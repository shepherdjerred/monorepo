{
  "name": "@shepherdjerred/streambot",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "imports": {
    "#sports-png-fixture": "./test/fixtures/sports-png.ts",
    "#lol-fixture": "./test/fixtures/lol.ts",
    "#music-fixture": "./test/music/fixture.ts",
    "#youtube-music-fixture": "./test/music/youtube-music-fixture.ts",
    "#architecture": "./architecture.config.ts",
    "#scripts/*": "./scripts/*",
    "#web-fixture": "./test/web/web-fixture.ts",
    "#numbered-fixture": "./test/session/numbered-fixture.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "web:dev": "vite",
    "preview:web": "vite build && bun test/web/preview.ts",
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run test/ src/sports/",
    "test:integration": "bun run scripts/run-integration.ts",
    "e2e": "bun run e2e/run.ts",
    "e2e:sports": "bun run e2e/sports-live.ts",
    "e2e:voice-assistant": "bun run e2e/voice-assistant.ts",
    "e2e:voice-recovery": "bun run e2e/voice-recovery.ts",
    "voice:corpus:generate": "bun run scripts/voice-corpus-generate.ts",
    "voice:corpus:verify": "bun run scripts/voice-corpus-verify.ts",
    "voice:corpus:evaluate": "bun run scripts/voice-corpus-evaluate.ts",
    "voice:human:evaluate": "bun run scripts/voice-human-holdout-evaluate.ts",
    "voice:harness:prepare": "bun run scripts/voice-harness-prepare.ts",
    "voice:harness": "bun run scripts/voice-harness.ts",
    "voice:harness:evaluate": "bun run scripts/voice-harness-evaluate.ts",
    "voice:cloud-probe": "bun run scripts/voice-cloud-probe.ts",
    "voice:verifier:package": "bun run scripts/voice-verifier-package.ts",
    "voice:keywords:generate": "bun run scripts/voice-keywords-generate.ts",
    "e2e:local": "bun run e2e/local.ts",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit && PATH=node_modules/@typescript/native/bin:$PATH tsc --project src/web/client/tsconfig.json --noEmit",
    "lint": "eslint . && check-architecture",
    "docker:build": "docker buildx build --cache-from type=registry,ref=docker.io/shepherdjerred/streambot:buildcache ${DOCKER_BUILD_EXTRA_ARGS:-} --load -t streambot:dev -f Dockerfile ../..",
    "docker:build:smoke": "docker buildx build --cache-from type=registry,ref=docker.io/shepherdjerred/streambot:buildcache ${DOCKER_BUILD_EXTRA_ARGS:-} --target smoke --load -t streambot:smoke -f Dockerfile ../..",
    "smoke": "bun run scripts/smoke.ts",
    "ytmusic:probe": "bun scripts/ytmusic-probe.ts",
    "test:ci": "bun ../../scripts/ci/run-ci-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1001.0",
    "@openai/agents": "0.22.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@sentry/bun": "^11.16.0",
    "@sentry/react": "^11.16.0",
    "@shepherdjerred/bugsink-config": "workspace:*",
    "@shepherdjerred/config": "workspace:*",
    "@shepherdjerred/discord-stream-lifecycle": "workspace:*",
    "@shepherdjerred/discord-video-stream": "workspace:*",
    "@shepherdjerred/feature-flags": "workspace:*",
    "@shepherdjerred/llm-runtime": "workspace:*",
    "@shepherdjerred/text": "workspace:*",
    "@shepherdjerred/voice-assistant": "workspace:*",
    "discord.js": "^14.26.4",
    "discord.js-selfbot-v13": "^3.7.1",
    "fast-xml-builder": "1.3.1",
    "fast-xml-parser": "5.12.1",
    "posthog-js": "^1.418.10",
    "posthog-node": "^6.0.5",
    "prom-client": "^15.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.3",
    "spotify-url-info": "3.3.3",
    "xstate": "^5.32.4",
    "youtubei.js": "18.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shepherdjerred/architecture": "workspace:*",
    "@shepherdjerred/eslint-config": "workspace:*",
    "@types/bun": "1.4.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/utils": "^8.72.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-istanbul": "5.0.5",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "openai": "7.62.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "5.0.5"
  }
}
