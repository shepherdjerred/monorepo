{
  "name": "@shepherdjerred/docs-wiki",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "test": "bun test src",
    "test:e2e": "bun x --no-install playwright test",
    "lint": "eslint --cache",
    "lint:fix": "eslint --cache --fix",
    "deploy": "bun ../../../scripts/deploy-site.ts wiki-sjer-red"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-satteri": "^0.3.5",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.41.5",
    "astro": "^7.1.5",
    "astro-mermaid": "^2.1.0",
    "mermaid": "^11.16.0",
    "satteri": "^0.9.5",
    "sharp": "^0.35.0",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@shepherdjerred/eslint-config": "workspace:*",
    "@typescript/native": "npm:typescript@7.0.2",
    "@types/bun": "^1.3.13",
    "eslint": "^10.3.0",
    "eslint-plugin-astro": "^3.0.1",
    "typescript": "^6.0.3"
  }
}
