{
  "name": "@scout-for-lol/app",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "storybook": "bun x --no-install storybook dev --port 6007 --no-open",
    "build:storybook": "bun x --no-install storybook build",
    "preview:storybook": "bun x --no-install vite preview --config .storybook/vite.config.ts --outDir storybook-static --host 127.0.0.1 --port 5191 --strictPort",
    "test:e2e": "bun run scripts/ensure-catalog-built.ts && bun --no-install --bun playwright test",
    "test": "bun --no-install --bun vitest --config ../../../../vitest.config.ts run src",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "lint": "bun x eslint src scripts .storybook e2e --max-warnings=0 && check-architecture",
    "test:ci": "bun ../../../../scripts/ci/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../../../scripts/ci/run-ci-test.ts"
  },
  "imports": {
    "#architecture": "./architecture.config.ts",
    "#src/*": "./src/*"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@scout-for-lol/backend": "workspace:*",
    "@scout-for-lol/data": "workspace:*",
    "@scout-for-lol/design-system": "workspace:*",
    "@scout-for-lol/report": "workspace:*",
    "@sentry/react": "^10.0.0",
    "@tanstack/react-form": "^1.33.5",
    "@shepherdjerred/loaded": "workspace:*",
    "@tanstack/react-query": "^5.62.0",
    "@trpc/client": "^11.17.0",
    "@trpc/tanstack-react-query": "^11.17.0",
    "clsx": "^2.1.1",
    "echarts": "^6.0.0",
    "lucide-react": "^1.14.0",
    "monaco-editor": "^0.56.0",
    "posthog-js": "^1.414.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "ts-pattern": "^5.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@shepherdjerred/architecture": "workspace:*",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-istanbul": "5.0.1",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "5.0.1"
  }
}
