{
  "name": "@scout-for-lol/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./assets": "./src/assets/index.tsx",
    "./brand": "./src/brand/index.tsx",
    "./build": "./src/build/index.ts",
    "./components/input": "./src/components/field.tsx",
    "./components/label": "./src/components/field.tsx",
    "./components/textarea": "./src/components/field.tsx",
    "./components/*": "./src/components/*.tsx",
    "./domain/*": "./src/domain/*.tsx",
    "./layout": "./src/layout/index.tsx",
    "./marketing": "./src/marketing/index.tsx",
    "./runtime": "./src/runtime/context.tsx",
    "./runtime/bootstrap": "./src/runtime/bootstrap.ts",
    "./runtime/theme": "./src/runtime/theme.ts",
    "./runtime/theme-menu": "./src/runtime/theme-menu.tsx",
    "./satori/assets": "./src/satori/assets.ts",
    "./satori/brand": "./src/brand/emblem.ts",
    "./satori/classic-fonts": "./src/satori/classic-fonts.ts",
    "./satori/classic-style": "./src/satori/classic-style.ts",
    "./satori/colors": "./src/satori/colors.ts",
    "./satori/file-assets": "./src/satori/file-assets.ts",
    "./satori/fonts": "./src/satori/fonts.ts",
    "./styles.css": "./styles/index.css",
    "./themes": "./src/generated/tokens.ts"
  },
  "imports": {
    "#src/*": "./src/*",
    "#styles/*": "./styles/*",
    "#tokens/*": "./tokens/*",
    "#workbench/*": "./workbench/*"
  },
  "scripts": {
    "build": "bun run generate && vite build",
    "dev": "vite",
    "generate": "bun run scripts/generate-tokens.ts",
    "check:generated": "bun run scripts/generate-tokens.ts --check",
    "test": "bun run check:generated && bun test src",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../../../scripts/run-ci-test.ts",
    "test:ci": "bun ../../../../scripts/run-ci-test.ts",
    "test:e2e": "playwright test",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "lint": "bun x --no-install eslint src scripts workbench",
    "format": "bun x --no-install prettier --check ."
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@scout-for-lol/data": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "satori": "^0.29.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "1.62.0",
    "@types/bun": "^1.3.13",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.0",
    "ajv": "^8.20.0",
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "vite": "^8.0.11"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
