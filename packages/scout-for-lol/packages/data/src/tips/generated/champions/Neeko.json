      "tips": [
        {
          "id": "support:Neeko:general:0",
          "text": "Aim Tangle-Barbs through a minion or enemy before it lands on your target; once it hits something it grows faster and roots for much longer.",
          "refs": [
            { "kind": "ability", "key": "Neeko-E", "start": 4, "end": 16 },
            { "kind": "keyword", "key": "rooted", "start": 118, "end": 123 }
          ],
          "pWrong": 0.22
        },
        {
          "id": "support:Neeko:general:1",
          "text": "Throw Blooming Burst at a champion or a large monster so it blooms again. Hitting a minion only blooms again if it dies.",
          "refs": [
            { "kind": "ability", "key": "Neeko-Q", "start": 6, "end": 20 }
          ],
          "pWrong": 0.21
        },
        {
          "id": "support:Neeko:general:2",
          "text": "Use Shapesplitter to run at or away from a fight; you and your clone both gain Move Speed. Every third attack also hits harder.",
          "refs": [
            { "kind": "ability", "key": "Neeko-W", "start": 4, "end": 17 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "support:Neeko:general:3",
          "text": "Disguise with Inherent Glamour only when it will pay off, because a wasted use puts enemies on alert. Casting a damaging spell or being immobilized breaks it.",
          "refs": [
            {
              "kind": "ability",
              "key": "Neeko-passive",
              "start": 14,
              "end": 30
            }
          ],
          "pWrong": 0.32
        },
        {
          "id": "support:Neeko:general:4",
          "text": "Start Pop Blossom while disguised; enemies get no warning visuals. Your disguise breaks shortly after you cast.",
          "refs": [
            { "kind": "ability", "key": "Neeko-R", "start": 6, "end": 17 }
          ],
          "pWrong": 0.21
        },
        {
          "id": "support:Neeko:general:5",
          "text": "Land Tangle-Barbs first, then follow with Pop Blossom while the enemy is rooted so they cannot walk out of it. They are knocked up, then stunned.",
          "refs": [
            { "kind": "ability", "key": "Neeko-E", "start": 5, "end": 17 },
            { "kind": "ability", "key": "Neeko-R", "start": 42, "end": 53 },
            { "kind": "keyword", "key": "knocked-up", "start": 120, "end": 130 }
          ],
          "pWrong": 0.32
        },
        {
          "id": "support:Neeko:general:6",
          "text": "Stand near an allied minion or ward to collect its disguise, so you can blend in without needing an ally champion.",
          "refs": [],
          "pWrong": 0.54
        }
      ],
      "combos": [
        {
          "id": "support:Neeko:combo:0",
          "name": "Disguised Pop Blossom",
          "category": "trick",
          "sequence": [
            { "kind": "ability", "key": "Neeko-passive" },
            { "kind": "ability", "key": "Neeko-R" }
          ],
          "when": "When you want to engage a group of enemies who can't see the Pop Blossom warning.",
          "whenRefs": [
            { "kind": "ability", "key": "Neeko-R", "start": 61, "end": 72 }
          ],
          "text": "Disguise as an ally or minion and walk into the enemy team, then cast Pop Blossom. The warning is hidden while you're disguised, so they get less time to react.",
          "textRefs": [
            { "kind": "ability", "key": "Neeko-R", "start": 70, "end": 81 }
          ]
        }
      ]
    }
  ],
