generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Subscription {
  id        Int    @id @default(autoincrement())
  playerId  Int
  channelId String
  player    Player @relation(fields: [playerId], references: [id])

  // JSON-serialized SubscriptionFilterSpec (@scout-for-lol/data); null = notify
  // all. Validated in the app via Zod; never queried in SQL.
  filters String?

  // Muted subscriptions stay intact (history, filters, channel wiring) but are
  // skipped when dispatching pre/post-match notifications.
  isMuted Boolean @default(false)

  // metadata
  serverId         String
  creatorDiscordId String
  createdTime      DateTime
  updatedTime      DateTime

  @@unique([serverId, playerId, channelId])
}

model Player {
  id                        Int                        @id @default(autoincrement())
  alias                     String
  discordId                 String?
  accounts                  Account[]
  subscriptions             Subscription[]
  competitionParticipants   CompetitionParticipant[]
  competitionSnapshots      CompetitionSnapshot[]
  duelDisclosureAcceptances DuelDisclosureAcceptance[]

  // metadata
  serverId         String
  creatorDiscordId String
  createdTime      DateTime
  updatedTime      DateTime

  @@unique([serverId, alias])
}

model Account {
  id       Int    @id @default(autoincrement())
  alias    String
  puuid    String
  region   String
  playerId Int
  player   Player @relation(fields: [playerId], references: [id])

  // Cached Riot ID (gameName#tagLine) resolved from the PUUID. Nullable
  // until first resolved; refreshed on read when older than 24h. Lets the
  // web UI show the real Riot ID instead of the user-chosen alias.
  riotGameName    String?
  riotTagLine     String?
  riotIdUpdatedAt DateTime?

  // Match processing tracking
  lastProcessedMatchId String? // Track last match we've processed to avoid duplicates
  lastMatchTime        DateTime? // Timestamp of the last match this player was in (for dynamic polling)
  lastCheckedAt        DateTime? // Timestamp of when we last checked for new matches (for polling intervals)

  // metadata
  serverId         String
  creatorDiscordId String
  createdTime      DateTime
  updatedTime      DateTime

  @@unique([serverId, puuid])
  // Hot path updates filter by puuid alone (post-match cursor writes); the
  // unique index is (serverId, puuid) and cannot serve those lookups.
  @@index([puuid])
}

// Global, self-maintaining cache of known summoners (Riot IDs are public).
// Powers fast prefix autocomplete in the web "add player" flow. Populated on
// confirmed Riot resolutions + backfill from Account; an entry is evicted when
// Riot can no longer resolve it (rename/deletion).
model SummonerIndex {
  id             Int      @id @default(autoincrement())
  puuid          String   @unique
  gameName       String
  tagLine        String
  region         String
  lastVerifiedAt DateTime
  createdTime    DateTime
  updatedTime    DateTime

  // Prefix-autocomplete on gameName (case-insensitive via Prisma mode:
  // "insensitive" → ILIKE; the b-tree index serves exact-prefix scans only).
  @@index([gameName])
}

model MatchRankHistory {
  id        Int    @id @default(autoincrement())
  matchId   String // Riot match ID
  puuid     String // Player PUUID
  queueType String // "solo" or "flex"

  // Rank snapshots (JSON serialized, nullable for unranked)
  rankBefore String? // JSON: {tier, division, lp, wins, losses}
  rankAfter  String? // JSON: {tier, division, lp, wins, losses}

  matchGameCreationAt DateTime? // Riot match info.gameCreation for historical attribution
  matchGameEndAt      DateTime? // Riot match info.gameEndTimestamp for rank ordering
  capturedAt          DateTime // When this was recorded

  @@unique([matchId, puuid, queueType])
  @@index([puuid, capturedAt])
  @@index([puuid, queueType, matchGameEndAt])
  @@index([matchId])
}

// Durable, globally deduplicated first-run import. The PUUID key makes one
// Riot snapshot serve every guild that tracks the same account.
model InitialMatchHistoryImport {
  puuid  String @id
  region String
  phase  String

  // JSON-serialized MatchId[] validated by the application. The list is
  // captured once so retries cannot move the notification boundary.
  matchIdsJson      String?
  snapshotAt        DateTime?
  nextMatchIndex    Int       @default(0)
  newestMatchId     String?
  newestMatchTime   DateTime?
  cursorHandedOffAt DateTime?

  attemptCount  Int       @default(0)
  lastAttemptAt DateTime?
  nextAttemptAt DateTime
  errorCode     String?

  requestedAt    DateTime
  completedAt    DateTime?
  lastImportedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([phase, nextAttemptAt, requestedAt])
}

// Current rank is not a per-match observation. Keeping it separate prevents
// imported games from fabricating historical LP deltas.
model CurrentRankSnapshot {
  puuid        String   @id
  soloRank     String?
  flexRank     String?
  ranked5sRank String?
  fetchedAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Clash-v1 current snapshot. Riot returns empty registrations when Clash is
// inactive; rows are replaced on each poll rather than accumulated.
model ClashTournament {
  id               Int      @id @default(autoincrement())
  platform         String
  riotId           Int
  themeId          Int
  nameKey          String
  nameKeySecondary String
  scheduleJson     String
  fetchedAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([platform, riotId])
}

model ClashTeam {
  id               Int      @id @default(autoincrement())
  platform         String
  riotId           String
  tournamentRiotId Int
  name             String
  abbreviation     String
  iconId           Int
  tier             Int
  fetchedAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([platform, riotId])
  @@index([platform, tournamentRiotId])
}

model ClashRegistration {
  id               Int      @id @default(autoincrement())
  puuid            String
  region           String
  platform         String
  teamRiotId       String
  tournamentRiotId Int
  position         String
  role             String
  fetchedAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([puuid, region, tournamentRiotId])
  @@index([puuid])
  @@index([platform, teamRiotId])
}

// Append-only Clash-v1 membership. Current ClashTournament/Team/Registration
// rows still replace on each poll; this table keeps the named team after Riot
// returns empty.
model ClashMembershipHistory {
  id               Int      @id @default(autoincrement())
  puuid            String
  region           String
  platform         String
  tournamentRiotId Int
  teamRiotId       String
  teamName         String
  teamAbbreviation String
  position         String
  role             String
  nameKey          String
  nameKeySecondary String
  windowStartAt    DateTime
  windowEndAt      DateTime
  firstSeenAt      DateTime
  lastSeenAt       DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([puuid, platform, tournamentRiotId])
  @@index([puuid])
  @@index([platform, windowStartAt, windowEndAt])
}

// One Clash lobby or finished match Scout saw a tracked player in.
// source=prematch has no outcome; source=match carries Riot or validated client results.
model ClashGameSighting {
  id             Int      @id @default(autoincrement())
  platform       String
  gameId         String
  puuid          String
  source         String
  resultSource   String   @default("RIOT")
  resultConflict Boolean  @default(false)
  queue          String
  championId     Int
  teamId         Int
  observedAt     DateTime
  win            Boolean?
  teamRiotId     String?
  cupKey         String?
  cupDay         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([platform, gameId, puuid])
  @@index([puuid, observedAt])
  @@index([cupKey, cupDay])
}

// Champion mastery is public, current account state rather than match history.
// One PUUID snapshot is shared by every guild that tracks that Riot account.
model ChampionMasterySnapshot {
  puuid       String   @id
  entriesJson String
  fetchedAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Report {
  id                     Int       @id @default(autoincrement())
  serverId               String
  ownerId                String
  channelId              String
  title                  String
  description            String?
  queryText              String
  isEnabled              Boolean   @default(true)
  isSystemManaged        Boolean   @default(false)
  systemSource           String?
  sourceCompetitionId    Int?
  cronExpression         String
  scheduleTimezone       String    @default("UTC")
  nextScheduledRunAt     DateTime?
  lastScheduledRunAt     DateTime?
  lastScheduledLocalDate String?
  lastRunStatus          String?
  lastRunError           String?
  createdTime            DateTime
  updatedTime            DateTime
  revision               Int       @default(1)

  runs ReportRun[]

  @@index([serverId, isEnabled])
  @@index([nextScheduledRunAt])
  @@index([sourceCompetitionId])
  @@index([systemSource])
}

/// Transactional projection from Postgres-owned report definitions to
/// Temporal Schedules. reportId deliberately has no foreign key so deletion
/// cannot erase the tombstone required to remove the Schedule.
model ReportScheduleOutbox {
  id          Int       @id @default(autoincrement())
  reportId    Int
  revision    Int
  operation   String
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@unique([reportId, revision])
  @@index([processedAt, createdAt])
}

model ReportRun {
  id                    Int       @id @default(autoincrement())
  reportId              Int
  serverId              String
  trigger               String
  status                String
  startedAt             DateTime
  completedAt           DateTime?
  durationMs            Int?
  rowsReturned          Int       @default(0)
  rowsScanned           Int       @default(0)
  errorMessage          String?
  // Faithful per-run archive of what was posted: the rendered text body and an
  // S3 key for the chart PNG (null for text-only formats or when S3 is off).
  renderedContent       String?
  imageS3Key            String?
  imageByteSize         Int?
  querySnapshot         String?
  visualizationS3Key    String?
  visualizationByteSize Int?
  deliveryState         String    @default("NOT_REQUESTED")
  // Snapshot the destination selected for this occurrence. Report edits must
  // not redirect an already-rendered delivery during replay/reconciliation.
  deliveryChannelId     String?
  deliveryServerId      String?
  deliveryError         String?
  deliveredAt           DateTime?
  temporalWorkflowRunId String?   @unique
  createdAt             DateTime  @default(now())

  report         Report                @relation(fields: [reportId], references: [id], onDelete: Cascade)
  deliveryChunks ReportDeliveryChunk[]

  @@index([reportId, startedAt])
  @@index([serverId, startedAt])
  @@index([status, startedAt])
  @@index([deliveryState, createdAt])
}

/// One frozen Discord message and its observed send outcome. SENDING is never
/// automatically retried: a process can die after Discord accepted the send.
model ReportDeliveryChunk {
  reportRunId      Int
  channelId        String
  chunkIndex       Int
  serverId         String
  content          String
  attachmentKey    String?
  attachmentName   String?
  attachmentDigest String?
  nonce            String
  state            String    @default("PENDING")
  messageId        String?
  sendStartedAt    DateTime?
  deliveredAt      DateTime?
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  run              ReportRun @relation(fields: [reportRunId], references: [id], onDelete: Cascade)

  @@id([reportRunId, channelId, chunkIndex])
  @@index([state, updatedAt])
}

/// Target-specific presentation decisions. Kept independently of the subject
/// tables because match, Duel and Dare intents use different subject rows.
model NotificationPresentation {
  intentKey             String   @id
  serverId              String
  clashEnabled          Boolean
  guildPrematchArtifact Boolean  @default(false)
  tipKey                String?
  tipText               String?
  messageJson           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// Season metadata seeded from packages/data/src/seasons.ts on every bot startup.
// Competition.seasonId is a FK to Season.id; date drift is resolved by re-seeding.
model Season {
  id           String        @id
  displayName  String
  startDate    DateTime
  endDate      DateTime
  competitions Competition[]
}

model Competition {
  id               Int     @id @default(autoincrement())
  serverId         String
  ownerId          String // Discord user ID
  title            String
  description      String
  gameVariant      String  @default("MODERN")
  channelId        String
  isCancelled      Boolean @default(false)
  visibility       String // OPEN, INVITE_ONLY, SERVER_WIDE
  criteriaType     String // Enum stored as string
  criteriaConfig   String // JSON stored as string
  maxParticipants  Int     @default(100)
  analysisTimezone String  @default("UTC")

  // Time configuration (XOR: either fixed dates OR season)
  startDate DateTime?
  endDate   DateTime?
  seasonId  String?
  season    Season?   @relation(fields: [seasonId], references: [id])

  // Lifecycle tracking - when start/end processing was attempted
  // These prevent re-processing even if snapshot creation fails
  startProcessedAt           DateTime?
  endProcessedAt             DateTime?
  startNotifiedAt            DateTime?
  endNotifiedAt              DateTime?
  startNotificationMessageId String?
  endNotificationMessageId   String?

  // Optional leaderboard-post schedule. Legacy competitions remain disabled;
  // enabled schedules evaluate the CRON expression in scheduleTimezone.
  scheduledUpdatesEnabled Boolean   @default(false)
  updateCronExpression    String?
  scheduleTimezone        String    @default("UTC")
  // Next time the dispatcher should post a leaderboard update for this row.
  // The dispatcher selects rows where this is <= now (or NULL, as self-heal)
  // and recomputes this field from updateCronExpression after each post.
  nextScheduledUpdateAt   DateTime?
  // Wall-clock time of the most recent dispatched leaderboard post.
  lastScheduledUpdateAt   DateTime?

  // Relations
  participants CompetitionParticipant[]
  snapshots    CompetitionSnapshot[]

  // Metadata
  creatorDiscordId String
  createdTime      DateTime
  updatedTime      DateTime

  // Note: We do NOT have a unique constraint on [serverId, ownerId]
  // This allows users to create multiple competitions over time
  // The "one active competition per owner" rule is enforced in application logic
  @@index([serverId, isCancelled])
  @@index([serverId, ownerId, isCancelled])
  @@index([nextScheduledUpdateAt])
}

model CompetitionParticipant {
  id            Int       @id @default(autoincrement())
  competitionId Int
  playerId      Int
  status        String // INVITED, JOINED, LEFT
  invitedBy     String? // Discord user ID (nullable)
  invitedAt     DateTime? // When invited (nullable - null if joined directly)
  joinedAt      DateTime? // When joined (nullable - null if only invited)
  leftAt        DateTime? // When left (nullable - null if still participating)

  // Relations
  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  player      Player      @relation(fields: [playerId], references: [id])

  @@unique([competitionId, playerId])
  @@index([competitionId, status])
}

model CompetitionSnapshot {
  id            Int      @id @default(autoincrement())
  competitionId Int
  playerId      Int
  snapshotType  String // START, END
  snapshotData  String // JSON stored as string
  snapshotTime  DateTime

  // Relations
  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  player      Player      @relation(fields: [playerId], references: [id])

  @@unique([competitionId, playerId, snapshotType])
}

model ServerPermission {
  id            Int      @id @default(autoincrement())
  serverId      String
  discordUserId String
  // Canonical "resource:action" key from the RBAC catalog (@scout-for-lol/data),
  // e.g. "subscriptions:create". Legacy web-less grants "CREATE_COMPETITION" /
  // "CREATE_REPORT" were migrated to "competitions:create" / "reports:create".
  permission    String
  grantedBy     String // Discord user ID
  grantedAt     DateTime

  @@unique([serverId, discordUserId, permission])
  @@index([serverId, discordUserId]) // resolveGuildPermissions: a user's grants in a guild
  @@index([serverId]) // roles.list: all grants in a guild
}

model GuildPermissionError {
  id                    Int       @id @default(autoincrement())
  serverId              String
  channelId             String
  errorType             String // Type of permission error
  errorReason           String? // Detailed reason
  firstOccurrence       DateTime // When this error first occurred
  lastOccurrence        DateTime // Most recent occurrence
  consecutiveErrorCount Int       @default(1) // Number of consecutive errors
  lastSuccessfulSend    DateTime? // Last time a message was successfully sent to this server
  // Backed-off owner notification escalation for the current failure streak.
  // notificationStage: 0 = none sent, 1 = immediate sent, 2 = +1w sent, 3 = +1mo sent (terminal).
  // lastNotifiedAt anchors the next stage's delay (NOT firstOccurrence) so existing
  // mid-streak rows restart cleanly at "immediate" instead of jumping to "month".
  notificationStage     Int       @default(0)
  lastNotifiedAt        DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([serverId, channelId])
  @@index([serverId, consecutiveErrorCount])
  @@index([lastOccurrence])
}

// Central audit log of every direct message (DM) the bot sends to a user.
// All DMs MUST flow through `sendDM` (discord/utils/dm.ts), which writes one
// row here per attempt so DMs are fully traceable. Append-only.
model DmAuditLog {
  id             Int      @id @default(autoincrement())
  recipientId    String // Discord user (snowflake) the DM was addressed to
  recipientTag   String? // Discord tag at send time, when resolvable
  guildId        String? // Guild this DM relates to, when applicable
  kind           String // Category, e.g. "permission_error" | "abandonment" | "feedback_request" | "competition_invite" | "prune_notice"
  content        String // The message body that was (attempted to be) sent
  deliveryStatus String // "sent" | "dm_disabled" | "failed" | "budget_exhausted" | "deferred"
  // Ladder rung this message represented, for budgeted outreach only.
  // Persisted because the Nth delivered message is NOT necessarily rung N:
  // a bounced rung-1 DM followed by a delivered rung-2 DM would otherwise be
  // reconstructed as rung 1, mis-attributing conversions and letting a former
  // installer receive a repeat of a rung they already got.
  ladderStage    Int?
  errorMessage   String? // Failure detail when delivery != "sent"
  createdAt      DateTime @default(now())

  @@index([recipientId, createdAt])
  @@index([kind, createdAt])
  @@index([guildId, createdAt])
}

// =============================================================================
// Desktop Voice Notification System
// =============================================================================

model User {
  discordId           String    @id // Discord snowflake ID
  discordUsername     String
  discordAvatar       String?
  discordAccessToken  String?
  discordRefreshToken String?
  tokenExpiresAt      DateTime?
  // Opaque, app-owned analytics identity. PostHog must never receive the
  // Discord snowflake as a distinct id: that is an external identifier the
  // analytics registry forbids sending, and using it as the join key would
  // make every event and recording addressable by Discord account. Same role
  // for a person as `GuildInstall.analyticsInstallationId` has for an install.
  analyticsUserId     String    @unique @default(uuid())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  // Best-effort dashboard activity marker for DB-side MAU/WAU, written by the
  // authenticated request context at most once per hour per user. `updatedAt`
  // cannot answer this: it moves on token refresh, not on activity.
  lastSeenAt          DateTime?

  exploreConversations ExploreConversation[]
  challengeDrafts      ChallengeDraft[]
  challengeRuns        ChallengeRun[]
  scoutClientDevices   ScoutClientDevice[]
  scoutClientApprovals ScoutClientPairing[]  @relation("ScoutClientPairingApprover")
}

/// One short-lived native-client browser approval request. Only a digest of
/// the one-time secret is stored; approval records intent but does not mint a
/// device credential until the client proves possession during exchange.
model ScoutClientPairing {
  id              String    @id @default(uuid())
  secretDigest    String    @unique
  deviceName      String
  platform        String
  architecture    String
  appVersion      String
  protocolVersion Int
  state           String    @default("PENDING")
  expiresAt       DateTime
  approvedAt      DateTime?
  exchangedAt     DateTime?
  approvedById    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  approvedBy User?              @relation("ScoutClientPairingApprover", fields: [approvedById], references: [discordId], onDelete: SetNull)
  device     ScoutClientDevice?

  @@index([state, expiresAt])
  @@index([approvedById, createdAt])
}

/// One paired Windows or macOS Scout observer. The bearer token is opaque and
/// stored only as a SHA-256 digest so a database read cannot impersonate it.
model ScoutClientDevice {
  id              String    @id @default(uuid())
  ownerId         String
  pairingId       String    @unique
  tokenDigest     String    @unique
  deviceName      String
  platform        String
  architecture    String
  appVersion      String
  protocolVersion Int
  deviceState     String    @default("ACTIVE")
  lastSeenAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  owner           User                        @relation(fields: [ownerId], references: [discordId], onDelete: Cascade)
  pairing         ScoutClientPairing          @relation(fields: [pairingId], references: [id], onDelete: Restrict)
  observations    ScoutClientObservation[]
  replayArtifacts ScoutClientReplayArtifact[]
  versions        ScoutClientDeviceVersion[]

  @@index([ownerId, deviceState])
  @@index([lastSeenAt])
}

/// Every application version this credential has authenticated. Keeping the
/// history lets a client upload immutable observations captured before an
/// upgrade without weakening version attestation for arbitrary values.
model ScoutClientDeviceVersion {
  deviceId    String
  appVersion  String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  device ScoutClientDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([deviceId, appVersion])
  @@index([appVersion, lastSeenAt])
}

/// One content-addressed ROFL received through the authenticated backend relay.
/// The object key is generated by the server and becomes durable only after the
/// SeaweedFS S3 put succeeds and its streamed SHA-256 matches the claim.
model ScoutClientReplayArtifact {
  id          String    @id @default(uuid())
  deviceId    String
  gameId      String
  /// Verified platform; legacy uploads retain an unknown platform.
  platformId  String?
  digest      String    @unique
  objectKey   String    @unique
  bytes       BigInt
  uploadState String
  lastError   String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  device ScoutClientDevice @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@index([gameId, uploadState])
  @@index([platformId, gameId, uploadState])
  @@index([deviceId, createdAt])
}

/// Immutable, idempotent gameplay observation received from a paired device.
/// Raw observations are evidence: only ACCEPTED rows may be considered by the
/// canonical merge, and a conflicting id/sequence is rejected rather than
/// overwritten.
model ScoutClientObservation {
  normalizedEvidence      MatchResultEvidence?
  observationId           String               @id
  deviceId                String
  sequence                BigInt
  capturedAt              DateTime
  receivedAt              DateTime             @default(now())
  protocolVersion         Int
  schemaVersion           Int
  appVersion              String
  kind                    String
  leaguePatch             String?
  platformId              String?
  /// The observer's Riot API PUUID: the envelope's League-client UUID
  /// translated through `LeagueIdentityAlias`, or that UUID unchanged when no
  /// alias exists yet (such a row is quarantined).
  localPuuid              String?
  /// The observer identity exactly as the client sent it, when it was a
  /// League-client UUID rather than a Riot API PUUID.
  localLcuUuid            String?
  lobbyId                 String?
  gameId                  String?
  payload                 Json
  bodyDigest              String
  disposition             String
  quarantineReason        String?
  /// Received headers before identity/routing translation, or explicitly labelled
  /// legacy metadata frozen at the first archive claim. Payload is stored above.
  rawEnvelope             Json?
  rawArchiveKey           String?
  rawArchiveDigest        String?
  rawArchiveBytes         BigInt?
  rawArchivedAt           DateTime?
  rawArchiveAttemptAt     DateTime?
  rawArchiveNextAttemptAt DateTime             @default(now())
  rawArchiveClaimId       String?
  rawArchiveError         String?
  /// Projection checkpoints never change the immutable envelope or payload.
  recoveryVersion         Int                  @default(0)
  recoveryAttemptAt       DateTime?
  recoveryComplete        Boolean              @default(false)

  device         ScoutClientDevice                    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  canonicalMatch ScoutClientCanonicalMatch?
  playerSnapshot ScoutClientPlayerSnapshot?
  clashEntities  ScoutClientClashEntity[]
  gameResult     ScoutClientGameResult?
  revalidations  ScoutClientObservationRevalidation[]

  @@unique([deviceId, sequence])
  @@index([kind, capturedAt])
  @@index([gameId, kind])
  @@index([lobbyId, kind])
  @@index([disposition, receivedAt])
  @@index([recoveryComplete, recoveryAttemptAt])
  @@index([rawArchivedAt, rawArchiveNextAttemptAt], map: "ScoutClientObservation_rawArchiveDue_idx")
}

/// Acceptance after quarantine is audited; the original body and digest never change.
model ScoutClientObservationRevalidation {
  id             Int                    @id @default(autoincrement())
  observationId  String
  previousReason String?
  validatedAt    DateTime
  observation    ScoutClientObservation @relation(fields: [observationId], references: [observationId], onDelete: Cascade)

  @@index([observationId])
}

/// Rebuildable, versioned local scoreboard; raw observations remain immutable.
/// This does not claim to be a Match-V5 payload or authorize financial effects.
model ScoutClientGameResult {
  observationId     String                 @id
  riotMatchId       String
  observerPuuid     String
  result            Json
  normalizerVersion Int
  capturedAt        DateTime
  observation       ScoutClientObservation @relation(fields: [observationId], references: [observationId], onDelete: Restrict)

  @@index([observerPuuid, capturedAt])
  @@index([riotMatchId])
}

/// Latest accepted local account/profile projection. The immutable source
/// observation retains the payload; this row is only the replaceable lookup
/// pointer used by mastery, milestone, Challenge, and Clash consumers.
model ScoutClientPlayerSnapshot {
  localPuuid    String
  resource      String
  kind          String
  observationId String   @unique
  capturedAt    DateTime
  updatedAt     DateTime @updatedAt

  observation ScoutClientObservation @relation(fields: [observationId], references: [observationId], onDelete: Restrict)

  @@id([localPuuid, resource])
  @@index([kind, capturedAt])
}

/// Client Clash entities are independent of Riot's replaceable schedule tables.
/// Each observer retains a pointer per entity; immutable observations hold history.
model ScoutClientClashEntity {
  observerPuuid String
  platformId    String
  resource      String
  entityId      String
  tournamentId  String?
  tournamentKey String   @default("")
  isPrimary     Boolean  @default(false)
  observationId String
  capturedAt    DateTime

  observation ScoutClientObservation @relation(fields: [observationId], references: [observationId], onDelete: Restrict)

  @@id([observerPuuid, platformId, resource, entityId, tournamentKey])
  @@index([platformId, tournamentId, resource])
  @@index([observationId])
}

/// The League client names players by a 36-character UUID; Riot's API names
/// them by a 78-character PUUID encrypted per API key. The two never compare
/// equal, so every client payload is translated through this table before
/// anything reads a player identity out of it.
///
/// An alias is learned by resolving the Riot ID the client reported alongside
/// the UUID (`gameName#tagLine`) through account-v1. The UUID-to-Riot-ID link is
/// the client's claim; the Riot-ID-to-PUUID link is Riot's answer.
///
/// `ownerVerified` marks an alias whose PUUID is one of the reporting device
/// owner's registered accounts — a player's own client vouching for itself.
/// A verified alias replaces an unverified one; otherwise a UUID never changes
/// owner, so the first alias stands and a later disagreement is counted rather
/// than written. That is what stops another client's forged payload from
/// permanently re-pointing a player who runs the client themselves.
model LeagueIdentityAlias {
  lcuUuid             String   @id
  puuid               String
  gameName            String
  tagLine             String
  source              String
  ownerVerified       Boolean  @default(false)
  learnedFromDeviceId String?
  resolvedAt          DateTime @default(now())

  @@index([puuid])
}

/// The immutable local Match-V5-compatible observation selected only after
/// Riot has returned no authoritative payload for two minutes. Recording the
/// selection prevents later Activity retries from silently changing sources
/// after effects have begun. Riot payloads are still preferred before this row
/// exists; the local row is a gap-fill, not a competing authority.
model ScoutClientCanonicalMatch {
  riotMatchId         String   @id
  sourceObservationId String   @unique
  payloadDigest       String
  selectedAt          DateTime @default(now())

  sourceObservation ScoutClientObservation @relation(fields: [sourceObservationId], references: [observationId], onDelete: Restrict)

  @@index([selectedAt])
}

/// A saved explore conversation. Explore queries the whole report lake rather
/// than one server's data, so a conversation belongs to a person, not a guild.
model ExploreConversation {
  preferredModel String?
  id             String    @id @default(uuid())
  userId         String
  title          String
  /// Server-owned provenance for the surface that created this conversation.
  /// Follow-up turns do not change it.
  origin         String    @default("legacy")
  /// Set when the owner shares the conversation; null means private. Opaque
  /// and unguessable rather than derived from `id`, because possession of the
  /// token is the only credential a share link carries.
  shareToken     String?   @unique
  sharedAt       DateTime?
  /// Which leaf of the message tree the owner is currently looking at. The
  /// active transcript is the path from this message back to the root.
  currentLeafId  String?
  /// The leaf the share link is pinned to, captured when the conversation was
  /// shared. Without it, branching after sharing would silently change what a
  /// link shows — the same freeze guarantee the stored results already give.
  sharedLeafId   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User                 @relation(fields: [userId], references: [discordId], onDelete: Cascade)
  messages     ExploreMessage[]
  toolPayloads ExploreToolPayload[]

  @@index([userId, updatedAt])
}

/// An image a person attached to an Explore question.
///
/// Uploaded before the turn starts, so `questionId` is null until the question
/// that carries it is written. The bytes live in the private support bucket
/// under `objectKey`; deleting the question (or its conversation) cascades the
/// row, and the conversation delete path queues the object's deletion.
model ExploreAttachment {
  id         String          @id @default(uuid())
  ownerId    String
  questionId String?
  /// Order within the question, as the asker attached them.
  position   Int?
  objectKey  String          @unique
  mediaType  String
  bytes      Int
  sha256     String
  createdAt  DateTime        @default(now())
  /// While unsent, the upload is not reclaimed before this: the composer
  /// showing it renews the hold, so only a composer that is gone lets it lapse.
  heldUntil  DateTime
  question   ExploreMessage? @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([ownerId, createdAt])
}

/// One row per Explore image upload, kept when the image itself is deleted,
/// so the hourly upload limit cannot be reset by deleting conversations.
/// Rows older than a day are pruned by the unsent-upload sweep.
model ExploreAttachmentUpload {
  id        String   @id @default(uuid())
  ownerId   String
  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
}

/// Full inspection data is fetched on demand, never replayed into model history.
model ExploreToolPayload {
  id             String              @id @default(uuid())
  conversationId String
  runId          String
  toolCallId     String
  toolName       String
  direction      String
  payload        String
  createdAt      DateTime            @default(now())
  conversation   ExploreConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, toolCallId, direction])
  @@index([runId])
}

/// One turn of an explore conversation, as a node in a tree.
///
/// Turns form a tree rather than a list so editing a question or regenerating
/// an answer forks a sibling instead of destroying what was there. Messages
/// sharing a `parentId` are versions of each other — that is what the `‹ 1/2 ›`
/// arrows page through — and nothing is ever deleted to make a new one.
///
/// Assistant turns store the rendered result inline — the preview rows and the
/// visualization snapshot the asker actually saw. A shared conversation is
/// therefore frozen by construction: rendering it needs no re-execution, so a
/// share link cannot silently change meaning as the lake grows, and an
/// anonymous viewer costs no query.
model ExploreMessage {
  generation     String?
  inlineEntities String?
  id             String   @id @default(uuid())
  conversationId String
  /// Null for the opening message. Siblings under one parent are versions.
  parentId       String?
  /// "user" or "assistant".
  role           String
  content        String
  /// Speech-safe rendering used only by the private voice delivery path.
  spokenContent  String?
  /// The ScoutQL the answer rests on, when the turn ran one.
  queryText      String?
  /// JSON string arrays; empty when the turn produced none.
  caveats        String   @default("[]")
  followUps      String   @default("[]")
  /// JSON blobs matching ReportAiPreviewSummarySchema / VisualizationSnapshotSchema.
  preview        String?
  visualization  String?
  /// JSON array matching ExploreMatchCardSchema; frozen with the assistant turn.
  matchCards     String?
  /// JSON array matching ExploreLoadoutCardSchema; frozen with the assistant turn.
  loadoutCards   String?
  /// JSON string array of the guilds this turn's capabilities were resolved
  /// from. A conversation belongs to a person, not a guild, but a *turn* ran
  /// with a specific one and that decided which tools existed — which replay
  /// needs and could otherwise only recover from a durable run payload, which
  /// Discord and voice turns never create. Null on user turns and on every
  /// row written before this column existed.
  guildIds       String?
  /// JSON array of the tool calls this turn made, for the reasoning panel.
  trace          String?
  createdAt      DateTime @default(now())

  conversation ExploreConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  parent       ExploreMessage?     @relation("ExploreMessageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     ExploreMessage[]    @relation("ExploreMessageTree")
  attachments  ExploreAttachment[]

  @@index([conversationId])
  @@index([conversationId, parentId])
}

/// Per-provider-request monetary hold. Ambiguous attempts retain their hold.
model ExploreSpend {
  id             String    @id @default(uuid())
  runId          String
  ownerId        String
  month          String
  model          String
  reservedMicros Int
  budgetMicros   Int
  state          String    @default("held")
  usage          String?
  responseId     String?
  createdAt      DateTime  @default(now())
  settledAt      DateTime?

  @@index([month, ownerId])
  @@index([runId])
}

model ExploreSandboxLease {
  id        String   @id @default(uuid())
  expiresAt DateTime
}

model GuildInstall {
  id                        Int       @id @default(autoincrement())
  serverId                  String    @unique
  serverName                String
  ownerDiscordId            String
  addedByDiscordId          String // Installer (from audit log), fallback to ownerId
  memberCount               Int
  installedAt               DateTime
  analyticsInstallationId   String    @unique @default(uuid())
  analyticsLifecycleTracked Boolean   @default(true)
  firstSubscriptionAt       DateTime?
  firstCoreOutputAt         DateTime?
  // Legacy one-shot markers, kept for one release so a rollback can still read
  // them. No longer written; DmAuditLog is the source of truth.
  outreach3dSentAt          DateTime?
  outreach14dSentAt         DateTime?
  outreach30dSentAt         DateTime?

  // Outreach budget, ladder position, and "have we asked for feedback?" are
  // NOT stored here. They are derived from DmAuditLog rows created after
  // `installedAt` — the durable record of what was actually delivered.
  //
  // A derived counter cannot drift from reality when a write fails, cannot
  // disagree with the "Message N of 3" text it produces, and makes a re-install
  // reset the whole ladder for free by simply moving `installedAt` forward.

  // Set once the one-time email nudge has been sent (see the email channel).
  emailNudgeSentAt DateTime?

  // Set when guildDelete confirms a removal; cleared on the next install.
  // This is the ONLY signal that distinguishes a genuine re-install (which
  // should restart onboarding) from a spurious `guildCreate` for a guild we
  // never left. `cleanupRemovedGuild` deliberately keeps this row, so row
  // existence alone cannot tell the two apart.
  removedAt DateTime?

  // Web-flow install attribution for THIS installation (cleared with the
  // identity rotation on reinstall). Stamped by whichever of the
  // /app/installed mutation or the guildCreate reconciler runs second — see
  // analytics/install-attribution.ts.
  attributedAt       DateTime?
  attributionSurface String?

  @@index([installedAt])
}

/// A single-use, server-minted token that rides Discord's OAuth `state`
/// parameter through the bot-install round trip. Minted by
/// /api/discord/install, echoed by Discord to /app/installed, and consumed by
/// the installAttribution.complete mutation. A consumed-but-unreconciled row
/// is also the pending-attribution store for the browser-beats-gateway race.
model InstallAttributionToken {
  id           Int       @id @default(autoincrement())
  token        String    @unique
  discordId    String
  surface      String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  consumedAt   DateTime?
  guildId      String?
  reconciledAt DateTime?

  @@index([guildId, reconciledAt])
  @@index([expiresAt])
}

/// Private support messages from the web dashboard and bot DMs.
/// Message contents are immutable; operators may mark them read and append replies.
model Feedback {
  id               Int                  @id @default(autoincrement())
  discordId        String // Sender; bot DMs do not require a web account
  serverId         String? // Guild in context when submitted, when known
  rating           Int? // Optional 1-5 sentiment
  body             String
  createdAt        DateTime             @default(now())
  source           FeedbackSource       @default(WEB)
  submissionId     String?              @unique
  discordMessageId String?              @unique
  discordChannelId String?
  discordUsername  String?
  attachments      Json                 @default("[]")
  readAt           DateTime?
  conversationId   String?
  conversation     SupportConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction        SupportDirection     @default(INBOUND)
  authorDiscordId  String?
  context          Json                 @default("{}")
  screenshots      SupportAttachment[]
  replies          FeedbackReply[]

  @@index([createdAt])
  @@index([discordId, createdAt])
  @@index([readAt, id])
  @@index([conversationId, createdAt, id])
}

enum FeedbackSource {
  WEB
  DISCORD_DM
  DISCORD_MODAL
}

enum FeedbackReplyStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  DM_DISABLED
}

/// A reply is reserved before contacting Discord; the request id prevents resends.
model FeedbackReply {
  id                String              @id
  feedbackId        Int
  feedback          Feedback            @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  operatorDiscordId String
  body              String
  status            FeedbackReplyStatus @default(SENDING)
  createdAt         DateTime            @default(now())
  completedAt       DateTime?

  @@index([feedbackId, createdAt])
}

enum SupportDirection {
  INBOUND
  OUTBOUND
}

enum SupportConversationStatus {
  OPEN
  WAITING_ON_USER
  RESOLVED
}

enum SupportCategory {
  HELP
  BUG
  IDEA
}

model SupportConversation {
  id                String                    @id @default(uuid())
  discordId         String                    @unique
  username          String?
  status            SupportConversationStatus @default(OPEN)
  category          SupportCategory?
  muted             Boolean                   @default(false)
  operatorReadAt    DateTime?
  userReadAt        DateTime?
  userReadMessageId Int                       @default(0)
  lastMessageAt     DateTime                  @default(now())
  lastAlertAt       DateTime?
  lastReceiptAt     DateTime?
  createdAt         DateTime                  @default(now())
  messages          Feedback[]
  attachments       SupportAttachment[]
  jobs              SupportJob[]

  @@index([status, lastMessageAt, id])
}

/// Minimal sender-scoped throttling state survives deletion of message history.
model SupportSenderThrottle {
  discordId           String     @id
  inboundAt           DateTime[] @default([])
  uploadAt            DateTime[] @default([])
  lastAlertAt         DateTime?
  lastReceiptAt       DateTime?
  lastFailureNoticeAt DateTime?
}

enum SupportAttachmentStatus {
  PENDING
  STORED
  FAILED
}

model SupportAttachment {
  id             String                  @id @default(uuid())
  conversationId String
  conversation   SupportConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feedbackId     Int?
  feedback       Feedback?               @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  name           String
  contentType    String
  size           Int
  sourceUrl      String?
  digest         String?
  objectKey      String                  @unique
  status         SupportAttachmentStatus @default(PENDING)
  createdAt      DateTime                @default(now())
  jobs           SupportJob[]

  @@index([feedbackId])
  @@index([createdAt])
}

enum SupportJobKind {
  ALERT
  ACKNOWLEDGEMENT
  REPLY
  ARCHIVE
  DELETE_OBJECT
}

enum SupportJobStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  BLOCKED
  UNKNOWN
  SKIPPED
}

/// Durable outbox: contains references, not message contents or screenshot bytes.
model SupportJob {
  id             String               @id
  kind           SupportJobKind
  status         SupportJobStatus     @default(QUEUED)
  conversationId String?
  conversation   SupportConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  attachmentId   String?
  attachment     SupportAttachment?   @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  replyId        String?
  objectKey      String?
  attempts       Int                  @default(0)
  errorCode      String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([status, createdAt])
}

/// Anonymous support funnel evidence; identifiers deduplicate delivery/interaction events.
model SupportTouchpoint {
  id        String   @id
  surface   String
  action    String
  createdAt DateTime @default(now())

  @@index([createdAt, surface, action])
}

/// A recorded outreach conversion: a guild whose FIRST subscription appeared
/// within the attribution window after a delivered outreach message.
///
/// Written once, never recomputed. Deriving it from live subscriptions made a
/// historical experiment result *decrease* as converted guilds churned —
/// `cleanupRemovedGuild` deletes their subscriptions, so the evidence vanished
/// and the next recompute subtracted them. Scoped to the installation so a
/// quick re-install cannot attribute a new subscription to the old one.
/// Records that a user has answered — or dismissed — the one-time in-app
/// feedback prompt. Server-side because localStorage is per-browser: the same
/// account was otherwise re-prompted on another device, in a private window, or
/// after clearing site data, contradicting the "we'll only ask you once"
/// promise the dialog makes.
model FeedbackPromptState {
  discordId   String   @id
  dismissedAt DateTime @default(now())
  submitted   Boolean  @default(false)
}

model OutreachConversion {
  id          Int      @id @default(autoincrement())
  serverId    String
  /// Install this conversion belongs to, so re-installs are distinct.
  installedAt DateTime
  /// Ladder rung of the message credited with the conversion.
  ladderStage Int
  convertedAt DateTime @default(now())

  @@unique([serverId, installedAt])
  @@index([ladderStage])
}

model BotState {
  id                        Int       @id @default(1)
  lastSuccessfulPollAt      DateTime?
  reconciliationCompletedAt DateTime?
  // End of the last window ingestion reconciliation backfilled to S3; the next
  // backfill starts at the later of this and lastSuccessfulPollAt.
  backfilledThroughAt       DateTime?
  pollStartedAt             DateTime?
  // Last renewal by the holder of a durable poll claim. A claim goes stale
  // only when both its start and its last renewal are past the bound.
  pollClaimRenewedAt        DateTime?
  pollCompletedAt           DateTime?
  evidenceWatermarkAt       DateTime?
  pollEvidenceComplete      Boolean?
  pollFailureReason         String?
  pollStatus                String    @default("never")
  updatedAt                 DateTime  @updatedAt
}

// A guild the reconcile-removed-guilds sweep saw missing from the client
// cache AND unconfirmed by a live `guilds.fetch` (Discord 10004) on some
// previous day's run. Cleanup only proceeds once a candidate has been
// re-observed as missing on a LATER calendar day than `firstDetectedAt` -
// a single day's outage (Discord region/shard down, cache hydration gap)
// resolves well within 24h, while a real removal stays missing across runs.
// The row is deleted as soon as a run finds the guild reachable again
// (recovered) or after cleanup runs (confirmed and handled).
model GuildRemovalCandidate {
  serverId        String   @id
  firstDetectedAt DateTime
  lastCheckedAt   DateTime
}

// Web-UI initiated subscription changes. Every mutation through the web UI
// records a row so we can audit who added/removed what from outside Discord.
model AuditLog {
  id              Int      @id @default(autoincrement())
  createdAt       DateTime @default(now())
  actorDiscordId  String
  serverId        String
  action          String // AuditAction enum value
  targetChannelId String?
  targetPlayerId  Int?
  targetAccountId Int?
  payload         String // JSON-encoded before/after snapshot
  ipAddress       String?
  userAgent       String?

  @@index([serverId, createdAt])
  @@index([actorDiscordId, createdAt])
}

// Binding or financial actions are prepared as single-use, actor-bound,
// expiring intents. The button/control consumes the intent idempotently after
// a human approves it; nothing writes domain state before that.
//
// `kind` is the sole discriminator and `payload` is its Zod-validated JSON
// body, so the action can never disagree with the payload describing it.
// `serverId` is denormalized from the target at mint time — every guild
// visibility check is a comparison against this column, so it must be derived
// from the row being acted on rather than taken from the caller.
//
// `dareId`/`expectedRevision` are nullable because an intent need not have an
// existing target; a dare intent always sets both, keeping its cascade delete.
model ConfirmationIntent {
  id               String    @id @default(uuid())
  kind             String
  serverId         String
  actorDiscordId   String
  payload          String
  idempotencyKey   String    @unique
  expiresAt        DateTime
  consumedAt       DateTime?
  resultJson       String?
  createdAt        DateTime  @default(now())
  dareId           Int?
  dare             Dare?     @relation(fields: [dareId], references: [id], onDelete: Cascade)
  expectedRevision Int?

  @@index([dareId, expiresAt])
}

// =============================================================================
// Scout Customs — beta-only, guild-scoped custom-game nights
// =============================================================================

/// A separate pointer makes the one-active-night constraint a PostgreSQL
/// invariant while ended nights remain immutable history.
model CustomActiveNight {
  guildId   String      @id
  nightId   String      @unique
  night     CustomNight @relation(fields: [nightId], references: [id], onDelete: Restrict)
  createdAt DateTime    @default(now())
}

model CustomNight {
  id                    String    @id @default(uuid())
  guildId               String
  guildName             String
  launchChannelId       String
  voiceLobbyChannelId   String
  hostDiscordId         String
  state                 String
  revision              Int       @default(0)
  recruitmentMessageId  String?
  recruitmentGeneration Int       @default(0)
  publishedRevision     Int       @default(-1)
  teamAVoiceChannelId   String?
  teamBVoiceChannelId   String?
  lastActivityAt        DateTime
  expiresAt             DateTime
  endedAt               DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  activePointer CustomActiveNight?
  cohosts       CustomNightCohost[]
  participants  CustomNightParticipant[]
  games         CustomGame[]
  auditEvents   CustomAuditEvent[]
  operations    CustomNightOperation[]

  @@index([guildId, createdAt])
  @@index([state, expiresAt])
}

/// One authorized, revision-fenced Customs operation. Temporal owns execution;
/// this record owns progress and external identifiers across gateway restarts.
model CustomNightOperation {
  id               String      @id
  nightId          String
  expectedRevision Int
  actorDiscordId   String
  action           String
  payload          String
  state            String      @default("queued")
  progress         String      @default("{}")
  outcome          String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  night            CustomNight @relation(fields: [nightId], references: [id], onDelete: Cascade)

  @@index([state, createdAt])
  @@index([nightId, createdAt])
}

/// Permanent monotonic latch: a disabled rollout flag cannot restore legacy
/// sends after a stage has committed its first durable operation.
model ScoutOrchestrationCutover {
  id          String   @id
  activatedAt DateTime @default(now())
}

model CustomNightCohost {
  nightId   String
  discordId String
  createdAt DateTime    @default(now())
  night     CustomNight @relation(fields: [nightId], references: [id], onDelete: Cascade)

  @@id([nightId, discordId])
}

/// Consent is append-preserving and guild-scoped. Operator anonymization
/// replaces identifiers; it never deletes the fact that consent was recorded.
model CustomConsent {
  id                String    @id @default(uuid())
  guildId           String
  discordId         String
  disclosureVersion String
  acceptedAt        DateTime
  anonymizedAt      DateTime?
  createdAt         DateTime  @default(now())

  @@unique([guildId, discordId, disclosureVersion])
  @@index([discordId, acceptedAt])
}

model CustomNightParticipant {
  id                String    @id @default(uuid())
  nightId           String
  discordId         String
  displayName       String
  avatarUrl         String?
  role              String
  availability      String
  readyAt           DateTime?
  awayUntil         DateTime?
  held              Boolean   @default(false)
  consentedAt       DateTime
  playerId          Int?
  playerAlias       String?
  selectedAccountId Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  night CustomNight @relation(fields: [nightId], references: [id], onDelete: Cascade)

  @@unique([nightId, discordId])
  @@index([nightId, availability, readyAt])
}

model CustomGame {
  id                 String    @id @default(uuid())
  nightId            String
  sequence           Int
  state              String
  rosterMode         String
  map                String
  pickMode           String
  activeCaptain      String?
  matchId            String?   @unique
  observedLobbyId    String?
  lobbyObservationId String?   @unique
  voiceState         String    @default("IDLE")
  voiceReady         Boolean   @default(false)
  voiceOverride      Boolean   @default(false)
  voiceError         String?
  winner             String?
  createdAt          DateTime  @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  updatedAt          DateTime  @updatedAt

  night        CustomNight             @relation(fields: [nightId], references: [id], onDelete: Cascade)
  participants CustomGameParticipant[]
  auditEvents  CustomAuditEvent[]

  @@unique([nightId, sequence])
  @@index([observedLobbyId])
  @@index([nightId, state])
  @@index([voiceState, updatedAt])
}

model CustomGameParticipant {
  id           String   @id @default(uuid())
  gameId       String
  discordId    String
  displayName  String
  playerId     Int
  playerAlias  String
  accountId    Int
  puuid        String
  riotGameName String?
  riotTagLine  String?
  rosterOrder  Int
  benchOrder   Int?
  team         String?
  side         String?
  captain      Boolean  @default(false)
  pickOrder    Int?
  championId   Int?
  won          Boolean?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  game CustomGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, discordId])
  @@index([gameId, team, pickOrder])
  @@index([puuid])
}

/// Append-only command and integration ledger. Random choices are recorded in
/// payload at the same revision as the mutation that accepted them.
model CustomAuditEvent {
  id        String   @id @default(uuid())
  nightId   String
  gameId    String?
  revision  Int
  actorId   String
  action    String
  payload   String
  source    String   @default("ACTIVITY")
  createdAt DateTime @default(now())

  night CustomNight @relation(fields: [nightId], references: [id], onDelete: Restrict)
  game  CustomGame? @relation(fields: [gameId], references: [id], onDelete: Restrict)

  @@index([nightId, revision])
  @@index([gameId, createdAt])
  @@index([actorId, createdAt])
}

/// Durable handoff for work created by request/gateway code before Temporal
