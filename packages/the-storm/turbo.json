{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // Two independent chains, so each cache key covers only what its work
    // reads.
    // GRADLE_BUILD_CACHE_* carries CI's remote build cache identity
    // (plugin/settings.gradle.kts); it selects where outputs come from, not
    // what a task produces, so it stays out of task hashes.
    //
    // JVM: build → typecheck:jvm → lint:jvm → test:ci:jvm. Gradle reads
    // nothing from the TypeScript workspace graph, so this chain has no
    // ^build edge, and a change to mc-harness, delivery or the version catalog
    // no longer re-runs the plugin suite. Its inputs name every file outside
    // plugin/ and client/ that Gradle packages or tests. Every task is a
    // separate Gradle process on the same project directory, and concurrent
    // Gradle builds overwrite each other's class files (CI build 17316: "bad
    // class file ... NoSuchFileException"), so the chain stays serial.
    //
    // No task reads Markdown, so README and docs edits never re-run a suite.
    //
    // TS tools: typecheck:ts, lint:ts and test:ci:tools never start Gradle.
    // They import mc-harness and mc-build source, so they keep ^build to hash
    // those packages.
    //
    // typecheck, lint and test:ci have no package script: they are transit
    // tasks that run both chains. MISE_DATA_DIR and JAVA_HOME must pass
    // through or strict env mode hides the mise-managed JDK/Gradle.
    "build": {
      "dependsOn": [],
      "inputs": [
        "client/**",
        "plugin/**",
        "server/owned/plugins/TheStorm/**",
        "server/patches/coreprotect.json",
        "public-status.json",
        "tools/learning/evaluation.json",
        "tools/learning/maps/protocol.json",
        "$TURBO_ROOT$/packages/mc-harness/src/protocol/evidence-contract.json",
        "$TURBO_ROOT$/packages/storm-brain/contracts/**",
        "!**/*.md",
        "!plugin/**/build/**",
        "!plugin/**/.gradle/**",
        "!client/**/build/**",
        "!client/**/.gradle/**"
      ],
      "outputs": ["plugin/dist/build/libs/TheStorm.jar"],
      "passThroughEnv": [
        "MISE_DATA_DIR",
        "JAVA_HOME",
        "GRADLE_USER_HOME",
        "GRADLE_OPTS",
        "GRADLE_BUILD_CACHE_*"
      ]
    },
    "typecheck:jvm": {
      "dependsOn": ["build"],
      "inputs": [
        "client/**",
        "plugin/**",
        "server/owned/plugins/TheStorm/**",
        "server/patches/coreprotect.json",
        "public-status.json",
        "tools/learning/evaluation.json",
        "tools/learning/maps/protocol.json",
        "$TURBO_ROOT$/packages/mc-harness/src/protocol/evidence-contract.json",
        "$TURBO_ROOT$/packages/storm-brain/contracts/**",
        "!**/*.md",
        "!plugin/**/build/**",
        "!plugin/**/.gradle/**",
        "!client/**/build/**",
        "!client/**/.gradle/**"
      ],
      "outputs": [],
      "passThroughEnv": [
        "MISE_DATA_DIR",
        "JAVA_HOME",
        "GRADLE_USER_HOME",
        "GRADLE_OPTS",
        "GRADLE_BUILD_CACHE_*"
      ]
    },
    "lint:jvm": {
      "dependsOn": ["typecheck:jvm"],
      "inputs": [
        "client/**",
        "plugin/**",
        "server/owned/plugins/TheStorm/**",
        "server/patches/coreprotect.json",
        "public-status.json",
        "tools/learning/evaluation.json",
        "tools/learning/maps/protocol.json",
        "$TURBO_ROOT$/packages/mc-harness/src/protocol/evidence-contract.json",
        "$TURBO_ROOT$/packages/storm-brain/contracts/**",
        "!**/*.md",
        "!plugin/**/build/**",
        "!plugin/**/.gradle/**",
        "!client/**/build/**",
        "!client/**/.gradle/**"
      ],
      "outputs": [],
      "passThroughEnv": [
        "MISE_DATA_DIR",
        "JAVA_HOME",
        "GRADLE_USER_HOME",
        "GRADLE_OPTS",
        "GRADLE_BUILD_CACHE_*"
      ]
    },
    // The plugin's archive and world-maintenance tests run Python from
    // server/ inside the tools/learning uv project.
    "test:ci:jvm": {
      "dependsOn": ["lint:jvm"],
      "env": ["NODE_ENV"],
      "inputs": [
        "$TURBO_ROOT$/scripts/ci/ci-reporting.ts",
        "$TURBO_ROOT$/scripts/ci/test-manifest-schema.ts",
        "$TURBO_ROOT$/scripts/ci/mstest-configuration.ts",
        "$TURBO_ROOT$/scripts/ci/gradle-junit.ts",
        "ci-tests.json",
        "$TURBO_ROOT$/scripts/ci/run-ci-test.ts",
        "client/**",
        "plugin/**",
        "server/**",
        "public-status.json",
        "package.json",
        "tools/learning/**",
        "$TURBO_ROOT$/packages/mc-harness/src/protocol/evidence-contract.json",
        "$TURBO_ROOT$/packages/storm-brain/contracts/**",
        "!**/*.md",
        "!plugin/**/build/**",
        "!plugin/**/.gradle/**",
        "!client/**/build/**",
        "!client/**/.gradle/**",
        "!tools/**/.venv/**",
        "!tools/**/.cache/**",
        "!**/__pycache__/**"
      ],
      "outputs": [],
      "passThroughEnv": [
        "MISE_DATA_DIR",
        "JAVA_HOME",
        "GRADLE_USER_HOME",
        "GRADLE_OPTS",
        "GRADLE_BUILD_CACHE_*"
      ]
    },
    "typecheck:ts": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!plugin/**",
        "!client/**",
        "!tools/**/.venv/**",
        "!tools/**/.cache/**",
        "!**/__pycache__/**"
      ],
      "outputs": [],
      "passThroughEnv": ["MISE_DATA_DIR"]
    },
    "lint:ts": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        // check:managed-flags compares the plugin's Java Flipt clients with
        // the shared inventory.
        "$TURBO_ROOT$/packages/feature-flags/src/managed-flag-inventory.json",
        "!**/*.md",
        "!plugin/**/build/**",
        "!plugin/**/.gradle/**",
        "!client/**",
        "!tools/**/.venv/**",
        "!tools/**/.cache/**",
        "!**/__pycache__/**"
      ],
      "outputs": [],
      "passThroughEnv": ["MISE_DATA_DIR"]
    },
    "test:ci:tools": {
      "dependsOn": ["^build"],
      "env": ["NODE_ENV"],
      "inputs": [
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/ci/ci-reporting.ts",
        "$TURBO_ROOT$/scripts/ci/test-manifest-schema.ts",
        "$TURBO_ROOT$/scripts/ci/mstest-configuration.ts",
        "$TURBO_ROOT$/scripts/ci/gradle-junit.ts",
        "$TURBO_ROOT$/scripts/ci/run-ci-test.ts",
        "!**/*.md",
        "!plugin/**/build/**",
        "!plugin/**/.gradle/**",
        "!client/**/build/**",
        "!client/**/.gradle/**",
        "!tools/**/.venv/**",
        "!tools/**/.cache/**",
        "!**/__pycache__/**"
      ],
      "outputs": [],
      "passThroughEnv": ["MISE_DATA_DIR"]
    },
    "typecheck": {
      "dependsOn": ["typecheck:jvm", "typecheck:ts"]
    },
    "lint": {
      "dependsOn": ["lint:jvm", "lint:ts"]
    },
    "test:ci": {
      "dependsOn": ["test:ci:jvm", "test:ci:tools"]
    },
    // The full local suite: every Gradle and TypeScript test.
    "test": {
      "dependsOn": ["lint"],
      "inputs": [
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/mc-harness/src/protocol/evidence-contract.json",
        "$TURBO_ROOT$/packages/storm-brain/contracts/**",
        "!**/*.md",
        "!plugin/**/build/**",
        "!plugin/**/.gradle/**",
        "!client/**/build/**",
        "!client/**/.gradle/**",
        "!tools/**/.venv/**",
        "!tools/**/.cache/**",
        "!**/__pycache__/**"
      ],
      "outputs": [],
      "passThroughEnv": [
        "MISE_DATA_DIR",
        "JAVA_HOME",
        "GRADLE_USER_HOME",
        "GRADLE_OPTS",
        "GRADLE_BUILD_CACHE_*"
      ]
    },
    // Real-server e2e against the built TheStorm.jar in a disposable Paper
    // container (tests/e2e). Uncached: it exercises Docker and live network
    // pins. STORM_E2E_* selects a CI sidecar server instead of local Docker.
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": [
        "DOCKER_HOST",
        "DOCKER_CONTEXT",
        "DOCKER_CONFIG",
        "STORM_E2E_*"
      ]
    }
  }
}
