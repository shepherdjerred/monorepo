{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "number",
      "const": 1
    },
    "session": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "captures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "cli": {
            "type": "string"
          },
          "transport": {
            "type": "string",
            "enum": ["http", "websocket"]
          },
          "format": {
            "type": "string",
            "enum": [
              "anthropic-messages",
              "openai-responses",
              "openai-chat",
              "unknown"
            ]
          },
          "host": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sessionId": {
            "type": ["string", "null"]
          },
          "cwd": {
            "type": ["string", "null"]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "endedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "durationMs": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "model": {
            "type": ["string", "null"]
          },
          "status": {
            "type": "string",
            "enum": ["pending", "ok", "error", "incomplete"]
          },
          "httpStatus": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "type": ["string", "null"]
          },
          "usage": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "inputTokens": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "outputTokens": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "cacheReadTokens": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "cacheCreationTokens": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "cachedInputTokens": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "reasoningTokens": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "inputTokens",
                  "outputTokens",
                  "cacheReadTokens",
                  "cacheCreationTokens",
                  "cachedInputTokens",
                  "reasoningTokens"
                ],
                "additionalProperties": false,
                "title": "HistoryApiCaptureUsage"
              },
              {
                "type": "null"
              }
            ]
          },
          "context": {
            "type": "object",
            "properties": {
              "systemBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "toolsBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "historyBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "newBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "systemBytes",
              "toolsBytes",
              "historyBytes",
              "newBytes"
            ],
            "additionalProperties": false,
            "title": "HistoryApiCaptureContext"
          },
          "blockCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "newBlockCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "contextComplete": {
            "type": "boolean"
          },
          "previousCaptureId": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "cli",
          "transport",
          "format",
          "host",
          "path",
          "sessionId",
          "cwd",
          "startedAt",
          "endedAt",
          "durationMs",
          "model",
          "status",
          "httpStatus",
          "error",
          "usage",
          "context",
          "blockCount",
          "newBlockCount",
          "contextComplete",
          "previousCaptureId"
        ],
        "additionalProperties": false,
        "title": "HistoryApiCapture"
      }
    },
    "hasMore": {
      "type": "boolean"
    }
  },
  "required": ["apiVersion", "session", "captures", "hasMore"],
  "additionalProperties": false,
  "title": "HistoryApiCapturesResponse"
}
