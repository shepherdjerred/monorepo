+
+/* AVL generic tables keep each element behind an RTL_BALANCED_LINKS header, as
+ * on Windows; the real tree root hangs off BalancedRoot.RightChild. The tree is
+ * kept ordered but is not rebalanced. */
+
+static inline void *avl_node_data( RTL_BALANCED_LINKS *node )
+{
+    return node + 1;
+}
+
+static inline RTL_BALANCED_LINKS *avl_root( RTL_AVL_TABLE *table )
+{
+    return table->BalancedRoot.RightChild;
+}
+
+static RTL_BALANCED_LINKS *avl_find( RTL_AVL_TABLE *table, void *buffer, RTL_BALANCED_LINKS **parent,
+                                     RTL_GENERIC_COMPARE_RESULTS *result )
+{
+    RTL_BALANCED_LINKS *node = avl_root( table );
+
+    *parent = &table->BalancedRoot;
+    *result = GenericGreaterThan;
+    while (node)
+    {
+        *parent = node;
+        *result = table->CompareRoutine( table, buffer, avl_node_data( node ) );
+        if (*result == GenericEqual) return node;
+        node = *result == GenericLessThan ? node->LeftChild : node->RightChild;
+    }
+    return NULL;
+}
+
+static RTL_BALANCED_LINKS *avl_leftmost( RTL_BALANCED_LINKS *node )
+{
+    while (node && node->LeftChild) node = node->LeftChild;
+    return node;
+}
+
+static void avl_replace_child( RTL_AVL_TABLE *table, RTL_BALANCED_LINKS *node, RTL_BALANCED_LINKS *child )
+{
+    RTL_BALANCED_LINKS *parent = node->Parent;
+
+    if (parent == &table->BalancedRoot || parent->RightChild == node) parent->RightChild = child;
+    else parent->LeftChild = child;
+    if (child) child->Parent = parent;
 }
 
