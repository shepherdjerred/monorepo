{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ops service catalog",
  "description": "Joins namespaces, ArgoCD apps, Bugsink projects, analytics sites, and Grafana dashboards under one service id.",
  "type": "object",
  "required": ["services"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "platformDeliveryDelegated": {
      "description": "Reviewed root/OpenTofu mutation owner policy; selected versions and plans remain in PostgreSQL.",
      "type": "boolean"
    },
    "deliveryDelegations": {
      "description": "Reviewed release-owner policy only; selected versions remain in PostgreSQL.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "kind", "namespaces", "argoApps"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["product", "workload", "platform"] },
          "package": { "type": "string", "minLength": 1 },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
          },
          "namespaces": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "argoApps": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "images": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "bootstrapImages": {
            "description": "Canonical first-party image references used by this service's bootstrap; image ownership remains with the producer.",
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "charts": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "rootReleaseExclusions": {
            "description": "Reviewed upstream or inactive chart exclusions; selected versions remain in PostgreSQL.",
            "type": "object",
            "additionalProperties": { "enum": ["upstream", "inactive"] }
          },
          "bugsinkProjects": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "analyticsSites": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "grafanaDashboards": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "deploy": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "versionKey", "argoApp"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "versionKey": { "type": "string", "minLength": 1 },
                "argoApp": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
