      "tips": [
        {
          "id": "adc:Corki:general:0",
          "text": "Keep attacking while Gatling Gun runs; you can fire it and auto at the same time. Use it up close, since it hits a short cone in front of him.",
          "refs": [
            { "kind": "ability", "key": "Corki-E", "start": 21, "end": 32 }
          ],
          "pWrong": 0.08
        },
        {
          "id": "adc:Corki:general:1",
          "text": "Face the enemy before you start Gatling Gun. Corki fires toward where he is facing, so the cone can miss if you turn the wrong way.",
          "refs": [
            { "kind": "ability", "key": "Corki-E", "start": 32, "end": 43 },
            { "kind": "champion", "key": "Corki", "start": 45, "end": 50 }
          ],
          "pWrong": 0.09
        },
        {
          "id": "adc:Corki:general:2",
          "text": "Throw Phosphorus Bomb into nearby brush to find hidden enemies. It also reveals any champion it hits.",
          "refs": [
            { "kind": "ability", "key": "Corki-Q", "start": 6, "end": 21 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "adc:Corki:general:3",
          "text": "Use Valkyrie to escape or to reposition in a fight. You can fire Gatling Gun while you fly.",
          "refs": [
            { "kind": "ability", "key": "Corki-W", "start": 4, "end": 12 },
            { "kind": "ability", "key": "Corki-E", "start": 65, "end": 76 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "adc:Corki:general:4",
          "text": "Poke with Missile Barrage from long range. It splashes, so you can hit enemies standing behind their minions.",
          "refs": [
            { "kind": "ability", "key": "Corki-R", "start": 10, "end": 25 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "adc:Corki:general:5",
          "text": "Count your missiles. Every third Missile Barrage is a Big One with more range and damage, so save it to finish a weakened enemy.",
          "refs": [
            { "kind": "ability", "key": "Corki-R", "start": 33, "end": 48 }
          ],
          "pWrong": 0.65
        },
        {
          "id": "adc:Corki:general:6",
          "text": "Auto-attack enemy champions between missiles. Each hit on a champion shortens the wait for your next Missile Barrage charge.",
          "refs": [
            { "kind": "ability", "key": "Corki-R", "start": 101, "end": 116 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "adc:Corki:general:7",
          "text": "Corki is exposed after Valkyrie, so don't use it to dive in without a plan. Enemies will switch to him when he lands.",
          "refs": [
            { "kind": "champion", "key": "Corki", "start": 0, "end": 5 },
            { "kind": "ability", "key": "Corki-W", "start": 23, "end": 31 }
          ],
          "pWrong": 0.06
        }
      ],
      "combos": [
        {
          "id": "adc:Corki:combo:0",
          "name": "Gatling attack-turn",
          "category": "trick",
          "sequence": [{ "kind": "ability", "key": "Corki-E" }, "attack"],
          "when": "Trading in lane while Gatling Gun is running and your target is not in the cone.",
          "whenRefs": [
            { "kind": "ability", "key": "Corki-E", "start": 22, "end": 33 }
          ],
          "text": "Give an attack order on the enemy champion during Gatling Gun. Corki turns to face them instantly, and you keep the cone on them while auto attacking.",
          "textRefs": [
            { "kind": "ability", "key": "Corki-E", "start": 50, "end": 61 },
            { "kind": "champion", "key": "Corki", "start": 63, "end": 68 }
          ]
        }
      ]
    }
