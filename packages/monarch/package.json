{
  "name": "@shepherdjerred/monarch",
  "version": "0.1.0",
  "description": "Monarch Money transaction classifier using OpenRouter + Amazon order matching",
  "type": "module",
  "bin": {
    "monarch-classify": "./src/index.ts"
  },
  "scripts": {
    "login": "bun run scripts/monarch-browser-login.ts",
    "login:password": "bun run scripts/monarch-login.ts",
    "login:browser": "bun run scripts/monarch-browser-login.ts",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "lint": "bunx eslint . && check-architecture",
    "test:ci": "bun ../../scripts/ci/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../scripts/ci/run-ci-test.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.4-r.1",
    "@shepherdjerred/llm-models": "workspace:*",
    "@shepherdjerred/llm-runtime": "workspace:*",
    "ai": "7.0.114",
    "pdfjs-dist": "^6.3.289",
    "playwright": "1.63.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shepherdjerred/architecture": "workspace:*",
    "@shepherdjerred/eslint-config": "workspace:*",
    "bun-types": "1.4.2",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "vitest": "5.0.1",
    "@vitest/coverage-istanbul": "5.0.1"
  },
  "author": "Jerred Shepherd",
  "license": "GPL-3.0",
  "imports": {
    "#architecture": "./architecture.config.ts"
  }
}
