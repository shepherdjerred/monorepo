{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ops service catalog",
  "description": "Joins namespaces, ArgoCD apps, Bugsink projects, analytics sites, and Grafana dashboards under one service id.",
  "type": "object",
  "required": ["services"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "kind", "namespaces", "argoApps"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["product", "workload", "platform"] },
          "package": { "type": "string", "minLength": 1 },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
          },
          "namespaces": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "argoApps": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "bugsinkProjects": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "analyticsSites": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "grafanaDashboards": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "deploy": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "versionKey", "argoApp"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "versionKey": { "type": "string", "minLength": 1 },
                "argoApp": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
