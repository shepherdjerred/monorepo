{
  "output": {
    "delivery_observer_onepassword_item_id": {
      "description": "1Password item UUID for the read-only Delivery ArgoCD recovery token",
      "value": "${onepassword_item.argocd_delivery_observer_token.uuid}"
    },
    "delivery_onepassword_item_id": {
      "description": "1Password item UUID for the scoped Delivery ArgoCD token",
      "value": "${onepassword_item.argocd_delivery_token.uuid}"
    },
    "delivery_platform_onepassword_item_id": {
      "description": "Issued dedicated platform ArgoCD item; register as platformArgocd before enabling platform execution",
      "value": "${onepassword_item.argocd_delivery_platform_token.uuid}"
    },
    "homelab_audit_onepassword_item_id": {
      "description": "1Password item UUID for the read-only homelab-audit ArgoCD token",
      "value": "${onepassword_item.argocd_homelab_audit_token.uuid}"
    },
    "operator_run_onepassword_item_id": {
      "description": "1Password item UUID for the operator tool's ArgoCD token for operator-run Applications",
      "value": "${onepassword_item.argocd_operator_run_token.uuid}"
    },
    "workstation_onepassword_item_id": {
      "description": "1Password item UUID for the read-only workstation ArgoCD token toolkit uses",
      "value": "${onepassword_item.argocd_workstation_token.uuid}"
    }
  },
  "provider": {
    "argocd": [
      {
        "auth_token": "${var.argocd_auth_token}",
        "server_addr": "argocd.tailnet-1a49.ts.net:443"
      }
    ],
    "onepassword": [{}]
  },
  "resource": {
    "argocd_account_token": {
      "delivery": { "account": "delivery" },
      "delivery_observer": { "account": "delivery-observer" },
      "delivery_platform": { "account": "delivery-platform" },
      "homelab_audit": { "account": "homelab-audit" },
      "operator_run": { "account": "operator-run" },
      "workstation": { "account": "workstation" }
    },
    "onepassword_item": {
      "argocd_delivery_observer_token": {
        "section": [
          {
            "field": [
              {
                "label": "ARGOCD_RECOVERY_TOKEN",
                "type": "CONCEALED",
                "value": "${argocd_account_token.delivery_observer.jwt}"
              }
            ],
            "label": "tokens"
          }
        ],
        "title": "delivery-argocd-observer-token",
        "vault": "v64ocnykdqju4ui6j6pua56xw4"
      },
      "argocd_delivery_platform_token": {
        "section": [
          {
            "field": [
              {
                "label": "ARGOCD_TOKEN",
                "type": "CONCEALED",
                "value": "${argocd_account_token.delivery_platform.jwt}"
              }
            ],
            "label": "tokens"
          }
        ],
        "title": "delivery-argocd-platform-token",
        "vault": "v64ocnykdqju4ui6j6pua56xw4"
      },
      "argocd_delivery_token": {
        "section": [
          {
            "field": [
              {
                "label": "ARGOCD_TOKEN",
                "type": "CONCEALED",
                "value": "${argocd_account_token.delivery.jwt}"
              }
            ],
            "label": "tokens"
          }
        ],
        "title": "delivery-argocd-token",
        "vault": "v64ocnykdqju4ui6j6pua56xw4"
      },
      "argocd_homelab_audit_token": {
        "section": [
          {
            "field": [
              {
                "label": "ARGOCD_AUTH_TOKEN",
                "type": "CONCEALED",
                "value": "${argocd_account_token.homelab_audit.jwt}"
              }
            ],
            "label": "tokens"
          }
        ],
        "title": "argocd-homelab-audit-token",
        "vault": "v64ocnykdqju4ui6j6pua56xw4"
      },
      "argocd_operator_run_token": {
        "section": [
          {
            "field": [
              {
                "label": "ARGOCD_TOKEN",
                "type": "CONCEALED",
                "value": "${argocd_account_token.operator_run.jwt}"
              }
            ],
            "label": "tokens"
          }
        ],
        "title": "delivery-argocd-operator-run-token",
        "vault": "v64ocnykdqju4ui6j6pua56xw4"
      },
      "argocd_workstation_token": {
        "section": [
          {
            "field": [
              {
                "label": "ARGOCD_AUTH_TOKEN",
                "type": "CONCEALED",
                "value": "${argocd_account_token.workstation.jwt}"
              }
            ],
            "label": "tokens"
          }
        ],
        "title": "argocd-workstation-token",
        "vault": "v64ocnykdqju4ui6j6pua56xw4"
      }
    }
  },
  "terraform": {
    "backend": {
      "s3": {
        "bucket": "homelab-tofu-state",
        "endpoints": { "s3": "https://seaweedfs-s3.tailnet-1a49.ts.net" },
        "key": "argocd/terraform.tfstate",
        "region": "auto",
        "skip_credentials_validation": true,
        "skip_metadata_api_check": true,
        "skip_region_validation": true,
        "skip_requesting_account_id": true,
        "skip_s3_checksum": true,
        "use_lockfile": true,
        "use_path_style": true
      }
    },
    "required_providers": {
      "argocd": { "source": "argoproj-labs/argocd", "version": "~> 7.0" },
      "onepassword": { "source": "1password/onepassword", "version": "~> 3.0" }
    },
    "required_version": ">= 1.6.0"
  },
  "variable": {
    "argocd_auth_token": {
      "description": "Token of the tofu-argocd ArgoCD account, which may only read and issue tokens for the Delivery accounts this stack mints",
      "sensitive": true,
      "type": "string"
    }
  }
}
