{
  "name": "@shepherdjerred/incidents",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "exports": {
    "./contract": "./src/shared/contract.ts",
    "./alert-rules": "./src/shared/alert-rules.ts",
    "./router": "./src/router.ts",
    "./hub-server": "./src/server/hub-server.ts"
  },
  "imports": {
    "#generated/*": "./generated/*",
    "#architecture": "./architecture.config.ts",
    "#*": "./src/*"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "lint": "eslint . --max-warnings=0 && check-architecture",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run src --exclude '**/*.integration.test.ts' --testTimeout 30000 --hookTimeout 30000",
    "test:extended": "bun ../../scripts/ci/run-ci-test.ts --tier extended",
    "test:ci": "bun ../../scripts/ci/run-ci-test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/client-runtime-utils": "7.10.1",
    "@shepherdjerred/config": "workspace:*",
    "@shepherdjerred/feature-flags": "workspace:*",
    "@trpc/server": "^11.18.0",
    "hono": "^4.12.18",
    "prisma": "^7.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shepherdjerred/architecture": "workspace:*",
    "@shepherdjerred/eslint-config": "workspace:*",
    "@shepherdjerred/test-postgres": "workspace:*",
    "@types/bun": "1.4.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-istanbul": "5.0.5",
    "eslint": "^10.7.0",
    "typescript": "^6.0.3",
    "vitest": "5.0.5"
  }
}
