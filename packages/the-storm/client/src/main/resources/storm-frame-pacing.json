{
  "version": 1,
  "kind": "rwf-native-frame-pacing",
  "source": "game-renderer-tail-monotonic-nanos",
  "maximumDurationMs": 60000,
  "maximumFrames": 36000,
  "quantile": "nearest-rank",
  "status": ["name", "state", "frames", "error", "receipt"],
  "receipt": [
    "schema",
    "kind",
    "source",
    "complete",
    "error",
    "name",
    "world",
    "requestedDurationMs",
    "requestedFrames",
    "completion",
    "observedElapsedNanos",
    "measuredDurationNanos",
    "tailNanos",
    "settings",
    "runtime",
    "observations",
    "quantiles"
  ],
  "observation": [
    "index",
    "elapsedNanos",
    "intervalNanos",
    "worldTick",
    "focused",
    "screenOpen",
    "effectiveFpsCap",
    "camera"
  ],
  "quantiles": [
    "intervals",
    "meanNanos",
    "p50Nanos",
    "p95Nanos",
    "p99Nanos",
    "maxNanos"
  ],
  "settings": [
    "width",
    "height",
    "windowWidth",
    "windowHeight",
    "fpsCap",
    "vsync",
    "renderDistance",
    "effectiveRenderDistance",
    "simulationDistance",
    "graphicsPreset",
    "fullscreen",
    "fov"
  ],
  "runtime": [
    "javaVersion",
    "javaVendor",
    "osName",
    "osVersion",
    "osArch",
    "minecraftVersion",
    "gpuName",
    "gpuVendor",
    "gpuDriver",
    "gpuBackend",
    "code"
  ],
  "code": ["file", "sha256"],
  "camera": ["x", "y", "z", "yaw", "pitch"],
  "codeResources": [
    "FramePacing.class",
    "FramePacing$Settings.class",
    "FramePacing$RendererRuntime.class",
    "FramePacing$Code.class",
    "FramePacing$Run.class",
    "FramePacing$Receipt.class",
    "FramePacing$Status.class",
    "FramePacingClock.class",
    "FramePacingClock$Observation.class",
    "FramePacingClock$Camera.class",
    "FramePacingClock$RenderObservation.class",
    "FramePacingClock$Quantiles.class",
    "RenderCapture.class",
    "ClientActions.class",
    "mixin/FrameRenderMixin.class",
    "/storm-frame-pacing.json"
  ]
}
