{
  "extends": [
    "@tsconfig/strictest/tsconfig.json",
    "@tsconfig/node-lts/tsconfig.json",
    "@tsconfig/recommended/tsconfig.json"
  ],
  "compilerOptions": {
    "types": ["@types/bun"],
    "moduleResolution": "Node16",
    "module": "Node16",
    "target": "ES2022",
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "test", "eslint.config.ts"]
}
