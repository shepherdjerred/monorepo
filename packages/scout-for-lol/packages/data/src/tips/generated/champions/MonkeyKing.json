      "tips": [
        {
          "id": "jungle:MonkeyKing:general:0",
          "text": "Fight monsters and champions to build Stone Skin stacks; Wukong gets tougher and heals more the longer he keeps hitting things.",
          "refs": [
            {
              "kind": "ability",
              "key": "MonkeyKing-passive",
              "start": 38,
              "end": 48
            },
            { "kind": "champion", "key": "MonkeyKing", "start": 57, "end": 63 }
          ],
          "pWrong": 0.18
        },
        {
          "id": "jungle:MonkeyKing:general:1",
          "text": "Use Crushing Blow right before your next attack; the extra range lets you hit first and it strips the target's Armor.",
          "refs": [
            { "kind": "ability", "key": "MonkeyKing-Q", "start": 4, "end": 17 }
          ],
          "pWrong": 0.19
        },
        {
          "id": "jungle:MonkeyKing:general:2",
          "text": "Hit anything with attacks and abilities to bring Crushing Blow back sooner, so use it again and again in a fight.",
          "refs": [
            { "kind": "ability", "key": "MonkeyKing-Q", "start": 49, "end": 62 }
          ],
          "pWrong": 0.03
        },
        {
          "id": "jungle:MonkeyKing:general:3",
          "text": "Dash in with Nimbus Strike, then use Warrior Trickster to slip away or confuse the enemy about which one is the real Wukong.",
          "refs": [
            {
              "kind": "ability",
              "key": "MonkeyKing-E",
              "start": 13,
              "end": 26
            },
            {
              "kind": "ability",
              "key": "MonkeyKing-W",
              "start": 37,
              "end": 54
            },
            {
              "kind": "champion",
              "key": "MonkeyKing",
              "start": 117,
              "end": 123
            }
          ],
          "pWrong": 0.02
        },
        {
          "id": "jungle:MonkeyKing:general:4",
          "text": "Cast Warrior Trickster near brush so the enemy reacts to the wrong Wukong.",
          "refs": [
            { "kind": "ability", "key": "MonkeyKing-W", "start": 5, "end": 22 },
            { "kind": "champion", "key": "MonkeyKing", "start": 67, "end": 73 }
          ],
          "pWrong": 0.03
        },
        {
          "id": "jungle:MonkeyKing:general:5",
          "text": "Nimbus Strike hits up to two more enemies near your target, so start team fights by jumping onto a target with other enemies close to it.",
          "refs": [
            { "kind": "ability", "key": "MonkeyKing-E", "start": 0, "end": 13 }
          ],
          "pWrong": 0.09
        },
        {
          "id": "jungle:MonkeyKing:general:6",
          "text": "Save Cyclone for a fight where several enemies are bunched up; it knocks them up and hurts high-health targets.",
          "refs": [
            { "kind": "ability", "key": "MonkeyKing-R", "start": 5, "end": 12 }
          ],
          "pWrong": 0.05
        },
        {
          "id": "jungle:MonkeyKing:general:7",
          "text": "Your clone copies Cyclone when you cast it, so make a clone with Warrior Trickster first to add damage.",
          "refs": [
            {
              "kind": "ability",
              "key": "MonkeyKing-R",
              "start": 18,
              "end": 25
            },
            { "kind": "ability", "key": "MonkeyKing-W", "start": 65, "end": 82 }
