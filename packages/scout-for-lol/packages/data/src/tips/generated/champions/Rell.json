      "tips": [
        {
          "id": "support:Rell:general:0",
          "text": "Stun enemies with Shattering Strike when they step up to last-hit or poke. It also destroys their shields, so use it when an enemy shield is up.",
          "refs": [
            { "kind": "ability", "key": "Rell-Q", "start": 18, "end": 35 }
          ],
          "pWrong": 0.08
        },
        {
          "id": "support:Rell:general:1",
          "text": "Leap in with Ferromancy: Crash Down to knock enemies up, then take the shield it gives you. Cast it when your team can follow up on the stun.",
          "refs": [
            { "kind": "ability", "key": "Rell-W", "start": 13, "end": 35 }
          ],
          "pWrong": 0.33
        },
        {
          "id": "support:Rell:general:2",
          "text": "Use Ferromancy: Mount Up after the leap. Your next attack charges at the target and stuns them, so aim it at the enemy you want to catch.",
          "refs": [],
          "pWrong": 0.15
        },
        {
          "id": "support:Rell:general:3",
          "text": "Cast Full Tilt on your carry to engage or disengage together. Turn to face an enemy or your ally and you both get the bigger speed boost.",
          "refs": [
            { "kind": "ability", "key": "Rell-E", "start": 5, "end": 14 }
          ],
          "pWrong": 0.06
        },
        {
          "id": "support:Rell:general:4",
          "text": "Follow Full Tilt with Shattering Strike. The empowered hit explodes around the target for extra damage.",
          "refs": [
            { "kind": "ability", "key": "Rell-E", "start": 7, "end": 16 },
            { "kind": "ability", "key": "Rell-Q", "start": 22, "end": 39 }
          ],
          "pWrong": 0.32
        },
        {
          "id": "support:Rell:general:5",
          "text": "Save Magnet Storm for when enemies are grouped up in a fight. It pulls them to you and keeps dragging them while it damages them.",
          "refs": [
            { "kind": "ability", "key": "Rell-R", "start": 5, "end": 17 }
          ],
          "pWrong": 0.03
        },
        {
          "id": "support:Rell:general:6",
          "text": "Keep hitting enemies with attacks and abilities. Break the Mold lowers their resistances and raises yours, so you get tankier the longer a fight lasts.",
          "refs": [
            { "kind": "ability", "key": "Rell-passive", "start": 49, "end": 63 }
          ],
          "pWrong": 0.3
        }
      ],
      "combos": [
        {
          "id": "support:Rell:combo:0",
          "name": "Mount Up charge follow-up",
          "category": "combo",
          "sequence": [
            { "kind": "ability", "key": "Rell-W" },
            { "kind": "ability", "key": "Rell-R" },
            { "kind": "ability", "key": "Rell-W" },
