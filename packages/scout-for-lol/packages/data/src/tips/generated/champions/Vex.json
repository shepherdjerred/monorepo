  "general": [
    {
      "lane": "middle",
      "inputHash": "0952d34692dee6945d22c39f972a30598d1239a0b0bcac4f6adbc1b1b8692a94",
      "tips": [
        {
          "id": "middle:Vex:general:0",
          "text": "Hold Personal Space for when an enemy dashes or jumps at you; the shield and shockwave punish them and the shockwave reaches a bit further against dashers.",
          "refs": [
            { "kind": "ability", "key": "Vex-W", "start": 5, "end": 19 }
          ],
          "pWrong": 0.21
        },
        {
          "id": "middle:Vex:general:1",
          "text": "Poke with Mistral Bolt from long range. It is a wave, so you can hit several enemies, and it gets faster and narrower after a short delay.",
          "refs": [
            { "kind": "ability", "key": "Vex-Q", "start": 10, "end": 22 }
          ],
          "pWrong": 0.06
        },
        {
          "id": "middle:Vex:general:2",
          "text": "Use Looming Darkness to leave enemies slowed before you trade. It cannot detonate Gloom, so follow it with another ability or a basic attack.",
          "refs": [
            { "kind": "ability", "key": "Vex-E", "start": 4, "end": 20 },
            { "kind": "keyword", "key": "slowed", "start": 38, "end": 44 }
          ],
          "pWrong": 0.23
        },
        {
          "id": "middle:Vex:general:3",
          "text": "When an enemy dashes or blinks near you, hit them with a basic ability or attack to pop their Gloom for extra damage and a shorter Doom cooldown.",
          "refs": [],
          "pWrong": 0.01
        },
        {
          "id": "middle:Vex:general:4",
          "text": "Cast an ability when Doom is ready. It fears enemies and stops their dashes, which is a strong way to peel for yourself or start a fight.",
          "refs": [],
          "pWrong": 0.97,
          "hidden": true
        },
        {
          "id": "middle:Vex:general:5",
          "text": "Fire Shadow Surge at a champion you can kill, then recast to dash to them. You cannot recast while rooted, so use it before you get caught.",
          "refs": [
            { "kind": "ability", "key": "Vex-R", "start": 5, "end": 17 },
            { "kind": "keyword", "key": "rooted", "start": 99, "end": 105 }
          ],
          "pWrong": 0.22
        },
        {
          "id": "middle:Vex:general:6",
          "text": "If your target dies after Shadow Surge marks them, cast it again right away to chain onto the next champion in a teamfight.",
          "refs": [
            { "kind": "ability", "key": "Vex-R", "start": 26, "end": 38 }
          ],
          "pWrong": 0.88
        }
      ],
      "combos": [
        {
          "id": "middle:Vex:combo:0",
          "name": "Doom E fear",
          "category": "trick",
          "sequence": [{ "kind": "ability", "key": "Vex-E" }],
          "when": "When Doom is ready and you want the fear to land on enemies you can't reach with your other spells.",
          "whenRefs": [],
          "text": "Looming Darkness can carry the empowered fear. Enemies flee from the blast's center instead of from Vex, so you can fear them away from your position.",
          "textRefs": [
            { "kind": "ability", "key": "Vex-E", "start": 0, "end": 16 },
            { "kind": "champion", "key": "Vex", "start": 100, "end": 103 }
          ]
        }
      ]
    }
  ],
