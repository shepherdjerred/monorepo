{
  "mcpServers": {
    "grafana": {
      "command": "go",
      "args": [
        "run",
        "github.com/grafana/mcp-grafana/cmd/mcp-grafana@latest",
        "--disable-oncall",
        "--disable-incident",
        "--disable-admin",
        "--disable-navigation",
        "--disable-pyroscope"
      ],
      "env": {
        "GRAFANA_URL": "http://prometheus-grafana.prometheus"
      }
    },
    "pagerduty-mcp": {
      "type": "stdio",
      "command": "uvx",
      "args": ["pagerduty-mcp"]
    },
    "Home Assistant": {
      "command": "uvx",
      "args": [
        "mcp-proxy",
        "--transport=streamablehttp",
        "--stateless",
        "https://homeassistant.tailnet-1a49.ts.net/api/mcp"
      ]
    },
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server:v1.3.0@sha256:5c83359327a0bacc3d34db730bea6557d39d341cee0bf6c58c9a896e33150e80"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GH_TOKEN}"
      }
    }
  }
}
