{
  "name": "@scout-for-lol/evals",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "bun run src/dev.ts",
    "discover": "bun run src/scripts/discover-candidates.ts",
    "dataset:export": "bun run src/scripts/export-dataset.ts",
    "dataset:import": "bun run src/scripts/import-dataset.ts",
    "dataset:push": "bun run src/scripts/push-dataset.ts",
    "docker:build": "docker buildx build --cache-from type=registry,ref=ghcr.io/shepherdjerred/scout-evals:buildcache ${DOCKER_BUILD_EXTRA_ARGS:-} --load -t scout-evals:dev -f Dockerfile ../../../..",
    "smoke": "bun scripts/smoke.ts",
    "launch": "bun run build && bun run src/server/index.ts --open",
    "materialize": "bun run src/scripts/materialize-dataset.ts",
    "start": "bun run src/server/index.ts",
    "sync-beta": "bun run src/scripts/sync-beta-corpus.ts",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "test": "bun test src",
    "test:ci": "bun ../../../../scripts/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../../../scripts/run-ci-test.ts",
    "test:e2e": "bun x --no-install playwright test",
    "lint": "bun x --no-install eslint . --max-warnings=0"
  },
  "imports": {
    "#client/*": "./src/client/*",
    "#components/*": "./src/components/*",
    "#lib/*": "./src/lib/*",
    "#materialization/*": "./src/materialization/*",
    "#server/*": "./src/server/*",
    "#shared/*": "./src/shared/*",
    "#styles/*": "./src/styles/*",
    "#testing/*": "./src/testing/*"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1001.0",
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@scout-for-lol/data": "workspace:*",
    "@tanstack/react-query": "^5.101.2",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@trpc/tanstack-react-query": "^11.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.12.18",
    "lucide-react": "^1.14.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@shepherdjerred/eslint-config": "workspace:*",
    "@tailwindcss/vite": "^4.2.4",
    "@types/bun": "^1.3.13",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "shadcn": "^4.14.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.11"
  }
}
