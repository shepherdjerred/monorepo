generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
  runtime = "bun"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum StateType {
  triage
  backlog
  unstarted
  started
  completed
  canceled
  duplicate
}

enum ActorKind {
  human
  agent
  runner
}

enum RelationType {
  blocks
  duplicate
  related
}

enum AttachmentStatus {
  staged
  committed
}

enum Urgency {
  high
  medium
  low
}

enum Impact {
  high
  medium
  low
}

enum Effort {
  xs
  s
  m
  l
  xl
}

model Team {
  id String @id @default(uuid())
  key String @unique
  name String
  issueCounter Int @default(0)
  states WorkflowState[]
  labels Label[]
  issues Issue[]
  views View[]
}

model WorkflowState {
  id String @id @default(uuid())
  teamId String
  team Team @relation(fields: [teamId], references: [id])
  name String
  type StateType
  color String
  position Int
  issues Issue[]
  @@unique([teamId, name])
  @@unique([id, teamId])
}

model Label {
  id String @id @default(uuid())
  teamId String
  team Team @relation(fields: [teamId], references: [id])
  name String
  color String
  issues IssueLabel[]
  @@unique([teamId, name])
  @@unique([id, teamId])
}

model Project {
  id String @id @default(uuid())
  slug String @unique
  name String
  description String @default("")
  color String
  archivedAt DateTime?
  issues Issue[]
  forumPosts ForumPost[]
}

model Actor {
  id String @id @default(uuid())
  key String @unique
  kind ActorKind
  name String
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  seenCount Int @default(1)
  firstMetadata Json
  metadata Json
  createdIssues Issue[] @relation("creator")
  assignedIssues Issue[] @relation("assignee")
  comments Comment[]
  attachments Attachment[]
  votes Vote[]
  events Event[]
  views View[]
  forumPosts ForumPost[] @relation("forumCreator")
  forumResolutions ForumPost[] @relation("forumResolver")
  ownedForumPosts ForumPost[] @relation("forumOwner")
  pinnedForumPosts ForumPost[] @relation("forumPinner")
  lastRepliedForumPosts ForumPost[] @relation("forumLastReplier")
  forumReplies ForumReply[]
  forumPostVotes ForumPostVote[]
  forumReplyVotes ForumReplyVote[]
  forumReactions ForumReaction[]
  createdForumIssueLinks ForumIssueLink[]
  forumThreadStates ForumThreadState[]
}

enum ForumKind {
  notice
  discussion
  question
  decision
}

enum ForumState {
  open
  resolved
}

model ForumPost {
  id String @id @default(uuid())
  number Int @unique @default(autoincrement())
  kind ForumKind
  title String
  body String
  scopes String[] @default([])
  exitCondition String?
  expiresAt DateTime?
  state ForumState @default(open)
  creatorId String
  creator Actor @relation("forumCreator", fields: [creatorId], references: [id])
  ownerId String?
  owner Actor? @relation("forumOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  projectId String?
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  pinnedAt DateTime?
  pinnedById String?
  pinnedBy Actor? @relation("forumPinner", fields: [pinnedById], references: [id], onDelete: SetNull)
  acceptedReplyId String?
  acceptedReply ForumReply? @relation("acceptedForumReply", fields: [acceptedReplyId], references: [id], onDelete: SetNull)
  resolverId String?
  resolver Actor? @relation("forumResolver", fields: [resolverId], references: [id])
  resolutionNote String?
  resolvedAt DateTime?
  editedAt DateTime?
  replyCount Int @default(0)
  voteCount Int @default(0)
  lastActivityAt DateTime @default(now())
  lastReplyAt DateTime?
  lastReplyAuthorId String?
  lastReplyAuthor Actor? @relation("forumLastReplier", fields: [lastReplyAuthorId], references: [id], onDelete: SetNull)
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  searchVector Unsupported("tsvector")? @default(dbgenerated())
  replies ForumReply[] @relation("forumPostReplies")
  votes ForumPostVote[]
  reactions ForumReaction[]
  issueLinks ForumIssueLink[]
  threadStates ForumThreadState[]
  attachments Attachment[]
  @@index([kind, state, updatedAt, id])
  @@index([pinnedAt, lastActivityAt, id])
  @@index([projectId, lastActivityAt, id])
  @@index([scopes], type: Gin)
}

model ForumReply {
  id String @id @default(uuid())
  postId String
  post ForumPost @relation("forumPostReplies", fields: [postId], references: [id], onDelete: Cascade)
  parentReplyId String?
  parentReply ForumReply? @relation("forumReplyThread", fields: [parentReplyId, postId], references: [id, postId], onDelete: Cascade)
  childReplies ForumReply[] @relation("forumReplyThread")
  acceptedForPosts ForumPost[] @relation("acceptedForumReply")
  authorId String
  author Actor @relation(fields: [authorId], references: [id])
  body String
  createdAt DateTime @default(now())
  editedAt DateTime?
  deletedAt DateTime?
  voteCount Int @default(0)
  searchVector Unsupported("tsvector")? @default(dbgenerated())
  votes ForumReplyVote[]
  reactions ForumReaction[]
  issueLinks ForumIssueLink[]
  attachments Attachment[]
  @@unique([id, postId])
  @@index([postId, createdAt, id])
  @@index([parentReplyId, postId])
}

model ForumPostVote {
  postId String
  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  actorId String
  actor Actor @relation(fields: [actorId], references: [id])
  note String?
  createdAt DateTime @default(now())
  @@id([postId, actorId])
}

model ForumReplyVote {
  replyId String
  reply ForumReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  actorId String
  actor Actor @relation(fields: [actorId], references: [id])
  createdAt DateTime @default(now())
  @@id([replyId, actorId])
}

model ForumReaction {
  id String @id @default(uuid())
  postId String?
  post ForumPost? @relation(fields: [postId], references: [id], onDelete: Cascade)
  replyId String?
  reply ForumReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)
  actorId String
  actor Actor @relation(fields: [actorId], references: [id])
  emoji String
  createdAt DateTime @default(now())
  @@index([postId])
  @@index([replyId])
}

model ForumIssueLink {
  postId String
  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  issueId String
  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  sourceReplyId String?
  sourceReply ForumReply? @relation(fields: [sourceReplyId], references: [id], onDelete: SetNull)
  createdById String
  createdBy Actor @relation(fields: [createdById], references: [id])
  createdAt DateTime @default(now())
  @@id([postId, issueId])
  @@index([issueId])
}

model ForumThreadState {
  postId String
  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  actorId String
  actor Actor @relation(fields: [actorId], references: [id])
  mode String?
  lastReadAt DateTime?
  updatedAt DateTime @updatedAt
  @@id([postId, actorId])
  @@index([actorId, mode, updatedAt])
}

model Issue {
  id String @id @default(uuid())
  teamId String
  team Team @relation(fields: [teamId], references: [id])
  number Int
  title String
  description String @default("")
  stateId String
  state WorkflowState @relation(fields: [stateId, teamId], references: [id, teamId])
  priority Int @default(0)
  priorityManual Boolean @default(false)
  urgency Urgency?
  impact Impact?
  effort Effort?
  projectId String?
  project Project? @relation(fields: [projectId], references: [id])
  assigneeId String?
  assignee Actor? @relation("assignee", fields: [assigneeId], references: [id])
  creatorId String
  creator Actor @relation("creator", fields: [creatorId], references: [id])
  boardOrder Float @default(0)
  voteCount Int @default(0)
  revision Int @default(1)
  externalRef String? @unique
  sourceMetadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  startedAt DateTime?
  completedAt DateTime?
  canceledAt DateTime?
  archivedAt DateTime?
  parentId String?
  parent Issue? @relation("parent", fields: [parentId], references: [id], onDelete: SetNull)
  children Issue[] @relation("parent")
  dueDate DateTime? @db.Date
  searchVector Unsupported("tsvector")? @default(dbgenerated())
  labels IssueLabel[]
  comments Comment[]
  attachments Attachment[]
  votes Vote[]
  events Event[]
  relationsFrom IssueRelation[] @relation("from")
  relationsTo IssueRelation[] @relation("to")
  forumLinks ForumIssueLink[]
  @@unique([teamId, number])
  @@unique([id, teamId])
  @@index([updatedAt, id])
  @@index([stateId, boardOrder, id])
  @@index([parentId])
}

model IssueLabel {
  issueId String
  labelId String
  teamId String
  issue Issue @relation(fields: [issueId, teamId], references: [id, teamId], onDelete: Cascade)
  label Label @relation(fields: [labelId, teamId], references: [id, teamId], onDelete: Cascade)
  @@id([issueId, labelId])
}

model Comment {
  id String @id @default(uuid())
  issueId String
  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId String
  author Actor @relation(fields: [authorId], references: [id])
  body String
  createdAt DateTime @default(now())
  editedAt DateTime?
  attachments Attachment[]
  @@index([issueId, createdAt, id])
}

model IssueRelation {
  id String @id @default(uuid())
  fromId String
  from Issue @relation("from", fields: [fromId], references: [id], onDelete: Cascade)
  toId String
  to Issue @relation("to", fields: [toId], references: [id], onDelete: Cascade)
  type RelationType
  @@unique([fromId, toId, type])
}

model Attachment {
  id String @id @default(uuid())
  storageKey String @unique
  filename String
  contentType String
  sizeBytes Int
  sha256 String
  width Int?
  height Int?
  uploaderId String
  uploader Actor @relation(fields: [uploaderId], references: [id])
  status AttachmentStatus @default(staged)
  issueId String?
  issue Issue? @relation(fields: [issueId], references: [id], onDelete: SetNull)
  commentId String?
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  forumPostId String?
  forumPost ForumPost? @relation(fields: [forumPostId], references: [id], onDelete: SetNull)
  forumReplyId String?
  forumReply ForumReply? @relation(fields: [forumReplyId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@index([status, createdAt])
  @@index([forumPostId])
  @@index([forumReplyId])
}

model Vote {
  issueId String
  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actorId String
  actor Actor @relation(fields: [actorId], references: [id])
  note String?
  createdAt DateTime @default(now())
  @@id([issueId, actorId])
}

model Event {
  id String @id @default(uuid())
  entityType String
  entityId String
  issueId String?
  issue Issue? @relation(fields: [issueId], references: [id], onDelete: SetNull)
  issueIdentifier String?
  action String
  actorId String
  actor Actor @relation(fields: [actorId], references: [id])
  occurredAt DateTime @default(now())
  changes Json
  before Json?
  after Json?
  requestId String
  sourceIdentity String? @unique
  rawSourcePayload Json?
  @@index([issueIdentifier, occurredAt, id])
  @@index([actorId, occurredAt, id])
  @@index([occurredAt, id])
}

model View {
  id String @id @default(uuid())
  name String
  icon String
  params Json
  teamId String?
  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  position Int
  createdById String
  createdBy Actor @relation(fields: [createdById], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ImportMapping {
  source String
  entityType String
  externalId String
  destinationId String
  contentHash String
  @@id([source, entityType, externalId])
}
