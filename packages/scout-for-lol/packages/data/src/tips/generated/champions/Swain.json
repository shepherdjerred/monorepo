      "inputHash": "6c5e84a74a7e8bebe3f0595628245488f2a168d5b8663168e858ea1790b72b1d",
      "tips": [
        {
          "id": "support:Swain:general:0",
          "text": "Throw Nevermove when enemies stand near their minions so the blast surprises them, then recast it to pull them toward you.",
          "refs": [
            { "kind": "ability", "key": "Swain-E", "start": 6, "end": 15 }
          ],
          "pWrong": 0.44
        },
        {
          "id": "support:Swain:general:1",
          "text": "Poke from a safe distance with Death's Hand; it hits several enemies at once and does more damage when they are close.",
          "refs": [
            { "kind": "keyword", "key": "poke", "start": 0, "end": 4 },
            { "kind": "ability", "key": "Swain-Q", "start": 31, "end": 43 }
          ],
          "pWrong": 0.47
        },
        {
          "id": "support:Swain:general:2",
          "text": "Aim Vision of Empire at enemies who are busy or rooted, since it lands slowly. A hit slows them and reveals them.",
          "refs": [
            { "kind": "ability", "key": "Swain-W", "start": 4, "end": 20 },
            { "kind": "keyword", "key": "slowed", "start": 85, "end": 90 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "support:Swain:general:3",
          "text": "Recast Nevermove while an enemy is rooted to pull them in and grab a Soul Fragment. This works only while they stay rooted.",
          "refs": [
            { "kind": "ability", "key": "Swain-E", "start": 7, "end": 16 },
            { "kind": "keyword", "key": "rooted", "start": 35, "end": 41 },
            { "kind": "keyword", "key": "rooted", "start": 116, "end": 122 }
          ],
          "pWrong": 0.37
        },
        {
          "id": "support:Swain:general:4",
          "text": "Use Demonic Ascension in a fight where you can stay next to enemy champions, because draining them keeps it going. Its nova slows anyone who runs.",
          "refs": [
            { "kind": "ability", "key": "Swain-R", "start": 4, "end": 21 },
            { "kind": "keyword", "key": "slowed", "start": 124, "end": 129 }
          ],
          "pWrong": 0.1
        },
        {
          "id": "support:Swain:general:5",
          "text": "Collect Soul Fragments from fallen enemy champions. Each one heals you and permanently adds health.",
          "refs": [],
          "pWrong": 0.04
        }
      ],
      "combos": []
    }
  ],
  "matchups": [
