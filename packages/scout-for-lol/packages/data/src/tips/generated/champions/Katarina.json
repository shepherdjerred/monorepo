      "inputHash": "2dd8f1a399ef9b2865785aa4450d3bb01b2b22cad8ebe4af34787c9c6e3013fd",
      "tips": [
        {
          "id": "middle:Katarina:Orianna:0",
          "text": "Keep Death Lotus until Orianna has used Command: Shockwave or is far from her Ball. Her Shockwave can stop your channel, so don't start it while it is ready.",
          "refs": [
            { "kind": "ability", "key": "Katarina-R", "start": 5, "end": 16 },
            { "kind": "champion", "key": "Orianna", "start": 23, "end": 30 },
            { "kind": "ability", "key": "Orianna-R", "start": 40, "end": 58 }
          ],
          "pWrong": 0.88,
          "hidden": true
        },
        {
          "id": "middle:Katarina:Orianna:1",
          "text": "Look at where her Ball sits before you jump in. Her Command: Dissonance and Command: Shockwave only hit enemies close to the Ball.",
          "refs": [
            { "kind": "ability", "key": "Orianna-W", "start": 52, "end": 71 },
            { "kind": "ability", "key": "Orianna-R", "start": 76, "end": 94 }
          ],
          "pWrong": 0.51
        },
        {
          "id": "middle:Katarina:Orianna:2",
          "text": "Use Preparation to gain speed and walk out of her Command: Attack range, then pick up the Dagger with Shunpo to trade back.",
          "refs": [
            { "kind": "ability", "key": "Katarina-W", "start": 4, "end": 15 },
            { "kind": "ability", "key": "Orianna-Q", "start": 50, "end": 65 },
            { "kind": "item", "key": "1042", "start": 90, "end": 96 },
            { "kind": "ability", "key": "Katarina-E", "start": 102, "end": 108 }
          ],
          "pWrong": 0.68
        },
        {
          "id": "middle:Katarina:Orianna:3",
          "text": "Do not stay in the field left by Command: Dissonance, because you will be slowed. Go in with Shunpo after it fades.",
          "refs": [
            { "kind": "ability", "key": "Orianna-W", "start": 33, "end": 52 },
            { "kind": "keyword", "key": "slowed", "start": 74, "end": 80 },
            { "kind": "ability", "key": "Katarina-E", "start": 93, "end": 99 }
          ],
          "pWrong": 0.56
        },
        {
          "id": "middle:Katarina:Orianna:4",
          "text": "Bouncing Blade hits up to three enemies. Throw it at a minion next to Orianna so it bounces onto her, then Shunpo to the landed Dagger.",
          "refs": [
            { "kind": "ability", "key": "Katarina-Q", "start": 0, "end": 14 },
            { "kind": "champion", "key": "Orianna", "start": 70, "end": 77 },
            {
              "kind": "ability",
              "key": "Katarina-E",
              "start": 107,
              "end": 113
            },
            { "kind": "item", "key": "1042", "start": 128, "end": 134 }
          ],
          "pWrong": 0.48
        }
      ],
      "opponent": "Orianna",
      "comboRefs": []
    },
    {
      "lane": "middle",
      "inputHash": "5e986b32bc245bb187fadfc7ae108af62f64cecdd626d254698a26f1fab6a4a7",
      "tips": [
        {
          "id": "middle:Katarina:Ryze:0",
          "text": "Stay out of Ryze's range, then dash in with Shunpo only when Rune Prison and Spell Flux are used up.",
          "refs": [
            { "kind": "champion", "key": "Ryze", "start": 12, "end": 16 },
            { "kind": "ability", "key": "Katarina-E", "start": 44, "end": 50 },
            { "kind": "ability", "key": "Ryze-W", "start": 61, "end": 72 },
            { "kind": "ability", "key": "Ryze-E", "start": 77, "end": 87 }
          ],
          "pWrong": 0.32
        },
        {
          "id": "middle:Katarina:Ryze:1",
          "text": "Ryze roots you if Flux is on you when Rune Prison lands. Do not walk into his range after he has hit you with Spell Flux.",
          "refs": [
            { "kind": "champion", "key": "Ryze", "start": 0, "end": 4 },
            { "kind": "keyword", "key": "rooted", "start": 5, "end": 10 },
            { "kind": "ability", "key": "Ryze-W", "start": 38, "end": 49 },
            { "kind": "ability", "key": "Ryze-E", "start": 110, "end": 120 }
          ],
          "pWrong": 0.3
        },
        {
          "id": "middle:Katarina:Ryze:2",
          "text": "Use Bouncing Blade to hit Ryze and minions together. The Dagger it leaves behind gives you a free Shunpo target.",
          "refs": [
            { "kind": "ability", "key": "Katarina-Q", "start": 4, "end": 18 },
            { "kind": "champion", "key": "Ryze", "start": 26, "end": 30 },
            { "kind": "item", "key": "1042", "start": 57, "end": 63 },
            { "kind": "ability", "key": "Katarina-E", "start": 98, "end": 104 }
          ],
          "pWrong": 0.23
        },
        {
          "id": "middle:Katarina:Ryze:3",
          "text": "Use Preparation to dodge his Overload by speeding away, and to toss a Dagger you can pick up.",
          "refs": [
            { "kind": "ability", "key": "Katarina-W", "start": 4, "end": 15 },
            { "kind": "ability", "key": "Ryze-Q", "start": 29, "end": 37 },
            { "kind": "item", "key": "1042", "start": 70, "end": 76 }
          ],
          "pWrong": 0.59
        },
        {
          "id": "middle:Katarina:Ryze:4",
          "text": "Start Death Lotus once Ryze has used his root and slow. If he is rooted by nothing, he can still hit you hard.",
          "refs": [
            { "kind": "ability", "key": "Katarina-R", "start": 6, "end": 17 },
            { "kind": "champion", "key": "Ryze", "start": 23, "end": 27 }
          ],
          "pWrong": 0.58
        }
      ],
      "opponent": "Ryze",
      "comboRefs": []
    },
    {
      "lane": "middle",
      "inputHash": "cb05d7051739cce6352c395cec81ec71338ab0dab99e1364ca970bdfe4a0b164",
      "tips": [
        {
          "id": "middle:Katarina:Sylas:0",
          "text": "Use Shunpo to jump in only when Sylas has used Abscond or Chain Lash; his lunge and knock up are what punish you, so wait for them to be on cooldown.",
          "refs": [
