{
  "name": "@scout-for-lol/backend",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*",
    "./generated/*": "./generated/*"
  },
  "scripts": {
    "dev": "bun run scripts/ensure-dev-postgres.ts scout_dev_3000 && bun x --no-install prisma migrate deploy && bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "start:workflow-worker": "bun src/temporal/workflow-worker.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --external=ffmpeg-static --external '@duckdb/*' --external '@temporalio/*'",
    "test": "DATABASE_URL=${DATABASE_URL:-postgres://scout@127.0.0.1:${SCOUT_PG_PORT:-5471}/scout_test_unbound} bun --no-install --bun vitest --config ../../../../vitest.config.ts run --testTimeout 20000",
    "test:watch": "bun --no-install --bun vitest --config ../../../../vitest.config.ts",
    "test:coverage": "bun --no-install --bun vitest --config ../../../../vitest.config.ts run --coverage",
    "test:coverage:threshold": "bun --no-install --bun vitest --config ../../../../vitest.config.ts run --coverage --bail=1",
    "test:ci": "bun ../../../../scripts/run-ci-test.ts",
    "test:fast": "bun --no-install --bun vitest --config ../../../../vitest.config.ts run --bail=3",
    "test:debug": "bun --no-install --bun vitest --config ../../../../vitest.config.ts run --sequence.shuffle",
    "lint": "bun x eslint src && check-architecture",
    "format": "bun x prettier --check src",
    "format:write": "bun x prettier --write src",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "docker:build": "docker buildx build --cache-from type=registry,ref=ghcr.io/shepherdjerred/scout-for-lol:buildcache ${DOCKER_BUILD_EXTRA_ARGS:-} --load -t scout-for-lol:dev -f Dockerfile ../../../..",
    "smoke": "bun scripts/smoke.ts",
    "generate": "bun run db:generate",
    "temporal:requeue-work": "bun run scripts/requeue-temporal-work.ts",
    "compact:report-lake": "bun run scripts/compact-report-lake.ts",
    "generate-lane-priors": "bun run scripts/generate-lane-priors.ts",
    "evaluate-lane-priors": "bun run scripts/evaluate-lane-priors.ts",
    "evaluate-predictions": "bun run scripts/evaluate-predictions.ts",
    "update-queue-windows": "bun run scripts/update-queue-windows.ts",
    "db:generate": "bun x --trust prisma generate && bun run brand-types && bun x prettier --write generated/",
    "brand-types": "bun run scripts/brand-prisma-types.ts",
    "db:push": "bun x prisma db push",
    "db:migrate": "bun x prisma migrate dev",
    "db:studio": "bun x prisma studio",
    "import:report-store:s3": "bun run scripts/import-report-store-from-s3.ts",
    "discover:marketing-showcase": "bun run scripts/discover-marketing-showcase.ts",
    "generate:marketing-showcase": "bun run scripts/generate-marketing-showcase.ts",
    "test:review": "bun run src/league/review/test-reviews.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../../../scripts/run-ci-test.ts",
    "test:parlay:live": "bun run scripts/test-parlay-live.ts",
    "test:weekly-parlay:live": "bun run scripts/test-weekly-parlay-live.ts",
    "analytics:backfill-bryan-bucks": "bun run scripts/backfill-bryan-bucks-analytics.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1001.0",
    "@discordjs/voice": "^0.19.0",
    "@duckdb/node-api": "1.5.4-r.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.7.1",
    "@opentelemetry/core": "^2.7.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/client-runtime-utils": "7.9.1",
    "@scout-for-lol/data": "workspace:*",
    "@scout-for-lol/report": "workspace:*",
    "@scout-for-lol/temporal": "workspace:*",
    "@sentry/bun": "^10.70.0",
    "@shepherdjerred/config": "workspace:*",
    "@shepherdjerred/feature-flags": "workspace:*",
    "@shepherdjerred/llm-observability": "workspace:*",
    "@shepherdjerred/llm-runtime": "workspace:*",
    "@shepherdjerred/temporal-observability": "workspace:*",
    "@temporalio/activity": "1.22.0",
    "@temporalio/client": "1.22.0",
    "@temporalio/common": "1.22.0",
    "@temporalio/worker": "1.22.0",
    "@trpc/server": "11",
    "ai": "^7.0.77",
    "cron-parser": "^5.5.0",
    "date-fns": "^4.1.0",
    "discord.js": "^14.26.4",
    "dotenv": "^17.0.1",
    "env-var": "^7.5.0",
    "jose": "^6.2.3",
    "posthog-node": "^5.39.4",
    "prism-media": "^1.3.5",
    "prisma": "^7.9.1",
    "prom-client": "^15.1.3",
    "react": "19.2.8",
    "remeda": "^2.21.2",
    "sodium-native": "^5.0.10",
    "ts-pattern": "^5.7.0",
    "tslog": "^5.1.0",
    "uuid": "^14.0.0",
    "yoga-wasm-web": "^0.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shepherdjerred/architecture": "workspace:*",
    "@types/node": "^26.1.1",
    "aws-sdk-client-mock": "^4.1.0",
    "bun-types": "1.4.0",
    "glob": "^13.0.0",
    "ts-morph": "^28.0.0",
    "typescript": "^6.0.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "vitest": "4.1.10",
    "@vitest/coverage-istanbul": "4.1.10"
  },
  "description": "Backend service for Scout for League of Legends Discord bot",
  "keywords": [
    "discord",
    "bot",
    "league-of-legends",
    "typescript",
    "bun"
  ],
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shepherdjerred/monorepo.git"
  },
  "homepage": "https://github.com/shepherdjerred/monorepo/tree/main/packages/scout-for-lol",
  "bugs": {
    "url": "https://github.com/shepherdjerred/monorepo/issues"
  },
  "imports": {
    "#architecture": "./architecture.config.ts",
    "#src/*": "./src/*",
    "#generated/*": "./generated/*"
  }
}
