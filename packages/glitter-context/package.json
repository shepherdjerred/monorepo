{
  "name": "@shepherdjerred/glitter-context",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#data/*": "./data/*",
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "bun --no-install run build:runtime && tsc -p tsconfig.build.json",
    "build:runtime": "bun --no-install run scripts/generate.ts && bun --no-install build src/index.ts src/schema.ts --outdir dist --target browser --external zod",
    "typecheck": "bun run scripts/generate.ts && bunx tsc --noEmit",
    "lint": "bun run scripts/generate.ts && bunx eslint --cache .",
    "test": "bun run scripts/generate.ts && bun test test && uv run python/validate_context.py"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shepherdjerred/eslint-config": "workspace:*",
    "@tsconfig/node-lts": "^24.0.0",
    "@tsconfig/recommended": "^1.0.13",
    "@tsconfig/strictest": "^2.0.8",
    "@types/bun": "^1.3.13",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3"
  }
}
