{
  "name": "@shepherdjerred/trmnl-dashboard",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "prestart": "bun --no-install run --cwd ../home-assistant build",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "pretypecheck": "bun --no-install run --cwd ../home-assistant build",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run",
    "pretest": "bun --no-install run --cwd ../home-assistant build",
    "lint": "bunx eslint . --max-warnings=0",
    "docker:build": "docker buildx build --cache-from type=registry,ref=ghcr.io/shepherdjerred/trmnl-dashboard:buildcache ${DOCKER_BUILD_EXTRA_ARGS:-} --load -t trmnl-dashboard:dev -f Dockerfile ../..",
    "smoke": "bun scripts/smoke.ts",
    "test:ci": "bun ../../scripts/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../scripts/run-ci-test.ts"
  },
  "dependencies": {
    "@sentry/bun": "^10.70.0",
    "@shepherdjerred/config": "workspace:*",
    "@shepherdjerred/feature-flags": "workspace:*",
    "@shepherdjerred/home-assistant": "workspace:*",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shepherdjerred/eslint-config": "workspace:*",
    "@types/bun": "1.4.0",
    "eslint": "^10.3.0",
    "jiti": "^2.7.0",
    "liquidjs": "^10.29.0",
    "typescript": "^6.0.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "vitest": "4.1.10",
    "@vitest/coverage-istanbul": "4.1.10"
  }
}
