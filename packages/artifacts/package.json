{
  "name": "@shepherdjerred/artifacts",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "exports": {
    "./contract": "./src/shared/contract.ts",
    "./procedures": "./src/shared/procedures.ts",
    "./testing": "./src/testing/service.ts"
  },
  "imports": {
    "#generated/*": "./generated/*",
    "#*": "./src/*"
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "vite build && bun build src/index.ts --target bun --outdir dist",
    "start": "bun src/index.ts",
    "migrate:deploy": "prisma migrate deploy",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run src/shared src/domain src/application src/bridge src/server src/client --testTimeout 30000 --hookTimeout 30000",
    "test:extended": "bun ../../scripts/ci/run-ci-test.ts --tier extended",
    "test:ci": "bun ../../scripts/ci/run-ci-test.ts",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "dev": "bun src/dev.ts",
    "dev:client": "vite",
    "test:e2e": "bun --no-install --bun playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/client-runtime-utils": "7.10.1",
    "@shepherdjerred/config": "workspace:*",
    "@shepherdjerred/feature-flags": "workspace:*",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-virtual": "^3.14.26",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "asciinema-player": "^3.15.1",
    "hono": "^4.12.18",
    "mermaid": "12.3.0",
    "lucide-react": "^1.14.0",
    "pdfjs-dist": "^6.4.299",
    "pg": "8.23.1",
    "prisma": "^7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "8.4.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.0",
    "@shepherdjerred/console-ui": "workspace:*",
    "@shepherdjerred/eslint-config": "workspace:*",
    "@shepherdjerred/ops-model": "workspace:*",
    "@shepherdjerred/test-postgres": "workspace:*",
    "@types/bun": "1.4.5",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-istanbul": "5.0.5",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "5.0.5"
  }
}
