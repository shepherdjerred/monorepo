      "inputHash": "58991634b0327daf41e5973456d029711435d6eab545c4ec69ed3b411609f415",
      "tips": [
        {
          "id": "jungle:Rammus:general:0",
          "text": "Use Frenzying Taunt on jungle monsters as well as champions; it deals extra damage to them, which helps your clears.",
          "refs": [
            { "kind": "ability", "key": "Rammus-E", "start": 4, "end": 19 }
          ],
          "pWrong": 0.05
        },
        {
          "id": "jungle:Rammus:general:1",
          "text": "Taunt an enemy standing near your tower so the tower attacks them while they cannot walk away.",
          "refs": [],
          "pWrong": 0.04
        },
        {
          "id": "jungle:Rammus:general:2",
          "text": "Roll with Powerball to cross the map fast and start a gank from out of sight. The enemy is slowed when you hit.",
          "refs": [
            { "kind": "ability", "key": "Rammus-Q", "start": 10, "end": 19 },
            { "kind": "keyword", "key": "slowed", "start": 91, "end": 97 }
          ],
          "pWrong": 0.16
        },
        {
          "id": "jungle:Rammus:general:3",
          "text": "Use Powerball to run away when a fight turns bad. Recast it to stop early if you need to.",
          "refs": [
            { "kind": "ability", "key": "Rammus-Q", "start": 4, "end": 13 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "jungle:Rammus:general:4",
          "text": "Use Defensive Ball Curl when enemies are attacking you with basic attacks; they take magic damage back for each hit.",
          "refs": [
            { "kind": "ability", "key": "Rammus-W", "start": 4, "end": 23 }
          ],
          "pWrong": 0.16
        },
        {
          "id": "jungle:Rammus:general:5",
          "text": "Cast Soaring Slam while rolling in Powerball so enemies in the center are knocked up and take extra damage.",
          "refs": [
            { "kind": "ability", "key": "Rammus-R", "start": 5, "end": 17 },
            { "kind": "ability", "key": "Rammus-Q", "start": 35, "end": 44 },
            { "kind": "keyword", "key": "knocked-up", "start": 74, "end": 84 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "jungle:Rammus:general:6",
          "text": "Late in the game, use Soaring Slam on towers; it deals double damage to them. Slip away to hit buildings if a team fight is going badly.",
          "refs": [
            { "kind": "ability", "key": "Rammus-R", "start": 22, "end": 34 }
          ],
          "pWrong": 0.21
        }
      ],
      "combos": []
    }
