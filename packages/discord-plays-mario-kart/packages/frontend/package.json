{
  "name": "@discord-plays-mario-kart/frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "dev": "vite",
    "build": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit && vite build",
    "lint": "bun run lint:check",
    "lint:check": "eslint .",
    "lint:fix": "eslint --fix .",
    "preview": "vite preview",
    "test": "bun --no-install --bun vitest --config ../../../../vitest.config.ts run",
    "test:ci": "bun ../../../../scripts/ci/run-ci-test.ts"
  },
  "dependencies": {
    "@discord-plays-mario-kart/common": "workspace:*",
    "@tanstack/react-query": "^5.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@shepherdjerred/discord-plays-web": "workspace:*",
    "@shepherdjerred/discord-plays-core": "workspace:*"
  },
  "devDependencies": {
    "@iconify-json/ph": "^1.2.2",
    "@shepherdjerred/eslint-config": "workspace:*",
    "@types/dom-webcodecs": "^0.1.18",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "tailwindcss": "^4.0.17",
    "typescript": "^6.0.3",
    "unplugin-fonts": "^2.0.0",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.0.11",
    "vitest": "5.1.2",
    "@vitest/coverage-istanbul": "5.1.2"
  }
}
