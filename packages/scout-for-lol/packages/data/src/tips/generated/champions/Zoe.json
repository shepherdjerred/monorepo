      "tips": [
        {
          "id": "middle:Zoe:Sylas:0",
          "text": "Hit Sylas with Sleepy Trouble Bubble from long range, then follow with Paddle Star! while he sleeps, because attacks and ability hits wake him for extra damage.",
          "refs": [
