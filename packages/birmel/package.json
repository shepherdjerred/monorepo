{
  "name": "@shepherdjerred/birmel",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "description": "Discord bot built on a single explicit AI SDK agent runtime with routed specialists, durable memory, thread-bound sessions, and a jobs system",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "imports": {
    "#generated/*": "./generated/*"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "bun run build:context && bun run generate && bun build src/index.ts --target=bun --packages external --outdir=dist",
    "start": "bun run build:context && bun run generate && bun run scripts/start.ts",
    "dev": "bun run build:context && bun run generate && bun run scripts/migrate.ts && bun run --watch src/index.ts",
    "build:context": "bunx turbo run build --filter=@shepherdjerred/glitter-context",
    "build:test-dependencies": "bunx turbo run build --filter=@shepherdjerred/birmel^...",
    "generate": "bun run scripts/generate-prisma.ts",
    "test": "bun run build:test-dependencies && bun --env-file=.env.test run generate && bun --env-file=.env.test --no-install --bun vitest --config ../../vitest.config.ts run --coverage",
    "test:e2e:music": "bun run e2e/music-playback.ts",
    "test:e2e:youtube-stream": "bun run e2e/youtube-stream-resource.ts",
    "test:e2e:openclaw-docker": "bun run e2e/openclaw-capabilities-docker.ts",
    "typecheck": "bun run generate && PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "lint": "bun run generate && eslint .",
    "docker:build": "docker buildx build --cache-from type=registry,ref=ghcr.io/shepherdjerred/birmel:buildcache ${DOCKER_BUILD_EXTRA_ARGS:-} --load -t birmel:dev -f Dockerfile ../..",
    "smoke": "bun scripts/smoke.ts",
    "test:ci": "bun ../../scripts/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../scripts/run-ci-test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/core": "^2.7.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@prisma/adapter-libsql": "7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/client-runtime-utils": "7.9.1",
    "@sentry/bun": "10.69.0",
    "@shepherdjerred/glitter-context": "workspace:*",
    "@shepherdjerred/llm-observability": "workspace:*",
    "@shepherdjerred/llm-runtime": "workspace:*",
    "@snazzah/davey": "^0.1.11",
    "ai": "^7.0.58",
    "chrono-node": "^2.9.1",
    "cron-parser": "^5.5.0",
    "discord-player": "7.2.0",
    "discord-player-youtubei": "^2.0.0",
    "discord.js": "^14.27.0",
    "ffmpeg-static": "^5.3.0",
    "hono": "^4.12.18",
    "mediaplex": "^1.0.0",
    "playwright": "1.62.1",
    "prom-client": "^15.1.3",
    "prisma": "7.9.1",
    "youtube-dl-exec": "^3.1.6",
    "youtubei.js": "^17.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shepherdjerred/eslint-config": "workspace:*",
    "@types/bun": "1.4.0",
    "@typescript-eslint/utils": "^8.65.0",
    "eslint": "^10.3.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "vitest": "4.1.9",
    "@vitest/coverage-istanbul": "4.1.9"
  }
}
