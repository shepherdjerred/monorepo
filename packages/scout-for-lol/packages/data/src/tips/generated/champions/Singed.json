      "tips": [
        {
          "id": "top:Singed:general:0",
          "text": "Toggle Poison Trail on when you walk through the minion wave. It farms and hurts the enemy, but turn it off when your mana runs low.",
          "refs": [
            { "kind": "ability", "key": "Singed-Q", "start": 7, "end": 19 }
          ],
          "pWrong": 0.06
        },
        {
          "id": "top:Singed:general:1",
          "text": "Throw Mega Adhesive at your feet or onto the enemy first, then use Fling so they land in it and are rooted.",
          "refs": [
            { "kind": "ability", "key": "Singed-W", "start": 6, "end": 19 },
            { "kind": "ability", "key": "Singed-E", "start": 67, "end": 72 },
            { "kind": "keyword", "key": "rooted", "start": 100, "end": 106 }
          ],
          "pWrong": 0.45
        },
        {
          "id": "top:Singed:general:2",
          "text": "Fling enemies back toward your tower to add the tower's damage to yours.",
          "refs": [
            { "kind": "ability", "key": "Singed-E", "start": 0, "end": 5 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "top:Singed:general:3",
          "text": "Aim Mega Adhesive at a chasing enemy; it slows them. The goo is a missile, so a Wind Wall-type block can stop it.",
          "refs": [
            { "kind": "ability", "key": "Singed-W", "start": 4, "end": 17 },
            { "kind": "keyword", "key": "slowed", "start": 41, "end": 46 }
          ],
          "pWrong": 0.04
        },
        {
          "id": "top:Singed:general:4",
          "text": "Drink Insanity Potion when you fight, so enemies chasing you run through your trail. The poison then cuts their healing.",
          "refs": [
            { "kind": "ability", "key": "Singed-R", "start": 6, "end": 21 }
          ],
          "pWrong": 0.14
        },
        {
          "id": "top:Singed:general:5",
          "text": "Run past enemy champions with Noxious Slipstream to gain speed. Use it to catch up to a target or to get away.",
          "refs": [
            {
              "kind": "ability",
              "key": "Singed-passive",
              "start": 30,
              "end": 48
            }
          ],
          "pWrong": 0.03
        },
        {
          "id": "top:Singed:general:6",
          "text": "Fling can't be answered once Singed starts the cast, because the target's Flash is already locked. Use it on enemies who rely on Flash to escape.",
          "refs": [
            { "kind": "ability", "key": "Singed-E", "start": 0, "end": 5 },
            { "kind": "champion", "key": "Singed", "start": 29, "end": 35 },
            { "kind": "summoner-spell", "key": "4", "start": 74, "end": 79 },
            { "kind": "summoner-spell", "key": "4", "start": 129, "end": 134 }
          ],
          "pWrong": 0.07
        }
      ],
      "combos": [
        {
          "id": "top:Singed:combo:0",
          "name": "Fling over the wall",
          "category": "terrain",
          "sequence": [{ "kind": "ability", "key": "Singed-E" }],
          "when": "When an enemy is hugging a thin wall and you stand on the other side.",
          "whenRefs": [],
          "text": "Fling can throw enemies over thin walls. Use it to drag an enemy away from their escape route and into your team.",
