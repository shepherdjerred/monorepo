{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // homelab has no build script, so this is a transit task whose hash every
    // TypeScript consumer (temporal, cdk8s) inherits through ^build. They import
    // scripts/**, top-level src modules (and the desired state platform-model.ts
    // reads), the Discord credential contract and the neutral reviewed
    // promotion policy consumed by CDK
    // (homelab-build-inputs.test.ts verifies that coverage), so unrelated Talos,
    // OpenTofu, Helm and image edits do not re-run their suites.
    "build": {
      "inputs": [
        "package.json",
        "tsconfig*.json",
        "scripts/**",
        "src/*.ts",
        "src/*.json",
        "src/tofu/discord/desired-state.json",
        "src/talos/seccomp/promotion-policy.json",
        // platform-model.ts derives scoped credentials from these.
        "src/tofu/anthropic-federation/desired-state.json",
        "src/tofu/google/desired-state.json"
      ]
    },
    // The pinned Talos installer in patches/image.yaml must match what the
    // image.yaml schematic produces (old CI: talos-schematic-sync).
    "check:talos": {
      "inputs": ["src/talos/**"]
    },
    // Helm chart lint over the cdk8s synth output (old CI: homelab-helm-lint).
    // Ordered after the synth so it never reads a half-written dist/.
    "lint:helm": {
      "dependsOn": ["@homelab/cdk8s#build"],
      "inputs": [
        "scripts/helm/lint-helm.ts",
        "src/cdk8s/**",
        "!src/cdk8s/node_modules/**",
        "!src/cdk8s/dist/**"
      ]
    },
    // kubeconform validation of the cdk8s synth output. Ordered after the
    // synth (like lint:helm) so it reads the final, patched dist/.
    "check:kubeconform": {
      "dependsOn": ["@homelab/cdk8s#build"],
      "inputs": [
        "scripts/check-kubeconform.ts",
        "src/cdk8s/**",
        "!src/cdk8s/node_modules/**",
        "!src/cdk8s/dist/**"
      ]
    }
  }
}
