---
import ChampionPage from "#src/components/champions/ChampionPage.astro";
import { championMetaSnapshot } from "#src/components/champions/snapshot.ts";

export async function getStaticPaths() {
  const { index } = await championMetaSnapshot;
  return index.champions.map((champion) => {
    // The role the champion is played in most.
    const [main] = champion.roles;
    if (main === undefined) {
      throw new Error(`Champion ${champion.slug} has no role`);
    }
    return {
      params: { slug: champion.slug },
      props: { role: main.role },
    };
  });
}

const { slug } = Astro.params;
const { role } = Astro.props;
if (slug === undefined) {
  throw new Error("Champion route has no slug");
}
---

<ChampionPage slug={slug} role={role} />
