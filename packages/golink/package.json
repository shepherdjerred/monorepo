{
  "name": "@shepherdjerred/golink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./contract": "./src/shared/contract.ts",
    "./trpc-contract": "./src/shared/trpc-contract.ts"
  },
  "imports": {
    "#generated/*": "./generated/*",
    "#architecture": "./architecture.config.ts",
    "#*": "./src/*"
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "vite build",
    "start": "bun src/server/index.ts",
    "handover:tailscale": "bun src/server/handover-tailscale.ts",
    "dev": "bun src/server/dev.ts",
    "migrate:deploy": "prisma migrate deploy",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "lint": "eslint . --max-warnings=0 && check-architecture",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run src/domain src/infrastructure src/client src/server/app.test.ts --testTimeout 30000 --hookTimeout 30000",
    "test:extended": "bun ../../scripts/ci/run-ci-test.ts --tier extended",
    "test:ci": "bun ../../scripts/ci/run-ci-test.ts"
  },
  "dependencies": {
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/client-runtime-utils": "7.10.1",
    "@sentry/bun": "11.16.0",
    "@shepherdjerred/bugsink-config": "workspace:*",
    "@shepherdjerred/config": "workspace:*",
    "@shepherdjerred/console-server": "workspace:*",
    "@shepherdjerred/feature-flags": "workspace:*",
    "@trpc/server": "^11.18.0",
    "hono": "^4.12.18",
    "prisma": "^7.10.1",
    "prom-client": "^15.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shepherdjerred/architecture": "workspace:*",
    "@shepherdjerred/console-client": "workspace:*",
    "@shepherdjerred/console-ui": "workspace:*",
    "@shepherdjerred/eslint-config": "workspace:*",
    "@shepherdjerred/ops-model": "workspace:*",
    "@shepherdjerred/test-postgres": "workspace:*",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "1.170.46",
    "@trpc/client": "^11.18.0",
    "@trpc/tanstack-react-query": "^11.18.0",
    "@types/bun": "1.4.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-istanbul": "5.0.5",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "lucide-react": "^1.14.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "5.0.5"
  }
}
