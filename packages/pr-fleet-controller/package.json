{
  "name": "@shepherdjerred/pr-fleet-controller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "pr-fleet": "./src/cli/main.ts"
  },
  "exports": {
    ".": "./src/controller/fleet-controller.ts",
    "./src/*": "./src/*"
  },
  "imports": {
    "#architecture": "./architecture.config.ts",
    "#domain/*": "./src/domain/*",
    "#runtime/*": "./src/runtime/*",
    "#bundle/*": "./src/bundle/*",
    "#replay/*": "./src/replay/*",
    "#workers/*": "./src/workers/*",
    "#environment/*": "./src/environment/*",
    "#exec/*": "./src/exec/*",
    "#controller/*": "./src/controller/*",
    "#watch/*": "./src/watch/*",
    "#cli/*": "./src/cli/*"
  },
  "scripts": {
    "start": "bun run src/cli/main.ts",
    "inspect": "bun run src/cli/inspect.ts",
    "replay": "bun run src/cli/replay.ts",
    "watch": "bun run src/cli/watch.ts",
    "build": "bun build src/cli/main.ts --target bun --outdir dist",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run src test",
    "test:ci": "bun ../../scripts/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../scripts/run-ci-test.ts",
    "lint": "bunx eslint --cache . && check-architecture"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.7.1",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@shepherdjerred/code-review": "workspace:*",
    "@shepherdjerred/llm-observability": "workspace:*",
    "@shepherdjerred/llm-runtime": "workspace:*",
    "@shepherdjerred/root-scripts": "workspace:*",
    "ai": "7.0.77",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shepherdjerred/architecture": "workspace:*",
    "@shepherdjerred/eslint-config": "workspace:*",
    "@tsconfig/node-lts": "^24.0.0",
    "@tsconfig/recommended": "^1.0.13",
    "@tsconfig/strictest": "^2.0.8",
    "@types/bun": "1.4.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.3.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "vitest": "4.1.10",
    "@vitest/coverage-istanbul": "4.1.10"
  }
}
