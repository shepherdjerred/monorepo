---
import ChampionPage from "#src/components/champions/ChampionPage.astro";
import { championMetaSnapshot } from "#src/components/champions/snapshot.ts";
import { roleFromSlug, roleSlug } from "#src/lib/champion-meta/snapshot.ts";

export async function getStaticPaths() {
  const { index } = await championMetaSnapshot;
  return index.champions.flatMap((champion) =>
    champion.roles.map((entry) => ({
      params: { slug: champion.slug, role: roleSlug(entry.role) },
    })),
  );
}

const { slug, role: roleParam } = Astro.params;
const role = roleParam === undefined ? undefined : roleFromSlug(roleParam);
if (slug === undefined || role === undefined) {
  throw new Error(`Unknown champion route ${String(slug)}/${roleParam}`);
}
---

<ChampionPage slug={slug} role={role} />
