      "tips": [
        {
          "id": "support:Maokai:general:0",
          "text": "Dash onto an enemy with Twisted Advance, then follow with Bramble Smash. Maokai can't be targeted mid-dash, so it also dodges spells.",
          "refs": [
            { "kind": "ability", "key": "Maokai-W", "start": 24, "end": 39 },
            { "kind": "ability", "key": "Maokai-Q", "start": 58, "end": 71 },
            { "kind": "champion", "key": "Maokai", "start": 73, "end": 79 }
          ],
          "pWrong": 0.12
        },
        {
          "id": "support:Maokai:general:1",
          "text": "Toss Sapling Toss into brush when you can. It lasts longer and hurts more, but don't stack several in the same spot.",
          "refs": [
            { "kind": "ability", "key": "Maokai-E", "start": 5, "end": 17 }
          ],
          "pWrong": 0.09
        },
        {
          "id": "support:Maokai:general:2",
          "text": "Place saplings along the paths enemies walk, such as jungle entrances. They chase the first enemy who gets close and leave that enemy slowed.",
          "refs": [
            { "kind": "keyword", "key": "slowed", "start": 134, "end": 140 }
          ],
          "pWrong": 0.04
        },
        {
          "id": "support:Maokai:general:3",
          "text": "Aim Nature's Grasp from the side or through the fog. The longer the wall travels, the longer enemies stay rooted.",
          "refs": [
            { "kind": "ability", "key": "Maokai-R", "start": 4, "end": 18 },
            { "kind": "keyword", "key": "rooted", "start": 106, "end": 112 }
          ],
          "pWrong": 0.03
        },
        {
          "id": "support:Maokai:general:4",
          "text": "Cast your abilities often and take enemy spells in front of your carry. Each one shortens the cooldown on Sap Magic, which heals you on your next basic attack.",
          "refs": [
            {
              "kind": "ability",
              "key": "Maokai-passive",
              "start": 106,
              "end": 115
            }
          ],
          "pWrong": 0.4
        },
        {
          "id": "support:Maokai:general:5",
          "text": "Use Bramble Smash when enemies stand close to you. It knocks them back, so you can peel a diver off your carry.",
          "refs": [
            { "kind": "ability", "key": "Maokai-Q", "start": 4, "end": 17 }
          ],
          "pWrong": 0.14
        }
      ],
      "combos": []
    }
  ],
