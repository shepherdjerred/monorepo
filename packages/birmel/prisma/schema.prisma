generator client {
  provider = "prisma-client-js"
  // Stable in-repo output (gitignored) so codegen lands deterministically in a
  // bun workspace — matches the scout-for-lol backend pattern.
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "sqlite"
}

model DailyPostConfig {
  id         Int       @id @default(autoincrement())
  guildId    String    @unique
  channelId  String
  enabled    Boolean   @default(true)
  postTime   String    @default("09:00")
  timezone   String    @default("UTC")
  lastPostAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model ServerEvent {
  id        Int      @id @default(autoincrement())
  guildId   String
  eventType String
  eventData String
  actorId   String?
  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
}

model ScheduledAnnouncement {
  id          Int       @id @default(autoincrement())
  guildId     String
  channelId   String
  message     String
  scheduledAt DateTime
  sentAt      DateTime?
  repeat      String?
  createdBy   String
  createdAt   DateTime  @default(now())

  @@index([guildId])
  @@index([scheduledAt])
}

model MusicHistory {
  id        Int      @id @default(autoincrement())
  guildId   String
  trackUrl  String
  trackName String
  duration  Int
  userId    String
  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
}

model PollRecord {
  id        Int      @id @default(autoincrement())
  guildId   String
  channelId String
  messageId String   @unique
  pollId    String
  question  String
  createdBy String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
}

model UserActivity {
  id           Int      @id @default(autoincrement())
  guildId      String
  userId       String
  channelId    String
  activityType String
  metadata     String?
  createdAt    DateTime @default(now())

  @@index([guildId, userId, createdAt])
  @@index([guildId, activityType, createdAt])
}

model Birthday {
  id         Int      @id @default(autoincrement())
  userId     String
  guildId    String
  birthMonth Int
  birthDay   Int
  birthYear  Int?
  timezone   String   @default("UTC")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, guildId])
  @@index([guildId, birthMonth, birthDay])
}

model GuildOwner {
  id             Int       @id @default(autoincrement())
  guildId        String    @unique
  currentOwner   String
  nickname       String
  lastElectionAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ElectionPoll {
  id             Int       @id @default(autoincrement())
  guildId        String
  channelId      String
  messageId      String?
  pollType       String
  status         String
  scheduledStart DateTime
  scheduledEnd   DateTime
  actualStart    DateTime?
  actualEnd      DateTime?
  candidates     String
  winner         String?
  voteCounts     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([guildId, status])
  @@index([scheduledStart])
}

model AgentJob {
  id              String        @id @default(uuid())
  guildId         String
  channelId       String?
  threadId        String?
  actorUserId     String
  sourceChannelId String?
  sourceMessageId String?
  name            String?
  description     String?
  scheduleKind    String
  scheduleValue   String
  timezone        String        @default("UTC")
  nextRunAt       DateTime?
  status          String        @default("active")
  payloadKind     String        @default("tool")
  message         String?
  toolId          String?
  toolInput       String?
  agentPrompt     String?
  sessionId       String?
  session         AgentSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  deliveryMode    String        @default("discord")
  model           String?
  reasoningEffort String?
  textVerbosity   String?
  maxAttempts     Int           @default(3)
  timeoutMs       Int           @default(300000)
  attemptCount    Int           @default(0)
  lastRunAt       DateTime?
  lastStatus      String?
  lastError       String?
  claimedAt       DateTime?
  claimedBy       String?
  leaseExpiresAt  DateTime?
  legacyTaskId    Int?          @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  runs            AgentJobRun[]

  @@index([guildId, status])
  @@index([status, nextRunAt])
  @@index([channelId])
  @@index([threadId])
  @@index([sessionId])
  @@index([leaseExpiresAt])
}

model AgentJobRun {
  id         String    @id @default(uuid())
  jobId      String
  job        AgentJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status     String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  output     String?
  error      String?
  metadata   String?
  createdAt  DateTime  @default(now())

  @@index([jobId, startedAt])
  @@index([status, startedAt])
}

model AgentSession {
  id                     String              @id @default(uuid())
  guildId                String
  channelId              String
  threadId               String              @unique
  actorUserId            String
  label                  String?
  status                 String              @default("active")
  summary                String?
  summaryVersion         Int                 @default(1)
  summaryThroughSequence Int                 @default(0)
  expiresAt              DateTime?
  archivedAt             DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  events                 AgentSessionEvent[]
  jobs                   AgentJob[]

  @@index([guildId, status])
  @@index([channelId, status])
  @@index([actorUserId, status])
}

model AgentSessionEvent {
  id               String       @id @default(uuid())
  sessionId        String
  session          AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sequence         Int
  role             String
  eventType        String
  content          String
  discordMessageId String?
  toolId           String?
  metadata         String?
  createdAt        DateTime     @default(now())

  @@unique([sessionId, sequence])
  @@unique([sessionId, discordMessageId])
  @@index([eventType, createdAt])
}

model MemoryClaim {
  id              String           @id @default(uuid())
  identityKey     String           @unique
  guildId         String
  scope           String
  subject         String
  predicate       String
  value           String
  confidence      Float
  salience        Float
  origin          String
  validFrom       DateTime?
  validUntil      DateTime?
  status          String           @default("active")
  channelId       String?
  personaId       String?
  userId          String?
  relatedUserIds  String           @default("[]")
  embedding       String?
  lastConfirmedAt DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  revisions       MemoryRevision[]

  @@index([guildId, scope, status])
  @@index([channelId])
  @@index([personaId])
  @@index([userId])
  @@index([guildId, subject, predicate])
  @@index([lastConfirmedAt])
}

model MemoryRevision {
  id                      String      @id @default(uuid())
  claimId                 String
  claim                   MemoryClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  action                  String
  previousValue           String?
  nextValue               String?
  sourceDiscordMessageIds String
  authorUserId            String
  channelId               String
  extractorModel          String
  confidence              Float
  createdAt               DateTime    @default(now())

  @@index([claimId, createdAt])
  @@index([sourceDiscordMessageIds])
}

model AgentRun {
  id                       String    @id @default(uuid())
  discordMessageId         String    @unique
  guildId                  String
  channelId                String
  threadId                 String?
  actorUserId              String
  triggerKind              String
  persona                  String?
  route                    String?
  status                   String    @default("admitted")
  responseMessageId        String?
  incidentId               String?   @unique
  contextCoreCharacters    Int       @default(0)
  contextPersonaCharacters Int       @default(0)
  contextMemoryCharacters  Int       @default(0)
  contextTranscriptChars   Int       @default(0)
  selectedMemoryCount      Int       @default(0)
  inputTokens              Int?
  outputTokens             Int?
  finishReason             String?
  errorClass               String?
  startedAt                DateTime  @default(now())
  completedAt              DateTime?
  failedAt                 DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([guildId, createdAt])
  @@index([channelId, createdAt])
  @@index([status, createdAt])
}

model LegacyAgentRuntimeArchive {
  id          String   @id @default(uuid())
  sourceTable String
  sourceId    String
  payload     String
  archivedAt  DateTime @default(now())

  @@unique([sourceTable, sourceId])
  @@index([archivedAt])
}

model EditorSession {
  id             String   @id @default(uuid())
  userId         String
  guildId        String
  channelId      String
  threadId       String?
  messageId      String?
  repoName       String
  sdkSessionId   String?
  clonedRepoPath String? // Path to cloned repo in /tmp
  state          String   @default("active")
  pendingChanges String?
  summary        String?
  prUrl          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  expiresAt      DateTime

  @@index([userId, state])
  @@index([guildId])
  @@index([threadId])
}

model GitHubAuth {
  id           String    @id @default(uuid())
  userId       String    @unique
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
