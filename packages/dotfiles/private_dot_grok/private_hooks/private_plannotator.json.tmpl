{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); reason=$(printf '%s' \"$input\" | jq -r '.reason // empty'); [ \"$reason\" = \"end_turn\" ] || exit 0; printf '%s' \"$input\" | jq -r '.lastAssistantMessage // empty' | {{ .chezmoi.homeDir }}/.local/bin/plannotator annotate-last --stdin --gate --hook",
            "timeout": 345600
          }
        ]
      }
    ]
  }
}

