+// Replace `path` with `size` bytes so that a crash at any point leaves either
+// the previous complete file or the new one: write a sibling temp file, flush
+// it to disk, rename it over the target, then flush the directory entry.
+bool WriteFileAtomically(const std::string& path, const void* data, size_t size) {
+    const std::string temp = path + ".tmp";
+#ifndef _WIN32
+    int fd = open(temp.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0644);
+    if (fd < 0) {
+        return false;
+    }
+    const auto* bytes = static_cast<const uint8_t*>(data);
+    size_t written = 0;
+    while (written < size) {
+        ssize_t n = write(fd, bytes + written, size - written);
+        if (n < 0 && errno == EINTR) {
+            continue;
+        }
+        if (n <= 0) {
+            close(fd);
+            unlink(temp.c_str());
+            return false;
+        }
+        written += static_cast<size_t>(n);
+    }
+    if (fsync(fd) != 0 || close(fd) != 0) {
+        unlink(temp.c_str());
+        return false;
+    }
+    if (rename(temp.c_str(), path.c_str()) != 0) {
+        unlink(temp.c_str());
+        return false;
+    }
+    const size_t slash = path.find_last_of('/');
+    const std::string dir = slash == std::string::npos ? "." : path.substr(0, slash);
+    int dirfd = open(dir.c_str(), O_RDONLY);
+    if (dirfd >= 0) {
+        fsync(dirfd);
+        close(dirfd);
+    }
+    return true;
+#else
+    FILE* fp = fopen(temp.c_str(), "wb");
+    if (fp == NULL) {
+        return false;
+    }
+    const bool ok = fwrite(data, 1, size, fp) == size && fflush(fp) == 0;
+    fclose(fp);
+    std::error_code error;
+    if (ok) {
+        std::filesystem::rename(temp, path, error);
+    }
+    if (!ok || error) {
+        remove(temp.c_str());
+        return false;
+    }
+    return true;
+#endif
+}
+
+// Read a whole pak file. A missing file is an empty image; any other failure
+// is an error, so callers never rewrite a pak they could not read.
+bool ReadWholeFile(const std::string& path, std::vector<u8>& out) {
+    out.clear();
+    FILE* fp = fopen(path.c_str(), "rb");
+    if (fp == NULL) {
+        return errno == ENOENT;
+    }
+    bool ok = fseek(fp, 0, SEEK_END) == 0;
+    const long size = ok ? ftell(fp) : -1;
+    ok = ok && size >= 0 && fseek(fp, 0, SEEK_SET) == 0;
+    if (ok) {
+        out.resize(static_cast<size_t>(size));
+        ok = fread(out.data(), 1, out.size(), fp) == out.size();
+    }
+    fclose(fp);
+    return ok;
+}
+
+// Write `size` bytes at `offset`, keeping the rest of the file, atomically.
+bool WriteRegion(const std::string& path, size_t offset, const void* data, size_t size) {
+    std::vector<u8> content;
+    if (!ReadWholeFile(path, content)) {
+        return false;
+    }
+    if (content.size() < offset + size) {
+        content.resize(offset + size, 0);
+    }
+    memcpy(content.data() + offset, data, size);
+    return WriteFileAtomically(path, content.data(), content.size());
+}
