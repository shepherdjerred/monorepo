{
  "name": "@shepherdjerred/tasknotes-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#app/*": "./src/app/*",
    "#sync/*": "./src/sync/*",
    "#ui/*": "./src/ui/*",
    "#workspace/*": "./src/workspace/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run src",
    "test:ci": "bun ../../scripts/ci/run-ci-test.ts",
    "test:e2e": "bun --no-install --bun playwright test",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@shepherdjerred/facet-protocol": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "8.4.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@shepherdjerred/eslint-config": "workspace:*",
    "@types/bun": "1.4.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-istanbul": "5.0.5",
    "eslint": "^10.7.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "5.0.5"
  }
}
