#!/bin/sh

set -eu

# Homebrew's mermaid-cli ships without the chrome-headless-shell build its
# Puppeteer expects, and downloading one ties every machine to the exact
# version that mermaid-cli release pins. Chrome Canary is already installed on
# workstations and agent hosts (PinchTab's browser), so render with it. The
# variable is scoped to this process: a global PUPPETEER_EXECUTABLE_PATH or
# ~/.puppeteerrc would also redirect every other Puppeteer project.
PUPPETEER_EXECUTABLE_PATH="${PUPPETEER_EXECUTABLE_PATH:-/Applications/Google Chrome Canary.app/Contents/MacOS/Google Chrome Canary}"
export PUPPETEER_EXECUTABLE_PATH

exec "${HOMEBREW_PREFIX:-/opt/homebrew}/bin/mmdc" "$@"
