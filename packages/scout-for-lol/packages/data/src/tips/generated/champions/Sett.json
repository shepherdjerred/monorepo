  "general": [
    {
      "lane": "top",
      "inputHash": "f6402a0244b7ad21e9d9f0ca1caa8e4ee288f9874c21d91ede3566978c054031",
      "tips": [
        {
          "id": "top:Sett:general:0",
          "text": "Take hits before you cast Haymaker; the damage you absorb turns into a shield and extra damage. Cast it when the Grit bar is high.",
          "refs": [
            { "kind": "ability", "key": "Sett-W", "start": 26, "end": 34 }
          ],
          "pWrong": 0.2
        },
        {
          "id": "top:Sett:general:1",
          "text": "Aim Haymaker so the enemy is in the middle of the blast, because only the center deals true damage. The edges deal less, physical damage.",
          "refs": [
            { "kind": "ability", "key": "Sett-W", "start": 4, "end": 12 }
          ],
          "pWrong": 0.14
        },
        {
          "id": "top:Sett:general:2",
          "text": "Use Facebreaker when enemies are on both sides of you; hitting one on each side stuns them all. With only one side it just slows.",
          "refs": [
            { "kind": "ability", "key": "Sett-E", "start": 4, "end": 15 },
            { "kind": "keyword", "key": "slowed", "start": 123, "end": 128 }
          ],
          "pWrong": 0.04
        },
        {
          "id": "top:Sett:general:3",
          "text": "Start a trade with Knuckle Down: walk at the enemy with the extra speed, then land both empowered punches. They hurt more against high-health targets.",
          "refs": [
            { "kind": "ability", "key": "Sett-Q", "start": 19, "end": 31 }
          ],
          "pWrong": 0.03
        },
        {
          "id": "top:Sett:general:4",
          "text": "Fight when you are hurt but not about to die; Pit Grit heals you faster the lower your health is.",
          "refs": [
            { "kind": "ability", "key": "Sett-passive", "start": 46, "end": 54 }
          ],
          "pWrong": 0.03
        },
        {
          "id": "top:Sett:general:5",
          "text": "Weave your punches: the right punch is faster and hits harder, so keep attacking instead of stopping between hits.",
          "refs": [],
          "pWrong": 0.13
        },
        {
          "id": "top:Sett:general:6",
          "text": "Use The Show Stopper on a high-health enemy, ideally so the slam lands on their teammates too. Its damage grows with the target's bonus health.",
          "refs": [
            { "kind": "ability", "key": "Sett-R", "start": 4, "end": 20 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "top:Sett:general:7",
          "text": "Sett can't be stopped mid-dash during The Show Stopper, but terrain cuts the leap short. Cast it with open space ahead of you.",
          "refs": [
            { "kind": "champion", "key": "Sett", "start": 0, "end": 4 },
            { "kind": "ability", "key": "Sett-R", "start": 38, "end": 54 }
          ],
          "pWrong": 0.33
        }
      ],
      "combos": [
        {
          "id": "top:Sett:combo:0",
          "name": "Facebreaker into Haymaker",
          "category": "combo",
          "sequence": [
            { "kind": "ability", "key": "Sett-E" },
            { "kind": "ability", "key": "Sett-W" }
          ],
          "when": "When Facebreaker catches enemies on both sides and stuns them in lane or a fight.",
          "whenRefs": [
            { "kind": "ability", "key": "Sett-E", "start": 5, "end": 16 }
          ],
          "text": "The stun holds the enemy still, so Haymaker's narrow centre line is easy to land for true damage. Wait until the stun lands before you cast.",
          "textRefs": [
            { "kind": "ability", "key": "Sett-W", "start": 35, "end": 43 }
          ]
        },
        {
          "id": "top:Sett:combo:1",
          "name": "Throw the grab toward your team",
          "category": "trick",
          "sequence": [{ "kind": "ability", "key": "Sett-R" }],
          "when": "In a teamfight when you can choose which way to cast the ultimate.",
          "whenRefs": [],
          "text": "Sett leaps past the target and slams them down, so aim the cast to land them in your team's reach. Their allies get hit by the slam too.",
          "textRefs": [
            { "kind": "champion", "key": "Sett", "start": 0, "end": 4 }
          ]
        }
      ]
    }
  ],
  "matchups": [
