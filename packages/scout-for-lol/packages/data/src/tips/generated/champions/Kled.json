            { "kind": "ability", "key": "Briar-Q", "start": 96, "end": 105 }
          ],
          "pWrong": 0.52
        },
        {
          "id": "top:Kled:Briar:1",
          "text": "Briar's Blood Frenzy forces her to attack the nearest enemy. Use that to pull her into your trades and keep your Violent Tendencies ready.",
          "refs": [
