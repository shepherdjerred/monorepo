{
  "name": "@shepherdjerred/pr-fleet-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "test": "bun --no-install --bun vitest --config ../../../../vitest.config.ts run",
    "test:ci": "bun ../../../../scripts/ci/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../../../scripts/ci/run-ci-test.ts",
    "lint": "bunx eslint --cache ."
  },
  "dependencies": {
    "@shepherdjerred/pr-fleet-controller": "workspace:*",
    "@tanstack/react-query": "^5.101.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shepherdjerred/eslint-config": "workspace:*",
    "@types/bun": "1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "5.0.1",
    "@vitest/coverage-istanbul": "5.0.1"
  }
}
