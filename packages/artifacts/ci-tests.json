{
  "$schema": "../../scripts/ci-tests.schema.json",
  "package": "@shepherdjerred/artifacts",
  "steps": [
    {
      "runner": "vitest",
      "args": [
        "src/shared",
        "src/domain",
        "src/application",
        "src/bridge",
        "src/server",
        "--testTimeout",
        "30000",
        "--hookTimeout",
        "30000"
      ]
    },
    {
      "runner": "vitest",
      "name": "postgres-integration",
      "tier": "extended",
      "args": [
        "src/integration",
        "--testTimeout",
        "60000",
        "--hookTimeout",
        "60000"
      ]
    }
  ]
}
