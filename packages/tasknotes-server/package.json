{
  "name": "tasknotes-server",
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#architecture": "./architecture.config.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile=dist/tasknotes-server",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run",
    "lint": "bunx eslint . --max-warnings=0 && check-architecture",
    "docker:build": "docker buildx build --cache-from type=registry,ref=ghcr.io/shepherdjerred/tasknotes-server:buildcache ${DOCKER_BUILD_EXTRA_ARGS:-} --load -t tasknotes-server:dev -f Dockerfile ../..",
    "smoke": "bun scripts/smoke.ts",
    "test:ci": "bun ../../scripts/ci/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../scripts/ci/run-ci-test.ts"
  },
  "dependencies": {
    "@sentry/bun": "^10.70.0",
    "hono": "^4.12.18",
    "prom-client": "^15.1.3",
    "tasknotes-types": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shepherdjerred/architecture": "workspace:*",
    "@shepherdjerred/eslint-config": "workspace:*",
    "@types/bun": "1.4.0",
    "@typescript-eslint/utils": "^8.67.0",
    "eslint": "^10.3.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "vitest": "4.1.10",
    "@vitest/coverage-istanbul": "4.1.10"
  }
}
