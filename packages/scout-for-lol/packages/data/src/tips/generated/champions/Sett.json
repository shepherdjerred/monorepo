          ],
          "pWrong": 0.24
        },
        {
          "id": "top:Sett:Sion:1",
          "text": "Use Facebreaker when Sion is slowed or stands between you and a minion; the stun makes his short fight window your own.",
          "refs": [
            { "kind": "ability", "key": "Sett-E", "start": 4, "end": 15 },
            { "kind": "champion", "key": "Sion", "start": 21, "end": 25 },
