{
  "name": "@shepherdjerred/unix-socket-daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared scaffolding for local unix-socket HTTP daemons (toolkit discord, mc-harness): serve, idle TTL, state file, PID identity.",
  "exports": {
    ".": "./src/index.ts"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --target bun --outdir dist",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run test",
    "lint": "bunx eslint --cache .",
    "test:ci": "bun ../../scripts/ci/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../scripts/ci/run-ci-test.ts"
  },
  "devDependencies": {
    "@shepherdjerred/eslint-config": "workspace:*",
    "@types/bun": "1.4.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "vitest": "5.0.1"
  }
}
