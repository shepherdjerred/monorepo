{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // Provider bindings (`cdktn get`): never committed, restored from the
    // cache unless a provider pin (src/tofu/provider-versions.json), the cdktn
    // release (package.json) or the generator changes. A miss needs `tofu`,
    // Node and the provider registry; .mise.toml is already a global
    // dependency. The AsusWRT provider is built from this repository, so its
    // source is part of the bindings generated from it.
    "generate": {
      "inputs": [
        "package.json",
        "scripts/generate-bindings.ts",
        "src/homelab-stack.ts",
        "$TURBO_ROOT$/packages/homelab/src/tofu/provider-versions.json",
        "$TURBO_ROOT$/packages/homelab/scripts/tofu/provider-versions.ts",
        "$TURBO_ROOT$/packages/homelab/scripts/tofu/asuswrt-provider.ts",
        "$TURBO_ROOT$/packages/terraform-provider-asuswrt/**/*.go",
        "$TURBO_ROOT$/packages/terraform-provider-asuswrt/go.mod",
        "$TURBO_ROOT$/packages/terraform-provider-asuswrt/go.sum"
      ],
      "outputs": ["generated/**"]
    },
    // "Synth is current": synthesizes every stack and fails when a committed
    // src/tofu/<stack>/main.tf.json differs. It writes nothing. The posthog
    // stack inlines the analytics site registry, the cloudflare stack the
    // domain registry, and the cloudflare and seaweedfs stacks the
    // platform model (which reads two stacks' desired state).
    "build": {
      "dependsOn": ["^build", "generate"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/config/analytics-sites.json",
        "$TURBO_ROOT$/packages/homelab/src/domain-registry.{json,ts}",
        "$TURBO_ROOT$/packages/homelab/src/platform-model.{json,ts}",
        "$TURBO_ROOT$/packages/homelab/src/tofu/{anthropic-federation,google}/desired-state.json",
        "$TURBO_ROOT$/packages/homelab/src/tofu/*/main.tf.json"
      ],
      "outputs": []
    },
    // The suite compares a fresh synthesis with the committed
    // src/tofu/<stack>/main.tf.json and the pins with each stack's lock file.
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_ROOT$/config/analytics-sites.json",
        "$TURBO_ROOT$/packages/homelab/src/domain-registry.{json,ts}",
        "$TURBO_ROOT$/packages/homelab/src/platform-model.{json,ts}",
        "$TURBO_ROOT$/packages/homelab/src/tofu/{anthropic-federation,google}/desired-state.json",
        "$TURBO_ROOT$/packages/homelab/src/tofu/*/main.tf.json",
        "$TURBO_ROOT$/packages/homelab/src/tofu/*/.terraform.lock.hcl",
        "$TURBO_ROOT$/packages/homelab/src/tofu/provider-versions.json",
        "$TURBO_ROOT$/packages/homelab/scripts/tofu/provider-versions.ts"
      ]
    },
    "test:ci": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/ci/ci-reporting.ts",
        "$TURBO_ROOT$/scripts/ci/test-manifest-schema.ts",
        "$TURBO_ROOT$/scripts/ci/mstest-configuration.ts",
        "$TURBO_ROOT$/scripts/ci/gradle-junit.ts",
        "$TURBO_ROOT$/scripts/ci/run-ci-test.ts",
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_ROOT$/config/analytics-sites.json",
        "$TURBO_ROOT$/packages/homelab/src/domain-registry.{json,ts}",
        "$TURBO_ROOT$/packages/homelab/src/platform-model.{json,ts}",
        "$TURBO_ROOT$/packages/homelab/src/tofu/{anthropic-federation,google}/desired-state.json",
        "$TURBO_ROOT$/packages/homelab/src/tofu/*/main.tf.json",
        "$TURBO_ROOT$/packages/homelab/src/tofu/*/.terraform.lock.hcl",
        "$TURBO_ROOT$/packages/homelab/src/tofu/provider-versions.json",
        "$TURBO_ROOT$/packages/homelab/scripts/tofu/provider-versions.ts"
      ]
    }
  }
}
