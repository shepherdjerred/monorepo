{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sjer.red/schemas/ci-test-manifest.schema.json",
  "title": "Monorepo CI test reporting manifest",
  "type": "object",
  "required": ["$schema", "version", "testlessWorkspaces", "separateTests"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "./ci-test-manifest.schema.json"
    },
    "version": {
      "const": 2
    },
    "testlessWorkspaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package", "directory", "reason"],
        "properties": {
          "package": {
            "type": "string",
            "minLength": 1
          },
          "directory": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "separateTests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package", "directory", "reason"],
        "properties": {
          "package": {
            "type": "string",
            "minLength": 1
          },
          "directory": {
            "type": "string",
            "minLength": 1
          },
          "localScripts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["test"],
            "properties": {
              "build": {
                "const": "build:local"
              },
              "test": {
                "const": "test:local"
              }
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
