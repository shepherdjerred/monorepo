      "inputHash": "f57e22340dfa9be058a49bf6b8e055c1500cb56a4636999e0c951e1e1d9dd321",
      "tips": [
        {
          "id": "top:Gragas:general:0",
          "text": "Use Drunken Rage the moment you see damage coming, since the damage reduction starts as you begin drinking. Your next attack then hits harder.",
          "refs": [
            { "kind": "ability", "key": "Gragas-W", "start": 4, "end": 16 }
          ],
          "pWrong": 0.04
        },
        {
          "id": "top:Gragas:general:1",
          "text": "Drunken Rage deals extra damage based on the target's max health, so use it on tanky top laners. Weave it into your trades.",
          "refs": [
            { "kind": "ability", "key": "Gragas-W", "start": 0, "end": 12 }
          ],
          "pWrong": 0.06
        },
        {
          "id": "top:Gragas:general:2",
          "text": "Drop Barrel Roll where the enemy will step and let it sit. It hits harder and slows more the longer it sits, so detonate it late when you can.",
          "refs": [
            { "kind": "ability", "key": "Gragas-Q", "start": 5, "end": 16 },
            { "kind": "keyword", "key": "slowed", "start": 78, "end": 83 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "top:Gragas:general:3",
          "text": "Recast Barrel Roll to blow it up early when the enemy is about to leave the area.",
          "refs": [
            { "kind": "ability", "key": "Gragas-Q", "start": 7, "end": 18 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "top:Gragas:general:4",
          "text": "Body Slam stops on the first enemy it hits and knocks them up. Its cooldown is cut when it hits, so use it to start a trade.",
          "refs": [
            { "kind": "ability", "key": "Gragas-E", "start": 0, "end": 9 }
          ],
          "pWrong": 0.93,
          "hidden": true
        },
        {
          "id": "top:Gragas:general:5",
          "text": "Cast Barrel Roll or Explosive Cask during the Body Slam dash to chain your damage together.",
          "refs": [
            { "kind": "ability", "key": "Gragas-Q", "start": 5, "end": 16 },
            { "kind": "ability", "key": "Gragas-R", "start": 20, "end": 34 },
            { "kind": "ability", "key": "Gragas-E", "start": 46, "end": 55 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "top:Gragas:general:6",
          "text": "Knock enemies back toward your tower with Explosive Cask. Aim so they are pushed into your side, not away from it.",
          "refs": [
            { "kind": "ability", "key": "Gragas-R", "start": 42, "end": 56 }
          ],
          "pWrong": 0.04
        },
        {
          "id": "top:Gragas:general:7",
          "text": "Combo Body Slam into Explosive Cask at level 6 to set up kills for your team.",
          "refs": [
            { "kind": "ability", "key": "Gragas-E", "start": 6, "end": 15 },
            { "kind": "ability", "key": "Gragas-R", "start": 21, "end": 35 }
          ],
          "pWrong": 0.04
        },
        {
          "id": "top:Gragas:general:8",
          "text": "Use abilities freely in trades, since Happy Hour heals you when you cast one.",
          "refs": [
            {
              "kind": "ability",
              "key": "Gragas-passive",
              "start": 38,
              "end": 48
            }
          ],
          "pWrong": 0.12
        }
      ],
      "combos": [
