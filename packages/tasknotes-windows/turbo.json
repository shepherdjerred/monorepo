{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  // Every task here shells out to the mise-pinned .NET SDK. Turbo's strict env
  // mode drops MISE_DATA_DIR, which the CI image sets to /opt/mise, so without
  // the passthrough `mise where dotnet` resolves against the default
  // ~/.local/share/mise and reports the SDK as not installed.
  "tasks": {
    "build": {
      "passThroughEnv": [
        "APPDATA",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "LOCALAPPDATA",
        "MISE_DATA_DIR",
        "NO_PROXY",
        "TEMP",
        "TMP",
        "USERPROFILE"
      ],
      "inputs": [
        "src/**",
        "tests/**",
        "Directory.Build.props",
        "Directory.Build.targets",
        "Directory.Packages.props",
        "projects.json",
        "coverage-baseline.json",
        "coverage.settings.xml",
        "stryker-config.json",
        ".config/dotnet-tools.json",
        "TaskNotes.Windows.Portable.slnx",
        "**/packages.lock.json",
        "!**/bin/**",
        "!**/obj/**"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["build", "^build", "generate"],
      "passThroughEnv": [
        "APPDATA",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "LOCALAPPDATA",
        "MISE_DATA_DIR",
        "NO_PROXY",
        "TEMP",
        "TMP",
        "USERPROFILE"
      ],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["typecheck", "^build", "generate"],
      "passThroughEnv": [
        "APPDATA",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "LOCALAPPDATA",
        "MISE_DATA_DIR",
        "NO_PROXY",
        "TEMP",
        "TMP",
        "USERPROFILE"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": ["lint", "^build", "generate"],
      "passThroughEnv": [
        "APPDATA",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "LOCALAPPDATA",
        "MISE_DATA_DIR",
        "NO_PROXY",
        "TEMP",
        "TMP",
        "USERPROFILE"
      ],
      "outputs": []
    },
    "test:ci": {
      // The portable coverage ratchet always consumes fresh reports. This run
      // supplies both JUnit and coverage, with no second test invocation.
      "cache": false,
      "env": ["NODE_ENV", "TASKNOTES_TEST_SEED"],
      "dependsOn": ["lint", "^build", "generate"],
      "passThroughEnv": [
        "APPDATA",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "LOCALAPPDATA",
        "MISE_DATA_DIR",
        "NO_PROXY",
        "TEMP",
        "TMP",
        "USERPROFILE"
      ],
      "outputs": []
    },
    "test:report": {
      "dependsOn": ["lint", "^build", "generate"],
      "passThroughEnv": [
        "APPDATA",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "LOCALAPPDATA",
        "MISE_DATA_DIR",
        "NO_PROXY",
        "TEMP",
        "TMP",
        "USERPROFILE"
      ],
      "outputs": []
    },
    // Check the two fresh instrumented reports produced by test:ci. Keep the
    // Git diff and baseline comparison uncached as the target branch moves.
    "coverage:portable:check": {
      "dependsOn": ["lint", "^build", "generate", "test:ci"],
      "cache": false,
      "passThroughEnv": [
        "APPDATA",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "LOCALAPPDATA",
        "MISE_DATA_DIR",
        "NO_PROXY",
        "TASKNOTES_COVERAGE_BASE",
        "TEMP",
        "TMP",
        "USERPROFILE"
      ],
      "outputs": []
    }
  }
}
