{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        // ESLint resolves the parent Scout config; it is an input of these
        // lint tasks only, not a global dependency.
        "$TURBO_ROOT$/packages/scout-for-lol/eslint.config.ts"
      ]
    },
    "build:storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "test:e2e": {
      "dependsOn": ["build:storybook"],
      "cache": true,
      "env": [
        "CI",
        "CI_PLAYWRIGHT_IMAGE",
        "CI_REPORTING_BUILD_ID",
        "PLAYWRIGHT_BRANDED_BROWSERS"
      ],
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"]
    }
  }
}
