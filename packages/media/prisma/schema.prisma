generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  runtime      = "bun"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum MediaKind {
  movie
  series
  season
  episode
}

enum Availability {
  wanted
  searching
  downloading
  validating
  importing
  available
  quarantined
  removed
}

enum UserRole {
  owner
  member
}

enum OperationStatus {
  queued
  running
  completed
  failed
  reconciling
}

// Internal transaction-local validation work, empty after every successful commit.
model PlexClaimValidation {
  transactionId BigInt
  groupId String
  @@id([transactionId, groupId], map: "plex_claim_validation_pk")
}

// Transient commit-deadline work; never evidence or application authority.
model PlexDeadlineValidation {
  transactionId BigInt @id(map: "plex_deadline_validation_pk")
  deadlineMs BigInt
}

model PlexAssociationEvidence {
  id String @id @default(uuid())
  mediaId String
  edition String
  target MediaIntent @relation(fields: [mediaId, edition], references: [mediaId, edition], onDelete: Restrict, onUpdate: Restrict)
  assetId String
  asset LibraryAsset @relation(fields: [assetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  serverMachineId String
  associationHash String
  evidence Json
  createdAt DateTime @default(now())
  current PlexBindingCurrent[]
  members PlexClaimGroupMember[]
  items PlexItemClaim[]
  watches PlexWatchProjection[]
  @@unique([mediaId, edition, associationHash], map: "plex_evidence_scope_hash")
  @@unique([id, mediaId, edition, associationHash], map: "plex_evidence_scope_id")
  @@index([assetId], map: "plex_evidence_asset_idx")
}

model PlexBindingCurrent {
  mediaId String
  edition String
  target MediaIntent @relation(fields: [mediaId, edition], references: [mediaId, edition], onDelete: Restrict, onUpdate: Restrict)
  evidenceId String?
  associationHash String?
  evidence PlexAssociationEvidence? @relation(fields: [evidenceId, mediaId, edition, associationHash], references: [id, mediaId, edition, associationHash], onDelete: Restrict, onUpdate: Restrict, map: "plex_current_evidence_fk")
  revision Int @default(0)
  verifiedStartedAt DateTime?
  verifiedCompletedAt DateTime?
  @@id([mediaId, edition], map: "plex_binding_current_pk")
  @@index([evidenceId], map: "plex_current_evidence_idx")
}

model PlexClaimGroup {
  id String @id @default(uuid())
  serverMachineId String
  groupHash String
  group Json
  members PlexClaimGroupMember[]
  parts PlexPartClaim[]
  paths PlexPathClaim[]
  @@unique([serverMachineId, groupHash], map: "plex_claim_group_key")
}

model PlexClaimGroupMember {
  groupId String
  group PlexClaimGroup @relation(fields: [groupId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  mediaId String
  edition String
  evidenceId String
  associationHash String
  evidence PlexAssociationEvidence @relation(fields: [evidenceId, mediaId, edition, associationHash], references: [id, mediaId, edition, associationHash], onDelete: Restrict, onUpdate: Restrict, map: "plex_member_evidence_fk")
  item PlexItemClaim?
  @@id([groupId, mediaId, edition], map: "plex_claim_member_pk")
  @@unique([mediaId, edition], map: "plex_claim_member_scope")
}

model PlexItemClaim {
  serverMachineId String
  sectionId String
  ratingKey String
  groupId String
  mediaId String
  edition String
  member PlexClaimGroupMember @relation(fields: [groupId, mediaId, edition], references: [groupId, mediaId, edition], onDelete: Restrict, onUpdate: Restrict, map: "plex_item_member_fk")
  evidenceId String
  associationHash String
  evidence PlexAssociationEvidence @relation(fields: [evidenceId, mediaId, edition, associationHash], references: [id, mediaId, edition, associationHash], onDelete: Restrict, onUpdate: Restrict, map: "plex_item_evidence_fk")
  @@id([serverMachineId, sectionId, ratingKey], map: "plex_item_claim_pk")
  @@unique([groupId, mediaId, edition], map: "plex_item_member_key")
}

model PlexPartClaim {
  serverMachineId String
  partId String
  groupId String
  group PlexClaimGroup @relation(fields: [groupId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  canonicalPath String
  @@id([serverMachineId, partId], map: "plex_part_claim_pk")
  @@index([groupId], map: "plex_part_group_idx")
}

model PlexPathClaim {
  serverMachineId String
  canonicalPathHash String
  canonicalPath String
  groupId String
  group PlexClaimGroup @relation(fields: [groupId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@id([serverMachineId, canonicalPathHash], map: "plex_path_claim_pk")
  @@index([groupId], map: "plex_path_group_idx")
}

model PlexWatchProjection {
  userId String
  user MediaUser @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  mediaId String
  edition String
  target MediaIntent @relation(fields: [mediaId, edition], references: [mediaId, edition], onDelete: Restrict, onUpdate: Restrict)
  evidenceId String
  associationHash String
  evidence PlexAssociationEvidence @relation(fields: [evidenceId, mediaId, edition, associationHash], references: [id, mediaId, edition, associationHash], onDelete: Restrict, onUpdate: Restrict, map: "plex_watch_evidence_fk")
  bindingRevision Int
  purpose String
  watchBatchRevision BigInt
  observedAt DateTime
  watched Boolean
  source String
  authority Json
  authorityHash String
  @@id([userId, mediaId, edition], map: "plex_watch_projection_pk")
}

model RetentionPlexProjection {
  decisionId String @id
  decision RetentionDecision @relation(fields: [decisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  projection Json
  projectionHash String
  createdAt DateTime @default(now())
}

model PlexBindingVerificationRequest {
  operationId String @id
  operation Operation @relation(fields: [operationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  expected Json
  expectedHash String
  recoveryEpoch Int
  assetIds String[]
  createdAt DateTime @default(now())
  receipt PlexBindingVerificationReceipt?
  @@unique([operationId, expectedHash], map: "plex_verify_request_hash")
}

model PlexBindingVerificationReceipt {
  operationId String @id(map: "plex_verify_receipt_pk")
  expectedHash String
  request PlexBindingVerificationRequest @relation(fields: [operationId, expectedHash], references: [operationId, expectedHash], onDelete: Restrict, onUpdate: Restrict, map: "plex_verify_receipt_request_fk")
  completion Json
  completionHash String
  createdAt DateTime @default(now())
  @@unique([operationId, expectedHash], map: "plex_verify_receipt_parent")
}

model NativePlexProofBatch {
  id String @id @default(uuid())
  planId String
  plan NativeRecoveryPlan @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  operationId String
  operation Operation @relation(fields: [operationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  networkObservationId String @unique(map: "native_plex_network_key")
  networkObservation NativeRecoveryObservation @relation("PlexBatchNetwork", fields: [networkObservationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  plexObservationId String @unique(map: "native_plex_observation_key")
  plexObservation NativeRecoveryObservation @relation("PlexBatchAssociation", fields: [plexObservationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  batch Json
  batchHash String
  createdAt DateTime @default(now())
  @@index([planId], map: "native_plex_plan_idx")
  @@index([operationId], map: "native_plex_operation_idx")
}

model MediaUser {
  plexWatchProjections PlexWatchProjection[]
  id                 String                 @id @default(uuid())
  plexAccountId      String                 @unique
  displayName        String
  role               UserRole               @default(member)
  restricted         Boolean                @default(false)
  version            Int                    @default(0)
  email              String?
  emailVerifiedAt    DateTime?
  discordId          String?                @unique
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  sessions           MediaSession[]
  credentials        Credential[]
  requests           MediaRequest[]
  holds              RetentionHold[]
  watchStates        WatchState[]
  idempotencyRecords IdempotencyRecord[]
  notifications      NotificationDelivery[]
  notificationPreference NotificationPreference?
  emailVerifications EmailVerification[]
  discordLinks DiscordLink[]
  plexIdentity PlexIdentityMapping?
  migrationProposals AdoptionProposal[]
  migrationBundleReviews MigrationBundleReview[]
  plexExclusionRuns PlexExclusionRun[]
  handoffPlans MediaHandoffPlan[]
  handoffReceipts MediaHandoffReceipt[]
  releasedRecoveryHolds RecoveryHold[]
  subtitlePolicyVersions MediaSubtitlePolicyVersion[]
  recoveryReviews RecoveryReview[]
  recoveryResponses RecoveryResponse[] @relation("RecoveryRespondent")
  recoveryDeclarations RecoveryResponse[] @relation("RecoveryDeclarant")
  recoveryReceipts RecoveryReleaseReceipt[]
  nativeRecoveryPlans NativeRecoveryPlan[]
  nativeRecoveryReceipts NativeRecoveryReceipt[]
  subtitleReplacements SubtitleReplacement[]
  subtitleReplacementApprovals SubtitleReplacementReview[]
  legacyRequesterBindings LegacyRequesterBinding[] @relation("LegacyRequesterSubject")
  legacyRequesterDeclarations LegacyRequesterBinding[] @relation("LegacyRequesterActor")
  movieEditionChoices MovieEditionChoice[] @relation("MovieChoiceActor")
}

model MigrationCapture {
  id String @id @default(uuid())
  schemaVersion Int
  sourceInstanceId String
  sourceKind String
  sourceVersion String
  startedAt DateTime
  completedAt DateTime
  complete Boolean
  stable Boolean
  manifestHash String @unique
  manifest Json
  records MigrationRecord[]
  proposals AdoptionProposal[]
  bundles MigrationBundleCapture[]
  requesterBindings LegacyRequesterBinding[]
  createdAt DateTime @default(now())
  @@index([sourceInstanceId, completedAt])
}

model MigrationRecord {
  captureId String
  capture MigrationCapture @relation(fields: [captureId], references: [id], onDelete: Restrict)
  provenanceKey String
  kind String
  sourceId String
  observationHash String
  payload Json
  @@id([captureId, provenanceKey])
}

model AdoptionProposal {
  id String @id @default(uuid())
  captureId String
  capture MigrationCapture @relation(fields: [captureId], references: [id], onDelete: Restrict)
  reportHash String
  recoveryEpoch Int
  runtimeVersion Int
  status String
  report Json
  actorId String?
  actor MediaUser? @relation(fields: [actorId], references: [id], onDelete: Restrict)
  approvedAt DateTime?
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([captureId, reportHash, recoveryEpoch, runtimeVersion])
}

model MigrationBundle {
  id String @id @default(uuid())
  bundleHash String @unique
  manifest Json
  captures MigrationBundleCapture[]
  reviews MigrationBundleReview[]
  createdAt DateTime @default(now())
}

model MigrationBundleCapture {
  bundleId String
  bundle MigrationBundle @relation(fields: [bundleId], references: [id], onDelete: Restrict)
  captureId String
  capture MigrationCapture @relation(fields: [captureId], references: [id], onDelete: Restrict)
  @@id([bundleId, captureId])
}

model MigrationBundleReview {
  handoffPlans MediaHandoffPlan[]
  id String @id @default(uuid())
  bundleId String
  bundle MigrationBundle @relation(fields: [bundleId], references: [id], onDelete: Restrict)
  reportHash String
  report Json
  selection Json
  recoveryEpoch Int
  runtimeVersion Int
  status String
  actorId String?
  actor MediaUser? @relation(fields: [actorId], references: [id], onDelete: Restrict)
  approvedAt DateTime?
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([bundleId, reportHash, recoveryEpoch, runtimeVersion])
}

model PlexExclusionRun {
  id String @id @default(uuid())
  ownerId String
  owner MediaUser @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  state String
  recoveryEpoch Int
  runtimeVersion Int
  planDigest String
  plan Json
  journal Json
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  proof PlexExclusionProof?
}

model PlexExclusionProof {
  id String @id @default(uuid())
  runId String @unique
  run PlexExclusionRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  serverMachineId String
  serverVersion String
  sectionId String
  sectionUuid String
  libraryRoot String
  controlRoot String
  rootMarkerSha256 String
  controlMarkerSha256 String
  configurationDigest String
  recoveryEpoch Int
  evidence Json
  verifiedAt DateTime
  revokedAt DateTime?
  @@index([serverMachineId, sectionId, libraryRoot, recoveryEpoch])
}

model PlexIdentityMapping {
  userId String @id
  user MediaUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverMachineId String
  serverAccountId String?
  homeUserId String?
  kind String
  permittedSectionIds String[] @default([])
  permittedMediaKinds String[] @default([])
  plexRestricted Boolean @default(false)
  verifiedAt DateTime?
  version Int @default(0)
  @@unique([serverMachineId, serverAccountId])
  @@unique([serverMachineId, homeUserId])
}

model NotificationPreference {
  userId String @id
  user MediaUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled Boolean @default(false)
  discordEnabled Boolean @default(false)
  upgrades Boolean @default(false)
  removalCompleted Boolean @default(false)
  version Int @default(0)
}

model EmailVerification {
  id String @id @default(uuid())
  userId String
  user MediaUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  email String
  tokenHash String @unique
  encryptedToken String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}

model DiscordLink {
  id String @id @default(uuid())
  userId String
  user MediaUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  stateHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model MediaSession {
  id        String    @id
  userId    String
  user      MediaUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  csrfHash  String
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}

model PlexLogin {
  id              String   @id @default(uuid())
  pinId           String
  pinCode         String
  browserHash     String
  encryptedDevice String
  expiresAt       DateTime
  createdAt       DateTime @default(now())
}

model Credential {
  id         String     @id @default(uuid())
  userId     String?
  user       MediaUser? @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String
  ciphertext String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([userId, kind])
}

model MediaItem {
  subtitlePolicies MediaSubtitlePolicyVersion[]
  recoveryHolds RecoveryHold[]
  editionDefinitions MediaEditionDefinition[]
  id            String              @id @default(uuid())
  kind          MediaKind
  title         String
  year          Int?
  runtimeMinutes Int?
  originalLanguage String?
  airDate DateTime?
  catalogState String @default("ready")
  parentId      String?
  parent        MediaItem?          @relation("MediaHierarchy", fields: [parentId], references: [id])
  children      MediaItem[]         @relation("MediaHierarchy")
  seasonNumber  Int?
  episodeNumber Int?
  tmdbId        Int?
  externalIds   Json                @default("{}")
  availability  Availability        @default(wanted)
  version       Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  requests      MediaRequest[]
  intents       MediaIntent[]
  assets        AssetCoverage[]
  watchStates   WatchState[]
  holds         RetentionHold[]
  retention     RetentionDecision[]
  acquisitionReservations AcquisitionReservation[]

  @@unique([kind, tmdbId])
  @@index([parentId, seasonNumber, episodeNumber])
}

model MediaRequest {
  id                    String    @id @default(uuid())
  userId                String
  user                  MediaUser @relation(fields: [userId], references: [id])
  mediaId               String
  media                 MediaItem @relation(fields: [mediaId], references: [id])
  edition               String @default("default")
  target                MediaIntent @relation(fields: [mediaId, edition], references: [mediaId, edition], onDelete: Restrict)
  active                Boolean   @default(true)
  direct                Boolean   @default(true)
  excluded              Boolean   @default(false)
  coverageCompletedAt   DateTime?
  subtitleLanguages     String[]  @default([])
  includeFutureEpisodes Boolean   @default(false)
  includeSpecials       Boolean   @default(false)
  sponsorRequestId      String?
  version               Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  coverageSources RequestCoverage[] @relation("CoveredRequest")
  expandedCoverage RequestCoverage[] @relation("RootRequest")
  movieEditionChoiceId String?
  movieEditionChoiceRevision Int @default(0)
  movieEditionChoice MovieEditionChoice? @relation("LiveMovieChoice", fields: [id, movieEditionChoiceId, movieEditionChoiceRevision], references: [requestId, id, choiceRevision], onDelete: Restrict, onUpdate: Restrict, map: "movie_request_live_choice_fk")
  movieEditionChoices MovieEditionChoice[] @relation("MovieChoiceRequest")

  @@unique([userId, mediaId, edition])
  @@unique([id, edition])
  @@unique([id, mediaId, edition])
  @@unique([id, userId, mediaId, edition], map: "movie_request_subject_scope_key")
  @@index([mediaId, active])
}

model MovieEditionChoice {
  id String @id @default(uuid())
  requestId String
  choiceRevision Int
  actorId String
  actor MediaUser @relation("MovieChoiceActor", fields: [actorId], references: [id], onDelete: Restrict)
  subjectUserId String
  rootMediaId String
  edition String
  definitionVersion Int
  registryVersion Int
  requestVersionAtChoice Int
  authority Json
  createdAt DateTime @default(now())
  request MediaRequest @relation("MovieChoiceRequest", fields: [requestId, subjectUserId, rootMediaId, edition], references: [id, userId, mediaId, edition], onDelete: Restrict, onUpdate: Restrict, map: "movie_choice_request_fk")
  definition MediaEditionDefinition @relation(fields: [rootMediaId, edition, definitionVersion], references: [rootMediaId, key, definitionVersion], onDelete: Restrict, onUpdate: Restrict, map: "movie_choice_definition_fk")
  liveRequests MediaRequest[] @relation("LiveMovieChoice")
  attempts AcquisitionAttempt[]
  @@unique([requestId, choiceRevision], map: "movie_choice_revision_key")
  @@unique([requestId, id, choiceRevision], map: "movie_choice_live_key")
  @@unique([id, choiceRevision], map: "movie_choice_attempt_key")
  @@index([rootMediaId, edition], map: "movie_choice_scope_idx")
}

model RequestCoverage {
  rootRequestId String
  rootRequest MediaRequest @relation("RootRequest", fields: [rootRequestId, edition], references: [id, edition], onDelete: Cascade)
  requestId String
  request MediaRequest @relation("CoveredRequest", fields: [requestId, mediaId, edition], references: [id, mediaId, edition], onDelete: Cascade)
  mediaId String
  edition String @default("default")
  active Boolean @default(true)
  sourceVersion Int
  createdAt DateTime @default(now())
  @@id([rootRequestId, mediaId])
  @@index([requestId, active])
}

model QualityProfile {
  id        String                  @id @default(uuid())
  name      String
  version   Int                     @default(0)
  rules     Json
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  intents   MediaIntent[]
  versions  QualityProfileVersion[]
  defaults QualityProfileDefault[]
}

model QualityProfileDefault {
  kind String @id
  profileId String
  profile QualityProfile @relation(fields: [profileId], references: [id])
  version Int @default(0)
}

model QualityProfileVersion {
  movieAssessments MovieReleaseAssessment[]
  profileId String
  profile   QualityProfile @relation(fields: [profileId], references: [id])
  version   Int
  rules     Json
  createdAt DateTime       @default(now())

  @@id([profileId, version])
}

model MediaEditionDefinition {
  rootMediaId String
  root MediaItem @relation(fields: [rootMediaId], references: [id], onDelete: Restrict)
  key String
  policy String
  pathLabel String
  plexLabel String
  definitionVersion Int @default(0)
  displayLabel String
  displayVersion Int @default(0)
  targets MediaIntent[]
  assets LibraryAsset[]
  movieChoices MovieEditionChoice[]
  @@id([rootMediaId, key])
  @@unique([rootMediaId, key, definitionVersion], map: "movie_definition_version_key")
}

model MediaIntent {
  movieAssessments MovieReleaseAssessment[]
  plexEvidence PlexAssociationEvidence[]
  plexBinding PlexBindingCurrent?
  plexWatchProjections PlexWatchProjection[]
  watchObservationFence WatchObservationFence?
  automationEpoch Int @default(-1)
  mediaId                String
  media                  MediaItem       @relation(fields: [mediaId], references: [id])
  edition                String @default("default")
  editionRootId          String?
  definition             MediaEditionDefinition? @relation(fields: [editionRootId, edition], references: [rootMediaId, key], onDelete: Restrict)
  availability           Availability @default(wanted)
  generation             Int             @default(0)
  desiredPresence        Boolean         @default(true)
  monitoring             Boolean         @default(true)
  profileId              String?
  profile                QualityProfile? @relation(fields: [profileId], references: [id])
  version                Int             @default(0)
  intentionallyRemovedAt DateTime?
  updatedAt              DateTime        @updatedAt
  requests MediaRequest[]
  reservations AcquisitionReservation[]
  coverage AssetCoverage[]
  watchStates WatchState[]
  holds RetentionHold[]
  retention RetentionDecision[]
  recoveryHolds RecoveryHold[]
  subtitlePolicies MediaSubtitlePolicyVersion[]
  @@id([mediaId, edition])
}

model ReleaseCandidate {
  movieAssessments MovieReleaseAssessment[]
  id                String               @id @default(uuid())
  providerId        String
  providerReleaseId String
  title             String
  attributes        Json
  evaluation        Json
  encryptedSource   String?
  mediaIds          String[]
  searchedForMediaIds String[] @default([])
  sourceEvidence Json?
  createdAt         DateTime             @default(now())
  attempts          AcquisitionAttempt[]

  @@unique([providerId, providerReleaseId])
}

// Append-only interpretation of an original provider snapshot. Old snapshot bytes stay literal.
model MovieReleaseAssessment {
  id String @id @default(uuid())
  releaseId String
  release ReleaseCandidate @relation(fields: [releaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  mediaId String
  edition String
  target MediaIntent @relation(fields: [mediaId, edition], references: [mediaId, edition], onDelete: Restrict, onUpdate: Restrict, map: "movie_assessment_target_fk")
  sourceHash String
  canonicalHash String
  profileId String
  profileVersion Int
  profile QualityProfileVersion @relation(fields: [profileId, profileVersion], references: [profileId, version], onDelete: Restrict, onUpdate: Restrict, map: "movie_assessment_profile_fk")
  profileHash String
  parserVersion String
  raw String
  assessment Json
  assessmentHash String
  createdAt DateTime @default(now())
  @@unique([releaseId, mediaId, edition, sourceHash, canonicalHash, profileId, profileVersion, profileHash, parserVersion], name: "lookup", map: "movie_assessment_lookup")
  @@unique([id, assessmentHash], map: "movie_assessment_identity")
  @@index([mediaId, edition, createdAt], map: "movie_assessment_target")
}

model MediaProvider {
  id String @id
  enabled Boolean @default(false)
  configuration Json @default("{}")
  seedingPolicy Json @default("{\"kind\":\"unknown\"}")
  credentialId String?
  lastError String?
  lastFeedAt DateTime?
  feedState String @default("unconfigured")
  updatedAt DateTime @updatedAt
}

model PlexInventoryObservation {
  sectionId String
  ratingKey String
  path String
  kind String
  guids Json
  seasonNumber Int?
  episodeNumber Int?
  scanId String
  observedAt DateTime @default(now())
  @@id([sectionId, ratingKey, path])
  @@index([path])
  @@index([scanId])
}

model ReconciliationScan {
  id String @id
  kind String
  state String @default("running")
  progress Json @default("{}")
  startedAt DateTime @default(now())
  completedAt DateTime?
}

model ProviderLease {
  providerId String @id
  ownerId String?
  leaseUntil DateTime?
  nextAllowedAt DateTime @default(now())
}

model MediaRuntimeState {
  id String @id
  mode String @default("observe")
  recoveryEpoch Int @default(0)
  ownershipConfirmed Boolean @default(false)
  version Int @default(0)
  updatedAt DateTime @updatedAt
}

model AcquisitionAttempt {
  publicationTransition MediaPublicationTransition?
  edition          String @default("default")
  id               String                   @id @default(uuid())
  releaseId        String
  release          ReleaseCandidate         @relation(fields: [releaseId], references: [id])
  sponsorRequestId String
  mediaIds         String[]
  generations      Json
  state            String
  torrentId        String?
  torrent          Torrent?                 @relation(fields: [torrentId], references: [id])
  operationId      String                   @unique
  coordinatorOperationId String?
  failure          Json?
  filePlan         Json?
  identityEvidence Json?
  movieEditionChoiceId String?
  movieEditionChoiceRevision Int?
  movieEditionAuthority Json?
  movieEditionChoice MovieEditionChoice? @relation(fields: [movieEditionChoiceId, movieEditionChoiceRevision], references: [id, choiceRevision], onDelete: Restrict, onUpdate: Restrict, map: "movie_attempt_choice_fk")
  recoveryEpoch    Int                      @default(0)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  reservations     AcquisitionReservation[]
  @@unique([id, edition])
}

model AcquisitionReservation {
  mediaId    String
  media      MediaItem          @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  edition    String @default("default")
  target     MediaIntent @relation(fields: [mediaId, edition], references: [mediaId, edition], onDelete: Restrict)
  attemptId  String
  attempt    AcquisitionAttempt @relation(fields: [attemptId, edition], references: [id, edition])
  generation Int
  createdAt  DateTime           @default(now())

