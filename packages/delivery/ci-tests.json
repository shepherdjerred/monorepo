{
  "$schema": "../../scripts/ci-tests.schema.json",
  "package": "@shepherdjerred/delivery",
  "steps": [
    {
      "runner": "command",
      "name": "generate",
      "tier": "shared",
      "command": ["bun", "run", "generate"]
    },
    {
      "runner": "vitest",
      "args": ["src", "--exclude", "**/*.integration.test.ts"]
    },
    {
      "runner": "vitest",
      "name": "integration",
      "tier": "extended",
      "args": ["--dir", "src", ".integration.test.ts"]
    }
  ],
  "excludedSuites": [
    {
      "path": "e2e",
      "reason": "Playwright suite; runs in the browser E2E lane (ci/scripts/selection/playwright-targets.ts), not in Vitest reporting."
    }
  ]
}
