{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun", "vite/client"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "e2e/**/*",
    "scripts/**/*",
    "playwright.config.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
