{
  "contractVersion": 9,
  "minimumContractVersion": 1,
  "header": "X-Scout-Desktop-Contract",
  "scopes": ["ingest", "explore"],
  "pairingScopes": ["ingest", "explore"],
  "routes": {
    "pairings_v2": {
      "method": "POST",
      "path": "/api/scout-client/v1/pairings/v2",
      "scope": null,
      "response": "json"
    },
    "device_scope_requests": {
      "method": "POST",
      "path": "/api/scout-client/v1/devices/current/scope-requests",
      "scope": null,
      "response": "json"
    },
    "explore_status": {
      "method": "POST",
      "path": "/api/scout-client/v1/explore/status",
      "scope": "explore",
      "response": "json"
    },
    "explore_conversations_list": {
      "method": "POST",
      "path": "/api/scout-client/v1/explore/conversations/list",
      "scope": "explore",
      "response": "json"
    },
    "explore_conversations_get": {
      "method": "POST",
      "path": "/api/scout-client/v1/explore/conversations/get",
      "scope": "explore",
      "response": "json"
    },
    "explore_runs_start": {
      "method": "POST",
      "path": "/api/scout-client/v1/explore/runs/start",
      "scope": "explore",
      "response": "json"
    },
    "explore_runs_start_app": {
      "method": "POST",
      "path": "/api/scout-client/v1/explore/runs/start-app",
      "scope": "explore",
      "response": "json"
    },
    "explore_runs_stop": {
      "method": "POST",
      "path": "/api/scout-client/v1/explore/runs/stop",
      "scope": "explore",
      "response": "json"
    },
    "explore_runs_active": {
      "method": "POST",
      "path": "/api/scout-client/v1/explore/runs/active",
      "scope": "explore",
      "response": "json"
    },
    "explore_runs_outcome": {
      "method": "POST",
      "path": "/api/scout-client/v1/explore/runs/outcome",
      "scope": "explore",
      "response": "json"
    },
    "explore_runs_stream": {
      "method": "POST",
      "path": "/api/scout-client/v1/explore/runs/stream",
      "scope": "explore",
      "response": "event-stream"
    },
    "explore_assets": {
      "method": "POST",
      "path": "/api/scout-client/v1/explore/assets",
      "scope": "explore",
      "response": "json"
    },
    "explore_visualization": {
      "method": "POST",
      "path": "/api/scout-client/v1/explore/visualization",
      "scope": "explore",
      "response": "png"
    },
    "explore_models": {
      "method": "POST",
      "path": "/api/scout-client/v1/explore/models",
      "scope": "explore",
      "response": "json"
    },
    "explore_conversations_set_leaf": {
      "method": "POST",
      "path": "/api/scout-client/v1/explore/conversations/set-leaf",
      "scope": "explore",
      "response": "json"
    },
    "explore_conversations_share": {
      "method": "POST",
      "path": "/api/scout-client/v1/explore/conversations/share",
      "scope": "explore",
      "response": "json"
    },
    "explore_conversations_revoke_share": {
      "method": "POST",
      "path": "/api/scout-client/v1/explore/conversations/revoke-share",
      "scope": "explore",
      "response": "json"
    },
    "explore_attachments_upload": {
      "method": "POST",
      "path": "/api/scout-client/v1/explore/attachments/upload",
      "scope": "explore",
      "response": "json"
    },
    "explore_attachments_discard": {
      "method": "POST",
      "path": "/api/scout-client/v1/explore/attachments/discard",
      "scope": "explore",
      "response": "json"
    },
    "coach_voice_turns": {
      "method": "POST",
      "path": "/api/scout-client/v1/coach/voice/turns",
      "scope": "explore",
      "response": "event-stream"
    },
    "coach_reviews_get": {
      "method": "POST",
      "path": "/api/scout-client/v1/coach/reviews/get",
      "scope": "explore",
      "response": "json"
    }
  },
  "streamEvents": [
    "snapshot",
    "run_preview",
    "started",
    "activity",
    "tool_call",
    "tool_result",
    "preview",
    "answer_delta",
    "final",
    "error",
    "done"
  ],
  "voiceTurn": {
    "triggers": ["wake_word", "push_to_talk"],
    "audio": {
      "mediaType": "audio/wav",
      "sampleRateHz": 16000,
      "channels": 1,
      "bitsPerSample": 16,
      "minDurationMs": 200,
      "maxDurationMs": 15000
    },
    "speech": {
      "encoding": "pcm_s16le",
      "sampleRateHz": 24000,
      "channels": 1,
      "maxChunkBytes": 48000
    },
    "events": ["transcript", "run", "answer", "audio", "error", "done"],
    "errors": [
      "wake_not_verified",
      "empty_question",
      "transcription_failed",
      "budget_exhausted",
      "quota_exceeded",
      "conversation_busy",
      "invalid_turn",
      "not_found",
      "unavailable",
      "answer_failed",
      "synthesis_failed"
    ]
  },
  "nativeVisualizationKinds": ["TABLE", "LIST", "LEADERBOARD", "KPI_CARD"],
  "errors": {
    "invalid_request": 400,
    "invalid_turn": 400,
    "invalid_game_context": 400,
    "unauthorized": 401,
    "reauthorize_required": 401,
    "scope_required": 403,
    "explore_forbidden": 403,
    "not_found": 404,
    "conversation_busy": 409,
    "scope_already_granted": 409,
    "contract_unsupported": 426,
    "rate_limited": 429,
    "quota_exceeded": 429,
    "stream_limit": 429,
    "unavailable": 503,
    "feature_disabled": 503
  }
}
