        {
          "id": "middle:Zoe:Ryze:0",
          "text": "Avoid being hit by Spell Flux, because it marks you and lets Ryze root you with Rune Prison. Stay behind minions so his orb is harder to land.",
          "refs": [
            { "kind": "ability", "key": "Ryze-E", "start": 19, "end": 29 },
            { "kind": "champion", "key": "Ryze", "start": 61, "end": 65 },
            { "kind": "keyword", "key": "rooted", "start": 66, "end": 70 },
            { "kind": "ability", "key": "Ryze-W", "start": 80, "end": 91 }
          ],
          "pWrong": 0.9
        },
        {
          "id": "middle:Zoe:Ryze:1",
          "text": "Cast Sleepy Trouble Bubble when Ryze is rooted or low on room to move. If it hits, you can follow up with Paddle Star.",
          "refs": [
            { "kind": "ability", "key": "Zoe-E", "start": 5, "end": 26 },
            { "kind": "champion", "key": "Ryze", "start": 32, "end": 36 }
          ],
          "pWrong": 0.26
        },
        {
          "id": "middle:Zoe:Ryze:2",
          "text": "Fire Paddle Star from far away, then redirect it at Ryze. The longer it flies, the more it hurts, and he cannot hide inside the minion wave.",
          "refs": [
            { "kind": "champion", "key": "Ryze", "start": 52, "end": 56 }
          ],
          "pWrong": 0.78
        },
        {
          "id": "middle:Zoe:Ryze:3",
          "text": "Watch Ryze's Realm Warp. Stun or sleep him while it charges to cancel the portal for his team.",
          "refs": [
            { "kind": "champion", "key": "Ryze", "start": 6, "end": 10 },
            { "kind": "ability", "key": "Ryze-R", "start": 13, "end": 23 },
            { "kind": "keyword", "key": "stunned", "start": 25, "end": 29 }
          ],
          "pWrong": 0.95,
          "hidden": true
        }
      ],
      "opponent": "Ryze",
      "comboRefs": []
    },
    {
