{
  "name": "@shepherdjerred/code-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./github": {
      "types": "./src/github.ts",
      "default": "./src/github.ts"
    },
    "./head-pushed-at": {
      "types": "./src/head-pushed-at.ts",
      "default": "./src/head-pushed-at.ts"
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "lint": "bunx eslint . --max-warnings=0",
    "test:ci": "bun ../../scripts/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../scripts/run-ci-test.ts"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shepherdjerred/eslint-config": "workspace:*",
    "@types/bun": "^1.3.14",
    "eslint": "^10.3.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "@typescript/native": "npm:typescript@7.0.2"
  }
}
