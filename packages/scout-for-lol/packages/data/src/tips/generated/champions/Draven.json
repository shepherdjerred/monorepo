      "tips": [
        {
          "id": "adc:Draven:general:0",
          "text": "Move after each attack with Spinning Axe so it lands in your path, then walk into it to catch it. Every catch readies another axe and adds Adoration.",
          "refs": [
            { "kind": "ability", "key": "Draven-Q", "start": 28, "end": 40 }
          ],
          "pWrong": 0.42
        },
        {
          "id": "adc:Draven:general:1",
          "text": "Catch an axe to refresh Blood Rush right away. Use it freely to chase, to run away, or to reach a far axe.",
          "refs": [
            { "kind": "ability", "key": "Draven-W", "start": 24, "end": 34 }
          ],
          "pWrong": 0.12
        },
        {
          "id": "adc:Draven:general:2",
          "text": "Keep two Spinning Axes ready before you trade. Your damage falls off sharply when you drop them.",
          "refs": [],
          "pWrong": 0.64
        },
        {
          "id": "adc:Draven:general:3",
          "text": "Use Stand Aside on an enemy who walks up to you. It knocks them away and leaves them slowed, which helps you escape or line up your attacks.",
          "refs": [
            { "kind": "ability", "key": "Draven-E", "start": 4, "end": 15 },
            { "kind": "keyword", "key": "slowed", "start": 85, "end": 91 }
          ],
          "pWrong": 0.06
        },
        {
          "id": "adc:Draven:general:4",
          "text": "Last-hit minions and catch axes to build Adoration. Dying costs you some of it, so play safe once you have a lot.",
          "refs": [],
          "pWrong": 0.3
        },
        {
          "id": "adc:Draven:general:5",
          "text": "Use Whirling Death to finish a low-health enemy who is running away. It executes champions it leaves low enough, and you can recast it.",
          "refs": [
            { "kind": "ability", "key": "Draven-R", "start": 4, "end": 18 }
          ],
          "pWrong": 0.16
        },
        {
          "id": "adc:Draven:general:6",
          "text": "Stay out of fights near the enemy's skillshots while your axes are in the air. Their landing spot is visible to both teams.",
          "refs": [],
          "pWrong": 0.19
        }
      ],
      "combos": [
        {
          "id": "adc:Draven:combo:0",
