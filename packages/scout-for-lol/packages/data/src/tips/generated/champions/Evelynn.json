  "general": [
    {
      "lane": "jungle",
      "inputHash": "933f2430076ca90aad74586089845ff109a7d9f31e165452cfd0dd95892930e3",
      "tips": [
        {
          "id": "jungle:Evelynn:general:0",
          "text": "Cast Allure on a target early and wait before you hit them. A mark that has matured charms them and cuts their Magic Resist.",
          "refs": [
            { "kind": "ability", "key": "Evelynn-W", "start": 5, "end": 11 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "jungle:Evelynn:general:1",
          "text": "Use Allure on big monsters too. A matured mark charms the monster and adds heavy damage, which speeds up your clears.",
          "refs": [
            { "kind": "ability", "key": "Evelynn-W", "start": 4, "end": 10 }
          ],
          "pWrong": 0.08
        },
        {
          "id": "jungle:Evelynn:general:2",
          "text": "Open with Hate Spike, then hit the same enemy with attacks and abilities. They deal extra damage to the marked target.",
          "refs": [
            { "kind": "ability", "key": "Evelynn-Q", "start": 10, "end": 20 }
          ],
          "pWrong": 0.09
        },
        {
          "id": "jungle:Evelynn:general:3",
          "text": "Recast Hate Spike when enemies are lined up. The spikes hit everything in the line and need a visible enemy nearby.",
          "refs": [
            { "kind": "ability", "key": "Evelynn-Q", "start": 7, "end": 17 }
          ],
          "pWrong": 0.11
        },
        {
          "id": "jungle:Evelynn:general:4",
          "text": "After you enter Demon Shade, Whiplash is refreshed and its next cast dashes to the target. Use it to close the gap and hit enemies along the path.",
          "refs": [
            {
              "kind": "ability",
              "key": "Evelynn-passive",
              "start": 16,
              "end": 27
            },
            { "kind": "ability", "key": "Evelynn-E", "start": 29, "end": 37 }
          ],
          "pWrong": 0.09
        },
        {
          "id": "jungle:Evelynn:general:5",
          "text": "Hold Last Caress for targets at low health, where it hurts far more. It makes you untargetable, so it also works as an escape.",
          "refs": [
            { "kind": "ability", "key": "Evelynn-R", "start": 5, "end": 16 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "jungle:Evelynn:general:6",
          "text": "Watch for the glowing eyes over enemy champions when you are stealthed. They show you are close to being detected.",
          "refs": [],
          "pWrong": 0.01
        },
        {
          "id": "jungle:Evelynn:general:7",
          "text": "When you are low on health, back off and let Demon Shade heal you. Then return and surprise the enemy.",
          "refs": [
            {
              "kind": "ability",
              "key": "Evelynn-passive",
              "start": 45,
              "end": 56
            }
          ],
          "pWrong": 0.01
        },
        {
          "id": "jungle:Evelynn:general:8",
          "text": "Casting Allure does not break Demon Shade. Mark a target from stealth, then wait for the mark to mature before you strike.",
          "refs": [
            { "kind": "ability", "key": "Evelynn-W", "start": 8, "end": 14 },
            {
              "kind": "ability",
              "key": "Evelynn-passive",
              "start": 30,
              "end": 41
            },
            { "kind": "summoner-spell", "key": "32", "start": 43, "end": 47 }
          ],
          "pWrong": 0.06
        }
      ],
      "combos": [
        {
          "id": "jungle:Evelynn:combo:0",
          "name": "Whiplash into buffered Last Caress",
          "category": "trick",
          "sequence": [
            { "kind": "ability", "key": "Evelynn-E" },
            { "kind": "ability", "key": "Evelynn-R" }
          ],
          "when": "When you dash onto a target with empowered Whiplash and want to finish them with no delay.",
          "whenRefs": [
            { "kind": "ability", "key": "Evelynn-E", "start": 43, "end": 51 }
          ],
          "text": "Last Caress can be buffered during the empowered dash. Queue it while dashing and it fires the moment you land.",
          "textRefs": [
            { "kind": "ability", "key": "Evelynn-R", "start": 0, "end": 11 }
          ]
        }
      ]
    }
  ],
  "matchups": [
