      "tips": [
        {
          "id": "middle:Taliyah:general:0",
          "text": "Cast Seismic Shove on an enemy standing in Unraveled Earth's stones. Being knocked through them sets them off and stuns the enemy.",
          "refs": [
            { "kind": "ability", "key": "Taliyah-W", "start": 5, "end": 18 },
            { "kind": "ability", "key": "Taliyah-E", "start": 43, "end": 58 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "middle:Taliyah:general:1",
          "text": "Throw Unraveled Earth first, then Seismic Shove. Enemies are slowed in the stones, so the shove is easier to land.",
          "refs": [
            { "kind": "ability", "key": "Taliyah-E", "start": 6, "end": 21 },
            { "kind": "ability", "key": "Taliyah-W", "start": 34, "end": 47 },
            { "kind": "keyword", "key": "slowed", "start": 61, "end": 67 }
          ],
          "pWrong": 0.09
        },
        {
          "id": "middle:Taliyah:general:2",
          "text": "Cast Threaded Volley once to make Worked Ground, then cast it again while standing on it. The second cast is a cheap, fast boulder that slows.",
          "refs": [
            { "kind": "ability", "key": "Taliyah-Q", "start": 5, "end": 20 },
            { "kind": "keyword", "key": "slowed", "start": 136, "end": 141 }
          ],
          "pWrong": 0.14
        },
        {
          "id": "middle:Taliyah:general:3",
          "text": "Aim Threaded Volley carefully. It fires in a straight line, so enemies can sidestep it.",
          "refs": [
            { "kind": "ability", "key": "Taliyah-Q", "start": 4, "end": 19 }
          ],
          "pWrong": 0.1
        },
        {
          "id": "middle:Taliyah:general:4",
          "text": "Aim Seismic Shove so the enemy is pushed toward your stones or away from their team. It lands after a short delay, so aim where they will be.",
          "refs": [
            { "kind": "ability", "key": "Taliyah-W", "start": 4, "end": 17 }
          ],
          "pWrong": 0.1
        },
        {
          "id": "middle:Taliyah:general:5",
          "text": "Stay near walls when you are not fighting. Rock Surfing makes you faster there, but it stops while you cast or fight.",
          "refs": [
            {
              "kind": "ability",
              "key": "Taliyah-passive",
              "start": 43,
              "end": 55
            }
          ],
          "pWrong": 0.16
        },
        {
          "id": "middle:Taliyah:general:6",
          "text": "Use Weaver's Wall to cut off a fleeing enemy or split a fight. You only need to ride it when you want to, and you can't cast it right after taking damage.",
          "refs": [
            { "kind": "ability", "key": "Taliyah-R", "start": 4, "end": 17 }
          ],
          "pWrong": 0.26
        }
      ],
      "combos": [
