{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["generate", "^build"],
      // Composition changes the emitted manager, so a composed build must not
      // reuse a plain build's cache entry.
      "env": ["SCOUT_STORYBOOK_COMPOSED"],
      "outputs": [
        "storybook-static/**",
        "src/generated/**",
        "styles/generated/**"
      ]
    },
    "generate": {
      "outputs": ["src/generated/**", "styles/generated/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": true,
      "env": [
        "CI",
        "CI_PLAYWRIGHT_IMAGE",
        "CI_REPORTING_BUILD_ID",
        "PLAYWRIGHT_BRANDED_BROWSERS"
      ],
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"]
    }
  }
}
