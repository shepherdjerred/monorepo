      "tips": [
        {
          "id": "middle:Katarina:general:0",
          "text": "Pick up Daggers after Bouncing Blade lands; each pickup slashes nearby enemies and cuts Shunpo's cooldown a lot.",
          "refs": [
            { "kind": "ability", "key": "Katarina-Q", "start": 22, "end": 36 },
            { "kind": "ability", "key": "Katarina-E", "start": 88, "end": 94 }
          ],
          "pWrong": 0.14
        },
        {
          "id": "middle:Katarina:general:1",
          "text": "Use Preparation to drop a Dagger where you want to Shunpo next. Grab it fast, because Daggers vanish after a few seconds.",
          "refs": [
            { "kind": "ability", "key": "Katarina-W", "start": 4, "end": 15 },
            { "kind": "item", "key": "1042", "start": 26, "end": 32 },
            { "kind": "ability", "key": "Katarina-E", "start": 51, "end": 57 }
          ],
          "pWrong": 0.18
        },
        {
          "id": "middle:Katarina:general:2",
          "text": "Throw Bouncing Blade at an enemy standing near other enemies or minions; it hits up to two more targets.",
          "refs": [
            { "kind": "ability", "key": "Katarina-Q", "start": 6, "end": 20 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "middle:Katarina:general:3",
          "text": "Shunpo onto a minion, ally or Dagger to escape when a fight turns bad.",
          "refs": [
            { "kind": "ability", "key": "Katarina-E", "start": 0, "end": 6 },
            { "kind": "item", "key": "1042", "start": 30, "end": 36 }
          ],
          "pWrong": 0.07
        },
        {
          "id": "middle:Katarina:general:4",
          "text": "Wait until the enemy team is busy fighting your team, then Shunpo in and use Death Lotus.",
          "refs": [
            { "kind": "ability", "key": "Katarina-E", "start": 59, "end": 65 },
            { "kind": "ability", "key": "Katarina-R", "start": 77, "end": 88 }
          ],
          "pWrong": 0.08
        },
        {
          "id": "middle:Katarina:general:5",
          "text": "Stay still inside Death Lotus and avoid cancelling it; moving or attacking mid-channel interrupts it. A stun or knock up on you ends it too.",
          "refs": [
            { "kind": "ability", "key": "Katarina-R", "start": 18, "end": 29 },
            { "kind": "keyword", "key": "knocked-up", "start": 112, "end": 120 }
          ],
          "pWrong": 0.36
        },
        {
          "id": "middle:Katarina:general:6",
          "text": "Try to damage a champion before a teammate or you finish them. Voracity then slashes your cooldowns, so you can chain abilities.",
          "refs": [
            {
              "kind": "ability",
              "key": "Katarina-passive",
              "start": 63,
              "end": 71
            }
          ],
          "pWrong": 0.42
        }
      ],
      "combos": [
        {
          "id": "middle:Katarina:combo:0",
          "name": "Shunpo over the wall",
          "category": "trick",
          "sequence": [{ "kind": "ability", "key": "Katarina-E" }],
          "when": "When escaping or chasing near a thin wall.",
          "whenRefs": [],
          "text": "Shunpo to a target, ally, or Dagger close to a wall and aim behind it. Katarina can blink over thin walls this way.",
          "textRefs": [
            { "kind": "ability", "key": "Katarina-E", "start": 0, "end": 6 },
            { "kind": "item", "key": "1042", "start": 29, "end": 35 },
            { "kind": "champion", "key": "Katarina", "start": 71, "end": 79 }
          ]
        }
      ]
    }
  ],
  "matchups": [
    {
