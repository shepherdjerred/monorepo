--- a/Source/Core/AudioCommon/NullSoundStream.cpp
+++ b/Source/Core/AudioCommon/NullSoundStream.cpp
@@ -2,17 +2,37 @@
 // SPDX-License-Identifier: GPL-2.0-or-later
 
 #include "AudioCommon/NullSoundStream.h"
+#include "Common/ArcadeBridge.h"
+#include "AudioCommon/Mixer.h"
+#include <array>
+#include <chrono>
 
 bool NullSound::Init()
 {
   // Make Mixer aware that audio output is disabled.
-  GetMixer()->SetSampleRate(0);
+  GetMixer()->SetSampleRate(ArcadeBridge::Enabled() ? 48000 : 0);
 
   return true;
 }
 
 bool NullSound::SetRunning(bool running)
 {
+  if (!ArcadeBridge::Enabled()) return true;
+  if (!running) {
+    m_arcade_audio.request_stop();
+    if (m_arcade_audio.joinable()) m_arcade_audio.join();
+  } else if (!m_arcade_audio.joinable()) {
+    m_arcade_audio = std::jthread([this](std::stop_token stop) {
+      std::array<s16, 960> samples{};
+      auto deadline = std::chrono::steady_clock::now();
+      while (!stop.stop_requested()) {
+        deadline += std::chrono::milliseconds(10);
+        GetMixer()->Mix(samples.data(), 480);
+        ArcadeBridge::Audio(samples.data(), 480);
+        std::this_thread::sleep_until(deadline);
+      }
+    });
+  }
   return true;
 }
 
