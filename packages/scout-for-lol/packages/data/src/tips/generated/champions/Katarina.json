        {
          "id": "middle:Katarina:Viktor:5",
          "text": "Kill Viktor and the cooldown reset from Voracity lets you chain your abilities into a second target.",
          "refs": [
            { "kind": "champion", "key": "Viktor", "start": 5, "end": 11 },
