{
  "name": "@scout-for-lol/design-audit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run typecheck",
    "check:tokens": "bun run src/static-token-check.ts",
    "test": "bun test src",
    "test:e2e": "playwright test",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "lint": "bun x --no-install eslint src tests",
    "format": "bun x --no-install prettier --check ."
  },
  "dependencies": {
    "@scout-for-lol/design-system": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "1.62.0",
    "@types/bun": "^1.3.13",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  },
  "license": "GPL-3.0-only",
  "imports": {
    "#src/*": "./src/*"
  }
}
