{
  "name": "@shepherdjerred/seaweedfs-backup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./gc": "./src/gc.ts",
    "./manifest": "./src/manifest.ts",
    "./policy": "./src/policy.ts",
    "./restore": "./src/restore.ts",
    "./retention": "./src/retention.ts",
    "./schemas": "./src/schemas.ts",
    "./snapshot": "./src/snapshot.ts",
    "./store": "./src/store.ts",
    "./verify": "./src/verify.ts"
  },
  "imports": {
    "#policy": "./policy.json",
    "#policy-schema": "./policy.schema.json"
  },
  "scripts": {
    "build": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "lint": "bunx --no-install eslint --cache .",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run",
    "test:ci": "bun ../../scripts/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../scripts/run-ci-test.ts",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1001.0",
    "@aws-sdk/lib-storage": "^3.1001.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shepherdjerred/eslint-config": "workspace:*",
    "@tsconfig/node-lts": "^24.0.1",
    "@tsconfig/recommended": "^1.0.13",
    "@tsconfig/strictest": "^2.0.8",
    "@types/bun": "^1.4.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "ajv": "^8.20.0",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "s3rver": "2.2.9",
    "typescript": "^6.0.3",
    "vitest": "4.1.10"
  }
}
