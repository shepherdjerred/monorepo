            { "kind": "ability", "key": "Caitlyn-Q", "start": 46, "end": 65 }
          ],
          "pWrong": 0.04
        },
        {
          "id": "adc:Aphelios:Caitlyn:2",
          "text": "Watch where you walk near her. A Yordle Snap Trap roots you and sets up a big Headshot, so avoid stepping on bushes or choke points she may have trapped.",
          "refs": [
            { "kind": "ability", "key": "Caitlyn-W", "start": 33, "end": 49 },
            { "kind": "keyword", "key": "rooted", "start": 50, "end": 55 },
            {
              "kind": "ability",
              "key": "Caitlyn-passive",
              "start": 78,
              "end": 86
            }
          ],
          "pWrong": 0.49
        },
        {
          "id": "adc:Aphelios:Caitlyn:3",
          "text": "Move out of her line when her net hits you, since her Headshot then reaches you from long range.",
          "refs": [
            {
              "kind": "ability",
              "key": "Caitlyn-passive",
              "start": 54,
              "end": 62
            }
          ],
          "pWrong": 0.41
        },
        {
          "id": "adc:Aphelios:Caitlyn:4",
          "text": "Stand in the path of Ace in the Hole to block it when she aims at an ally.",
          "refs": [
            { "kind": "ability", "key": "Caitlyn-R", "start": 21, "end": 36 }
          ],
          "pWrong": 0.05
        }
      ],
      "opponent": "Caitlyn",
      "comboRefs": []
    },
