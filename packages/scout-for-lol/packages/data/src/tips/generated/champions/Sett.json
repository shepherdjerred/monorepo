    {
      "lane": "top",
      "inputHash": "9453c81dd590bd849e09847269e5ba1e040665d7650bf8c0646f9aa3fd1886de",
      "tips": [
        {
          "id": "top:Sett:Malphite:0",
          "text": "Dodge Malphite's Seismic Shard if you can. It slows you and gives him speed, so he can chase you or leave at will.",
          "refs": [
            { "kind": "champion", "key": "Malphite", "start": 6, "end": 14 },
            { "kind": "ability", "key": "Malphite-Q", "start": 17, "end": 30 },
            { "kind": "keyword", "key": "slowed", "start": 46, "end": 51 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "top:Sett:Malphite:1",
          "text": "Hold Haymaker until you have taken some damage, then use it. The shield and the big hit are worth more with plenty of Grit stored.",
          "refs": [
            { "kind": "ability", "key": "Sett-W", "start": 5, "end": 13 }
          ],
          "pWrong": 0.47
        },
        {
          "id": "top:Sett:Malphite:2",
          "text": "Malphite's Granite Shield makes him tanky, and your Knuckle Down deals extra damage based on max Health. Break the shield first, then fight.",
          "refs": [
            { "kind": "champion", "key": "Malphite", "start": 0, "end": 8 },
            {
              "kind": "ability",
              "key": "Malphite-passive",
              "start": 11,
              "end": 25
            },
            { "kind": "ability", "key": "Sett-Q", "start": 52, "end": 64 }
          ],
          "pWrong": 0.46
        },
        {
          "id": "top:Sett:Malphite:3",
          "text": "Ground Slam cuts your Attack Speed. Step out of its range, or use Facebreaker to pull him in and stun him if he has an enemy on each side.",
          "refs": [
            { "kind": "ability", "key": "Malphite-E", "start": 0, "end": 11 },
            { "kind": "ability", "key": "Sett-E", "start": 66, "end": 77 },
            { "kind": "keyword", "key": "stunned", "start": 97, "end": 101 }
          ],
          "pWrong": 0.48
        },
        {
          "id": "top:Sett:Malphite:4",
          "text": "Stay away from Malphite at level 6. Unstoppable Force can't be stopped once he starts, so stay out of its range.",
          "refs": [
            { "kind": "champion", "key": "Malphite", "start": 15, "end": 23 },
            { "kind": "ability", "key": "Malphite-R", "start": 36, "end": 53 }
          ],
          "pWrong": 0.39
        }
      ],
      "opponent": "Malphite",
      "comboRefs": []
    },
    {
