{
  "name": "@shepherdjerred/streambot",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run test/",
    "test:integration": "bun --no-install --bun vitest --config ../../vitest.config.ts run --testTimeout 120000 integration/",
    "e2e": "bun run e2e/run.ts",
    "e2e:voice-assistant": "bun run e2e/voice-assistant.ts",
    "e2e:voice-recovery": "bun run e2e/voice-recovery.ts",
    "voice:corpus:generate": "bun run scripts/voice-corpus-generate.ts",
    "voice:corpus:verify": "bun run scripts/voice-corpus-verify.ts",
    "voice:corpus:evaluate": "bun run scripts/voice-corpus-evaluate.ts",
    "voice:human:evaluate": "bun run scripts/voice-human-holdout-evaluate.ts",
    "voice:harness:prepare": "bun run scripts/voice-harness-prepare.ts",
    "voice:harness": "bun run scripts/voice-harness.ts",
    "voice:harness:evaluate": "bun run scripts/voice-harness-evaluate.ts",
    "voice:verifier:package": "bun run scripts/voice-verifier-package.ts",
    "e2e:local": "bun run e2e/local.ts",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "lint": "eslint . && check-architecture",
    "docker:build": "docker buildx build --cache-from type=registry,ref=ghcr.io/shepherdjerred/streambot:buildcache ${DOCKER_BUILD_EXTRA_ARGS:-} --load -t streambot:dev -f Dockerfile ../..",
    "smoke": "bun scripts/smoke.ts",
    "test:ci": "bun ../../scripts/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../scripts/run-ci-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1001.0",
    "@openai/agents": "0.17.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/core": "^2.7.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.7.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.7.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@sentry/bun": "^10.70.0",
    "@shepherdjerred/config": "workspace:*",
    "@shepherdjerred/discord-stream-lifecycle": "workspace:*",
    "@shepherdjerred/discord-video-stream": "workspace:*",
    "@shepherdjerred/feature-flags": "workspace:*",
    "discord.js": "^14.26.4",
    "discord.js-selfbot-v13": "^3.7.1",
    "onnxruntime-node": "1.27.0",
    "prom-client": "^15.1.3",
    "sherpa-onnx": "1.13.1",
    "sherpa-onnx-node": "1.13.1",
    "xstate": "^5.32.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shepherdjerred/architecture": "workspace:*",
    "@shepherdjerred/eslint-config": "workspace:*",
    "@types/bun": "1.4.0",
    "@typescript-eslint/utils": "^8.67.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.3.0",
    "jiti": "^2.7.0",
    "openai": "7.5.0",
    "typescript": "^6.0.3",
    "vitest": "4.1.10",
    "@vitest/coverage-istanbul": "4.1.10"
  }
}
