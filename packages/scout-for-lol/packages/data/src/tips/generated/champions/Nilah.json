      "tips": [
        {
          "id": "adc:Nilah:general:0",
          "text": "Last-hit minions with your attacks to level faster; Joy Unending gives you and your nearest ally extra experience.",
          "refs": [
            {
              "kind": "ability",
              "key": "Nilah-passive",
              "start": 52,
              "end": 64
            }
          ],
          "pWrong": 0.12
        },
        {
          "id": "adc:Nilah:general:1",
          "text": "Stay close to your support when they heal or shield; Joy Unending gives you both a bit extra.",
          "refs": [
            {
              "kind": "ability",
              "key": "Nilah-passive",
              "start": 53,
              "end": 65
            }
          ],
          "pWrong": 0.11
        },
        {
          "id": "adc:Nilah:general:2",
          "text": "Hit an enemy champion with Formless Blade before you trade; it gives you range and attack speed, and your attacks hit in a cone.",
          "refs": [
            { "kind": "ability", "key": "Nilah-Q", "start": 27, "end": 41 }
          ],
          "pWrong": 0.18
        },
        {
          "id": "adc:Nilah:general:3",
          "text": "Use Formless Blade on minions standing near the enemy to start your bonus range and clear the wave with cone attacks.",
          "refs": [
            { "kind": "ability", "key": "Nilah-Q", "start": 4, "end": 18 }
          ],
          "pWrong": 0.16
        },
        {
          "id": "adc:Nilah:general:4",
          "text": "Attack champions to heal with Formless Blade; extra healing turns into a shield, so trade when you can keep hitting.",
          "refs": [
            { "kind": "ability", "key": "Nilah-Q", "start": 30, "end": 44 }
          ],
          "pWrong": 0.48
        },
        {
          "id": "adc:Nilah:general:5",
          "text": "Use Slipstream to dodge a skillshot or close in, and to reset your attack timer. It dashes through a unit, so you need a target to aim at.",
          "refs": [
            { "kind": "ability", "key": "Nilah-E", "start": 4, "end": 14 }
          ],
          "pWrong": 0.26
        },
        {
          "id": "adc:Nilah:general:6",
          "text": "Cast Jubilant Veil when an enemy marksman starts attacking you; it dodges their attacks and reduces magic damage.",
          "refs": [
            { "kind": "ability", "key": "Nilah-W", "start": 5, "end": 18 }
          ],
          "pWrong": 0.16
        },
        {
          "id": "adc:Nilah:general:7",
          "text": "Run into your ally to share Jubilant Veil with them. It only works on each ally once in a while, so save it for a real fight.",
          "refs": [
            { "kind": "ability", "key": "Nilah-W", "start": 28, "end": 41 }
          ],
          "pWrong": 0.19
        },
        {
          "id": "adc:Nilah:general:8",
          "text": "At level 6, use Apotheosis when several enemies are close. It pulls them in, leaves them slowed, and heals you and nearby allies.",
          "refs": [
            { "kind": "ability", "key": "Nilah-R", "start": 16, "end": 26 },
            { "kind": "keyword", "key": "slowed", "start": 89, "end": 95 }
          ],
          "pWrong": 0.46
        },
        {
          "id": "adc:Nilah:general:9",
          "text": "Move while Apotheosis spins, but you can't attack or cast other abilities, so line up your dashes first.",
          "refs": [
            { "kind": "ability", "key": "Nilah-R", "start": 11, "end": 21 }
          ],
          "pWrong": 0.2
        }
      ],
      "combos": [
        {
          "id": "adc:Nilah:combo:0",
          "name": "Slipstream-Q wave",
          "category": "trick",
          "sequence": [
            { "kind": "ability", "key": "Nilah-E" },
            { "kind": "ability", "key": "Nilah-Q" }
          ],
          "when": "When you dash through a minion or enemy and want extra poke or a safe trade.",
          "whenRefs": [],
          "text": "Cast Q while dashing. It leaves a wave behind that hits enemies on the way back to your landing spot, and the hit still powers up your attacks.",
          "textRefs": []
        }
      ]
    }
  ],
