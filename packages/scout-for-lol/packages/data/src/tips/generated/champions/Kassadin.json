            {
              "kind": "ability",
              "key": "Kassadin-passive",
              "start": 39,
              "end": 49
            }
          ],
          "pWrong": 0.6
        },
        {
          "id": "middle:Kassadin:Ahri:3",
          "text": "Hit Ahri with Force Pulse when she steps up to poke, so she is slowed and can't easily get away.",
          "refs": [
