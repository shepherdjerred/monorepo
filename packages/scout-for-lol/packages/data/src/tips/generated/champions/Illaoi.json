      "inputHash": "76d9693c441aee4824b10c3618b9bc58f1f9aad09ad7bf2d9aadff62294e41f6",
      "tips": [
        {
          "id": "top:Illaoi:general:0",
          "text": "Walk up and use Harsh Lesson on the enemy champion when Tentacles are near. It makes them slam the target, and they heal you when they hit a champion.",
          "refs": [
            { "kind": "ability", "key": "Illaoi-W", "start": 16, "end": 28 }
          ],
          "pWrong": 0.09
        },
        {
          "id": "top:Illaoi:general:1",
          "text": "Fight near Tentacles, not away from them. Without them Illaoi loses much of her power.",
          "refs": [
            { "kind": "champion", "key": "Illaoi", "start": 55, "end": 61 }
          ],
          "pWrong": 0.05
        },
        {
          "id": "top:Illaoi:general:2",
          "text": "Use Test of Spirit on an enemy champion when you want a fight. Once their spirit dies or they run too far, they are slowed and marked.",
          "refs": [
            { "kind": "ability", "key": "Illaoi-E", "start": 4, "end": 18 },
            { "kind": "keyword", "key": "slowed", "start": 116, "end": 122 }
          ],
          "pWrong": 0.04
        },
        {
          "id": "top:Illaoi:general:3",
          "text": "Whittle the enemy down before using Test of Spirit. The spirit copies their current health, so it dies faster.",
          "refs": [
            { "kind": "ability", "key": "Illaoi-E", "start": 36, "end": 50 }
          ],
          "pWrong": 0.05
        },
        {
          "id": "top:Illaoi:general:4",
          "text": "Aim Tentacle Smash at where the enemy will be, because it takes a moment to swing. It also grows stronger as you rank it up.",
          "refs": [
            { "kind": "ability", "key": "Illaoi-Q", "start": 4, "end": 18 }
          ],
          "pWrong": 0.06
        },
        {
          "id": "top:Illaoi:general:5",
          "text": "Use Leap of Faith to follow up an engage or when the enemy jumps on you. Avoid being the first one into a fight.",
          "refs": [
            { "kind": "ability", "key": "Illaoi-R", "start": 4, "end": 17 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "top:Illaoi:general:6",
          "text": "Once you use Leap of Faith, trade freely. Harsh Lesson has a short cooldown and your Tentacles can't be targeted and slam faster.",
          "refs": [
            { "kind": "ability", "key": "Illaoi-R", "start": 13, "end": 26 },
            { "kind": "ability", "key": "Illaoi-W", "start": 42, "end": 54 }
          ],
          "pWrong": 0.52
        }
      ],
      "combos": [
        {
          "id": "top:Illaoi:combo:0",
          "name": "Free Harsh Lesson mid-cast",
          "category": "trick",
          "sequence": [
            { "kind": "ability", "key": "Illaoi-Q" },
            { "kind": "ability", "key": "Illaoi-W" }
          ],
          "when": "When you are low on mana or want to hide the order of your abilities in a trade.",
          "whenRefs": [],
          "text": "Harsh Lesson can be used during another ability's cast time. Mana is spent at the end of the cast, so you can sometimes get both for the price of one.",
          "textRefs": [
            { "kind": "ability", "key": "Illaoi-W", "start": 0, "end": 12 }
          ]
        }
      ]
    }
  ],
