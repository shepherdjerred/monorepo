<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TaskNotes.Windows.App.Views.BoardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:host="using:TaskNotes.Windows.Host"
    xmlns:presentation="using:TaskNotes.Windows.Presentation">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Board" />
            <Button Click="Refresh_Click" Content="Refresh" />
        </StackPanel>
        <ScrollViewer
            Grid.Row="1"
            Margin="0,18,0,0"
            AutomationProperties.AutomationId="TaskNotes.Board"
            AutomationProperties.Name="Kanban board"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled">
            <ItemsControl ItemsSource="{x:Bind ViewModel.BoardColumns, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="presentation:BoardColumn">
                        <StackPanel Width="280" Spacing="8">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind Label}" />
                            <ListView
                                AllowDrop="True"
                                AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                AutomationProperties.Name="{x:Bind Label}"
                                CanDragItems="True"
                                DragItemsStarting="Board_DragItemsStarting"
                                Drop="Board_Drop"
                                ItemsSource="{x:Bind Tasks}"
                                SelectionMode="Single"
                                Tag="{x:Bind Value}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="host:TaskItem">
                                        <Grid
                                            Padding="8"
                                            AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                            AutomationProperties.Name="{x:Bind Title}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
                                            <Button
                                                Grid.Column="1"
                                                AutomationProperties.Name="Move task to next configured status"
                                                Click="AdvanceBoardTask_Click"
                                                Content="Move next"
                                                Tag="{x:Bind Id}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
