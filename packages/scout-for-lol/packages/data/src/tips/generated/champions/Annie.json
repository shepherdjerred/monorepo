  "general": [
    {
      "lane": "middle",
      "inputHash": "c36e7136a8cd7b88300335eab2a725e6cacbd266a8a47e8431bfec2c75e4f92f",
      "tips": [
        {
          "id": "middle:Annie:general:0",
          "text": "Last-hit minions with Disintegrate; a kill refunds its mana and cuts its cooldown, so you can farm freely early.",
          "refs": [
            { "kind": "ability", "key": "Annie-Q", "start": 22, "end": 34 }
          ],
          "pWrong": 0.05
        },
        {
          "id": "middle:Annie:general:1",
          "text": "Watch your Pyromania counter. When it is full, open a trade with Disintegrate or Incinerate so the enemy is stunned.",
          "refs": [
            {
              "kind": "ability",
              "key": "Annie-passive",
              "start": 11,
              "end": 20
            },
            { "kind": "ability", "key": "Annie-Q", "start": 65, "end": 77 },
            { "kind": "ability", "key": "Annie-W", "start": 81, "end": 91 }
          ],
          "pWrong": 0.17
        },
        {
          "id": "middle:Annie:general:2",
          "text": "Cast Molten Shield on yourself to build toward your stun. It also gives a burst of speed and hurts enemies who hit you.",
          "refs": [
            { "kind": "ability", "key": "Annie-E", "start": 5, "end": 18 }
          ],
          "pWrong": 0.04
        },
        {
          "id": "middle:Annie:general:3",
          "text": "Aim Incinerate so it catches several minions and the enemy together. It is a cone, so stand where the enemy is in line.",
          "refs": [
            { "kind": "ability", "key": "Annie-W", "start": 4, "end": 14 }
          ],
          "pWrong": 0.12
        },
        {
          "id": "middle:Annie:general:4",
          "text": "You start the game and respawn with your stun ready. Use it for an early trade or save it to set up Summon: Tibbers.",
          "refs": [
            { "kind": "ability", "key": "Annie-R", "start": 100, "end": 115 }
          ],
          "pWrong": 0.08
        },
        {
          "id": "middle:Annie:general:5",
          "text": "At level 6, store your stun and land Summon: Tibbers on a group. Enemies hit are stunned, and Tibbers becomes enraged.",
          "refs": [
            { "kind": "ability", "key": "Annie-R", "start": 37, "end": 52 }
          ],
          "pWrong": 0.36
        },
        {
          "id": "middle:Annie:general:6",
          "text": "After Summon: Tibbers lands, recast it to steer the bear toward targets. Enemies standing near him keep taking burn damage.",
          "refs": [
            { "kind": "ability", "key": "Annie-R", "start": 6, "end": 21 }
          ],
          "pWrong": 0.11
        }
      ],
      "combos": []
    }
  ],
