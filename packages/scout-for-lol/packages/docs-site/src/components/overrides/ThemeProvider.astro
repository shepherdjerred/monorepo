<script is:inline src="/assets/scout/brand/theme-bootstrap.js"></script>
<script is:inline>
  const focusScrollableRegions = () => {
    document.querySelectorAll("table, pre").forEach((element) => {
      if (
        element.scrollWidth > element.clientWidth &&
        !element.hasAttribute("tabindex")
      ) {
        element.setAttribute("tabindex", "0");
      }
    });
  };

  focusScrollableRegions();
  document.addEventListener("DOMContentLoaded", focusScrollableRegions, {
    once: true,
  });
  window.addEventListener("load", focusScrollableRegions, { once: true });
  window.setTimeout(focusScrollableRegions, 0);
  document.addEventListener("astro:page-load", focusScrollableRegions);
</script>
