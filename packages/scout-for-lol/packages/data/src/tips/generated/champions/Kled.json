  "general": [
    {
      "lane": "top",
      "inputHash": "9097800905cbc9156fa57ca54f1e927a84ca6d5193ef0e8e1d25cdd9fdb2cd30",
      "tips": [
        {
          "id": "top:Kled:general:0",
          "text": "Hit Bear Trap on a Rope on a champion, then stay close for the pull. The yank deals big damage and leaves them slowed.",
          "refs": [
            { "kind": "ability", "key": "Kled-Q", "start": 4, "end": 23 },
            { "kind": "keyword", "key": "slowed", "start": 111, "end": 117 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "top:Kled:general:1",
          "text": "Start trades by landing a Bear Trap on a Rope, then use Violent Tendencies. Its fourth hit deals bonus damage, so make sure you land it.",
          "refs": [
            { "kind": "ability", "key": "Kled-Q", "start": 26, "end": 45 },
            { "kind": "ability", "key": "Kled-W", "start": 56, "end": 74 }
          ],
          "pWrong": 0.04
        },
        {
          "id": "top:Kled:general:2",
          "text": "Hit an enemy champion with Jousting, then recast it to dash back through them. You also get a burst of Move Speed for chasing or escaping.",
          "refs": [
            { "kind": "ability", "key": "Kled-E", "start": 27, "end": 35 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "top:Kled:general:3",
          "text": "Use Jousting to pull minions toward you. It pulls them into the path of your trade.",
          "refs": [
            { "kind": "ability", "key": "Kled-E", "start": 4, "end": 12 }
          ],
          "pWrong": 0.21
        },
        {
          "id": "top:Kled:general:4",
          "text": "Skaarl soaks damage while you are mounted. Once Skaarl flees, you are dismounted and can't use Jousting or Chaaaaaaaarge!!!, so don't take bad trades early.",
          "refs": [
            { "kind": "ability", "key": "Kled-E", "start": 95, "end": 103 },
            { "kind": "ability", "key": "Kled-R", "start": 107, "end": 123 }
          ],
          "pWrong": 0.36
        },
        {
          "id": "top:Kled:general:5",
          "text": "When dismounted, fight enemy champions to refill courage. At full courage you remount.",
          "refs": [],
          "pWrong": 0.01
        },
        {
          "id": "top:Kled:general:6",
          "text": "Cast Chaaaaaaaarge!!!, aiming where the enemy team will be when you arrive; it shields you and knocks back the first champion it hits.",
          "refs": [
            { "kind": "ability", "key": "Kled-R", "start": 5, "end": 21 }
          ],
          "pWrong": 0.06
        },
        {
          "id": "top:Kled:general:7",
          "text": "Join fights across the map with Chaaaaaaaarge!!!, since allies who follow its trail gain Move Speed.",
          "refs": [
            { "kind": "ability", "key": "Kled-R", "start": 32, "end": 48 }
          ],
          "pWrong": 0.01
        }
      ],
      "combos": [
        {
          "id": "top:Kled:combo:0",
          "name": "Dash-cast trap",
          "category": "trick",
          "sequence": [
            { "kind": "ability", "key": "Kled-E" },
            { "kind": "ability", "key": "Kled-Q" }
          ],
          "when": "Engaging or chasing an enemy champion within dash range.",
          "whenRefs": [],
          "text": "Jousting lets you cast the trap mid-dash. It leaves from where the dash ends, so you stay close and the tether doesn't snap.",
          "textRefs": [
            { "kind": "ability", "key": "Kled-E", "start": 0, "end": 8 }
          ]
        },
        {
          "id": "top:Kled:combo:1",
          "name": "Dismount pistol buffer",
          "category": "trick",
          "sequence": [{ "kind": "ability", "key": "Kled-Q" }],
          "when": "Skaarl is about to break while you are pressing the trap button.",
          "whenRefs": [],
          "text": "If you dismount as you cast, give a movement command straight after. Otherwise the cast buffers into Pocket Pistol and fires at the wrong time.",
          "textRefs": []
        }
      ]
    }
  ],
  "matchups": [
    {
      "lane": "top",
      "inputHash": "80d0b3f871ebc2a1fff3bf19e620ec3f20631d5fcfe56139f0fe7c2a8699c499",
      "tips": [
        {
          "id": "top:Kled:Aatrox:0",
          "text": "Throw Bear Trap on a Rope at Aatrox when he walks up, then stay close so the trap yanks him in and slows him.",
          "refs": [
            { "kind": "ability", "key": "Kled-Q", "start": 6, "end": 25 },
            { "kind": "champion", "key": "Aatrox", "start": 29, "end": 35 }
          ],
          "pWrong": 0.04
        },
        {
          "id": "top:Kled:Aatrox:1",
          "text": "Aatrox's Darkin Blade is slow and easy to see coming. Sidestep it, then jump in with Jousting while he is recovering.",
          "refs": [
            { "kind": "champion", "key": "Aatrox", "start": 0, "end": 6 },
            { "kind": "ability", "key": "Kled-E", "start": 85, "end": 93 }
          ],
          "pWrong": 0.06
        },
        {
          "id": "top:Kled:Aatrox:2",
          "text": "Break the Infernal Chains by walking toward Aatrox or to the side, or you get pulled back and hit again.",
          "refs": [
            { "kind": "ability", "key": "Aatrox-W", "start": 10, "end": 25 },
            { "kind": "champion", "key": "Aatrox", "start": 44, "end": 50 }
          ],
          "pWrong": 0.06
        },
        {
          "id": "top:Kled:Aatrox:3",
          "text": "Start trades with Violent Tendencies ready. Its fourth hit hits hard, so make sure you land it.",
          "refs": [
            { "kind": "ability", "key": "Kled-W", "start": 18, "end": 36 }
          ],
          "pWrong": 0.05
        },
        {
          "id": "top:Kled:Aatrox:4",
          "text": "While Skaarl is alive, Aatrox's damage hits her, not you. Fight him then and trade freely.",
          "refs": [
            { "kind": "champion", "key": "Aatrox", "start": 23, "end": 29 }
          ],
          "pWrong": 0.75
        }
      ],
      "opponent": "Aatrox",
      "comboRefs": []
    },
    {
