# Add common paths (OS-specific to avoid testing nonexistent dirs)
# libpq is keg-only because it conflicts with a full postgresql install, so brew
# never links psql/pg_dump/pg_isready/pg_config into /opt/homebrew/bin. pgcli
# pulls libpq in as a dependency, but that does not link the binaries.
{{ if eq .chezmoi.os "darwin" -}}
fish_add_path /opt/homebrew/bin ~/bin ~/.local/bin /opt/homebrew/opt/libpq/bin
{{ else -}}
fish_add_path /home/linuxbrew/.linuxbrew/bin ~/bin ~/.local/bin
{{ end -}}

# Ghostty shell integration
if set -q GHOSTTY_RESOURCES_DIR
    source "$GHOSTTY_RESOURCES_DIR"/shell-integration/fish/vendor_conf.d/ghostty-shell-integration.fish
end

# Disable vendor conf.d auto-activation (expensive full hook mode ~23ms)
# and use only --shims mode (~2ms, just adds PATH entry)
set -gx MISE_FISH_AUTO_ACTIVATE 0
mise activate fish --shims | source

# Use abbreviations so scripts use real commands, but your typing expands
abbr vim nvim
abbr ls eza
abbr grep rg
abbr cat bat
abbr htop "sudo btop"
abbr top "sudo btop"
abbr btop "sudo btop"
abbr less ov
abbr ping gping
abbr oc opencode
abbr finder "open -a Finder"
abbr gs git-spice

# Set shell to fish
{{ if eq .chezmoi.os "darwin" -}}
set -gx SHELL /opt/homebrew/bin/fish
{{ else -}}
set -gx SHELL /home/linuxbrew/.linuxbrew/bin/fish
{{ end -}}
set -gx EDITOR nvim
set -gx LANG en_US.UTF-8
set -gx RIPGREP_CONFIG_PATH ~/.config/ripgrep/ripgreprc

# PinchTab: point the CLI at the same config the launchd daemon uses. The
# daemon's plist pins PINCHTAB_CONFIG to this path; without it the CLI falls
# back to ~/.pinchtab/config.json and the tokens diverge → 401 bad_token.
{{ if eq .chezmoi.os "darwin" -}}
set -gx PINCHTAB_CONFIG "$HOME/Library/Application Support/pinchtab/config.json"
set -gx TESSDATA_PREFIX /opt/homebrew/share/tessdata
{{ end -}}

set -gx CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS "1"

