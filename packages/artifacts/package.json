{
  "name": "@shepherdjerred/artifacts",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "exports": {
    "./contract": "./src/shared/contract.ts",
    "./procedures": "./src/shared/procedures.ts",
    "./testing": "./src/testing/service.ts"
  },
  "imports": {
    "#generated/*": "./generated/*",
    "#*": "./src/*"
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "start": "bun src/index.ts",
    "migrate:deploy": "prisma migrate deploy",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run src/shared src/domain src/application src/bridge src/server --testTimeout 30000 --hookTimeout 30000",
    "test:extended": "bun ../../scripts/ci/run-ci-test.ts --tier extended",
    "test:ci": "bun ../../scripts/ci/run-ci-test.ts",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "dev": "bun src/dev.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/client-runtime-utils": "7.10.1",
    "@shepherdjerred/config": "workspace:*",
    "@shepherdjerred/feature-flags": "workspace:*",
    "@trpc/server": "^11.18.0",
    "hono": "^4.12.18",
    "mermaid": "12.3.0",
    "pg": "8.23.1",
    "prisma": "^7.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shepherdjerred/eslint-config": "workspace:*",
    "@shepherdjerred/test-postgres": "workspace:*",
    "@types/bun": "1.4.5",
    "@types/pg": "8.23.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-istanbul": "5.0.5",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "vitest": "5.0.5"
  }
}
