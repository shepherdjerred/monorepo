---
import Search from "@astrojs/starlight/components/Search.astro";
import { themeCatalog, resolveTheme } from "@shepherdjerred/storm-theme";
import { forumActive, forumUrl as forum } from "../forum-release.ts";
const id = resolveTheme("auto", true, new Date());
const theme = themeCatalog.themes.find((theme) => theme.id === id);
if (!theme) throw new Error("Missing Storm theme");
const api = forumActive ? `${forum}/storm-theme/` : undefined;
---

<div
  class="stormDocsHeader"
  id="storm-theme-root"
  data-storm-surface="docs"
  data-storm-base="/storm/"
  data-storm-api={api}
  data-storm-sync={forumActive ? "forum" : "local"}
>
  <div class="stormDocsTop stormDocsInner">
    <a href={forum} aria-label="The Storm community">
      <img
        class="stormDocsLogo"
        data-storm-logo
        src={`/storm/${theme.logos.light}`}
        width="270"
        height="83"
        alt="The Storm"
      />
    </a>
    <div class="stormDocsServer">
      <p>
        <span class="stormDocsTagline">
          A place to build, explore, and catch up.
        </span>
        <br />
        <strong>Server IP: ts-mc.net</strong>
        <br />
        Minecraft Java + Bedrock
      </p>
    </div>
  </div>
  <div class="stormDocsNavigation">
    <div class="stormDocsNavInner stormDocsInner">
      <nav class="stormDocsNav" aria-label="The Storm">
        <a href={forum}>Home</a>
        <a href="https://bluemap.ts-mc.net">LiveMap</a>
        <a href="/" aria-current="page">
          Docs
        </a>
        {forumActive && (
          <>
            <details>
              <summary>Forums</summary>
              <div class="stormNavMenu">
                <a href={`${forum}/forums/`}>Forum list</a>
                <a href={`${forum}/whats-new/posts/`}>New posts</a>
              </div>
            </details>
            <details class="stormDocsSecondary">
              <summary>What's new</summary>
              <div class="stormNavMenu">
                <a href={`${forum}/whats-new/`}>What's new</a>
                <a href={`${forum}/whats-new/posts/`}>New posts</a>
              </div>
            </details>
            <details class="stormDocsSecondary">
              <summary>Members</summary>
              <div class="stormNavMenu">
                <a href={`${forum}/members/`}>Members</a>
                <a href={`${forum}/online/`}>Current visitors</a>
              </div>
            </details>
            <details class="stormDocsMore">
              <summary>More</summary>
              <div class="stormNavMenu">
                <a href={`${forum}/whats-new/`}>What's new</a>
                <a href={`${forum}/members/`}>Members</a>
                <a href={`${forum}/online/`}>Current visitors</a>
              </div>
            </details>
          </>
        )}
      </nav>
      <div class="stormDocsActions">
        {forumActive && (
          <div data-storm-account>
            <a href={`${forum}/login/`}>Log in</a>
            <a href={`${forum}/register/`}>Register</a>
          </div>
        )}
        <Search />
        <button
          class="stormDocsMenuToggle"
          type="button"
          aria-label="Open navigation"
          aria-expanded="false"
          aria-controls="storm-docs-navigation"
        >
          ☰
        </button>
      </div>
    </div>
  </div>
  <div class="stormDocsSubNav" aria-hidden="true"></div>
</div>
<script>
  import "@shepherdjerred/storm-theme/browser";
  const header = document.getElementById("storm-theme-root");
  if (!header) throw new Error("Missing Storm header");
  new ResizeObserver(() => {
    document.documentElement.style.setProperty(
      "--sl-nav-height",
      `${header.getBoundingClientRect().height}px`,
    );
    const actions = header.querySelector(".stormDocsActions");
    if (actions)
      document.documentElement.style.setProperty(
        "--storm-mobile-menu-top",
        `${actions.getBoundingClientRect().top}px`,
      );
  }).observe(header);
  header.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    const target = event.target;
    if (!(target instanceof Element)) return;
    const menu = target.closest("details");
    if (menu instanceof HTMLDetailsElement) {
      menu.open = false;
      menu.querySelector("summary")?.focus();
    }
  });
  document.addEventListener("click", (event) => {
    for (const menu of header.querySelectorAll("details[open]")) {
      if (
        menu instanceof HTMLDetailsElement &&
        event.target instanceof Node &&
        !menu.contains(event.target)
      )
        menu.open = false;
    }
  });
  const toggle = header.querySelector<HTMLButtonElement>(
    ".stormDocsMenuToggle",
  );
  const sidebar = document.querySelector<HTMLElement>(".stormDocsSidebar");
  if (toggle && sidebar) {
    sidebar.id = "storm-docs-navigation";
    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") !== "true";
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute(
        "aria-label",
        open ? "Close navigation" : "Open navigation",
      );
      document.documentElement.toggleAttribute("data-storm-menu-open", open);
      if (open) sidebar.querySelector<HTMLElement>("a")?.focus();
    });
    sidebar.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      document.documentElement.removeAttribute("data-storm-menu-open");
      toggle.setAttribute("aria-expanded", "false");
      toggle.focus();
    });
  }
</script>
