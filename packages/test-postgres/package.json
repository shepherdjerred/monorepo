{
  "name": "@shepherdjerred/test-postgres",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "build": "bun build src/index.ts --target bun --outdir dist",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run src --exclude '**/*.integration.test.ts'",
    "test:ci": "bun ../../scripts/ci/run-ci-test.ts",
    "test:extended": "bun ../../scripts/ci/run-ci-test.ts --tier extended",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shepherdjerred/eslint-config": "workspace:*",
    "@types/bun": "1.4.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-istanbul": "5.0.3",
    "eslint": "^10.7.0",
    "typescript": "^6.0.3",
    "vitest": "5.0.3"
  }
}
