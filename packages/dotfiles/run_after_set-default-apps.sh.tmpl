#!/bin/bash
{{ if eq .chezmoi.os "darwin" -}}
set -euo pipefail

# This is intentionally a run_after_ hook: the initial chezmoi apply happens
# before Homebrew installs duti, while the post-Brew apply needs to configure
# the associations. Re-applying the desired handlers is idempotent.
if ! command -v duti &>/dev/null; then
    echo "duti is not installed; default app setup will run on the next chezmoi apply" >&2
    exit 0
fi

# Sublime Text — text and source code
# Keep HTML with Safari. Assigning .html to Sublime with the "all" role makes
# macOS treat every chezmoi apply as a protected default-browser change.
SUBLIME="com.sublimetext.4"
for ext in txt md log csv json yaml yml xml toml ini cfg conf \
           sh bash zsh fish py js ts tsx rs go java \
           c cpp h hpp css scss svg lua rb swift sql \
           dockerfile diff patch properties proto plist; do
    duti -s "$SUBLIME" ".$ext" all
done
# UTI-based associations for broader coverage
for uti in public.plain-text public.source-code public.shell-script \
           public.python-script public.json public.xml public.yaml; do
    duti -s "$SUBLIME" "$uti" all
done

# IINA — video
IINA="com.colliderli.iina"
for ext in mp4 mkv avi mov wmv flv webm m4v mpg mpeg 3gp \
           ogv vob m2ts mts rmvb rm; do
    duti -s "$IINA" ".$ext" all
done

# IINA — audio
for ext in mp3 flac aac ogg wav m4a wma opus aiff aif; do
    duti -s "$IINA" ".$ext" all
done

# IINA — broad UTIs for catch-all coverage
duti -s "$IINA" public.movie all
duti -s "$IINA" public.audio all

# Affinity — design files (not general images, those stay with Preview)
AFFINITY="com.canva.affinity"
duti -s "$AFFINITY" com.canva.affinity.document all
for ext in psd ai; do
    duti -s "$AFFINITY" ".$ext" all
done

# Keka — archives. macOS accepts the registered archive UTIs, not dynamically
# generated extension identifiers.
KEKA="com.aone.keka"
for uti in com.pkware.zip-archive public.zip-archive org.7-zip.7-zip-archive \
           public.tar-archive org.gnu.gnu-zip-archive public.bzip2-archive \
           org.tukaani.xz-archive com.rarlab.rar-archive; do
    duti -s "$KEKA" "$uti" all
done

# Safari — web browsing. URL schemes do not take a role argument.
duti -s com.apple.Safari http
duti -s com.apple.Safari https

# MailMate — email
duti -s com.freron.MailMate mailto

# NetNewsWire — RSS
NNW="com.ranchero.NetNewsWire-Evergreen"
duti -s "$NNW" feed
for ext in rss; do
    duti -s "$NNW" ".$ext" all
done

# Ghostty — SSH
duti -s com.mitchellh.ghostty ssh

# Calendar — webcal subscriptions
duti -s com.apple.iCal webcal

echo "Default apps configured via duti"
{{ end -}}
