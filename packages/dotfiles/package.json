{
  "name": "@shepherdjerred/dotfiles-scripts",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "test": "bun test scripts",
    "test:coverage": "bun test --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage --config ../../scripts/bunfig.coverage.toml --coverage scripts/git-cleanup.test.ts",
    "lint": "eslint bin/executable_git_cleanup.ts bin/git_cleanup_core.ts scripts/*.ts",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "test:ci": "bun ../../scripts/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../scripts/run-ci-test.ts"
  },
  "devDependencies": {
    "@shepherdjerred/eslint-config": "workspace:*",
    "@types/bun": "^1.3.14",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "@typescript/native": "npm:typescript@7.0.2"
  }
}
