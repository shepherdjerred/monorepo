{{- /* Agent hosts render no ~/.aws/credentials; the SDKs and CLI ask toolkit
       for each profile's keys at call time through credential_process.
       Backblaze keys are bucket-scoped, so agent hosts get one profile per
       key instead of the endpoint-only b2 profile. */ -}}
{{- $toolkit := joinPath .chezmoi.homeDir ".local/bin/toolkit" -}}
{{- $agentHost := eq .profile "agent-host" }}
[default]
endpoint_url = https://seaweedfs-s3.tailnet-1a49.ts.net
region = us-east-1
{{- if $agentHost }}
{{- range list "b2-velero" "b2-postgres-wal" "b2-seaweedfs-backups" }}

[profile {{ . }}]
endpoint_url = https://s3.us-west-004.backblazeb2.com
region = us-west-004
credential_process = {{ $toolkit }} aws credential {{ . }}
{{- end }}
{{- else }}

[profile b2]
endpoint_url = https://s3.us-west-004.backblazeb2.com
region = us-west-004
{{- end }}

[profile seaweedfs]
endpoint_url = https://seaweedfs-s3.tailnet-1a49.ts.net
region = us-east-1
{{- if $agentHost }}
credential_process = {{ $toolkit }} aws credential seaweedfs
{{- end }}

[profile brim-sync]
endpoint_url = https://seaweedfs-s3.tailnet-1a49.ts.net
region = us-east-1
{{- if $agentHost }}
credential_process = {{ $toolkit }} aws credential brim-sync
{{- end }}

[profile aws]
login_session = arn:aws:iam::926367030076:root
region = us-east-1
