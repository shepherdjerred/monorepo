# Claude Code rewrites model/effortLevel/fast into this file on every /model or
# /effort, so tracking it caused perpetual drift and re-add snapshotting a
# transient model. Durable config now lives in the managed layer (see
# claude-managed/README.md); this file holds only per-machine + churny keys,
# seeded from claude-managed/settings.user-reference.json on a fresh machine.
.claude/settings.json

# Repo-side source of truth + installer for the Claude Code managed-settings
# policy. It targets a system path (/Library/Application Support/ClaudeCode),
# not $HOME, so it's installed by claude-managed/install-managed-settings.sh,
# never placed by chezmoi.
claude-managed

# pinchtab daemon rewrites this at runtime (token, extension paths, sessions);
# it's per-machine server state regenerated by the run_once install script, so
# don't track it — tracking caused perpetual drift and apply-clobber risk.
Library/Application Support/pinchtab/config.json

