  completedAt       DateTime?
  failedAt          DateTime?
  lastRequeuedAt    DateTime?
  updatedAt         DateTime  @updatedAt

  @@index([state, createdAt])
  @@index([kind, state])
}

/// Durable execution and recovery record for one Explore turn or report-AI
/// edit. Provider inputs and partial output remain in Postgres, never Workflow
/// history. A non-null providerAttemptAt is intentionally ambiguous: retries
/// salvage instead of issuing another billable request.
model ScoutInteractiveRun {
  id                String    @id
  kind              String
  ownerId           String
  guildId           String?
  conversationId    String?
  quotaExempt       Boolean   @default(false)
  payload           String
  state             String    @default("PENDING")
  providerAttemptAt DateTime?
  stopRequestedAt   DateTime?
  partialOutput     String?
  trace             String?
  /// Mirrored live-run progress, so a durable observer that did not land on
  /// the process owning the run shows the same status line and result table
  /// as one that did. `preview` is JSON, matching `trace`.
  activity          String?
  preview           String?
  resultMessageId   String?
  outcome           String?
  lastError         String?
  createdAt         DateTime  @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  updatedAt         DateTime  @updatedAt

  @@index([kind, ownerId, createdAt])
  @@index([kind, guildId, createdAt])
  @@index([state, createdAt])
  @@index([conversationId, state])
}

