{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "check:ios-native-deps": {
      "inputs": [
        "package.json",
        "ios/**",
        "!ios/build/**",
        "scripts/check-ios-native-deps.ts",
        "$TURBO_ROOT$/.mise.toml"
      ]
    },
    "lint:swift": {
      "inputs": [
        "ios/**/*.swift",
        "$TURBO_ROOT$/packages/tasknotes-macos/.swiftlint.yml",
        "$TURBO_ROOT$/packages/tasknotes-macos/.swiftlint-appkit-baseline.json"
      ]
    },
    "test": {
      "inputs": ["$TURBO_ROOT$/vitest.config.ts", "$TURBO_DEFAULT$"]
    },
    "test:ci": {
      "inputs": ["$TURBO_EXTENDS$"]
    }
  }
}
