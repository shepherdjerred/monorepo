{
  "name": "@scout-for-lol/activity",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "lint": "bun x --no-install eslint src",
    "test": "bun --no-install --bun vitest --config ../../../../vitest.config.ts run src",
    "test:ci": "bun ../../../../scripts/ci/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../../../scripts/ci/run-ci-test.ts",
    "test:e2e": "bun --no-install --bun playwright test"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "@scout-for-lol/backend": "workspace:*",
    "@scout-for-lol/data": "workspace:*",
    "@scout-for-lol/design-system": "workspace:*",
    "@tanstack/react-query": "^5.90.21",
    "@trpc/client": "^11.18.0",
    "@trpc/tanstack-react-query": "^11.18.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/bun": "1.4.0",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vitest": "4.1.9",
    "@vitest/coverage-istanbul": "4.1.9"
  }
}
