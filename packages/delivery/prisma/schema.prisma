generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  runtime      = "bun"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// A catalog-defined unit of ownership and release (model 4.2).
model Service {
  id              String               @id
  lifecycle       String               @default("active")
  selfHosted      Boolean              @default(false)
  group           String?
  components      Json                 @default("[]")
  lineage         String
  catalogRevision String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  builds          Build[]
  versionSets     VersionSet[]
  environments    Environment[]
  deployments     Deployment[]
  references      ComponentReference[] @relation("ReferencingService")
  referencedBy    ComponentReference[] @relation("SourceService")
}

model Build {
  id                     String                   @id
  requestId              String                   @unique
  serviceId              String
  service                Service                  @relation(fields: [serviceId], references: [id])
  sourceRevision         String
  sourceKind             String                   @default("ci")
  ciUrl                  String?
  verifiedAt             DateTime
  status                 String                   @default("pending")
  qualificationReason    String?
  qualificationCheckedAt DateTime?
  platformChanges        Json?
  repositoryId           Int?
  pipelineNumber         Int?
  /// Global registration order; the order key of an `attested` build (B4). Null only for rows older than the sequence.
  registrationSequence   Int?                     @default(dbgenerated("nextval('\"Build_registrationSequence_seq\"'::regclass)"))
  createdAt              DateTime                 @default(now())
  artifacts              Artifact[]
  selections             BuildArtifactSelection[]
  platformDeployments    Deployment[]             @relation("PlatformSource")

  @@index([serviceId, createdAt])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([serviceId, registrationSequence])
}

model Artifact {
  id                   String                      @id
  buildId              String
  build                Build                       @relation(fields: [buildId], references: [id])
  component            String
  kind                 String
  uri                  String
  store                String
  digest               String
  runtimeDigests       String[]                    @default([])
  requires             Json                        @default("{}")
  version              String
  origin               Json                        @default("{\"kind\":\"first-party\"}")
  originKey            String?                     @unique
  /// Chart content identity with the version excluded (X10); null for images, archives and older charts.
  contentFingerprint   String?
  /// Off-cluster replica receipt for bytes in a self-hosted store (PC1); null until the executor copies them.
  replication          Json?
  createdAt            DateTime                    @default(now())
  entries              VersionSetEntry[]
  workerVersions       WorkerVersion[]
  forumBaselineImages  ForumBaselineIntent[]       @relation("ForumBaselineImage")
  forumBaselineBundles ForumBaselineIntent[]       @relation("ForumBaselineBundle")
  selections           BuildArtifactSelection[]
  platformReferences   PlatformArtifactReference[]

  @@unique([buildId, component])
}

model BuildArtifactSelection {
  buildId    String
  build      Build    @relation(fields: [buildId], references: [id])
  component  String
  artifactId String
  artifact   Artifact @relation(fields: [artifactId], references: [id])

  @@id([buildId, component])
  @@index([artifactId])
}

model VersionSet {
  id                  String            @id
  qualifiedBuildId    String?           @unique
  serviceId           String
  service             Service           @relation(fields: [serviceId], references: [id])
  revision            Int
  baseRevisionId      String?
  lineage             String
  orderMajor          Int?
  orderMinor          Int?
  /// Composed by qualification or a tracking recomposition (R2, R7); false for a manual hotfix (R3).
  automatic           Boolean           @default(false)
  /// The source environment's accepting deployment that triggered a tracking recomposition (R7).
  triggerDeploymentId String?
  triggerDeployment   Deployment?       @relation("TrackingTrigger", fields: [triggerDeploymentId], references: [id], onDelete: Restrict)
  createdAt           DateTime          @default(now())
  entries             VersionSetEntry[]

  @@unique([serviceId, revision])
  @@index([serviceId, lineage, orderMajor, orderMinor], map: "VersionSet_serviceId_lineage_order_idx")
}

model VersionSetEntry {
  revisionId String
  revision   VersionSet @relation(fields: [revisionId], references: [id])
  component  String
  artifactId String
  artifact   Artifact   @relation(fields: [artifactId], references: [id])

  @@id([revisionId, component])
}

/// Immutable recipe revision (model 4.7; the code name is retained).
model Pipeline {
  id             String                @id
  definition     Json
  createdAt      DateTime              @default(now())
  environments   Environment[]
  forumBaselines ForumBaselineIntent[]
}

/// Immutable configuration revision (model 4.8).
model Configuration {
  id           String        @id
  content      Json
  forwardOnly  String[]      @default([])
  createdAt    DateTime      @default(now())
  environments Environment[]
  deployments  Deployment[]
}

model Environment {
  id                                 String                @id
  serviceId                          String
  service                            Service               @relation(fields: [serviceId], references: [id])
  name                               String
  application                        String?               @unique
  pipelineRevisionId                 String
  pipeline                           Pipeline              @relation(fields: [pipelineRevisionId], references: [id])
  declaredConfigurationId            String
  declaredConfiguration              Configuration         @relation(fields: [declaredConfigurationId], references: [id])
  automatic                          Boolean               @default(false)
  automaticSuppressedThroughRevision Int                   @default(0)
  promotionSourceEnvironmentId       String?
  role                               String                @default("durable")
  lifecycle                          String                @default("active")
  approvalPolicy                     String                @default("none")
  durableParentId                    String?
  durableParent                      Environment?          @relation("ReplicaParent", fields: [durableParentId], references: [id], onDelete: Restrict)
  replicas                           Environment[]         @relation("ReplicaParent")
  generation                         Int                   @default(0)
  desiredVersionSetRevisionId        String?
  observedVersionSetRevisionId       String?
  acceptedVersionSetRevisionId       String?
  acceptedDeploymentId               String?
  acceptedDeployment                 Deployment?           @relation("AcceptedSelection", fields: [acceptedDeploymentId], references: [id], onDelete: Restrict)
  observedAt                         DateTime?
  activeDeploymentId                 String?
  createdAt                          DateTime              @default(now())
  deployments                        Deployment[]
  workerVersions                     WorkerVersion[]
  forumBaselines                     ForumBaselineIntent[] @relation("ForumEnvironmentBaseline")
  dependentEdges                     PrerequisiteEdge[]    @relation("DependentEnvironment")
  prerequisiteEdges                  PrerequisiteEdge[]    @relation("PrerequisiteEnvironment")

  @@index([serviceId])
}

model Deployment {
  id                                   String                      @id
  requestId                            String                      @unique
  environmentId                        String
  environment                          Environment                 @relation(fields: [environmentId], references: [id])
  serviceId                            String
  service                              Service                     @relation(fields: [serviceId], references: [id])
  versionSetRevisionId                 String
  sourceEnvironmentId                  String?
  repairOfDeploymentId                 String?
  repairOfDeployment                   Deployment?                 @relation("TrmnlRepairSource", fields: [repairOfDeploymentId], references: [id], onDelete: Restrict)
  trmnlRepairs                         Deployment[]                @relation("TrmnlRepairSource")
  previousAcceptedVersionSetRevisionId String?
  previousAcceptedDeploymentId         String?
  previousAcceptedDeployment           Deployment?                 @relation("PreviousAcceptedSelection", fields: [previousAcceptedDeploymentId], references: [id], onDelete: Restrict)
  previousAcceptedOf                   Deployment[]                @relation("PreviousAcceptedSelection")
  restoredDeploymentId                 String?
  restoredDeployment                   Deployment?                 @relation("RestoredSelection", fields: [restoredDeploymentId], references: [id], onDelete: Restrict)
  restoredBy                           Deployment[]                @relation("RestoredSelection")
  pipelineRevisionId                   String
  configurationId                      String
  configuration                        Configuration               @relation(fields: [configurationId], references: [id])
  catalogRevision                      String
  workerSnapshot                       Json?
  platformSnapshot                     Json?
  controlPlaneSnapshot                 Json?
  forumBaselineSnapshot                Json?
  admissionSnapshot                    Json?
  platformSourceBuildId                String?
  platformSourceBuild                  Build?                      @relation("PlatformSource", fields: [platformSourceBuildId], references: [id], onDelete: Restrict)
  platformArtifacts                    PlatformArtifactReference[]
  preparedPlatformPlan                 PlatformPlan?               @relation("PreparedPlatformPlan")
  appliedPlatformPlan                  PlatformPlan?               @relation("AppliedPlatformPlan")
  platformLock                         PlatformLock?
  acceptedBy                           Environment[]               @relation("AcceptedSelection")
  triggeredSets                        VersionSet[]                @relation("TrackingTrigger")
  recoveryIntents                      RecoveryIntent[]
  monitorObservations                  MonitorObservation[]
  expectedGeneration                   Int
  kind                                 String
  automatic                            Boolean                     @default(false)
  status                               String
  requestedBy                          String
  message                              String?
  cancelRequested                      Boolean                     @default(false)
  workflowId                           String?
  workflowRunId                        String?
  leaseExpiresAt                       DateTime?
  handoffAt                            DateTime?
  monitorState                         String?
  monitorSettledAt                     DateTime?
  monitorAlarmedAt                     DateTime?
  createdAt                            DateTime                    @default(now())
  startedAt                            DateTime?
  finishedAt                           DateTime?
  recoveryRequired                     Boolean                     @default(false)
  resultFingerprint                    String?
  evidence                             Evidence[]
  approval                             Approval?
  stages                               Stage[]
  outbox                               Outbox?
  locks                                TargetLock[]
  introducedWorkers                    WorkerVersion[]

  @@index([environmentId, createdAt])
  @@index([status, createdAt])
  @@index([versionSetRevisionId])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([monitorState])
}

/// Original-runtime baseline observation retained as evidence; never an accepted pointer.
model ForumBaselineIntent {
  id                            String      @id
  environmentId                 String
  environment                   Environment @relation("ForumEnvironmentBaseline", fields: [environmentId], references: [id])
  imageArtifactId               String
  imageArtifact                 Artifact    @relation("ForumBaselineImage", fields: [imageArtifactId], references: [id])
  bundleArtifactId              String
  bundleArtifact                Artifact    @relation("ForumBaselineBundle", fields: [bundleArtifactId], references: [id])
  requestedBy                   String
  reason                        String
  expectedEnvironmentGeneration Int
  pipelineRevisionId            String
  pipeline                      Pipeline    @relation(fields: [pipelineRevisionId], references: [id])
  configurationRevision         String
  snapshotFingerprint           String
  status                        String      @default("pending")
  workflowId                    String      @unique
  submittedAt                   DateTime?
  proof                         Json?
  message                       String?
  resultFingerprint             String?
  createdAt                     DateTime    @default(now())
  finishedAt                    DateTime?

  @@index([status, createdAt])
  @@index([environmentId, createdAt])
}

/// One operator-authorised inspection of a recovery-required deployment (model 4.15).
model RecoveryIntent {
  id                 String     @id
  kind               String
  deploymentId       String
  deployment         Deployment @relation(fields: [deploymentId], references: [id])
  sequence           Int
  step               String?
  requestedBy        String
  reason             String
  expectedGeneration Int
  fingerprint        String
  status             String     @default("pending")
  workflowId         String?    @unique
  submittedAt        DateTime?
  detail             Json       @default("{}")
  evidence           Json       @default("[]")
  barrier            Json?
  barrierRestoredAt  DateTime?
  outcome            Json?
  message            String?
  resultFingerprint  String?
  createdAt          DateTime   @default(now())
  finishedAt         DateTime?

  @@unique([deploymentId, sequence])
  @@index([status, createdAt])
  @@index([kind, status, createdAt])
  @@index([deploymentId, createdAt])
}

model WorkerVersion {
  id                       String      @id
  environmentId            String
  environment              Environment @relation(fields: [environmentId], references: [id])
  buildId                  String
  artifactId               String
  artifact                 Artifact    @relation(fields: [artifactId], references: [id])
  introducedByDeploymentId String
  introducedByDeployment   Deployment  @relation(fields: [introducedByDeploymentId], references: [id])
  host                     Json
  replicas                 Int         @default(1)
  generation               Int         @default(0)
  retiredAt                DateTime?
  retirementProof          Json?
  createdAt                DateTime    @default(now())

  @@unique([environmentId, buildId])
  @@index([environmentId, replicas])
}

model PlatformArtifactReference {
  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id])
  kind         String
  selector     String
  artifactId   String
  artifact     Artifact   @relation(fields: [artifactId], references: [id])

  @@id([deploymentId, kind, selector])
  @@index([artifactId])
}

model PlatformPlan {
  deploymentId      String      @id
  deployment        Deployment  @relation("PreparedPlatformPlan", fields: [deploymentId], references: [id])
  receipt           Json
  encryptedPlan     Json
  fingerprint       String
  applyDeploymentId String?     @unique
  applyDeployment   Deployment? @relation("AppliedPlatformPlan", fields: [applyDeploymentId], references: [id], onDelete: Restrict)
  createdAt         DateTime    @default(now())
}

/// The one named shared lock (model T1); its id is `platform`.
model PlatformLock {
  id           String     @id
  deploymentId String     @unique
  deployment   Deployment @relation(fields: [deploymentId], references: [id])
  createdAt    DateTime   @default(now())
}

model Evidence {
  id           String     @id
  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id])
  kind         String
  summary      String
  url          String?
  operationId  String?
  createdAt    DateTime   @default(now())

  @@unique([deploymentId, id])
}

/// One decision per deployment, bound to its frozen selection (model 4.13).
model Approval {
  id               String     @id
  deploymentId     String     @unique
  deployment       Deployment @relation(fields: [deploymentId], references: [id])
  status           String     @default("pending")
  override         Boolean    @default(false)
  boundFingerprint String
  reason           String?
  actor            String?
  createdAt        DateTime   @default(now())
  decidedAt        DateTime?
}

model Stage {
  id           String     @id
  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id])
  key          String
  status       String
  operationId  String
  message      String
  startedAt    DateTime?
  updatedAt    DateTime   @updatedAt

  @@unique([deploymentId, key])
}

model Outbox {
  deploymentId String     @id
  deployment   Deployment @relation(fields: [deploymentId], references: [id])
  workflowId   String     @unique
  submittedAt  DateTime?
  createdAt    DateTime   @default(now())

  @@index([submittedAt, createdAt])
}

/// One lock per target instance; a deployment may hold several (model T1).
model TargetLock {
  instance     String     @id
  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id])
  acquiredAt   DateTime   @default(now())

  @@index([deploymentId])
}

/// Catalog edge: the dependent deploys only after the prerequisite accepted (model 4.18).
model PrerequisiteEdge {
  dependentId    String
  dependent      Environment @relation("DependentEnvironment", fields: [dependentId], references: [id])
  prerequisiteId String
  prerequisite   Environment @relation("PrerequisiteEnvironment", fields: [prerequisiteId], references: [id])
  rule           String

  @@id([dependentId, prerequisiteId])
  @@index([prerequisiteId])
}

/// One monitor observation of the accepted deployment it watches (model 4.19).
model MonitorObservation {
  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id])
  sequence     Int
  observedAt   DateTime
  alarms       Json       @default("[]")
  evidence     Json       @default("{}")
  outcome      String
  createdAt    DateTime   @default(now())

  @@id([deploymentId, sequence])
}

/// A component filled by another service's artifact (model A5).
model ComponentReference {
  serviceId         String
  service           Service @relation("ReferencingService", fields: [serviceId], references: [id])
  component         String
  sourceServiceId   String
  sourceService     Service @relation("SourceService", fields: [sourceServiceId], references: [id])
  sourceComponent   String
  mode              String
  sourceEnvironment String?

  @@id([serviceId, component])
  @@index([sourceServiceId, sourceComponent])
}

model Request {
  id          String   @id
  fingerprint String
  resultType  String
  resultId    String
  actor       String
  createdAt   DateTime @default(now())
}

model Audit {
  id         String   @id
  actor      String
  action     String
  entityId   String
  requestId  String
  metadata   Json
  occurredAt DateTime @default(now())

  @@index([entityId, occurredAt])
  @@index([occurredAt(sort: Desc), id(sort: Desc)])
}

model IntegrationSnapshot {
  source    String
  key       String
  payload   Json
  final     Boolean
  fetchedAt DateTime

  @@id([source, key])
}
