  "general": [
    {
      "lane": "top",
      "inputHash": "b7623f61ea4bfed372da9d3a0698ba65506718d368a3dd3480a7107100d80ecb",
      "tips": [
        {
          "id": "top:Zaahen:general:0",
          "text": "Hit enemy champions with attacks and abilities to build stacks in a trade. Fight until they are full, because Zaahen then hits much harder.",
          "refs": [
            { "kind": "champion", "key": "Zaahen", "start": 110, "end": 116 }
          ],
          "pWrong": 0.16
        },
        {
          "id": "top:Zaahen:general:1",
          "text": "Take trades with full stacks. If you would die then, Cultivation of War revives you after a short time spent untargetable and unable to act.",
          "refs": [
            {
              "kind": "ability",
              "key": "Zaahen-passive",
              "start": 53,
              "end": 71
            }
          ],
          "pWrong": 0.07
        },
        {
          "id": "top:Zaahen:general:2",
          "text": "Start trades with The Darkin Glaive. Its double strike heals you, and you can recast it to knock the enemy up.",
          "refs": [
            { "kind": "ability", "key": "Zaahen-Q", "start": 18, "end": 35 }
          ],
          "pWrong": 0.12
        },
        {
          "id": "top:Zaahen:general:3",
          "text": "Use The Darkin Glaive on minions when you need a little health back. It heals less on them than on champions.",
          "refs": [
            { "kind": "ability", "key": "Zaahen-Q", "start": 4, "end": 21 }
          ],
          "pWrong": 0.05
        },
        {
          "id": "top:Zaahen:general:4",
          "text": "Aim Dreaded Return so the enemy is caught at the far end of the line. It pulls them toward you and stuns them briefly, so follow up with attacks.",
          "refs": [
            { "kind": "ability", "key": "Zaahen-W", "start": 4, "end": 18 }
          ],
          "pWrong": 0.18
        },
        {
          "id": "top:Zaahen:general:5",
          "text": "Land Aureate Rush so the enemy is at the edge of the slice. The outer edge does extra damage, including a share of their max Health.",
          "refs": [
            { "kind": "ability", "key": "Zaahen-E", "start": 5, "end": 17 }
          ],
          "pWrong": 0.08
        },
        {
          "id": "top:Zaahen:general:6",
          "text": "Use Aureate Rush to close the gap on someone walking away, then attack right after the slice.",
          "refs": [
            { "kind": "ability", "key": "Zaahen-E", "start": 4, "end": 16 }
          ],
          "pWrong": 0.03
        },
        {
          "id": "top:Zaahen:general:7",
          "text": "Use Grim Deliverance to finish a fight. You cannot be crowd controlled while casting, and it heals you for each champion it hits.",
          "refs": [
            { "kind": "ability", "key": "Zaahen-R", "start": 4, "end": 20 }
          ],
          "pWrong": 0.09
        },
        {
          "id": "top:Zaahen:general:8",
          "text": "Don't fire Grim Deliverance at a spot the enemy can walk out of. Wait until they are stuck, such as right after Dreaded Return.",
          "refs": [
            { "kind": "ability", "key": "Zaahen-R", "start": 11, "end": 27 },
            { "kind": "ability", "key": "Zaahen-W", "start": 112, "end": 126 }
          ],
          "pWrong": 0.24
        }
      ],
      "combos": []
    }
  ],
