          "pWrong": 0.12
        },
        {
          "id": "top:Heimerdinger:Gangplank:3",
          "text": "Stay out of range when his Powder Kegs are placed, because their explosions slow you and hit hard.",
          "refs": [
            { "kind": "keyword", "key": "slowed", "start": 76, "end": 80 }
          ],
          "pWrong": 0.09
        },
        {
          "id": "top:Heimerdinger:Gangplank:4",
