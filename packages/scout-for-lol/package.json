{
  "name": "scout-for-lol",
  "private": true,
  "scripts": {
    "build": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit -p tsconfig.scripts.json",
    "format": "cd ../.. && prettier --check packages/scout-for-lol",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run ./scripts",
    "test:coverage": "bun --no-install --bun vitest --config ../../vitest.config.ts run --coverage.reporter=text --coverage.reporter=lcovonly --coverage.reportsDirectory=coverage --coverage scripts/create-minimal-png.test.ts scripts/dev-lake-seed.test.ts scripts/dev-web.test.ts scripts/install-pkgs.test.ts --coverage.thresholds.lines=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "lint": "eslint scripts",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit -p tsconfig.scripts.json",
    "dev:web": "op run --env-file=./dev-web.env.tpl -- bun scripts/dev-web.ts",
    "dev:design-audit": "bun scripts/dev-web.ts",
    "dev:seed": "bun scripts/dev-seed.ts",
    "dev:login": "bun scripts/dev-login.ts",
    "duplication-check": "bun run scripts/check-duplication.ts",
    "check:assets": "bun run scripts/check-asset-sizes.ts",
    "test:ci": "bun ../../scripts/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../scripts/run-ci-test.ts"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
    "@eslint/js": "^10.0.1",
    "@shepherdjerred/eslint-config": "workspace:*",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "1.4.0",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "@typescript/native": "npm:typescript@7.0.2",
    "bun-types": "1.4.0",
    "eslint": "^10.3.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-import-resolver-typescript-bun": "^0.0.104",
    "eslint-plugin-astro": "^3.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "jiti": "^2.7.0",
    "jscpd": "^5.0.16",
    "prettier": "3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "4.1.10",
    "@vitest/coverage-istanbul": "4.1.10"
  },
  "dependencies": {
    "@scout-for-lol/design-system": "workspace:*",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "react": "19.2.8",
    "zod": "^4.4.3"
  }
}
