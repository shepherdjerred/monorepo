          ],
          "when": "Full teamfight engage once Crash Down and Magnet Storm have both landed.",
          "whenRefs": [
            { "kind": "ability", "key": "Rell-R", "start": 42, "end": 54 }
          ],
          "text": "Recast W to remount, then attack. The empowered attack charges at the target and stuns it, which adds more crowd control after the ultimate.",
          "textRefs": []
        }
      ]
    }
  ],
