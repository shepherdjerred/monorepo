{
  "extends": [
    "@tsconfig/strictest/tsconfig.json",
    "@tsconfig/node-lts/tsconfig.json",
    "@tsconfig/recommended/tsconfig.json"
  ],
  "compilerOptions": {
    "types": ["@types/bun"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "scripts", "test", "eslint.config.ts"]
}
