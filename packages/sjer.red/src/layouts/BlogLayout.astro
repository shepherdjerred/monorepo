---
import NavbarLayout from "@layouts/NavbarLayout.astro";
import { BlogSchema } from "@src/content/schemas";
import BlogContent from "@components/blog/BlogContent.astro";
import BlogWebring from "@components/blog/BlogWebring.astro";
import Container from "@components/Container.astro";
import { z } from "astro/zod";

const AstroPropsSchema = z
  .object({ frontmatter: z.record(z.string(), z.unknown()).optional() })
  .passthrough();
const { frontmatter, ...directProps } = AstroPropsSchema.parse(Astro.props);
const props = BlogSchema.parse({
  ...frontmatter,
  ...directProps,
});
---

<NavbarLayout
  title={props.title}
  description={props.description}
  openGraphType="article"
>
  <Container width="normal">
    <BlogContent {...props}>
      <slot />
    </BlogContent>
  </Container>
  <BlogWebring date={props.date} />
</NavbarLayout>
