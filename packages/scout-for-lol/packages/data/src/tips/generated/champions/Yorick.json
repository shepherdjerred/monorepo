      "tips": [
        {
          "id": "top:Yorick:general:0",
          "text": "Use Last Rites on enemy champions and last-hit with it when you are hurt. It heals you more the lower your Health is, but less against minions.",
          "refs": [
            { "kind": "ability", "key": "Yorick-Q", "start": 4, "end": 14 }
          ],
          "pWrong": 0.15
        },
        {
          "id": "top:Yorick:general:1",
          "text": "Hit a champion with Last Rites to leave a grave. When three graves are nearby, Recast to raise Mist Walkers.",
          "refs": [
            { "kind": "ability", "key": "Yorick-Q", "start": 20, "end": 30 }
          ],
          "pWrong": 0.23
        },
        {
          "id": "top:Yorick:general:2",
          "text": "Throw Mourning Mist at the enemy before you trade. It slows them and cuts their Armor, and your Mist Walkers leap at them.",
          "refs": [
            { "kind": "ability", "key": "Yorick-E", "start": 6, "end": 19 },
            { "kind": "keyword", "key": "slowed", "start": 54, "end": 59 }
          ],
          "pWrong": 0.04
        },
        {
          "id": "top:Yorick:general:3",
          "text": "Mourning Mist also raises Mist Walkers from nearby graves while the enemy stays marked, so use it to fill your army mid-fight.",
          "refs": [
            { "kind": "ability", "key": "Yorick-E", "start": 0, "end": 13 }
          ],
          "pWrong": 0.05
        },
        {
          "id": "top:Yorick:general:4",
          "text": "Drop Dark Procession around the enemy to trap them, or behind them to cut off their escape. Enemies can break it by attacking it.",
          "refs": [
            { "kind": "ability", "key": "Yorick-W", "start": 5, "end": 20 }
          ],
          "pWrong": 0.03
        },
        {
          "id": "top:Yorick:general:5",
          "text": "Use Dark Procession to block enemies chasing you. It blocks enemies but not your allies, so you can walk through it.",
          "refs": [
            { "kind": "ability", "key": "Yorick-W", "start": 4, "end": 19 }
          ],
          "pWrong": 0.07
        },
        {
          "id": "top:Yorick:general:6",
          "text": "Summon the Maiden with Eulogy of the Isles at level 6 to fight beside you or push a tower. Pick your targets, because she attacks whoever she chooses.",
          "refs": [
            { "kind": "ability", "key": "Yorick-R", "start": 23, "end": 42 }
          ],
          "pWrong": 0.82
        },
        {
          "id": "top:Yorick:general:7",
          "text": "Keep the Maiden alive. If you die, she quickly loses Health and dies, so stay safe while she is out.",
          "refs": [],
          "pWrong": 0.09
        }
      ],
      "combos": [
        {
          "id": "top:Yorick:combo:0",
          "name": "Attack-Q reset",
          "category": "trick",
          "sequence": [
            "attack",
            { "kind": "ability", "key": "Yorick-Q" },
            "attack"
          ],
          "when": "When trading with a champion in melee range during a lane fight.",
          "whenRefs": [],
          "text": "Last Rites resets Yorick's basic attack timer. Auto first, then Q, then auto again so the empowered hit follows straight after the first and adds extra damage.",
          "textRefs": [
            { "kind": "ability", "key": "Yorick-Q", "start": 0, "end": 10 },
            { "kind": "champion", "key": "Yorick", "start": 18, "end": 24 }
          ]
        },
        {
          "id": "top:Yorick:combo:1",
          "name": "Cage duel",
          "category": "trick",
          "sequence": [
            { "kind": "ability", "key": "Yorick-W" },
            { "kind": "ability", "key": "Yorick-E" },
            { "kind": "ability", "key": "Yorick-Q" },
            "attack"
          ],
          "when": "When you want to isolate one top laner away from their jungler or wave.",
          "whenRefs": [],
          "text": "Place Dark Procession over the enemy so the ring closes around you both and traps them in. Then mark them with Mourning Mist and fight inside the ring.",
          "textRefs": [
