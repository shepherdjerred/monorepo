---
import { Fold } from "@scout-for-lol/design-system/components/surfaces/fold";
import { formatPercent } from "@scout-for-lol/design-system/domain/profile/win-rate-bar";
import { SetupRow } from "@scout-for-lol/design-system/domain/rows/setup-row";
import { otherOptions, setupRows } from "#src/components/champions/setup.ts";
import type { SnapshotChampion } from "#src/lib/champion-meta/snapshot-v2-schema.ts";

interface Props {
  champion: SnapshotChampion;
  slice: SnapshotChampion["slices"][number];
}

const { champion, slice } = Astro.props;
const rows = setupRows(champion.id, slice);
const folds = otherOptions(slice);
---

{rows.length > 0 && (
  <section
    class="scout-soft-panel scout-soft-panel--panel champions-setup"
    aria-labelledby="setup-h"
  >
    <h2 id="setup-h">How most people play {champion.name}</h2>
    <div class="champions-steps">
      {rows.map((row) => (
        <SetupRow
          title={row.title}
          items={row.items}
          sequence={row.sequence}
          proof={row.proof}
          {...(row.note === undefined ? {} : { note: row.note })}
        />
      ))}
    </div>
  </section>
)}
{folds.length > 0 && (
  <section
    class="scout-soft-panel scout-soft-panel--open"
    aria-labelledby="other-h"
  >
    <h2 id="other-h">Other options</h2>
    <div class="champions-folds">
      {folds.map((fold) => (
        <Fold summary={fold.summary}>
          <ul class="champions-alternatives">
            {fold.entries.map((entry) => (
              <li class="champions-quiet">
                {entry.text}: {formatPercent(entry.winRate)} wins from{" "}
                {entry.games.toLocaleString("en-US")} games
              </li>
            ))}
          </ul>
        </Fold>
      ))}
    </div>
  </section>
)}
