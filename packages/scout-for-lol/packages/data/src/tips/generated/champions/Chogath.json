      "inputHash": "68a15d359cef93868297dc03ce1a8fda5371463dec1372d22bb4b1001f922f43",
      "tips": [
        {
          "id": "top:Chogath:general:0",
          "text": "Aim Rupture where the enemy will step, not where they stand. It lands after a short delay, so cast it at their path when they walk up to last-hit.",
          "refs": [
            { "kind": "ability", "key": "Chogath-Q", "start": 4, "end": 11 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "top:Chogath:general:1",
          "text": "Use Rupture on minion waves to heal and regain mana through Carnivore. It also keeps your mana up for longer trades.",
          "refs": [
            { "kind": "ability", "key": "Chogath-Q", "start": 4, "end": 11 },
            {
              "kind": "ability",
              "key": "Chogath-passive",
              "start": 60,
              "end": 69
            }
          ],
          "pWrong": 0.45
        },
        {
          "id": "top:Chogath:general:2",
          "text": "Use Feral Scream only when the enemy is close, because its range is short. It leaves them silenced, so they cannot use abilities to escape or fight back.",
          "refs": [
            { "kind": "ability", "key": "Chogath-W", "start": 4, "end": 16 },
            { "kind": "keyword", "key": "silenced", "start": 90, "end": 98 }
          ],
          "pWrong": 0.63
        },
        {
          "id": "top:Chogath:general:3",
          "text": "Line up Vorpal Spikes shots so they pass through the enemy and kill minions at once. The spikes slow the enemy and keep going after a hit.",
          "refs": [
            { "kind": "ability", "key": "Chogath-E", "start": 8, "end": 21 },
            { "kind": "keyword", "key": "slowed", "start": 96, "end": 100 }
          ],
          "pWrong": 0.05
        },
        {
          "id": "top:Chogath:general:4",
          "text": "Eat minions with Feast early to grow bigger and tankier. Save it for champions once you are large enough to finish them.",
          "refs": [
            { "kind": "ability", "key": "Chogath-R", "start": 17, "end": 22 }
          ],
          "pWrong": 0.43
        },
        {
          "id": "top:Chogath:general:5",
          "text": "Look for the kill when an enemy champion is low on health. Feast deals true damage, and the game marks enemies you can eat.",
          "refs": [
            { "kind": "ability", "key": "Chogath-R", "start": 59, "end": 64 }
          ],
          "pWrong": 0.16
        },
        {
          "id": "top:Chogath:general:6",
          "text": "Start trades with Rupture, then use Feral Scream and Vorpal Spikes while the enemy is knocked up and slowed.",
          "refs": [
            { "kind": "ability", "key": "Chogath-Q", "start": 18, "end": 25 },
            { "kind": "ability", "key": "Chogath-W", "start": 36, "end": 48 },
            { "kind": "ability", "key": "Chogath-E", "start": 53, "end": 66 },
            { "kind": "keyword", "key": "knocked-up", "start": 86, "end": 96 },
            { "kind": "keyword", "key": "slowed", "start": 101, "end": 107 }
          ],
          "pWrong": 0.23
        }
      ],
      "combos": []
    }
