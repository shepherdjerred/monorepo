+bool GfxRenderingAPIOGL::ReadFramebufferBGRA8(int fbId, uint32_t width, uint32_t height, uint8_t* bgraOut) {
+    if (fbId >= (int)mFrameBuffers.size()) {
+        return false;
+    }
+
+    const size_t stride = (size_t)width * 4;
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, mFrameBuffers[fbId].fbo);
+    glPixelStorei(GL_PACK_ALIGNMENT, 4);
+#ifdef USE_OPENGLES
+    glReadPixels(0, 0, width, height, GL_RGBA, GL_UNSIGNED_BYTE, bgraOut);
+    for (size_t i = 0; i < stride * height; i += 4) {
+        std::swap(bgraOut[i], bgraOut[i + 2]);
+    }
+#else
+    glReadPixels(0, 0, width, height, GL_BGRA, GL_UNSIGNED_BYTE, bgraOut);
+#endif
+    glBindFramebuffer(GL_FRAMEBUFFER, mFrameBuffers[mCurrentFrameBuffer].fbo);
+
+    // GL rows start at the bottom unless the framebuffer was rendered
+    // Y-inverted (the game framebuffer is); hosts expect the top row first.
+    if (mFrameBuffers[fbId].invertY) {
+        return true;
+    }
+    std::vector<uint8_t> row(stride);
+    for (uint32_t y = 0; y < height / 2; y++) {
+        uint8_t* top = bgraOut + (size_t)y * stride;
+        uint8_t* bottom = bgraOut + (size_t)(height - 1 - y) * stride;
+        memcpy(row.data(), top, stride);
+        memcpy(top, bottom, stride);
+        memcpy(bottom, row.data(), stride);
+    }
+    return true;
+}
