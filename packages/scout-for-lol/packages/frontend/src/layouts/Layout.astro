---
import "../styles/global.css";
import MarketingTracking from "#src/components/MarketingTracking.astro";
import SeoHead from "#src/components/SeoHead.astro";

interface Props {
  title: string;
  description: string;
  image?: string | undefined;
  noindex?: boolean | undefined;
}

const { title, description, image, noindex } = Astro.props;
const posthogProjectToken =
  typeof import.meta.env["PUBLIC_POSTHOG_PROJECT_TOKEN"] === "string"
    ? import.meta.env["PUBLIC_POSTHOG_PROJECT_TOKEN"]
    : undefined;
const posthogApiHost =
  typeof import.meta.env["PUBLIC_POSTHOG_API_HOST"] === "string"
    ? import.meta.env["PUBLIC_POSTHOG_API_HOST"]
    : undefined;
const posthogAssetHost =
  typeof import.meta.env["PUBLIC_POSTHOG_ASSET_HOST"] === "string"
    ? import.meta.env["PUBLIC_POSTHOG_ASSET_HOST"]
    : undefined;
const posthogSiteKey =
  typeof import.meta.env["PUBLIC_POSTHOG_SITE_KEY"] === "string"
    ? import.meta.env["PUBLIC_POSTHOG_SITE_KEY"]
    : undefined;
const posthogSiteDomain =
  typeof import.meta.env["PUBLIC_POSTHOG_SITE_DOMAIN"] === "string"
    ? import.meta.env["PUBLIC_POSTHOG_SITE_DOMAIN"]
    : undefined;
const posthogSessionReplay =
  typeof import.meta.env["PUBLIC_POSTHOG_SESSION_REPLAY"] === "string"
    ? import.meta.env["PUBLIC_POSTHOG_SESSION_REPLAY"]
    : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <SeoHead
      title={title}
      description={description}
      image={image}
      noindex={noindex}
    />
    <script is:inline>
      // Initialize dark mode before page renders to prevent flash
      if (
        localStorage.theme === "dark" ||
        (!("theme" in localStorage) &&
          window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>
    <script
      is:inline
      defer
      src="/posthog-bootstrap.js"
      data-posthog-project-token={posthogProjectToken}
      data-posthog-api-host={posthogApiHost}
      data-posthog-asset-host={posthogAssetHost}
      data-posthog-site-key={posthogSiteKey}
      data-posthog-site-domain={posthogSiteDomain}
      data-posthog-session-replay={posthogSessionReplay}></script>
    <script>
      import { initSentry } from "../lib/sentry";
      initSentry();
    </script>
    <MarketingTracking />
  </head>
  <body class="text-slate-950 dark:text-white">
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
