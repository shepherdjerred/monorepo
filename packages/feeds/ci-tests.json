{
  "$schema": "../../scripts/ci-tests.schema.json",
  "package": "@shepherdjerred/feeds",
  "steps": [
    {
      "runner": "vitest",
      "args": ["src", "--exclude", "**/*.integration.test.ts"]
    },
    {
      "runner": "vitest",
      "name": "postgres-integration",
      "tier": "extended",
      "args": [
        "src/server/postgres/store.integration.test.ts",
        "src/migration/import-sqlite.integration.test.ts",
        "--testTimeout",
        "60000",
        "--hookTimeout",
        "60000"
      ]
    }
  ]
}
