      "tips": [
        {
          "id": "top:Quinn:Aatrox:0",
          "text": "Use Blinding Assault on Aatrox when he walks up to trade; his vision shrinks, so he has a harder time aiming The Darkin Blade.",
          "refs": [
            { "kind": "ability", "key": "Quinn-Q", "start": 4, "end": 20 },
            { "kind": "champion", "key": "Aatrox", "start": 24, "end": 30 },
            { "kind": "ability", "key": "Aatrox-Q", "start": 109, "end": 125 }
          ],
          "pWrong": 0.6
        },
        {
          "id": "top:Quinn:Aatrox:1",
          "text": "Sidestep The Darkin Blade instead of walking back; the hit zones are telegraphed and each swing comes from where he stands.",
          "refs": [
            { "kind": "ability", "key": "Aatrox-Q", "start": 9, "end": 25 }
          ],
          "pWrong": 0.78
        },
        {
          "id": "top:Quinn:Aatrox:2",
          "text": "Trade with Vault, then attack right away; you hop back out and he is slowed, so he struggles to follow.",
