{
  "name": "@shepherdjerred/ops-clients",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun build ./src/http.ts ./src/prometheus.ts ./src/graphql.ts ./src/kubernetes.ts ./src/alertmanager.ts ./src/bugsink.ts ./src/github.ts ./src/renovate.ts ./src/linear.ts ./src/posthog.ts ./src/loki.ts ./src/buildkite.ts --target bun --outdir dist",
    "lint": "bunx --no-install eslint --cache .",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run",
    "test:ci": "bun ../../scripts/ci/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../scripts/ci/run-ci-test.ts",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit"
  },
  "devDependencies": {
    "@shepherdjerred/eslint-config": "workspace:*",
    "@tsconfig/node-lts": "^24.0.1",
    "@tsconfig/recommended": "^1.0.13",
    "@tsconfig/strictest": "^2.0.8",
    "@types/bun": "^1.3.14",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "vitest": "5.0.1",
    "@vitest/coverage-istanbul": "5.0.1"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "exports": {
    "./*": "./src/*"
  }
}
