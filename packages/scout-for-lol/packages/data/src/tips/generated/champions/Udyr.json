  "general": [
    {
      "lane": "jungle",
      "inputHash": "ba18ffc4c14fd5ae8f788159e87f084069df9b815e4ad088920a7469ac4ec777",
      "tips": [
        {
          "id": "jungle:Udyr:general:0",
          "text": "Start fights with Blazing Stampede: your next attack dashes onto the target and stuns them, so use it to catch runners or to open a gank.",
          "refs": [
            { "kind": "ability", "key": "Udyr-E", "start": 18, "end": 34 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "jungle:Udyr:general:1",
          "text": "Use Iron Mantle when you take a lot of damage, such as after a camp or in a skirmish; it gives a shield and your next attacks heal you.",
          "refs": [
            { "kind": "ability", "key": "Udyr-W", "start": 4, "end": 15 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "jungle:Udyr:general:2",
          "text": "Cast Wilding Claw before you attack. It gives Attack Speed, and your next two attacks reach farther and deal extra damage based on the target's max Health.",
          "refs": [
            { "kind": "ability", "key": "Udyr-Q", "start": 5, "end": 17 }
          ],
          "pWrong": 0.17
        },
        {
          "id": "jungle:Udyr:general:3",
          "text": "Use Wingborne Storm when you are surrounded. It damages and slows everyone close to you, so stay inside it while you fight.",
          "refs": [
            { "kind": "ability", "key": "Udyr-R", "start": 4, "end": 19 },
            { "kind": "keyword", "key": "slowed", "start": 60, "end": 65 }
          ],
          "pWrong": 0.1
        },
        {
          "id": "jungle:Udyr:general:4",
          "text": "Cast an ability a second time to Awaken it. This is strong but then goes on a long cooldown, so save it for the moment that matters.",
          "refs": [],
          "pWrong": 0.22
        },
        {
          "id": "jungle:Udyr:general:5",
          "text": "Swap between abilities often. Each cast gives bonus Attack Speed on your next two attacks and speeds up your Awaken cooldown.",
          "refs": [],
          "pWrong": 0.11
        },
        {
          "id": "jungle:Udyr:general:6",
          "text": "Awakened Blazing Stampede makes you immune to crowd control for a short time. Cast it to dive through enemy stuns or slows.",
          "refs": [
            { "kind": "ability", "key": "Udyr-E", "start": 9, "end": 25 }
          ],
          "pWrong": 0.14
        },
        {
          "id": "jungle:Udyr:general:7",
          "text": "Awakened Wingborne Storm moves on its own and follows the last enemy you hit, so attack your target first, then step back and let it keep hurting them.",
          "refs": [
            { "kind": "ability", "key": "Udyr-R", "start": 9, "end": 24 }
          ],
          "pWrong": 0.1
        }
      ],
      "combos": []
    }
  ],
