            { "kind": "champion", "key": "Sylas", "start": 32, "end": 37 },
            { "kind": "ability", "key": "Sylas-Q", "start": 58, "end": 68 },
            { "kind": "keyword", "key": "knocked-up", "start": 84, "end": 92 }
          ],
          "pWrong": 0.99
        },
        {
          "id": "middle:Katarina:Sylas:1",
          "text": "Save Death Lotus until Sylas has used Kingslayer. It is a long channel, and he can heal back a lot if he is low when he lunges.",
          "refs": [
            { "kind": "ability", "key": "Katarina-R", "start": 5, "end": 16 },
            { "kind": "champion", "key": "Sylas", "start": 23, "end": 28 },
            { "kind": "ability", "key": "Sylas-W", "start": 38, "end": 48 }
          ],
          "pWrong": 1
        },
        {
          "id": "middle:Katarina:Sylas:2",
          "text": "Death Lotus applies Grievous Wounds, so use it when Sylas is trying to heal with Kingslayer to cut the healing.",
          "refs": [
            { "kind": "ability", "key": "Katarina-R", "start": 0, "end": 11 },
            { "kind": "champion", "key": "Sylas", "start": 52, "end": 57 },
            { "kind": "ability", "key": "Sylas-W", "start": 81, "end": 91 }
          ],
          "pWrong": 0.19
        },
        {
          "id": "middle:Katarina:Sylas:3",
          "text": "Sylas can steal Death Lotus with Hijack, so expect it back at you. Move away or burst him before he can use it.",
          "refs": [
            { "kind": "champion", "key": "Sylas", "start": 0, "end": 5 },
            { "kind": "ability", "key": "Katarina-R", "start": 16, "end": 27 },
            { "kind": "ability", "key": "Sylas-R", "start": 33, "end": 39 }
          ],
          "pWrong": 0.14
        },
        {
          "id": "middle:Katarina:Sylas:4",
          "text": "Stay out of a straight line with Sylas. Use Preparation to speed away from Abduct, since a dodged chain leaves him out of position.",
          "refs": [
            { "kind": "champion", "key": "Sylas", "start": 33, "end": 38 },
            { "kind": "ability", "key": "Katarina-W", "start": 44, "end": 55 }
          ],
          "pWrong": 0.77
        }
      ],
      "opponent": "Sylas",
      "comboRefs": []
    },
    {
