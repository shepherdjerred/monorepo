      "tips": [
        {
          "id": "middle:Azir:general:0",
          "text": "Put Sand Soldiers between the enemy minions and the enemy champion to last-hit and threaten at once, using Arise!",
          "refs": [
            { "kind": "ability", "key": "Azir-W", "start": 107, "end": 113 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "middle:Azir:general:1",
          "text": "Keep one stored Sand Soldier for an escape with Shifting Sands or fast damage. Don't place both with Arise!",
          "refs": [
            { "kind": "ability", "key": "Azir-E", "start": 48, "end": 62 },
            { "kind": "ability", "key": "Azir-W", "start": 101, "end": 107 }
          ],
          "pWrong": 0.07
        },
        {
          "id": "middle:Azir:general:2",
          "text": "Attack the enemy champion when they are near your soldiers. Your attack makes the soldiers stab for you, so you can hit from farther away.",
          "refs": [],
          "pWrong": 0.26
        },
        {
          "id": "middle:Azir:general:3",
          "text": "Send your soldiers with Conquering Sands to slow the enemy when they step back or try to engage. Enemies hit by later soldiers take no extra damage.",
          "refs": [
            { "kind": "ability", "key": "Azir-Q", "start": 24, "end": 40 },
            { "kind": "keyword", "key": "slowed", "start": 44, "end": 48 }
          ],
          "pWrong": 0.1
        },
        {
          "id": "middle:Azir:general:4",
          "text": "Shifting Sands needs a Sand Soldier to dash to. Have one down before you cast it, and it shields you as you go.",
          "refs": [
            { "kind": "ability", "key": "Azir-E", "start": 0, "end": 14 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "middle:Azir:general:5",
          "text": "Use Emperor's Divide defensively when enemies dive you or your team. Your allies can walk through the wall, but enemies can't.",
          "refs": [
            { "kind": "ability", "key": "Azir-R", "start": 4, "end": 20 }
          ],
          "pWrong": 0.26
        },
        {
          "id": "middle:Azir:general:6",
          "text": "Fight near your own soldiers and away from enemy turrets. Soldiers expire faster under an enemy turret.",
          "refs": [],
          "pWrong": 0.37
        },
        {
          "id": "middle:Azir:general:7",
          "text": "After a turret falls, use its ruins to build a Disc of the Sun with Shurima's Legacy. It acts as a turret for you.",
          "refs": [
            { "kind": "ability", "key": "Azir-passive", "start": 68, "end": 84 }
          ],
          "pWrong": 0.1
        }
      ],
      "combos": [
        {
          "id": "middle:Azir:combo:0",
          "name": "Shurima Shuffle",
          "category": "trick",
          "sequence": [
            { "kind": "ability", "key": "Azir-E" },
            { "kind": "ability", "key": "Azir-Q" }
          ],
          "when": "When you need a longer dash to chase, engage or escape, with a soldier out and both spells ready.",
          "whenRefs": [],
          "text": "Cast the dash to a soldier, then right away send the soldiers out with the Q. Azir follows the moving soldier, so the dash carries much further than normal.",
          "textRefs": [
            { "kind": "champion", "key": "Azir", "start": 78, "end": 82 }
          ]
        },
        {
          "id": "middle:Azir:combo:1",
          "name": "Shuffle into wall",
          "category": "combo",
          "sequence": [
            { "kind": "ability", "key": "Azir-E" },
            { "kind": "ability", "key": "Azir-Q" },
            { "kind": "ability", "key": "Azir-R" }
          ],
          "when": "When you want to engage on a squishy target or force a fight, and your team can follow up.",
          "whenRefs": [],
          "text": "Start the shuffle, then cast the ultimate during the dash. Azir can cast during the dash, so the wall lands on the enemies as he arrives.",
          "textRefs": [
            { "kind": "champion", "key": "Azir", "start": 59, "end": 63 }
          ]
        },
        {
          "id": "middle:Azir:combo:2",
          "name": "Soldier wall hop",
          "category": "terrain",
          "sequence": [
            { "kind": "ability", "key": "Azir-W" },
            { "kind": "ability", "key": "Azir-E" }
          ],
          "when": "When escaping or repositioning over a thin wall, such as in the jungle or the river.",
          "whenRefs": [],
          "text": "Drop a soldier on the far side of the wall, then dash to it. Keep a soldier in reserve so you always have this escape.",
          "textRefs": []
        }
      ]
    }
  ],
