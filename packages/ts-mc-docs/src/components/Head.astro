---
import { productionForumActive } from "../forum-release.ts";
const { head } = Astro.locals.starlightRoute;
const path = Astro.url.pathname;
if (!Astro.site) throw new Error("Missing docs site URL");
const image = productionForumActive
  ? `https://ts-mc.net/storm-theme/card?surface=docs&path=${encodeURIComponent(path)}`
  : new URL("/storm-card.png", Astro.site).href;
---

{head
  .filter(({ attrs }) => attrs?.["property"] !== "og:image")
  .map(({ tag: Tag, attrs, content }) => (
    <Tag {...attrs} set:html={content} />
  ))}
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:image" content={image} />
