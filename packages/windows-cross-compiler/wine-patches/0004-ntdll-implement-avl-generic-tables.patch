 /***********************************************************************
  *           RtlInsertElementGenericTableAvl  (NTDLL.@)
  */
-void WINAPI RtlInsertElementGenericTableAvl(PRTL_AVL_TABLE table, void *buffer, ULONG size, BOOL *element)
+void * WINAPI RtlInsertElementGenericTableAvl(PRTL_AVL_TABLE table, void *buffer, ULONG size, BOOLEAN *new_element)
 {
-    FIXME("%p %p %lu %p: stub\n", table, buffer, size, element);
+    RTL_BALANCED_LINKS *parent, *node;
+    RTL_GENERIC_COMPARE_RESULTS result;
+
+    TRACE("%p %p %lu %p\n", table, buffer, size, new_element);
+
+    if ((node = avl_find( table, buffer, &parent, &result )))
+    {
+        if (new_element) *new_element = FALSE;
+        return avl_node_data( node );
+    }
+
+    if (!(node = table->AllocateRoutine( table, sizeof(*node) + size ))) return NULL;
+    memset( node, 0, sizeof(*node) );
+    memcpy( avl_node_data( node ), buffer, size );
+    node->Parent = parent;
+    if (parent == &table->BalancedRoot || result != GenericLessThan) parent->RightChild = node;
+    else parent->LeftChild = node;
+
+    table->NumberGenericTableElements++;
+    table->WhichOrderedElement = 0;
+    table->OrderedPointer = NULL;
+    if (new_element) *new_element = TRUE;
+    return avl_node_data( node );
 }
 
