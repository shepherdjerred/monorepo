# Generated by packages/dotfiles/scripts/agent-policy.ts from
# packages/dotfiles/agent-policy/denied-commands.json. Do not edit by hand.

prefix_rule(
    pattern = [["sudo", "su"]],
    decision = "forbidden",
    justification = "Agents never run privileged commands. The user runs any sudo step.",
)

prefix_rule(
    pattern = ["rm", ["-rf", "-fr", "-Rf", "-fR"], "/"],
    decision = "forbidden",
    justification = "Never force-delete the filesystem root.",
)

prefix_rule(
    pattern = ["diskutil", ["eraseDisk", "eraseVolume", "secureErase", "zeroDisk"]],
    decision = "forbidden",
    justification = "Never erase a disk or volume.",
)

prefix_rule(
    pattern = ["kubectl", "delete", ["namespace", "namespaces", "ns", "customresourcedefinition", "customresourcedefinitions", "crd", "crds"]],
    decision = "forbidden",
    justification = "Deleting a namespace or CRD cascades to every resource and volume under it. ArgoCD owns these objects.",
)

prefix_rule(
    pattern = ["talosctl", ["reset", "wipe"]],
    decision = "forbidden",
    justification = "Never reset or wipe a Talos node.",
)

prefix_rule(
    pattern = ["toolkit", "talosctl", ["reset", "wipe"]],
    decision = "forbidden",
    justification = "Never reset or wipe a Talos node.",
)

prefix_rule(
    pattern = ["argocd", "cluster", "rm"],
    decision = "forbidden",
    justification = "Never remove a cluster from Argo CD.",
)

prefix_rule(
    pattern = ["toolkit", "argocd", "cluster", "rm"],
    decision = "forbidden",
    justification = "Never remove a cluster from Argo CD.",
)

prefix_rule(
    pattern = ["argocd", "app", "sync", "--prune"],
    decision = "forbidden",
    justification = "Pruned syncs go through scripts/argocd/argocd.ts release-root, which checks prune candidates first.",
)

prefix_rule(
    pattern = ["toolkit", "argocd", "app", "sync", "--prune"],
    decision = "forbidden",
    justification = "Pruned syncs go through scripts/argocd/argocd.ts release-root, which checks prune candidates first.",
)

prefix_rule(
    pattern = ["gh", "repo", "delete"],
    decision = "forbidden",
    justification = "Never delete a GitHub repository.",
)

prefix_rule(
    pattern = ["toolkit", "gh", "repo", "delete"],
    decision = "forbidden",
    justification = "Never delete a GitHub repository.",
)

prefix_rule(
    pattern = ["op", "vault", "delete"],
    decision = "forbidden",
    justification = "Never delete a 1Password vault.",
)

prefix_rule(
    pattern = ["security", ["find-generic-password", "find-internet-password", "dump-keychain", "export"]],
    decision = "forbidden",
    justification = "Never read Keychain secrets directly. toolkit and scripts/onepassword/with-service-account.sh resolve credentials without exposing them.",
)

prefix_rule(
    pattern = ["cf", "zones", "delete"],
    decision = "forbidden",
    justification = "Deleting a Cloudflare zone takes down every record and site in it.",
)

prefix_rule(
    pattern = ["toolkit", "cf", "zones", "delete"],
    decision = "forbidden",
    justification = "Deleting a Cloudflare zone takes down every record and site in it.",
)
