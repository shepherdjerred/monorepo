---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  subtitle?: string;
}

const { id, eyebrow, title, subtitle } = Astro.props;
---

<div class="max-w-2xl">
  <p class="font-mono text-xs font-semibold uppercase tracking-widest text-sky-700 dark:text-sky-400">
    {eyebrow}
  </p>
  <h2
    id={id}
    class="mt-3 text-3xl font-semibold tracking-tight text-stone-900 sm:text-4xl dark:text-white"
  >
    {title}
  </h2>
  {subtitle && (
    <p class="mt-4 text-base leading-relaxed text-stone-600 dark:text-stone-400">
      {subtitle}
    </p>
  )}
</div>
