+// rewrittenBlobsSize is the size of the timestamp-rewritten blobs that this
+// record's blob and its compression variants retain through GC references
+// (util/converter). DiskUsage and prune add it to the record's cached size on
+// every call rather than caching it, because a later export can add a
+// rewritten blob to a record whose size was already recorded.
+func (cr *cacheRecord) rewrittenBlobsSize(ctx context.Context) int64 {
+	cr.mu.Lock()
+	dgst := cr.getBlob()
+	cr.mu.Unlock()
+	if dgst == "" {
+		return 0
+	}
+	cs := cr.cm.ContentStore
+	sources := []digest.Digest{dgst}
+	walkBlobVariantsOnly(ctx, cs, dgst, func(desc ocispecs.Descriptor) bool {
+		sources = append(sources, desc.Digest)
+		return true
+	}, nil)
+	counted := make(map[digest.Digest]struct{})
+	var total int64
+	for _, src := range sources {
+		info, err := cs.Info(ctx, src)
+		if err != nil {
+			continue
+		}
+		for _, rewritten := range converter.RewrittenBlobs(info.Labels) {
+			if _, ok := counted[rewritten]; ok {
+				continue
+			}
+			counted[rewritten] = struct{}{}
+			if rinfo, err := cs.Info(ctx, rewritten); err == nil {
+				total += rinfo.Size
+			}
+		}
+	}
+	return total
+}
