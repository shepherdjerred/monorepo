---
import { productionForumActive } from "../forum-release.ts";
import brandRevision from "../../../storm-theme/assets/brand/revision.txt?raw";
const { head } = Astro.locals.starlightRoute;
const path = Astro.url.pathname;
if (!Astro.site) throw new Error("Missing docs site URL");
const image = productionForumActive
  ? `https://ts-mc.net/storm-theme/card?surface=docs&path=${encodeURIComponent(path)}&v=${brandRevision.trim()}`
  : new URL(`/storm-card.png?v=${brandRevision.trim()}`, Astro.site).href;
---

{head
  .filter(({ attrs }) => attrs?.["property"] !== "og:image")
  .map(({ tag: Tag, attrs, content }) => (
    <Tag {...attrs} set:html={content} />
  ))}
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:image" content={image} />
<meta
  property="og:image:alt"
  content="The Storm wordmark over its archived spawn, with the page title."
/>
<link rel="alternate icon" href="/favicon.ico" sizes="16x16 32x32" />
<link
  rel="icon"
  type="image/png"
  sizes="48x48"
  href="/storm/brand/favicon-48.png"
/>
<link rel="apple-touch-icon" sizes="180x180" href="/storm/brand/icon-180.png" />
<link rel="manifest" href="/storm/brand/site.webmanifest" />
