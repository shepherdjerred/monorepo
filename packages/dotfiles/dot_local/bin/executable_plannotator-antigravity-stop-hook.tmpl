#!/bin/sh
set -eu

# Antigravity's Stop event carries no direct last-message-text field (unlike
# grok's `lastAssistantMessage`), so read `transcriptPath` from the hook event
# and extract the last assistant turn ourselves. Verified against real
# transcript.jsonl files on this machine: source=="MODEL" && type=="PLANNER_RESPONSE"
# is the agent's rendered chat text; source=="MODEL" && type=="GENERIC" is
# tool/background-task log noise.

event="$(cat)"
termination_reason="$(printf '%s' "$event" | jq -r '.terminationReason // empty')"

# Only review genuine completions; error/max-steps terminations pass through
# untouched, matching grok's `reason == "end_turn"` gate.
if [ "$termination_reason" != "model_stop" ]; then
  printf '{}\n'
  exit 0
fi

transcript_path="$(printf '%s' "$event" | jq -r '.transcriptPath // empty')"
if [ -z "$transcript_path" ] || [ ! -f "$transcript_path" ]; then
  echo "plannotator-antigravity-stop-hook: no readable transcriptPath for a model_stop event" >&2
  exit 1
fi

last_message="$(jq -rs '[.[] | select(.source == "MODEL" and .type == "PLANNER_RESPONSE")] | last | .content // empty' "$transcript_path")"
if [ -z "$last_message" ]; then
  echo "plannotator-antigravity-stop-hook: no PLANNER_RESPONSE entries in $transcript_path" >&2
  exit 1
fi

outcome="$(printf '%s' "$last_message" | {{ .chezmoi.homeDir }}/.local/bin/plannotator annotate-last --stdin --gate --hook)"
if [ -z "$outcome" ]; then
  printf '{}\n'
  exit 0
fi

# Antigravity's Stop contract is inverted vs. grok/Claude: "continue" blocks
# the stop (not "block"). Rename the value, keep reason unchanged.
printf '%s\n' "$outcome" | jq -c '.decision = "continue"'
