{
  "name": "@shepherdjerred/tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./contract": "./src/shared/contract.ts"
  },
  "imports": {
    "#generated/*": "./generated/*",
    "#*": "./src/*"
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "vite build",
    "start": "bun src/server/index.ts",
    "dev": "bun src/dev.ts",
    "migrate:deploy": "prisma migrate deploy",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "lint": "eslint . --max-warnings=0 && check-architecture",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run src",
    "test:ci": "bun ../../scripts/ci/run-ci-test.ts",
    "test:e2e": "bun --no-install --bun playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/client-runtime-utils": "7.10.0",
    "@shepherdjerred/config": "workspace:*",
    "@shepherdjerred/feature-flags": "workspace:*",
    "@tanstack/react-query": "^5.101.2",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "hono": "^4.12.18",
    "lucide-react": "^1.14.0",
    "prisma": "^7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@sentry/bun": "11.6.0",
    "@shepherdjerred/sentry-config": "workspace:*"
  },
  "devDependencies": {
    "@shepherdjerred/architecture": "workspace:*",
    "@shepherdjerred/eslint-config": "workspace:*",
    "@tailwindcss/vite": "^4.2.4",
    "@types/bun": "1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@playwright/test": "1.64.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "5.0.3",
    "@vitest/coverage-istanbul": "5.0.3"
  }
}
