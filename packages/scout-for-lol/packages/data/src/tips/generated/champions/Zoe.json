          "sequence": [{ "kind": "ability", "key": "Zoe-E" }],
          "when": "Setting up a long-range sleep from a bush or hidden spot near a wall.",
          "whenRefs": [],
          "text": "The bubble flies much further when it crosses a wall. Stand in fog of war, kick it over the wall and catch an enemy who can't see you.",
          "textRefs": []
        },
        {
          "id": "middle:Zoe:combo:2",
          "name": "Portal bubble",
          "category": "trick",
          "sequence": [
            { "kind": "ability", "key": "Zoe-R" },
