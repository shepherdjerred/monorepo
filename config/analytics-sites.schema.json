{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["trackerOrigin", "sites"],
  "additionalProperties": false,
  "properties": {
    "trackerOrigin": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://matomo\\.sjer\\.red$"
    },
    "sites": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["hostname", "siteId"],
        "additionalProperties": false,
        "properties": {
          "hostname": { "type": "string", "minLength": 1 },
          "siteId": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
