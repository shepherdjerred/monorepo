{
  "id": "prometheus/prod/1",
  "definition": {
    "kind": "compound",
    "subRecipes": [
      {
        "instance": "application:prometheus-companion",
        "pointOfNoReturn": false,
        "definition": {
          "kind": "kubernetes-application",
          "application": {
            "name": "prometheus-companion",
            "metadata": {
              "labels": { "ci.sjer.red/managed-application": "true" },
              "annotations": {
                "argocd.argoproj.io/sync-options": "Prune=false",
                "ci.sjer.red/application-lifecycle": "retain"
              },
              "finalizers": []
            },
            "project": "workloads",
            "destination": {
              "server": "https://kubernetes.default.svc",
              "namespace": "prometheus"
            },
            "source": {
              "repoURL": "https://chartmuseum.tailnet-1a49.ts.net",
              "chart": "prometheus-companion"
            },
            "syncOptions": [
              "CreateNamespace=true",
              "ServerSideApply=true",
              "RespectIgnoreDifferences=true"
            ],
            "ignoreDifferences": [
              {
                "group": "networking.cfargotunnel.com",
                "kind": "TunnelBinding",
                "jqPathExpressions": [
                  ".subjects[].kind",
                  ".subjects[].spec.http2Origin",
                  ".subjects[].spec.noTlsVerify",
                  ".subjects[].spec.proxyAddress",
                  ".subjects[].spec.proxyPort",
                  ".subjects[].spec.proxyType",
                  ".tunnelRef.disableDNSUpdates"
                ]
              }
            ],
            "revisionHistoryLimit": 5,
            "lifecycle": "retain"
          },
          "chartComponent": "chart:prometheus-companion",
          "artifactParameters": {},
          "runner": { "service": "ci", "component": "image:ci-base" },
          "steps": [
            {
              "kind": "apply-safety",
              "instance": "application:prometheus-companion",
              "pointOfNoReturn": false
            },
            {
              "kind": "sync",
              "instance": "application:prometheus-companion",
              "pointOfNoReturn": false
            }
          ],
          "oracle": { "probes": [], "tests": [] }
        }
      },
      {
        "instance": "application:prometheus",
        "pointOfNoReturn": false,
        "definition": {
          "kind": "kubernetes-application",
          "application": {
            "name": "prometheus",
            "metadata": {
              "labels": { "ci.sjer.red/managed-application": "true" },
              "annotations": {
                "argocd.argoproj.io/sync-options": "Prune=false",
                "ci.sjer.red/application-lifecycle": "retain"
              },
              "finalizers": []
            },
            "project": "cluster",
            "destination": {
              "server": "https://kubernetes.default.svc",
              "namespace": "prometheus"
            },
            "source": {
              "repoURL": "https://prometheus-community.github.io/helm-charts",
              "chart": "kube-prometheus-stack"
            },
            "syncOptions": ["CreateNamespace=true", "ServerSideApply=true"],
            "ignoreDifferences": [
              {
                "group": "",
                "kind": "Secret",
                "name": "prometheus-grafana",
                "namespace": "prometheus",
                "jsonPointers": ["/data/admin-password"]
              },
              {
                "group": "apps",
                "kind": "StatefulSet",
                "name": "prometheus-grafana",
                "namespace": "prometheus",
                "jsonPointers": [
                  "/spec/template/metadata/annotations/checksum~1secret"
                ]
              }
            ],
            "revisionHistoryLimit": 5,
            "lifecycle": "retain"
          },
          "chartComponent": "chart:kube-prometheus-stack",
          "artifactParameters": {
            "alertmanager.alertmanagerSpec.containers[0].image": {
              "component": "image:caddy-s3proxy",
              "format": "reference"
            },
            "grafana.imageRenderer.image.tag": {
              "component": "image:grafana-image-renderer",
              "format": "tag-digest"
            },
            "prometheus.prometheusSpec.containers[1].image": {
              "component": "image:caddy-s3proxy",
              "format": "reference"
            }
          },
          "runner": { "service": "ci", "component": "image:ci-base" },
          "steps": [
            {
              "kind": "apply-safety",
              "instance": "application:prometheus",
              "pointOfNoReturn": false
            },
            {
              "kind": "sync",
              "instance": "application:prometheus",
              "pointOfNoReturn": false
            }
          ],
          "oracle": { "probes": [], "tests": [] }
        }
      }
    ]
  }
}
