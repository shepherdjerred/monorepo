---
import "../../styles/global.css";
import SeoHead from "#src/components/SeoHead.astro";
import { SharedNavbar } from "#src/components/shared-navbar.tsx";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SeoHead
      title={title}
      description="Review Generator Development Tool"
      noindex
    />
    <script is:inline src="/assets/scout/brand/theme-bootstrap.js"></script>
  </head>
  <body>
    <SharedNavbar currentPath="/dev/review-tool" client:load />
    <slot />
  </body>
</html>
