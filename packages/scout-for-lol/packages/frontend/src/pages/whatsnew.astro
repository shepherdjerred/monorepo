---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import CTA from "../components/CTA.astro";
import {
  changelog,
  formatChangelogDate,
  renderChangelogToHtml,
} from "../data/changelog";
import {
  APP_DASHBOARD_URL,
  DOCS_URL,
  GET_STARTED_CLICK_EVENT,
} from "#src/lib/marketing-constants.ts";
---

<Layout
  title="What's New · Scout for LoL"
  description="The latest updates, features, and improvements to Scout for League of Legends."
>
  <div class="bg-scout-surface ">
    <Navbar activePage="whatsnew" />

    <Hero
      title="What's New"
      subtitle="Check out the latest updates and improvements to Scout for League of Legends."
      showGradient={true}
    />

    <!-- Changelog Section -->
    <div class="py-24 sm:py-32">
      <div class="mx-auto max-w-3xl px-6 lg:px-8">
        <div class="space-y-12">
          {
            changelog.map((entry, index) => (
              <div
                class:list={[
                  "pb-12",
                  index !== changelog.length - 1 &&
                    "border-b border-scout-border",
                ]}
              >
                {/* Date Header */}
                <div class="mb-6">
                  <div class="flex items-center gap-x-3">
                    <div class="h-3 w-3 rounded-full bg-scout-brand " />
                    <h2 class="text-2xl font-semibold text-scout-ink ">
                      {formatChangelogDate(entry)}
                    </h2>
                  </div>
                </div>

                {/* Changes List */}
                <div
                  class="text-scout-subtle prose pl-6 space-y-6"
                  set:html={renderChangelogToHtml(entry.text)}
                />
              </div>
            ))
          }
        </div>

        {
          changelog.length === 0 && (
            <div class="text-center py-12">
              <p class="text-scout-subtle ">
                No changelog entries found. Check back soon!
              </p>
            </div>
          )
        }
      </div>
    </div>

    <!-- CTA Section -->
    <CTA
      variant="indigo"
      title="Ready to get Scout?"
      description="Sign in, add Scout to your server, and start tracking your friends' League matches from the dashboard today."
      buttons={[
        {
          text: "Get Started",
          href: APP_DASHBOARD_URL,
          variant: "primary",
          trackingEvent: GET_STARTED_CLICK_EVENT,
          trackingLocation: "whatsnew",
        },
        { text: "Read the docs", href: DOCS_URL, variant: "secondary" },
      ]}
    />

    <Footer variant="homepage" />
  </div>
</Layout>
