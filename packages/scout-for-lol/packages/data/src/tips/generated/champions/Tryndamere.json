      "tips": [
        {
          "id": "top:Tryndamere:general:0",
          "text": "Use Spinning Slash to close the gap on a fleeing enemy or to dash away after a trade. It has no minimum range, so you can use it at point-blank range too.",
          "refs": [
            { "kind": "ability", "key": "Tryndamere-E", "start": 4, "end": 18 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "top:Tryndamere:general:1",
          "text": "Land critical strikes on champions to bring Spinning Slash back sooner, so you can chain dashes in a long fight.",
          "refs": [
            { "kind": "ability", "key": "Tryndamere-E", "start": 44, "end": 58 }
          ],
          "pWrong": 0.04
        },
        {
          "id": "top:Tryndamere:general:2",
          "text": "Cast Mocking Shout when an enemy fighter starts hitting you. It cuts their Attack Damage, and it slows them if they are facing away, so use it to chase.",
          "refs": [
            { "kind": "ability", "key": "Tryndamere-W", "start": 5, "end": 18 },
            { "kind": "keyword", "key": "slowed", "start": 97, "end": 102 }
          ],
          "pWrong": 0.81
        },
        {
          "id": "top:Tryndamere:general:3",
          "text": "Spend your Fury with Bloodlust when you are hurt, not when you are at full health. The heal grows with the Fury you have stored.",
          "refs": [
            { "kind": "ability", "key": "Tryndamere-Q", "start": 21, "end": 30 }
          ],
          "pWrong": 0.08
        },
        {
          "id": "top:Tryndamere:general:4",
          "text": "Keep hitting minions and enemies so your Fury stays up. It starts to fade after a while without dealing or taking damage.",
          "refs": [],
          "pWrong": 0.05
        },
        {
          "id": "top:Tryndamere:general:5",
          "text": "Hold Undying Rage until you are nearly dead. Enemies who chase you will overcommit, and you can still fight on at low health.",
          "refs": [
            { "kind": "ability", "key": "Tryndamere-R", "start": 5, "end": 17 }
          ],
          "pWrong": 0.14
        },
        {
          "id": "top:Tryndamere:general:6",
          "text": "Do not cast Mocking Shout just before you need Undying Rage. Mocking Shout stops you from using it while it casts.",
          "refs": [
            {
              "kind": "ability",
              "key": "Tryndamere-W",
              "start": 12,
              "end": 25
            },
            {
              "kind": "ability",
              "key": "Tryndamere-R",
              "start": 47,
              "end": 59
            },
            { "kind": "ability", "key": "Tryndamere-W", "start": 61, "end": 74 }
          ],
          "pWrong": 0.02
        }
      ],
      "combos": [
        {
          "id": "top:Tryndamere:combo:0",
          "name": "Bloodlust during attack windup",
