{
  "id": "syncthing/prod/1",
  "definition": {
    "kind": "kubernetes-application",
    "application": {
      "name": "syncthing",
      "metadata": {
        "labels": { "ci.sjer.red/managed-application": "true" },
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=false",
          "ci.sjer.red/application-lifecycle": "retain"
        },
        "finalizers": []
      },
      "project": "workloads",
      "destination": {
        "server": "https://kubernetes.default.svc",
        "namespace": "syncthing"
      },
      "source": {
        "repoURL": "https://chartmuseum.tailnet-1a49.ts.net",
        "chart": "syncthing"
      },
      "syncOptions": [],
      "ignoreDifferences": [],
      "revisionHistoryLimit": 5,
      "lifecycle": "retain"
    },
    "chartComponent": "chart:syncthing",
    "artifactParameters": {},
    "runner": { "service": "ci", "component": "image:ci-base" },
    "steps": [
      {
        "kind": "apply-safety",
        "instance": "application:syncthing",
        "pointOfNoReturn": false
      },
      {
        "kind": "sync",
        "instance": "application:syncthing",
        "pointOfNoReturn": false
      }
    ],
    "oracle": { "probes": [], "tests": [] }
  }
}
