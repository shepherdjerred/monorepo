{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

# All pinchtab CLI calls below must target the same config the daemon reads
# (its launchd plist pins PINCHTAB_CONFIG here). Without this export, the
# `config set` calls write to ~/.pinchtab/config.json and the daemon never
# sees them — which is exactly how the two configs drifted apart.
export PINCHTAB_CONFIG="$HOME/Library/Application Support/pinchtab/config.json"

pinchtab daemon install

# Use a dedicated, signed automation browser rather than the daily Chrome app.
# PinchTab's macOS discovery prefers Canary when Chrome for Testing or Chromium
# are unavailable, avoiding the primary-Chrome single-instance conflict.
pinchtab config set browser.binary \
  '/Applications/Google Chrome Canary.app/Contents/MacOS/Google Chrome Canary'

# Broad browsing and page evaluation are intentional on this trusted Mac.
# Merge only the policy: preserve the daemon's token, profiles, and state.
# Website access includes local/LAN/tailnet hosts; task authorization still
# governs which sites an agent uses and which account actions it performs.
pinchtab config patch '{
  "server": { "bind": "127.0.0.1" },
  "security": {
    "allowedDomains": ["*"],
    "allowEvaluate": true,
    "allowCookies": false,
    "allowDownload": false,
    "allowUpload": false,
    "allowClipboard": false,
    "allowMacro": false,
    "allowScreencast": false,
    "allowStateExport": false,
    "allowNetworkIntercept": false,
    "allowFileScheme": false,
    "trustedResolveCIDRs": [],
    "trustedProxyCIDRs": [],
    "attach": { "enabled": false, "forwardProxyAuth": false },
    "idpi": {
      "enabled": true,
      "strictMode": true,
      "scanContent": true,
      "wrapContent": true
    }
  }
}'
pinchtab config validate

# Full stealth for sites with bot detection (e.g. X, Reddit)
pinchtab config set instanceDefaults.stealthLevel full

# Install uBlock Origin extension
STATE_DIR="$HOME/Library/Application Support/pinchtab"
EXT_DIR="$STATE_DIR/extensions/ublock-origin"
if [ ! -d "$EXT_DIR/uBlock0.chromium" ]; then
  mkdir -p "$EXT_DIR"
  tmp="$(mktemp -d)"
  gh release download 1.70.0 --repo gorhill/uBlock --pattern "*.chromium.zip" --dir "$tmp"
  unzip -q "$tmp"/*.chromium.zip -d "$EXT_DIR"
  rm -rf "$tmp"
fi

# Set extension path directly in config JSON (config set doesn't support this field)
python3 -c "
import json, os
config_path = os.path.expanduser('~/Library/Application Support/pinchtab/config.json')
with open(config_path) as f:
    config = json.load(f)
ext_path = os.path.expanduser('~/Library/Application Support/pinchtab/extensions/ublock-origin/uBlock0.chromium')
if ext_path not in config.get('browser', {}).get('extensionPaths', []):
    config.setdefault('browser', {})['extensionPaths'] = [ext_path]
    with open(config_path, 'w') as f:
        json.dump(config, f, indent=2)
"

pinchtab daemon restart
{{- end -}}
