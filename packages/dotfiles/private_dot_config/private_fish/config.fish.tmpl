if status is-interactive
  # Keep provider API keys available to ordinary tools, but coding-agent
  # wrappers explicitly remove direct API credentials. Claude and Codex
  # therefore use their subscription/auth-file flows; OpenCode uses its
  # configured provider. These wrappers are intentionally interactive-only;
  # launches that bypass fish (Raycast, scripts) must scrub their environment
  # explicitly.
  function claude --wraps claude -d "Run Claude Code without direct provider API keys"
      env -u ANTHROPIC_API_KEY -u OPENAI_API_KEY -u CODEX_API_KEY \
          (command -s claude) --allow-dangerously-skip-permissions $argv
  end
  function codex --wraps codex -d "Run Codex without direct provider API keys"
      env -u OPENAI_API_KEY -u CODEX_API_KEY -u ANTHROPIC_API_KEY \
          (command -s codex) $argv
  end
  function opencode --wraps opencode
      env -u ANTHROPIC_API_KEY -u OPENAI_API_KEY -u CODEX_API_KEY \
          EDITOR=true VISUAL=true GIT_EDITOR=true PAGER=cat GIT_PAGER=cat \
          GIT_CONFIG_GLOBAL="$HOME/.config/agent/gitconfig" \
          (command -s opencode) --auto $argv
  end
  fish_vi_key_bindings

  starship init fish | source
  atuin init fish | source

  set -q CARAPACE_BRIDGES; or set -Ux CARAPACE_BRIDGES 'zsh,fish,bash,inshellisense'
  mkdir -p ~/.config/fish/completions
  # Run the following block only once a day
  if test (find ~/.config/fish/completions -name '*.fish' -mtime -1 | wc -l) -eq 0
      echo "running carapace..."
      carapace --list | awk '{print $1}' | xargs -I{} touch ~/.config/fish/completions/{}.fish # disable auto-loaded completions (#185)
  end
  # Lazy-load carapace on first tab completion
  function _carapace_lazy --on-event fish_complete
      functions -e _carapace_lazy  # remove this bootstrap function
      carapace _carapace | source
  end
end

