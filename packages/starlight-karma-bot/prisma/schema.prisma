generator client {
  provider = "prisma-client-js"
  // Stable in-repo output (gitignored) so codegen lands deterministically in a
  // bun workspace — matches the birmel and scout-for-lol backend pattern.
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "sqlite"
}

// A Discord user who has given or received karma. Rows are created on demand
// the first time a user appears on either side of a karma event.
model Person {
  id              String           @id
  given           Karma[]          @relation("KarmaGiver")
  received        Karma[]          @relation("KarmaReceiver")
  milestoneStates MilestoneState[]

  @@map("person")
}

// One karma event: `giver` awarded `amount` to `receiver` in `guildId`.
//
// `amount` is a signed integer, not a flag: self-gives store a negative
// penalty, and the 2023 rows imported from the predecessor bot carry
// pre-aggregated balances up to +42. Every read sums this column.
//
// The legacy TypeORM schema left `guildId`, `giverId`, and `receiverId`
// nullable. The import in `scripts/import-legacy.ts` asserts zero nulls across
// all three before writing, so they are required here.
model Karma {
  id         Int      @id @default(autoincrement())
  amount     Int
  datetime   DateTime
  reason     String?
  guildId    String
  receiverId String
  giverId    String

  /// Set when this karma came from reacting to a message, so the reaction can
  /// be undone and the award can link back to what earned it. Null for slash
  /// command and context-menu gives.
  sourceMessageId String?

  receiver Person @relation("KarmaReceiver", fields: [receiverId], references: [id])
  giver    Person @relation("KarmaGiver", fields: [giverId], references: [id])

  // One reaction award per giver per message: removing and re-adding a
  // reaction must not stack. SQL treats NULLs as distinct, so this does not
  // constrain the (far more common) non-reaction gives.
  @@unique([giverId, sourceMessageId])
  @@index([guildId, receiverId])
  @@index([guildId, giverId])
  // Supports the time-scoped leaderboards.
  @@index([guildId, datetime])
  @@map("karma")
}

/// The highest karma milestone announced for one person in one guild.
///
/// Karma can move downward through undo, reaction removal, and self-give
/// penalties. Keeping this high-water mark separate from the current balance
/// prevents the same milestone from being announced again after a downward
/// crossing.
model MilestoneState {
  guildId          String
  receiverId       String
  highestAnnounced Int

  receiver Person @relation(fields: [receiverId], references: [id])

  @@id([guildId, receiverId])
  @@map("milestone_state")
}

/// Per-guild settings for the scheduled recap. Absent rows mean "not
/// configured" — the dispatcher only ever considers rows that are both enabled
/// and have a channel.
model GuildConfig {
  guildId        String    @id
  recapChannelId String?
  /// CRON expression evaluated in UTC. Default: Fridays at 17:00 UTC.
  recapCron      String    @default("0 17 * * 5")
  /// When the dispatcher should next post. Null is a self-heal path: a row
  /// that never had a time computed is treated as due.
  nextRecapAt    DateTime?
  lastRecapAt    DateTime?
  enabled        Boolean   @default(false)

  @@index([enabled, nextRecapAt])
  @@map("guild_config")
}
