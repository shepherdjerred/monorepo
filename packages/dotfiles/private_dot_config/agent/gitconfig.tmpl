# Agent gitconfig — pointed at by GIT_CONFIG_GLOBAL in AI-agent sessions
# (agent-exec wrappers, Claude Code managed-settings.json, and Codex
# config.toml).
#
# Curated subset of ~/.gitconfig (private_dot_gitconfig.tmpl) that shares the
# normal GitHub identity and ~/.config/gh credentials, git-spice settings, and
# fetch/push/pull behavior while dropping interactive customizations that
# confuse agents: delta pager, difftastic external diff, column UI, aliases,
# and sort-order overrides. Note git cannot UNSET a key via env-based config
# (GIT_CONFIG_KEY_n/GIT_CONFIG_VALUE_n), which is why this file exists: an
# empty diff.external is an error, not an unset.
[user]
	name = Jerred Shepherd
	email = github@sjer.red

[core]
	pager = cat
	excludesFile = ~/.gitignore
	autocrlf = false
	eol = lf
	fsmonitor = true
	untrackedCache = true

[credential "https://github.com"]
	helper =
{{- if eq .chezmoi.os "darwin" }}
	helper = !/opt/homebrew/bin/gh auth git-credential
{{- else }}
	helper = !/home/linuxbrew/.linuxbrew/bin/gh auth git-credential
{{- end }}
[credential "https://gist.github.com"]
	helper =
{{- if eq .chezmoi.os "darwin" }}
	helper = !/opt/homebrew/bin/gh auth git-credential
{{- else }}
	helper = !/home/linuxbrew/.linuxbrew/bin/gh auth git-credential
{{- end }}

[http]
	postBuffer = 524288000

[push]
	autoSetupRemote = true
	default = simple
	followTags = true
[pull]
	rebase = true
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
[fetch]
	prune = true
	pruneTags = true
	all = true
[init]
	defaultBranch = main
[merge]
	conflictstyle = zdiff3
[diff]
	algorithm = histogram
	renames = true
[rerere]
	enabled = true
	autoupdate = true

# git-spice stacked-branch workflow (mirrors ~/.gitconfig; agents drive
# git-spice per the monorepo-delivery skill).
[spice "branchCreate"]
	commit = false
[spice "branchMerge"]
	method = squash
[spice "merge"]
	method = squash
[spice "submit"]
	skipRestackCheck = trunk
