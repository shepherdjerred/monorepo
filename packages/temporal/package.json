{
  "name": "@shepherdjerred/temporal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#client": "./src/client.ts",
    "#shared/*": "./src/shared/*",
    "#activities/*": "./src/activities/*",
    "#workflows/*": "./src/workflows/*",
    "#generated/*": "./src/generated/*",
    "#observability/*": "./src/observability/*",
    "#lib/*": "./src/lib/*",
    "#db/*": "./src/db/*",
    "#schedules/*": "./src/schedules/*"
  },
  "scripts": {
    "start": "bun run src/worker.ts",
    "typecheck": "bun run scripts/ensure-ha-schema.ts && PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "lint": "bunx eslint --cache .",
    "test": "bun run scripts/ensure-ha-schema.ts && bun run test:bun && bun run test:workflows",
    "test:bun": "bun --no-install --bun vitest --config ../../vitest.config.ts run src/activities src/event-bridge src/observability src/schedules src/shared src/lib src/workflows/agent-task.test.ts",
    "test:workflows": "bun scripts/test-workflows.ts",
    "test:integration": "bun run scripts/ensure-ha-schema.ts && bun --no-install --bun vitest --config ../../vitest.config.ts run src/integration.test.ts",
    "generate:live": "bun ../home-assistant/src/codegen/cli.ts --out src/generated/ha-schema.ts --name HaSchema",
    "docker:build": "docker buildx build --cache-from type=registry,ref=ghcr.io/shepherdjerred/temporal-worker:buildcache ${DOCKER_BUILD_EXTRA_ARGS:-} --load -t temporal-worker:dev -f Dockerfile ../..",
    "smoke": "bun scripts/smoke.ts",
    "canary:agent-task": "bun run scripts/agent-task-structured-output-canary.ts --production-only",
    "canary:report-reliability": "bun run scripts/report-reliability-canary.ts --production-only",
    "inventory:report-schedules": "bun run scripts/inventory-report-schedules.ts",
    "check:rehearsal": "bun run scripts/check-schedule-rehearsal.ts",
    "glitter:import-seed": "bun run scripts/import-glitter-seed.ts",
    "glitter:operate": "bun run scripts/operate-glitter-corpus.ts",
    "glitter:verify-corpus": "bun run scripts/verify-glitter-corpus.ts",
    "test:ci": "bun ../../scripts/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../scripts/run-ci-test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@aws-sdk/client-s3": "^3.1001.0",
    "@kubernetes/client-node": "^1.4.0",
    "@octokit/webhooks-methods": "^6.0.0",
    "@openai/codex-sdk": "0.147.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/core": "^2.7.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@sentry/bun": "^10.49.0",
    "@shepherdjerred/code-review": "workspace:*",
    "@shepherdjerred/glitter-context": "workspace:*",
    "@shepherdjerred/home-assistant": "workspace:*",
    "@shepherdjerred/llm-models": "workspace:*",
    "@shepherdjerred/llm-observability": "workspace:*",
    "@shepherdjerred/llm-runtime": "workspace:*",
    "@temporalio/activity": "1.22.0",
    "@temporalio/client": "1.22.0",
    "@temporalio/common": "1.22.0",
    "@temporalio/worker": "1.22.0",
    "@temporalio/workflow": "1.22.0",
    "@types/sanitize-html": "^2.16.1",
    "csv-parse": "^7.0.1",
    "fflate": "^0.8.3",
    "firebase": "^12.12.1",
    "hono": "^4.12.18",
    "marked": "^18.0.3",
    "octokit": "^5.0.4",
    "ai": "7.0.59",
    "prom-client": "^15.1.3",
    "sanitize-html": "^2.17.4",
    "semver": "^7.7.3",
    "simple-git": "^3.36.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shepherdjerred/eslint-config": "workspace:*",
    "@temporalio/testing": "1.22.0",
    "@tsconfig/node-lts": "^24.0.0",
    "@tsconfig/recommended": "^1.0.13",
    "@tsconfig/strictest": "^2.0.8",
    "@types/bun": "1.4.0",
    "@types/semver": "^7.7.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.3.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "vitest": "4.1.9",
    "@vitest/coverage-istanbul": "4.1.9"
  }
}
