// =============================================================================
// Durable match pipeline: operational facts and receipts
//
// Persistence for the @scout-for-lol/domain unions (match-processing,
// notifications, recovery). Enum-shaped and JSON columns are TEXT validated by
// the domain schemas at every read/write boundary (src/database/durable/), per
// the provider-neutral convention above; the hand-authored migration adds
// CHECK constraints mirroring each union's vocabulary and per-variant field
// presence, following the InitialMatchHistoryImport precedent.
// =============================================================================

/// One row per observed Riot match. Match ownership lives here: the unique
/// riotMatchId is the claim key, `pipelineOwner` NULL is the domain's
/// `unowned` variant, and promotion mirrors promoteArchiveOnlyToFull — a FULL
/// row with NULL promotedAt was born FULL and can never have been promoted.
/// observeMatch is idempotent over what an observation ASSERTS, which is not
/// the whole row: `observedAt` is excluded from the replay comparison exactly
/// as `recordedAt` is excluded from a receipt's identity, so an ordinary
/// replay is `already-applied` and not a conflict.
model MatchObservation {
  riotMatchId      String    @id
  platformRoute    String
  processingPolicy String // MatchProcessingPolicy: ARCHIVE_ONLY | HISTORY_ONLY | FULL
  deliveryMode     String // MatchDeliveryMode: live | silent-backfill; decided at discovery, never derivable later
  matchDataSource  String    @default("RIOT") // MatchDataSource: RIOT | SCOUT_CLIENT; canonical payload provenance, fixed at commit
  pipelineOwner    String? // LEGACY_V1 | TEMPORAL_V2; NULL = unowned
  promotedAt       DateTime?
  gameCreatedAt    DateTime
  observedAt       DateTime // when someone first looked; never replay identity

  // Raw capture artifact references (S3 object key + SHA-256 digest, always
  // paired). NULL means no writer has reported one yet — silence, not a claim
  // that none exists, so an observation carrying none leaves a stored identity
  // standing. A first identity fills the pair in; a DIFFERENT one is two
  // producers disagreeing about the canonical bytes, and conflicts.
  matchObjectKey    String?
  matchDigest       String?
  timelineObjectKey String?
  timelineDigest    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([processingPolicy, observedAt])
  @@index([gameCreatedAt])
}

/// Source-independent discovery decision, fixed before queueing or source-selection delays.
model MatchEvidenceAdmission {
  riotMatchId              String    @id
  policy                   String // FULL | HISTORY_ONLY; immutable after admission
  reason                   String // live-completion | history-discovery | late-discovery | legacy-live | legacy-history
  firstDiscoveredAt        DateTime
  completedAt              DateTime? // Legacy completion remains unknown until resolved evidence supplies it.
  riotHistoryListed        Boolean   @default(false)
  timelineDeadlineAt       DateTime?
  timelineFinalizedAt      DateTime?
  timelineMissing          Boolean   @default(false)
  historyReportComplete    Boolean   @default(false)
  historyTimelineRecovered Boolean   @default(false)
  recoveryNextAttemptAt    DateTime  @default(now())
  recoveryClaimId          String?
  recoveryError            String?
  legacyPolicy             String?
  legacyPromotedAt         DateTime?
  createdAt                DateTime  @default(now())

  @@index([historyReportComplete, recoveryNextAttemptAt], map: "MatchEvidenceAdmission_recovery_idx")
}

/// Raw upstream responses are retained even when validation or source selection rejects them.
model RiotPayloadCapture {
  normalizedEvidence MatchResultEvidence?
  id                 String               @id @default(uuid())
  source             String
  document           Json
  capturedAt         DateTime             @default(now())
  archiveKey         String?
  archiveDigest      String?
  archiveBytes       BigInt?
  archivedAt         DateTime?
  nextAttemptAt      DateTime             @default(now())
  claimId            String?
  lastError          String?

  @@index([archivedAt, nextAttemptAt])
}

/// Frozen report input and tracked audience when a result can render before full match coverage.
/// This is normalized evidence; original observations remain independently archived in S3.
model MatchReportSnapshot {
  riotMatchId String    @id
  document    Json
  createdAt   DateTime  @default(now())
  /// Report rendering and intent reconciliation completed, not the game's end time.
  completedAt DateTime?
}

/// Both adapters publish to the same result evidence registry; ownership stays at query boundaries.
model MatchResultEvidence {
  source              String
  sourceId            String
  riotMatchId         String
  result              Json
  capturedAt          DateTime
  clientObservationId String?                 @unique
  clientObservation   ScoutClientObservation? @relation(fields: [clientObservationId], references: [observationId], onDelete: Cascade)
  riotCaptureId       String?                 @unique
  riotCapture         RiotPayloadCapture?     @relation(fields: [riotCaptureId], references: [id], onDelete: Cascade)

  @@id([source, sourceId])
  @@index([riotMatchId])
}

/// Frozen 10-player Flex roster for community MVP votes. Match-global: the
/// players are a fact of the Riot match, while ballots below are per guild.
/// `reportMessageIds` is the durable channel→message map for tally edits.
model MatchMvpContest {
  matchId          String    @id
  roster           Json
  reportMessageIds Json?
  /// Riot `info.gameCreation`. Backfilled from MatchObservation / rank history
  /// for contests that existed before this column; writers fill any remainder.
  gameCreationAt   DateTime?
  /// Resolved Scout queue type (`flex`, `ranked 5s`, …). Pre-column contests
  /// were Flex-only attach and backfill to `flex`.
  queueType        String?
  createdAt        DateTime  @default(now())

  @@index([gameCreationAt])
  @@index([queueType, gameCreationAt])
}

/// One guild member's vote in one category for one community MVP contest.
model MatchMvpVote {
  id             Int      @id @default(autoincrement())
  matchId        String
  serverId       String
  voterDiscordId String
  /// `ally` or `enemy`, relative to the voter's team in this match.
  category       String
  /// Index into MatchMvpContest.roster.participants.
  nomineeIndex   Int
  /// Copied from the frozen roster at vote time so leaderboards skip JSON.
  nomineePuuid   String?
  nomineeTeamId  Int?
  voterPuuid     String
  voterTeamId    Int
  justification  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([matchId, serverId, voterDiscordId, category])
  @@index([matchId, serverId, category])
  @@index([serverId, nomineePuuid])
}

/// One coalesced, durable tally edit request per match and guild. A vote and
/// its revision increment commit together; a worker may retry an edit safely
/// because it replaces the tally embed instead of appending another message.
model MatchMvpTallyRefresh {
  matchId           String
  serverId          String
  desiredRevision   Int       @default(0)
  appliedRevision   Int       @default(0)
  /// A lost worker increments this after a stale edit; the active worker's
  /// completion must not clear that requeue even if no new vote arrived.
  requeueGeneration Int       @default(0)
  /// Successful channel/message edits for the current revision and generation.
  targetProgress    Json      @default("{}")
  pending           Boolean   @default(true)
  nextAttemptAt     DateTime  @default(now())
  attemptCount      Int       @default(0)
  lastErrorCode     String?
  lastAttemptAt     DateTime?
  requestedAt       DateTime  @default(now())
  leaseToken        String?
  leaseUntil        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@id([matchId, serverId])
  @@index([pending, nextAttemptAt, createdAt])
}

/// Guild ownership for a delivered MVP report target. Discord may later delete
/// the channel or deny access, so refresh cannot recover its guild by fetching
/// the channel at the moment it needs to retire a permanently unavailable edit.
model MatchMvpReportTarget {
  matchId   String
  channelId String
  serverId  String
  messageId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([matchId, channelId, messageId])
  @@index([matchId, serverId])
}

/// Association between an observation and one tracked account seen in the
/// match. FK-by-value on riotMatchId (no relation) so ingestion can record
/// participants before/independently of any other table. playerId/accountId
/// are NULL when the puuid was tracked but not registered at observation time.
model MatchTrackedAccount {
  riotMatchId      String
  puuid            String
  playerId         Int?
  accountId        Int?
  cursorAdvancedAt DateTime?
  createdAt        DateTime  @default(now())

  @@id([riotMatchId, puuid])
  @@index([puuid, cursorAdvancedAt])
}

/// One durable processing receipt. The domain identity is
/// matchProcessingReceiptIdentityKey — `kind:version:scopeKey` — which the
/// unique constraint spells out as columns. `scopeKey` is receiptScopeKey
/// (scope) kept alongside the split scope columns so the unique constraint
/// has no nullable members (Postgres treats NULLs as distinct in unique
/// indexes); CHECKs tie the representations together and pin `kind` to the
/// domain's kebab-case ReceiptKind brand (no `:`, so the identity encoding
/// stays injective). recordReceipt is idempotent over the identity and
/// conflicts when a replay carries different evidence.
model MatchProcessingReceipt {
  id             BigInt   @id @default(autoincrement())
  riotMatchId    String
  kind           String // ReceiptKind: kebab-case brand
  version        Int
  scopeKind      String // ReceiptScope kind: global | guild | account
  scopeGuildId   String?
  scopeAccountId Int?
  scopeKey       String // receiptScopeKey(scope), e.g. "guild:123"
  evidence       String? // JSON, opaque to SQL
  recordedAt     DateTime
  createdAt      DateTime @default(now())

  @@unique([riotMatchId, kind, version, scopeKey])
  @@index([kind, recordedAt])
}

/// One durable notification intent (domain NotificationIntent). The state
/// union is flattened: `state` is the discriminant and each variant's payload
/// lives in a dedicated column whose presence the migration CHECKs to exactly
/// the states that carry it. `payload` is the notificationIntentCodec
/// envelope of the whole intent — the versioned wire form — and the row
/// codec cross-checks it against the columns on every read, so neither
/// representation can silently drift. lastFailure is split into its two
/// closed-vocabulary columns so a bad writer cannot brick the row.
model MatchNotificationIntent {
  intentKey       String  @id
  /// The subject union lets non-match notifications use the same durable send state.
  /// A NULL subjectId on a match row is accepted while older application pods
  /// are still writing through the previous schema; new writers set both.
  subjectKind     String  @default("match") // match | duel | dare | announcement
  subjectId       String?
  riotMatchId     String? // match subjects only; retained for match fan-out lookup
  kind            String // NotificationIntentKind; product-announcement has an occurrence subject
  originKind      String // NotificationIntentOrigin kind: live | recovery
  recoveryBatchId String? // recovery origin only: the batch whose policy governs delivery
  targetKind      String // NotificationTarget kind: channel | dm
  targetId        String

  state                     String    @default("pending") // NotificationIntentState kind
  attemptCount              Int       @default(0)
  attemptNonce              String? // sending / unknown-delivery only
  sendStartedAt             DateTime? // sending only
  deliveredAt               DateTime? // delivered only
  messageId                 String? // delivered only (optional there)
  suppressedReason          String? // suppressed only: stale | feature-disabled | recipient-preference | subscription-deleted | channel-deleted | guild-left
  unknownObservedAt         DateTime? // unknown-delivery only
  lastFailureClassification String? // NotificationFailure: retryable | terminal
  lastFailureReason         String? // reason vocabulary of its classification
  freshnessDeadline         DateTime
  /// Critical product bookkeeping is repaired independently of Discord delivery.
  followUpCompletedAt       DateTime?
  payload                   String // JSON notificationIntentCodec envelope of the intent

  createdAt DateTime
  updatedAt DateTime @updatedAt

  @@index([state, freshnessDeadline])
  @@index([kind, state, followUpCompletedAt])
  @@index([riotMatchId])
  @@index([subjectKind, subjectId])
  @@index([recoveryBatchId])
}

/// One recovery batch (domain RecoveryBatch). Cursor and count columns mirror
/// the state union's per-variant payloads, so they are nullable and CHECKed
/// present exactly in the variant that carries them (cursor in `scanning`,
/// counts in `processing`). workflowId is the Temporal retry-adoption business
/// key, minted when a workflow takes the batch over.
model MatchRecoveryBatch {
  recoveryBatchId String  @id
  policy          String // RecoveryPolicy: normal | stale-private-only | no-external
  state           String  @default("planned") // RecoveryBatchState kind
  cursorPosition  String? // scanning only, and only after the first advance
  pagesScanned    Int? // scanning only
  pageBudget      Int? // scanning only
  discoveredCount Int? // processing only
  succeededCount  Int? // processing only
  suppressedCount Int? // processing only
  failedCount     Int? // processing only
  abandonReason   String? // abandoned only
  workflowId      String? @unique

  createdAt DateTime
  updatedAt DateTime @updatedAt

  @@index([state, createdAt])
}

/// A requested Temporal workflow start and its acknowledgement. Deliberately
/// separate from ScoutTemporalWork: this records only "start requested" /
/// "start accepted". One row per REQUEST: every V2 workflow id derives from
/// identity alone, so keying by the workflow id would limit each logical
/// workflow to one request forever. A crashed requester adopts the in-flight
/// (unaccepted) request for its workflow id — at most one exists, enforced by
/// the migration's partial unique index — and a request made after the
/// previous one was accepted is a new row. The domain's
/// recovery/workflow-start module owns which phases are in flight vs terminal.
model ScoutWorkflowStart {
  requestId           String    @id // application-minted lowercase UUID; shape pinned by a migration CHECK
  requestedWorkflowId String
  workflowType        String
  requestedBy         String? // operator/actor discord id; NULL for system requests
  requestSource       String
  inputPayload        String // JSON versioned envelope; its kind must equal workflowType
  requestedAt         DateTime
  acceptedAt          DateTime?
  runId               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([workflowType, requestedAt])
  @@index([requestedWorkflowId, acceptedAt])
}

/// Append-only operator audit trail for the durable pipeline. No update path:
/// rows are only ever inserted and read. `idempotencyKey` lets a retried
/// Temporal activity replay its append without double-writing the trail.
model ScoutOperatorAuditEvent {
  id             BigInt   @id @default(autoincrement())
  actorDiscordId String
  action         String
  subjectKind    String
  subjectId      String
  detail         String // JSON, opaque to SQL
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  @@index([subjectKind, subjectId, createdAt])
  @@index([actorDiscordId, createdAt])
}

/// Archived old→new PUUID evidence from the completed Riot API-key cutover.
/// Canonical S3 objects and database identities have both been rewritten.
/// Runtime reads and lake rebuilds no longer consult these records. Preserve
/// them for historical recovery; retiring application code does not delete data.
model PuuidKeyMap {
  oldPuuid    String    @id
  gameName    String?
  tagLine     String?
  newPuuid    String?
  /// pending | harvested | resolved | unresolved | stranded
  status      String    @default("pending")
  harvestedAt DateTime? @db.Timestamptz()
  resolvedAt  DateTime? @db.Timestamptz()
  /// When this mapping's stored references were rewritten during cutover.
  appliedAt   DateTime? @db.Timestamptz()

  @@index([status])
}

/// Archived applied edges from earlier API-key domains. Retained as evidence,
/// not an application translation source.
model PuuidKeyMapHistory {
  oldPuuid  String
  newPuuid  String
  appliedAt DateTime @db.Timestamptz()

  @@id([oldPuuid, appliedAt])
  @@index([oldPuuid])
}

/// Archived database cutover receipt, retained independently of tracked accounts.
model PuuidKeyMigration {
  /// Always 1. One row describes one database.
  id             Int       @id @default(1)
  appliedAt      DateTime? @db.Timestamptz()
  /// Whether an explicitly opened later transition is still collecting identities.
  transitionOpen Int       @default(1)
}

/// One feature-tip impression, with a temporary pre-send claim.
///
/// Two questions are answered from these rows rather than from stored counters,
/// the same way the settlement-DM hint derives its cadence from `DmAuditLog`:
/// whether an audience is still inside its tip cooldown (the newest `shownAt`),
/// and which tips it has already been shown (`tipKey` presence). A non-null
/// `claimedAt` is a temporary reservation removed after send failure or
/// confirmation; delivered rows remain as history.
///
/// `discordId` is null for a guild-channel message and set for a DM, so a
/// member's DM cadence is their own and does not consume the channel's.
model FeatureTipImpression {
  id         Int       @id @default(autoincrement())
  serverId   String
  /// Who the tip went to: a Discord user id for a DM, or "" for the guild
  /// channel. A sentinel rather than null because the uniqueness below is what
  /// makes a tip claim atomic, and Postgres treats NULLs as distinct — a
  /// nullable column would leave every channel-scoped row unconstrained.
  /// Deliberately not named `discordId`: it holds a sentinel as well as an id.
  audienceId String    @default("")
  /// A `TipKey` from the tips catalog. Validated on read.
  tipKey     String
  shownAt    DateTime  @default(now())
  /// Non-null while the row is a pre-send claim. Cleared after Discord accepts
  /// the message; the partial audience index serializes all tip keys.
  claimedAt  DateTime?

  /// The claim. Two concurrent deliveries to one audience race to insert here;
  /// exactly one wins, so a tip cannot be selected twice.
  @@unique([serverId, audienceId, tipKey])
  @@index([serverId, audienceId, shownAt])
  @@index([serverId, audienceId, claimedAt])
}

// Standalone, non-monetary Dare contracts.
model Dare {
  id                    Int       @id @default(autoincrement())
  serverId              String
  channelId             String
  challengerDiscordId   String
  originConversationId  String?
  dareState             String    @default("draft")
  currentRevision       Int       @default(1)
  publishedRevision     Int?
  contractJson          String?
  proposalExpiresAt     DateTime?
  acceptDeadline        DateTime?
  activatedAt           DateTime?
  deadlineAt            DateTime?
  settledAt             DateTime?
  // The match whose settlement made this Dare terminal, when one did. Written
  // in the settling transaction so a retried settlement can still name every
  // Dare the match resolved after its in-memory result is gone.
  settledMatchId        String?
  finalValue            Boolean?
  proofJson             String?
  voidReason            String?
  messageRef            String?
  calloutClaimId        String?
  calloutClaimedAt      DateTime?
  calloutRefreshPending Boolean   @default(false)
  calloutRefreshVersion Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  revisions  DareRevision[]
  targets    DareTarget[]
  evidence   DareEvidence[]
  intents    ConfirmationIntent[]
  activation DareActivation?

  @@index([challengerDiscordId, dareState, updatedAt])
  @@index([serverId, dareState, updatedAt])
  @@index([dareState, acceptDeadline])
  @@index([dareState, deadlineAt])
  @@index([calloutRefreshPending, updatedAt])
  @@index([settledMatchId])
}

model DareActivation {
  dareId        Int       @id
  dare          Dare      @relation(fields: [dareId], references: [id], onDelete: Cascade)
  revision      Int
  requestedAt   DateTime
  nextAttemptAt DateTime
  attemptCount  Int       @default(0)
  lastAttemptAt DateTime?
  errorCode     String?
  snapshotJson  String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([completedAt, nextAttemptAt, requestedAt])
}

model DareRevision {
  id                  Int      @id @default(autoincrement())
  dareId              Int
  dare                Dare     @relation(fields: [dareId], references: [id], onDelete: Cascade)
  revision            Int
  originalText        String
  canonicalScoutQl    String
  compiledPlan        String
  scoutQlImmutableAst String?
  scoutQlPlanHash     String?
  compilerVersion     String
  evaluatorVersion    String
  targetsJson         String
  deadlineSpecJson    String
  plainLanguage       String
  semanticProofPlan   String
  // List-card copy from Explore authoring. Null on revisions written before
  // this existed; the list then uses originalText and humanized game-set
  // names rather than inventing a second contract.
  displayTitle        String?
  statusPhrasesJson   String?
  translationJson     String?
  createdAt           DateTime @default(now())

  @@unique([dareId, revision])
}

model DareTarget {
  id         Int       @id @default(autoincrement())
  dareId     Int
  dare       Dare      @relation(fields: [dareId], references: [id], onDelete: Cascade)
  targetKey  String
  discordId  String
  playerId   Int
  alias      String
  accounts   String
  acceptedAt DateTime?
  declinedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([dareId, targetKey])
  @@unique([dareId, discordId])
}

model DareEvidence {
  id                  Int      @id @default(autoincrement())
  dareId              Int
  dare                Dare     @relation(fields: [dareId], references: [id], onDelete: Cascade)
  matchId             String
  gameStartAt         DateTime
  gameEndAt           DateTime
  queueType           String
  candidateMembership String
  sourceReferences    String
  evaluationOutput    String
  coverageState       String
  targetDependencies  String
  evaluationTrace     String
  planVersion         String
  createdAt           DateTime @default(now())

  @@unique([dareId, matchId])
  @@index([dareId, gameEndAt, matchId])
}

model DareNotificationPreference {
  id               Int      @id @default(autoincrement())
  serverId         String
  discordId        String
  dareLifecycleDms Boolean  @default(true)
  dareProgressDms  Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([serverId, discordId])
}
