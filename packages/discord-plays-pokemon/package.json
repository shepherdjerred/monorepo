{
  "name": "@shepherdjerred/discord-plays-pokemon-scripts",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "test": "bun test scripts",
    "test:coverage": "bun test --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage --config ../../scripts/bunfig.coverage.toml --coverage scripts/build-wasm.test.ts",
    "lint": "eslint --config eslint.config.ts scripts/build-wasm.ts scripts/build-wasm.test.ts scripts/generate-battle-data.ts scripts/generate-battle-data.test.ts scripts/generate-knowledge.ts scripts/migration-smoke.test.ts scripts/lib/*.ts scripts/knowledge/*.ts",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "build:wasm": "bun scripts/build-wasm.ts",
    "generate:knowledge": "bun scripts/generate-knowledge.ts",
    "generate:battle-data": "bun scripts/generate-battle-data.ts",
    "test:ci": "bun ../../scripts/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../scripts/run-ci-test.ts"
  },
  "devDependencies": {
    "@shepherdjerred/eslint-config": "workspace:*",
    "@types/bun": "^1.3.14",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "csv-parse": "^7.0.1",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "zod": "^4.4.3",
    "@typescript/native": "npm:typescript@7.0.2"
  }
}
