{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Original scene animation authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "build",
    "protocol",
    "baseProfileSha256",
    "imageSha256",
    "sceneManifestSha256",
    "roles",
    "capabilities",
    "nativeSpectatorAdmitted"
  ],
  "properties": {
    "schema": { "const": 1 },
    "kind": { "const": "scene-animation-authority" },
    "build": { "type": "string", "minLength": 1 },
    "protocol": { "type": "string", "minLength": 1 },
    "baseProfileSha256": { "$ref": "#/$defs/digest" },
    "imageSha256": { "$ref": "#/$defs/digest" },
    "sceneManifestSha256": { "$ref": "#/$defs/digest" },
    "nativeSpectatorAdmitted": { "const": false },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clock", "rig", "eventInventory", "leafPoses"],
      "properties": {
        "clock": { "$ref": "#/$defs/graphRole" },
        "rig": { "$ref": "#/$defs/graphRole" },
        "eventInventory": { "$ref": "#/$defs/eventRole" },
        "leafPoses": { "$ref": "#/$defs/graphRole" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dynamicStateProgram", "eventScheduling"],
      "properties": {
        "dynamicStateProgram": { "const": "unadmitted" },
        "eventScheduling": {
          "enum": [
            "unsupported-matching-effects-required",
            "unsupported-native-event-classes"
          ]
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9_.@/-]+$"
    },
    "graphIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "graph",
        "graphSha256",
        "catalog",
        "catalogSha256",
        "rig",
        "rigSha256",
        "leafIds"
      ],
      "properties": {
        "actor": { "$ref": "#/$defs/path" },
        "graph": { "$ref": "#/$defs/path" },
        "graphSha256": { "$ref": "#/$defs/digest" },
        "catalog": { "$ref": "#/$defs/path" },
        "catalogSha256": { "$ref": "#/$defs/digest" },
        "rig": { "$ref": "#/$defs/path" },
        "rigSha256": { "$ref": "#/$defs/digest" },
        "leafIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "eventIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph",
        "graphSha256",
        "owner",
        "field",
        "nativeClass",
        "nativeField",
        "nativeOrder",
        "nativeMapEvidence",
        "schedulingAdmitted",
        "eventIds"
      ],
      "properties": {
        "graph": { "$ref": "#/$defs/path" },
        "graphSha256": { "$ref": "#/$defs/digest" },
        "owner": {
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "string", "minLength": 1 },
              { "type": "integer", "minimum": 0 }
            ]
          }
        },
        "field": { "enum": ["mEventDataMap", "{f598463e}"] },
        "nativeClass": { "type": "string", "minLength": 1 },
        "nativeField": { "enum": [null, "f598463e"] },
        "nativeOrder": {
          "enum": [
            "unresolved-original-map",
            "see-bound-original-map-evidence",
            "source-declarations-only"
          ]
        },
        "nativeMapEvidence": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "sha256"],
              "properties": {
                "file": { "$ref": "#/$defs/path" },
                "sha256": { "$ref": "#/$defs/digest" }
              }
            }
          ]
        },
        "schedulingAdmitted": { "const": false },
        "eventIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "graphRole": {
      "allOf": [
        { "$ref": "#/$defs/role" },
        {
          "properties": {
            "identities": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/graphIdentity" }
            }
          }
        }
      ]
    },
    "eventRole": {
      "allOf": [
        { "$ref": "#/$defs/role" },
        {
          "properties": {
            "identities": {
              "type": "array",
              "items": { "$ref": "#/$defs/eventIdentity" }
            }
          }
        }
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "bytes", "sha256"],
      "properties": {
        "file": { "$ref": "#/$defs/path" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "file", "bytes", "sha256"],
      "properties": {
        "authority": { "enum": ["scene", "native", "derived"] },
        "file": { "$ref": "#/$defs/path" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "bytes", "sha256", "dependsOn", "identities"],
      "properties": {
        "file": { "$ref": "#/$defs/path" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/digest" },
        "dependsOn": {
          "type": "array",
          "items": { "$ref": "#/$defs/dependency" }
        },
        "identities": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
