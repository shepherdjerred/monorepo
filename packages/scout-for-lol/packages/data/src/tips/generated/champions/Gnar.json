          "text": "Hop away from The Darkin Blade; it has long, telegraphed hit zones. Leaping out of one costs him a lot of cooldown.",
          "refs": [
            { "kind": "ability", "key": "Aatrox-Q", "start": 14, "end": 30 }
          ],
          "pWrong": 0.69
        },
        {
          "id": "top:Gnar:Aatrox:4",
          "text": "Fight near a wall once you turn into Mega Gnar; GNAR! stuns anyone knocked into terrain.",
          "refs": [
            { "kind": "champion", "key": "Gnar", "start": 42, "end": 46 },
            { "kind": "ability", "key": "Gnar-R", "start": 48, "end": 53 },
