<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TaskNotes.Windows.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:host="using:TaskNotes.Windows.Host">
    <ScrollViewer>
        <StackPanel
            MaxWidth="760"
            HorizontalAlignment="Left"
            Spacing="16">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="The server URL stays in local settings. The token stays only in Windows Credential Locker."
                TextWrapping="Wrap" />
            <TextBox
                x:Name="ServerUrlTextBox"
                AutomationProperties.AutomationId="TaskNotes.Settings.ServerUrl"
                AutomationProperties.Name="TaskNotes server URL"
                Header="Server URL"
                PlaceholderText="https://tasks.example.com" />
            <PasswordBox
                x:Name="TokenPasswordBox"
                AutomationProperties.AutomationId="TaskNotes.Settings.Token"
                AutomationProperties.Name="TaskNotes bearer token"
                Header="Bearer token" />
            <Button
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="TaskNotes.Settings.Save"
                AutomationProperties.Name="Save server settings and synchronize"
                Click="Save_Click"
                Content="Save and sync" />
            <TextBlock
                x:Name="ConnectionStatusText"
                AutomationProperties.AutomationId="TaskNotes.Settings.Status"
                AutomationProperties.LiveSetting="Polite"
                TextWrapping="Wrap" />
            <TextBox
                x:Name="HotkeyTextBox"
                AutomationProperties.AutomationId="TaskNotes.Settings.Hotkey"
                Header="Global Quick Add hotkey"
                PlaceholderText="Ctrl+Alt+N" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    AutomationProperties.AutomationId="TaskNotes.Settings.Hotkey.Apply"
                    Click="ApplyHotkey_Click"
                    Content="Apply hotkey" />
                <Button
                    AutomationProperties.AutomationId="TaskNotes.Settings.Hotkey.Clear"
                    Click="ClearHotkey_Click"
                    Content="Clear hotkey" />
                <TextBlock
                    x:Name="HotkeyStatusText"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="TaskNotes.Settings.HotkeyStatus"
                    AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <TextBlock
                Margin="0,16,0,0"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Saved views" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="CreateSavedView_Click" Content="Create" />
                <Button Click="RestoreSavedViews_Click" Content="Restore defaults" />
            </StackPanel>
            <ListView
                AutomationProperties.AutomationId="TaskNotes.Settings.SavedViews"
                ItemsSource="{x:Bind ShellViewModel.SavedViews, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="host:SavedViewDefinition">
                        <Grid Padding="0,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Name}" />
                            <Button
                                Grid.Column="1"
                                Click="DuplicateSavedView_Click"
                                Content="Duplicate"
                                Tag="{x:Bind Id}" />
                            <Button
                                Grid.Column="2"
                                Click="MoveSavedView_Click"
                                Content="Move up"
                                Tag="{x:Bind Id}" />
                            <Button
                                Grid.Column="3"
                                Click="DeleteSavedView_Click"
                                Content="Delete"
                                Tag="{x:Bind Id}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                Margin="0,16,0,0"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Parked changes" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Retry changes after correcting the server state, or discard them permanently."
                TextWrapping="Wrap" />
            <ListView
                AutomationProperties.AutomationId="TaskNotes.Settings.ParkedChanges"
                ItemsSource="{x:Bind ViewModel.ParkedChanges, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="host:ParkedChange">
                        <Grid Padding="0,10" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind ErrorName}" />
                                <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                AutomationProperties.Name="Retry parked change"
                                Click="RetryParked_Click"
                                Content="Retry"
                                Tag="{x:Bind Id}" />
                            <Button
                                Grid.Column="2"
                                AutomationProperties.Name="Discard parked change"
                                Click="DiscardParked_Click"
                                Content="Discard"
                                Tag="{x:Bind Id}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</UserControl>
