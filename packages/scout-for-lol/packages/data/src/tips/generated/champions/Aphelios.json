  "general": [
    {
      "lane": "adc",
      "inputHash": "2cc9fcaf57b51176238da9d10926c4fa4ccdd523249f2f08e563152dd81d4426",
      "tips": [
        {
          "id": "adc:Aphelios:general:0",
          "text": "Check which weapons you hold before you trade. Each main weapon has a different ability, so pick the fight that fits your current gun.",
          "refs": [],
          "pWrong": 0.01
        },
        {
          "id": "adc:Aphelios:general:1",
          "text": "Use Moonshot to mark a target, then attack it from far away. The follow-up attack has very long range, so poke from outside their reach.",
          "refs": [],
          "pWrong": 0.02
        },
        {
          "id": "adc:Aphelios:general:2",
          "text": "Hit enemies with Gravitum attacks to slow them. Then use your weapon ability to root every slowed enemy, which sets up a kill or a safe escape.",
          "refs": [
            { "kind": "keyword", "key": "slowed", "start": 37, "end": 41 },
            { "kind": "keyword", "key": "rooted", "start": 80, "end": 84 },
            { "kind": "keyword", "key": "slowed", "start": 91, "end": 97 }
          ],
          "pWrong": 0.2
        },
        {
          "id": "adc:Aphelios:general:3",
          "text": "Swap weapons with Phase to get the gun you need. It has a short cooldown, but you can't cast it while a new weapon is being assembled.",
          "refs": [
            { "kind": "ability", "key": "Aphelios-W", "start": 18, "end": 23 }
          ],
          "pWrong": 0.23
        },
        {
          "id": "adc:Aphelios:general:4",
          "text": "Watch your ammo counter. When a weapon is nearly empty, using its ability burns all the rest, so swap before you waste a good weapon.",
          "refs": [],
          "pWrong": 0.19
        },
        {
          "id": "adc:Aphelios:general:5",
          "text": "Fire Moonlight Vigil at a champion in a clump of enemies. It explodes on the first champion hit and then attacks every enemy caught in the blast.",
          "refs": [
            { "kind": "ability", "key": "Aphelios-R", "start": 5, "end": 20 }
          ],
          "pWrong": 0.85
        },
        {
          "id": "adc:Aphelios:general:6",
          "text": "Spend skill points on attack damage, attack speed or lethality, because Aphelios can't level his abilities. Choose what suits your lane.",
          "refs": [
            { "kind": "champion", "key": "Aphelios", "start": 72, "end": 80 }
          ],
          "pWrong": 0.01
        }
      ],
      "combos": []
    }
  ],
  "matchups": [
    {
