{
  "locals": {
    "arr_api_keys": {
      "animez_password": "${var.animez_password}",
      "animez_pid": "${var.animez_pid}",
      "avistaz_password": "${var.avistaz_password}",
      "avistaz_pid": "${var.avistaz_pid}",
      "privatehd_password": "${var.privatehd_password}",
      "privatehd_pid": "${var.privatehd_pid}",
      "prowlarr": "${var.prowlarr_api_key}",
      "qbittorrent": "${var.qbittorrent_password}",
      "radarr": "${var.radarr_api_key}",
      "sonarr": "${var.sonarr_api_key}"
    }
  },
  "provider": {
    "prowlarr": [
      {
        "api_key": "${local.arr_api_keys[\"prowlarr\"]}",
        "url": "https://prowlarr.tailnet-1a49.ts.net"
      }
    ],
    "radarr": [
      {
        "api_key": "${local.arr_api_keys[\"radarr\"]}",
        "url": "https://radarr.tailnet-1a49.ts.net"
      }
    ],
    "sonarr": [
      {
        "api_key": "${local.arr_api_keys[\"sonarr\"]}",
        "url": "https://sonarr.tailnet-1a49.ts.net"
      }
    ]
  },
  "resource": {
    "prowlarr_application": {
      "radarr": {
        "anime_sync_categories": [],
        "api_key": "${local.arr_api_keys[\"radarr\"]}",
        "base_url": "http://media-radarr-service:7878",
        "config_contract": "RadarrSettings",
        "implementation": "Radarr",
        "name": "Radarr",
        "prowlarr_url": "http://media-prowlarr-service:9696",
        "sync_categories": [
          2000, 2010, 2020, 2030, 2040, 2045, 2050, 2060, 2070, 2080, 2090
        ],
        "sync_level": "fullSync",
        "tags": []
      },
      "sonarr": {
        "anime_sync_categories": [5070],
        "api_key": "${local.arr_api_keys[\"sonarr\"]}",
        "base_url": "http://media-sonarr-service:8989",
        "config_contract": "SonarrSettings",
        "implementation": "Sonarr",
        "name": "Sonarr",
        "prowlarr_url": "http://media-prowlarr-service:9696",
        "sync_categories": [5000, 5010, 5020, 5030, 5040, 5045, 5050, 5090],
        "sync_level": "fullSync",
        "tags": []
      }
    },
    "prowlarr_download_client": {
      "qbittorrent": {
        "additional_tags": [],
        "categories": [],
        "category": "prowlarr",
        "config_contract": "QBittorrentSettings",
        "enable": true,
        "field_tags": [],
        "host": "media-qbittorrent-service",
        "implementation": "QBittorrent",
        "initial_state": 0,
        "item_priority": 0,
        "name": "qBittorrent",
        "password": "${local.arr_api_keys[\"qbittorrent\"]}",
        "port": 8080,
        "post_im_tags": [],
        "priority": 1,
        "protocol": "torrent",
        "tags": [],
        "use_ssl": false,
        "username": "jerred"
      }
    },
    "prowlarr_indexer": {
      "animez": {
        "app_profile_id": 1,
        "config_contract": "AvistazSettings",
        "enable": true,
        "fields": [
          { "bool_value": false, "name": "freeleechOnly" },
          {
            "bool_value": false,
            "name": "torrentBaseSettings.preferMagnetUrl"
          },
          { "name": "baseSettings.limitsUnit", "number_value": 0 },
          { "name": "baseUrl", "text_value": "https://animez.to/" },
          {
            "name": "password",
            "sensitive_value": "${local.arr_api_keys[\"animez_password\"]}"
          },
          {
            "name": "pid",
            "sensitive_value": "${local.arr_api_keys[\"animez_pid\"]}"
          },
          { "name": "torrentBaseSettings.seedRatio", "number_value": 3 },
          { "name": "username", "text_value": "shprd" }
        ],
        "implementation": "AnimeZ",
        "name": "AnimeZ",
        "priority": 1,
        "protocol": "torrent",
        "tags": []
      },
      "avistaz": {
        "app_profile_id": 1,
        "config_contract": "AvistazSettings",
        "enable": true,
        "fields": [
          { "bool_value": false, "name": "freeleechOnly" },
          {
            "bool_value": false,
            "name": "torrentBaseSettings.preferMagnetUrl"
          },
          { "name": "baseSettings.limitsUnit", "number_value": 0 },
          { "name": "baseUrl", "text_value": "https://avistaz.to/" },
          {
            "name": "password",
            "sensitive_value": "${local.arr_api_keys[\"avistaz_password\"]}"
          },
          {
            "name": "pid",
            "sensitive_value": "${local.arr_api_keys[\"avistaz_pid\"]}"
          },
          { "name": "torrentBaseSettings.seedRatio", "number_value": 3 },
          { "name": "username", "text_value": "shprd" }
        ],
        "implementation": "AvistaZ",
        "name": "AvistaZ",
        "priority": 1,
        "protocol": "torrent",
        "tags": []
      },
      "knaben": {
        "app_profile_id": 1,
        "config_contract": "NoAuthTorrentBaseSettings",
        "enable": true,
        "fields": [
          {
            "bool_value": false,
            "name": "torrentBaseSettings.preferMagnetUrl"
          },
          { "name": "baseSettings.limitsUnit", "number_value": 0 }
        ],
        "implementation": "Knaben",
        "lifecycle": { "ignore_changes": ["fields"] },
        "name": "Knaben",
        "priority": 25,
        "protocol": "torrent",
        "tags": []
      },
      "magnetdownload": {
        "app_profile_id": 1,
        "config_contract": "CardigannSettings",
        "enable": true,
        "fields": [
          {
            "bool_value": false,
            "name": "torrentBaseSettings.preferMagnetUrl"
          },
          { "name": "baseSettings.limitsUnit", "number_value": 0 },
          { "name": "definitionFile", "text_value": "magnetdownload" },
          {
            "name": "info_category_8000",
            "text_value": "MagnetDownload does not return categories in its search results. To sync to your apps, include 8000(Other) in your Apps' Sync Categories."
          }
        ],
        "implementation": "Cardigann",
        "lifecycle": { "ignore_changes": ["fields"] },
        "name": "MagnetDownload",
        "priority": 25,
        "protocol": "torrent",
        "tags": []
      },
      "privatehd": {
        "app_profile_id": 1,
        "config_contract": "AvistazSettings",
        "enable": true,
        "fields": [
          { "bool_value": false, "name": "freeleechOnly" },
          {
            "bool_value": false,
            "name": "torrentBaseSettings.preferMagnetUrl"
          },
          { "name": "baseSettings.limitsUnit", "number_value": 0 },
          { "name": "baseUrl", "text_value": "https://privatehd.to/" },
          {
            "name": "password",
            "sensitive_value": "${local.arr_api_keys[\"privatehd_password\"]}"
          },
          {
            "name": "pid",
            "sensitive_value": "${local.arr_api_keys[\"privatehd_pid\"]}"
          },
          { "name": "torrentBaseSettings.seedRatio", "number_value": 3 },
          { "name": "username", "text_value": "root@sjer.red" }
        ],
        "implementation": "PrivateHD",
        "name": "PrivateHD",
        "priority": 1,
        "protocol": "torrent",
        "tags": []
      },
      "the_pirate_bay": {
        "app_profile_id": 1,
        "config_contract": "CardigannSettings",
        "enable": true,
        "fields": [
          {
            "bool_value": false,
            "name": "torrentBaseSettings.preferMagnetUrl"
          },
          { "name": "apiurl", "text_value": "apibay.org" },
          { "name": "baseSettings.limitsUnit", "number_value": 0 },
          { "name": "definitionFile", "text_value": "thepiratebay" },
          {
            "name": "info_uploader",
            "text_value": "You can filter by Uploader by entering a Case Sensitive username, or leave empty to get all results.<br>Note: this is the username of the Uploader and not the Groupname that often show up at the end of TPB titles, eg -MeGusta."
          },
          { "name": "uploader", "text_value": "" }
        ],
        "implementation": "Cardigann",
        "lifecycle": { "ignore_changes": ["fields"] },
        "name": "The Pirate Bay",
        "priority": 25,
        "protocol": "torrent",
        "tags": []
      }
    },
    "radarr_download_client": {
      "qbittorrent": {
        "additional_tags": [],
        "config_contract": "QBittorrentSettings",
        "enable": true,
        "field_tags": [],
        "first_and_last": false,
        "host": "media-qbittorrent-service",
        "implementation": "QBittorrent",
        "initial_state": 0,
        "movie_category": "radarr",
        "name": "qBittorrent",
        "older_movie_priority": 0,
        "password": "${local.arr_api_keys[\"qbittorrent\"]}",
        "port": 8080,
        "post_import_tags": [],
        "priority": 1,
        "protocol": "torrent",
        "recent_movie_priority": 0,
        "remove_completed_downloads": true,
        "remove_failed_downloads": true,
        "sequential_order": false,
        "tags": [],
        "use_ssl": false,
        "username": "jerred"
      }
    },
    "radarr_root_folder": { "movies": { "path": "/movies" } },
    "sonarr_download_client": {
      "qbittorrent": {
        "additional_tags": [],
        "config_contract": "QBittorrentSettings",
        "enable": true,
        "field_tags": [],
        "first_and_last": false,
        "host": "media-qbittorrent-service",
        "implementation": "QBittorrent",
        "initial_state": 0,
        "name": "qBittorrent",
        "older_tv_priority": 0,
        "password": "${local.arr_api_keys[\"qbittorrent\"]}",
        "port": 8080,
        "post_import_tags": [],
        "priority": 1,
        "protocol": "torrent",
        "recent_tv_priority": 0,
        "remove_completed_downloads": true,
        "remove_failed_downloads": true,
        "sequential_order": false,
        "tags": [],
        "tv_category": "tv-sonarr",
        "use_ssl": false,
        "username": "jerred"
      }
    },
    "sonarr_root_folder": { "tv": { "path": "/tv" } }
  },
  "terraform": {
    "backend": {
      "s3": {
        "bucket": "homelab-tofu-state",
        "endpoints": { "s3": "https://seaweedfs-s3.tailnet-1a49.ts.net" },
        "key": "arr/terraform.tfstate",
        "region": "auto",
        "skip_credentials_validation": true,
        "skip_metadata_api_check": true,
        "skip_region_validation": true,
        "skip_requesting_account_id": true,
        "skip_s3_checksum": true,
        "use_lockfile": true,
        "use_path_style": true
      }
    },
    "required_providers": {
      "prowlarr": { "source": "devopsarr/prowlarr", "version": "~> 3.0" },
      "radarr": { "source": "devopsarr/radarr", "version": "~> 2.0" },
      "sonarr": { "source": "devopsarr/sonarr", "version": "~> 3.0" }
    },
    "required_version": ">= 1.6.0"
  },
  "variable": {
    "animez_password": {
      "description": "AnimeZ (animez.to) account password for the Prowlarr AnimeZ indexer.",
      "sensitive": true,
      "type": "string",
      "validation": [
        {
          "condition": "${(length(var.animez_password) > 0)}",
          "error_message": "animez_password must be non-empty (set ANIMEZ_PASSWORD / TF_VAR_animez_password)."
        }
      ]
    },
    "animez_pid": {
      "description": "AnimeZ PID (per-account token from My Account / My Profile) for the Prowlarr AnimeZ indexer.",
      "sensitive": true,
      "type": "string",
      "validation": [
        {
          "condition": "${(length(var.animez_pid) > 0)}",
          "error_message": "animez_pid must be non-empty (set ANIMEZ_PID / TF_VAR_animez_pid)."
        }
      ]
    },
    "avistaz_password": {
      "description": "AvistaZ (avistaz.to) account password for the Prowlarr AvistaZ indexer.",
      "sensitive": true,
      "type": "string",
      "validation": [
        {
          "condition": "${(length(var.avistaz_password) > 0)}",
          "error_message": "avistaz_password must be non-empty (set AVISTAZ_PASSWORD / TF_VAR_avistaz_password)."
        }
      ]
    },
    "avistaz_pid": {
      "description": "AvistaZ PID (per-account token from My Account / My Profile) for the Prowlarr AvistaZ indexer.",
      "sensitive": true,
      "type": "string",
      "validation": [
        {
          "condition": "${(length(var.avistaz_pid) > 0)}",
          "error_message": "avistaz_pid must be non-empty (set AVISTAZ_PID / TF_VAR_avistaz_pid)."
        }
      ]
    },
    "privatehd_password": {
      "description": "PrivateHD account password for the Prowlarr PrivateHD indexer.",
      "sensitive": true,
      "type": "string",
      "validation": [
        {
          "condition": "${(length(var.privatehd_password) > 0)}",
          "error_message": "privatehd_password must be non-empty (set PRIVATEHD_PASSWORD / TF_VAR_privatehd_password)."
        }
      ]
    },
    "privatehd_pid": {
      "description": "PrivateHD PID (AvisTaz per-user token) for the Prowlarr PrivateHD indexer.",
      "sensitive": true,
      "type": "string",
      "validation": [
        {
          "condition": "${(length(var.privatehd_pid) > 0)}",
          "error_message": "privatehd_pid must be non-empty (set PRIVATEHD_PID / TF_VAR_privatehd_pid)."
        }
      ]
    },
    "prowlarr_api_key": {
      "description": "Prowlarr REST API key (provider auth).",
      "sensitive": true,
      "type": "string",
      "validation": [
        {
          "condition": "${(length(var.prowlarr_api_key) > 0)}",
          "error_message": "prowlarr_api_key must be non-empty (set PROWLARR_API_KEY / TF_VAR_prowlarr_api_key)."
        }
      ]
    },
    "qbittorrent_password": {
      "description": "qBittorrent WebUI password (user \"jerred\") used by the Radarr/Sonarr/Prowlarr download clients.",
      "sensitive": true,
      "type": "string",
      "validation": [
        {
          "condition": "${(length(var.qbittorrent_password) > 0)}",
          "error_message": "qbittorrent_password must be non-empty (set QBITTORRENT_PASSWORD / TF_VAR_qbittorrent_password)."
        }
      ]
    },
    "radarr_api_key": {
      "description": "Radarr REST API key (provider auth + Prowlarr application sync).",
      "sensitive": true,
      "type": "string",
      "validation": [
        {
          "condition": "${(length(var.radarr_api_key) > 0)}",
          "error_message": "radarr_api_key must be non-empty (set RADARR_API_KEY / TF_VAR_radarr_api_key)."
        }
      ]
    },
    "sonarr_api_key": {
      "description": "Sonarr REST API key (provider auth + Prowlarr application sync).",
      "sensitive": true,
      "type": "string",
      "validation": [
        {
          "condition": "${(length(var.sonarr_api_key) > 0)}",
          "error_message": "sonarr_api_key must be non-empty (set SONARR_API_KEY / TF_VAR_sonarr_api_key)."
        }
      ]
    }
  }
}
