{
  "name": "@discord-plays-mario-kart/backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "exports": {
    "./*": "./src/*"
  },
  "imports": {
    "#src/*": "./src/*",
    "#generated/*": "./generated/*"
  },
  "scripts": {
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "watch": "PATH=node_modules/@typescript/native/bin:$PATH tsc --watch",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "lint": "bun run lint:check",
    "lint:fix": "bun run lint:eslint:fix",
    "lint:check": "bun run lint:eslint:check",
    "lint:eslint:check": "bunx eslint .",
    "lint:eslint:fix": "bunx eslint . --fix",
    "test": "bun --no-install --bun vitest --config ../../../../vitest.config.ts run",
    "test:watch": "bun --no-install --bun vitest --config ../../../../vitest.config.ts",
    "e2e:native-latency": "bun run scripts/e2e-native-latency.ts",
    "e2e:audio": "bun run scripts/e2e-audio.ts",
    "e2e:stream-latency": "bun run scripts/e2e-stream-latency.ts",
    "e2e:driver-feed": "bun run scripts/e2e-driver-feed.ts",
    "e2e:viewer-stats": "bun run scripts/e2e-viewer-stats.ts",
    "smoke:spaghetti-install": "bun run scripts/smoke-spaghetti-install.ts",
    "generate": "bunx --trust prisma generate",
    "db:push": "bunx prisma db push",
    "docker:build": "docker buildx build --cache-from type=registry,ref=ghcr.io/shepherdjerred/discord-plays-mario-kart:buildcache ${DOCKER_BUILD_EXTRA_ARGS:-} --load -t discord-plays-mario-kart:dev -f ../../Dockerfile ../../../..",
    "smoke": "bun scripts/smoke.ts",
    "test:ci": "bun ../../../../scripts/ci/run-ci-test.ts",
    "e2e:driver-feed:glass": "bun run --cwd ../common build && bun run --cwd ../frontend build && bun run scripts/e2e-driver-feed-glass.ts",
    "e2e:press-to-paint": "bun run --cwd ../common build && bun run --cwd ../frontend build && bun run scripts/e2e-press-to-paint.ts"
  },
  "dependencies": {
    "@discord-plays-mario-kart/common": "workspace:*",
    "@libsql/client": "0.18.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@prisma/adapter-libsql": "7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/client-runtime-utils": "7.10.0",
    "@sentry/bun": "^11.6.0",
    "@shepherdjerred/discord-stream-lifecycle": "workspace:*",
    "@shepherdjerred/discord-video-stream": "workspace:*",
    "discord.js": "^14.26.4",
    "discord.js-selfbot-v13": "^3.6.1",
    "express": "^5.0.0",
    "prisma": "^7.10.0",
    "prom-client": "^15.1.3",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1",
    "ts-pattern": "^5.7.0",
    "zod": "^4.4.3",
    "@shepherdjerred/discord-plays-core": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@shepherdjerred/eslint-config": "workspace:*",
    "@types/bun": "1.4.2",
    "@types/express": "^5.0.1",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.1",
    "socket.io-client": "^4.8.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "vitest": "5.0.3",
    "@vitest/coverage-istanbul": "5.0.3"
  }
}
