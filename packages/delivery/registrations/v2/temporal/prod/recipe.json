{
  "id": "temporal/2",
  "definition": {
    "kind": "kubernetes-application",
    "application": {
      "name": "temporal",
      "metadata": {
        "labels": { "ci.sjer.red/managed-application": "true" },
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=false",
          "ci.sjer.red/application-lifecycle": "retain"
        },
        "finalizers": []
      },
      "project": "cluster",
      "destination": {
        "server": "https://kubernetes.default.svc",
        "namespace": "temporal"
      },
      "source": {
        "repoURL": "https://chartmuseum.tailnet-1a49.ts.net",
        "chart": "temporal"
      },
      "syncOptions": ["CreateNamespace=true", "RespectIgnoreDifferences=true"],
      "ignoreDifferences": [
        {
          "group": "",
          "kind": "ConfigMap",
          "name": "velero-r2-orphan-audit-state",
          "namespace": "temporal",
          "jsonPointers": ["/data/audit.json"]
        }
      ],
      "revisionHistoryLimit": 5,
      "lifecycle": "retain"
    },
    "chartComponent": "chart:temporal",
    "artifactParameters": {
      "delivery.dependencies.caddy-s3proxy": "image:caddy-s3proxy",
      "delivery.images.temporal-worker": "image:temporal-worker"
    },
    "runner": { "service": "ci", "component": "image:ci-base" },
    "steps": [
      {
        "kind": "apply-safety",
        "instance": "application:temporal",
        "pointOfNoReturn": false
      },
      {
        "kind": "sync",
        "instance": "application:temporal",
        "pointOfNoReturn": false
      },
      {
        "kind": "worker-rollout",
        "instance": "worker-pool:central",
        "pointOfNoReturn": false,
        "target": "central",
        "imageComponent": "image:temporal-worker"
      }
    ],
    "oracle": { "probes": [], "tests": [] }
  }
}
