{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "collectedAt": {
      "type": "number",
      "minimum": 0,
      "maximum": 4000000000
    },
    "quotas": {
      "maxItems": 7,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "claude-code",
              "codex",
              "antigravity",
              "cursor",
              "grok",
              "kimi",
              "muse"
            ]
          },
          "status": {
            "type": "string",
            "enum": ["current", "sign_in_required", "unavailable", "disabled"]
          },
          "snapshot": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "enum": [
                  "claude-code",
                  "codex",
                  "antigravity",
                  "cursor",
                  "grok",
                  "kimi",
                  "muse"
                ]
              },
              "accountLabel": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "plan": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      },
                      "monthlyCostUSD": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": ["name"],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "windows": {
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "kind": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "rolling": {
                              "type": "object",
                              "properties": {
                                "durationSeconds": {
                                  "anyOf": [
                                    {
                                      "type": "integer",
                                      "exclusiveMinimum": 0,
                                      "maximum": 9007199254740991
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                }
                              },
                              "additionalProperties": false
                            }
                          },
                          "required": ["rolling"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "weekly": {
                              "type": "object",
                              "properties": {},
                              "additionalProperties": false
                            }
                          },
                          "required": ["weekly"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "monthly": {
                              "type": "object",
                              "properties": {},
                              "additionalProperties": false
                            }
                          },
                          "required": ["monthly"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "modelScoped": {
                              "type": "object",
                              "properties": {
                                "model": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 500
                                }
                              },
                              "required": ["model"],
                              "additionalProperties": false
                            }
                          },
                          "required": ["modelScoped"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "credits": {
                              "type": "object",
                              "properties": {},
                              "additionalProperties": false
                            }
                          },
                          "required": ["credits"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "providerDefined": {
                              "type": "object",
                              "properties": {},
                              "additionalProperties": false
                            }
                          },
                          "required": ["providerDefined"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "entitlement": {
                              "type": "object",
                              "properties": {},
                              "additionalProperties": false
                            }
                          },
                          "required": ["entitlement"],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "usedPercent": {
                      "anyOf": [
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 100
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "resetAt": {
                      "anyOf": [
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 4000000000
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "sourceTimestamp": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 4000000000
                    }
                  },
                  "required": ["id", "label", "kind", "sourceTimestamp"],
                  "additionalProperties": false
                }
              },
              "resets": {
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "exp": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 4000000000
                    }
                  },
                  "required": ["exp"],
                  "additionalProperties": false
                }
              },
              "resetErrorMessage": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "notes": {
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "sourceTimestamp": {
                "type": "number",
                "minimum": 0,
                "maximum": 4000000000
              },
              "freshness": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "current": {
                        "type": "object",
                        "properties": {},
                        "additionalProperties": false
                      }
                    },
                    "required": ["current"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "stale": {
                        "type": "object",
                        "properties": {
                          "reason": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 500
                          }
                        },
                        "required": ["reason"],
                        "additionalProperties": false
                      }
                    },
                    "required": ["stale"],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": ["provider", "windows", "sourceTimestamp"],
            "additionalProperties": false
          }
        },
        "required": ["provider", "status"],
        "additionalProperties": false
      }
    },
    "billing": {
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "enum": ["openai", "anthropic"]
          },
          "status": {
            "type": "string",
            "enum": ["current", "sign_in_required", "unavailable", "disabled"]
          },
          "snapshot": {
            "type": "object",
            "properties": {
              "platform": {
                "type": "string",
                "enum": ["openai", "anthropic"]
              },
              "workspaceNames": {
                "maxItems": 1000,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "monthlySpend": {
                "type": "number",
                "minimum": 0
              },
              "projectedSpend": {
                "type": "number",
                "minimum": 0
              },
              "sourceTimestamp": {
                "type": "number",
                "minimum": 0,
                "maximum": 4000000000
              },
              "creditsRemaining": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "creditGrants": {
                "maxItems": 1000,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": ["purchased", "granted", "unspecified"]
                    },
                    "remainingUSD": {
                      "type": "number",
                      "minimum": 0
                    },
                    "expiresAt": {
                      "anyOf": [
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 4000000000
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": ["kind", "remainingUSD"],
                  "additionalProperties": false
                }
              },
              "creditGrantsUnavailableReason": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "platform",
              "workspaceNames",
              "monthlySpend",
              "projectedSpend",
              "sourceTimestamp",
              "creditGrants"
            ],
            "additionalProperties": false
          }
        },
        "required": ["platform", "status"],
        "additionalProperties": false
      }
    },
    "quotaHistory": {
      "maxItems": 150000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "claude-code",
              "codex",
              "antigravity",
              "cursor",
              "grok",
              "kimi",
              "muse"
            ]
          },
          "windowID": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "kind": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "rolling": {
                    "type": "object",
                    "properties": {
                      "durationSeconds": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "required": ["rolling"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "weekly": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": false
                  }
                },
                "required": ["weekly"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "monthly": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": false
                  }
                },
                "required": ["monthly"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "modelScoped": {
                    "type": "object",
                    "properties": {
                      "model": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      }
                    },
                    "required": ["model"],
                    "additionalProperties": false
                  }
                },
                "required": ["modelScoped"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "credits": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": false
                  }
                },
                "required": ["credits"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "providerDefined": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": false
                  }
                },
                "required": ["providerDefined"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "entitlement": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": false
                  }
                },
                "required": ["entitlement"],
                "additionalProperties": false
              }
            ]
          },
          "usedPercent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "recordedAt": {
            "type": "number",
            "minimum": 0,
            "maximum": 4000000000
          },
          "resetAt": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 4000000000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "provider",
          "windowID",
          "label",
          "kind",
          "usedPercent",
          "recordedAt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "collectedAt", "quotas", "billing", "quotaHistory"],
  "additionalProperties": false
}
