{
  "name": "@shepherdjerred/console-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./caller": "./src/caller.ts"
  },
  "scripts": {
    "build": "bun build ./src/index.ts ./src/caller.ts --target bun --outdir dist",
    "lint": "bunx --no-install eslint --cache . --max-warnings=0",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run src",
    "test:ci": "bun ../../scripts/ci/run-ci-test.ts",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit"
  },
  "dependencies": {
    "@hono/bun": "^1.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "hono": "^4.12.18",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shepherdjerred/eslint-config": "workspace:*",
    "@tsconfig/node-lts": "^24.0.1",
    "@tsconfig/recommended": "^1.0.13",
    "@tsconfig/strictest": "^2.0.8",
    "@types/bun": "1.4.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-istanbul": "5.0.5",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "vitest": "5.0.5"
  }
}
