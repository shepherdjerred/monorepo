{
  "name": "@shepherdjerred/ops-model",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun build ./src/assemble.ts ./src/catalog.ts ./src/facets/index.ts --target bun --outdir dist",
    "lint": "bunx --no-install eslint --cache .",
    "preview:emails": "bun run scripts/preview-ops-emails.ts",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run",
    "test:ci": "bun ../../scripts/ci/run-ci-test.ts",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit"
  },
  "devDependencies": {
    "@shepherdjerred/eslint-config": "workspace:*",
    "@tsconfig/node-lts": "^24.0.1",
    "@tsconfig/recommended": "^1.0.13",
    "@tsconfig/strictest": "^2.0.8",
    "@types/bun": "^1.4.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "ajv": "^8.20.0",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "vitest": "5.0.3",
    "@vitest/coverage-istanbul": "5.0.3"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "exports": {
    "./services.json": "./services.json",
    "./platform-policy.json": "./platform-policy.json",
    "./catalog-document.schema.json": "./catalog-document.schema.json",
    "./catalog-document.json": "./catalog-document.json",
    "./facets.ts": "./src/facets/index.ts",
    "./*": "./src/*"
  }
}
