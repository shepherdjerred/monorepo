{
  "name": "@tasknotes/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./chaos-proxy": "./src/chaos-proxy.ts"
  },
  "scripts": {
    "build": "bun node_modules/@typescript/native/bin/tsc --noEmit",
    "typecheck": "bun node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "bun node_modules/eslint/bin/eslint.js .",
    "test": "bun test",
    "test:ci": "bun ../../scripts/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../scripts/run-ci-test.ts",
    "coverage:portable": "bun --config=../../scripts/bunfig.coverage.toml test ./tests --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage"
  },
  "devDependencies": {
    "@shepherdjerred/eslint-config": "workspace:*",
    "@tsconfig/node-lts": "^24.0.0",
    "@tsconfig/recommended": "^1.0.13",
    "@tsconfig/strictest": "^2.0.8",
    "@types/bun": "^1.3.13",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "tasknotes-server": "workspace:*",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  }
}
