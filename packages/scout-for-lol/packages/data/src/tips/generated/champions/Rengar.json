      "tips": [
        {
          "id": "jungle:Rengar:general:0",
          "text": "Cast Savagery, Battle Roar and Bola Strike in any order to fill Ferocity, then use your next ability for its empowered effect.",
          "refs": [
            { "kind": "ability", "key": "Rengar-Q", "start": 5, "end": 13 },
            { "kind": "ability", "key": "Rengar-W", "start": 15, "end": 26 },
            { "kind": "ability", "key": "Rengar-E", "start": 31, "end": 42 }
          ],
          "pWrong": 0.98
        },
        {
          "id": "jungle:Rengar:general:1",
          "text": "Walk through brush toward your target. Unseen Predator makes your attack leap at them from far away.",
          "refs": [
            {
              "kind": "ability",
              "key": "Rengar-passive",
              "start": 39,
              "end": 54
            }
          ],
          "pWrong": 0.53
        },
        {
          "id": "jungle:Rengar:general:2",
          "text": "Save the empowered Bola Strike for a runner; it roots them instead of slowing them.",
          "refs": [
            { "kind": "ability", "key": "Rengar-E", "start": 19, "end": 30 },
            { "kind": "keyword", "key": "rooted", "start": 48, "end": 53 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "jungle:Rengar:general:3",
          "text": "Use empowered Battle Roar when you are stunned or held down; it cleanses crowd control and heals you.",
          "refs": [
            { "kind": "ability", "key": "Rengar-W", "start": 14, "end": 25 }
          ],
          "pWrong": 0.7
        },
        {
          "id": "jungle:Rengar:general:4",
          "text": "Aim Bola Strike down a line. The bola keeps flying after a hit, but it only affects the first enemy.",
          "refs": [
            { "kind": "ability", "key": "Rengar-E", "start": 4, "end": 15 }
          ],
          "pWrong": 0.58
        },
        {
          "id": "jungle:Rengar:general:5",
          "text": "Use Thrill of the Hunt to find a target far away, then leap onto them. It shows you the nearest enemy champion.",
          "refs": [
            { "kind": "ability", "key": "Rengar-R", "start": 4, "end": 22 }
          ],
          "pWrong": 0.42
        },
        {
          "id": "jungle:Rengar:general:6",
          "text": "Leap first, then use your abilities, because Thrill of the Hunt ends if you cast anything except Savagery.",
          "refs": [
            { "kind": "ability", "key": "Rengar-R", "start": 45, "end": 63 },
            { "kind": "ability", "key": "Rengar-Q", "start": 97, "end": 105 }
          ],
          "pWrong": 0.78
        },
        {
          "id": "jungle:Rengar:general:7",
          "text": "Battle Roar heals you based on damage you recently took, so use it right after a fight starts. It also hurts nearby monsters.",
          "refs": [
            { "kind": "ability", "key": "Rengar-W", "start": 0, "end": 11 }
          ],
          "pWrong": 0.81
        }
      ],
      "combos": [
        {
          "id": "jungle:Rengar:combo:0",
          "name": "Leap Savagery reset",
          "category": "trick",
          "sequence": ["attack", { "kind": "ability", "key": "Rengar-Q" }],
          "when": "Leaping out of brush or ultimate onto a target and you want an immediate second hit.",
          "whenRefs": [],
          "text": "The leap puts the attack timer on cooldown at its start. Casting Q during the leap resets the timer, so a second attack follows as soon as the leap lands.",
          "textRefs": []
        },
        {
          "id": "jungle:Rengar:combo:1",
          "name": "Bola buffer",
          "category": "trick",
          "sequence": [
            { "kind": "ability", "key": "Rengar-E" },
            { "kind": "ability", "key": "Rengar-Q" },
            { "kind": "ability", "key": "Rengar-W" }
          ],
          "when": "Casting Bola Strike when you want your other abilities to come out at once.",
          "whenRefs": [
            { "kind": "ability", "key": "Rengar-E", "start": 8, "end": 19 }
          ],
          "text": "Press Q or W during the bola cast time and Rengar buffers them. They fire as soon as the bola leaves, so the follow-up is instant.",
          "textRefs": [
            { "kind": "champion", "key": "Rengar", "start": 43, "end": 49 }
          ]
        }
      ]
    }
