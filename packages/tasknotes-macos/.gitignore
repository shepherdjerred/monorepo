# XcodeGen output. `project.yml` is the reviewable source of truth; a committed
# pbxproj is 3,000 lines nobody reads, merges badly, and accumulates settings
# nobody chose. Run `bun run xcodegen` after cloning.
*.xcodeproj/

# Generated by XcodeGen from the `info:` block in project.yml, for the same
# reason: one source of truth for the bundle's metadata.
App/Info.plist

# Toolchain scratch. `.build` and `.swiftpm` are also in the root .gitignore;
# repeated here so this package is self-describing.
.build/
.swiftpm/
DerivedData/
Resources/ThirdPartyNotices.txt
Resources/ios/ThirdPartyNotices.txt
Resources/macos/ThirdPartyNotices.txt
Resources/ios/FirstPartyLicense.txt
Resources/macos/FirstPartyLicense.txt
Resources/ios/native-license-inventory.json
Resources/macos/native-license-inventory.json
