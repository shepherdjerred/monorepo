{
  "name": "@shepherdjerred/streambot",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "test": "bun test test/",
    "test:integration": "bun test --timeout 120000 integration/",
    "e2e": "bun run e2e/run.ts",
    "e2e:voice-recovery": "bun run e2e/voice-recovery.ts",
    "e2e:local": "bun run e2e/local.ts",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "lint": "eslint .",
    "docker:build": "docker buildx build --cache-from type=registry,ref=ghcr.io/shepherdjerred/streambot:buildcache ${DOCKER_BUILD_EXTRA_ARGS:-} --load -t streambot:dev -f Dockerfile ../..",
    "smoke": "bun scripts/smoke.ts",
    "test:ci": "bun ../../scripts/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../scripts/run-ci-test.ts"
  },
  "dependencies": {
    "@sentry/bun": "^10.49.0",
    "@shepherdjerred/discord-stream-lifecycle": "workspace:*",
    "@shepherdjerred/discord-video-stream": "workspace:*",
    "discord.js": "^14.26.4",
    "discord.js-selfbot-v13": "^3.7.1",
    "prom-client": "^15.1.3",
    "xstate": "^5.32.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shepherdjerred/eslint-config": "workspace:*",
    "@types/bun": "^1.3.13",
    "@typescript-eslint/utils": "^8.65.0",
    "eslint": "^10.3.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "@typescript/native": "npm:typescript@7.0.2"
  }
}
