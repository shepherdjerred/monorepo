{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    "typecheck": {},
    // Static metadata and redirect assertions inspect the actual built files.
    "test": { "dependsOn": ["build", "^build", "generate"] },
    "test:ci": { "dependsOn": ["build", "^build", "generate"] },
    "test:report": { "dependsOn": ["build", "^build", "generate"] },
    "test:e2e": {
      "dependsOn": ["build", "^build"],
      "cache": true,
      "env": [
        "CI",
        "CI_PLAYWRIGHT_IMAGE",
        "CI_REPORTING_BUILD_ID",
        "PLAYWRIGHT_BRANDED_BROWSERS"
      ],
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"]
    }
  }
}
