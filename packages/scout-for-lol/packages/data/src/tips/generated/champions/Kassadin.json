            { "kind": "ability", "key": "Ahri-E", "start": 48, "end": 53 }
          ],
          "pWrong": 0.04
        },
        {
          "id": "middle:Kassadin:Ahri:1",
          "text": "Use Null Sphere on Ahri to trade. Its magic shield cuts the damage you take from her magic spells.",
          "refs": [
            { "kind": "ability", "key": "Kassadin-Q", "start": 4, "end": 15 },
            { "kind": "champion", "key": "Ahri", "start": 19, "end": 23 }
          ],
          "pWrong": 0.2
        },
        {
          "id": "middle:Kassadin:Ahri:2",
          "text": "Ahri's damage is mostly magic, so your Void Stone passive makes early trades fairly safe. Stay close enough to hit her back.",
          "refs": [
