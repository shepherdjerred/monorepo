+// Timestamp-rewritten blobs retained through a source blob's converter GC
+// reference count toward the record's disk usage, even after the record's own
+// size was computed.
+func TestDiskUsageCountsRetainedRewrittenBlobs(t *testing.T) {
+	t.Parallel()
+	ctx := namespaces.WithNamespace(t.Context(), "buildkit-test")
+	tmpdir := t.TempDir()
+	snapshotter, err := native.NewSnapshotter(filepath.Join(tmpdir, "snapshots"))
+	require.NoError(t, err)
+	t.Cleanup(func() {
+		require.NoError(t, snapshotter.Close())
+	})
+	co, cleanup, err := newCacheManager(ctx, t, cmOpt{tmpdir: tmpdir, snapshotter: snapshotter, snapshotterName: "native"})
+	require.NoError(t, err)
+	t.Cleanup(cleanup)
+	cm := co.manager
+
+	blob, desc, err := mapToBlob(map[string]string{"layer": "data"}, true)
+	require.NoError(t, err)
+	require.NoError(t, content.WriteBlob(ctx, co.cs, "layer", bytes.NewReader(blob), desc))
+	ref, err := cm.GetByBlob(ctx, desc, nil)
+	require.NoError(t, err)
+	require.NoError(t, ref.Release(ctx))
+
+	usage := func() int64 {
+		du, err := cm.DiskUsage(ctx, client.DiskUsageInfo{})
+		require.NoError(t, err)
+		require.Len(t, du, 1)
+		return du[0].Size
+	}
+	require.Equal(t, int64(len(blob)), usage())
+
+	rewritten := []byte("rewritten layer bytes")
+	rdesc := ocispecs.Descriptor{MediaType: ocispecs.MediaTypeImageLayerGzip, Digest: digest.FromBytes(rewritten), Size: int64(len(rewritten))}
+	require.NoError(t, content.WriteBlob(ctx, co.cs, "rewritten", bytes.NewReader(rewritten), rdesc))
+	label := converter.RewrittenBlobGCLabelPrefix + "key"
+	_, err = co.cs.Update(ctx, content.Info{Digest: desc.Digest, Labels: map[string]string{label: rdesc.Digest.String()}}, "labels."+label)
+	require.NoError(t, err)
+	require.Equal(t, int64(len(blob)+len(rewritten)), usage())
+}
