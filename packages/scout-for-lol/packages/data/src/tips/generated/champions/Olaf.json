          "name": "Tough It Out attack reset",
          "category": "trick",
          "sequence": [
            "attack",
            { "kind": "ability", "key": "Olaf-W" },
            "attack"
          ],
          "when": "In melee trades when you want a faster follow-up auto.",
          "whenRefs": [],
          "text": "Tough It Out resets your basic attack timer. Cast it right after an auto so the next auto comes out sooner.",
          "textRefs": [
            { "kind": "ability", "key": "Olaf-W", "start": 0, "end": 12 }
          ]
        },
        {
          "id": "top:Olaf:combo:2",
          "name": "Ragnarok cleanse",
          "category": "trick",
          "sequence": [{ "kind": "ability", "key": "Olaf-R" }],
          "when": "When an enemy stuns, roots or slows you and you want to keep fighting.",
          "whenRefs": [],
          "text": "Ragnarok removes all disables on you and makes you immune to them while it is active. Cast it while you are disabled to break free and keep chasing.",
          "textRefs": [
            { "kind": "ability", "key": "Olaf-R", "start": 0, "end": 8 }
          ]
        }
      ]
