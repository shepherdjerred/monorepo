{
  "dependencies": {
    "@sentry/browser": "^10.0.0",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.7.2",
    "@aws-sdk/client-s3": "^3.1001.0",
    "@iconify-json/heroicons": "^1.2.1",
    "@iconify-json/simple-icons": "^1.2.72",
    "@scout-for-lol/data": "workspace:*",
    "@scout-for-lol/design-system": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "@scout-for-lol/report": "workspace:*",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@shepherdjerred/llm-models": "workspace:*",
    "@shepherdjerred/llm-runtime": "workspace:*",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.2.4",
    "astro": "^7.3.3",
    "astro-icon": "^1.1.1",
    "astro-opengraph-images": "workspace:*",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "fuse.js": "^7.1.0",
    "lucide-react": "^1.14.0",
    "ai": "^7.0.114",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.0.0",
    "zod": "^4.4.3"
  },
  "name": "@scout-for-lol/frontend",
  "scripts": {
    "astro": "astro",
    "build": "astro build && bun run scripts/emit-shared-assets.ts",
    "dev": "astro dev",
    "format": "prettier --check .",
    "lint": "astro check && eslint src --max-warnings=0 && check-architecture",
    "preview": "astro preview",
    "test": "bun --no-install --bun vitest --config ../../../../vitest.config.ts run",
    "test:ci": "bun ../../../../scripts/ci/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../../../scripts/ci/run-ci-test.ts",
    "typecheck": "astro check && PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "deploy": "bun ../../../../scripts/release/deploy-site.ts scout-frontend",
    "deploy:beta": "bun ../../../../scripts/release/deploy-site.ts scout-frontend-beta"
  },
  "type": "module",
  "version": "0.0.1",
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@shepherdjerred/architecture": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-types": "1.4.2",
    "eslint": "^10.7.0",
    "typescript": "^6.0.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "vitest": "5.0.1",
    "@vitest/coverage-istanbul": "5.0.1"
  },
  "description": "Web frontend for Scout for League of Legends",
  "keywords": [
    "league-of-legends",
    "frontend",
    "astro",
    "web"
  ],
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shepherdjerred/monorepo.git"
  },
  "homepage": "https://github.com/shepherdjerred/monorepo/tree/main/packages/scout-for-lol",
  "bugs": {
    "url": "https://github.com/shepherdjerred/monorepo/issues"
  },
  "imports": {
    "#architecture": "./architecture.config.ts",
    "#src/*": "./src/*"
  }
}
