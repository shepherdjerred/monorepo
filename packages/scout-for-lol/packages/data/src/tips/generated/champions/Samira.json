      "tips": [
        {
          "id": "adc:Samira:general:0",
          "text": "Use Blade Whirl to wipe out enemy missiles aimed at you or an ally standing close. Time it for the shot, not before.",
          "refs": [
            { "kind": "ability", "key": "Samira-W", "start": 4, "end": 15 }
          ],
          "pWrong": 0.03
        },
        {
          "id": "adc:Samira:general:1",
          "text": "Mix your hits. Alternate attacks with Flair, Wild Rush and Blade Whirl, because repeating the same hit builds no Style.",
          "refs": [
            { "kind": "ability", "key": "Samira-Q", "start": 38, "end": 43 },
            { "kind": "ability", "key": "Samira-E", "start": 45, "end": 54 },
            { "kind": "ability", "key": "Samira-W", "start": 59, "end": 70 }
          ],
          "pWrong": 0.45
        },
        {
          "id": "adc:Samira:general:2",
          "text": "Cast Flair in the middle of a Wild Rush dash to leave explosives behind you that damage enemies.",
          "refs": [
            { "kind": "ability", "key": "Samira-Q", "start": 5, "end": 10 },
            { "kind": "ability", "key": "Samira-E", "start": 30, "end": 39 }
          ],
          "pWrong": 0.03
        },
        {
          "id": "adc:Samira:general:3",
          "text": "Dash through a weakened enemy champion with Wild Rush to finish them. A kill resets its cooldown, so you can chain into the next target.",
          "refs": [
            { "kind": "ability", "key": "Samira-E", "start": 44, "end": 53 }
          ],
          "pWrong": 0.06
        },
        {
          "id": "adc:Samira:general:4",
          "text": "Attack enemies who are stunned or rooted. Samira dashes to them and fires a burst of shots.",
          "refs": [
            { "kind": "keyword", "key": "rooted", "start": 34, "end": 40 },
            { "kind": "champion", "key": "Samira", "start": 42, "end": 48 }
          ],
          "pWrong": 0.49
        },
        {
          "id": "adc:Samira:general:5",
          "text": "Hold Inferno Trigger until you reach top Style rank and enemies are close to you. You cannot attack while it runs, and crowd control ends it early.",
          "refs": [
            { "kind": "ability", "key": "Samira-R", "start": 5, "end": 20 }
          ],
          "pWrong": 0.17
        },
        {
          "id": "adc:Samira:general:6",
          "text": "Fight enemies up close with Flair. Aimed at a nearby enemy it becomes a sword slash, and your melee-range hits deal extra magic damage.",
          "refs": [
            { "kind": "ability", "key": "Samira-Q", "start": 28, "end": 33 }
          ],
          "pWrong": 0.13
        },
        {
          "id": "adc:Samira:general:7",
          "text": "Poke with Flair at long range when you have a clear line. It stops at the first enemy it hits, so a minion in the way soaks it.",
          "refs": [
            { "kind": "ability", "key": "Samira-Q", "start": 10, "end": 15 }
          ],
          "pWrong": 0.03
        }
      ],
