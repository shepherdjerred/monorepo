reader-to-writer copy of its dump output.

--- a/dlls/msxml3/mxwriter.c
+++ b/dlls/msxml3/mxwriter.c
@@ -1179,8 +1179,8 @@
     ISAXLocator *locator)
 {
     mxwriter *This = impl_from_ISAXContentHandler( iface );
-    FIXME("(%p)->(%p)\n", This, locator);
-    return E_NOTIMPL;
+    TRACE("(%p)->(%p)\n", This, locator);
+    return S_OK;
 }
 
