      "tips": [
        {
          "id": "jungle:Hecarim:general:0",
          "text": "Use Devastating Charge from a long way off so the knock back and damage are bigger. Wait until you have run a good distance before you hit.",
          "refs": [
            { "kind": "ability", "key": "Hecarim-E", "start": 4, "end": 22 }
          ],
          "pWrong": 0.16
        },
        {
          "id": "jungle:Hecarim:general:1",
          "text": "Cast Rampage whenever enemies or camps are close. Each hit builds stacks that make it hit harder and come back sooner.",
          "refs": [
            { "kind": "ability", "key": "Hecarim-Q", "start": 5, "end": 12 }
          ],
          "pWrong": 0.15
        },
        {
          "id": "jungle:Hecarim:general:2",
          "text": "Start Spirit of Dread when a fight begins, not after. Heal off the damage you and your allies deal to nearby enemies.",
          "refs": [
            { "kind": "ability", "key": "Hecarim-W", "start": 6, "end": 21 },
            { "kind": "summoner-spell", "key": "7", "start": 54, "end": 58 }
          ],
          "pWrong": 0.06
        },
        {
          "id": "jungle:Hecarim:general:3",
          "text": "Aim Onslaught of Shadows to catch several enemies at once. They are feared when you arrive, so charge in from far away for a longer fear.",
          "refs": [
            { "kind": "ability", "key": "Hecarim-R", "start": 4, "end": 24 }
          ],
          "pWrong": 0.1
        },
        {
          "id": "jungle:Hecarim:general:4",
          "text": "Charge into the enemy backline with Onslaught of Shadows, then use Rampage and Spirit of Dread while they are feared.",
          "refs": [
            { "kind": "ability", "key": "Hecarim-R", "start": 36, "end": 56 },
            { "kind": "ability", "key": "Hecarim-Q", "start": 67, "end": 74 },
            { "kind": "ability", "key": "Hecarim-W", "start": 79, "end": 94 }
          ],
          "pWrong": 0.32
        },
        {
          "id": "jungle:Hecarim:general:5",
          "text": "Stay fast when you want to hit hard, because Warpath turns bonus Move Speed into Attack Damage.",
          "refs": [
            {
              "kind": "ability",
              "key": "Hecarim-passive",
              "start": 45,
              "end": 52
            }
          ],
          "pWrong": 0.02
        }
      ],
      "combos": [
        {
