@@ -0,0 +1,297 @@
+package converter
+
+import (
+	"archive/tar"
+	"bytes"
+	"compress/gzip"
+	"context"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/containerd/containerd/v2/core/content"
+	"github.com/containerd/containerd/v2/core/leases"
+	"github.com/containerd/containerd/v2/core/metadata"
+	"github.com/containerd/containerd/v2/pkg/namespaces"
+	"github.com/containerd/containerd/v2/plugins/content/local"
+	cerrdefs "github.com/containerd/errdefs"
+	"github.com/moby/buildkit/util/compression"
+	digest "github.com/opencontainers/go-digest"
+	ocispecs "github.com/opencontainers/image-spec/specs-go/v1"
+	"github.com/stretchr/testify/require"
+	bolt "go.etcd.io/bbolt"
+)
+
+const labelGCRoot = "containerd.io/gc.root"
+
+type countingStore struct {
+	content.Store
+	writers int
+}
+
+func (s *countingStore) Writer(ctx context.Context, opts ...content.WriterOpt) (content.Writer, error) {
+	s.writers++
+	return s.Store.Writer(ctx, opts...)
+}
+
+func newReuseTestStore(t *testing.T) (context.Context, *countingStore, *metadata.DB) {
+	t.Helper()
+	dir := t.TempDir()
+	store, err := local.NewStore(filepath.Join(dir, "content"))
+	require.NoError(t, err)
+	db, err := bolt.Open(filepath.Join(dir, "meta.db"), 0o644, nil)
+	require.NoError(t, err)
+	t.Cleanup(func() { db.Close() })
+	mdb := metadata.NewDB(db, store, nil)
+	ctx := namespaces.WithNamespace(t.Context(), "buildkit")
+	require.NoError(t, mdb.Init(ctx))
+	return ctx, &countingStore{Store: mdb.ContentStore()}, mdb
+}
+
+// writeSourceLayer stores a gzip layer whose entries carry a timestamp newer
+// than the epoch, so the rewrite changes its bytes.
+func writeSourceLayer(ctx context.Context, t *testing.T, cs content.Store, modTime time.Time) ocispecs.Descriptor {
+	t.Helper()
+	return writeLayer(ctx, t, cs, modTime, map[string]string{labelGCRoot: "source"})
+}
+
+// writeUnrootedSourceLayer stores the same layer without a GC root, so only
+// leases keep it.
+func writeUnrootedSourceLayer(ctx context.Context, t *testing.T, cs content.Store, modTime time.Time) ocispecs.Descriptor {
+	t.Helper()
+	return writeLayer(ctx, t, cs, modTime, nil)
+}
+
+func writeLayer(ctx context.Context, t *testing.T, cs content.Store, modTime time.Time, extra map[string]string) ocispecs.Descriptor {
+	t.Helper()
+	var tarBuf bytes.Buffer
+	tw := tar.NewWriter(&tarBuf)
+	for _, name := range []string{"app/", "app/a.txt", "app/b.txt"} {
+		hdr := &tar.Header{Name: name, ModTime: modTime, Mode: 0o644, Typeflag: tar.TypeReg, Size: int64(len(name))}
+		if name[len(name)-1] == '/' {
+			hdr.Typeflag, hdr.Mode, hdr.Size = tar.TypeDir, 0o755, 0
+		}
+		require.NoError(t, tw.WriteHeader(hdr))
+		if hdr.Size > 0 {
+			_, err := tw.Write([]byte(name))
+			require.NoError(t, err)
+		}
+	}
+	require.NoError(t, tw.Close())
+	var gzBuf bytes.Buffer
+	gw := gzip.NewWriter(&gzBuf)
+	_, err := gw.Write(tarBuf.Bytes())
+	require.NoError(t, err)
+	require.NoError(t, gw.Close())
+	desc := ocispecs.Descriptor{
+		MediaType: ocispecs.MediaTypeImageLayerGzip,
+		Digest:    digest.FromBytes(gzBuf.Bytes()),
+		Size:      int64(gzBuf.Len()),
+	}
+	labelz := map[string]string{"containerd.io/uncompressed": digest.FromBytes(tarBuf.Bytes()).String()}
+	for k, v := range extra {
+		labelz[k] = v
+	}
+	require.NoError(t, content.WriteBlob(ctx, cs, "source", bytes.NewReader(gzBuf.Bytes()), desc, content.WithLabels(labelz)))
+	return desc
+}
+
+func rewrite(ctx context.Context, t *testing.T, cs content.Store, desc ocispecs.Descriptor, comp compression.Config, epoch time.Time) ocispecs.Descriptor {
+	t.Helper()
+	fn, err := NewWithRewriteTimestamp(ctx, cs, desc, comp, &epoch, nil)
+	require.NoError(t, err)
+	require.NotNil(t, fn)
+	out, err := fn(ctx, cs, desc)
+	require.NoError(t, err)
+	require.NotNil(t, out)
+	return *out
+}
+
+func TestRewriteTimestampReusesRecordedBlob(t *testing.T) {
+	ctx, cs, _ := newReuseTestStore(t)
+	epoch := time.Unix(1767225600, 0)
+	src := writeSourceLayer(ctx, t, cs, epoch.Add(24*time.Hour))
+	comp := compression.New(compression.Gzip)
+
+	cs.writers = 0
+	first := rewrite(ctx, t, cs, src, comp, epoch)
+	require.NotEqual(t, src.Digest, first.Digest)
+	require.Equal(t, 1, cs.writers, "the first export converts the layer")
+
+	cs.writers = 0
+	second := rewrite(ctx, t, cs, src, comp, epoch)
+	require.Equal(t, 0, cs.writers, "a recorded, present blob is reused without writing")
+	require.Equal(t, first, second, "the reused descriptor is identical to the converted one")
+}
+
+func TestRewriteTimestampReuseIsKeyedOnConverterConfig(t *testing.T) {
+	ctx, cs, _ := newReuseTestStore(t)
+	epoch := time.Unix(1767225600, 0)
+	src := writeSourceLayer(ctx, t, cs, epoch.Add(24*time.Hour))
+	gz := compression.New(compression.Gzip)
+	rewrite(ctx, t, cs, src, gz, epoch)
+
+	for name, tc := range map[string]struct {
+		comp  compression.Config
+		epoch time.Time
+	}{
+		"level":       {gz.SetLevel(9), epoch},
+		"force":       {gz.SetForce(true), epoch},
+		"compression": {compression.New(compression.Zstd), epoch},
+		"epoch":       {gz, epoch.Add(time.Hour)},
+	} {
+		t.Run(name, func(t *testing.T) {
+			cs.writers = 0
+			rewrite(ctx, t, cs, src, tc.comp, tc.epoch)
+			require.Equal(t, 1, cs.writers, "a different converter input must convert again")
+		})
+	}
+}
+
+func TestRewriteTimestampConvertsWhenRecordDoesNotVerify(t *testing.T) {
+	epoch := time.Unix(1767225600, 0)
+	comp := compression.New(compression.Gzip)
+	key := func(t *testing.T) string {
+		k, ok := (&conversion{target: comp, rewriteTimestamp: &epoch}).rewriteReuseKey()
+		require.True(t, ok)
+		return k
+	}
+
+	t.Run("rewritten blob missing", func(t *testing.T) {
+		ctx, cs, _ := newReuseTestStore(t)
+		src := writeSourceLayer(ctx, t, cs, epoch.Add(time.Hour))
+		first := rewrite(ctx, t, cs, src, comp, epoch)
+		require.NoError(t, cs.Delete(ctx, first.Digest))
+		cs.writers = 0
+		again := rewrite(ctx, t, cs, src, comp, epoch)
+		require.Equal(t, 1, cs.writers)
+		require.Equal(t, first, again, "conversion is deterministic")
+	})
+
+	t.Run("recorded size does not match", func(t *testing.T) {
+		ctx, cs, _ := newReuseTestStore(t)
+		src := writeSourceLayer(ctx, t, cs, epoch.Add(time.Hour))
+		first := rewrite(ctx, t, cs, src, comp, epoch)
+		k := labelRewriteReusePrefix + key(t)
+		_, err := cs.Update(ctx, content.Info{Digest: src.Digest, Labels: map[string]string{
+			k: `{"digest":"` + first.Digest.String() + `","size":1,"diffID":"` + first.Annotations["containerd.io/uncompressed"] + `"}`,
+		}}, "labels."+k)
+		require.NoError(t, err)
+		cs.writers = 0
+		rewrite(ctx, t, cs, src, comp, epoch)
+		require.Equal(t, 1, cs.writers)
+	})
+
+	t.Run("record without its GC reference", func(t *testing.T) {
+		ctx, cs, _ := newReuseTestStore(t)
+		src := writeSourceLayer(ctx, t, cs, epoch.Add(time.Hour))
+		rewrite(ctx, t, cs, src, comp, epoch)
+		gcKey := labelGCRefRewritten + key(t)
+		_, err := cs.Update(ctx, content.Info{Digest: src.Digest, Labels: map[string]string{gcKey: ""}}, "labels."+gcKey)
+		require.NoError(t, err)
+		cs.writers = 0
+		rewrite(ctx, t, cs, src, comp, epoch)
+		require.Equal(t, 1, cs.writers)
+	})
+}
+
+func TestRewriteTimestampNeverReusesForImmutableBaseLayers(t *testing.T) {
+	epoch := time.Unix(1767225600, 0)
+	imm := map[digest.Digest]struct{}{digest.FromString("base"): {}}
+	_, ok := (&conversion{target: compression.New(compression.Gzip), rewriteTimestamp: &epoch, immDiffIDs: imm}).rewriteReuseKey()
+	require.False(t, ok)
+	_, ok = (&conversion{target: compression.New(compression.EStargz), rewriteTimestamp: &epoch}).rewriteReuseKey()
+	require.False(t, ok, "formats with finalizer annotations are not reused")
+	_, ok = (&conversion{target: compression.New(compression.Gzip)}).rewriteReuseKey()
+	require.False(t, ok, "plain recompression is unchanged")
+}
+
+// A rewritten blob that already exists without converter labels, for example
+// after the exact-digest smoke pulled it back, is labelled by the conversion
+// that finds it, so the next export reuses it.
+func TestRewriteTimestampLabelsAnExistingRewrittenBlob(t *testing.T) {
+	epoch := time.Unix(1767225600, 0)
+	modTime := epoch.Add(time.Hour)
+	comp := compression.New(compression.Gzip)
+
+	ctxA, csA, _ := newReuseTestStore(t)
+	produced := rewrite(ctxA, t, csA, writeSourceLayer(ctxA, t, csA, modTime), comp, epoch)
+	bytesA, err := content.ReadBlob(ctxA, csA, produced)
+	require.NoError(t, err)
+
+	ctx, cs, _ := newReuseTestStore(t)
+	src := writeSourceLayer(ctx, t, cs, modTime)
+	require.NoError(t, content.WriteBlob(ctx, cs, "pulled", bytes.NewReader(bytesA),
+		ocispecs.Descriptor{MediaType: produced.MediaType, Digest: produced.Digest, Size: produced.Size}))
+	before, err := cs.Info(ctx, produced.Digest)
+	require.NoError(t, err)
+	require.Empty(t, before.Labels[labelRewrittenTimestamp])
+
+	cs.writers = 0
+	converted := rewrite(ctx, t, cs, src, comp, epoch)
+	require.Equal(t, 1, cs.writers, "the commit finds the blob already present")
+	require.Equal(t, produced, converted)
+	after, err := cs.Info(ctx, produced.Digest)
+	require.NoError(t, err)
+	require.Equal(t, "1767225600", after.Labels[labelRewrittenTimestamp])
+	require.Equal(t, produced.Annotations["containerd.io/uncompressed"], after.Labels["containerd.io/uncompressed"])
+
+	cs.writers = 0
+	require.Equal(t, produced, rewrite(ctx, t, cs, src, comp, epoch))
+	require.Equal(t, 0, cs.writers, "the labelled blob is reused")
+}
+
+// The rewritten blob's lifetime follows BuildKit's cache-record leases. A
+// record's own lease is flat, so GC keeps its blob without following the blob's
+// references; records whose blob BuildKit produced also hold it in the
+// non-flat "-variants" lease (cache/refs.go linkBlob), which GC traverses.
+func TestRewrittenBlobLifetimeFollowsRecordLeases(t *testing.T) {
+	ctx, cs, mdb := newReuseTestStore(t)
+	lm := metadata.NewLeaseManager(mdb)
+	epoch := time.Unix(1767225600, 0)
+	comp := compression.New(compression.Gzip)
+	src := writeUnrootedSourceLayer(ctx, t, cs, epoch.Add(time.Hour))
+	source := leases.Resource{ID: src.Digest.String(), Type: "content"}
+
+	flat, err := lm.Create(ctx, leases.WithID("record"), leases.WithLabels(map[string]string{
+		"containerd.io/gc.flat": time.Now().UTC().Format(time.RFC3339Nano),
+	}))
+	require.NoError(t, err)
+	require.NoError(t, lm.AddResource(ctx, flat, source))
+	rewritten := rewrite(ctx, t, cs, src, comp, epoch)
+
+	// Flat lease only (records created by GetByBlob): the rewritten blob is
+	// collected, and the next export converts the layer again.
+	_, err = mdb.GarbageCollect(ctx)
+	require.NoError(t, err)
+	_, err = cs.Info(ctx, src.Digest)
+	require.NoError(t, err)
+	_, err = cs.Info(ctx, rewritten.Digest)
+	require.True(t, cerrdefs.IsNotFound(err), "a flat lease does not follow the source's GC reference")
+	cs.writers = 0
+	require.Equal(t, rewritten, rewrite(ctx, t, cs, src, comp, epoch))
+	require.Equal(t, 1, cs.writers, "a collected rewritten blob is a missed reuse, not a wrong one")
+
+	// Non-flat variants lease (records whose blob BuildKit produced): the
+	// rewritten blob survives GC and is reused.
+	variants, err := lm.Create(ctx, leases.WithID("record-variants"))
+	require.NoError(t, err)
+	require.NoError(t, lm.AddResource(ctx, variants, source))
+	_, err = mdb.GarbageCollect(ctx)
+	require.NoError(t, err)
+	_, err = cs.Info(ctx, rewritten.Digest)
+	require.NoError(t, err, "the variants lease follows the source's GC reference")
+	cs.writers = 0
+	require.Equal(t, rewritten, rewrite(ctx, t, cs, src, comp, epoch))
+	require.Equal(t, 0, cs.writers)
+
+	// Removing the record's leases makes both blobs collectable.
+	require.NoError(t, lm.Delete(ctx, flat))
+	require.NoError(t, lm.Delete(ctx, variants))
+	_, err = mdb.GarbageCollect(ctx)
+	require.NoError(t, err)
+	_, err = cs.Info(ctx, src.Digest)
+	require.True(t, cerrdefs.IsNotFound(err))
+	_, err = cs.Info(ctx, rewritten.Digest)
+	require.True(t, cerrdefs.IsNotFound(err))
+}
