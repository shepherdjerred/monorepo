{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // Gradle keeps its own build cache in plugin/**/build and ~/.gradle, both
    // outside turbo's concern; no task declares outputs. Turbo's win is the
    // cached log/exit replay keyed on source hash. MISE_DATA_DIR and JAVA_HOME
    // must pass through or strict env mode hides the mise-managed JDK/Gradle.
    //
    // Every task is a separate Gradle process on the same project directory,
    // and concurrent Gradle builds overwrite each other's class files (CI build
    // 17316: "bad class file ... NoSuchFileException"). The tasks are chained
    // so turbo never runs two of them at once: build → typecheck → lint →
    // test / test:ci. Gradle's up-to-date checks keep the later steps cheap.
    "build": {
      "inputs": [
        "plugin/**/*.java",
        "plugin/**/*.kts",
        "plugin/**/*.kt",
        "plugin/**/*.toml",
        "plugin/**/*.properties",
        "plugin/**/*.lockfile",
        "plugin/**/*.xml",
        "plugin/**/*.yml",
        "plugin/**/*.sql",
        "!plugin/**/build/**",
        "!plugin/.gradle/**"
      ],
      "outputs": [],
      "passThroughEnv": [
        "MISE_DATA_DIR",
        "JAVA_HOME",
        "GRADLE_USER_HOME",
        "GRADLE_OPTS"
      ]
    },
    "test": {
      "dependsOn": ["lint"],
      "inputs": [
        "plugin/**/*.java",
        "plugin/**/*.kts",
        "plugin/**/*.kt",
        "plugin/**/*.toml",
        "plugin/**/*.properties",
        "plugin/**/*.lockfile",
        "plugin/**/*.xml",
        "plugin/**/*.yml",
        "plugin/**/*.sql",
        "!plugin/**/build/**",
        "!plugin/.gradle/**"
      ],
      "outputs": [],
      "passThroughEnv": [
        "MISE_DATA_DIR",
        "JAVA_HOME",
        "GRADLE_USER_HOME",
        "GRADLE_OPTS"
      ]
    },
    "test:ci": {
      "dependsOn": ["lint"],
      "inputs": [
        "plugin/**/*.java",
        "plugin/**/*.kts",
        "plugin/**/*.kt",
        "plugin/**/*.toml",
        "plugin/**/*.properties",
        "plugin/**/*.lockfile",
        "plugin/**/*.xml",
        "plugin/**/*.yml",
        "plugin/**/*.sql",
        "!plugin/**/build/**",
        "!plugin/.gradle/**"
      ],
      "outputs": [],
      "passThroughEnv": [
        "MISE_DATA_DIR",
        "JAVA_HOME",
        "GRADLE_USER_HOME",
        "GRADLE_OPTS"
      ]
    },
    "lint": {
      "dependsOn": ["typecheck"],
      "inputs": [
        "plugin/**/*.java",
        "plugin/**/*.kts",
        "plugin/**/*.kt",
        "plugin/**/*.toml",
        "plugin/**/*.properties",
        "plugin/config/**",
        "tests/**",
        "vitest.e2e.config.ts",
        "tsconfig.json",
        "eslint.config.ts",
        "package.json",
        "!plugin/**/build/**",
        "!plugin/.gradle/**"
      ],
      "outputs": [],
      "passThroughEnv": [
        "MISE_DATA_DIR",
        "JAVA_HOME",
        "GRADLE_USER_HOME",
        "GRADLE_OPTS"
      ]
    },
    "typecheck": {
      "dependsOn": ["build"],
      "inputs": [
        "plugin/**/*.java",
        "plugin/**/*.kts",
        "plugin/**/*.kt",
        "plugin/**/*.toml",
        "plugin/**/*.properties",
        "plugin/**/*.lockfile",
        "plugin/**/*.xml",
        "plugin/**/*.sql",
        "tests/**",
        "vitest.e2e.config.ts",
        "tsconfig.json",
        "eslint.config.ts",
        "package.json",
        "!plugin/**/build/**",
        "!plugin/.gradle/**"
      ],
      "outputs": [],
      "passThroughEnv": [
        "MISE_DATA_DIR",
        "JAVA_HOME",
        "GRADLE_USER_HOME",
        "GRADLE_OPTS"
      ]
    },
    // Real-server e2e against the built TheStorm.jar in a disposable Paper
    // container (tests/e2e). Uncached: it exercises Docker and live network
    // pins. STORM_E2E_* selects a CI sidecar server instead of local Docker.
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": [
        "DOCKER_HOST",
        "DOCKER_CONTEXT",
        "DOCKER_CONFIG",
        "STORM_E2E_*"
      ]
    }
  }
}
