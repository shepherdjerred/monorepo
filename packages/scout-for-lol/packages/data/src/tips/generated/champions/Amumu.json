  "general": [
    {
      "lane": "jungle",
      "inputHash": "b23e15e66edfba005c645ecbe5df4eaa1af3618dd605dae9d0803a2228528997",
      "tips": [
        {
          "id": "jungle:Amumu:general:0",
          "text": "Aim Bandage Toss carefully; it stops at the first enemy it hits, so a minion in the way takes the stun instead. Line it up on the champion you want.",
          "refs": [
            { "kind": "ability", "key": "Amumu-Q", "start": 4, "end": 16 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "jungle:Amumu:general:1",
          "text": "Keep a second Bandage Toss charge for escaping or chasing. It also pulls you to the target, so don't throw both charges early in a fight.",
          "refs": [
            { "kind": "ability", "key": "Amumu-Q", "start": 14, "end": 26 }
          ],
          "pWrong": 0.05
        },
        {
          "id": "jungle:Amumu:general:2",
          "text": "Turn on Despair as soon as you are next to enemies, and turn it off when the fight ends so you don't waste mana. It hurts high-health enemies the most.",
          "refs": [
            { "kind": "ability", "key": "Amumu-W", "start": 8, "end": 15 }
          ],
          "pWrong": 0.99
        },
        {
          "id": "jungle:Amumu:general:3",
          "text": "Use Tantrum when enemies are close. Being hit with attacks shortens its cooldown, so it comes back quickly when you tank damage.",
          "refs": [
            { "kind": "ability", "key": "Amumu-E", "start": 4, "end": 11 }
          ],
          "pWrong": 0.16
        },
        {
          "id": "jungle:Amumu:general:4",
          "text": "Save Curse of the Sad Mummy for a fight where it catches several enemies. It stuns everyone close to you, so move into the middle of them first.",
          "refs": [
            { "kind": "ability", "key": "Amumu-R", "start": 5, "end": 27 }
          ],
          "pWrong": 0.5
        },
        {
          "id": "jungle:Amumu:general:5",
          "text": "Hit enemies with attacks or Despair before magic damage from your team lands. Cursed Touch makes them take extra true damage from magic.",
          "refs": [
            { "kind": "ability", "key": "Amumu-W", "start": 28, "end": 35 },
            {
              "kind": "ability",
              "key": "Amumu-passive",
              "start": 78,
              "end": 90
            }
          ],
          "pWrong": 0.46
        },
        {
          "id": "jungle:Amumu:general:6",
          "text": "Look for ganks where Bandage Toss lands first. Follow the stun with your team's damage while the enemy cannot move.",
          "refs": [
            { "kind": "ability", "key": "Amumu-Q", "start": 21, "end": 33 }
          ],
          "pWrong": 0.06
        }
      ],
      "combos": [
        {
          "id": "jungle:Amumu:combo:0",
          "name": "Despair during Bandage dash",
          "category": "trick",
          "sequence": [
            { "kind": "ability", "key": "Amumu-Q" },
            { "kind": "ability", "key": "Amumu-W" }
          ],
          "when": "When you engage on a target and want Despair damage and Curse to start as early as possible.",
          "whenRefs": [
            { "kind": "ability", "key": "Amumu-W", "start": 37, "end": 44 }
          ],
          "text": "Despair can be cast while Amumu is still dashing from Bandage Toss. Toggle it on mid-dash so it ticks the moment you land.",
          "textRefs": [
            { "kind": "ability", "key": "Amumu-W", "start": 0, "end": 7 },
            { "kind": "champion", "key": "Amumu", "start": 26, "end": 31 },
            { "kind": "ability", "key": "Amumu-Q", "start": 54, "end": 66 }
          ]
        }
      ]
    }
  ],
