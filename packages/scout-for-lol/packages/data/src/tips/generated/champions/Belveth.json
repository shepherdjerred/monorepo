  "general": [
    {
      "lane": "jungle",
      "inputHash": "54eb046687846a7949fa8c1602dc737458f1a6b8e504b80d9540cad6e45a2045",
      "tips": [
        {
          "id": "jungle:Belveth:general:0",
          "text": "Clear camps with Void Surge and Royal Maelstrom; both deal extra damage to monsters, so use them to speed up your clear.",
          "refs": [
            { "kind": "ability", "key": "Belveth-Q", "start": 17, "end": 27 },
            { "kind": "ability", "key": "Belveth-E", "start": 32, "end": 47 }
          ],
          "pWrong": 1
        },
        {
          "id": "jungle:Belveth:general:1",
          "text": "Dash in a different direction each time with Void Surge. Every direction has its own cooldown, so you can chain dashes.",
          "refs": [
            { "kind": "ability", "key": "Belveth-Q", "start": 45, "end": 55 }
          ],
          "pWrong": 0.96
        },
        {
          "id": "jungle:Belveth:general:2",
          "text": "When Above and Below hits an enemy champion, you get that direction of Void Surge back. Slam, then dash again to stay on them.",
          "refs": [
            { "kind": "ability", "key": "Belveth-W", "start": 5, "end": 20 },
            { "kind": "ability", "key": "Belveth-Q", "start": 71, "end": 81 }
          ],
          "pWrong": 0.19
        },
        {
          "id": "jungle:Belveth:general:3",
          "text": "Above and Below knocks up and slows. Use it to start a fight or to stop an enemy who is running away.",
          "refs": [
            { "kind": "ability", "key": "Belveth-W", "start": 0, "end": 15 },
            { "kind": "keyword", "key": "knocked-up", "start": 16, "end": 25 },
            { "kind": "keyword", "key": "slowed", "start": 30, "end": 35 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "jungle:Belveth:general:4",
          "text": "Get the last hit on large monsters and on champions. Death in Lavender gives you permanent attack speed for these takedowns.",
          "refs": [],
          "pWrong": 0.61
        },
        {
          "id": "jungle:Belveth:general:5",
          "text": "Use Royal Maelstrom in a fight once you are in melee range. It cuts damage taken and heals you, but you can't move during it.",
          "refs": [
            { "kind": "ability", "key": "Belveth-E", "start": 4, "end": 19 }
          ],
          "pWrong": 0.2
        },
        {
          "id": "jungle:Belveth:general:6",
          "text": "Don't use Royal Maelstrom while you are stunned or otherwise unable to cast, because you can't slash then.",
          "refs": [
            { "kind": "ability", "key": "Belveth-E", "start": 10, "end": 25 }
          ],
          "pWrong": 0.2
        },
        {
          "id": "jungle:Belveth:general:7",
          "text": "After a champion or epic monster takedown, grab the Void Coral quickly with Endless Banquet. It disappears after a short time.",
          "refs": [
            { "kind": "ability", "key": "Belveth-R", "start": 76, "end": 91 }
          ],
          "pWrong": 0.68
        },
        {
          "id": "jungle:Belveth:general:8",
          "text": "Stay on one target. Basic attacks with Endless Banquet add more true damage on each hit against the same enemy.",
          "refs": [
            { "kind": "ability", "key": "Belveth-R", "start": 39, "end": 54 }
          ],
          "pWrong": 0.11
        },
        {
          "id": "jungle:Belveth:general:9",
          "text": "In true form, Void Surge can dash through walls. Use that to take shortcuts into camps or to chase and escape.",
          "refs": [
            { "kind": "ability", "key": "Belveth-Q", "start": 14, "end": 24 }
          ],
          "pWrong": 0.16
        }
      ],
      "combos": [
        {
          "id": "jungle:Belveth:combo:0",
          "name": "Tail slam dash reset",
          "category": "combo",
          "sequence": [
            { "kind": "ability", "key": "Belveth-W" },
            { "kind": "ability", "key": "Belveth-Q" },
            "attack"
          ],
          "when": "When trading with an enemy champion and you want to keep dashing in the same direction.",
          "whenRefs": [],
          "text": "Hitting a champion with the tail slam refreshes the dash in that direction, so you can dash again right after. Weave attacks between them.",
          "textRefs": []
        },
        {
          "id": "jungle:Belveth:combo:1",
          "name": "True form wall dash",
          "category": "terrain",
          "sequence": [{ "kind": "ability", "key": "Belveth-Q" }],
          "when": "While in true form, when you want to escape or reach a new jungle camp through the walls.",
          "whenRefs": [],
          "text": "In true form, Void Surge can pass through jungle walls. Dash across thin walls to cut through the jungle or flee a gank.",
          "textRefs": [
            { "kind": "ability", "key": "Belveth-Q", "start": 14, "end": 24 }
          ]
        }
      ]
    }
  ],
  "matchups": [
