# Required credentials
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
OPENAI_API_KEY=

# Trusted capability boundary: JSON array of Discord user snowflakes.
# Omit to use the repository's documented allowlist; malformed JSON/IDs fail startup.
# TRUSTED_USER_IDS=["186665676134547461"]

# Models and bounded agent runtime
OPENAI_MODEL=gpt-5.6-sol
OPENAI_CLASSIFIER_MODEL=gpt-5.4-nano
OPENAI_MEMORY_MODEL=gpt-5.4-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_REASONING_EFFORT=medium
OPENAI_TEXT_VERBOSITY=low
OPENAI_MAX_TOKENS=4096
AGENT_MAX_STEPS=8
AGENT_RESPONSE_TIMEOUT_MS=120000
AGENT_ROUTER_TIMEOUT_MS=30000

# Product database. The historical mastra-memory.db is intentionally not configured.
DATABASE_URL=file:./data/birmel.db

# Conversational admission and bounded raw transcript
RESPONDER_ENABLED=true
RESPONDER_ENGAGEMENT_WINDOW_MS=180000
RESPONDER_TRANSCRIPT_WINDOW_MS=3600000
RESPONDER_TRANSCRIPT_MAX_MESSAGES=50

# Scheduler and durable jobs
SCHEDULER_ENABLED=true
SCHEDULER_TICK_INTERVAL_MS=10000
SCHEDULER_OPERATION_TIMEOUT_MS=30000
SCHEDULER_SHUTDOWN_TIMEOUT_MS=30000
SCHEDULER_MAX_TASKS_PER_GUILD=100
SCHEDULER_MAX_RECURRING_TASKS=50
SCHEDULER_MAX_CONCURRENT_JOBS=5

# Daily posts
DAILY_POSTS_ENABLED=true
DAILY_POST_TIME=09:00
DAILY_POST_TIMEZONE=America/Los_Angeles

# Browser automation
BROWSER_ENABLED=true
BROWSER_PROVIDER=pinchtab
BROWSER_HEADLESS=true
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=720
BROWSER_MAX_SESSIONS=5
BROWSER_SESSION_TIMEOUT_MS=300000
PINCHTAB_BASE_URL=http://localhost:9867
PINCHTAB_TOKEN=
PINCHTAB_PROFILE=birmel
# BROWSER_USER_AGENT=

# Shell, editor, and external APIs
SHELL_ENABLED=true
SHELL_DEFAULT_TIMEOUT=30000
SHELL_MAX_TIMEOUT=300000
EDITOR_ENABLED=false
EDITOR_ALLOWED_REPOS=[]
EDITOR_MAX_SESSION_DURATION_MS=1800000
EDITOR_MAX_SESSIONS_PER_USER=1
EDITOR_OAUTH_HOST=0.0.0.0
EDITOR_OAUTH_PORT=4112
EDITOR_GITHUB_CLIENT_ID=
EDITOR_GITHUB_CLIENT_SECRET=
EDITOR_GITHUB_CALLBACK_URL=
NEWS_API_KEY=
RIOT_API_KEY=
WEB_SEARCH_PROVIDER=openai

# Persona and scheduled social features
PERSONA_ENABLED=true
PERSONA_DEFAULT=virmel
PERSONA_STYLE_MODEL=gpt-5.4-nano
BIRTHDAYS_ENABLED=true
BIRTHDAYS_DEFAULT_TIMEZONE=UTC
BIRTHDAYS_ANNOUNCEMENT_CHANNEL_ID=
BIRTHDAYS_ROLE_ID=
ACTIVITY_TRACKING_ENABLED=true
ACTIVITY_ROLE_TIERS=[]
ELECTIONS_ENABLED=true
ELECTION_CHANNEL_ID=
ELECTION_START_TIME=17:00
ELECTION_END_TIME=19:00
ELECTION_TIMEZONE=America/Los_Angeles

# Health and observability
HEALTH_PORT=8080
LOG_LEVEL=info
TELEMETRY_ENABLED=true
TELEMETRY_SERVICE_NAME=birmel
OTLP_ENDPOINT=http://tempo.tempo.svc.cluster.local:4318
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_SAMPLE_RATE=1
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_DEBUG=false

# Voice/music and live E2E
ANTHROPIC_API_KEY=replace-with-anthropic-key
VOICE_ENABLED=true
TTS_VOICE=nova
TTS_SPEED=1.0
BIRMEL_E2E_GUILD_ID=
BIRMEL_E2E_TEXT_CHANNEL_ID=
BIRMEL_E2E_VOICE_CHANNEL_ID=
BIRMEL_E2E_YOUTUBE_QUERY=
BIRMEL_E2E_PLAYBACK_SECONDS=5
BIRMEL_E2E_TIMEOUT_MS=45000
