      "tips": [
        {
          "id": "support:Janna:general:0",
          "text": "Put Eye of the Storm on your carry before a trade; the shield also adds Attack Damage, so they hit harder while it holds.",
          "refs": [
            { "kind": "ability", "key": "Janna-E", "start": 4, "end": 20 }
          ],
          "pWrong": 0
        },
        {
          "id": "support:Janna:general:1",
          "text": "Shield an allied turret with Eye of the Storm when it is under attack or about to kill an enemy.",
          "refs": [
            { "kind": "ability", "key": "Janna-E", "start": 29, "end": 45 }
          ],
          "pWrong": 0.03
        },
        {
          "id": "support:Janna:general:2",
          "text": "Hit an enemy with Zephyr to leave them slowed, which also shortens the wait for your next Eye of the Storm.",
          "refs": [
            { "kind": "ability", "key": "Janna-W", "start": 18, "end": 24 },
            { "kind": "keyword", "key": "slowed", "start": 39, "end": 45 },
            { "kind": "ability", "key": "Janna-E", "start": 90, "end": 106 }
          ],
          "pWrong": 0.05
        },
        {
          "id": "support:Janna:general:3",
          "text": "Hold Howling Gale to charge it before you throw it when you can. A longer charge goes farther and knocks enemies up for longer.",
          "refs": [
            { "kind": "ability", "key": "Janna-Q", "start": 5, "end": 17 }
          ],
          "pWrong": 0.1
        },
        {
          "id": "support:Janna:general:4",
          "text": "Recast Howling Gale right away to knock an enemy up fast when they dive your carry or you need a quick stop.",
          "refs": [
            { "kind": "ability", "key": "Janna-Q", "start": 7, "end": 19 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "support:Janna:general:5",
          "text": "Cast Monsoon when enemies dive onto a wounded ally. It knocks them back and then heals your team.",
          "refs": [
            { "kind": "ability", "key": "Janna-R", "start": 5, "end": 12 }
          ],
          "pWrong": 0.06
        },
        {
          "id": "support:Janna:general:6",
          "text": "Stand still while Monsoon heals. Moving or using an ability ends it early.",
          "refs": [
            { "kind": "ability", "key": "Janna-R", "start": 18, "end": 25 }
          ],
          "pWrong": 0.06
        },
        {
          "id": "support:Janna:general:7",
          "text": "Walk near Janna's allies as they move toward her. Tailwind gives them extra Move Speed, so use it to chase or run away together.",
          "refs": [
            { "kind": "champion", "key": "Janna", "start": 10, "end": 15 },
            {
              "kind": "ability",
              "key": "Janna-passive",
              "start": 50,
              "end": 58
            }
          ],
          "pWrong": 0.27
        }
      ],
      "combos": [
        {
          "id": "support:Janna:combo:0",
          "name": "Instant Howling Gale",
          "category": "trick",
          "sequence": [
            { "kind": "ability", "key": "Janna-Q" },
            { "kind": "ability", "key": "Janna-Q" }
          ],
          "when": "When you need a fast knock up to stop a dive or interrupt a dash, and an uncharged tornado is enough.",
          "whenRefs": [],
          "text": "Cast the tornado and recast it at once to send it uncharged. It is quick and hard to dodge, but short in range and knock up time.",
          "textRefs": []
        }
      ]
    }
  ],
