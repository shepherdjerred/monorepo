---
import { HeroPanel } from "@scout-for-lol/design-system/domain/profile/hero-panel";
import ChampionsShell from "#src/components/champions/ChampionsShell.astro";
import { ChampionIndexBrowser } from "#src/components/champions/champion-index-browser.tsx";
import { championMetaSnapshot } from "#src/components/champions/snapshot.ts";
import {
  indexCards,
  leadSentence,
  sortCards,
} from "#src/components/champions/index-model.ts";
import { hasChampions } from "#src/lib/champion-meta/snapshot-v2-load.ts";
import { indexContextLine } from "#src/lib/champion-meta/public-context.ts";

const snapshot = await championMetaSnapshot;
const populated = hasChampions(snapshot.index);
const cards = populated
  ? indexCards(snapshot.index, await snapshot.champions())
  : [];
const [leader] = sortCards(
  cards.filter((card) => card.main),
  "strongest",
);
const lead = leadSentence(cards);
---

<ChampionsShell
  title="Champions · Scout for LoL"
  description="Champion win rates, builds, runes and skill orders from the games Scout has seen, with the games, patch, queue and rank bracket on every figure."
>
  {populated ? (
    <>
      <HeroPanel
        aria-labelledby="idx-h"
        {...(leader === undefined ? {} : { art: { champion: leader.id } })}
      >
        <h1 id="idx-h" class="champions-h1">
          Champions
        </h1>
        {lead !== null && <p class="champions-lead">{lead}</p>}
        <p class="champions-quiet champions-honest">
          {indexContextLine(snapshot.index)}
        </p>
      </HeroPanel>
      <ChampionIndexBrowser client:load cards={cards} />
    </>
  ) : (
    <HeroPanel aria-labelledby="idx-h">
      <h1 id="idx-h" class="champions-h1">
        Champions
      </h1>
      <p class="champions-lead">No champion data yet</p>
    </HeroPanel>
  )}
</ChampionsShell>
