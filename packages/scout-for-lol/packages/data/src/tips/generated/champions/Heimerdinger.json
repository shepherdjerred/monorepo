          ],
          "pWrong": 0.18
        },
        {
          "id": "top:Heimerdinger:Aatrox:3",
          "text": "Use Hextech Micro-Rockets to poke him from long range while he is on cooldown. Keep him from reaching you.",
          "refs": [
            {
              "kind": "ability",
              "key": "Heimerdinger-W",
              "start": 4,
              "end": 25
            },
            { "kind": "keyword", "key": "poke", "start": 29, "end": 33 }
          ],
          "pWrong": 0.51
        },
        {
          "id": "top:Heimerdinger:Aatrox:4",
          "text": "If Infernal Chains pins you, walk out of the area toward him or to the side so you are not pulled back.",
          "refs": [
            { "kind": "ability", "key": "Aatrox-W", "start": 3, "end": 18 }
          ],
          "pWrong": 0.17
        }
      ],
      "opponent": "Aatrox",
      "comboRefs": []
