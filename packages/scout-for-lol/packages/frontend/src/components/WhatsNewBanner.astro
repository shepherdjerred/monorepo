---
import { Icon } from "astro-icon/components";
import {
  changelog,
  formatChangelogDate,
  renderChangelogToHtml,
} from "../data/changelog";

const latestEntry = changelog[0];
---

{
  latestEntry && (
    <div class="scout-announcement relative z-40">
      <div class="mx-auto max-w-7xl px-4 py-2 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between gap-x-6">
          <div class="flex items-center gap-x-3 min-w-0 flex-1">
            <Icon
              name="heroicons:megaphone"
              class="h-5 w-5 flex-none text-scout-ink"
            />
            <p class="text-sm leading-6 text-scout-accent-ink truncate">
              <strong class="font-semibold">
                What's New - {formatChangelogDate(latestEntry)}:
              </strong>{" "}
              {renderChangelogToHtml(latestEntry.banner).replaceAll(
                /<[^>]*>?/g,
                "",
              )}
            </p>
          </div>
          <a
            href="/whatsnew"
            class="inline-flex min-h-[44px] flex-none items-center text-sm font-semibold text-scout-accent-ink hover:text-scout-accent-ink transition-colors whitespace-nowrap"
          >
            View all <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  )
}
