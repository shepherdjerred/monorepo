  "general": [
    {
      "lane": "adc",
      "inputHash": "8eafeef22f8d626dc4a5f316159c83e0c6b6db89e66d2821edc7d39c5c975661",
      "tips": [
        {
          "id": "adc:Ziggs:general:0",
          "text": "Throw Bouncing Bomb at the enemy's feet to poke, and aim it past them so the bounces can still reach if they step back.",
          "refs": [
            { "kind": "ability", "key": "Ziggs-Q", "start": 6, "end": 19 }
          ],
          "pWrong": 0.19
        },
        {
          "id": "adc:Ziggs:general:1",
          "text": "Drop Hexplosive Minefield on the spot where the enemy has to stand to last-hit. It slows them and lets you follow up with your other abilities.",
          "refs": [
            { "kind": "ability", "key": "Ziggs-E", "start": 5, "end": 25 },
            { "kind": "keyword", "key": "slowed", "start": 83, "end": 88 }
          ],
          "pWrong": 0.08
        },
        {
          "id": "adc:Ziggs:general:2",
          "text": "Use Satchel Charge to jump away from danger, and detonate it when an enemy is next to it to knock them back. Save it for when someone dives you.",
          "refs": [
            { "kind": "ability", "key": "Ziggs-W", "start": 4, "end": 18 }
          ],
          "pWrong": 0.19
        },
        {
          "id": "adc:Ziggs:general:3",
          "text": "Cast an ability just before a basic attack. Casting shortens the cooldown on Short Fuse, so your next auto hits harder.",
          "refs": [
            {
              "kind": "ability",
              "key": "Ziggs-passive",
              "start": 77,
              "end": 87
            }
          ],
          "pWrong": 0.44
        },
        {
          "id": "adc:Ziggs:general:4",
          "text": "Use Satchel Charge on enemy towers. It destroys a tower that is low on health, so it helps you finish a push.",
          "refs": [
            { "kind": "ability", "key": "Ziggs-W", "start": 4, "end": 18 }
          ],
          "pWrong": 0.05
        },
        {
          "id": "adc:Ziggs:general:5",
          "text": "From level 6, look for kills across the map with Mega Inferno Bomb. It lands slowly, so aim it at enemies who are slowed or stuck in place.",
          "refs": [
            { "kind": "ability", "key": "Ziggs-R", "start": 49, "end": 66 },
            { "kind": "keyword", "key": "slowed", "start": 114, "end": 120 }
          ],
          "pWrong": 0.14
        },
        {
          "id": "adc:Ziggs:general:6",
          "text": "Try to hit with the center of Mega Inferno Bomb, because it does less damage at the edge.",
          "refs": [
            { "kind": "ability", "key": "Ziggs-R", "start": 30, "end": 47 }
          ],
          "pWrong": 0.01
        }
      ],
      "combos": [
        {
          "id": "adc:Ziggs:combo:0",
          "name": "Satchel wall hop",
          "category": "terrain",
          "sequence": [{ "kind": "ability", "key": "Ziggs-W" }],
          "when": "When you need to escape or chase over a thin wall, such as between the jungle and the lane.",
          "whenRefs": [],
          "text": "Throw the satchel next to a thin wall and recast it while standing close to it. The blast launches Ziggs over the wall, and you can cast abilities mid-dash.",
          "textRefs": [
            { "kind": "champion", "key": "Ziggs", "start": 99, "end": 104 }
          ]
        },
        {
          "id": "adc:Ziggs:combo:1",
          "name": "Satchel escape",
          "category": "trick",
          "sequence": [
            { "kind": "ability", "key": "Ziggs-W" },
            { "kind": "ability", "key": "Ziggs-W" }
          ],
          "when": "When an enemy dives you and you need to get away or break up a gank.",
          "whenRefs": [],
          "text": "Throw the satchel at your feet or just behind you and recast it right away. The blast knocks nearby enemies back and launches you away from them.",
          "textRefs": []
        }
      ]
    }
  ],
