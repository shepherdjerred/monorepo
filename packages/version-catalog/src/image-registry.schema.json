{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sjer:red:schema:image-registry:v1",
  "title": "First-party image registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "registry", "namespace", "images"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "registry": { "const": "docker.io" },
    "namespace": { "const": "shepherdjerred" },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "visibility"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
          },
          "visibility": { "enum": ["public", "private"] }
        }
      }
    }
  }
}
