generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Subscription {
  id        Int    @id @default(autoincrement())
  playerId  Int
  channelId String
  player    Player @relation(fields: [playerId], references: [id])

  // JSON-serialized SubscriptionFilterSpec (@scout-for-lol/data); null = notify
  // all. Validated in the app via Zod; never queried in SQL.
  filters String?

  // Muted subscriptions stay intact (history, filters, channel wiring) but are
  // skipped when dispatching pre/post-match notifications.
  isMuted Boolean @default(false)

  // metadata
  serverId         String
  creatorDiscordId String
  createdTime      DateTime
  updatedTime      DateTime

  @@unique([serverId, playerId, channelId])
}

model Player {
  id                      Int                      @id @default(autoincrement())
  alias                   String
  discordId               String?
  accounts                Account[]
  subscriptions           Subscription[]
  competitionParticipants CompetitionParticipant[]
  competitionSnapshots    CompetitionSnapshot[]

  // metadata
  serverId         String
  creatorDiscordId String
  createdTime      DateTime
  updatedTime      DateTime

  @@unique([serverId, alias])
}

model Account {
  id       Int    @id @default(autoincrement())
  alias    String
  puuid    String
  region   String
  playerId Int
  player   Player @relation(fields: [playerId], references: [id])

  // Cached Riot ID (gameName#tagLine) resolved from the PUUID. Nullable
  // until first resolved; refreshed on read when older than 24h. Lets the
  // web UI show the real Riot ID instead of the user-chosen alias.
  riotGameName    String?
  riotTagLine     String?
  riotIdUpdatedAt DateTime?

  // Match processing tracking
  lastProcessedMatchId String? // Track last match we've processed to avoid duplicates
  lastMatchTime        DateTime? // Timestamp of the last match this player was in (for dynamic polling)
  lastCheckedAt        DateTime? // Timestamp of when we last checked for new matches (for polling intervals)

  // metadata
  serverId         String
  creatorDiscordId String
  createdTime      DateTime
  updatedTime      DateTime

  @@unique([serverId, puuid])
  // Hot path updates filter by puuid alone (post-match cursor writes); the
  // unique index is (serverId, puuid) and cannot serve those lookups.
  @@index([puuid])
}

// Global, self-maintaining cache of known summoners (Riot IDs are public).
// Powers fast prefix autocomplete in the web "add player" flow. Populated on
// confirmed Riot resolutions + backfill from Account; an entry is evicted when
// Riot can no longer resolve it (rename/deletion).
model SummonerIndex {
  id             Int      @id @default(autoincrement())
  puuid          String   @unique
  gameName       String
  tagLine        String
  region         String
  lastVerifiedAt DateTime
  createdTime    DateTime
  updatedTime    DateTime

  // Prefix-autocomplete on gameName (case-insensitive via Prisma mode:
  // "insensitive" → ILIKE; the b-tree index serves exact-prefix scans only).
  @@index([gameName])
}

model MatchRankHistory {
  id        Int    @id @default(autoincrement())
  matchId   String // Riot match ID
  puuid     String // Player PUUID
  queueType String // "solo" or "flex"

  // Rank snapshots (JSON serialized, nullable for unranked)
  rankBefore String? // JSON: {tier, division, lp, wins, losses}
  rankAfter  String? // JSON: {tier, division, lp, wins, losses}

  matchGameCreationAt DateTime? // Riot match info.gameCreation for historical attribution
  matchGameEndAt      DateTime? // Riot match info.gameEndTimestamp for rank ordering
  capturedAt          DateTime // When this was recorded

  @@unique([matchId, puuid, queueType])
  @@index([puuid, capturedAt])
  @@index([puuid, queueType, matchGameEndAt])
  @@index([matchId])
}

// Durable, globally deduplicated first-run import. The PUUID key makes one
// Riot snapshot serve every guild that tracks the same account.
model InitialMatchHistoryImport {
  puuid  String @id
  region String
  phase  String

  // JSON-serialized MatchId[] validated by the application. The list is
  // captured once so retries cannot move the notification boundary.
  matchIdsJson      String?
  snapshotAt        DateTime?
  nextMatchIndex    Int       @default(0)
  newestMatchId     String?
  newestMatchTime   DateTime?
  cursorHandedOffAt DateTime?

  attemptCount  Int       @default(0)
  lastAttemptAt DateTime?
  nextAttemptAt DateTime
  errorCode     String?

  requestedAt    DateTime
  completedAt    DateTime?
  lastImportedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([phase, nextAttemptAt, requestedAt])
}

// Current rank is not a per-match observation. Keeping it separate prevents
// imported games from fabricating historical LP deltas.
model CurrentRankSnapshot {
  puuid        String   @id
  soloRank     String?
  flexRank     String?
  ranked5sRank String?
  fetchedAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Report {
  id                     Int       @id @default(autoincrement())
  serverId               String
  ownerId                String
  channelId              String
  title                  String
  description            String?
  queryText              String
  isEnabled              Boolean   @default(true)
  isSystemManaged        Boolean   @default(false)
  systemSource           String?
  sourceCompetitionId    Int?
  cronExpression         String
  scheduleTimezone       String    @default("UTC")
  nextScheduledRunAt     DateTime?
  lastScheduledRunAt     DateTime?
  lastScheduledLocalDate String?
  lastRunStatus          String?
  lastRunError           String?
  createdTime            DateTime
  updatedTime            DateTime
  revision               Int       @default(1)

  runs ReportRun[]

  @@index([serverId, isEnabled])
  @@index([nextScheduledRunAt])
  @@index([sourceCompetitionId])
  @@index([systemSource])
}

/// Transactional projection from Postgres-owned report definitions to
/// Temporal Schedules. reportId deliberately has no foreign key so deletion
/// cannot erase the tombstone required to remove the Schedule.
model ReportScheduleOutbox {
  id          Int       @id @default(autoincrement())
  reportId    Int
  revision    Int
  operation   String
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@unique([reportId, revision])
  @@index([processedAt, createdAt])
}

model ReportRun {
  id                    Int       @id @default(autoincrement())
  reportId              Int
  serverId              String
  trigger               String
  status                String
  startedAt             DateTime
  completedAt           DateTime?
  durationMs            Int?
  rowsReturned          Int       @default(0)
  rowsScanned           Int       @default(0)
  errorMessage          String?
  // Faithful per-run archive of what was posted: the rendered text body and an
  // S3 key for the chart PNG (null for text-only formats or when S3 is off).
  renderedContent       String?
  imageS3Key            String?
  imageByteSize         Int?
  querySnapshot         String?
  visualizationS3Key    String?
  visualizationByteSize Int?
  deliveryState         String    @default("NOT_REQUESTED")
  // Snapshot the destination selected for this occurrence. Report edits must
  // not redirect an already-rendered delivery during replay/reconciliation.
  deliveryChannelId     String?
  deliveryServerId      String?
  deliveryError         String?
  deliveredAt           DateTime?
  temporalWorkflowRunId String?   @unique
  createdAt             DateTime  @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, startedAt])
  @@index([serverId, startedAt])
  @@index([status, startedAt])
  @@index([deliveryState, createdAt])
}

// Season metadata seeded from packages/data/src/seasons.ts on every bot startup.
// Competition.seasonId is a FK to Season.id; date drift is resolved by re-seeding.
model Season {
  id           String        @id
  displayName  String
  startDate    DateTime
  endDate      DateTime
  competitions Competition[]
}

model Competition {
  id               Int     @id @default(autoincrement())
  serverId         String
  ownerId          String // Discord user ID
  title            String
  description      String
  gameVariant      String  @default("MODERN")
  channelId        String
  isCancelled      Boolean @default(false)
  visibility       String // OPEN, INVITE_ONLY, SERVER_WIDE
  criteriaType     String // Enum stored as string
  criteriaConfig   String // JSON stored as string
  maxParticipants  Int     @default(100)
  analysisTimezone String  @default("UTC")

  // Time configuration (XOR: either fixed dates OR season)
  startDate DateTime?
  endDate   DateTime?
  seasonId  String?
  season    Season?   @relation(fields: [seasonId], references: [id])

  // Lifecycle tracking - when start/end processing was attempted
  // These prevent re-processing even if snapshot creation fails
  startProcessedAt           DateTime?
  endProcessedAt             DateTime?
  startNotifiedAt            DateTime?
  endNotifiedAt              DateTime?
  startNotificationMessageId String?
  endNotificationMessageId   String?

  // Optional leaderboard-post schedule. Legacy competitions remain disabled;
  // enabled schedules evaluate the CRON expression in scheduleTimezone.
  scheduledUpdatesEnabled Boolean   @default(false)
  updateCronExpression    String?
  scheduleTimezone        String    @default("UTC")
  // Next time the dispatcher should post a leaderboard update for this row.
  // The dispatcher selects rows where this is <= now (or NULL, as self-heal)
  // and recomputes this field from updateCronExpression after each post.
  nextScheduledUpdateAt   DateTime?
  // Wall-clock time of the most recent dispatched leaderboard post.
  lastScheduledUpdateAt   DateTime?

  // Relations
  participants CompetitionParticipant[]
  snapshots    CompetitionSnapshot[]

  // Metadata
  creatorDiscordId String
  createdTime      DateTime
  updatedTime      DateTime

  // Note: We do NOT have a unique constraint on [serverId, ownerId]
  // This allows users to create multiple competitions over time
  // The "one active competition per owner" rule is enforced in application logic
  @@index([serverId, isCancelled])
  @@index([serverId, ownerId, isCancelled])
  @@index([nextScheduledUpdateAt])
}

model CompetitionParticipant {
  id            Int       @id @default(autoincrement())
  competitionId Int
  playerId      Int
  status        String // INVITED, JOINED, LEFT
  invitedBy     String? // Discord user ID (nullable)
  invitedAt     DateTime? // When invited (nullable - null if joined directly)
  joinedAt      DateTime? // When joined (nullable - null if only invited)
  leftAt        DateTime? // When left (nullable - null if still participating)

  // Relations
  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  player      Player      @relation(fields: [playerId], references: [id])

  @@unique([competitionId, playerId])
  @@index([competitionId, status])
}

model CompetitionSnapshot {
  id            Int      @id @default(autoincrement())
  competitionId Int
  playerId      Int
  snapshotType  String // START, END
  snapshotData  String // JSON stored as string
  snapshotTime  DateTime

  // Relations
  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  player      Player      @relation(fields: [playerId], references: [id])

  @@unique([competitionId, playerId, snapshotType])
}

model ServerPermission {
  id            Int      @id @default(autoincrement())
  serverId      String
  discordUserId String
  // Canonical "resource:action" key from the RBAC catalog (@scout-for-lol/data),
  // e.g. "subscriptions:create". Legacy web-less grants "CREATE_COMPETITION" /
  // "CREATE_REPORT" were migrated to "competitions:create" / "reports:create".
  permission    String
  grantedBy     String // Discord user ID
  grantedAt     DateTime

  @@unique([serverId, discordUserId, permission])
  @@index([serverId, discordUserId]) // resolveGuildPermissions: a user's grants in a guild
  @@index([serverId]) // roles.list: all grants in a guild
}

model GuildPermissionError {
  id                    Int       @id @default(autoincrement())
  serverId              String
  channelId             String
  errorType             String // Type of permission error
  errorReason           String? // Detailed reason
  firstOccurrence       DateTime // When this error first occurred
  lastOccurrence        DateTime // Most recent occurrence
  consecutiveErrorCount Int       @default(1) // Number of consecutive errors
  lastSuccessfulSend    DateTime? // Last time a message was successfully sent to this server
  ownerNotified         Boolean   @default(false) // DEPRECATED (was the abandoned-guild latch); unused since notificationStage replaced it
  // Backed-off owner notification escalation for the current failure streak.
  // notificationStage: 0 = none sent, 1 = immediate sent, 2 = +1w sent, 3 = +1mo sent (terminal).
  // lastNotifiedAt anchors the next stage's delay (NOT firstOccurrence) so existing
  // mid-streak rows restart cleanly at "immediate" instead of jumping to "month".
  notificationStage     Int       @default(0)
  lastNotifiedAt        DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([serverId, channelId])
  @@index([serverId, consecutiveErrorCount])
  @@index([lastOccurrence])
}

// Central audit log of every direct message (DM) the bot sends to a user.
// All DMs MUST flow through `sendDM` (discord/utils/dm.ts), which writes one
// row here per attempt so DMs are fully traceable. Append-only.
model DmAuditLog {
  id             Int      @id @default(autoincrement())
  recipientId    String // Discord user (snowflake) the DM was addressed to
  recipientTag   String? // Discord tag at send time, when resolvable
  guildId        String? // Guild this DM relates to, when applicable
  kind           String // Category, e.g. "permission_error" | "abandonment" | "feedback_request" | "competition_invite" | "prune_notice"
  content        String // The message body that was (attempted to be) sent
  deliveryStatus String // "sent" | "dm_disabled" | "failed" | "budget_exhausted" | "deferred"
  // Ladder rung this message represented, for budgeted outreach only.
  // Persisted because the Nth delivered message is NOT necessarily rung N:
  // a bounced rung-1 DM followed by a delivered rung-2 DM would otherwise be
  // reconstructed as rung 1, mis-attributing conversions and letting a former
  // installer receive a repeat of a rung they already got.
  ladderStage    Int?
  errorMessage   String? // Failure detail when delivery != "sent"
  createdAt      DateTime @default(now())

  @@index([recipientId, createdAt])
  @@index([kind, createdAt])
  @@index([guildId, createdAt])
}

// =============================================================================
// Desktop Voice Notification System
// =============================================================================

model User {
  discordId           String    @id // Discord snowflake ID
  discordUsername     String
  discordAvatar       String?
  discordAccessToken  String?
  discordRefreshToken String?
  tokenExpiresAt      DateTime?
  // Opaque, app-owned analytics identity. PostHog must never receive the
  // Discord snowflake as a distinct id: that is an external identifier the
  // analytics registry forbids sending, and using it as the join key would
  // make every event and recording addressable by Discord account. Same role
  // for a person as `GuildInstall.analyticsInstallationId` has for an install.
  analyticsUserId     String    @unique @default(uuid())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  // Best-effort dashboard activity marker for DB-side MAU/WAU, written by the
  // authenticated request context at most once per hour per user. `updatedAt`
  // cannot answer this: it moves on token refresh, not on activity.
  lastSeenAt          DateTime?

  apiTokens            ApiToken[]
  soundPacks           SoundPack[]
  desktopClients       DesktopClient[]
  storedSounds         StoredSound[]
  exploreConversations ExploreConversation[]
}

/// A saved explore conversation. Explore queries the whole report lake rather
/// than one server's data, so a conversation belongs to a person, not a guild.
model ExploreConversation {
  id            String    @id @default(uuid())
  userId        String
  title         String
  /// Set when the owner shares the conversation; null means private. Opaque
  /// and unguessable rather than derived from `id`, because possession of the
  /// token is the only credential a share link carries.
  shareToken    String?   @unique
  sharedAt      DateTime?
  /// Which leaf of the message tree the owner is currently looking at. The
  /// active transcript is the path from this message back to the root.
  currentLeafId String?
  /// The leaf the share link is pinned to, captured when the conversation was
  /// shared. Without it, branching after sharing would silently change what a
  /// link shows — the same freeze guarantee the stored results already give.
  sharedLeafId  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user     User             @relation(fields: [userId], references: [discordId], onDelete: Cascade)
  messages ExploreMessage[]

  @@index([userId, updatedAt])
}

/// One turn of an explore conversation, as a node in a tree.
///
/// Turns form a tree rather than a list so editing a question or regenerating
/// an answer forks a sibling instead of destroying what was there. Messages
/// sharing a `parentId` are versions of each other — that is what the `‹ 1/2 ›`
/// arrows page through — and nothing is ever deleted to make a new one.
///
/// Assistant turns store the rendered result inline — the preview rows and the
/// visualization snapshot the asker actually saw. A shared conversation is
/// therefore frozen by construction: rendering it needs no re-execution, so a
/// share link cannot silently change meaning as the lake grows, and an
/// anonymous viewer costs no query.
model ExploreMessage {
  id             String   @id @default(uuid())
  conversationId String
  /// Null for the opening message. Siblings under one parent are versions.
  parentId       String?
  /// "user" or "assistant".
  role           String
  content        String
  /// The ScoutQL the answer rests on, when the turn ran one.
  queryText      String?
  /// JSON string arrays; empty when the turn produced none.
  caveats        String   @default("[]")
  followUps      String   @default("[]")
  /// JSON blobs matching ReportAiPreviewSummarySchema / VisualizationSnapshotSchema.
  preview        String?
  visualization  String?
  /// JSON array of the tool calls this turn made, for the reasoning panel.
  trace          String?
  createdAt      DateTime @default(now())

  conversation ExploreConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  parent       ExploreMessage?     @relation("ExploreMessageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     ExploreMessage[]    @relation("ExploreMessageTree")

  @@index([conversationId])
  @@index([conversationId, parentId])
}

model ApiToken {
  id         Int       @id @default(autoincrement())
  userId     String
  user       User      @relation(fields: [userId], references: [discordId], onDelete: Cascade)
  token      String    @unique // hashed token
  name       String
  scopes     String    @default("events:write")
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
}

model DesktopClient {
  id                Int        @id @default(autoincrement())
  userId            String
  user              User       @relation(fields: [userId], references: [discordId], onDelete: Cascade)
  clientId          String     @unique // UUID generated on first connection
  hostname          String?
  isConnected       Boolean    @default(false)
  lastHeartbeat     DateTime?
  currentGameId     String? // Game ID if in active game
  voiceChannelId    String? // Discord voice channel to join
  guildId           String? // Discord guild ID for voice
  activeSoundPackId Int?
  activeSoundPack   SoundPack? @relation(fields: [activeSoundPackId], references: [id])
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([userId])
}

model SoundPack {
  id          Int      @id @default(autoincrement())
  userId      String
  user        User     @relation(fields: [userId], references: [discordId], onDelete: Cascade)
  name        String
  version     String   @default("1.0.0")
  description String?
  isPublic    Boolean  @default(false) // Whether other users can use this pack
  settings    String // JSON: { masterVolume: number, normalization: boolean }
  defaults    String // JSON: { gameStart?: SoundPool, kill?: SoundPool, ... }
  rules       String // JSON: SoundRule[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  desktopClients DesktopClient[]

  @@unique([userId, name])
  @@index([userId])
  @@index([isPublic])
}

model StoredSound {
  id           Int      @id @default(autoincrement())
  userId       String
  user         User     @relation(fields: [userId], references: [discordId], onDelete: Cascade)
  s3Key        String   @unique // S3/R2 object key
  originalName String // Original filename
  mimeType     String
  sizeBytes    Int
  durationMs   Int?
  sourceType   String // "upload", "youtube", "url"
  sourceUrl    String? // Original URL if from YouTube/URL
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([sourceUrl])
}

model GuildInstall {
  id                        Int       @id @default(autoincrement())
  serverId                  String    @unique
  serverName                String
  ownerDiscordId            String
  addedByDiscordId          String // Installer (from audit log), fallback to ownerId
  memberCount               Int
  installedAt               DateTime
  analyticsInstallationId   String    @unique @default(uuid())
  analyticsLifecycleTracked Boolean   @default(true)
  firstSubscriptionAt       DateTime?
  firstCoreOutputAt         DateTime?
  // Legacy one-shot markers, kept for one release so a rollback can still read
  // them. No longer written; DmAuditLog is the source of truth.
  outreach3dSentAt          DateTime?
  outreach14dSentAt         DateTime?
  outreach30dSentAt         DateTime?

  // Outreach budget, ladder position, and "have we asked for feedback?" are
  // NOT stored here. They are derived from DmAuditLog rows created after
  // `installedAt` — the durable record of what was actually delivered.
  //
  // A derived counter cannot drift from reality when a write fails, cannot
  // disagree with the "Message N of 3" text it produces, and makes a re-install
  // reset the whole ladder for free by simply moving `installedAt` forward.

  // Set once the one-time email nudge has been sent (see the email channel).
  emailNudgeSentAt DateTime?

  // Set when guildDelete confirms a removal; cleared on the next install.
  // This is the ONLY signal that distinguishes a genuine re-install (which
  // should restart onboarding) from a spurious `guildCreate` for a guild we
  // never left. `cleanupRemovedGuild` deliberately keeps this row, so row
  // existence alone cannot tell the two apart.
  removedAt DateTime?

  // Web-flow install attribution for THIS installation (cleared with the
  // identity rotation on reinstall). Stamped by whichever of the
  // /app/installed mutation or the guildCreate reconciler runs second — see
  // analytics/install-attribution.ts.
  attributedAt       DateTime?
  attributionSurface String?

  @@index([installedAt])
}

/// A single-use, server-minted token that rides Discord's OAuth `state`
/// parameter through the bot-install round trip. Minted by
/// /api/discord/install, echoed by Discord to /app/installed, and consumed by
/// the installAttribution.complete mutation. A consumed-but-unreconciled row
/// is also the pending-attribution store for the browser-beats-gateway race.
model InstallAttributionToken {
  id           Int       @id @default(autoincrement())
  token        String    @unique
  discordId    String
  surface      String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  consumedAt   DateTime?
  guildId      String?
  reconciledAt DateTime?

  @@index([guildId, reconciledAt])
  @@index([expiresAt])
}

/// Free-text feedback submitted from the web dashboard.
///
/// Exists because every prior feedback path was a one-way DM ending in "reply
/// to a human" — there was nowhere for an answer to land, so nothing was ever
/// captured. Append-only.
model Feedback {
  id        Int      @id @default(autoincrement())
  discordId String // Submitting web user
  serverId  String? // Guild in context when submitted, when known
  rating    Int? // Optional 1-5 sentiment
  body      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([discordId, createdAt])
}

/// A recorded outreach conversion: a guild whose FIRST subscription appeared
/// within the attribution window after a delivered outreach message.
///
/// Written once, never recomputed. Deriving it from live subscriptions made a
/// historical experiment result *decrease* as converted guilds churned —
/// `cleanupRemovedGuild` deletes their subscriptions, so the evidence vanished
/// and the next recompute subtracted them. Scoped to the installation so a
/// quick re-install cannot attribute a new subscription to the old one.
/// Records that a user has answered — or dismissed — the one-time in-app
/// feedback prompt. Server-side because localStorage is per-browser: the same
/// account was otherwise re-prompted on another device, in a private window, or
/// after clearing site data, contradicting the "we'll only ask you once"
/// promise the dialog makes.
model FeedbackPromptState {
  discordId   String   @id
  dismissedAt DateTime @default(now())
  submitted   Boolean  @default(false)
}

model OutreachConversion {
  id          Int      @id @default(autoincrement())
  serverId    String
  /// Install this conversion belongs to, so re-installs are distinct.
  installedAt DateTime
  /// Ladder rung of the message credited with the conversion.
  ladderStage Int
  convertedAt DateTime @default(now())

  @@unique([serverId, installedAt])
  @@index([ladderStage])
}

model BotState {
  id                   Int       @id @default(1)
  lastSuccessfulPollAt DateTime?
  updatedAt            DateTime  @updatedAt
}

model ActiveGame {
  id                  Int      @id @default(autoincrement())
  gameId              BigInt // Riot game ID (from Spectator V5 API)
  trackedPuuids       String // JSON array of tracked puuids detected in this game
  prematchMessageIds  String? // JSON object: Discord channel ID -> prematch message ID
  // JSON object: Discord channel ID -> postmatch report message ID.
  //
  // The Bryan Bucks settlement embed replies to the postmatch report, and the
  // report IDs were previously held only in an in-memory Map for the duration
  // of one poll. A restart between delivering the report and announcing the
  // settlement permanently lost the reply target, because the settlement
  // summary is one-shot and a later pass returns nothing for an already
  // settled pool.
  postmatchMessageIds String?
  prematchMatchId     String?  @unique // Platform-qualified Riot match ID and active-game key
  detectedAt          DateTime // When we first detected this game
  expiresAt           DateTime // TTL: auto-cleanup after this time (detectedAt + 3 hours)
  updatedAt           DateTime @updatedAt

  @@index([expiresAt])
}

model GameEventLog {
  id          Int      @id @default(autoincrement())
  userId      String
  clientId    String
  eventType   String // "kill", "multikill", "objective", etc.
  eventData   String // JSON of event context
  soundPlayed String? // Sound ID that was played
  timestamp   DateTime @default(now())

  @@index([userId, timestamp])
  @@index([clientId, timestamp])
}

// Records every match for which the AI review pipeline has been entered.
// Insert happens BEFORE the first OpenAI call so that even a mid-pipeline
// crash leaves a row behind, preventing duplicate spend on the next poll.
// Pure dedup table — one row per match, never reprocessed.
model MatchAiAttempt {
  matchId     String   @id // Riot match ID, e.g. EUW1_7843083474
  attemptedAt DateTime @default(now())
}

// A guild the reconcile-removed-guilds sweep saw missing from the client
// cache AND unconfirmed by a live `guilds.fetch` (Discord 10004) on some
// previous day's run. Cleanup only proceeds once a candidate has been
// re-observed as missing on a LATER calendar day than `firstDetectedAt` -
// a single day's outage (Discord region/shard down, cache hydration gap)
// resolves well within 24h, while a real removal stays missing across runs.
// The row is deleted as soon as a run finds the guild reachable again
// (recovered) or after cleanup runs (confirmed and handled).
model GuildRemovalCandidate {
  serverId        String   @id
  firstDetectedAt DateTime
  lastCheckedAt   DateTime
}

// Web-UI initiated subscription changes. Every mutation through the web UI
// records a row so we can audit who added/removed what from outside Discord.
model AuditLog {
  id              Int      @id @default(autoincrement())
  createdAt       DateTime @default(now())
  actorDiscordId  String
  serverId        String
  action          String // AuditAction enum value
  targetChannelId String?
  targetPlayerId  Int?
  targetAccountId Int?
  payload         String // JSON-encoded before/after snapshot
  ipAddress       String?
  userAgent       String?

  @@index([serverId, createdAt])
  @@index([actorDiscordId, createdAt])
}

// ============================================================================
// Bryan Bucks — friendly betting economy
//
// Gated per guild by the `betting_enabled` flag. Players earn Bucks for ranked
// games and offer up to an amount on whether a tracked player wins an
// in-progress game. Human offers and a capped house fill determine the amount
// actually at risk. No monetary value; nothing transfers to real goods.
// ============================================================================

// A Bryan Bucks wallet: one per (guild, Discord user).
//
// Scoped per guild because `Player`, `Subscription`, and the `betting_enabled`
// flag are all per guild. A global wallet would let Bucks earned in an opted-in
// server be spent in one that never opted in.
//
// `balance` is a STORED column, not a ledger sum. This does NOT contradict the
// DmAuditLog "derive, never store" rule: that rule exists because a counter
// written AFTER a non-transactional side effect (a Discord send) goes stale if
// its write fails. Here the balance mutation and its BucksLedgerEntry commit in
// the SAME prisma.$transaction, through the single chokepoint in
// src/betting/ledger.ts, so they cannot disagree.
//
// Storing it is also the only way to check affordability atomically on this
// stack. `SELECT SUM(delta)` then `INSERT` is a read-then-write inside a WAL
// transaction, and the libsql adapter opens a deferred BEGIN — a concurrent
// committer yields SQLITE_BUSY_SNAPSHOT, which `busy_timeout` does NOT retry.
// One guarded `UPDATE ... WHERE balance >= :stake` is the whole check.
//
// `reconcileBucksBalances()` re-derives from the ledger and reports drift
// rather than trusting this column.
model BucksAccount {
  id                Int       @id @default(autoincrement())
  serverId          String
  discordId         String
  // Opaque, app-owned identity for Bryan Bucks PostHog retention. The
  // Discord snowflake must never become an analytics distinct id.
  analyticsUserId   String    @unique @default(uuid())
  // Synthetic per-guild house rows use the reserved account ID. They are
  // ledger-audited but excluded from user-facing balances and leaderboards.
  isHouse           Boolean   @default(false)
  balance           Int       @default(0)
  // Retired with the peek feature; no code reads or writes this anymore.
  // Kept for one compatibility release so a rollback to the pre-removal
  // image (which still writes it) doesn't hit a missing column. Drop in a
  // follow-up migration once this release is no longer a rollback target.
  peekPassExpiresAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  ledgerEntries    BucksLedgerEntry[]
  bets             BucksBet[]
  parlayBets       BucksParlayBet[]
  weeklyParlayBets BucksWeeklyParlayBet[]
  openPositions    BucksOpenPosition[]

  @@unique([serverId, discordId])
  @@index([serverId, balance])
}

// Per-user Bryan Bucks settlement DM preferences. Missing rows intentionally
// resolve to both settings enabled so adding this table preserves the existing
// beta behavior for users who have not visited `/bb notifications` yet.
model BucksNotificationPreference {
  id                        Int       @id @default(autoincrement())
  serverId                  String
  discordId                 String
  ownBetSettlementDms       Boolean   @default(true)
  betsOnPlayerSettlementDms Boolean   @default(true)
  settlementDmHintShownAt   DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@unique([serverId, discordId])
}

// Durable reservation for a Bryan Bucks PostHog event. PostHog's event UUID is
// deterministic for replay, while this beta database is the idempotency
// boundary for both the historical backfill and the post-commit live sync.
model BucksAnalyticsBackfillEvent {
  id        Int      @id @default(autoincrement())
  eventId   String   @unique
  createdAt DateTime @default(now())
}

// Append-only ledger. Every Buck anyone holds is the sum of these rows.
//
// This is what answers "how did they get these points": `kind` says why,
// `matchId` says which game, `predictedTeamId`/`actualWinningTeamId` say what
// was predicted versus what happened, and `context` carries the participant
// snapshot frozen at write time. Player rows are renameable, untrackable, and
// prunable — a ledger that re-derives its own explanation is not a ledger.
model BucksLedgerEntry {
  id             Int          @id @default(autoincrement())
  bucksAccountId Int
  bucksAccount   BucksAccount @relation(fields: [bucksAccountId], references: [id], onDelete: Cascade)

  // Signed change. Negative = reserved stake, match funding, or fee paid.
  // Positive = earning, payout, refund, fee received, or seed grant. Never zero.
  delta Int

  // Balance AFTER this delta, as of the committing transaction. Makes an audit
  // read one query, and localizes any drift to a specific row.
  balanceAfter Int

  // BucksLedgerKind (@scout-for-lol/data): seed | earn_* | bet_stake |
  // bet_payout | bet_*_refund | winner_fee | house_match | cancel_fee |
  // parlay_stake | parlay_reserve | parlay_payout | parlay_refund |
  // parlay_release | transfer_sent | transfer_received | transfer_fee |
  // legacy bet_refund/house_rake/peek_pass | adjustment.
  // Not a Prisma enum (kept a plain string through the Postgres migration).
  // Zod-validated on write
  // and on read.
  kind String

  // Platform-qualified Riot match ID. Null only for seed/adjustment.
  matchId String?

  betId Int?
  bet   BucksBet? @relation(fields: [betId], references: [id])

  parlayBetId Int?
  parlayBet   BucksParlayBet? @relation(fields: [parlayBetId], references: [id])

  weeklyParlayBetId Int?
  weeklyParlayBet   BucksWeeklyParlayBet? @relation(fields: [weeklyParlayBetId], references: [id])

  // Riot team IDs (100/200). Both null for seed/earn_*/adjustment.
  // `actualWinningTeamId` is also null for bet_stake (unknown at bet time) and
  // for a refund on a voided match (there is no winner).
  predictedTeamId     Int?
  actualWinningTeamId Int?

  // JSON, BucksLedgerContextSchema. Frozen at write time.
  context String

  createdAt DateTime @default(now())

  analyticsOutbox BucksAnalyticsLedgerOutbox?

  @@index([bucksAccountId, createdAt])
  @@index([matchId])
}

// Created atomically with each live ledger entry. Temporal consumes the
// committed ledger row after the transaction and sends the PostHog event.
model BucksAnalyticsLedgerOutbox {
  id            Int              @id @default(autoincrement())
  ledgerEntryId Int              @unique
  ledgerEntry   BucksLedgerEntry @relation(fields: [ledgerEntryId], references: [id], onDelete: Cascade)
  eventId       String           @unique
  createdAt     DateTime         @default(now())

  @@index([createdAt])
}

// One user's position on one match in one guild.
//
// `stake` is the maximum the user offered and is DEBITED at placement. At
// close, only matched stake remains at risk and unmatched stake is refunded.
model BucksBet {
  id             Int            @id @default(autoincrement())
  poolId         Int
  pool           BucksMatchPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  bucksAccountId Int
  bucksAccount   BucksAccount   @relation(fields: [bucksAccountId], references: [id], onDelete: Cascade)

  // Riot team ID the user is backing: 100 or 200.
  predictedTeamId Int

  // Display-only tracked-player anchor used to identify the game and preserve
  // the v1 subject-relative button encoding. `predictedTeamId` alone defines
  // the wager and settlement outcome.
  subjectPuuid String

  // Running submitted maximum. Adding to an open position increments this;
  // each increment writes its own bet_stake ledger row.
  stake Int

  // Null on historical rows written before close-time matching. For new rows,
  // matchedStake == humanMatchedStake + houseMatchedStake and
  // stake == matchedStake + unmatchedStake.
  humanMatchedStake Int?
  houseMatchedStake Int?
  matchedStake      Int?
  unmatchedStake    Int?

  // BucksBetOutcome: pending | won | lost | refunded | cancelled.
  // Deliberately not named `status` — brand-prisma-types would type it
  // ParticipantStatus.
  betOutcome String @default("pending")

  // Matched-stake settlement accounting. Unmatched refunds are separate ledger
  // entries and are not included here. Cancellation stores the gross submitted
  // stake, fee, and net refund in these same lifecycle fields.
  grossPayout Int?
  fee         Int?
  payout      Int?
  cancelledAt DateTime?
  settledAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerEntries BucksLedgerEntry[]
  openPosition  BucksOpenPosition?

  // Historical and cancelled attempts are retained. BucksOpenPosition owns the
  // one-live-position constraint while the market is open.
  @@index([poolId, bucksAccountId])
  @@index([poolId, predictedTeamId])
}

// The one currently editable offer for a user in a pool. Deleting this slot on
// cancellation preserves the BucksBet and its ledger links while allowing a
// fresh offer, including on the other side.
model BucksOpenPosition {
  poolId         Int
  pool           BucksMatchPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  bucksAccountId Int
  bucksAccount   BucksAccount   @relation(fields: [bucksAccountId], references: [id], onDelete: Cascade)
  betId          Int            @unique
  bet            BucksBet       @relation(fields: [betId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())

  @@id([poolId, bucksAccountId])
  @@index([poolId])
}

// The betting market for one Riot match in one guild.
//
// Per guild, not per match: one match can be announced in several guilds, and
// paying guild A's winners out of guild B's losers would be wrong.
//
// Not a column on ActiveGame — that row has a 3-hour TTL and is swept every
// poll, and staked Bucks must outlive it.
model BucksMatchPool {
  id       Int    @id @default(autoincrement())
  matchId  String
  serverId String

  // Copied from ActiveGame so the window does not depend on a row the TTL
  // sweep deletes.
  detectedAt DateTime

  // Retired with the peek feature; no code reads this anymore, but
  // pool-open.ts still computes and writes a compatibility value (see its
  // computeLegacyPeekAvailableAt) so a rollback to the pre-removal image —
  // whose Prisma schema still declares this NOT NULL and whose peek.ts
  // candidate query decodes it unconditionally — can still read pools this
  // code creates. Stop writing it and drop the column in a follow-up
  // migration once this release is no longer a rollback target.
  peekAvailableAt DateTime?

  // STORED rather than computed, so changing BETTING_WINDOW_MS cannot
  // retroactively move a window a user was already shown.
  closesAt DateTime

  queueType String?

  // JSON, BucksPoolRosterSchema: both teams as seen on the loading screen.
  // Frozen at pool creation — this is what the bettor actually saw.
  roster String

  // JSON [{ channelId, messageId }] for THIS guild, recorded after the prematch
  // send so the close sweep can edit exactly the right messages without
  // re-deriving channel -> guild.
  messageRefs String @default("[]")

  // The non-betting content of the prematch Discord message. Stored alongside
  // messageRefs after delivery so live bet summaries can replace message
  // content with a direct PATCH and no Read Message History permission. Null
  // identifies a pre-deployment or not-yet-delivered pool and must not be
  // edited, because reconstructing its existing message would be guesswork.
  prematchContentBase String?

  // BucksPoolState: open | closed | settled | voided.
  //
  // Advanced only by guarded conditional updates. This column IS the settlement
  // idempotency token — unlike MatchAiAttempt, which must be marked BEFORE its
  // call because OpenAI spend is external and cannot join a database
  // transaction. Every side effect here is local, so the state transition
  // commits WITH the payouts. A separate marker table would reintroduce the
  // exact "marked but didn't happen" window it was invented to close.
  poolState String @default("open")

  // Set atomically with close-time allocation. matchingJson is a versioned
  // BucksMatchingSummary and is the audit record for every matched/refunded BB.
  matchedAt    DateTime?
  matchingJson String?

  // Riot team ID that won. Non-null iff poolState == "settled".
  winningTeamId Int?

  // BucksVoidReason: remake | expired | unsupported_mode, plus historical
  // no_counterparty and house_unavailable values.
  // Non-null iff poolState == "voided".
  voidReason String?

  // Serialized Prediction, for the postmatch recap and later calibration.
  predictionJson String?

  settledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bets          BucksBet[]
  parlayMarket  BucksParlayMarket?
  openPositions BucksOpenPosition[]

  @@unique([matchId, serverId])
  @@index([poolState, closesAt])
  @@index([serverId, poolState, settledAt])
  @@index([matchId])
}

// One immutable, model-generated proposition per Riot match. The model chooses
// only from the versioned criteria catalog; `criteria` is evaluated later by
// deterministic code against the final RawMatch.
model BucksParlayDefinition {
  id             Int    @id @default(autoincrement())
  matchId        String @unique
  queueType      String
  selectedTeamId Int

  // JSON validated by ParlaySubjectsSchema / GeneratedParlaySchema.
  subjects String
  criteria String

  yesProbabilityBps Int
  promptVersion     String
  catalogVersion    String
  schemaVersion     Int
  evaluatorVersion  String
  generationContext String

  // Pass-one legs, before any number was chosen, and the frozen record of how
  // the published price was measured. Nullable because definitions written by
  // the single-pass generator predate both.
  proposal String?
  pricing  String?

  requestedModel String
  resolvedModel  String?
  usage          String
  durationMs     Int

  createdAt DateTime @default(now())

  markets BucksParlayMarket[]
}

// A guild-local publication of the match-global parlay. Its clock starts when
// the follow-up is published and is independent from the outcome pool clock.
model BucksParlayMarket {
  id            Int                   @id @default(autoincrement())
  definitionId  Int
  definition    BucksParlayDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  outcomePoolId Int                   @unique
  outcomePool   BucksMatchPool        @relation(fields: [outcomePoolId], references: [id], onDelete: Cascade)
  matchId       String
  serverId      String

  publishedAt DateTime
  closesAt    DateTime
  messageRefs String   @default("[]")

  // BucksParlayMarketState: publishing | open | closed | settled | voided.
  marketState String    @default("publishing")
  yesResult   Boolean?
  legResults  String?
  // BucksParlayVoidReason when voided.
  voidReason  String?
  settledAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bets BucksParlayBet[]

  @@unique([matchId, serverId])
  @@index([marketState, closesAt])
  @@index([matchId])
}

// One fixed-odds YES/NO position per user and parlay market. Both the user
// stake and the maximum house liability are debited when the quote is accepted.
model BucksParlayBet {
  id             Int               @id @default(autoincrement())
  marketId       Int
  market         BucksParlayMarket @relation(fields: [marketId], references: [id], onDelete: Cascade)
  bucksAccountId Int
  bucksAccount   BucksAccount      @relation(fields: [bucksAccountId], references: [id], onDelete: Cascade)

  // BucksParlaySide: YES | NO.
  side         String
  stake        Int
  houseReserve Int
  grossPayout  Int

  // BucksBetOutcome: pending | won | lost | refunded.
  betOutcome String    @default("pending")
  payout     Int?
  settledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerEntries BucksLedgerEntry[]

  @@unique([marketId, bucksAccountId])
  @@index([marketId, side])
}

// Immutable cross-game proposition for one guild-local Pacific scoring period.
// The subject/account snapshots and every generation/pricing input are frozen
// here so later alias, account, model, or catalog changes cannot alter it.
model BucksWeeklyParlayDefinition {
  id        Int    @id @default(autoincrement())
  serverId  String
  periodKey String
  slot      Int

  openAt          DateTime
  bettingClosesAt DateTime
  scoringStartsAt DateTime
  scoringEndsAt   DateTime

  subjects       String
  eligibleQueues String
  proposal       String
  criteria       String
  historySample  String
  pricing        String

  yesProbabilityBps Int
  promptVersion     String
  catalogVersion    String
  schemaVersion     Int
  evaluatorVersion  String
  pricingVersion    String
  generationContext String
  requestedModel    String
  resolvedModel     String?
  usage             String
  durationMs        Int

  createdAt DateTime @default(now())

  market        BucksWeeklyParlayMarket?
  contributions BucksWeeklyParlayContribution[]

  @@unique([serverId, scoringStartsAt, slot])
  @@unique([serverId, periodKey, slot])
  @@index([scoringStartsAt, scoringEndsAt])
}

// Guild-local publication and settlement state for one weekly definition.
model BucksWeeklyParlayMarket {
  id           Int                         @id @default(autoincrement())
  definitionId Int                         @unique
  definition   BucksWeeklyParlayDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  serverId     String
  periodKey    String
  slot         Int

  publishedAt     DateTime
  bettingClosesAt DateTime
  scoringEndsAt   DateTime
  messageRefs     String   @default("[]")

  // publishing | open | active | settled | voided
  marketState String    @default("publishing")
  yesResult   Boolean?
  legResults  String?
  voidReason  String?
  settledAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bets       BucksWeeklyParlayBet[]
  deliveries BucksWeeklyParlayDelivery[]

  @@unique([serverId, periodKey, slot])
  @@index([marketState, bettingClosesAt])
  @@index([marketState, scoringEndsAt])
}

// One fixed-odds YES/NO position per wallet and weekly market.
model BucksWeeklyParlayBet {
  id             Int                     @id @default(autoincrement())
  marketId       Int
  market         BucksWeeklyParlayMarket @relation(fields: [marketId], references: [id], onDelete: Cascade)
  bucksAccountId Int
  bucksAccount   BucksAccount            @relation(fields: [bucksAccountId], references: [id], onDelete: Cascade)

  side         String
  stake        Int
  houseReserve Int
  grossPayout  Int
  betOutcome   String    @default("pending")
  payout       Int?
  settledAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerEntries BucksLedgerEntry[]

  @@unique([marketId, bucksAccountId])
  @@index([marketId, side])
}

// Idempotent contribution from one completed, eligible match for one frozen
// subject. Progress and settlement are derived only from these rows.
model BucksWeeklyParlayContribution {
  id           Int                         @id @default(autoincrement())
  definitionId Int
  definition   BucksWeeklyParlayDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  matchId      String
  subjectKey   String
  completedAt  DateTime
  ingestedAt   DateTime
  queueType    String
  snapshot     String
  createdAt    DateTime                    @default(now())

  @@unique([definitionId, matchId, subjectKey])
  @@index([definitionId, completedAt])
  @@index([matchId])
}

// One durable Discord action attempt per market/action key. The action key is
// also the enforced Discord nonce, so activity retries cannot duplicate posts.
model BucksWeeklyParlayDelivery {
  id            Int                     @id @default(autoincrement())
  marketId      Int
  market        BucksWeeklyParlayMarket @relation(fields: [marketId], references: [id], onDelete: Cascade)
  actionKey     String
  kind          String
  scheduledAt   DateTime
  deliveryState String                  @default("pending")
  messageRefs   String                  @default("[]")
  attemptedAt   DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([marketId, actionKey])
  @@index([deliveryState, scheduledAt])
}

// Durable marker for Bucks EARNINGS on a (match, guild).
//
// A pending row is created before wallet funding so house exhaustion leaves a
// retryable record even though the post-match cursor advances. The awarding
// transaction claims it as processing with its FIRST write, then completes it
// with the earn ledger rows. A failed transaction rolls the claim back to
// pending; the composite primary key still guards concurrent replays.
// `awardedAt` is refreshed when the pending row completes, so it is the actual
// award time for completed rows; while pending it is the marker creation time.
// `retryAt` rotates failed rows out of the bounded recovery batch, and the
// target snapshot preserves the original guild recipients across config drift;
// matchCreatedAt points S3 recovery at the match's game-date partition.
//
// Earnings need their own marker because, unlike settlement, they have no
// natural per-(match, guild) row to carry the state.
model BucksMatchEarning {
  matchId   String
  serverId  String
  awardedAt DateTime @default(now())

  // postmatch is the normal Match-V5 award; prematch is the one-time League
  // Classic participation grant, which has no supported post-game payload.
  phase String @default("postmatch")

  // pending means wallet funding was unavailable and the match must be retried;
  // processing is held only inside the awarding transaction; complete is the
  // durable exactly-once result.
  state String @default("complete")

  targetSnapshotJson String   @default("[]")
  retryAt            DateTime @default(now())
  matchCreatedAt     DateTime @default(now())

  // Number of ledger rows written, so reconciliation is one comparison once
  // the marker is complete.
  entryCount Int

  @@id([matchId, serverId])
  @@index([phase, state, retryAt])
  @@index([state, retryAt])
}

// The complete non-house standings exactly as one Friday 5 PM PT leaderboard
// post disclosed them. The web leaderboard reads only this table — never live
// balances — so the deliberate no-on-demand-leaderboard rule survives a second
// surface, and the table doubles as an audit of exactly what was disclosed
// each week. `runWeek` shares the weekly post's chunk-nonce clock, so a cron
// retry upserts its own week instead of duplicating it.
model BucksWeeklyLeaderboardSnapshot {
  id         Int      @id @default(autoincrement())
  serverId   String
  runWeek    Int
  postedAt   DateTime @default(now())
  entryCount Int
  // JSON, BucksWeeklyLeaderboardEntriesSchema
  entries    String
  createdAt  DateTime @default(now())

  @@unique([serverId, runWeek])
  @@index([serverId, postedAt])
}

// =============================================================================
// Tournament-code custom lobbies
//
// Riot removed custom games from the public API for privacy reasons, so
// Spectator sees them only unreliably and Match-V5 does not carry them at all.
// The one sanctioned exception is the Tournament API: a game created from a
// tournament code IS recorded in Match-V5, with `info.tournamentCode`
// populated. These two tables are what let Scout mint such a lobby and follow
// it to its report.
//
// Deliberately provider-agnostic: only Int/String/BigInt/DateTime/Boolean, no
// Prisma enum (SQLite has none) and no @db.* native types. Enum-shaped columns
// are TEXT validated by Zod on read and write, matching how `AuditLog.action`
// and `DmAuditLog.kind` already work. That keeps the migration portable across
// the pending Postgres cutover.
// =============================================================================

/// A registered tournament provider and tournament.
///
/// Both are long-lived registrations produced by an API call, not per-game
/// state and not a credential — so they live here rather than in 1Password or
/// an env var. Created by scripts/register-tournament-provider.ts; call sites
/// read the row and fail loudly naming that script when it is absent, rather
/// than lazily creating one (which would race two concurrent /lobby create
/// calls into two providers and silently mint a new one on a fresh volume).
///
/// Keyed by (apiMode, region) because stub and live IDs are different
/// namespaces: a code minted under the stub is meaningless under the live API.
model TournamentRegistration {
  id               Int      @id @default(autoincrement())
  apiMode          String // TournamentApiMode: "stub" | "live"
  /// Riot tournament region code, e.g. "NA". Deliberately NOT named `region`:
  /// that field name is branded as Scout's own Region enum, and these are a
  /// different naming scheme entirely.
  tournamentRegion String
  providerId       Int
  tournamentId     Int
  callbackUrl      String
  name             String
  createdAt        DateTime @default(now())

  @@unique([apiMode, tournamentRegion])
}

/// One Scout-created custom lobby, from minted code to delivered report.
///
/// Not folded into ActiveGame: that row is keyed by prematchMatchId, which does
/// not exist until a game starts, and it is hard-deleted every 30 seconds once
/// past its 3-hour TTL. A lobby exists before any game, may never produce one,
/// and has to survive for /lobby status and for audit.
///
/// The link to ActiveGame is by value — TournamentLobby.matchId equals
/// ActiveGame.prematchMatchId — so the post-match reply path needs no change.
model TournamentLobby {
  id           Int    @id @default(autoincrement())
  /// The Riot tournament code. This is the join credential, so it is never
  /// posted to a public channel.
  code         String @unique
  apiMode      String // TournamentApiMode
  providerId   Int
  tournamentId Int
  /// Scout Region enum value, e.g. "AMERICA_NORTH".
  region       String
  /// Platform id, e.g. "NA1". games/by-code answers with a bare numeric gameId
  /// and Match-V5 wants {PLATFORM}_{gameId}; this is the missing half.
  platformId   String

  serverId         String
  channelId        String
  creatorDiscordId String

  /// JSON string arrays. Teams come from the /lobby create arguments because
  /// lobby events carry a PUUID per join and never a side, and spectator is
  /// unreliable for customs — so this is the only pregame source of the split.
  bluePuuids    String
  redPuuids     String
  blueAliases   String
  redAliases    String
  teamSize      Int
  pickType      String // TournamentPickType
  mapType       String // TournamentMapType
  spectatorType String // TournamentSpectatorType
  lobbyName     String?
  password      String?

  /// TournamentLobbyState. Advances monotonically; see lifecycle.ts.
  state String

  /// Observability only. Correctness must NOT depend on these: lobby-events
  /// replays its whole list every call, multiple events can share a
  /// millisecond, and `timestamp` is a string. The monotonic state recompute
  /// is what makes a replay idempotent.
  processedEventCount Int     @default(0)
  lastEventTimestamp  String?

  /// JSON object: Discord channel ID -> prematch message ID. Copied onto the
  /// ActiveGame row once the match ID is known, so the post-match report
  /// replies to the right message.
  prematchMessageIds String?

  /// JSON string array of PUUIDs seen in a PlayerJoinedGameEvent.
  joinedPuuids String @default("[]")

  gameId  BigInt?
  /// Platform-qualified Riot match ID; joins to ActiveGame.prematchMatchId.
  matchId String?

  lastPolledAt DateTime?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  updatedAt    DateTime  @updatedAt

  /// The durable request claim that minted this credential. A lobby can be
  /// created by `/lobby` or by Customs, but every path goes through the same
  /// claim-before-Riot provisioning service.
  provision  TournamentLobbyProvision?
  customGame CustomGame?

  @@index([state, expiresAt])
  @@index([serverId, state])
  @@index([matchId])
}

/// Claim for one Tournament-V5 code-creation request.
///
/// A timeout after the POST may mean Riot minted a credential, so any request
/// that did not durably reach COMPLETED is intentionally not retried. The
/// request hash also prevents an idempotency key from being reused for a
/// different roster or lobby policy.
model TournamentLobbyProvision {
  id          String           @id
  requestHash String
  state       String           @default("PENDING")
  lobbyId     Int?             @unique
  lobby       TournamentLobby? @relation(fields: [lobbyId], references: [id], onDelete: Restrict)
  lastError   String?
  claimedAt   DateTime         @default(now())
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([state, claimedAt])
  @@index([requestHash, state])
}

// =============================================================================
// Scout Customs — beta-only, guild-scoped custom-game nights
// =============================================================================

/// A separate pointer makes the one-active-night constraint a PostgreSQL
/// invariant while ended nights remain immutable history.
model CustomActiveNight {
  guildId   String      @id
  nightId   String      @unique
  night     CustomNight @relation(fields: [nightId], references: [id], onDelete: Restrict)
  createdAt DateTime    @default(now())
}

model CustomNight {
  id                   String    @id @default(uuid())
  guildId              String
  guildName            String
  launchChannelId      String
  voiceLobbyChannelId  String
  hostDiscordId        String
  state                String
  revision             Int       @default(0)
  recruitmentMessageId String?
  teamAVoiceChannelId  String?
  teamBVoiceChannelId  String?
  lastActivityAt       DateTime
  expiresAt            DateTime
  endedAt              DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  activePointer CustomActiveNight?
  cohosts       CustomNightCohost[]
  participants  CustomNightParticipant[]
  games         CustomGame[]
  auditEvents   CustomAuditEvent[]

  @@index([guildId, createdAt])
  @@index([state, expiresAt])
}

model CustomNightCohost {
  nightId   String
  discordId String
  createdAt DateTime    @default(now())
  night     CustomNight @relation(fields: [nightId], references: [id], onDelete: Cascade)

  @@id([nightId, discordId])
}

/// Consent is append-preserving and guild-scoped. Operator anonymization
/// replaces identifiers; it never deletes the fact that consent was recorded.
model CustomConsent {
  id                String    @id @default(uuid())
  guildId           String
  discordId         String
  disclosureVersion String
  acceptedAt        DateTime
  anonymizedAt      DateTime?
  createdAt         DateTime  @default(now())

  @@unique([guildId, discordId, disclosureVersion])
  @@index([discordId, acceptedAt])
}

model CustomNightParticipant {
  id                String    @id @default(uuid())
  nightId           String
  discordId         String
  displayName       String
  avatarUrl         String?
  role              String
  availability      String
  readyAt           DateTime?
  awayUntil         DateTime?
  held              Boolean   @default(false)
  consentedAt       DateTime
  playerId          Int?
  playerAlias       String?
  selectedAccountId Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  night CustomNight @relation(fields: [nightId], references: [id], onDelete: Cascade)

  @@unique([nightId, discordId])
  @@index([nightId, availability, readyAt])
}

model CustomGame {
  id                String    @id @default(uuid())
  nightId           String
  sequence          Int
  state             String
  rosterMode        String
  map               String
  pickMode          String
  activeCaptain     String?
  tournamentLobbyId Int?      @unique
  voiceState        String    @default("IDLE")
  voiceReady        Boolean   @default(false)
  voiceOverride     Boolean   @default(false)
  voiceError        String?
  winner            String?
  createdAt         DateTime  @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  updatedAt         DateTime  @updatedAt

  night           CustomNight             @relation(fields: [nightId], references: [id], onDelete: Cascade)
  tournamentLobby TournamentLobby?        @relation(fields: [tournamentLobbyId], references: [id], onDelete: Restrict)
  participants    CustomGameParticipant[]
  auditEvents     CustomAuditEvent[]

  @@unique([nightId, sequence])
  @@index([nightId, state])
  @@index([voiceState, updatedAt])
}

model CustomGameParticipant {
  id           String   @id @default(uuid())
  gameId       String
  discordId    String
  displayName  String
  playerId     Int
  playerAlias  String
  accountId    Int
  puuid        String
  riotGameName String?
  riotTagLine  String?
  rosterOrder  Int
  benchOrder   Int?
  team         String?
  side         String?
  captain      Boolean  @default(false)
  pickOrder    Int?
  championId   Int?
  won          Boolean?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  game CustomGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, discordId])
  @@index([gameId, team, pickOrder])
  @@index([puuid])
}

/// Append-only command and integration ledger. Random choices are recorded in
/// payload at the same revision as the mutation that accepted them.
model CustomAuditEvent {
  id        String   @id @default(uuid())
  nightId   String
  gameId    String?
  revision  Int
  actorId   String
  action    String
  payload   String
  source    String   @default("ACTIVITY")
  createdAt DateTime @default(now())

  night CustomNight @relation(fields: [nightId], references: [id], onDelete: Restrict)
  game  CustomGame? @relation(fields: [gameId], references: [id], onDelete: Restrict)

  @@index([nightId, revision])
  @@index([gameId, createdAt])
  @@index([actorId, createdAt])
}

/// Durable handoff for work created by request/gateway code before Temporal
/// has accepted the Workflow start. Payloads are validated by the activity and
/// never enter Workflow history.
model ScoutTemporalWork {
  id          String    @id
  kind        String
  payload     String
  state       String    @default("queued")
  lastError   String?
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([state, createdAt])
  @@index([kind, state])
}

/// Durable execution and recovery record for one Explore turn or report-AI
/// edit. Provider inputs and partial output remain in Postgres, never Workflow
/// history. A non-null providerAttemptAt is intentionally ambiguous: retries
/// salvage instead of issuing another billable request.
model ScoutInteractiveRun {
  id                String    @id
  kind              String
  ownerId           String
  guildId           String?
  conversationId    String?
  quotaExempt       Boolean   @default(false)
  payload           String
  state             String    @default("PENDING")
  providerAttemptAt DateTime?
  stopRequestedAt   DateTime?
  partialOutput     String?
  trace             String?
  resultMessageId   String?
  outcome           String?
  lastError         String?
  createdAt         DateTime  @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  updatedAt         DateTime  @updatedAt

  @@index([kind, ownerId, createdAt])
  @@index([kind, guildId, createdAt])
  @@index([state, createdAt])
  @@index([conversationId, state])
}

/// Durable claim for an external side effect. The key is derived from the
/// product operation (for example report-run plus message chunk), never from a
/// Temporal attempt, so Activity retries cannot create a second effect.
model ScoutEffectClaim {
  key         String    @id
  kind        String
  state       String    @default("CLAIMED")
  lastError   String?
  resultId    String?
  claimedAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([kind, state, claimedAt])
}
