{
  "name": "@shepherdjerred/llm-runtime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./metadata": "./src/metadata.ts"
  },
  "scripts": {
    "build": "bun --no-install build src/index.ts --outdir dist --target bun --external ai --external zod --external prom-client --external '@openrouter/ai-sdk-provider' --external '@opentelemetry/api' --external '@shepherdjerred/llm-models' --external '@shepherdjerred/llm-observability/*'",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "lint": "bunx eslint --cache .",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run test",
    "test:ci": "bun ../../scripts/ci/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../scripts/ci/run-ci-test.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@shepherdjerred/llm-models": "workspace:*",
    "@shepherdjerred/llm-observability": "workspace:*",
    "ai": "7.0.77",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shepherdjerred/eslint-config": "workspace:*",
    "@tsconfig/node-lts": "^24.0.0",
    "@tsconfig/recommended": "^1.0.13",
    "@tsconfig/strictest": "^2.0.8",
    "@types/bun": "1.4.0",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "vitest": "4.1.10",
    "@vitest/coverage-istanbul": "4.1.10"
  }
}
