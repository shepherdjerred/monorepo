  "general": [
    {
      "lane": "middle",
      "inputHash": "e6ec825dde537044e7d5a5dc36575318e45e556ff128be1c9689d9a468c52e35",
      "tips": [
        {
          "id": "middle:Kassadin:general:0",
          "text": "Use Null Sphere on an enemy who is channeling to interrupt them. It also gives you a shield that soaks magic damage.",
          "refs": [
            { "kind": "ability", "key": "Kassadin-Q", "start": 4, "end": 15 }
          ],
          "pWrong": 0
        },
        {
          "id": "middle:Kassadin:general:1",
          "text": "Fire Null Sphere at the start of a trade against a mage. The shield absorbs some of what they throw back.",
          "refs": [
            { "kind": "ability", "key": "Kassadin-Q", "start": 5, "end": 16 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "middle:Kassadin:general:2",
          "text": "Activate Nether Blade before you hit an enemy champion. The hit restores a lot of your missing Mana, so use it when you are low.",
          "refs": [
            { "kind": "ability", "key": "Kassadin-W", "start": 9, "end": 21 }
          ],
          "pWrong": 0.24
        },
        {
          "id": "middle:Kassadin:general:3",
          "text": "Use Force Pulse to get slowed enemies to stay in your range. Casting abilities, yours or a nearby champion's, brings it back sooner.",
          "refs": [
            { "kind": "ability", "key": "Kassadin-E", "start": 4, "end": 15 },
            { "kind": "keyword", "key": "slowed", "start": 23, "end": 29 }
          ],
          "pWrong": 0.29
        },
        {
          "id": "middle:Kassadin:general:4",
          "text": "Chain Riftwalk only when it will win the fight. Each cast in a row costs more Mana, so you can run dry fast.",
          "refs": [
            { "kind": "ability", "key": "Kassadin-R", "start": 6, "end": 14 }
          ],
          "pWrong": 0.14
        },
        {
          "id": "middle:Kassadin:general:5",
          "text": "Use Riftwalk to close the gap or escape, since its cooldown is short. Expect it to be blocked by spell shields.",
          "refs": [
            { "kind": "ability", "key": "Kassadin-R", "start": 4, "end": 12 }
          ],
          "pWrong": 0.8
        },
        {
          "id": "middle:Kassadin:general:6",
          "text": "Trade into enemy mages with Void Stone up. You take less magic damage and walk through units, so you can chase or slip away.",
          "refs": [
            {
              "kind": "ability",
              "key": "Kassadin-passive",
              "start": 28,
              "end": 38
            }
          ],
          "pWrong": 0.01
        }
      ],
      "combos": [
        {
          "id": "middle:Kassadin:combo:0",
          "name": "Flash Riftwalk",
          "category": "trick",
          "sequence": [
            { "kind": "ability", "key": "Kassadin-R" },
            { "kind": "summoner-spell", "key": "2202" }
          ],
          "when": "When you need extra blink distance to catch a fleeing target or to escape a gank.",
          "whenRefs": [],
          "text": "Press Flash during Riftwalk's cast time and Kassadin blinks further away. The wiki notes that this is possible.",
          "textRefs": [
            { "kind": "summoner-spell", "key": "4", "start": 6, "end": 11 },
            { "kind": "ability", "key": "Kassadin-R", "start": 19, "end": 27 },
            { "kind": "champion", "key": "Kassadin", "start": 44, "end": 52 }
          ]
        },
        {
          "id": "middle:Kassadin:combo:1",
          "name": "Nether Blade reset",
          "category": "trick",
          "sequence": [{ "kind": "ability", "key": "Kassadin-W" }, "attack"],
          "when": "When trading in melee range or poking in lane and you want to restore mana.",
          "whenRefs": [],
          "text": "Nether Blade resets the attack timer and gives bonus range. Use it right before an auto attack on a champion to get the mana back.",
          "textRefs": [
            { "kind": "ability", "key": "Kassadin-W", "start": 0, "end": 12 }
          ]
        }
      ]
    }
  ],
  "matchups": [
    {
      "lane": "middle",
