  "general": [
    {
      "lane": "top",
      "inputHash": "542975f5abeb9a8f09cbdda35d1b8138c42607fbf5e77f1ec213a6fadf743b90",
      "tips": [
        {
          "id": "top:Urgot:general:0",
          "text": "Aim Corrosive Charge at where the enemy is walking, not where they stand. It lands after a short delay, so it hits best when they step up to last-hit.",
          "refs": [
            { "kind": "ability", "key": "Urgot-Q", "start": 4, "end": 20 }
          ],
          "pWrong": 0.04
        },
        {
          "id": "top:Urgot:general:1",
          "text": "Open a trade with Corrosive Charge or Disdain. Hitting with either marks the enemy, and Purge then fires at them first.",
          "refs": [
            { "kind": "ability", "key": "Urgot-Q", "start": 18, "end": 34 },
            { "kind": "ability", "key": "Urgot-E", "start": 38, "end": 45 },
            { "kind": "ability", "key": "Urgot-W", "start": 88, "end": 93 }
          ],
          "pWrong": 0.05
        },
        {
          "id": "top:Urgot:general:2",
          "text": "Use Disdain to catch the enemy champion. The first champion you hit is stunned and thrown behind you, and you get a shield.",
          "refs": [
            { "kind": "ability", "key": "Urgot-E", "start": 4, "end": 11 }
          ],
          "pWrong": 0.09
        },
        {
          "id": "top:Urgot:general:3",
          "text": "Don't aim Disdain at a wall. Neither the dash nor the throw crosses terrain.",
          "refs": [
            { "kind": "ability", "key": "Urgot-E", "start": 10, "end": 17 }
          ],
          "pWrong": 0.03
        },
        {
          "id": "top:Urgot:general:4",
          "text": "Walk around the enemy while attacking so more of your legs fire. Echoing Flames only fires a leg when you attack in the direction it faces.",
          "refs": [
            {
              "kind": "ability",
              "key": "Urgot-passive",
              "start": 65,
              "end": 79
            }
          ],
          "pWrong": 0.73
        },
        {
          "id": "top:Urgot:general:5",
          "text": "Keep Purge on in long trades. You can move while it fires, but it makes you move slower.",
          "refs": [
            { "kind": "ability", "key": "Urgot-W", "start": 5, "end": 10 }
          ],
          "pWrong": 0.13
        },
        {
          "id": "top:Urgot:general:6",
          "text": "Don't use Purge right after Disdain or Fear Beyond Death. Each one stops Purge from firing for a moment, so lead with the spells.",
          "refs": [
            { "kind": "ability", "key": "Urgot-W", "start": 10, "end": 15 },
            { "kind": "ability", "key": "Urgot-E", "start": 28, "end": 35 },
            { "kind": "ability", "key": "Urgot-R", "start": 39, "end": 56 },
            { "kind": "ability", "key": "Urgot-W", "start": 73, "end": 78 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "top:Urgot:general:7",
          "text": "Save Fear Beyond Death for a weakened or fleeing enemy. It slows them more the lower their health, and you can recast it to execute them once they're low.",
          "refs": [
            { "kind": "ability", "key": "Urgot-R", "start": 5, "end": 22 },
            { "kind": "keyword", "key": "slowed", "start": 59, "end": 64 }
          ],
          "pWrong": 0.11
        }
      ],
      "combos": [
        {
          "id": "top:Urgot:combo:0",
          "name": "Disdain flip into Purge",
          "category": "combo",
          "sequence": [
            { "kind": "ability", "key": "Urgot-E" },
            { "kind": "ability", "key": "Urgot-W" }
          ],
          "when": "When you want to stun a champion and keep damaging them straight afterwards.",
          "whenRefs": [],
          "text": "Land the stun, then turn on Purge to lock onto the marked target. Purge can't fire during the dash or for a short time after, so don't switch it on too early.",
          "textRefs": [
            { "kind": "ability", "key": "Urgot-W", "start": 28, "end": 33 },
            { "kind": "ability", "key": "Urgot-W", "start": 66, "end": 71 }
          ]
        }
      ]
    }
  ],
