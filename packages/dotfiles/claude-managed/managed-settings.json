{
  "permissions": {
    "deny": [
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(rm -rf / *)",
      "Bash(rm -fr / *)",
      "Bash(rm -Rf / *)",
      "Bash(rm -fR / *)",
      "Bash(diskutil eraseDisk *)",
      "Bash(diskutil eraseVolume *)",
      "Bash(diskutil secureErase *)",
      "Bash(diskutil zeroDisk *)",
      "Bash(kubectl delete namespace *)",
      "Bash(kubectl delete namespaces *)",
      "Bash(kubectl delete ns *)",
      "Bash(kubectl delete customresourcedefinition *)",
      "Bash(kubectl delete customresourcedefinitions *)",
      "Bash(kubectl delete crd *)",
      "Bash(kubectl delete crds *)",
      "Bash(talosctl reset *)",
      "Bash(talosctl wipe *)",
      "Bash(toolkit talosctl reset *)",
      "Bash(toolkit talosctl wipe *)",
      "Bash(argocd cluster rm *)",
      "Bash(toolkit argocd cluster rm *)",
      "Bash(argocd app sync*--prune*)",
      "Bash(toolkit argocd app sync*--prune*)",
      "Bash(gh repo delete *)",
      "Bash(toolkit gh repo delete *)",
      "Bash(op vault delete *)",
      "Bash(security find-generic-password *)",
      "Bash(security find-internet-password *)",
      "Bash(security dump-keychain *)",
      "Bash(security export *)",
      "Bash(cf zones delete *)",
      "Bash(toolkit cf zones delete *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "toolkit tracker identity-hook claude-code"
          }
        ]
      }
    ]
  },
  "env": {
    "EDITOR": "true",
    "VISUAL": "true",
    "GIT_EDITOR": "true",
    "PAGER": "cat",
    "GIT_PAGER": "cat",
    "GIT_CONFIG_GLOBAL": "/Users/jerred/.config/agent/gitconfig",
    "GH_CONFIG_DIR": "/Users/jerred/.config/gh-agent"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "jdtls-lsp@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": true
  }
}
