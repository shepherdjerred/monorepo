{
  "name": "@discord-plays-pokemon/frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "dev": "vite",
    "build": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit && vite build",
    "lint": "bun run lint:check",
    "lint:check": "eslint .",
    "lint:fix": "eslint --fix .",
    "preview": "vite preview",
    "test": "bun --no-install --bun vitest --config ../../../../vitest.config.ts run",
    "test:ci": "bun ../../../../scripts/ci/run-ci-test.ts"
  },
  "dependencies": {
    "@shepherdjerred/discord-plays-web": "workspace:*",
    "@discord-plays-pokemon/common": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.4.3",
    "@shepherdjerred/discord-plays-core": "workspace:*",
    "@fontsource/pixelify-sans": "^5.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@shepherdjerred/eslint-config": "workspace:*",
    "@tailwindcss/forms": "^0.5.10",
    "@tanstack/eslint-plugin-query": "^5.68.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "jiti": "^2.7.0",
    "tailwindcss": "^4.0.17",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.0.11",
    "@typescript/native": "npm:typescript@7.0.2",
    "@types/dom-webcodecs": "^0.1.18",
    "vitest": "5.0.3",
    "@vitest/coverage-istanbul": "5.0.3"
  }
}
