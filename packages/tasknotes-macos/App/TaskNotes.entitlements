<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The app is sandboxed from commit one, on purpose. Retrofitting the sandbox
	  onto an app that has been reading arbitrary paths is the expensive
	  direction; starting inside it means Phase 8 reaches for security-scoped
	  bookmarks the first time it opens a vault, rather than discovering the
	  requirement after the file access is spread across the codebase.
	-->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!--
	  The vault is chosen by the user through a system open panel, and the
	  resulting security-scoped bookmark is what grants access on later
	  launches. There is deliberately no broad filesystem entitlement.
	-->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

	<!--
	  Outbound only: the app talks to a TaskNotes server over HTTP. It never
	  listens, so there is no `network.server` entitlement.
	-->
	<key>com.apple.security.network.client</key>
	<true/>

	<!--
	  Sparkle, in a sandbox.

	  An update has to replace the application bundle, which is outside the
	  sandbox by definition, so Sparkle does the install from an XPC service
	  (`Installer.xpc`, shipped inside `Sparkle.framework`) rather than from
	  this process. These two Mach service names are how the app talks to that
	  service and to the installer it launches; without them the connection is
	  refused by the sandbox and every update fails at the last step.

	  `$(PRODUCT_BUNDLE_IDENTIFIER)` is substituted by Xcode when it processes
	  the entitlements file, so these resolve to
	  `red.sjer.tasknotes.mac-spks` and `red.sjer.tasknotes.mac-spki`.

	  ⚠️ There is deliberately **no** Downloader XPC service and no
	  `SUEnableDownloaderService`. Sparkle's own guidance is that the
	  downloader service exists only for sandboxed apps that will not take
	  `com.apple.security.network.client` — this app already has it, three
	  entries above, because it syncs — and enabling it anyway would drag in a
	  deprecated WebKit1 view for release notes.
	-->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spks</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spki</string>
	</array>
</dict>
</plist>
