    "fast-uri": "3.1.3",
    "fast-xml-builder": "1.3.0",
    "js-cookie": "3.0.8",
    "postcss": "8.5.23",
    "protobufjs": "^7.5.7",
    "sanitize-html": "^2.17.4",
    "shell-quote": "1.10.0",
    "tmp": "0.2.7",
    "typescript-eslint": "8.61.1"
  },
  "trustedDependencies": [
    "@lng2004/node-datachannel",
    "@sentry/profiling-node",
    "@snazzah/davey",
    "node-av",
    "node-datachannel",
    "sharp",
    "unrs-resolver"
  ],
  "patchedDependencies": {
    "bun-types@1.3.14": "patches/bun-types@1.3.14.patch",
    "discord-player-youtubei@2.0.0": "patches/discord-player-youtubei@2.0.0.patch",
    "react-native-ios-utilities@5.2.0": "patches/react-native-ios-utilities@5.2.0.patch",
    "react-native-sound@0.13.0": "patches/react-native-sound@0.13.0.patch",
    "twisted@1.82.0": "patches/twisted@1.82.0.patch"
  },
  "packageManager": "bun@1.3.14"
}
