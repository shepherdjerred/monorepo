  "general": [
    {
      "lane": "middle",
      "inputHash": "b9340a22159664e2fb73465182de3e16ad398eb68776292191fafc67bead0c1f",
      "tips": [
        {
          "id": "middle:Zoe:general:0",
          "text": "Cast Paddle Star! away from the enemy first, then recast it back through them; the longer it flies, the harder it hits.",
          "refs": [
            { "kind": "ability", "key": "Zoe-Q", "start": 5, "end": 17 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "middle:Zoe:general:1",
          "text": "Land Sleepy Trouble Bubble first, then hit them with your biggest damage; sleeping enemies take double damage when woken.",
          "refs": [
            { "kind": "ability", "key": "Zoe-E", "start": 5, "end": 26 }
          ],
          "pWrong": 0.2
        },
        {
          "id": "middle:Zoe:general:2",
          "text": "Fire Sleepy Trouble Bubble from a bush or fog of war. It flies farther over walls, so you can catch enemies who think they are out of range.",
          "refs": [
            { "kind": "ability", "key": "Zoe-E", "start": 5, "end": 26 }
          ],
          "pWrong": 0.12
        },
        {
          "id": "middle:Zoe:general:3",
          "text": "Use Portal Jump to line up a Paddle Star! or bubble, but only when the enemy can't punish you, since you can't move while there.",
          "refs": [
            { "kind": "ability", "key": "Zoe-R", "start": 4, "end": 15 },
            { "kind": "ability", "key": "Zoe-Q", "start": 29, "end": 41 }
          ],
          "pWrong": 0.25
        },
        {
          "id": "middle:Zoe:general:4",
          "text": "Walk over spell shards dropped by enemies or marked minions to steal their summoner spell or item active with Spell Thief.",
          "refs": [
            { "kind": "ability", "key": "Zoe-W", "start": 110, "end": 121 }
          ],
          "pWrong": 0.12
        },
        {
          "id": "middle:Zoe:general:5",
          "text": "Weave an attack after each spell; More Sparkles! adds bonus magic damage to your next basic attack.",
          "refs": [
            { "kind": "ability", "key": "Zoe-passive", "start": 34, "end": 48 }
          ],
          "pWrong": 0.63
        },
        {
          "id": "middle:Zoe:general:6",
          "text": "Sleepy Trouble Bubble slows the target before they fall asleep, so cast it when they step up to farm and follow with Paddle Star!.",
          "refs": [
            { "kind": "ability", "key": "Zoe-E", "start": 0, "end": 21 },
            { "kind": "keyword", "key": "slowed", "start": 22, "end": 27 },
            { "kind": "ability", "key": "Zoe-Q", "start": 117, "end": 129 }
          ],
          "pWrong": 0.12
        }
      ],
      "combos": [
        {
