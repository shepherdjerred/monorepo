{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sjer.red/schemas/script-migrations.schema.json",
  "title": "Shell to Bun migration manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "scripts"],
  "properties": {
    "version": { "const": 1 },
    "scripts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "disposition", "reason"],
        "properties": {
          "source": { "type": "string", "pattern": "\\.sh$" },
          "disposition": {
            "enum": ["port", "remove-wrapper", "delete", "retain"]
          },
          "reason": { "type": "string", "minLength": 1 },
          "replacement": { "type": "string", "pattern": "\\.ts$" },
          "owner": {
            "type": "object",
            "additionalProperties": false,
            "required": ["packageJson", "tsconfig", "eslintConfig"],
            "properties": {
              "packageJson": { "type": "string" },
              "tsconfig": { "type": "string" },
              "eslintConfig": { "type": "string" }
            }
          },
          "tests": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "\\.test\\.ts$" }
          }
        }
      }
    }
  }
}
