{
  "id": "static-site-proxy/prod/1",
  "definition": {
    "kind": "kubernetes-application",
    "application": {
      "name": "s3-static-sites",
      "metadata": {
        "labels": { "ci.sjer.red/managed-application": "true" },
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=false",
          "ci.sjer.red/application-lifecycle": "retain"
        },
        "finalizers": []
      },
      "project": "workloads",
      "destination": {
        "server": "https://kubernetes.default.svc",
        "namespace": "s3-static-sites"
      },
      "source": {
        "repoURL": "https://chartmuseum.tailnet-1a49.ts.net",
        "chart": "s3-static-sites"
      },
      "syncOptions": ["CreateNamespace=true"],
      "ignoreDifferences": [],
      "revisionHistoryLimit": 5,
      "lifecycle": "retain"
    },
    "chartComponent": "chart:s3-static-sites",
    "artifactParameters": {
      "delivery.images.caddy-s3proxy": {
        "component": "image:caddy-s3proxy",
        "format": "reference"
      }
    },
    "runner": { "service": "ci", "component": "image:ci-base" },
    "steps": [
      {
        "kind": "apply-safety",
        "instance": "application:s3-static-sites",
        "pointOfNoReturn": false
      },
      {
        "kind": "sync",
        "instance": "application:s3-static-sites",
        "pointOfNoReturn": false
      }
    ],
    "oracle": { "probes": [], "tests": [] }
  }
}
