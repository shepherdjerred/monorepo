  "general": [
    {
      "lane": "support",
      "inputHash": "596d8776bb7231fa89759750388a12c4d6bb0d257702ad791d48a8a946dde6b0",
      "tips": [
        {
          "id": "support:Velkoz:general:0",
          "text": "Poke with Void Rift on enemies standing near minions. It has a short cooldown and builds Organic Deconstruction stacks for a burst of true damage.",
          "refs": [
            { "kind": "ability", "key": "Velkoz-W", "start": 10, "end": 19 },
            {
              "kind": "ability",
              "key": "Velkoz-passive",
              "start": 89,
              "end": 111
            }
          ],
          "pWrong": 0.31
        },
        {
          "id": "support:Velkoz:general:1",
          "text": "Aim Plasma Fission diagonally so it splits at max range. The split bolts reach enemies who are out of range of the first bolt.",
          "refs": [
            { "kind": "ability", "key": "Velkoz-Q", "start": 4, "end": 18 }
          ],
          "pWrong": 0.1
        },
        {
          "id": "support:Velkoz:general:2",
          "text": "Recast Plasma Fission mid-flight to split it early. You can fire the new bolts sideways at enemies standing beside the first bolt's path.",
          "refs": [
            { "kind": "ability", "key": "Velkoz-Q", "start": 7, "end": 21 }
          ],
          "pWrong": 0.03
        },
        {
          "id": "support:Velkoz:general:3",
          "text": "Land Plasma Fission to leave the enemy slowed, then follow up with Tectonic Disruption so it is harder for them to dodge.",
          "refs": [
            { "kind": "ability", "key": "Velkoz-Q", "start": 5, "end": 19 },
            { "kind": "keyword", "key": "slowed", "start": 39, "end": 45 },
            { "kind": "ability", "key": "Velkoz-E", "start": 67, "end": 86 }
          ],
          "pWrong": 0.12
        },
        {
          "id": "support:Velkoz:general:4",
          "text": "Cast Tectonic Disruption at an enemy who is close to you. It knocks them back instead of up, which makes room.",
          "refs": [
            { "kind": "ability", "key": "Velkoz-E", "start": 5, "end": 24 }
          ],
          "pWrong": 0.19
        },
        {
          "id": "support:Velkoz:general:5",
          "text": "Use Tectonic Disruption on enemies who dive you or your ally. Enemies who are knocked up can't act, so your team gets a free hit.",
          "refs": [
            { "kind": "ability", "key": "Velkoz-E", "start": 4, "end": 23 },
            { "kind": "keyword", "key": "knocked-up", "start": 78, "end": 88 }
          ],
          "pWrong": 0.61
        },
        {
          "id": "support:Velkoz:general:6",
          "text": "Start Life Form Disintegration Ray only when enemies can't stop it. Stuns, silences and knockups cancel it, so wait for their crowd control to be used.",
          "refs": [
            { "kind": "ability", "key": "Velkoz-R", "start": 6, "end": 34 },
            { "kind": "keyword", "key": "silenced", "start": 75, "end": 83 }
          ],
          "pWrong": 0.51
        },
        {
          "id": "support:Velkoz:general:7",
          "text": "Hit an enemy with three stacks of Organic Deconstruction before the ray. Then Life Form Disintegration Ray deals true damage, which finishes them.",
          "refs": [
            {
              "kind": "ability",
              "key": "Velkoz-passive",
              "start": 34,
              "end": 56
            },
            { "kind": "ability", "key": "Velkoz-R", "start": 78, "end": 106 }
          ],
          "pWrong": 0.63
        },
        {
          "id": "support:Velkoz:general:8",
          "text": "Stay behind your front line. Vel'Koz has low mobility and is easy to catch, so keep your distance and use your long range.",
          "refs": [
            { "kind": "champion", "key": "Velkoz", "start": 29, "end": 36 }
          ],
          "pWrong": 0.11
        }
      ],
      "combos": [
        {
          "id": "support:Velkoz:combo:0",
          "name": "Angled Q split",
          "category": "trick",
          "sequence": [
            { "kind": "ability", "key": "Velkoz-Q" },
            { "kind": "ability", "key": "Velkoz-Q" }
          ],
          "when": "Use it when an enemy stands beyond Plasma Fission's normal range, or off to the side of the bolt's path, such as behind minions.",
          "whenRefs": [
            { "kind": "ability", "key": "Velkoz-Q", "start": 35, "end": 49 }
          ],
          "text": "Aim the bolt diagonally past the target, then recast it, or let it split at max range. The two side bolts hit enemies the first bolt could not reach.",
          "textRefs": []
        }
      ]
    }
  ],
  "matchups": [
    {
