        {
          "id": "support:Taric:Pantheon:0",
          "text": "Aim Dazzle at where Pantheon will be, not where he is; it bursts after a delay and he can walk out of it. Cast it when he commits to a jump or a trade.",
          "refs": [
            { "kind": "ability", "key": "Taric-E", "start": 4, "end": 10 },
            { "kind": "champion", "key": "Pantheon", "start": 20, "end": 28 }
          ],
          "pWrong": 0.16
        },
        {
          "id": "support:Taric:Pantheon:1",
          "text": "Pantheon can't be hurt from the front while he braces with Aegis Assault. Wait it out or hit him from behind, and don't waste Dazzle on the shield.",
          "refs": [
            { "kind": "champion", "key": "Pantheon", "start": 0, "end": 8 },
            { "kind": "ability", "key": "Pantheon-E", "start": 59, "end": 72 },
            { "kind": "ability", "key": "Taric-E", "start": 126, "end": 132 }
          ],
          "pWrong": 0.37
        },
        {
          "id": "support:Taric:Pantheon:2",
          "text": "Bind your carry with Bastion before Pantheon jumps in; the shield blunts his burst, and your abilities then come from both of you.",
          "refs": [
            { "kind": "ability", "key": "Taric-W", "start": 21, "end": 28 },
            { "kind": "champion", "key": "Pantheon", "start": 36, "end": 44 }
          ],
          "pWrong": 0.18
        },
        {
          "id": "support:Taric:Pantheon:3",
          "text": "Use Cosmic Radiance as soon as Pantheon commits to a fight. Its delay is long, so it must start before your ally is in danger.",
          "refs": [
            { "kind": "ability", "key": "Taric-R", "start": 4, "end": 19 },
            { "kind": "champion", "key": "Pantheon", "start": 31, "end": 39 }
          ],
          "pWrong": 0.79
        },
        {
          "id": "support:Taric:Pantheon:4",
          "text": "Heal with Starlight's Touch after your empowered attacks have built charges. Weak allies hit by Pantheon's poke need the heal.",
          "refs": [
            { "kind": "summoner-spell", "key": "7", "start": 0, "end": 4 },
            { "kind": "ability", "key": "Taric-Q", "start": 10, "end": 27 },
            { "kind": "champion", "key": "Pantheon", "start": 96, "end": 104 },
            { "kind": "keyword", "key": "poke", "start": 107, "end": 111 }
          ],
          "pWrong": 0.11
        }
      ],
