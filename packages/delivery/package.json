{
  "name": "@shepherdjerred/delivery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./contract": "./src/shared/contract.ts",
    "./model-contract": "./src/shared/model/contract.ts",
    "./client": "./src/shared/client.ts",
    "./client-error": "./src/shared/client-error.ts",
    "./artifact-contract": "./src/shared/artifact-contract.ts",
    "./operation-id": "./src/shared/operation-id.ts",
    "./testing": "./src/testing/index.ts"
  },
  "imports": {
    "#generated/*": "./generated/*",
    "#*": "./src/*"
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "vite build",
    "start": "bun src/server/index.ts",
    "dev": "bun --watch src/server/index.ts",
    "dev:client": "vite",
    "migrate:deploy": "prisma migrate deploy",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run src",
    "test:ci": "bun ../../scripts/ci/run-ci-test.ts",
    "test:e2e": "bun --no-install --bun playwright test"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/client-runtime-utils": "7.10.0",
    "@shepherdjerred/config": "workspace:*",
    "@shepherdjerred/feature-flags": "workspace:*",
    "@shepherdjerred/ops-clients": "workspace:*",
    "@shepherdjerred/ops-model": "workspace:*",
    "@shepherdjerred/version-catalog": "workspace:*",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "1.170.32",
    "fflate": "^0.8.3",
    "hono": "^4.12.18",
    "pg": "8.23.0",
    "prisma": "^7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@shepherdjerred/eslint-config": "workspace:*",
    "@types/bun": "1.4.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-istanbul": "5.0.3",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "5.0.3"
  }
}
