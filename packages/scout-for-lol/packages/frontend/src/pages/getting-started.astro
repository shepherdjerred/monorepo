---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import {
  APP_DASHBOARD_URL,
  DOCS_URL,
  GET_STARTED_CLICK_EVENT,
} from "#src/lib/marketing-constants.ts";
---

<Layout
  title="Getting Started · Scout for LoL"
  description="Install Scout and configure League match notifications from the web dashboard."
>
  <div class="bg-scout-surface">
    <Navbar activePage="getting-started" />
    <main class="relative px-6 lg:px-8">
      <div class="mx-auto max-w-3xl py-32 sm:py-48 lg:py-56">
        <p
          class="text-sm font-semibold uppercase tracking-wide text-scout-brand"
        >
          Getting started
        </p>
        <h1
          class="mt-4 text-4xl font-bold tracking-tight text-scout-ink sm:text-6xl"
        >
          Configure Scout in the browser.
        </h1>
        <p class="mt-6 text-lg leading-8 text-scout-subtle">
          Sign in, add Scout to your Discord server, and choose the players and
          channels you want to watch. Discord stays focused on notifications;
          the dashboard handles the settings.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href={APP_DASHBOARD_URL}
            data-scout-conversion={GET_STARTED_CLICK_EVENT}
            data-scout-cta-location="getting-started"
            class="rounded-md bg-scout-brand px-5 py-3 font-semibold text-scout-brand-ink shadow-sm hover:bg-scout-brand"
            >Open the dashboard</a
          >
          <a
            href={DOCS_URL}
            class="rounded-md border border-scout-border px-5 py-3 font-semibold text-scout-ink hover:bg-scout-raised"
            >Read the documentation</a
          >
        </div>
        <div class="mt-16 rounded-xl bg-scout-raised p-8">
          <h2 class="text-xl font-semibold text-scout-ink">
            Prefer to try it from Discord?
          </h2>
          <p class="mt-3 text-scout-subtle">
            Use <code>/track</code> for one player in the current channel, then return
            to the dashboard for filters, queues, additional channels, competitions,
            reports, and permissions.
          </p>
        </div>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
