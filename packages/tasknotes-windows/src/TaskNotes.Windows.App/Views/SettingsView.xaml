<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TaskNotes.Windows.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:host="using:TaskNotes.Windows.Host">
    <ScrollViewer>
        <StackPanel
            MaxWidth="760"
            HorizontalAlignment="Left"
            Spacing="16">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Connect an existing Obsidian Sync vault. Account tokens and vault keys stay in Windows Credential Locker. Local folders are currently read-only."
                TextWrapping="Wrap" />
            <TextBox
                x:Name="EmailTextBox"
                AutomationProperties.AutomationId="Facet.Settings.Email"
                AutomationProperties.Name="Obsidian account email"
                Header="Obsidian account email" />
            <PasswordBox
                x:Name="AccountPasswordBox"
                AutomationProperties.AutomationId="Facet.Settings.Password"
                AutomationProperties.Name="Obsidian account password"
                Header="Account password" />
            <TextBox
                x:Name="MfaTextBox"
                AutomationProperties.AutomationId="Facet.Settings.Mfa"
                Header="One-time code, when requested" />
            <Button
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="TaskNotes.Settings.Save"
                AutomationProperties.Name="Sign in to Obsidian and discover vaults"
                Click="Save_Click"
                Content="Sign in" />
            <ComboBox
                x:Name="VaultComboBox"
                AutomationProperties.AutomationId="Facet.Settings.Vaults"
                DisplayMemberPath="Name"
                Header="Existing Sync vault"
                ItemsSource="{x:Bind ViewModel.Vaults, Mode=OneWay}" />
            <PasswordBox
                x:Name="VaultPasswordBox"
                AutomationProperties.AutomationId="Facet.Settings.VaultPassword"
                Header="Vault encryption password, when required" />
            <CheckBox
                x:Name="ApproveStandardCheckBox"
                AutomationProperties.AutomationId="Facet.Settings.ApproveStandard"
                Content="Use standard TaskNotes settings if this vault has no TaskNotes configuration" />
            <Button
                AutomationProperties.AutomationId="Facet.Settings.ConnectVault"
                Click="ConnectVault_Click"
                Content="Connect selected vault" />
            <ComboBox
                x:Name="ProfileComboBox"
                AutomationProperties.AutomationId="Facet.Settings.Profiles"
                DisplayMemberPath="Name"
                Header="Configured vaults"
                ItemsSource="{x:Bind ViewModel.Profiles, Mode=OneWay}" />
            <Button
                AutomationProperties.AutomationId="Facet.Settings.SelectProfile"
                Click="SelectProfile_Click"
                Content="Open selected vault" />
            <Button
                AutomationProperties.AutomationId="Facet.Settings.Reauthorize"
                Click="Reauthorize_Click"
                Content="Authorize selected vault again" />
            <Button
                AutomationProperties.AutomationId="Facet.Settings.RemoveProfile"
                Click="RemoveProfile_Click"
                Content="Remove selected vault from Facet" />
            <Button
                AutomationProperties.AutomationId="Facet.Settings.LocalFolder"
                Click="LocalFolder_Click"
                Content="Open local folder (read-only)" />
            <Button
                AutomationProperties.AutomationId="Facet.Settings.SignOut"
                Click="SignOut_Click"
                Content="Sign out of Obsidian" />
            <TextBlock
                x:Name="ConnectionStatusText"
                AutomationProperties.AutomationId="TaskNotes.Settings.Status"
                AutomationProperties.LiveSetting="Polite"
                Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="BackgroundSyncStatusText"
                AutomationProperties.LiveSetting="Polite"
                TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="EnableBackgroundSync_Click" Content="Enable background Sync" />
                <Button Click="DisableBackgroundSync_Click" Content="Disable background Sync" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="EnableReminders_Click" Content="Enable Windows reminders" />
                <Button Click="DisableReminders_Click" Content="Disable reminders on this device" />
            </StackPanel>
            <TextBlock
                x:Name="ReminderStatusText"
                AutomationProperties.LiveSetting="Polite"
                TextWrapping="Wrap" />
            <TextBlock Text="Reminders use Windows notifications. Delivery depends on Windows permissions and power settings; a computer off for more than five minutes after the firing time can miss a reminder." TextWrapping="Wrap" />
            <TextBox
                x:Name="HotkeyTextBox"
                AutomationProperties.AutomationId="TaskNotes.Settings.Hotkey"
                Header="Global Quick Add hotkey"
                PlaceholderText="Ctrl+Alt+N" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    AutomationProperties.AutomationId="TaskNotes.Settings.Hotkey.Apply"
                    Click="ApplyHotkey_Click"
                    Content="Apply hotkey" />
                <Button
                    AutomationProperties.AutomationId="TaskNotes.Settings.Hotkey.Clear"
                    Click="ClearHotkey_Click"
                    Content="Clear hotkey" />
                <TextBlock
                    x:Name="HotkeyStatusText"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="TaskNotes.Settings.HotkeyStatus"
                    AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <TextBlock
                Margin="0,16,0,0"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Saved views" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="CreateSavedView_Click" Content="Create" />
                <Button Click="RestoreSavedViews_Click" Content="Restore defaults" />
            </StackPanel>
            <ListView
                AutomationProperties.AutomationId="TaskNotes.Settings.SavedViews"
                ItemsSource="{x:Bind ShellViewModel.SavedViews, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="host:SavedViewDefinition">
                        <Grid Padding="0,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Name}" />
                            <Button
                                Grid.Column="1"
                                Click="DuplicateSavedView_Click"
                                Content="Duplicate"
                                Tag="{x:Bind Id}" />
                            <Button
                                Grid.Column="2"
                                Click="MoveSavedView_Click"
                                Content="Move up"
                                Tag="{x:Bind Id}" />
                            <Button
                                Grid.Column="3"
                                Click="DeleteSavedView_Click"
                                Content="Delete"
                                Tag="{x:Bind Id}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                Margin="0,16,0,0"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Conflicts" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Both versions remain retained until you explicitly choose one."
                TextWrapping="Wrap" />
            <TextBlock
                FontSize="20"
                FontWeight="SemiBold"
                Text="Saved actions" />
            <TextBlock Text="Select the action's original vault before resuming. The original ID, timestamp and decision remain unchanged." TextWrapping="Wrap" />
            <ListView
                AutomationProperties.AutomationId="Facet.Settings.SavedActions"
                ItemsSource="{x:Bind ViewModel.PendingActions, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="host:FacetPendingAction">
                        <StackPanel Padding="0,8" Spacing="6">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind ProfileName}" />
                            <TextBlock Text="{x:Bind Kind}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Click="ResumeAction_Click"
                                    Content="Resume saved action"
                                    Tag="{x:Bind Id}" />
                                <Button
                                    Click="RetireAction_Click"
                                    Content="Retire rejected action"
                                    Tag="{x:Bind Id}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ListView
                AutomationProperties.AutomationId="TaskNotes.Settings.ParkedChanges"
                ItemsSource="{x:Bind ViewModel.Conflicts, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="host:FacetConflict">
                        <Grid Padding="0,10" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Path}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                AutomationProperties.Name="Keep local version"
                                Click="RetryParked_Click"
                                Content="Keep local"
                                Tag="{x:Bind Id}" />
                            <Button
                                Grid.Column="2"
                                AutomationProperties.Name="Keep remote version"
                                Click="DiscardParked_Click"
                                Content="Keep remote"
                                Tag="{x:Bind Id}" />
                            <Button
                                Grid.Column="3"
                                AutomationProperties.Name="Review retained conflict versions"
                                Click="ReviewConflict_Click"
                                Content="Review versions"
                                Tag="{x:Bind Id}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</UserControl>
