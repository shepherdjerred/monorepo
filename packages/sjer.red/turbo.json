{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // The og-image rendering inside `astro build` launches a browser too —
    // same PLAYWRIGHT_BROWSERS_PATH pass-through as test:e2e (hash-neutral).
    // Astro 6 writes generated content modules through a shared `.astro`
    // directory. Serialize this package's typecheck before its build so two
    // Astro processes cannot race the same temporary rename.
    "build": {
      "dependsOn": ["typecheck", "^build"],
      "outputs": ["dist/**"],
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"]
    },
    // The Playwright CI container sets PLAYWRIGHT_BROWSERS_PATH; without the
    // pass-through, turbo's strict env hides it and the browser launch falls
    // back to ~/.cache/ms-playwright (empty in the container). passThroughEnv
    // (not env) because the path is machine-specific and must not shift the
    // task hash.
    "test:e2e": {
      "dependsOn": ["build", "^build"],
      "cache": false,
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"]
    }
  }
}
