{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // Dependents (e.g. @scout-for-lol/frontend, which typechecks backend
    // source via a relative import) only reach this package through the
    // root pipeline's "^build" edges — never through "generate" directly,
    // since root turbo.json's bare "generate" dependency on typecheck/test
    // resolves to the SAME package's own generate task, not a dependency's.
    // Without this edge, a dependent pulled into --affected scope without
    // this package also being affected (e.g. a PR touching only a package
    // frontend depends on) never schedules this package's Prisma codegen,
    // so #generated/prisma/client is missing and dependent typechecks fail.
    "build": {
      "dependsOn": ["^build", "generate"]
    },
    // test script interpolates the PostgreSQL test URL — ambient value
    // changes results. Everything else is pinned by the test-setup preload.
    "test": {
      "env": ["DATABASE_URL", "SCOUT_PG_PORT"],
      "passThroughEnv": ["MISE_DATA_DIR"]
    },
    // Transit task: Turbo reaches the group tasks below through it, so
    // `turbo run test:ci` (verify) runs all of them in parallel. DATABASE_URL
    // and SCOUT_PG_PORT only say where the suites reach the shared PostgreSQL
    // server and which URL the unbound singleton stub carries: the suites
    // clone their own databases, never write to the named one, and pass or
    // fail the same for any value (verified by running them with others), so
    // they pass through instead of entering the hash.
    "test:ci": {
      "dependsOn": ["test:ci:free-1", "test:ci:free-2", "test:ci:db"]
    },
    // Shards of the PostgreSQL-free suites (every CI-tier test file that does
    // not list in ci-tests.json's `db` group). Vitest's --shard splits one
    // deterministic file list, so the shards together run each file once.
    // Their inputs drop the `db` group's test files, which these tasks never
    // run, so a PostgreSQL-test-only edit leaves both shards cached.
    "test:ci:free-1": {
      "dependsOn": ["^build", "^generate", "generate"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/ci/ci-reporting.ts",
        "$TURBO_ROOT$/scripts/ci/test-manifest-schema.ts",
        "$TURBO_ROOT$/scripts/ci/mstest-configuration.ts",
        "$TURBO_ROOT$/scripts/ci/gradle-junit.ts",
        "$TURBO_ROOT$/scripts/ci/run-ci-test.ts",
        "$TURBO_ROOT$/vitest.config.ts",
        "!src/analytics/command-usage.test.ts",
        "!src/analytics/guild-lifecycle.test.ts",
        "!src/analytics/install-attribution.test.ts",
        "!src/consumer/confirmed-access.test.ts",
        "!src/database/get-accounts-with-state.test.ts",
        "!src/database/guild-permission-errors.test.ts",
