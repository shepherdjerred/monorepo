{
  "name": "@shepherdjerred/storm-forum",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#scripts/*": "./scripts/*",
    "#config/*": "./config/*"
  },
  "exports": {
    "./contracts": "./src/contracts.ts"
  },
  "scripts": {
    "build": "bun --no-install build src/cli.ts --outdir dist --target bun --packages external",
    "lint": "bunx eslint --cache . --max-warnings=0",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run test",
    "test:ci": "bun ../../scripts/ci/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../scripts/ci/run-ci-test.ts",
    "start": "bun src/cli.ts"
  },
  "dependencies": {
    "@shepherdjerred/storm-theme": "workspace:*",
    "@shepherdjerred/config": "workspace:*",
    "@shepherdjerred/feature-flags": "workspace:*",
    "@temporalio/activity": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "htmlparser2": "^12.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "@shepherdjerred/eslint-config": "workspace:*",
    "@tsconfig/node-lts": "^24.0.0",
    "@tsconfig/recommended": "^1.0.13",
    "@tsconfig/strictest": "^2.0.8",
    "@types/bun": "1.4.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "vitest": "5.0.3",
    "@vitest/coverage-istanbul": "5.0.3"
  }
}
