      "tips": [
        {
          "id": "jungle:Ivern:general:0",
          "text": "Plant a grove on each camp with Friend of the Forest, then come back to free it once it has fully grown. Smite frees it at once.",
          "refs": [
            {
              "kind": "ability",
              "key": "Ivern-passive",
              "start": 32,
              "end": 52
            },
            { "kind": "summoner-spell", "key": "11", "start": 105, "end": 110 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "jungle:Ivern:general:1",
          "text": "Aim Rootcaller carefully; it stops at the first enemy it hits. A hit leaves the target rooted, so your team can follow up.",
          "refs": [
            { "kind": "ability", "key": "Ivern-Q", "start": 4, "end": 14 },
            { "kind": "keyword", "key": "rooted", "start": 87, "end": 93 }
          ],
          "pWrong": 0.03
        },
        {
          "id": "jungle:Ivern:general:2",
          "text": "Tell your allies to attack the rooted enemy. Rootcaller makes them dash into attack range, which helps melee allies most.",
          "refs": [
            { "kind": "keyword", "key": "rooted", "start": 31, "end": 37 },
            { "kind": "ability", "key": "Ivern-Q", "start": 45, "end": 55 }
          ],
          "pWrong": 0.06
        },
        {
          "id": "jungle:Ivern:general:3",
          "text": "Put Triggerseed on an ally just before a fight. It shields them, then bursts and slows enemies standing near them.",
          "refs": [
            { "kind": "ability", "key": "Ivern-E", "start": 4, "end": 15 },
            { "kind": "keyword", "key": "slowed", "start": 81, "end": 86 }
          ],
          "pWrong": 0.05
        },
        {
          "id": "jungle:Ivern:general:4",
          "text": "Grow Brushmaker patches at ambush spots and objectives before a fight. They reveal the area, and attacks from brush hit harder.",
          "refs": [
            { "kind": "ability", "key": "Ivern-W", "start": 5, "end": 15 }
          ],
          "pWrong": 0.29
        },
        {
          "id": "jungle:Ivern:general:5",
          "text": "Use Brushmaker to cover your escape when chased, or to hide an ally's engage from the enemy.",
          "refs": [
            { "kind": "ability", "key": "Ivern-W", "start": 4, "end": 14 }
          ],
          "pWrong": 0.12
        },
        {
          "id": "jungle:Ivern:general:6",
          "text": "Send Daisy! in at the start of a fight and have her hit the same enemy until her third attack knocks enemies up.",
          "refs": [
            { "kind": "ability", "key": "Ivern-R", "start": 5, "end": 11 }
          ],
          "pWrong": 0.26
        },
        {
          "id": "jungle:Ivern:general:7",
          "text": "Recast Daisy! to pull her back to protect a teammate, since she can block skillshots and slow chasers.",
          "refs": [
            { "kind": "ability", "key": "Ivern-R", "start": 7, "end": 13 }
          ],
          "pWrong": 0.85,
          "hidden": true
        }
      ],
      "combos": [
        {
          "id": "jungle:Ivern:combo:0",
          "name": "Root then recast dash",
          "category": "combo",
          "sequence": [
            { "kind": "ability", "key": "Ivern-Q" },
            { "kind": "ability", "key": "Ivern-Q" }
          ],
          "when": "When you want to close in on a rooted enemy to peel for or engage with an ally.",
          "whenRefs": [],
          "text": "After the vine roots a target, recast to dash onto them. Your allies can also attack the rooted target to dash in.",
          "textRefs": []
        }
      ]
    }
  ],
