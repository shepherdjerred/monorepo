{
  "name": "@shepherdjerred/alert-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run generate && vite build",
    "check:architecture": "bun scripts/check-architecture.ts",
    "dev": "bun run src/dev.ts",
    "docker:build": "docker buildx build --cache-from type=registry,ref=ghcr.io/shepherdjerred/alert-dashboard:buildcache ${DOCKER_BUILD_EXTRA_ARGS:-} --load -t alert-dashboard:dev -f Dockerfile ../..",
    "generate": "prisma generate",
    "lint": "bun run generate && eslint . --max-warnings=0 && bun run check:architecture",
    "migrate:deploy": "prisma migrate deploy",
    "start": "bun run src/server/index.ts",
    "test": "bun run generate && bun --no-install --bun vitest --config ../../vitest.config.ts run src",
    "test:sqlite": "bun run generate && bun --no-install --bun vitest --config ../../vitest.config.ts run ./integration/sqlite.integration.test.ts",
    "test:e2e": "bun --no-install --bun playwright test",
    "test:ci": "bun ../../scripts/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../scripts/run-ci-test.ts",
    "typecheck": "bun run generate && PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit"
  },
  "imports": {
    "#application/*": "./src/application/*.ts",
    "#client/*": "./src/client/*.tsx",
    "#components/*": "./src/components/*.tsx",
    "#domain/*": "./src/domain/*.ts",
    "#generated/*": "./generated/*",
    "#infrastructure/*": "./src/infrastructure/*.ts",
    "#lib/*": "./src/lib/*.ts",
    "#server/*": "./src/server/*.ts",
    "#shared/*": "./src/shared/*.ts",
    "#styles/*": "./src/styles/*"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.7.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@prisma/adapter-libsql": "7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/client-runtime-utils": "7.9.1",
    "@tanstack/react-query": "^5.101.2",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@trpc/tanstack-react-query": "^11.18.0",
    "clsx": "^2.1.1",
    "hono": "^4.12.18",
    "lucide-react": "^1.14.0",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^8.3.0",
    "sanitize-html": "^2.17.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shepherdjerred/eslint-config": "workspace:*",
    "@tailwindcss/vite": "^4.2.4",
    "@types/bun": "1.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@playwright/test": "1.62.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "shadcn": "^4.14.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "4.1.10",
    "@vitest/coverage-istanbul": "4.1.10"
  }
}
