{
  "name": "@arcade/backend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "test": "bun --no-install --bun vitest --config ../../../../vitest.config.ts run",
    "test:ci": "bun ../../../../scripts/ci/run-ci-test.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@arcade/common": "workspace:*",
    "@shepherdjerred/discord-stream-lifecycle": "workspace:*",
    "@shepherdjerred/discord-plays-core": "workspace:*",
    "@discord-plays-mario-kart/backend": "workspace:*",
    "@discord-plays-pokemon/backend": "workspace:*",
    "@discord-plays-mario-kart/common": "workspace:*",
    "@discord-plays-pokemon/common": "workspace:*",
    "@shepherdjerred/config": "workspace:*",
    "@shepherdjerred/feature-flags": "workspace:*",
    "@shepherdjerred/llm-observability": "workspace:*",
    "discord.js": "^14.26.4",
    "express": "^5.0.0",
    "socket.io": "^4.8.1",
    "playwright-core": "1.64.0",
    "ws": "^8.18.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shepherdjerred/eslint-config": "workspace:*",
    "@types/bun": "1.4.2",
    "@types/node": "^26.1.1",
    "@types/express": "^5.0.1",
    "@types/ws": "^8.18.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "vitest": "5.0.3",
    "socket.io-client": "^4.8.1",
    "@vitest/coverage-istanbul": "5.0.3"
  }
}
