diff --git a/util/converter/rewrite_reuse.go b/util/converter/rewrite_reuse.go
new file mode 100644
index 0000000..192ab6e
--- /dev/null
+++ b/util/converter/rewrite_reuse.go
@@ -0,0 +1,199 @@
+package converter
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"runtime"
+	"strconv"
+	"strings"
+
+	"github.com/containerd/containerd/v2/core/content"
+	"github.com/containerd/containerd/v2/pkg/labels"
+	"github.com/moby/buildkit/util/bklog"
+	"github.com/moby/buildkit/util/compression"
+	"github.com/moby/buildkit/version"
+	digest "github.com/opencontainers/go-digest"
+	ocispecs "github.com/opencontainers/image-spec/specs-go/v1"
+)
+
+// Reuse of timestamp-rewritten layer blobs.
+//
+// Rewriting a layer to SOURCE_DATE_EPOCH is a pure function of the source
+// blob's bytes and the converter configuration, so a rewritten blob produced
+// once can be reused for every later export of the same source blob instead of
+// decompressing, rewriting and recompressing it again.
+//
+// After a conversion commits, the source blob is labelled with a record of
+// the rewritten blob, keyed by a hash of the normalized converter
+// configuration, and with a containerd GC content reference to it.
+//
+// The GC reference is followed whenever the source blob is reachable through a
+// non-flat lease. Records whose blobs BuildKit produced (setBlob) hold them in
+// the record's non-flat compression-variants lease, so the rewritten blob lives
+// as long as the record does. Records created only by GetByBlob (pulled or
+// imported layers) hold their blob in a flat lease, which GC does not traverse:
+// their rewritten blob is collected on the next GC and the following export
+// converts the layer again. That is a missed reuse, never a wrong one.
+//
+// A record is only reused when the referenced blob is present in the content
+// store with the recorded size, uncompressed digest and epoch. Otherwise the
+// layer is converted as before and the record is replaced.
+const (
+	// rewriteReuseVersion is part of every reuse key. Bump it whenever the
+	// rewrite or compression output for a given configuration may change, so
+	// records written by an older converter are never reused.
+	rewriteReuseVersion = "1"
+
+	labelRewriteReusePrefix = "buildkit.io/rewritten-timestamp-reuse."
+
+	// RewrittenBlobGCLabelPrefix prefixes the GC content references from a
+	// source blob to its retained rewritten blobs. Cache accounting counts the
+	// referenced blobs so that disk usage and GC policies include them.
+	RewrittenBlobGCLabelPrefix = "containerd.io/gc.ref.content.buildkit.rewritten."
+	labelGCRefRewritten        = RewrittenBlobGCLabelPrefix
+)
+
+// RewrittenBlobs returns the rewritten blobs a source blob's labels retain.
+func RewrittenBlobs(labels map[string]string) []digest.Digest {
+	var out []digest.Digest
+	for k, v := range labels {
+		if !strings.HasPrefix(k, RewrittenBlobGCLabelPrefix) {
+			continue
+		}
+		if dgst, err := digest.Parse(v); err == nil {
+			out = append(out, dgst)
+		}
+	}
+	return out
+}
+
+type rewriteReuseRecord struct {
+	Digest digest.Digest `json:"digest"`
+	Size   int64         `json:"size"`
+	DiffID digest.Digest `json:"diffID"`
+}
+
+// rewriteReuseKey returns the key that identifies every converter input other
+// than the source blob, and whether results of this conversion may be reused.
+func (c *conversion) rewriteReuseKey() (string, bool) {
+	if c.rewriteTimestamp == nil {
+		return "", false
+	}
+	// An immutable base-image diffID is compared against the source while it is
+	// being converted; keep that path exact by never reusing for such layers.
+	if len(c.immDiffIDs) > 0 {
+		return "", false
+	}
+	// Only compression types whose descriptor carries no finalizer
+	// annotations; estargz and similar formats record per-blob metadata that a
+	// reuse record does not reproduce.
+	switch c.target.Type {
+	case compression.Gzip, compression.Zstd, compression.Uncompressed:
+	default:
+		return "", false
+	}
+	if c.finalize != nil {
+		return "", false
+	}
+	level := "default"
+	if c.target.Level != nil {
+		level = strconv.Itoa(*c.target.Level)
+	}
+	// The toolchain and BuildKit revision are part of the key: the tar writer
+	// and compressors come from them, so an upgrade never reuses a blob an
+	// older build produced.
+	normalized := strings.Join([]string{
+		"version=" + rewriteReuseVersion,
+		"go=" + runtime.Version(),
+		"buildkit=" + version.Revision,
+		"epoch=" + strconv.FormatInt(c.rewriteTimestamp.UTC().UnixNano(), 10),
+		"type=" + c.target.Type.String(),
+		"mediatype=" + c.target.Type.MediaType(),
+		"force=" + strconv.FormatBool(c.target.Force),
+		"level=" + level,
+	}, "\n")
+	return digest.FromString(normalized).Encoded()[:32], true
+}
+
+// lookupRewrittenBlob returns the descriptor of a previously rewritten blob
+// for desc, or false when no verified record exists.
+func (c *conversion) lookupRewrittenBlob(ctx context.Context, cs content.Store, desc ocispecs.Descriptor, key string) (*ocispecs.Descriptor, bool) {
+	info, err := cs.Info(ctx, desc.Digest)
+	if err != nil {
+		return nil, false
+	}
+	raw, ok := info.Labels[labelRewriteReusePrefix+key]
+	if !ok {
+		return nil, false
+	}
+	var rec rewriteReuseRecord
+	if err := json.Unmarshal([]byte(raw), &rec); err != nil || rec.Digest.Validate() != nil || rec.DiffID.Validate() != nil {
+		return nil, false
+	}
+	if info.Labels[labelGCRefRewritten+key] != rec.Digest.String() {
+		return nil, false
+	}
+	target, err := cs.Info(ctx, rec.Digest)
+	if err != nil {
+		return nil, false
+	}
+	epoch := fmt.Sprintf("%d", c.rewriteTimestamp.UTC().Unix())
+	if target.Size != rec.Size ||
+		target.Labels[labels.LabelUncompressed] != rec.DiffID.String() ||
+		target.Labels[labelRewrittenTimestamp] != epoch {
+		return nil, false
+	}
+	newDesc := desc
+	newDesc.MediaType = c.target.Type.MediaType()
+	newDesc.Digest = rec.Digest
+	newDesc.Size = rec.Size
+	newDesc.Annotations = map[string]string{
+		labels.LabelUncompressed: rec.DiffID.String(),
+		labelRewrittenTimestamp:  epoch,
+	}
+	bklog.G(ctx).WithField("blob", desc.Digest).WithField("rewritten", rec.Digest).Debugf("reusing timestamp-rewritten blob")
+	return &newDesc, true
+}
+
+// recordRewrittenBlob labels desc's blob with a record of newDesc and a GC
+// reference to it. Failing to record only means the next export converts the
+// layer again, so errors are logged rather than returned.
+func recordRewrittenBlob(ctx context.Context, cs content.Store, desc ocispecs.Descriptor, key string, newDesc ocispecs.Descriptor) {
+	if newDesc.Digest == desc.Digest {
+		return
+	}
+	rec, err := json.Marshal(rewriteReuseRecord{
+		Digest: newDesc.Digest,
+		Size:   newDesc.Size,
+		DiffID: digest.Digest(newDesc.Annotations[labels.LabelUncompressed]),
+	})
+	if err != nil {
+		return
+	}
+	// A rewritten blob that already existed (for example, pulled back from a
+	// registry) keeps the labels it was ingested with, because the commit
+	// above returns AlreadyExists without applying new labels. Stamp the
+	// labels this conversion just computed so the record verifies next time.
+	if _, err := cs.Update(ctx, content.Info{
+		Digest: newDesc.Digest,
+		Labels: map[string]string{
+			labels.LabelUncompressed: newDesc.Annotations[labels.LabelUncompressed],
+			labelRewrittenTimestamp:  newDesc.Annotations[labelRewrittenTimestamp],
+		},
+	}, "labels."+labels.LabelUncompressed, "labels."+labelRewrittenTimestamp); err != nil {
+		bklog.G(ctx).WithError(err).WithField("blob", newDesc.Digest).Warnf("failed to label timestamp-rewritten blob for reuse")
+		return
+	}
+	recordKey := labelRewriteReusePrefix + key
+	gcKey := labelGCRefRewritten + key
+	if _, err := cs.Update(ctx, content.Info{
+		Digest: desc.Digest,
+		Labels: map[string]string{
+			recordKey: string(rec),
+			gcKey:     newDesc.Digest.String(),
+		},
+	}, "labels."+recordKey, "labels."+gcKey); err != nil {
+		bklog.G(ctx).WithError(err).WithField("blob", desc.Digest).Warnf("failed to record timestamp-rewritten blob for reuse")
+	}
+}
