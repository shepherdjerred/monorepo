{
  "$schema": "../../scripts/ci-test.schema.json",
  "steps": [
    {
      "runner": "command",
      "name": "generate",
      "command": ["bun", "run", "scripts/generate.ts"]
    },
    {
      "runner": "vitest",
      "args": ["test"]
