            { "kind": "keyword", "key": "slowed", "start": 69, "end": 75 }
          ],
          "pWrong": 0.47
        },
        {
          "id": "top:Quinn:Aatrox:3",
          "text": "Move sideways or toward Aatrox to leave Infernal Chains before it pulls you back and hits again.",
          "refs": [
            { "kind": "champion", "key": "Aatrox", "start": 24, "end": 30 },
            { "kind": "ability", "key": "Aatrox-W", "start": 40, "end": 55 }
          ],
          "pWrong": 0.1
        },
        {
          "id": "top:Quinn:Aatrox:4",
          "text": "Fight in short trades. When Aatrox hits you, his Deathbringer Stance heals him, so avoid long brawls.",
          "refs": [
            { "kind": "champion", "key": "Aatrox", "start": 28, "end": 34 },
            {
              "kind": "ability",
              "key": "Aatrox-passive",
              "start": 49,
              "end": 68
            }
          ],
          "pWrong": 0.99
        },
        {
          "id": "top:Quinn:Aatrox:5",
          "text": "Keep away from Aatrox while World Ender is active; his healing and damage rise and a kill extends it.",
          "refs": [
            { "kind": "champion", "key": "Aatrox", "start": 15, "end": 21 },
            { "kind": "ability", "key": "Aatrox-R", "start": 28, "end": 39 }
          ],
          "pWrong": 0.16
        }
