{
  "name": "@shepherdjerred/storm-stats",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "imports": {
    "#contracts/*": "./contracts/*"
  },
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "start": "bun src/index.ts",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run src",
    "test:ci": "bun ../../scripts/ci/run-ci-test.ts",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "lint": "bunx eslint --cache . --max-warnings=0"
  },
  "dependencies": {
    "@shepherdjerred/config": "workspace:*",
    "@shepherdjerred/feature-flags": "workspace:*",
    "hono": "^4.12.18",
    "lucide-react": "^1.14.0",
    "prom-client": "^15.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shepherdjerred/eslint-config": "workspace:*",
    "@types/bun": "1.4.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-istanbul": "5.1.2",
    "eslint": "^10.7.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "5.1.2"
  }
}
