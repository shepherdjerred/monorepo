---
import { FAQItem } from "@scout-for-lol/design-system/marketing";

interface Props {
  question: string;
}

const { question } = Astro.props;
const value = question.toLowerCase().replaceAll(/[^a-z0-9]+/g, "-");
---

<FAQItem value={value} question={question} client:visible>
  <slot />
</FAQItem>
