#!/bin/sh
set -eu

# cursor-agent's `stop` event does not fire in `-p` (print/non-interactive)
# mode (confirmed empirically: beforeShellExecution and sessionEnd both fired
# in a spike run, stop and afterAgentResponse never did). sessionEnd fires
# reliably and carries a `transcript_path`, but per Cursor's own hook docs it
# is observe-only — it cannot block or continue the session — so this is a
# post-hoc review popup, not a gate: it cannot feed changes back into the
# agent the way the grok/Antigravity Stop hooks do.

event="$(cat)"

# Skip subagent/background-agent completions; review the top-level session only.
is_background="$(printf '%s' "$event" | jq -r '.is_background_agent // false')"
[ "$is_background" = "true" ] && exit 0

reason="$(printf '%s' "$event" | jq -r '.reason // empty')"
[ "$reason" = "completed" ] || exit 0

transcript_path="$(printf '%s' "$event" | jq -r '.transcript_path // empty')"
if [ -z "$transcript_path" ] || [ ! -f "$transcript_path" ]; then
  echo "plannotator-cursor-session-end-hook: no readable transcript_path for a completed session" >&2
  exit 1
fi

last_message="$(jq -rs '[.[] | select(.role == "assistant")] | last | .message.content // [] | map(select(.type == "text") | .text) | join("\n\n")' "$transcript_path")"
if [ -z "$last_message" ]; then
  echo "plannotator-cursor-session-end-hook: no assistant text found in $transcript_path" >&2
  exit 1
fi

# sessionEnd's stdout is discarded (non-blocking), so this is fire-and-forget:
# open the review UI, but nothing consumes its decision.
printf '%s' "$last_message" | {{ .chezmoi.homeDir }}/.local/bin/plannotator annotate-last --stdin --gate >/dev/null
