{
  "name": "@shepherdjerred/monarch",
  "version": "0.1.0",
  "description": "Monarch Money transaction classifier using Claude AI + Amazon order matching",
  "type": "module",
  "bin": {
    "monarch-classify": "./src/index.ts"
  },
  "scripts": {
    "login": "bun run scripts/monarch-browser-login.ts",
    "login:password": "bun run scripts/monarch-login.ts",
    "login:browser": "bun run scripts/monarch-browser-login.ts",
    "test": "bun test",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "lint": "bunx eslint .",
    "test:ci": "bun ../../scripts/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../scripts/run-ci-test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@shepherdjerred/llm-models": "workspace:*",
    "pdfjs-dist": "^6.1.200",
    "playwright": "1.62.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shepherdjerred/eslint-config": "workspace:*",
    "bun-types": "^1.3.13",
    "eslint": "^10.3.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "author": "Jerred Shepherd",
  "license": "GPL-3.0"
}
