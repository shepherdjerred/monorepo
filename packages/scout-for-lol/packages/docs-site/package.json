{
  "name": "@scout-for-lol/docs-site",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "description": "User documentation for Scout for League of Legends",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "test": "bun run test:flavor:prod && bun run test:flavor:beta",
    "test:flavor:prod": "PUBLIC_SCOUT_SITE_FLAVOR=prod bun run build && bun --no-install --bun vitest --config ../../../../vitest.config.ts run src",
    "test:flavor:beta": "PUBLIC_SCOUT_SITE_FLAVOR=beta bun run build && bun --no-install --bun vitest --config ../../../../vitest.config.ts run src",
    "test:ci": "bun ../../../../scripts/ci/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../../../scripts/ci/run-ci-test.ts",
    "lint": "astro sync && eslint --cache",
    "generate": "bun run scripts/generate-render-samples.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.41.5",
    "@expressive-code/core": "^0.44.1",
    "@scout-for-lol/data": "workspace:*",
    "@scout-for-lol/design-system": "workspace:*",
    "astro": "^7.1.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@scout-for-lol/backend": "workspace:*",
    "@scout-for-lol/report": "workspace:*",
    "@shepherdjerred/eslint-config": "workspace:*",
    "@types/bun": "1.4.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.3.0",
    "typescript": "^6.0.3",
    "vitest": "4.1.10",
    "@vitest/coverage-istanbul": "4.1.10"
  },
  "license": "GPL-3.0-only"
}
