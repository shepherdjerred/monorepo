      "tips": [
        {
          "id": "jungle:Lillia:general:0",
          "text": "Hit a champion or monster with any ability first; Dream-Laden Bough then burns their max Health over time and heals you.",
          "refs": [
            {
              "kind": "ability",
              "key": "Lillia-passive",
              "start": 50,
              "end": 67
            }
          ],
          "pWrong": 0.31
        },
        {
          "id": "jungle:Lillia:general:1",
          "text": "Hit a champion before casting Lilting Lullaby, because it only puts enemies to sleep if they are carrying Dream Dust from your other abilities.",
          "refs": [
            { "kind": "ability", "key": "Lillia-R", "start": 30, "end": 45 }
          ],
          "pWrong": 0.15
        },
        {
          "id": "jungle:Lillia:general:2",
          "text": "Aim Watch Out! Eep! so the enemy stands in the center of the strike, because that spot deals far more damage than the edge.",
          "refs": [
            { "kind": "ability", "key": "Lillia-W", "start": 4, "end": 19 }
          ],
          "pWrong": 0.05
        },
        {
          "id": "jungle:Lillia:general:3",
          "text": "Throw Swirlseed past a fleeing enemy; it keeps rolling until it hits someone, then leaves them slowed.",
          "refs": [
            { "kind": "ability", "key": "Lillia-E", "start": 6, "end": 15 },
            { "kind": "keyword", "key": "slowed", "start": 95, "end": 101 }
          ],
          "pWrong": 0.36
        },
        {
          "id": "jungle:Lillia:general:4",
          "text": "Keep landing Blooming Blows on monsters and enemies to build Move Speed; you can walk while she swings.",
          "refs": [
            { "kind": "ability", "key": "Lillia-Q", "start": 13, "end": 27 }
          ],
          "pWrong": 0.19
        },
        {
          "id": "jungle:Lillia:general:5",
          "text": "Hit the outer edge with Blooming Blows to deal extra true damage. Stay at that range when you fight.",
          "refs": [
            { "kind": "ability", "key": "Lillia-Q", "start": 24, "end": 38 }
          ],
          "pWrong": 1
        }
      ],
      "combos": [
        {
          "id": "jungle:Lillia:combo:0",
          "name": "Wall hop with W",
          "category": "terrain",
          "sequence": [{ "kind": "ability", "key": "Lillia-W" }],
          "when": "When you want to cross a thin wall edge in the jungle to chase or escape.",
          "whenRefs": [],
          "text": "Watch Out! Eep! can't pass through terrain, but Lillia can hop over the edges of some thin walls if you aim just past them.",
          "textRefs": [
            { "kind": "ability", "key": "Lillia-W", "start": 0, "end": 15 },
            { "kind": "champion", "key": "Lillia", "start": 48, "end": 54 }
          ]
        }
      ]
    }
  ],
