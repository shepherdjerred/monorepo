            { "kind": "ability", "key": "Kled-W", "start": 113, "end": 131 }
          ],
          "pWrong": 0.53
        },
        {
          "id": "top:Kled:Briar:2",
          "text": "Don't stand near a wall when Briar charges Chilling Scream. A full charge knocks you back and stuns you.",
          "refs": [
            { "kind": "champion", "key": "Briar", "start": 29, "end": 34 },
            { "kind": "ability", "key": "Briar-E", "start": 43, "end": 58 },
            { "kind": "keyword", "key": "stunned", "start": 94, "end": 99 }
          ],
          "pWrong": 0.11
        },
        {
          "id": "top:Kled:Briar:3",
          "text": "Use Jousting to dash through Briar and get out, or back in for a second hit.",
          "refs": [
            { "kind": "ability", "key": "Kled-E", "start": 4, "end": 12 },
            { "kind": "champion", "key": "Briar", "start": 29, "end": 34 }
          ],
          "pWrong": 0.48
        }
      ],
      "opponent": "Briar",
      "comboRefs": []
    },
    {
      "lane": "top",
      "inputHash": "895eac32a8e34c56356817c924dc6712bb0c66a3f0c2fbca7f70510cdf556d69",
      "tips": [
        {
          "id": "top:Kled:Darius:0",
          "text": "Hit Darius with Bear Trap on a Rope from long range. Stay near him until the tether pulls, because the pull does extra damage and slows him.",
          "refs": [
            { "kind": "champion", "key": "Darius", "start": 4, "end": 10 },
            { "kind": "ability", "key": "Kled-Q", "start": 16, "end": 35 },
            { "kind": "keyword", "key": "slowed", "start": 130, "end": 135 }
          ],
          "pWrong": 0.13
        },
        {
          "id": "top:Kled:Darius:1",
          "text": "Stay out of Apprehend's cone and away from walls of minions. If he pulls you, expect Crippling Strike to follow.",
          "refs": [
            { "kind": "ability", "key": "Darius-E", "start": 12, "end": 21 },
            { "kind": "ability", "key": "Darius-W", "start": 85, "end": 101 }
          ],
          "pWrong": 0.43
        },
        {
          "id": "top:Kled:Darius:2",
          "text": "Trade while Apprehend is on cooldown. Without the pull he has trouble catching you.",
          "refs": [
            { "kind": "ability", "key": "Darius-E", "start": 12, "end": 21 }
          ],
          "pWrong": 0.24
        },
        {
          "id": "top:Kled:Darius:3",
          "text": "Do not let Darius stack up Hemorrhage on you. Back off when his stacks are high, because he becomes much stronger and Noxian Guillotine hits harder.",
          "refs": [
            { "kind": "champion", "key": "Darius", "start": 11, "end": 17 },
            {
              "kind": "ability",
              "key": "Darius-passive",
              "start": 27,
              "end": 37
            },
            { "kind": "ability", "key": "Darius-R", "start": 118, "end": 135 }
          ],
          "pWrong": 0.18
        },
        {
          "id": "top:Kled:Darius:4",
          "text": "Use the dash from Jousting to slip out of Decimate. Dash through Darius and follow up with Violent Tendencies for a quick trade.",
          "refs": [
            { "kind": "ability", "key": "Kled-E", "start": 18, "end": 26 },
            { "kind": "ability", "key": "Darius-Q", "start": 42, "end": 50 },
            { "kind": "champion", "key": "Darius", "start": 65, "end": 71 },
            { "kind": "ability", "key": "Kled-W", "start": 91, "end": 109 }
          ],
          "pWrong": 0.77
        }
      ],
      "opponent": "Darius",
      "comboRefs": []
    },
