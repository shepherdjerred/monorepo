---
import { marketingTrackingConfig } from "#src/lib/marketing.ts";
import { GET_STARTED_CLICK_EVENT } from "#src/lib/marketing-constants.ts";

const { pinterestTagId, redditPixelId } = marketingTrackingConfig;
const getStartedClickEvent = GET_STARTED_CLICK_EVENT;
---

<script
  is:inline
  defer
  src="/marketing-tracking.js"
  data-pinterest-tag-id={pinterestTagId}
  data-reddit-pixel-id={redditPixelId}
  data-get-started-click-event={getStartedClickEvent}></script>
