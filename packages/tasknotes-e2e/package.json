{
  "name": "@tasknotes/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./chaos-proxy": "./src/chaos-proxy.ts"
  },
  "scripts": {
    "build": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "lint": "bun node_modules/eslint/bin/eslint.js .",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run",
    "test:ci": "bun ../../scripts/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../scripts/run-ci-test.ts",
    "coverage:portable": "bun --no-install --bun vitest --config ../../vitest.config.ts run ./tests --coverage --coverage.reporter=text --coverage.reporter=lcovonly --coverage.reportsDirectory=coverage --coverage.thresholds.lines=85 --coverage.thresholds.functions=90 --coverage.thresholds.statements=85"
  },
  "devDependencies": {
    "@shepherdjerred/eslint-config": "workspace:*",
    "@types/bun": "1.4.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "tasknotes-server": "workspace:*",
    "typescript": "^6.0.3",
    "zod": "^4.4.3",
    "vitest": "4.1.10",
    "@vitest/coverage-istanbul": "4.1.10"
  }
}
