      "tips": [
        {
          "id": "jungle:RekSai:general:0",
          "text": "Cast Burrow before you travel the map; it gives extra Move Speed and Tremor Sense shows you moving enemies nearby, which helps when you enter enemy territory.",
          "refs": [],
          "pWrong": 0
        },
        {
          "id": "jungle:RekSai:general:1",
          "text": "Attack an enemy while Burrowed to Unburrow into them. It knocks them up, so open fights that way.",
          "refs": [],
          "pWrong": 0.16
        },
        {
          "id": "jungle:RekSai:general:2",
          "text": "Hold Furious Bite until your Fury is full. It then deals true damage and hits harder, so it is a great finisher.",
          "refs": [],
          "pWrong": 0.08
        },
        {
          "id": "jungle:RekSai:general:3",
          "text": "Spread tunnels around the map with Tunnel so you always have an entrance to escape through or to reach a target for Void Rush.",
          "refs": [
            { "kind": "ability", "key": "RekSai-R", "start": 116, "end": 125 }
          ],
          "pWrong": 0.71
        },
        {
          "id": "jungle:RekSai:general:4",
          "text": "Hit an enemy champion first, then use Void Rush. It only works on someone you damaged recently, and you can't be stopped while you dive.",
          "refs": [
            { "kind": "ability", "key": "RekSai-R", "start": 38, "end": 47 }
          ],
          "pWrong": 0.18
        },
        {
          "id": "jungle:RekSai:general:5",
          "text": "Burrow when you are hurt and have built up Fury. Burrowing turns Fury into healing.",
          "refs": [],
          "pWrong": 0.02
        },
        {
          "id": "jungle:RekSai:general:6",
          "text": "Use Prey Seeker on a champion to reveal them for a short time. It stops at the first enemy it hits, so aim at open lanes.",
          "refs": [],
          "pWrong": 0.78
        },
        {
          "id": "jungle:RekSai:general:7",
          "text": "Use Queen's Wrath before you auto-attack in a fight. It adds Attack Speed and extra damage to nearby enemies.",
          "refs": [],
          "pWrong": 0.2
        },
        {
          "id": "jungle:RekSai:general:8",
          "text": "Stay out of silenced status when you want to tunnel away. You can't enter a tunnel while silenced.",
          "refs": [
            { "kind": "keyword", "key": "silenced", "start": 12, "end": 20 },
            { "kind": "keyword", "key": "silenced", "start": 89, "end": 97 }
          ],
          "pWrong": 0.02
        }
      ],
      "combos": [
        {
          "id": "jungle:RekSai:combo:0",
          "name": "Tunnel knock-up",
          "category": "trick",
          "sequence": [{ "kind": "ability", "key": "RekSai-E" }, "attack"],
          "when": "When you want to engage and knock up a target while dashing through them with Tunnel.",
          "whenRefs": [],
          "text": "While burrowed, cast Tunnel and issue an attack command on an enemy as the dash passes them. Unburrow triggers and knocks them up, and the dash still finishes.",
          "textRefs": []
        },
        {
          "id": "jungle:RekSai:combo:1",
          "name": "Attack-command Unburrow",
          "category": "trick",
          "sequence": [{ "kind": "ability", "key": "RekSai-W" }, "attack"],
          "when": "When engaging a champion or jungle monster while burrowed.",
          "whenRefs": [],
          "text": "Right-click the target while burrowed so Unburrow casts on its own once in range. This knocks them up with no separate cast.",
          "textRefs": []
        }
      ]
    }
  ],
