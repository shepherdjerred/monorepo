{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun"],
    "noEmit": true
  },
  "include": [
    "**/*.ts",
    "types/**/*.d.ts",
    "observability/**/*.ts",
    "../.buildkite/scripts/**/*.ts"
  ],
  // local-stack is a standalone mini-package (own package.json + bun.lock,
  // deliberately outside the workspace); its deps only exist after its own
  // install, so the scripts typecheck must not include it.
  // `ci` was excluded here for a directory that no longer exists; leaving it
  // would silently drop the real `ci/` sub-domain from the project service.
  "exclude": ["node_modules", "observability/local-stack"]
}
