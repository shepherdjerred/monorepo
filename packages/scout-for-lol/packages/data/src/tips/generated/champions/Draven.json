          "textRefs": [
            { "kind": "ability", "key": "Draven-W", "start": 26, "end": 36 }
          ]
        },
        {
          "id": "adc:Draven:combo:1",
          "name": "Axe steering",
          "category": "trick",
          "sequence": [{ "kind": "ability", "key": "Draven-Q" }, "attack"],
