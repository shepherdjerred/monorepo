            { "kind": "keyword", "key": "poke", "start": 61, "end": 65 }
          ],
          "pWrong": 0.27
        },
        {
          "id": "top:Sett:Sion:3",
          "text": "Don't stand in Sion's Soul Furnace blast after his shield has been up a while; step away or break the shield first.",
          "refs": [
            { "kind": "champion", "key": "Sion", "start": 15, "end": 19 },
            { "kind": "ability", "key": "Sion-W", "start": 22, "end": 34 }
          ],
          "pWrong": 0.32
        },
        {
          "id": "top:Sett:Sion:4",
          "text": "Use The Show Stopper on Sion early in a fight. Don't chase him after he dies, because Glory in Death makes him dangerous for a moment.",
          "refs": [
            { "kind": "ability", "key": "Sett-R", "start": 4, "end": 20 },
            { "kind": "champion", "key": "Sion", "start": 24, "end": 28 },
            {
              "kind": "ability",
              "key": "Sion-passive",
              "start": 86,
              "end": 100
            }
          ],
          "pWrong": 0.4
