  "general": [
    {
      "lane": "middle",
      "inputHash": "6feaf9eee4ec37e17fd471951e3ca4f2eb7b5abc3df5d036f02189ddfdc79fb0",
      "tips": [
        {
          "id": "middle:Akshan:general:0",
          "text": "Throw Avengerang through the minion wave so it also hits the enemy champion; its range grows with each hit.",
          "refs": [
            { "kind": "ability", "key": "Akshan-Q", "start": 6, "end": 16 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "middle:Akshan:general:1",
          "text": "Hit a champion with Avengerang and keep chasing or run away; the Move Speed boost fades quickly, so use it right away.",
          "refs": [
            { "kind": "ability", "key": "Akshan-Q", "start": 20, "end": 30 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "middle:Akshan:general:2",
          "text": "Swing with Heroic Swing to dodge enemy skillshots or close in on the enemy. You must hook onto terrain first, so stay near walls.",
          "refs": [
            { "kind": "ability", "key": "Akshan-E", "start": 11, "end": 23 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "middle:Akshan:general:3",
          "text": "Don't cast Heroic Swing while the enemy can stun or pin you; being stopped in the middle of the swing cancels it.",
          "refs": [
            { "kind": "ability", "key": "Akshan-E", "start": 11, "end": 23 }
          ],
          "pWrong": 0.03
        },
        {
          "id": "middle:Akshan:general:4",
          "text": "Take a champion down and Heroic Swing is ready again almost at once. Use it to chain into the next fight or to escape.",
          "refs": [
            { "kind": "ability", "key": "Akshan-E", "start": 25, "end": 37 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "middle:Akshan:general:5",
          "text": "Use Going Rogue to hide in a brush or beside a wall and flank. Attacking or casting a spell ends it.",
          "refs": [
            { "kind": "ability", "key": "Akshan-W", "start": 4, "end": 15 }
          ],
          "pWrong": 0.09
        },
        {
          "id": "middle:Akshan:general:6",
          "text": "If an enemy kills your ally, they become a Scoundrel. Kill them with Going Rogue's help to bring back everyone they killed.",
          "refs": [
            { "kind": "ability", "key": "Akshan-W", "start": 69, "end": 80 }
          ],
          "pWrong": 0.79
        },
        {
          "id": "middle:Akshan:general:7",
          "text": "Mix attacks and spells on one champion. Every third hit with Dirty Fighting adds bonus damage and gives you a shield.",
          "refs": [
            {
              "kind": "ability",
              "key": "Akshan-passive",
              "start": 61,
              "end": 75
            }
          ],
          "pWrong": 0.05
        },
        {
          "id": "middle:Akshan:general:8",
          "text": "Cancel the extra shot from Dirty Fighting by moving right after an attack. You get a burst of Move Speed for stutter-stepping.",
          "refs": [
            {
              "kind": "ability",
              "key": "Akshan-passive",
              "start": 27,
              "end": 41
            }
          ],
          "pWrong": 0.08
        },
        {
          "id": "middle:Akshan:general:9",
          "text": "Use Comeuppance on a weakened enemy; it hurts more the lower their health is. You can still move and swing while it charges.",
          "refs": [
            { "kind": "ability", "key": "Akshan-R", "start": 4, "end": 15 }
          ],
          "pWrong": 0.05
        }
      ],
      "combos": [
        {
          "id": "middle:Akshan:combo:0",
          "name": "Second shot cancel",
          "category": "trick",
          "sequence": ["attack"],
          "when": "When kiting or chasing in a trade and you want extra movement speed.",
          "whenRefs": [],
          "text": "Right after the first shot, issue a move command to cancel the second shot. You gain a burst of move speed, which lets you weave attacks and movement.",
          "textRefs": []
        },
        {
          "id": "middle:Akshan:combo:1",
          "name": "Swing and dive",
          "category": "trick",
          "sequence": [
            { "kind": "ability", "key": "Akshan-E" },
            { "kind": "ability", "key": "Akshan-E" },
            { "kind": "ability", "key": "Akshan-E" }
          ],
          "when": "When you need to reposition or close the gap using walls, terrain, or enemies in lane.",
          "whenRefs": [],
          "text": "Cast the hook onto terrain, swing around it, then recast to dive off toward your target. Raising your cursor to the left or right picks the swing direction.",
          "textRefs": []
        },
        {
          "id": "middle:Akshan:combo:2",
          "name": "Boomerang during dive",
          "category": "combo",
          "sequence": [
            { "kind": "ability", "key": "Akshan-E" },
            { "kind": "ability", "key": "Akshan-E" },
            { "kind": "ability", "key": "Akshan-E" },
            { "kind": "ability", "key": "Akshan-Q" }
          ],
          "when": "When you dive off a swing and want to add burst damage on the landing.",
          "whenRefs": [],
          "text": "Avengerang can be cast during the third-cast dash, but not while the hook or swing is active. Throw it mid-dive to add damage as you land.",
          "textRefs": [
            { "kind": "ability", "key": "Akshan-Q", "start": 0, "end": 10 }
          ]
        }
      ]
    }
  ],
  "matchups": [
    {
