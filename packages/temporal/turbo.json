{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // The workflow-worker suite resolves the mise-pinned Node executable.
    // Turbo's strict env mode otherwise drops the CI image's /opt/mise store
    // location and makes an installed Node version appear to be missing.
    "test": {
      "passThroughEnv": ["MISE_DATA_DIR"]
    },
    "test:ci": {
      "passThroughEnv": ["MISE_DATA_DIR"]
    },
    "test:report": {
      "passThroughEnv": ["MISE_DATA_DIR"]
    },
    // Rehearse the scheduled PR-creating workflows' environment prep against a
    // copy of the repo tree. Drives the SAME bot-clone.ts helpers the weekly
    // activities run.
    //
    // This task is for LOCAL use: run it when you touch bot-clone.ts or a
    // scheduled activity's install/repo-path assumptions. In production the
    // rehearsal runs on the `schedule-rehearsal-weekly` Temporal schedule
    // (Friday, 24h before the Saturday job it protects), not in CI — it was
    // the longest task in the root verify graph at ~338s of uncacheable work
    // per pull request, for a rehearsal of a once-a-week job.
    //
    // cache:false: the rehearsal copies the entire live repo tree and runs real
    // installs + git + prettier — its correctness depends on the whole tree
    // and on external tools (rsync), none of which
    // turbo can hash. `inputs` is scoped to the temporal-package sources it
    // loads directly; the cross-repo coupling is deliberately not modelled as a
    // turbo hash because it can't be (inputs cannot reach outside the package).
    "check:rehearsal": {
      "dependsOn": ["^build"],
      "inputs": [
        "scripts/check-schedule-rehearsal.ts",
        "scripts/rehearse-bot-clone.ts",
        "src/activities/bot-clone.ts",
        "src/activities/data-dragon-shell.ts",
        "src/activities/scout-season-refresh.ts"
      ],
      "cache": false
    }
  }
}
