      "inputHash": "08d7cf6ccc932b20a710e3e28cb209bfc56bb45faca4a36b74c806583e900226",
      "tips": [
        {
          "id": "top:Heimerdinger:general:0",
          "text": "Place turrets with H-28 G Evolution Turret near each other and away from the enemy's reach, so they cover one another and punish anyone who walks up.",
          "refs": [
            {
              "kind": "ability",
              "key": "Heimerdinger-Q",
              "start": 19,
              "end": 42
            }
          ],
          "pWrong": 0.05
        },
        {
          "id": "top:Heimerdinger:general:1",
          "text": "Land CH-2 Electron Storm Grenade on a champion to fully charge nearby turrets. Aim it at the center so the enemy is stunned, not just slowed.",
          "refs": [
            {
              "kind": "ability",
              "key": "Heimerdinger-E",
              "start": 5,
              "end": 32
            },
            { "kind": "keyword", "key": "stunned", "start": 116, "end": 123 },
            { "kind": "keyword", "key": "slowed", "start": 134, "end": 140 }
          ],
          "pWrong": 0.06
        },
        {
          "id": "top:Heimerdinger:general:2",
          "text": "Keep CH-2 Electron Storm Grenade ready as your escape when a jungler shows up. Stun the attacker, then walk back to your turrets.",
          "refs": [
            {
              "kind": "ability",
              "key": "Heimerdinger-E",
              "start": 5,
              "end": 32
            },
            { "kind": "keyword", "key": "stunned", "start": 79, "end": 83 }
          ],
          "pWrong": 0.17
        },
        {
          "id": "top:Heimerdinger:general:3",
          "text": "Fire Hextech Micro-Rockets from long range to poke. Rockets that hit a champion also charge nearby turrets.",
          "refs": [
            {
              "kind": "ability",
              "key": "Heimerdinger-W",
              "start": 5,
              "end": 26
            },
            { "kind": "keyword", "key": "poke", "start": 46, "end": 50 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "top:Heimerdinger:general:4",
          "text": "Use Hextech Micro-Rockets on the minion wave too. Rockets after the first hit minions much harder, which helps you clear and push.",
          "refs": [
            {
              "kind": "ability",
              "key": "Heimerdinger-W",
              "start": 4,
              "end": 25
            }
          ],
          "pWrong": 0.98
        },
        {
          "id": "top:Heimerdinger:general:5",
          "text": "Stay close to your turrets when you fight. Hextech Affinity gives you extra Move Speed near them.",
          "refs": [
            {
              "kind": "ability",
              "key": "Heimerdinger-passive",
              "start": 43,
              "end": 59
            }
          ],
          "pWrong": 0
        },
        {
          "id": "top:Heimerdinger:general:6",
          "text": "Use UPGRADE!!! to make your next ability stronger. Save it for a kill or to get out of trouble, since it has a long cooldown.",
          "refs": [
            {
              "kind": "ability",
              "key": "Heimerdinger-R",
              "start": 4,
              "end": 14
            }
          ],
          "pWrong": 0.12
        },
        {
          "id": "top:Heimerdinger:general:7",
          "text": "Upgrade your turret ability for a strong turret that slows enemies and ignores crowd control. It is great for holding a spot in a fight.",
          "refs": [
            { "kind": "keyword", "key": "slowed", "start": 53, "end": 58 }
          ],
          "pWrong": 0.09
        },
        {
          "id": "top:Heimerdinger:general:8",
          "text": "Watch for enemies with area damage, because they can destroy your turrets quickly. Pull the turrets back or place them out of reach.",
          "refs": [],
          "pWrong": 0.05
        }
      ],
      "combos": [
        {
          "id": "top:Heimerdinger:combo:0",
          "name": "Upgraded grenade into rockets",
          "category": "combo",
          "sequence": [
            { "kind": "ability", "key": "Heimerdinger-R" },
            { "kind": "ability", "key": "Heimerdinger-E" },
            { "kind": "ability", "key": "Heimerdinger-W" }
          ],
          "when": "Use it when an enemy champion walks into your turrets or dives you and you want a guaranteed stun.",
          "whenRefs": [],
          "text": "Toggle the upgrade first so the next grenade is the big one with a wider stun. Then follow with rockets on the stunned target.",
          "textRefs": []
        },
        {
          "id": "top:Heimerdinger:combo:1",
          "name": "Grenade charges turrets",
          "category": "combo",
          "sequence": [
            { "kind": "ability", "key": "Heimerdinger-Q" },
            { "kind": "ability", "key": "Heimerdinger-E" },
            { "kind": "ability", "key": "Heimerdinger-W" }
          ],
          "when": "Use it when you are trading near your turrets and want their strong beams ready immediately.",
          "whenRefs": [],
          "text": "Place a turret by the enemy, then hit them with the grenade, which fully charges nearby turrets. Rockets add more damage while they are stuck.",
          "textRefs": []
        }
      ]
    }
  ],
  "matchups": [
    {
