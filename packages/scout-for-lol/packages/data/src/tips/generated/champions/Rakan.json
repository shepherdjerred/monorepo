      "tips": [
        {
          "id": "support:Rakan:general:0",
          "text": "Dash to an ally with Battle Dance to shield them and yourself into a fight. Recall it once within a short window to hop again and shield a second ally.",
          "refs": [
            { "kind": "ability", "key": "Rakan-E", "start": 21, "end": 33 },
            { "kind": "item", "key": "2001", "start": 76, "end": 82 }
          ],
          "pWrong": 0.83
        },
        {
          "id": "support:Rakan:general:1",
          "text": "Land Gleaming Quill on an enemy champion, then walk next to your carry to heal both of you right away.",
          "refs": [
            { "kind": "ability", "key": "Rakan-Q", "start": 5, "end": 19 }
          ],
          "pWrong": 0.62
        },
        {
          "id": "support:Rakan:general:2",
          "text": "Start trades with Grand Entrance when enemies are bunched up. It knocks them up, so your team gets a free window to hit them.",
          "refs": [
            { "kind": "ability", "key": "Rakan-W", "start": 18, "end": 32 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "support:Rakan:general:3",
          "text": "Stay close to your allies, because Rakan needs them for Battle Dance. Alone he has very little mobility.",
          "refs": [
            { "kind": "champion", "key": "Rakan", "start": 35, "end": 40 },
            { "kind": "ability", "key": "Rakan-E", "start": 56, "end": 68 }
          ],
          "pWrong": 0.31
        },
        {
          "id": "support:Rakan:general:4",
          "text": "Run into the enemy team with The Quickness at level 6 to charm everyone you touch, then let your team follow up.",
          "refs": [
            { "kind": "ability", "key": "Rakan-R", "start": 29, "end": 42 }
          ],
          "pWrong": 0.48
        },
        {
          "id": "support:Rakan:general:5",
          "text": "Hit enemy champions with attacks and abilities to bring back Fey Feathers sooner, so you get your shield more often in a trade.",
          "refs": [
            {
              "kind": "ability",
              "key": "Rakan-passive",
              "start": 61,
              "end": 73
            }
          ],
          "pWrong": 0.03
        },
        {
          "id": "support:Rakan:general:6",
          "text": "Don't dash with Grand Entrance or Battle Dance near enemy crowd control. Getting stunned or rooted mid-dash knocks you down.",
          "refs": [
            { "kind": "ability", "key": "Rakan-W", "start": 16, "end": 30 },
            { "kind": "ability", "key": "Rakan-E", "start": 34, "end": 46 },
            { "kind": "keyword", "key": "rooted", "start": 92, "end": 98 }
          ],
          "pWrong": 0.4
        }
      ],
      "combos": [
        {
          "id": "support:Rakan:combo:0",
