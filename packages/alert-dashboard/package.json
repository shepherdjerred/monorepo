{
  "name": "@shepherdjerred/alert-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check:architecture": "check-architecture",
    "dev": "bun run src/dev.ts",
    "dev:fixture": "bun run src/dev.ts --fixture",
    "email:cancel-incident": "bun run scripts/cancel-pending-incident-email.ts",
    "docker:build": "docker buildx build --cache-from type=registry,ref=docker.io/shepherdjerred/alert-dashboard:buildcache ${DOCKER_BUILD_EXTRA_ARGS:-} --load -t alert-dashboard:dev -f Dockerfile ../..",
    "generate": "prisma generate",
    "lint": "eslint . --max-warnings=0 && bun run check:architecture",
    "migrate:deploy": "prisma migrate deploy",
    "start": "bun run src/server/index.ts",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run src",
    "test:sqlite": "bun run generate && bun --no-install --bun vitest --config ../../vitest.config.ts run ./integration/sqlite.integration.test.ts",
    "test:e2e": "bun --no-install --bun playwright test",
    "test:ci": "bun ../../scripts/ci/run-ci-test.ts",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit"
  },
  "imports": {
    "#architecture": "./architecture.config.ts",
    "#application/*": "./src/application/*.ts",
    "#client/*": "./src/client/*",
    "#components/*": "./src/components/*.tsx",
    "#domain/*": "./src/domain/*.ts",
    "#generated/*": "./generated/*",
    "#infrastructure/*": "./src/infrastructure/*.ts",
    "#server/*": "./src/server/*.ts",
    "#shared/*": "./src/shared/*.ts",
    "#styles/*": "./src/styles/*",
    "#test-fixtures/*": "./src/test-fixtures/*.ts"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@hono/bun": "catalog:",
    "@js-temporal/polyfill": "catalog:",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@prisma/adapter-libsql": "7.10.1",
    "@prisma/client": "catalog:",
    "@prisma/client-runtime-utils": "7.10.1",
    "@shepherdjerred/loaded": "workspace:*",
    "@shepherdjerred/experiments": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@trpc/tanstack-react-query": "catalog:",
    "hono": "catalog:",
    "lucide-react": "catalog:",
    "prisma": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "8.4.0",
    "zod": "catalog:",
    "@shepherdjerred/ops-model": "workspace:*",
    "@shepherdjerred/ops-clients": "workspace:*",
    "@shepherdjerred/llm-observability": "workspace:*",
    "uplot": "catalog:",
    "@shepherdjerred/config": "workspace:*",
    "@shepherdjerred/feature-flags": "workspace:*",
    "@shepherdjerred/incidents": "workspace:*"
  },
  "devDependencies": {
    "@shepherdjerred/architecture": "workspace:*",
    "@shepherdjerred/console-ui": "workspace:*",
    "@shepherdjerred/eslint-config": "workspace:*",
    "@types/bun": "1.4.5",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@axe-core/playwright": "catalog:",
    "@playwright/test": "1.64.0",
    "@vitejs/plugin-react": "catalog:",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-istanbul": "catalog:"
  }
}
