  "general": [
    {
      "lane": "adc",
      "inputHash": "ef3c26260b33ee02915c47e7289cfc0e70e5fdee0cae0e0bbe96e6e398ef1661",
      "tips": [
        {
          "id": "adc:Kalista:general:0",
          "text": "Press a move command right as each basic attack winds up to lunge with Martial Poise. Attack, hop back, repeat to stay out of reach.",
          "refs": [
            {
              "kind": "ability",
              "key": "Kalista-passive",
              "start": 71,
              "end": 84
            }
          ],
          "pWrong": 0.62
        },
        {
          "id": "adc:Kalista:general:1",
          "text": "Use Rend to finish low-health minions. Their death resets its cooldown, so you can last-hit with it again right away.",
          "refs": [
            { "kind": "ability", "key": "Kalista-E", "start": 4, "end": 8 }
          ],
          "pWrong": 0.22
        },
        {
          "id": "adc:Kalista:general:2",
          "text": "Put spears on the enemy with attacks and Pierce first, then use Rend. It only works on enemies with spears in them, and more spears mean more damage.",
          "refs": [
            { "kind": "ability", "key": "Kalista-Q", "start": 41, "end": 47 },
            { "kind": "ability", "key": "Kalista-E", "start": 64, "end": 68 }
          ],
          "pWrong": 0.04
        },
        {
          "id": "adc:Kalista:general:3",
          "text": "Aim Pierce down the lane through a minion wave. It stops at the first target, but if it kills a minion it keeps flying and carries the spears to the next enemy.",
          "refs": [
            { "kind": "ability", "key": "Kalista-Q", "start": 4, "end": 10 }
          ],
          "pWrong": 0.82
        },
        {
          "id": "adc:Kalista:general:4",
          "text": "Rend leaves enemies slowed. Use it to stop a fleeing enemy or to cut off their approach.",
          "refs": [
            { "kind": "ability", "key": "Kalista-E", "start": 0, "end": 4 },
            { "kind": "keyword", "key": "slowed", "start": 20, "end": 26 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "adc:Kalista:general:5",
          "text": "Send Sentinel into the brush or toward the objectives to see danger coming. Hold a charge for when you need it.",
          "refs": [
            { "kind": "ability", "key": "Kalista-W", "start": 5, "end": 13 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "adc:Kalista:general:6",
          "text": "Use Fate's Call when your support is in range. They fly to the enemy and knock them up, which sets up a kill.",
          "refs": [
            { "kind": "ability", "key": "Kalista-R", "start": 4, "end": 15 }
          ],
          "pWrong": 0.72
        },
        {
          "id": "adc:Kalista:general:7",
          "text": "Stay close to your support. Sentinel and Fate's Call both rely on them being nearby.",
          "refs": [
            { "kind": "ability", "key": "Kalista-W", "start": 28, "end": 36 },
            { "kind": "ability", "key": "Kalista-R", "start": 41, "end": 52 }
          ],
          "pWrong": 0.76
        },
        {
          "id": "adc:Kalista:general:8",
          "text": "You can't cancel an attack once it starts. Don't begin one when an enemy skillshot is about to hit you.",
          "refs": [],
          "pWrong": 0.7
        }
      ],
      "combos": [
        {
          "id": "adc:Kalista:combo:0",
          "name": "Hop kiting",
          "category": "trick",
          "sequence": ["attack", "attack"],
          "when": "Any time you fight or chase, and when you kite away from enemies in lane.",
          "whenRefs": [],
          "text": "Enter a move command while your attack winds up to hop on each hit. Clicking the ground repeatedly keeps your target, so you can hop again and again.",
          "textRefs": []
        },
        {
          "id": "adc:Kalista:combo:1",
          "name": "Pierce hop",
          "category": "trick",
          "sequence": [{ "kind": "ability", "key": "Kalista-Q" }],
          "when": "When you want to poke with Pierce and stay out of enemy range.",
          "whenRefs": [
            { "kind": "ability", "key": "Kalista-Q", "start": 27, "end": 33 }
          ],
          "text": "Move away right after casting Pierce to hop backward as it launches. You poke from range and step out of the return fire.",
          "textRefs": [
            { "kind": "ability", "key": "Kalista-Q", "start": 30, "end": 36 }
          ]
        },
        {
          "id": "adc:Kalista:combo:2",
          "name": "Rend during a hop",
          "category": "trick",
          "sequence": ["attack", { "kind": "ability", "key": "Kalista-E" }],
          "when": "When you are about to last hit a minion or finish a champion while dashing.",
          "whenRefs": [],
          "text": "Rend can be cast during a hop or an attack windup. Use it to cancel the windup, and the empowered attack applies Rend on landing.",
          "textRefs": [
            { "kind": "ability", "key": "Kalista-E", "start": 0, "end": 4 },
            { "kind": "ability", "key": "Kalista-E", "start": 113, "end": 117 }
          ]
        }
      ]
    }
  ],
