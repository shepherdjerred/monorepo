  "general": [
    {
      "lane": "top",
      "inputHash": "fc44eb62e010530a57437f81833a2161d2765a4abad9571b9de3b1353adf47f4",
      "tips": [
        {
          "id": "top:Quinn:general:0",
          "text": "Cast Blinding Assault at the first enemy in its path; it stops there. On a champion it shrinks their vision, so use it before you trade.",
          "refs": [
            { "kind": "ability", "key": "Quinn-Q", "start": 5, "end": 21 }
          ],
          "pWrong": 0.11
        },
        {
          "id": "top:Quinn:general:1",
          "text": "Aim Blinding Assault carefully when minions are in front. A minion takes the hit and the champion behind it is missed.",
          "refs": [
            { "kind": "ability", "key": "Quinn-Q", "start": 4, "end": 20 }
          ],
          "pWrong": 0.16
        },
        {
          "id": "top:Quinn:general:2",
          "text": "Open a trade with Vault on the enemy champion. It marks them and slows them, and you leap back out of melee range.",
          "refs": [
            { "kind": "ability", "key": "Quinn-E", "start": 18, "end": 23 },
            { "kind": "keyword", "key": "slowed", "start": 65, "end": 70 }
          ],
          "pWrong": 0.25
        },
        {
          "id": "top:Quinn:general:3",
          "text": "Hit a marked enemy with a basic attack right after Vault. Harrier adds bonus damage and Heightened Senses speeds you up.",
          "refs": [
            { "kind": "ability", "key": "Quinn-E", "start": 51, "end": 56 },
            {
              "kind": "ability",
              "key": "Quinn-passive",
              "start": 58,
              "end": 65
            },
            { "kind": "ability", "key": "Quinn-W", "start": 88, "end": 105 }
          ],
          "pWrong": 0.11
        },
        {
          "id": "top:Quinn:general:4",
          "text": "Use Vault with your back to a wall to hop over thin terrain. This works when there is enough room to land on the other side.",
          "refs": [
            { "kind": "ability", "key": "Quinn-E", "start": 4, "end": 9 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "top:Quinn:general:5",
          "text": "Use Heightened Senses to reveal nearby bushes before a fight or a gank, so you know who is there.",
          "refs": [
            { "kind": "ability", "key": "Quinn-W", "start": 4, "end": 21 }
          ],
          "pWrong": 0.13
        },
        {
          "id": "top:Quinn:general:6",
          "text": "Use Behind Enemy Lines to cross the map fast, to farm side waves or to chase a weak enemy. Cast it out of sight, because the channel takes a moment.",
          "refs": [
            { "kind": "ability", "key": "Quinn-R", "start": 4, "end": 22 }
          ],
          "pWrong": 0.15
        },
        {
          "id": "top:Quinn:general:7",
          "text": "Avoid taking damage from champions while using Behind Enemy Lines, because it removes your speed bonus for a short time. Being stunned or silenced ends it.",
          "refs": [
            { "kind": "ability", "key": "Quinn-R", "start": 47, "end": 65 },
            { "kind": "keyword", "key": "silenced", "start": 138, "end": 146 }
          ],
          "pWrong": 0.1
        },
        {
          "id": "top:Quinn:general:8",
          "text": "Attack or cast Vault to finish Behind Enemy Lines with Skystrike. It deals area damage and marks enemies as you jump in.",
          "refs": [
            { "kind": "ability", "key": "Quinn-E", "start": 15, "end": 20 },
            { "kind": "ability", "key": "Quinn-R", "start": 31, "end": 49 }
          ],
          "pWrong": 0.13
        }
      ],
      "combos": [
        {
          "id": "top:Quinn:combo:0",
          "name": "Vault over thin walls",
          "category": "terrain",
          "sequence": [{ "kind": "ability", "key": "Quinn-E" }],
          "when": "Escaping or chasing when an enemy stands on the far side of a thin wall.",
          "whenRefs": [],
          "text": "Stand with your back to a thin wall and Vault the enemy. Quinn's backward leap can carry her over the wall if there is enough room to land on the other side.",
          "textRefs": [
            { "kind": "ability", "key": "Quinn-E", "start": 40, "end": 45 },
            { "kind": "champion", "key": "Quinn", "start": 57, "end": 62 }
          ]
        }
      ]
    }
  ],
  "matchups": [
    {
