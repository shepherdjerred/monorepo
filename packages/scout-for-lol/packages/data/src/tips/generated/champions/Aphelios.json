          "pWrong": 0.87
        },
        {
          "id": "adc:Aphelios:Ashe:1",
          "text": "Ashe has few escapes, so look for trades when Volley is on cooldown.",
          "refs": [
            { "kind": "champion", "key": "Ashe", "start": 0, "end": 4 },
            { "kind": "ability", "key": "Ashe-W", "start": 46, "end": 52 }
          ],
          "pWrong": 0.09
        },
        {
