      "tips": [
        {
          "id": "support:Zilean:general:0",
          "text": "Cast Time Bomb, then Rewind, then Time Bomb again on the same target. The second bomb sets off the first and stuns everyone nearby.",
          "refs": [
            { "kind": "ability", "key": "Zilean-Q", "start": 5, "end": 14 },
            { "kind": "ability", "key": "Zilean-W", "start": 21, "end": 27 },
            { "kind": "ability", "key": "Zilean-Q", "start": 34, "end": 43 }
          ],
          "pWrong": 0.16
        },
        {
          "id": "support:Zilean:general:1",
          "text": "Rewind only works while Time Bomb or Time Warp is on cooldown, so cast one of them first.",
          "refs": [
            { "kind": "ability", "key": "Zilean-W", "start": 0, "end": 6 },
            { "kind": "ability", "key": "Zilean-Q", "start": 24, "end": 33 },
            { "kind": "ability", "key": "Zilean-E", "start": 37, "end": 46 }
          ],
          "pWrong": 0.4
        },
        {
          "id": "support:Zilean:general:2",
          "text": "Put Time Warp on an enemy to leave them slowed, so your carry can catch them. Put it on a friend to help them chase or escape.",
          "refs": [
            { "kind": "ability", "key": "Zilean-E", "start": 4, "end": 13 },
            { "kind": "keyword", "key": "slowed", "start": 40, "end": 46 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "support:Zilean:general:3",
          "text": "Hold Chronoshift until the enemy commits to your carry. Cast too early and they switch targets.",
          "refs": [
            { "kind": "ability", "key": "Zilean-R", "start": 5, "end": 16 }
          ],
          "pWrong": 0.16
        },
        {
          "id": "support:Zilean:general:4",
          "text": "Use Time In A Bottle when it's ready and you are out of combat. It levels up an ally and gives you experience too.",
          "refs": [
            {
              "kind": "ability",
              "key": "Zilean-passive",
              "start": 4,
              "end": 20
            }
          ],
          "pWrong": 0.38
        },
        {
          "id": "support:Zilean:general:5",
          "text": "Time Bomb sticks to the first unit that comes near it, and enemy champions are picked before minions when it lands on several. Aim it at their champions.",
          "refs": [
            { "kind": "ability", "key": "Zilean-Q", "start": 0, "end": 9 }
          ],
          "pWrong": 0.48
        }
      ],
      "combos": [
