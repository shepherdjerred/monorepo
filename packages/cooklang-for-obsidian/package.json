{
  "name": "cooklang-for-obsidian",
  "version": "1.0.0",
  "description": "Obsidian plugin for viewing and editing Cooklang recipe files",
  "main": "main.js",
  "scripts": {
    "dev": "bun esbuild.config.mjs",
    "build": "bun esbuild.config.mjs production",
    "lint": "eslint src --cache",
    "test": "bun test",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "publish:plugin": "bun scripts/publish.ts",
    "test:ci": "bun ../../scripts/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../scripts/run-ci-test.ts"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@shepherdjerred/eslint-config": "workspace:*",
    "@types/node": "^26.1.1",
    "builtin-modules": "^5.1.0",
    "bun-types": "^1.3.14",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "obsidian": "latest",
    "typescript": "^6.0.3",
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "dependencies": {
    "chevrotain": "^13.0.0"
  }
}
