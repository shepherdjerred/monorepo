      "inputHash": "7f55dc962cbc313352f1043f7631ddaa55dda9c5ee21571079bde80705bf4bd3",
      "tips": [
        {
          "id": "adc:Zeri:general:0",
          "text": "Keep moving and keep firing Burst Fire; moving and casting it both charge your passive, so your next attack hits much harder when it is full.",
          "refs": [
            { "kind": "ability", "key": "Zeri-Q", "start": 28, "end": 38 }
          ],
          "pWrong": 0.79
        },
        {
          "id": "adc:Zeri:general:1",
          "text": "Aim Burst Fire at the enemy you want to hit. It stops at the first enemy it hits, so shoot past minions only after Spark Surge.",
          "refs": [
            { "kind": "ability", "key": "Zeri-Q", "start": 4, "end": 14 },
            { "kind": "ability", "key": "Zeri-E", "start": 115, "end": 126 }
          ],
          "pWrong": 0.87,
          "hidden": true
        },
        {
          "id": "adc:Zeri:general:2",
          "text": "Fire Ultrashock Laser at an enemy to get them slowed, then keep hitting them. Aimed at a wall, it turns into a laser that hits harder.",
          "refs": [
            { "kind": "ability", "key": "Zeri-W", "start": 5, "end": 21 },
            { "kind": "keyword", "key": "slowed", "start": 46, "end": 52 }
          ],
          "pWrong": 0.82
        },
        {
          "id": "adc:Zeri:general:3",
          "text": "Use Spark Surge to jump over walls to escape or reposition. Casting it next to terrain makes the dash go much farther.",
          "refs": [
            { "kind": "ability", "key": "Zeri-E", "start": 4, "end": 15 }
          ],
          "pWrong": 0.04
        },
        {
          "id": "adc:Zeri:general:4",
          "text": "Hit enemies with Burst Fire after Spark Surge to get it back sooner. Chain attacks on champions to dash again quickly.",
          "refs": [
            { "kind": "ability", "key": "Zeri-Q", "start": 17, "end": 27 },
            { "kind": "ability", "key": "Zeri-E", "start": 34, "end": 45 }
          ],
          "pWrong": 0.26
        },
        {
          "id": "adc:Zeri:general:5",
          "text": "Start a fight with Lightning Crash once you are close to the enemy champions. Hitting one gives you attack speed and move speed, so keep hitting them.",
          "refs": [
            { "kind": "ability", "key": "Zeri-R", "start": 19, "end": 34 }
          ],
          "pWrong": 0.14
        },
        {
          "id": "adc:Zeri:general:6",
          "text": "You can still fire Burst Fire while silenced, so do not back off just because you are silenced.",
          "refs": [
            { "kind": "ability", "key": "Zeri-Q", "start": 19, "end": 29 },
            { "kind": "keyword", "key": "silenced", "start": 36, "end": 44 },
            { "kind": "keyword", "key": "silenced", "start": 86, "end": 94 }
          ],
          "pWrong": 0.27
        }
      ],
      "combos": []
    }
  ],
