{
  "name": "scout-for-lol",
  "private": true,
  "scripts": {
    "build": "bun node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.scripts.json",
    "test": "bun test ./scripts",
    "test:coverage": "bun test --config ../../scripts/bunfig.coverage.toml --coverage scripts/create-minimal-png.test.ts scripts/dev-web.test.ts scripts/install-pkgs.test.ts",
    "lint": "eslint scripts",
    "typecheck": "bun node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.scripts.json",
    "dev:web": "op run --env-file=./dev-web.env.tpl -- bun scripts/dev-web.ts",
    "duplication-check": "bun run scripts/check-duplication.ts",
    "check:assets": "bun run scripts/check-asset-sizes.ts"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
    "@eslint/js": "^10.0.1",
    "@shepherdjerred/eslint-config": "workspace:*",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "^1.3.13",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@typescript/native": "npm:typescript@7.0.2",
    "bun-types": "latest",
    "eslint": "^10.3.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-import-resolver-typescript-bun": "^0.0.104",
    "eslint-plugin-astro": "^3.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-unicorn": "^72.0.0",
    "jiti": "^2.7.0",
    "jscpd": "^5.0.14",
    "knip": "^6.29.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "openai": "^7.0.0",
    "react": "19.2.8",
    "twisted": "^1.82.0",
    "zod": "^4.4.3"
  }
}
