      "tips": [
        {
          "id": "jungle:Fiddlesticks:general:0",
          "text": "Stay hidden in brush or stand still as a scarecrow, then open with Reap or Bountiful Harvest. Your first damaging ability will make them flee in fear.",
          "refs": [
            {
              "kind": "ability",
              "key": "Fiddlesticks-E",
              "start": 67,
              "end": 71
            },
            {
              "kind": "ability",
              "key": "Fiddlesticks-W",
              "start": 75,
              "end": 92
            }
          ],
          "pWrong": 0.22
        },
        {
          "id": "jungle:Fiddlesticks:general:1",
          "text": "Hold still without moving, attacking or casting to turn into a scarecrow. Do it near a lane or an objective, because it hides you from view.",
          "refs": [],
          "pWrong": 0.85
        },
        {
          "id": "jungle:Fiddlesticks:general:2",
          "text": "Use Terrify on a target who has already been feared. It then deals double damage, so save it as your follow-up.",
          "refs": [
            {
              "kind": "ability",
              "key": "Fiddlesticks-Q",
              "start": 4,
              "end": 11
            }
          ],
          "pWrong": 0.15
        },
        {
          "id": "jungle:Fiddlesticks:general:3",
          "text": "Use Reap to catch runners. They are slowed, and anyone hit in the center is also silenced and cannot cast spells.",
          "refs": [
            {
              "kind": "ability",
              "key": "Fiddlesticks-E",
              "start": 4,
              "end": 8
            },
            { "kind": "keyword", "key": "slowed", "start": 36, "end": 42 },
            { "kind": "keyword", "key": "silenced", "start": 81, "end": 89 }
          ],
          "pWrong": 0.14
        },
        {
          "id": "jungle:Fiddlesticks:general:4",
          "text": "Stay in the channel of Bountiful Harvest to the end. It deals extra damage on the last tick and refunds part of its cooldown.",
          "refs": [
            {
              "kind": "ability",
              "key": "Fiddlesticks-W",
              "start": 23,
              "end": 40
            }
          ],
          "pWrong": 0.02
        },
        {
          "id": "jungle:Fiddlesticks:general:5",
          "text": "Use Bountiful Harvest on jungle camps to heal while you clear. It also heals you in fights.",
          "refs": [
            {
              "kind": "ability",
              "key": "Fiddlesticks-W",
              "start": 4,
              "end": 21
            }
          ],
          "pWrong": 0.01
        },
        {
          "id": "jungle:Fiddlesticks:general:6",
          "text": "Start Crowstorm from out of sight, so your enemies can't see it coming. Cast Reap or Bountiful Harvest right after landing, and the fear still applies.",
          "refs": [
            {
              "kind": "ability",
              "key": "Fiddlesticks-R",
              "start": 6,
              "end": 15
            },
            {
              "kind": "ability",
              "key": "Fiddlesticks-E",
              "start": 77,
              "end": 81
            },
            {
              "kind": "ability",
              "key": "Fiddlesticks-W",
              "start": 85,
              "end": 102
            }
          ],
          "pWrong": 0.05
        },
        {
          "id": "jungle:Fiddlesticks:general:7",
          "text": "Don't use Flash or other movement during the Crowstorm channel. It stops you from casting, so only start it when you won't be interrupted.",
          "refs": [
            { "kind": "summoner-spell", "key": "4", "start": 10, "end": 15 },
            {
              "kind": "ability",
              "key": "Fiddlesticks-R",
              "start": 45,
              "end": 54
            }
          ],
          "pWrong": 0.97,
          "hidden": true
        }
      ],
