---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  sourceHref?: string;
  sourceName: string;
}

const { src, alt, caption, sourceHref, sourceName } = Astro.props;
const widths = [
  ...new Set([480, 960, src.width].filter((width) => width <= src.width)),
];
---

<figure class="guide-screenshot">
  <a
    class="image-link"
    href={src.src}
    target="_blank"
    rel="noreferrer"
    aria-label={`Open full-size screenshot: ${alt}`}
    style={{ "--screenshot-width": `${src.width}px` }}
  >
    <Image
      src={src}
      alt={alt}
      widths={widths}
      sizes="(min-width: 72rem) 50rem, (min-width: 50rem) 65vw, calc(100vw - 2rem)"
      format="webp"
      loading="lazy"
      decoding="async"
    />
  </a>
  <figcaption>
    {caption}{" "}
    <span class="credit">
      Source: {sourceHref ? <a href={sourceHref}>{sourceName}</a> : sourceName}.
    </span>
    <span class="enlarge">Click the image to enlarge.</span>
  </figcaption>
</figure>

<style>
  .guide-screenshot {
    margin: 1.5rem 0 2rem;
  }
  .image-link {
    display: block;
    width: min(100%, var(--screenshot-width));
    max-width: 100%;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    overflow: hidden;
  }
  .image-link:focus-visible {
    outline: 3px solid var(--sl-color-accent);
    outline-offset: 4px;
  }
  img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    margin: 0;
  }
  figcaption {
    margin-top: 0.65rem;
    color: var(--sl-color-gray-2);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .credit,
  .enlarge {
    display: block;
  }
</style>
