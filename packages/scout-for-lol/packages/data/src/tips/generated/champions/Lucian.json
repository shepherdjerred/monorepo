      "tips": [
        {
          "id": "adc:Lucian:general:0",
          "text": "Cast an ability before each attack so Lightslinger fires its double-shot. Weave attacks between abilities instead of only auto-attacking.",
          "refs": [
            {
              "kind": "ability",
              "key": "Lucian-passive",
              "start": 38,
              "end": 50
            }
          ],
          "pWrong": 0.5
        },
        {
          "id": "adc:Lucian:general:1",
          "text": "Dash with Relentless Pursuit into Piercing Light for your burst. Use it to reposition, not just to escape.",
          "refs": [
            { "kind": "ability", "key": "Lucian-E", "start": 10, "end": 28 },
            { "kind": "ability", "key": "Lucian-Q", "start": 34, "end": 48 }
          ],
          "pWrong": 0.11
        },
        {
          "id": "adc:Lucian:general:2",
          "text": "Hit enemy champions with Lightslinger shots to cut the cooldown of Relentless Pursuit. Champions cut it more than minions do.",
          "refs": [
            {
              "kind": "ability",
              "key": "Lucian-passive",
              "start": 25,
              "end": 37
            },
            { "kind": "ability", "key": "Lucian-E", "start": 67, "end": 85 }
          ],
          "pWrong": 0.1
        },
        {
          "id": "adc:Lucian:general:3",
          "text": "Piercing Light goes through units. Aim it at a minion so the line also reaches the enemy standing behind it.",
          "refs": [
            { "kind": "ability", "key": "Lucian-Q", "start": 0, "end": 14 }
          ],
          "pWrong": 0.5
        },
        {
          "id": "adc:Lucian:general:4",
          "text": "Aim Ardent Blaze so the spokes of its star hit an enemy champion. Hitting one marks them and gives you bonus Move Speed when they take damage.",
          "refs": [
            { "kind": "ability", "key": "Lucian-W", "start": 4, "end": 16 }
          ],
          "pWrong": 0.14
        },
        {
          "id": "adc:Lucian:general:5",
          "text": "Start The Culling once the enemy has nowhere to dodge, such as after they are rooted or stunned. You can't change its angle once it starts.",
          "refs": [
            { "kind": "ability", "key": "Lucian-R", "start": 6, "end": 17 },
            { "kind": "keyword", "key": "rooted", "start": 78, "end": 84 }
          ],
          "pWrong": 0.1
        },
        {
          "id": "adc:Lucian:general:6",
          "text": "Use Relentless Pursuit while The Culling is firing to dodge or reposition. Piercing Light and Ardent Blaze are disabled during it.",
          "refs": [
            { "kind": "ability", "key": "Lucian-E", "start": 4, "end": 22 },
            { "kind": "ability", "key": "Lucian-R", "start": 29, "end": 40 },
            { "kind": "ability", "key": "Lucian-Q", "start": 75, "end": 89 },
            { "kind": "ability", "key": "Lucian-W", "start": 94, "end": 106 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "adc:Lucian:general:7",
          "text": "Trade in short, fast bursts and then back off. Lucian has strong burst but little sustained damage.",
          "refs": [
            { "kind": "champion", "key": "Lucian", "start": 47, "end": 53 }
          ],
          "pWrong": 0.04
        }
      ],
      "combos": []
    }
  ],
