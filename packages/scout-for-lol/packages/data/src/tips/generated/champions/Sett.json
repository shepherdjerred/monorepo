              "start": 12,
              "end": 23
            },
            {
              "kind": "ability",
              "key": "Mordekaiser-passive",
              "start": 37,
              "end": 50
            }
          ],
          "pWrong": 0.43
        },
        {
          "id": "top:Sett:Mordekaiser:1",
          "text": "Use Facebreaker to slow Mordekaiser as you close in on him. If you hit enemies on both sides, they are stunned.",
          "refs": [
            { "kind": "ability", "key": "Sett-E", "start": 4, "end": 15 },
            {
              "kind": "champion",
              "key": "Mordekaiser",
              "start": 24,
              "end": 35
