  "general": [
    {
      "lane": "support",
      "inputHash": "58d0637ab739cd926198104cf25ab9c9d1387407855b0ef7db3836fac8884689",
      "tips": [
        {
          "id": "support:Alistar:general:0",
          "text": "Start your engage with Headbutt on a fragile enemy, then use Pulverize as you land to knock up everyone around them.",
          "refs": [
            { "kind": "ability", "key": "Alistar-W", "start": 23, "end": 31 },
            { "kind": "ability", "key": "Alistar-Q", "start": 61, "end": 70 },
            { "kind": "keyword", "key": "knocked-up", "start": 86, "end": 94 }
          ],
          "pWrong": 0.72
        },
        {
          "id": "support:Alistar:general:1",
          "text": "Aim Headbutt so the enemy is knocked back toward your allies and their damage.",
          "refs": [
            { "kind": "ability", "key": "Alistar-W", "start": 4, "end": 12 }
          ],
          "pWrong": 0.19
        },
        {
          "id": "support:Alistar:general:2",
          "text": "Use Pulverize when enemies walk up to your lane partner or the minions. It hits all around you, so you don't need to aim it.",
          "refs": [
            { "kind": "ability", "key": "Alistar-Q", "start": 4, "end": 13 }
          ],
          "pWrong": 0.21
        },
        {
          "id": "support:Alistar:general:3",
          "text": "Turn on Trample when you trade, and keep hitting champions with it. Once it is fully stacked, your next attack on a champion stuns.",
          "refs": [
            { "kind": "ability", "key": "Alistar-E", "start": 8, "end": 15 }
          ],
          "pWrong": 0.06
        },
        {
          "id": "support:Alistar:general:4",
          "text": "Stun or displace enemy champions and stand near dying minions to charge Triumphant Roar. It heals you and your nearby allies.",
          "refs": [
            {
              "kind": "ability",
              "key": "Alistar-passive",
              "start": 72,
              "end": 87
            }
          ],
          "pWrong": 0.08
        },
        {
          "id": "support:Alistar:general:5",
          "text": "Press Unbreakable Will when you are caught by crowd control or focused. It cleanses you and cuts the damage you take, so you can keep fighting.",
          "refs": [
            { "kind": "ability", "key": "Alistar-R", "start": 6, "end": 22 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "support:Alistar:general:6",
          "text": "Don't waste Headbutt and Pulverize when you can't follow up. Your lane partner needs to be close to punish the enemy.",
          "refs": [
            { "kind": "ability", "key": "Alistar-W", "start": 12, "end": 20 },
            { "kind": "ability", "key": "Alistar-Q", "start": 25, "end": 34 }
          ],
          "pWrong": 0.03
        }
      ],
      "combos": [
        {
          "id": "support:Alistar:combo:0",
          "name": "Headbutt-Pulverize combo",
          "category": "combo",
          "sequence": [
            { "kind": "ability", "key": "Alistar-W" },
            { "kind": "ability", "key": "Alistar-Q" }
          ],
          "when": "When you want to engage and lock down an enemy near your allies or under your turret.",
          "whenRefs": [],
          "text": "Headbutt into the target and cast Pulverize right as you land. Pulverize knocks them up and overrides the knockback, so they stay beside you and your team.",
          "textRefs": [
            { "kind": "ability", "key": "Alistar-W", "start": 0, "end": 8 },
            { "kind": "ability", "key": "Alistar-Q", "start": 34, "end": 43 },
            { "kind": "ability", "key": "Alistar-Q", "start": 63, "end": 72 }
          ]
        },
        {
          "id": "support:Alistar:combo:1",
          "name": "Buffered Pulverize",
          "category": "trick",
          "sequence": [
            { "kind": "ability", "key": "Alistar-W" },
            { "kind": "ability", "key": "Alistar-Q" }
          ],
          "when": "When you want the Pulverize to come out immediately after the Headbutt dash ends.",
          "whenRefs": [
            { "kind": "ability", "key": "Alistar-Q", "start": 18, "end": 27 },
            { "kind": "ability", "key": "Alistar-W", "start": 62, "end": 70 }
          ],
          "text": "Press Pulverize while Headbutt is still dashing. It casts with a shorter cast time when the dash ends, and it shortens the knockback so the target stays close.",
          "textRefs": [
            { "kind": "ability", "key": "Alistar-Q", "start": 6, "end": 15 },
            { "kind": "ability", "key": "Alistar-W", "start": 22, "end": 30 }
          ]
        },
        {
          "id": "support:Alistar:combo:2",
          "name": "Flash Headbutt-Pulverize",
          "category": "trick",
          "sequence": [
            { "kind": "summoner-spell", "key": "2202" },
            { "kind": "ability", "key": "Alistar-W" },
            { "kind": "ability", "key": "Alistar-Q" }
          ],
          "when": "When you want to catch an enemy off guard and push them into your allies.",
          "whenRefs": [],
          "text": "Flash to change your angle, then Headbutt and Pulverize. The surprise gap close and the new angle knock the target back into your team.",
          "textRefs": [
            { "kind": "summoner-spell", "key": "4", "start": 0, "end": 5 },
            { "kind": "ability", "key": "Alistar-W", "start": 33, "end": 41 },
            { "kind": "ability", "key": "Alistar-Q", "start": 46, "end": 55 }
          ]
        }
      ]
    }
  ],
