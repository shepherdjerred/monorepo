  "general": [
    {
      "lane": "top",
      "inputHash": "76be69fa9e1947ccea412eb49e582d32172d8d9c52ce93816d52f6c7cb993339",
      "tips": [
        {
          "id": "top:Gnar:general:0",
          "text": "Throw Boomerang Throw at long range to poke, then step toward the returning boomerang to catch it and get the ability back sooner.",
          "refs": [],
          "pWrong": 0.02
        },
        {
          "id": "top:Gnar:general:1",
          "text": "Line up Boomerang Throw so it hits more than one enemy; targets hit on the way back take less damage, and each enemy is hit only once per pass.",
          "refs": [],
          "pWrong": 0.03
        },
        {
          "id": "top:Gnar:general:2",
          "text": "Hit the same enemy three times with attacks or abilities to trigger Hyper for bonus damage and a burst of speed. It works best against high-health targets.",
          "refs": [],
          "pWrong": 0.33
        },
        {
          "id": "top:Gnar:general:3",
          "text": "Use Hop to jump onto a minion or enemy and bounce further. That makes it an escape, or a way to slow an enemy you want to chase.",
          "refs": [
            { "kind": "keyword", "key": "slowed", "start": 96, "end": 100 }
          ],
          "pWrong": 0.09
        },
        {
          "id": "top:Gnar:general:4",
          "text": "Watch your Rage bar. Fighting builds it, and at full Rage your next ability turns you into Mega Gnar, so choose a fight where you want that to happen.",
          "refs": [
            { "kind": "champion", "key": "Gnar", "start": 96, "end": 100 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "top:Gnar:general:5",
          "text": "After Mega Gnar ends you are tired and can't gain Rage for a while. Play safe until it passes.",
          "refs": [
            { "kind": "champion", "key": "Gnar", "start": 11, "end": 15 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "top:Gnar:general:6",
          "text": "As Mega Gnar, use Wallop on enemies who are close to you. It stuns them and deals heavy damage.",
          "refs": [
            { "kind": "champion", "key": "Gnar", "start": 8, "end": 12 }
          ],
          "pWrong": 0.44
        },
        {
          "id": "top:Gnar:general:7",
          "text": "Fight with a wall behind your target when you cast GNAR!. Enemies thrown into the wall are stunned and take extra damage.",
          "refs": [
            { "kind": "ability", "key": "Gnar-R", "start": 51, "end": 56 }
          ],
          "pWrong": 0.03
        },
        {
          "id": "top:Gnar:general:8",
          "text": "As Mega Gnar, walk over your Boulder Toss boulder after it lands to pick it up and get most of the cooldown back.",
          "refs": [
            { "kind": "champion", "key": "Gnar", "start": 8, "end": 12 }
          ],
          "pWrong": 0.03
        }
      ],
      "combos": [
        {
          "id": "top:Gnar:combo:0",
          "name": "Hop bounce into Boomerang",
          "category": "trick",
          "sequence": [
            { "kind": "ability", "key": "Gnar-E" },
            { "kind": "ability", "key": "Gnar-Q" }
          ],
          "when": "When engaging a target in mini form and you want to hit the boomerang during the dash.",
          "whenRefs": [],
          "text": "Hop lets you cast Boomerang Throw in mid-air. Bounce off the enemy and throw the boomerang at once so the slow lands as you close in.",
          "textRefs": []
        }
      ]
    }
  ],
  "matchups": [
