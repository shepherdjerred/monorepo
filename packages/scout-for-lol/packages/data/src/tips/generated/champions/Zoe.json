          "whenRefs": [],
          "text": "Cast Portal Jump, then kick the bubble right as you blink back. The bubble still flies to the spot you aimed at, and you land safely.",
          "textRefs": [
            { "kind": "ability", "key": "Zoe-R", "start": 5, "end": 16 }
          ]
        },
        {
          "id": "middle:Zoe:combo:3",
          "name": "Sleep then Q break",
          "category": "combo",
          "sequence": [
