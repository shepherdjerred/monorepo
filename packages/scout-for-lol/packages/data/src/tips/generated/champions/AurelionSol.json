      "tips": [
        {
          "id": "middle:AurelionSol:general:0",
          "text": "Hold Breath of Light on the same enemy champion for a full second to trigger its bonus burst, and keep it on them to gather Stardust.",
          "refs": [
            { "kind": "ability", "key": "AurelionSol-Q", "start": 5, "end": 20 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "middle:AurelionSol:general:1",
          "text": "Drop Singularity on a wave or a trapped enemy; it drags them toward the center, and low-health enemies there die instantly.",
          "refs": [
            { "kind": "ability", "key": "AurelionSol-E", "start": 5, "end": 16 }
          ],
          "pWrong": 0.11
        },
        {
          "id": "middle:AurelionSol:general:2",
          "text": "Use Astral Flight to reposition or chase, and keep channeling Breath of Light while you fly, since it has no cooldown then.",
          "refs": [
            {
              "kind": "ability",
              "key": "AurelionSol-W",
              "start": 4,
              "end": 17
            },
            {
              "kind": "ability",
              "key": "AurelionSol-Q",
              "start": 62,
              "end": 77
            }
          ],
          "pWrong": 0.24
        },
        {
          "id": "middle:AurelionSol:general:3",
          "text": "Get a takedown soon after hurting a champion and Astral Flight comes back almost at once, so chain fights.",
          "refs": [
            {
              "kind": "ability",
              "key": "AurelionSol-W",
              "start": 49,
              "end": 62
            }
          ],
          "pWrong": 0.12
        },
        {
          "id": "middle:AurelionSol:general:4",
          "text": "Falling Star lands after a delay, so aim it where enemies are heading or when they are stuck, such as inside Singularity.",
          "refs": [
            {
              "kind": "ability",
              "key": "AurelionSol-E",
              "start": 109,
              "end": 120
            }
          ],
          "pWrong": 0.13
        },
        {
          "id": "middle:AurelionSol:general:5",
          "text": "When your Stardust is full, Falling Star becomes The Skies Descend, which knocks up and slows. Save it for a team fight.",
          "refs": [
            { "kind": "keyword", "key": "knocked-up", "start": 74, "end": 83 },
            { "kind": "keyword", "key": "slowed", "start": 88, "end": 93 }
          ],
          "pWrong": 0.26
        },
        {
          "id": "middle:AurelionSol:general:6",
          "text": "Hit champions with your damaging abilities every chance you get. Stardust is permanent and makes all your abilities stronger.",
          "refs": [],
          "pWrong": 0.12
        },
        {
          "id": "middle:AurelionSol:general:7",
          "text": "Don't start Astral Flight when you are stunned or rooted; you won't fly, and any hard crowd control during the flight knocks you down.",
          "refs": [
            {
              "kind": "ability",
              "key": "AurelionSol-W",
              "start": 12,
              "end": 25
            },
            { "kind": "keyword", "key": "rooted", "start": 50, "end": 56 }
          ],
          "pWrong": 0.45
        }
      ],
      "combos": [
        {
          "id": "middle:AurelionSol:combo:0",
          "name": "Astral Flight beam chase",
          "category": "combo",
