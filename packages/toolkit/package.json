{
  "name": "@shepherdjerred/toolkit",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "exports": {
    "./lib/*": "./src/lib/*"
  },
  "imports": {
    "#architecture": "./architecture.config.ts",
    "#lib/*": "./src/lib/*",
    "#commands/*": "./src/commands/*"
  },
  "bin": {
    "toolkit": "./src/index.ts"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --compile --external ffmpeg-static --outfile=dist/toolkit",
    "test": "bun run test:unit",
    "test:coverage": "bun --no-install --bun vitest --config ../../vitest.config.ts run --coverage.reporter=text --coverage.reporter=lcovonly --coverage.reportsDirectory=coverage --coverage scripts/install.test.ts --coverage.thresholds.lines=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "test:unit": "bun --no-install --bun vitest --config ../../vitest.config.ts run test/lib test/bugsink test/s3 test/deployed test/screenshot test/history scripts",
    "install:local": "bun scripts/install.ts",
    "test:integration": "bun --no-install --bun vitest --config ../../vitest.config.ts run test-integration",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "lint": "eslint . && check-architecture",
    "test:ci": "bun ../../scripts/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../scripts/run-ci-test.ts"
  },
  "devDependencies": {
    "@shepherdjerred/architecture": "workspace:*",
    "@shepherdjerred/eslint-config": "workspace:*",
    "@types/bun": "1.4.0",
    "eslint": "^10.3.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "vitest": "4.1.10",
    "@vitest/coverage-istanbul": "4.1.10"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1001.0",
    "@shepherdjerred/code-review": "workspace:*",
    "asciinema-player": "^3.15.1",
    "debug": "^4.4.3",
    "discord.js": "^14",
    "discord.js-selfbot-v13": "^3.7",
    "zod": "^4.4.3"
  }
}
