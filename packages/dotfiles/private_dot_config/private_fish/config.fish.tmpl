# Add common paths (OS-specific to avoid testing nonexistent dirs)
# libpq is keg-only because it conflicts with a full postgresql install, so brew
# never links psql/pg_dump/pg_isready/pg_config into /opt/homebrew/bin. pgcli
# pulls libpq in as a dependency, but that does not link the binaries.
{{ if eq .chezmoi.os "darwin" -}}
fish_add_path /opt/homebrew/bin ~/bin ~/.local/bin /opt/homebrew/opt/libpq/bin
{{ else -}}
fish_add_path /home/linuxbrew/.linuxbrew/bin ~/bin ~/.local/bin
{{ end -}}

# Ghostty shell integration
if set -q GHOSTTY_RESOURCES_DIR
    source "$GHOSTTY_RESOURCES_DIR"/shell-integration/fish/vendor_conf.d/ghostty-shell-integration.fish
end

# Disable vendor conf.d auto-activation (expensive full hook mode ~23ms)
# and use only --shims mode (~2ms, just adds PATH entry)
set -gx MISE_FISH_AUTO_ACTIVATE 0
mise activate fish --shims | source
{{- if eq .profile "agent-host" }}
# Agent hosts route credentialed CLIs (talosctl, argocd, gcx, woodpecker-cli,
# temporal, posthog-cli) through toolkit shims, which resolve credentials at
# call time. They must precede mise shims and Homebrew. mise runs in --shims
# mode, which prepends once and installs no hook-env prompt handler, so moving
# the shim directory to the front here survives the session.
fish_add_path --path --move ~/.local/share/toolkit/shims
{{- end }}

# Coding-agent wrappers (claude, codex, agy, cursor-agent, grok, kimi, muse)
# strip provider API keys and service tokens, bypass approvals and sandboxes,
# and set the agent git identity. They are real executables, so Herdr, Brim and
# scripts get the same behavior as typing the command; see agent-exec there.
fish_add_path --path --move ~/.local/share/agent-bin

# Use abbreviations so scripts use real commands, but your typing expands
abbr vim nvim
abbr ls eza
abbr grep rg
abbr cat bat
abbr htop "sudo btop"
abbr top "sudo btop"
abbr btop "sudo btop"
abbr less ov
abbr ping gping
abbr finder "open -a Finder"
abbr gs git-spice

# Set shell to fish
{{ if eq .chezmoi.os "darwin" -}}
set -gx SHELL /opt/homebrew/bin/fish
{{ else -}}
set -gx SHELL /home/linuxbrew/.linuxbrew/bin/fish
{{ end -}}
set -gx EDITOR nvim
set -gx LANG en_US.UTF-8
set -gx RIPGREP_CONFIG_PATH ~/.config/ripgrep/ripgreprc

# PinchTab: point the CLI at the same config the launchd daemon uses. The
# daemon's plist pins PINCHTAB_CONFIG to this path; without it the CLI falls
# back to ~/.pinchtab/config.json and the tokens diverge → 401 bad_token.
{{ if eq .chezmoi.os "darwin" -}}
set -gx PINCHTAB_CONFIG "$HOME/Library/Application Support/pinchtab/config.json"
set -gx TESSDATA_PREFIX /opt/homebrew/share/tessdata
{{ end -}}

set -gx CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS "1"

# CLI tool credentials (via 1Password) - only set if op CLI is available.
# Brokered secrets (Grafana/PostHog/ArgoCD/Discord/Bugsink/Cloudflare
# tokens) resolve via `toolkit` at call time and are scrubbed from agent
# environments (see ~/.local/share/agent-bin/agent-exec); nothing is exported
# for them here. Only the workstation renders secrets into files: agent hosts
# take the URL-only branch below and resolve credentials at call time through
# toolkit or scripts/onepassword/with-service-account.sh, and assistant hosts
# carry no homelab or provider credentials at all.
{{ $renderSecrets := and (lookPath "op") (eq .profile "workstation") -}}
{{ if $renderSecrets -}}
set -gx GRAFANA_URL 'https://grafana.tailnet-1a49.ts.net'
set -gx BUGSINK_URL 'https://bugsink.sjer.red'
set -gx HASS_TOKEN '{{ onepasswordRead "op://yx6je6mgj2oiss6z5bm42h3cxy/y4c2gno3yrxcdcudaofbirmi4u/password" }}'
set -gx HASS_BASE_URL 'https://homeassistant.sjer.red'
# Dedicated local agent identities for toolkit discord. The user identity can
# invoke other bots and join voice; the bot identity provides reliable message
# content and voice-state access.
# posthog-cli reads POSTHOG_CLI_*, not the POSTHOG_API_KEY label the value is
# stored under. The dedicated item also supplies the encrypted state passphrase.
set -gx POSTHOG_CLI_PROJECT_ID '549883'
set -gx POSTHOG_TOFU_STATE_PASSPHRASE '{{ onepasswordRead "op://v64ocnykdqju4ui6j6pua56xw4/yh3xvqemmr4ic2up5zluo2rkcq/msdtltp4yy72ntrkanowlq7k24" }}'
# Deliberately NOT exported here. src/tofu/cloudflare authenticates from
# CLOUDFLARE_API_TOKEN ambiently, so a global export would let a bare
# `tofu apply` with no `op run` authenticate and apply instead of failing
# closed. `toolkit cf` resolves CF_API_TOKEN via the credential broker for
# its own child process only.
# Loki and Prometheus are tailnet-only with no auth (loki runs auth_enabled:
# false), so logcli and promtool need an address but no credential.
set -gx LOKI_ADDR 'https://loki.tailnet-1a49.ts.net'
set -gx PROMETHEUS_URL 'https://prometheus.tailnet-1a49.ts.net'
{{ end -}}
if test -f ~/.config/turbo-cache/env.fish
    source ~/.config/turbo-cache/env.fish
end
{{ if not $renderSecrets -}}
# Secrets not rendered: either 1Password CLI (op) is unavailable (install it
# and run 'chezmoi apply') or this is an agent or assistant host
set -gx GRAFANA_URL 'https://grafana.tailnet-1a49.ts.net'
set -gx BUGSINK_URL 'https://bugsink.sjer.red'
set -gx HASS_BASE_URL 'https://homeassistant.sjer.red'
set -gx LOKI_ADDR 'https://loki.tailnet-1a49.ts.net'
set -gx PROMETHEUS_URL 'https://prometheus.tailnet-1a49.ts.net'
set -gx POSTHOG_CLI_PROJECT_ID '549883'
{{ end -}}
if status is-interactive
  {{/* Plaintext provider keys in a file agents can read would defeat the
       agent-bin wrappers that strip them, so agent hosts skip them too. */ -}}
  {{ if $renderSecrets -}}
  set -gx (string join "" OPENAI _API_KEY) '{{ onepasswordRead "op://63lcesgoblzbpkdr4koye66rei/v2kd6fap7kzaaoqcbqqgz64y7m/credential" }}'
  set -gx (string join "" ANTHROPIC _API_KEY) '{{ onepasswordRead "op://63lcesgoblzbpkdr4koye66rei/sksz6g6ds4ypujxkoqfvm26jsu/credential" }}'
  {{ end -}}
  # Provider API keys stay available to ordinary tools; the coding-agent
  # wrappers in ~/.local/share/agent-bin remove them so agents always use their
  # subscription logins.
  fish_vi_key_bindings

  starship init fish | source
  atuin init fish | source

  set -q CARAPACE_BRIDGES; or set -Ux CARAPACE_BRIDGES 'zsh,fish,bash,inshellisense'
  mkdir -p ~/.config/fish/completions
  # Run the following block only once a day
  if test (find ~/.config/fish/completions -name '*.fish' -mtime -1 | wc -l) -eq 0
      echo "running carapace..."
      carapace --list | awk '{print $1}' | xargs -I{} touch ~/.config/fish/completions/{}.fish # disable auto-loaded completions (#185)
  end
  # Lazy-load carapace on first tab completion
  function _carapace_lazy --on-event fish_complete
      functions -e _carapace_lazy  # remove this bootstrap function
      carapace _carapace | source
  end
end

# Added by OrbStack: command-line tools and integration
# Source the integration only when OrbStack is installed on this machine.
if test -f ~/.orbstack/shell/init2.fish
  source ~/.orbstack/shell/init2.fish
end
