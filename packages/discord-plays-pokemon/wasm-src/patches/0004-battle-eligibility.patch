+static bool8 WasmCanBattlerSwitch(u8 battler)
+{
+    u8 other;
+
+    if ((gBattleMons[battler].status2 & (STATUS2_WRAPPED | STATUS2_ESCAPE_PREVENTION))
+     || (gStatuses3[battler] & STATUS3_ROOTED)
+     || (gBattleTypeFlags & BATTLE_TYPE_ARENA))
+        return FALSE;
+
+    for (other = 0; other < gBattlersCount; other++)
+    {
+        if (GetBattlerSide(other) == GetBattlerSide(battler)
+         || (gAbsentBattlerFlags & (1u << other))
+         || gBattleMons[other].hp == 0)
+            continue;
+        if (gBattleMons[other].ability == ABILITY_SHADOW_TAG)
+            return FALSE;
+        if (gBattleMons[other].ability == ABILITY_ARENA_TRAP
+         && !IS_BATTLER_OF_TYPE(battler, TYPE_FLYING)
+         && gBattleMons[battler].ability != ABILITY_LEVITATE)
+            return FALSE;
+        if (gBattleMons[other].ability == ABILITY_MAGNET_PULL
+         && IS_BATTLER_OF_TYPE(battler, TYPE_STEEL))
+            return FALSE;
+    }
+    return TRUE;
+}
+
+static s8 WasmFindPlayerBattlerForPartyIndex(u8 partyIndex)
+{
+    u8 battler;
+
+    for (battler = 0; battler < gBattlersCount; battler++)
+    {
+        if (GetBattlerSide(battler) == B_SIDE_PLAYER
+         && (gAbsentBattlerFlags & (1u << battler)) == 0
+         && gBattlerPartyIndexes[battler] == partyIndex)
+            return battler;
+    }
+    return -1;
+}
+
+u32 WasmCanUseBattleItemOnPartyMon(u32 item, u32 partyIndex)
+{
+    const u8 *effect;
+    struct Pokemon *mon;
+    u32 hp;
+    u32 status;
+    s8 battler;
+
+    if (!gMain.inBattle
+     || partyIndex >= gPlayerPartyCount
+     || !ITEM_HAS_EFFECT(item))
+        return FALSE;
+    effect = item == ITEM_ENIGMA_BERRY
+        ? gSaveBlock1Ptr->enigmaBerry.itemEffect
+        : gItemEffectTable[item - ITEM_POTION];
+    if (effect == NULL)
+        return FALSE;
+
+    mon = &gPlayerParty[partyIndex];
+    if (GetMonData(mon, MON_DATA_SPECIES) == SPECIES_NONE
+     || GetMonData(mon, MON_DATA_IS_EGG))
+        return FALSE;
+    hp = GetMonData(mon, MON_DATA_HP);
+    if (effect[4] & ITEM4_REVIVE)
+        return hp == 0;
+    if (hp == 0)
+        return FALSE;
+    if ((effect[4] & ITEM4_HEAL_HP)
+     && hp < GetMonData(mon, MON_DATA_MAX_HP))
+        return TRUE;
+
+    status = GetMonData(mon, MON_DATA_STATUS);
+    if (((effect[3] & ITEM3_SLEEP) && (status & STATUS1_SLEEP))
+     || ((effect[3] & ITEM3_POISON) && (status & (STATUS1_PSN_ANY | STATUS1_TOXIC_COUNTER)))
+     || ((effect[3] & ITEM3_BURN) && (status & STATUS1_BURN))
+     || ((effect[3] & ITEM3_FREEZE) && (status & STATUS1_FREEZE))
+     || ((effect[3] & ITEM3_PARALYSIS) && (status & STATUS1_PARALYSIS)))
+        return TRUE;
+
+    battler = WasmFindPlayerBattlerForPartyIndex(partyIndex);
+    if (battler >= 0
+     && (((effect[3] & ITEM3_CONFUSION) && (gBattleMons[battler].status2 & STATUS2_CONFUSION))
+      || ((effect[0] & ITEM0_INFATUATION) && (gBattleMons[battler].status2 & STATUS2_INFATUATION))))
+        return TRUE;
+    return FALSE;
+}
+
+u32 WasmCanUseBattleItemOnBattler(u32 item, u32 battler)
+{
+    const u8 *effect;
+
+    if (!gMain.inBattle
+     || battler >= gBattlersCount
+     || GetBattlerSide(battler) != B_SIDE_PLAYER
+     || (gAbsentBattlerFlags & (1u << battler))
+     || gBattleMons[battler].hp == 0
+     || !ITEM_HAS_EFFECT(item))
+        return FALSE;
+    effect = item == ITEM_ENIGMA_BERRY
+        ? gSaveBlock1Ptr->enigmaBerry.itemEffect
+        : gItemEffectTable[item - ITEM_POTION];
+    if (effect == NULL)
+        return FALSE;
+
+    if (((effect[0] & ITEM0_DIRE_HIT)
+         && !(gBattleMons[battler].status2 & STATUS2_FOCUS_ENERGY))
+     || ((effect[0] & ITEM0_X_ATTACK)
+         && gBattleMons[battler].statStages[STAT_ATK] < MAX_STAT_STAGE)
+     || ((effect[1] & ITEM1_X_DEFEND)
+         && gBattleMons[battler].statStages[STAT_DEF] < MAX_STAT_STAGE)
+     || ((effect[1] & ITEM1_X_SPEED)
+         && gBattleMons[battler].statStages[STAT_SPEED] < MAX_STAT_STAGE)
+     || ((effect[2] & ITEM2_X_ACCURACY)
+         && gBattleMons[battler].statStages[STAT_ACC] < MAX_STAT_STAGE)
+     || ((effect[2] & ITEM2_X_SPATK)
+         && gBattleMons[battler].statStages[STAT_SPATK] < MAX_STAT_STAGE)
+     || ((effect[3] & ITEM3_GUARD_SPEC)
+         && gSideTimers[GetBattlerSide(battler)].mistTimer == 0))
+        return TRUE;
+    return FALSE;
+}
+
+u32 WasmCanRunFromBattle(u32 battler)
+{
+    u8 holdEffect;
+    u8 other;
+
+    if (!gMain.inBattle
+     || battler >= gBattlersCount
+     || GetBattlerSide(battler) != B_SIDE_PLAYER
+     || (gAbsentBattlerFlags & (1u << battler))
+     || gBattleMons[battler].hp == 0)
+        return FALSE;
+
+    holdEffect = gBattleMons[battler].item == ITEM_ENIGMA_BERRY
+        ? gEnigmaBerries[battler].holdEffect
+        : GetItemHoldEffect(gBattleMons[battler].item);
+    if (holdEffect == HOLD_EFFECT_CAN_ALWAYS_RUN
+     || gBattleMons[battler].ability == ABILITY_RUN_AWAY)
+        return TRUE;
+
+    for (other = 0; other < gBattlersCount; other++)
+    {
+        if (GetBattlerSide(other) == GetBattlerSide(battler)
+         || (gAbsentBattlerFlags & (1u << other))
+         || gBattleMons[other].hp == 0)
+            continue;
+        if (gBattleMons[other].ability == ABILITY_SHADOW_TAG)
+            return FALSE;
+        if (gBattleMons[other].ability == ABILITY_ARENA_TRAP
+         && !IS_BATTLER_OF_TYPE(battler, TYPE_FLYING)
+         && gBattleMons[battler].ability != ABILITY_LEVITATE)
+            return FALSE;
+        if (gBattleMons[other].ability == ABILITY_MAGNET_PULL
+         && IS_BATTLER_OF_TYPE(battler, TYPE_STEEL))
+            return FALSE;
+    }
+    if ((gBattleMons[battler].status2
+         & (STATUS2_ESCAPE_PREVENTION | STATUS2_WRAPPED))
+     || (gStatuses3[battler] & STATUS3_ROOTED)
+     || (gBattleTypeFlags & BATTLE_TYPE_FIRST_BATTLE))
+        return FALSE;
+    return TRUE;
+}
