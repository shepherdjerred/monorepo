  "general": [
    {
      "lane": "support",
      "inputHash": "d360497dab8a017f310eae15fc1c1e262cd52388bd52e04ea855fcb785c55102",
      "tips": [
        {
          "id": "support:Blitzcrank:general:0",
          "text": "Aim Rocket Grab down a lane with no minions in the way; it pulls the first enemy it hits, so a minion in front will take the grab instead.",
          "refs": [
            { "kind": "ability", "key": "Blitzcrank-Q", "start": 4, "end": 15 }
          ],
          "pWrong": 0
        },
        {
          "id": "support:Blitzcrank:general:1",
          "text": "After a Rocket Grab lands, hit them with Power Fist right away; the knock up keeps them in place for your team to follow up.",
          "refs": [
            { "kind": "ability", "key": "Blitzcrank-Q", "start": 8, "end": 19 },
            {
              "kind": "ability",
              "key": "Blitzcrank-E",
              "start": 41,
              "end": 51
            },
            { "kind": "keyword", "key": "knocked-up", "start": 68, "end": 76 }
          ],
          "pWrong": 0.04
        },
        {
          "id": "support:Blitzcrank:general:2",
          "text": "Pull enemies toward your tower, then use Power Fist so the tower gets extra hits on them.",
          "refs": [
            { "kind": "ability", "key": "Blitzcrank-E", "start": 41, "end": 51 }
          ],
          "pWrong": 0.04
        },
        {
          "id": "support:Blitzcrank:general:3",
          "text": "Use Overdrive to close the gap before a grab or to chase a hurt enemy. Do not use it to retreat, since you are slowed when it ends.",
          "refs": [
            { "kind": "ability", "key": "Blitzcrank-W", "start": 4, "end": 13 },
            { "kind": "keyword", "key": "slowed", "start": 111, "end": 117 }
          ],
          "pWrong": 0.22
        },
        {
          "id": "support:Blitzcrank:general:4",
          "text": "Use Static Field when enemies are shielded or grouped up; it destroys their shields and silences them.",
          "refs": [
            { "kind": "ability", "key": "Blitzcrank-R", "start": 4, "end": 16 },
            { "kind": "keyword", "key": "silenced", "start": 88, "end": 96 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "support:Blitzcrank:general:5",
          "text": "Finish a grab with Power Fist and then Static Field for a strong burst on one enemy.",
          "refs": [
            {
              "kind": "ability",
              "key": "Blitzcrank-E",
              "start": 19,
              "end": 29
            },
            { "kind": "ability", "key": "Blitzcrank-R", "start": 39, "end": 51 }
          ],
          "pWrong": 0.07
        },
        {
          "id": "support:Blitzcrank:general:6",
          "text": "Do not Rocket Grab an enemy who is about to die to the damage; a target killed by it is not pulled.",
          "refs": [
            { "kind": "ability", "key": "Blitzcrank-Q", "start": 7, "end": 18 }
          ],
          "pWrong": 0.04
        },
        {
          "id": "support:Blitzcrank:general:7",
          "text": "When you drop low on health, Mana Barrier gives you a shield, so you can stay in the fight a bit longer.",
          "refs": [
            {
              "kind": "ability",
              "key": "Blitzcrank-passive",
              "start": 29,
              "end": 41
            }
          ],
          "pWrong": 0.02
        }
      ],
      "combos": []
    }
  ],
