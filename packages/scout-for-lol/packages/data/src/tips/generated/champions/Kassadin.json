            { "kind": "ability", "key": "Kassadin-E", "start": 14, "end": 25 },
            { "kind": "keyword", "key": "poke", "start": 47, "end": 51 },
            { "kind": "keyword", "key": "slowed", "start": 63, "end": 69 }
          ],
          "pWrong": 0.34
        },
        {
          "id": "middle:Kassadin:Ahri:4",
          "text": "Play safe while Ahri's Spirit Rush is ready. Once she spends it, jump in with Riftwalk and fight.",
          "refs": [
            { "kind": "champion", "key": "Ahri", "start": 16, "end": 20 },
            { "kind": "ability", "key": "Ahri-R", "start": 23, "end": 34 },
            { "kind": "ability", "key": "Kassadin-R", "start": 78, "end": 86 }
          ],
          "pWrong": 0.49
        },
        {
          "id": "middle:Kassadin:Ahri:5",
          "text": "Use Riftwalk to step out of a Charm line, or to close in on Ahri after she has used it.",
          "refs": [
            { "kind": "ability", "key": "Kassadin-R", "start": 4, "end": 12 },
            { "kind": "ability", "key": "Ahri-E", "start": 30, "end": 35 },
            { "kind": "champion", "key": "Ahri", "start": 60, "end": 64 }
