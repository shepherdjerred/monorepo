  "general": [
    {
      "lane": "top",
      "inputHash": "b422cf82ceada815d559bb439d62981cf8f6b5d5e734f6b79f542c182bda5140",
      "tips": [
        {
          "id": "top:Riven:general:0",
          "text": "Use Broken Wings between minions to close in and trade. Cast it at the enemy champion, not a minion, so the dash locks onto them.",
          "refs": [
            { "kind": "ability", "key": "Riven-Q", "start": 4, "end": 16 }
          ],
          "pWrong": 0.86
        },
        {
          "id": "top:Riven:general:1",
          "text": "Weave basic attacks between your ability casts. Each cast charges Runic Blade, and every charge adds extra damage to an attack.",
          "refs": [
            {
              "kind": "ability",
              "key": "Riven-passive",
              "start": 66,
              "end": 77
            }
          ],
          "pWrong": 0.32
        },
        {
          "id": "top:Riven:general:2",
          "text": "Lead a fight with Broken Wings, then use Ki Burst when the enemy is close to stun them. Follow with attacks while they can't act.",
          "refs": [
            { "kind": "ability", "key": "Riven-Q", "start": 18, "end": 30 },
            { "kind": "ability", "key": "Riven-W", "start": 41, "end": 49 }
          ],
          "pWrong": 0.18
        },
        {
          "id": "top:Riven:general:3",
          "text": "Use Valor to escape or to absorb the enemy's harass. Don't spend it early if you need it to get out.",
          "refs": [
            { "kind": "ability", "key": "Riven-E", "start": 4, "end": 9 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "top:Riven:general:4",
          "text": "Save the third cast of Broken Wings for the finishing move. It knocks enemies up and can cross terrain, which helps you chase or flee.",
          "refs": [
            { "kind": "ability", "key": "Riven-Q", "start": 23, "end": 35 }
          ],
          "pWrong": 0.73
        },
        {
          "id": "top:Riven:general:5",
          "text": "Activate Blade of the Exile before you start a full trade. Then finish a weakened enemy with its recast, which hits harder the lower their health is.",
          "refs": [
            { "kind": "ability", "key": "Riven-R", "start": 9, "end": 27 }
          ],
          "pWrong": 0.05
        },
        {
          "id": "top:Riven:general:6",
          "text": "Don't start a fight with your whole combo spent. Riven has no healing and little defense, so keep Valor ready for what comes back.",
          "refs": [
            { "kind": "champion", "key": "Riven", "start": 49, "end": 54 },
            { "kind": "ability", "key": "Riven-E", "start": 98, "end": 103 }
          ],
          "pWrong": 0.33
        }
      ],
      "combos": [
        {
          "id": "top:Riven:combo:0",
          "name": "Fast Q cancel",
          "category": "trick",
          "sequence": [{ "kind": "ability", "key": "Riven-Q" }, "attack"],
          "when": "Any time you Q into melee range and want the attack to come out quickly between recasts.",
          "whenRefs": [],
          "text": "Riven's Q resets her attack timer. Move right after each Q cast and attack at once, so the Q-attack-Q-attack rhythm stays quick.",
          "textRefs": [
            { "kind": "champion", "key": "Riven", "start": 0, "end": 5 }
          ]
        },
        {
          "id": "top:Riven:combo:1",
          "name": "Shield Q burst",
          "category": "combo",
          "sequence": [
            { "kind": "ability", "key": "Riven-E" },
            { "kind": "ability", "key": "Riven-W" },
            { "kind": "ability", "key": "Riven-Q" }
          ],
          "when": "Engaging a target that is just out of Ki Burst range and you want a shield as you go in.",
          "whenRefs": [
            { "kind": "ability", "key": "Riven-W", "start": 38, "end": 46 }
          ],
          "text": "Valor closes the gap and shields you. Ki Burst can be cast during the dash, then Broken Wings follows up.",
          "textRefs": [
            { "kind": "ability", "key": "Riven-E", "start": 0, "end": 5 },
            { "kind": "ability", "key": "Riven-W", "start": 38, "end": 46 },
            { "kind": "ability", "key": "Riven-Q", "start": 81, "end": 93 }
          ]
        },
        {
          "id": "top:Riven:combo:2",
          "name": "Third Q wall hop",
          "category": "terrain",
          "sequence": [{ "kind": "ability", "key": "Riven-Q" }],
          "when": "Escaping or chasing across thin walls, such as those in the jungle.",
          "whenRefs": [],
          "text": "The third Broken Wings cast can cross terrain and gains extra dash range through walls. Line up two recasts first, then use the last Q to hop over thin walls.",
          "textRefs": [
            { "kind": "ability", "key": "Riven-Q", "start": 10, "end": 22 }
          ]
        }
      ]
    }
  ],
