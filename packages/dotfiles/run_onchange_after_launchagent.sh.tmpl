#!/bin/bash
set -euo pipefail
{{ if eq .chezmoi.os "darwin" -}}
GUI_DOMAIN="gui/$(id -u)"

# Reload a LaunchAgent from its installed plist when the plist and the program
# it runs are both present.
reload_agent() {
    local label="$1" program="$2"
    local plist="$HOME/Library/LaunchAgents/$label.plist"
    if [ -f "$plist" ] && command -v "$program" >/dev/null; then
        if launchctl list | grep -q "$label"; then
            launchctl bootout "$GUI_DOMAIN" "$plist"
        fi
        launchctl bootstrap "$GUI_DOMAIN" "$plist"
    fi
}

# {{ include "Library/LaunchAgents/com.jerred.dark-notify.plist" | sha256sum }}
reload_agent com.jerred.dark-notify dark-notify

# Keeps the herdr-core daemon owned by launchd, not by an SSH login.
# {{ include "Library/LaunchAgents/com.jerred.herdr-core.plist" | sha256sum }}
reload_agent com.jerred.herdr-core "$HOME/.local/bin/herdr-core"
{{- if eq .profile "workstation" }}

# The Taildrop receiver runs only on the workstation.
# {{ include "Library/LaunchAgents/com.jerred.taildrop.plist" | sha256sum }}
reload_agent com.jerred.taildrop /opt/homebrew/bin/tailscale
{{- end }}
{{- if eq .profile "assistant-host" }}

# Keeps the ChatGPT app open so a Dot can use this Mac.
# {{ include "Library/LaunchAgents/com.jerred.chatgpt.plist" | sha256sum }}
reload_agent com.jerred.chatgpt /usr/bin/open
{{- end }}
{{ end -}}
