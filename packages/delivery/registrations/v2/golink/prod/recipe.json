{
  "id": "golink/prod/1",
  "definition": {
    "kind": "kubernetes-application",
    "application": {
      "name": "golink",
      "metadata": {
        "labels": { "ci.sjer.red/managed-application": "true" },
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=false",
          "ci.sjer.red/application-lifecycle": "retain"
        },
        "finalizers": []
      },
      "project": "workloads",
      "destination": {
        "server": "https://kubernetes.default.svc",
        "namespace": "golink"
      },
      "source": {
        "repoURL": "https://chartmuseum.tailnet-1a49.ts.net",
        "chart": "golink"
      },
      "syncOptions": [
        "ApplyOutOfSyncOnly=true",
        "RespectIgnoreDifferences=true"
      ],
      "ignoreDifferences": [
        {
          "group": "",
          "kind": "PersistentVolumeClaim",
          "name": "golink-pvc",
          "namespace": "golink",
          "jsonPointers": ["/spec/volumeName"]
        }
      ],
      "revisionHistoryLimit": 5,
      "lifecycle": "retain"
    },
    "chartComponent": "chart:golink",
    "artifactParameters": {},
    "runner": { "service": "ci", "component": "image:ci-base" },
    "steps": [
      {
        "kind": "apply-safety",
        "instance": "application:golink",
        "pointOfNoReturn": false
      },
      {
        "kind": "sync",
        "instance": "application:golink",
        "pointOfNoReturn": false
      }
    ],
    "oracle": { "probes": [], "tests": [] }
  }
}
