{
  "name": "@shepherdjerred/the-storm",
  "private": true,
  "type": "module",
  "exports": {
    "./promotion/targets.json": "./promotion/targets.json",
    "./maintenance-status.json": "./maintenance-status.json",
    "./public-status.json": "./public-status.json",
    "./server/owned/plugins/TheStorm/plot-reconcile.json": "./server/owned/plugins/TheStorm/plot-reconcile.json",
    "./server/owned/plugins/TheStorm/rwf-archive.json": "./server/owned/plugins/TheStorm/rwf-archive.json"
  },
  "imports": {
    "#capacity-bars": "./tests/capacity/capacity-bars.ts",
    "#capacity-runtime": "./tests/capacity/runtime.ts",
    "#capacity-combat-wire": "./plugin/dist/src/e2e/resources/rwf-capacity-combat.json",
    "#capacity-behavior-wire": "./plugin/dist/src/e2e/resources/rwf-capacity-behavior.json",
    "#capacity-behavior": "./tests/capacity/behavior.ts",
    "#capacity-features": "./tests/capacity/features.ts",
    "#capacity-fixtures/*": "./tests/capacity/fixtures/*",
    "#traversal-wire": "./plugin/dist/src/e2e/resources/rwf-traversal.json",
    "#map-connections-wire": "./plugin/dist/src/e2e/resources/rwf-map-connections.json",
    "#health-wire": "./plugin/dist/src/e2e/resources/rwf-health-proof.json",
    "#authored-combat-wire": "./plugin/dist/src/e2e/resources/rwf-authored-combat.json",
    "#pursuit-wire": "./plugin/dist/src/e2e/resources/rwf-pursuit.json",
    "#client/*": "./tools/client/*",
    "#client-duel-video-wire": "./client/src/main/resources/storm-duel-video.json",
    "#client-duel-clock-wire": "./client/src/main/resources/storm-duel-clock.json",
    "#client-video-wire": "./client/src/main/resources/storm-video.json",
    "#client-frame-pacing-wire": "./client/src/main/resources/storm-frame-pacing.json",
    "#e2e/*": "./tests/e2e/*",
    "#load/*": "./tests/load/*",
    "#maps/*": "./tools/maps/*",
    "#learning/*": "./tools/learning/*",
    "#learning-wire": "./plugin/modules/rwfbots/src/main/resources/rwf-duel.json",
    "#learning-map-wire": "./plugin/modules/rwfbots/src/main/resources/rwf-map-scenario.json",
    "#learning-map-scenarios": "./plugin/modules/rwfbots/src/main/resources/rwf-map-scenarios.json",
    "#learning-training-map-scenarios": "./tools/learning/maps/training-scenarios.json",
    "#learning-close-starts-wire": "./plugin/modules/rwfbots/src/main/resources/rwf-close-starts.json",
    "#learning-setup-wire": "./plugin/modules/rwfbots/src/main/resources/rwf-duel-setup.json",
    "#learning-load-wire": "./plugin/modules/rwfbots/src/main/resources/rwf-inference-load.json",
    "#learning-regression-wire": "./plugin/modules/rwfbots/src/main/resources/rwf-regression-capture.json",
    "#learning-melee-wire": "./plugin/modules/rwfbots/src/main/resources/rwf-melee-check.json",
    "#learning-simulation-wire": "./plugin/modules/rwfbots/src/main/resources/rwf-simulation-check.json",
    "#learning-promotion-wire": "./plugin/modules/rwfbots/src/main/resources/rwf-actor-promotion.json",
    "#ranged-kits-wire": "./plugin/modules/rwf/src/test/resources/rwf-ranged-kits.json"
  },
  "description": "Turbo shim over the Gradle build of The Storm's Paper plugin (plugin/) — scripts wrap Gradle so the workspace joins the task graph (caching + affected). Same pattern as the Go and Rust shims. tests/e2e is the TypeScript real-server harness.",
  "scripts": {
    "icon:render": "bun server/render-icon.ts",
    "icon:check": "bun server/render-icon.ts --check",
    "client": "bun --no-install tools/client/index.ts",
    "build:plugin": "mise exec -- gradle -p plugin assemble --console=plain",
    "build:client": "mise exec -- gradle -p client assemble --console=plain",
    "check:client": "mise exec -- gradle -p client check --console=plain",
    "test:client": "mise exec -- gradle -p client test --console=plain && bun --no-install --bun vitest run tools/client --exclude '**/.cache/**' --config ../../vitest.config.ts",
    "test:client-native": "mise exec -- gradle -p client runClientGameTest --console=plain",
    "build": "bun run build:plugin && bun run build:client",
    "test": "bun run test:server && mise exec -- gradle -p plugin test --console=plain && bun --no-install --bun vitest --config ../../vitest.config.ts run tests/rcon.test.ts tests/rwf-recording.test.ts tests/rwf-status.test.ts tests/server-files.test.ts tests/external-server.test.ts tools/sandbox-qualification tests/capacity/capacity-bars.test.ts scripts/bots/mineskin.test.ts scripts/bots/archery.test.ts && bun run test:client && bun run test:learning && bun run test:maps && bun run test:capacity-tools",
    "test:server": "bun run icon:check && python3 -m unittest discover -s server -p 'test_livemap.py' && python3 -m unittest discover -s server -p 'test_delivery*.py'",
    "test:smoke": "bun --no-install --bun vitest run --config vitest.e2e.config.ts tests/e2e/plugin.e2e.test.ts tests/e2e/server.e2e.test.ts",
    "test:e2e": "bun --no-install --bun vitest run --config vitest.e2e.config.ts",
    "test:full": "STORM_E2E_FULL=1 bun --no-install --bun vitest run --config vitest.full.config.ts",
    "test:startup": "STORM_E2E_FULL=1 bun --no-install --bun vitest run --config vitest.startup.config.ts",
    "test:load": "STORM_E2E_PROFILE=load bun --no-install --bun vitest run --config vitest.load.config.ts",
    "test:capacity": "STORM_E2E_PROFILE=capacity bun --no-install --bun vitest run --config vitest.capacity.config.ts",
    "test:capacity-native": "STORM_E2E_PROFILE=capacity bun --no-install --bun vitest run --config vitest.capacity-native.config.ts",
    "test:capacity-frame-pacing": "STORM_E2E_PROFILE=capacity bun --no-install --bun vitest run --config vitest.capacity-frame-pacing.config.ts",
    "test:capacity-tools": "bun --no-install --bun vitest run tools/capacity tests/capacity/runtime.test.ts tests/capacity/native-combat.test.ts tests/capacity/map-readiness.test.ts tests/capacity/native-readiness.test.ts tests/capacity/behavior.test.ts tests/capacity/features.test.ts --exclude '**/.cache/**' --config ../../vitest.config.ts",
    "capacity:qualify": "bun tools/capacity/index.ts",
    "qualify:sandbox": "bun tools/sandbox-qualification/index.ts",
    "rwf:watch": "bun scripts/rwf-watch.ts",
    "rwf:trails": "bun scripts/rwf-trails.ts",
    "maps:import": "bun tools/maps/index.ts",
    "maps:connect": "bun tools/maps/connections/index.ts",
    "maps:author": "bun tools/maps/author.ts",
    "maps:author-lobby": "bun tools/maps/lobby.ts",
    "maps:integrate-content": "bun tools/maps/content/integrate-content.ts",
    "maps:bake": "bun tools/maps/bake.ts",
    "maps:details": "bun tools/maps/details.ts",
    "maps:stage": "bun tools/maps/stage.ts",
    "maps:close-starts": "bun tools/maps/close-starts.ts",
    "maps:verify-close-starts": "bun tools/maps/close-starts-native.ts",
    "maps:verify-runtime": "bun tools/maps/runtime.ts",
    "maps:verify-navigation": "bun tools/maps/navigation.ts",
    "maps:verify-pursuit": "bun tools/maps/pursuit.ts",
    "maps:calibrate-traversal": "bun tools/maps/traversal.ts",
    "maps:verify-health-native": "bun tools/maps/health.ts",
    "maps:verify-authored-combat-native": "bun tools/maps/combat/native.ts",
    "test:maps-python": "uv run --project tools/learning --locked python -m unittest discover -s tools/maps -p '*_test.py'",
    "test:maps": "bun run test:maps-python && bun --no-install --bun vitest run tools/maps --exclude '**/.cache/**' --config ../../vitest.config.ts",
    "bots:generate": "bun scripts/bots/generate-personalities.ts",
    "bots:dataset": "uv run --project tools/learning --locked python scripts/bots/learning/dataset.py",
    "bots:benchmark": "bun scripts/bots/benchmark.ts",
    "bots:match": "bun scripts/bots/match.ts",
    "bots:stuck": "bun scripts/bots/stuck.ts",
    "bots:archery": "bun scripts/bots/archery.ts",
    "bots:ppo": "bun tools/learning/run.ts",
    "bots:pilot": "bun tools/learning/pilot.ts",
    "bots:evaluate": "bun tools/learning/evaluation.ts",
    "bots:preference": "bun tools/learning/preference/index.ts",
    "bots:java-video": "bun tools/learning/native/diagnostic.ts",
    "bots:verify-java": "bun tools/learning/java-run.ts",
    "bots:verify-java-load": "bun tools/learning/load-run.ts",
    "bots:verify-live-window": "bun tools/learning/native/live-window.ts",
    "bots:verify-regression-capture": "bun tools/learning/native/regression-diagnostic.ts",
    "bots:verify-human-combat": "bun tools/learning/native/regression/human.ts",
    "bots:verify-last-human-abort": "bun tools/learning/native/regression/abort.ts",
    "bots:verify-spectator-immunity": "bun tools/learning/native/regression/watcher.ts",
    "bots:verify-healing-lifecycle": "bun tools/learning/native/regression/healing.ts",
    "bots:verify-native-melee": "bun tools/learning/native/regression/melee.ts",
    "bots:verify-simulation-floors": "bun tools/learning/native/simulation/index.ts",
    "bots:collect-regressions": "bun tools/learning/native/evidence/index.ts",
    "bots:collect-preference": "bun tools/learning/native/collector.ts",
    "bots:promote": "bun tools/learning/promotion/index.ts",
    "test:preference-media": "bun --no-install --bun vitest run tests/media --config ../../vitest.config.ts",
    "test:learning-python": "uv run --project tools/learning --locked python -m unittest discover -s scripts/bots/learning -p '*_test.py' && uv run --project tools/learning --locked python -m unittest discover -s tools/learning -p '*_test.py'",
    "test:learning": "bun run test:learning-python && bun --no-install --bun vitest run tools/learning --exclude '**/.cache/**' --config ../../vitest.config.ts",
    "lint:learning": "uv run --project tools/learning --locked ruff check tools/learning && uv run --project tools/learning --locked ruff format --check tools/learning",
    "typecheck:learning": "uv run --project tools/learning --locked pyright --project tools/learning",
    "lint": "mise exec -- gradle -p plugin spotlessCheck pmdMain pmdTest --console=plain && mise exec -- gradle -p client spotlessCheck pmdMain pmdTest --console=plain && bunx --no-install eslint --cache . && bun run lint:learning",
    "typecheck": "mise exec -- gradle -p plugin compileJava compileTestJava --console=plain && mise exec -- gradle -p client compileJava compileTestJava --console=plain && PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit && bun run typecheck:learning",
    "check": "mise exec -- gradle -p plugin check --console=plain && bun run check:client",
    "format": "mise exec -- gradle -p plugin spotlessApply --console=plain",
    "test:ci": "bun ../../scripts/ci/run-ci-test.ts"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@shepherdjerred/eslint-config": "workspace:*",
    "@shepherdjerred/mc-build": "workspace:*",
    "@shepherdjerred/mc-harness": "workspace:*",
    "@types/bun": "1.4.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "minecraft-data": "3.117.0",
    "mineflayer": "4.39.0",
    "typescript": "^6.0.3",
    "vec3": "^0.1.7",
    "vitest": "5.0.1",
    "zod": "^4.4.3"
  }
}
