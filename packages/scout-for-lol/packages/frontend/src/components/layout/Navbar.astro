---
import { SharedNavbar } from "#src/components/shared-navbar.tsx";
import { championMetaSnapshot } from "#src/components/champions/snapshot.ts";
import { hasChampions } from "#src/lib/champion-meta/snapshot-v2-load.ts";

interface Props {
  activePage?:
    "home" | "getting-started" | "docs" | "support" | "whatsnew" | "champions";
}

const { activePage } = Astro.props;
const paths = {
  home: "/",
  "getting-started": "/getting-started",
  docs: "/docs/",
  support: "/support",
  whatsnew: "/whatsnew",
  champions: "/champions/",
};
const currentPath = activePage === undefined ? undefined : paths[activePage];

// The Champions page is linked only once a snapshot holds champions, so the
// navigation never points at an empty page.
const { index } = await championMetaSnapshot;
const extraLinks = hasChampions(index)
  ? [{ label: "Champions", href: "/champions/", match: "prefix" as const }]
  : [];
---

<SharedNavbar currentPath={currentPath} extraLinks={extraLinks} client:load />
