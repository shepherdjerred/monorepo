{
  "name": "tasknotes-server",
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#architecture": "./architecture.config.ts",
    "#generated/*": "./generated/*"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "bun scripts/migrate.ts",
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile=dist/tasknotes-server",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run --exclude '**/*.integration.test.ts'",
    "test:extended": "bun ../../scripts/ci/run-ci-test.ts --tier extended",
    "lint": "bunx eslint . --max-warnings=0 && check-architecture",
    "docker:build": "docker buildx build --cache-from type=registry,ref=docker.io/shepherdjerred/tasknotes-server:buildcache ${DOCKER_BUILD_EXTRA_ARGS:-} --load -t tasknotes-server:dev -f Dockerfile ../..",
    "smoke": "bun scripts/smoke.ts",
    "test:ci": "bun ../../scripts/ci/run-ci-test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/bun": "^11.16.0",
    "@shepherdjerred/bugsink-config": "workspace:*",
    "@shepherdjerred/facet-protocol": "workspace:*",
    "hono": "^4.12.18",
    "prisma": "^7.10.1",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shepherdjerred/architecture": "workspace:*",
    "@shepherdjerred/eslint-config": "workspace:*",
    "@shepherdjerred/test-postgres": "workspace:*",
    "@types/bun": "1.4.5",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "vitest": "5.0.5",
    "@vitest/coverage-istanbul": "5.0.5"
  }
}
