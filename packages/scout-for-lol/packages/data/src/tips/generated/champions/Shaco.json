          "when": "Starting a fight or baiting enemies when you want to control where the clone appears.",
          "whenRefs": [],
          "text": "Cast Hallucinate right after Deceive and the clone spawns toward your cursor instead of behind you. This helps send it at the enemy.",
          "textRefs": [
            { "kind": "ability", "key": "Shaco-R", "start": 5, "end": 16 },
            { "kind": "ability", "key": "Shaco-Q", "start": 29, "end": 36 }
          ]
        },
        {
          "id": "jungle:Shaco:combo:2",
          "name": "Deceive over a wall",
          "category": "terrain",
          "sequence": [{ "kind": "ability", "key": "Shaco-Q" }],
          "when": "Escaping a failed fight or chase near a thin wall.",
          "whenRefs": [],
          "text": "Deceive over a thin jungle wall to break line of sight and get away invisible.",
          "textRefs": [
            { "kind": "ability", "key": "Shaco-Q", "start": 0, "end": 7 }
          ]
        }
      ]
    }
  ],
