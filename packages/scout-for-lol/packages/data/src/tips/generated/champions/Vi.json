  "general": [
    {
      "lane": "jungle",
      "inputHash": "f835e4220e8a18116c323c66fc80c3a1c399abbcf591033ee9cf5ab274293513",
      "tips": [
        {
          "id": "jungle:Vi:general:0",
          "text": "Hold Vault Breaker to charge it before you release; a longer charge hits harder and reaches farther, so it is best for catching someone running away.",
          "refs": [{ "kind": "ability", "key": "Vi-Q", "start": 5, "end": 18 }],
          "pWrong": 0.1
        },
        {
          "id": "jungle:Vi:general:1",
          "text": "Charging Vault Breaker slows you a little, so charge it out of sight or behind a minion and release when the enemy is close.",
          "refs": [
            { "kind": "ability", "key": "Vi-Q", "start": 9, "end": 22 },
            { "kind": "keyword", "key": "slowed", "start": 23, "end": 28 }
          ],
          "pWrong": 0.68
        },
        {
          "id": "jungle:Vi:general:2",
          "text": "Use Relentless Force on a minion or monster in front of an enemy; the blast also hits the units behind your target.",
          "refs": [{ "kind": "ability", "key": "Vi-E", "start": 4, "end": 20 }],
          "pWrong": 0.36
        },
        {
          "id": "jungle:Vi:general:3",
          "text": "Keep attacking the same target; every third hit with Denting Blows deals extra damage, cuts their Armor and speeds up your attacks.",
          "refs": [
            { "kind": "ability", "key": "Vi-W", "start": 53, "end": 66 }
          ],
          "pWrong": 0.24
        },
        {
          "id": "jungle:Vi:general:4",
          "text": "Hit an enemy with an ability to activate Blast Shield; landing Denting Blows hits brings it back sooner.",
          "refs": [
            { "kind": "ability", "key": "Vi-passive", "start": 41, "end": 53 },
            { "kind": "ability", "key": "Vi-W", "start": 63, "end": 76 }
          ],
          "pWrong": 0.46
        },
        {
          "id": "jungle:Vi:general:5",
          "text": "Use Cease and Desist on a target you can finish off. Nothing can push you off course while you dash, and the target is knocked up.",
          "refs": [
            { "kind": "ability", "key": "Vi-R", "start": 4, "end": 20 },
            { "kind": "keyword", "key": "knocked-up", "start": 119, "end": 129 }
          ],
          "pWrong": 0.63
        },
        {
          "id": "jungle:Vi:general:6",
          "text": "Start a fight with Cease and Desist only when your team is close; diving alone ahead of them gets you killed.",
          "refs": [
            { "kind": "ability", "key": "Vi-R", "start": 19, "end": 35 }
          ],
          "pWrong": 0.06
        },
        {
          "id": "jungle:Vi:general:7",
          "text": "Enemies you dash through with Cease and Desist are stunned, so aim it at the target so the dash passes through the rest of their team.",
          "refs": [
            { "kind": "ability", "key": "Vi-R", "start": 30, "end": 46 }
          ],
          "pWrong": 0.21
        }
      ],
      "combos": []
    }
  ],
