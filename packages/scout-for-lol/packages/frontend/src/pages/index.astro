---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import WhatsNewBanner from "../components/WhatsNewBanner.astro";
import Hero from "../components/Hero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import FeatureCard from "../components/FeatureCard.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import CTA from "../components/CTA.astro";
import GalleryItem from "../components/GalleryItem.astro";
import ProcessStep from "../components/ProcessStep.astro";
import ConsumerExperiencePreviews from "../components/ConsumerExperiencePreviews.astro";
import {
  generatedScoutShowcaseAssets,
  getGeneratedScoutShowcaseAssetSrc,
} from "../data/scout-showcase";
import {
  APP_LOGIN_URL,
  GET_STARTED_CLICK_EVENT,
} from "#src/lib/marketing-constants.ts";

const matchImg = getGeneratedScoutShowcaseAssetSrc("ranked-solo-1-postmatch");

type GeneratedScoutShowcaseAsset =
  (typeof generatedScoutShowcaseAssets)[number];

const requireShowcaseAsset = (id: string): GeneratedScoutShowcaseAsset => {
  const src = getGeneratedScoutShowcaseAssetSrc(id);
  const asset = generatedScoutShowcaseAssets.find(
    (candidate) => candidate.id === id && candidate.src === src,
  );

  if (asset === undefined) {
    throw new Error(`Missing generated Scout showcase asset: ${id}`);
  }

  return asset;
};

const showcasePreviews = [
  {
    label: "League Classic",
    detail: "Pre-match coverage",
    asset: requireShowcaseAsset("classic-prematch"),
  },
  {
    label: "Ranked",
    detail: "Solo/Duo · Flex · Ranked 5s",
    asset: requireShowcaseAsset("ranked-solo-discord"),
  },
  {
    label: "ARAM",
    detail: "Post-match report",
    asset: requireShowcaseAsset("aram-discord"),
  },
  {
    label: "Arena",
    detail: "Placement and team report",
    asset: requireShowcaseAsset("arena-discord"),
  },
];

const initialShowcasePreview = showcasePreviews.at(0)?.asset;
---

<Layout
  title="Scout for League of Legends"
  description="Get notified when your friends start League of Legends matches and get beautiful post-match reports delivered right to your Discord server."
>
  <div class="bg-scout-surface">
    <div
      class="grid min-h-svh min-w-0 grid-cols-[minmax(0,1fr)] grid-rows-[auto_auto_minmax(0,1fr)]"
      data-home-above-fold
    >
      <div role="region" aria-label="Latest update">
        <WhatsNewBanner />
      </div>
      <Navbar activePage="home" />
      <Hero
        title="Scout for League of Legends"
        subtitle="Track your server’s League players with pre-match alerts and detailed recaps, run competitions and scheduled reports, then let members explore recorded games and shared player profiles."
        showGradient={true}
        size="home"
        ctaButtons={[
          {
            text: "Get Started",
            href: APP_LOGIN_URL,
            variant: "primary",
            trackingEvent: GET_STARTED_CLICK_EVENT,
            trackingLocation: "home_hero",
          },
        ]}
      />
    </div>
    <main>
      <!-- Features Section -->
      <div id="features" class="py-24 sm:py-32">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <SectionHeader
            badge="Everything you need"
            title="Everything your League server needs"
            subtitle="Scout follows each tracked player from queue pop to post-game, then turns recorded matches into reports, competitions, profiles, and answers."
          />
          <FeatureGrid>
            <FeatureCard
              icon="heroicons:eye"
              title="Pre- & Post-Match Updates"
              description="Know when a tracked player starts a game, then get a detailed Discord recap with the result, builds, ranks, and standout stats."
            />
            <FeatureCard
              icon="heroicons:bolt"
              title="All the Modes You Play"
              description="Track League Classic, Arena, ARAM, ARAM Mayhem, Clash, Ranked Solo/Duo, Ranked Flex, and Ranked 5s."
            />
            <FeatureCard
              icon="heroicons:users"
              title="Every Region, Every Name"
              description="Follow Riot accounts across every supported region and render multilingual player names clearly in every report."
            />
            <FeatureCard
              icon="heroicons:trophy"
              title="Competitions, Leaderboards & Reports"
              description="Run season or date-based competitions and schedule recurring Discord reports for standings, champion trends, surrender rates, and team performance."
            />
            <FeatureCard
              icon="heroicons:user-circle"
              title="Player Profiles"
              description="See configured accounts together with observed ranks, recent form, champion performance, and every game Scout recorded."
            />
            <FeatureCard
              icon="heroicons:sparkles"
              title="Explore & Ask Scout"
              description="Ask questions across Scout’s recorded games in Explore or start with /scout ask in Discord, then continue the conversation on the web."
            />
          </FeatureGrid>
        </div>
      </div>

      <ConsumerExperiencePreviews />

      <!-- Match Report Preview -->
      <div class="py-24 sm:py-32">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <SectionHeader
            badge="Automatic Match Reports"
            title="The whole match, at a glance"
            subtitle="When a tracked game ends, Scout posts a polished Discord recap with the result, team compositions, builds, ranks, and the numbers behind every performance."
          />

          <div class="mx-auto mt-16 max-w-5xl">
            <GalleryItem
              imageSrc={matchImg}
              imageAlt="Example League of Legends match report showing team compositions, player statistics, KDA, damage dealt, gold earned, and items"
            />
          </div>
        </div>
      </div>

      <!-- Features Gallery Section -->
      <div class="bg-scout-surface py-24 sm:py-32">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <SectionHeader
            badge="Supported Game Modes"
            title="Reports for the modes you play"
          />

          <div
            class="mx-auto mt-10 grid max-w-5xl grid-cols-1 gap-6 sm:grid-cols-2"
          >
            {
              showcasePreviews.map((preview) => (
                <button
                  type="button"
                  class="group mx-auto block w-full cursor-zoom-in overflow-hidden rounded-xl border border-scout-border bg-scout-raised text-left shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-scout-focus focus-visible:ring-offset-4 focus-visible:ring-offset-scout-canvas"
                  data-scout-lightbox-trigger
                  data-lightbox-src={preview.asset.src}
                  data-lightbox-alt={preview.asset.title}
                  aria-label={`View ${preview.label} example larger`}
                >
                  <img
                    src={preview.asset.src}
                    alt={preview.asset.title}
                    loading="lazy"
                    class="aspect-video h-auto w-full object-cover object-top transition duration-200 group-hover:opacity-90"
                  />
                  <span class="block px-5 py-4">
                    <span class="block text-lg font-semibold text-scout-ink">
                      {preview.label}
                    </span>
                    <span class="mt-1 block text-sm text-scout-subtle">
                      {preview.detail}
                    </span>
                  </span>
                </button>
              ))
            }
          </div>

          {
            showcasePreviews.length === 0 && (
              <div class="mt-8 rounded-lg border border-scout-border bg-scout-raised px-5 py-4 text-sm text-scout-subtle ">
                Scout showcase examples are unavailable right now.
              </div>
            )
          }

          {
            initialShowcasePreview !== undefined && (
              <div
                class="fixed inset-0 z-50 hidden items-center justify-center bg-scout-canvas/90 p-4 backdrop-blur-sm"
                data-scout-lightbox
                role="dialog"
                aria-modal="true"
                aria-label="Scout report preview"
              >
                <button
                  type="button"
                  class="absolute top-4 right-4 rounded-md bg-scout-surface px-3 py-2 text-sm font-semibold text-scout-ink shadow-sm hover:bg-scout-raised focus:outline-none focus-visible:ring-2 focus-visible:ring-scout-focus"
                  data-scout-lightbox-close
                >
                  Close
                </button>
                <img
                  alt=""
                  loading="lazy"
                  class="max-h-[88vh] max-w-[95vw] rounded-md shadow-2xl"
                  data-scout-lightbox-image
                />
              </div>
            )
          }
        </div>
      </div>

      <script>
        const lightbox = document.querySelector("[data-scout-lightbox]");
        const lightboxImage = document.querySelector(
          "[data-scout-lightbox-image]",
        );
        const closeButtons = document.querySelectorAll(
          "[data-scout-lightbox-close]",
        );
        const triggers = document.querySelectorAll(
          "[data-scout-lightbox-trigger]",
        );
        let previousFocus: HTMLElement | null = null;

        const isLightboxOpen = () =>
          lightbox instanceof HTMLElement &&
          lightbox.classList.contains("flex") &&
          !lightbox.classList.contains("hidden");

        const closeLightbox = () => {
          if (!(lightbox instanceof HTMLElement)) {
            return;
          }

          lightbox.classList.add("hidden");
          lightbox.classList.remove("flex");
          document.documentElement.classList.remove("overflow-hidden");

          if (previousFocus instanceof HTMLElement) {
            previousFocus.focus();
          }

          previousFocus = null;
        };

        const openLightbox = (trigger: Element) => {
          if (
            !(trigger instanceof HTMLButtonElement) ||
            !(lightbox instanceof HTMLElement) ||
            !(lightboxImage instanceof HTMLImageElement)
          ) {
            return;
          }

          const src = trigger.dataset["lightboxSrc"];
          const alt = trigger.dataset["lightboxAlt"];

          if (!src || !alt) {
            return;
          }

          previousFocus = trigger;
          lightboxImage.src = src;
          lightboxImage.alt = alt;
          lightbox.classList.remove("hidden");
          lightbox.classList.add("flex");
          document.documentElement.classList.add("overflow-hidden");

          const closeButton = lightbox.querySelector(
            "[data-scout-lightbox-close]",
          );
          if (closeButton instanceof HTMLButtonElement) {
            closeButton.focus();
          }
        };

        triggers.forEach((trigger) => {
          trigger.addEventListener("click", () => {
            openLightbox(trigger);
          });
        });

        closeButtons.forEach((button) => {
          button.addEventListener("click", closeLightbox);
        });

        lightbox?.addEventListener("click", (event) => {
          if (event.target === lightbox) {
            closeLightbox();
          }
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            closeLightbox();
            return;
          }

          if (event.key !== "Tab" || !isLightboxOpen()) {
            return;
          }

          const closeButton = lightbox?.querySelector(
            "[data-scout-lightbox-close]",
          );

          if (!(closeButton instanceof HTMLButtonElement)) {
            return;
          }

          event.preventDefault();
          closeButton.focus();
        });
      </script>

      <!-- How it works -->
      <div class="bg-scout-raised py-24 sm:py-32">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <SectionHeader
            badge="Simple setup"
            title="Get started in minutes"
            centered={true}
          />
          <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-none">
            <div
              class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-16 lg:max-w-none lg:grid-cols-3"
            >
              <ProcessStep number={1} title="Sign in with Discord">
                <p class="text-scout-subtle">
                  Open the dashboard and sign in with your Discord account.
                </p>
              </ProcessStep>
              <ProcessStep number={2} title="Add Scout to your server">
                <p class="text-scout-subtle">
                  One click adds the bot to your server and sends you right back
                  to the dashboard.
                </p>
              </ProcessStep>
              <ProcessStep number={3} title="Pick who to track">
                <p class="text-scout-subtle">
                  Add the friends you want to follow, choose where Scout posts,
                  and start getting alerts, reports, and leaderboards.
                </p>
              </ProcessStep>
            </div>
          </div>
        </div>
      </div>

      <!-- Dashboard showcase -->
      <div class="py-24 sm:py-32">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <SectionHeader
            badge="Subscriptions · Competitions · Reports"
            title="Manage it all from one dashboard"
            subtitle="Track the players you care about, choose where Scout posts, and run competitions and scheduled reports — all from a fast web UI."
            centered={true}
          />
          <div class="mx-auto mt-16 max-w-4xl space-y-12">
            <GalleryItem
              imageSrc="/dashboard-add-subscription.png"
              imageAlt="Scout dashboard 'Add subscription' dialog with channel, region, Riot ID, and alias fields"
              caption="Add a player to track in seconds — pick a channel, paste a Riot ID, set an alias."
            />
            <GalleryItem
              imageSrc="/dashboard-subscriptions.png"
              imageAlt="Scout dashboard subscriptions table listing tracked players and their channels"
              caption="Manage every tracked player and channel from one table."
            />
            <GalleryItem
              imageSrc="/dashboard-competition.png"
              imageAlt="Scout dashboard competition setup form with criteria, queue, and schedule"
              caption="Spin up competitions and leaderboards with a guided form."
            />
          </div>
        </div>
      </div>

      <!-- CTA Section -->
      <CTA
        variant="indigo"
        title="Ready to track your friends' League matches?"
        description="Add Scout to your Discord server and never miss another epic play or hilarious fail from your League friends."
        buttons={[
          {
            text: "Get Started",
            href: APP_LOGIN_URL,
            variant: "primary",
            trackingEvent: GET_STARTED_CLICK_EVENT,
            trackingLocation: "home_final_cta",
          },
        ]}
      />
    </main>
    <Footer variant="homepage" />
  </div>
</Layout>
