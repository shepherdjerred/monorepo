            { "kind": "ability", "key": "Caitlyn-Q", "start": 39, "end": 58 }
          ],
          "pWrong": 0.6
        },
        {
          "id": "adc:Aphelios:Caitlyn:1",
          "text": "Stand behind allied minions when Caitlyn uses Piltover Peacemaker. It hits less after the first target.",
