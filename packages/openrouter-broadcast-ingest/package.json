{
  "name": "@shepherdjerred/openrouter-broadcast-ingest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "build": "bun --no-install build src/index.ts --outdir dist --target bun --external hono --external prom-client --external zod --external '@shepherdjerred/llm-observability'",
    "docker:build": "docker buildx build --cache-from type=registry,ref=ghcr.io/shepherdjerred/openrouter-broadcast-ingest:buildcache ${DOCKER_BUILD_EXTRA_ARGS:-} --load -t openrouter-broadcast-ingest:dev -f Dockerfile ../..",
    "lint": "bunx eslint --cache . --max-warnings=0",
    "start": "bun src/index.ts",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run test",
    "test:ci": "bun ../../scripts/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../scripts/run-ci-test.ts",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit"
  },
  "dependencies": {
    "@shepherdjerred/llm-observability": "workspace:*",
    "hono": "^4.12.18",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shepherdjerred/eslint-config": "workspace:*",
    "@tsconfig/node-lts": "^24.0.0",
    "@tsconfig/recommended": "^1.0.13",
    "@tsconfig/strictest": "^2.0.8",
    "@types/bun": "1.4.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "vitest": "4.1.10",
    "@vitest/coverage-istanbul": "4.1.10"
  }
}
