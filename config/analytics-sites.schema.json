{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["provider", "projectToken", "apiHost", "assetHost", "sites"],
  "additionalProperties": false,
  "properties": {
    "provider": { "const": "posthog" },
    "projectToken": {
      "type": "string",
      "pattern": "^phc_[A-Za-z0-9]+$"
    },
    "apiHost": { "const": "https://us.i.posthog.com" },
    "assetHost": { "const": "https://us-assets.i.posthog.com" },
    "sites": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["key", "hostname", "sessionReplay"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "hostname": { "type": "string", "minLength": 1 },
          "sessionReplay": { "type": "boolean" },
          "marketing": {
            "type": "object",
            "required": ["pinterestTagId", "redditPixelId"],
            "additionalProperties": false,
            "properties": {
              "pinterestTagId": { "type": "string", "minLength": 1 },
              "redditPixelId": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
