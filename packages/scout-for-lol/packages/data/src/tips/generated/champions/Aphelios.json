          ],
          "pWrong": 0.54
        },
        {
          "id": "adc:Aphelios:Jhin:2",
          "text": "Jump on Jhin while he reloads after his fourth shot; he cannot basic attack then.",
          "refs": [
            { "kind": "champion", "key": "Jhin", "start": 8, "end": 12 }
          ],
          "pWrong": 0.02
        },
        {
