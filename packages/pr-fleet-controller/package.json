{
  "name": "@shepherdjerred/pr-fleet-controller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "pr-fleet": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --target bun --outdir dist",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "lint": "bunx eslint --cache ."
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.17",
    "@mastra/core": "^1.55.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shepherdjerred/eslint-config": "workspace:*",
    "@tsconfig/node-lts": "^24.0.0",
    "@tsconfig/recommended": "^1.0.13",
    "@tsconfig/strictest": "^2.0.8",
    "@types/bun": "^1.3.13",
    "eslint": "^10.3.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3"
  }
}
