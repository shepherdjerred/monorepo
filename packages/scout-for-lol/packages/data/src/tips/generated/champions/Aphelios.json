      "inputHash": "18b332ff3183f711848d3f223a2ee38c4073baee17f12aff7295da40098bca4e",
      "tips": [
        {
          "id": "adc:Aphelios:Caitlyn:0",
          "text": "Stay out of Caitlyn's range early. Her Piltover Peacemaker reaches far, so trade only when she is busy with minions.",
