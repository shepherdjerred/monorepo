{
  "name": "@scout-for-lol/ui",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "lint": "bunx eslint src",
    "format": "bunx prettier --check src",
    "format:write": "bunx prettier --write src"
  },
  "dependencies": {
    "@scout-for-lol/data": "workspace:*",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "bun-types": "latest",
    "eslint": "^10.3.0",
    "typescript": "^6.0.3",
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "peerDependencies": {
    "react": "19.2.8"
  },
  "imports": {
    "#src/*": "./src/*"
  }
}
