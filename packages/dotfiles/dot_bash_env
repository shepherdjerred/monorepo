# ~/.bash_env - Sourced by all bash shells via BASH_ENV and shell configs
# This ensures mise and brew are available in scripts and non-interactive shells

# Add Homebrew to PATH (macOS Apple Silicon)
if [[ ":$PATH:" != *":/opt/homebrew/bin:"* ]] && [[ -d /opt/homebrew ]]; then
    export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
fi

# Add Homebrew to PATH (Linux)
if [[ ":$PATH:" != *":/home/linuxbrew/.linuxbrew/bin:"* ]] && [[ -d /home/linuxbrew/.linuxbrew ]]; then
    export PATH="/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin:$PATH"
fi

# Add user local bin
if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
    export PATH="$HOME/.local/bin:$PATH"
fi

# Add Homebrew's keg-only libpq (psql, pg_dump, pg_isready, pg_config).
# It conflicts with a full postgresql install, so brew never links it into
# /opt/homebrew/bin; pgcli pulls it in as a dependency but that is not enough.
if [[ ":$PATH:" != *":/opt/homebrew/opt/libpq/bin:"* ]] && [[ -d /opt/homebrew/opt/libpq/bin ]]; then
    export PATH="/opt/homebrew/opt/libpq/bin:$PATH"
fi

# Activate mise shims if mise is available
if command -v mise &>/dev/null; then
    eval "$(mise activate bash --shims)"
fi

# Fix gRPC DNS resolution for Tailscale split DNS on macOS
# Required for tools like talosctl to resolve Tailscale hostnames
export GRPC_DNS_RESOLVER=native
[[ -f "$HOME/.config/turbo-cache/env.sh" ]] && source "$HOME/.config/turbo-cache/env.sh"
