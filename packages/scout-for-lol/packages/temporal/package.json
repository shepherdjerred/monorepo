{
  "name": "@scout-for-lol/temporal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#architecture": "./architecture.config.ts",
    "#src/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./activities": "./src/activities.ts",
    "./activity-contracts": "./src/activity-contracts.ts",
    "./contracts": "./src/contracts.ts",
    "./pipeline-contracts": "./src/pipeline-contracts.ts",
    "./workflow-contracts": "./src/workflow-contracts.ts",
    "./execution-metadata": "./src/execution-metadata.ts",
    "./identifiers": "./src/identifiers.ts",
    "./match-receipts": "./src/match-receipts.ts",
    "./signals": "./src/signals.ts",
    "./silent-postmatch-backfill": "./src/silent-postmatch-backfill.ts",
    "./workflow-ui-interceptor": "./src/workflow-ui-interceptor.ts",
    "./workflows": "./src/workflows/index.ts"
  },
  "scripts": {
    "build": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "lint": "bun x eslint src --max-warnings=0 && check-architecture",
    "format": "bun x prettier --check src package.json tsconfig.json",
    "test": "bun run test:ci",
    "test:bun": "bun --no-install --bun vitest --config ../../../../vitest.config.ts run src --exclude 'src/workflows/**/*.test.ts'",
    "test:workflows": "mise exec node@24.19.0 -- node node_modules/vitest/vitest.mjs --config ../../../../vitest.config.ts run src/workflows --no-file-parallelism",
    "replay:candidate-histories": "bun scripts/replay-candidate-histories.ts",
    "replay:candidate-histories:node": "node --experimental-strip-types scripts/replay-candidate-histories-node.ts",
    "replay:histories": "bun scripts/replay-histories.ts",
    "replay:histories:node": "node --experimental-strip-types scripts/replay-histories-node.ts",
    "canary": "bun scripts/run-canary.ts",
    "test:ci": "bun ../../../../scripts/ci/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../../../scripts/ci/run-ci-test.ts"
  },
  "dependencies": {
    "@scout-for-lol/domain": "workspace:*",
    "@temporalio/common": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@scout-for-lol/data": "workspace:*",
    "@shepherdjerred/architecture": "workspace:*",
    "@shepherdjerred/root-scripts": "workspace:*",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/testing": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@types/node": "^26.1.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "bun-types": "1.4.2",
    "eslint": "^10.7.0",
    "typescript": "^6.0.3",
    "vitest": "5.0.3"
  }
}
