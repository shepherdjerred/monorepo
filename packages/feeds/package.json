{
  "name": "@shepherdjerred/feeds",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "exports": {
    "./*": "./src/*"
  },
  "imports": {
    "#generated/*": "./generated/*"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "generate": "prisma generate",
    "generate:unicode61": "bun src/server/search/generate-unicode61-table.ts",
    "migrate:deploy": "prisma migrate deploy",
    "start": "bun src/index.ts",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run src --exclude '**/*.integration.test.ts'",
    "test:extended": "bun ../../scripts/ci/run-ci-test.ts --tier extended",
    "test:ci": "bun ../../scripts/ci/run-ci-test.ts",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "lint": "bunx eslint --cache . --max-warnings=0"
  },
  "dependencies": {
    "@hono/bun": "^1.0.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/client-runtime-utils": "7.10.1",
    "@shepherdjerred/feature-flags": "workspace:*",
    "fast-xml-parser": "5.11.1",
    "hono": "^4.12.18",
    "htmlparser2": "^12.0.0",
    "prisma": "^7.10.1",
    "sanitize-html": "^2.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shepherdjerred/console-ui": "workspace:*",
    "@shepherdjerred/eslint-config": "workspace:*",
    "@shepherdjerred/ops-model": "workspace:*",
    "@shepherdjerred/test-postgres": "workspace:*",
    "@tanstack/react-query": "^5.101.2",
    "@types/bun": "1.4.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-istanbul": "5.0.5",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "lucide-react": "^1.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "5.0.5"
  }
}
