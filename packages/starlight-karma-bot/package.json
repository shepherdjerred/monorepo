{
  "name": "starlight-karma-bot",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "imports": {
    "#src/*": "./src/*",
    "#generated/*": "./generated/*"
  },
  "scripts": {
    "start": "bun run generate && bun run scripts/start.ts",
    "health": "bun run src/health.ts",
    "generate": "bun run scripts/generate-prisma.ts",
    "migrate": "bun run scripts/migrate.ts",
    "test": "bun run generate && bun test",
    "typecheck": "bun run generate && PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "lint": "bun run generate && bunx eslint --cache .",
    "format": "bunx prettier --check .",
    "prettier": "bunx prettier --write .",
    "docker:build": "docker buildx build --cache-from type=registry,ref=ghcr.io/shepherdjerred/starlight-karma-bot:buildcache ${DOCKER_BUILD_EXTRA_ARGS:-} --load -t starlight-karma-bot:dev -f Dockerfile ../..",
    "smoke": "bun scripts/smoke.ts",
    "test:ci": "bun ../../scripts/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../scripts/run-ci-test.ts"
  },
  "dependencies": {
    "@prisma/adapter-libsql": "7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/client-runtime-utils": "7.9.1",
    "@sentry/bun": "^10.49.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "env-var": "^7.5.0",
    "prisma": "7.9.1",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shepherdjerred/monorepo.git",
    "directory": "packages/starlight-karma-bot"
  },
  "homepage": "https://github.com/shepherdjerred/monorepo/tree/main/packages/starlight-karma-bot",
  "bugs": {
    "url": "https://github.com/shepherdjerred/monorepo/issues"
  },
  "devDependencies": {
    "@commitlint/types": "^21.0.0",
    "@shepherdjerred/eslint-config": "workspace:*",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "^1.3.13",
    "bun-types": "latest",
    "eslint": "^10.3.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "@typescript/native": "npm:typescript@7.0.2"
  }
}
