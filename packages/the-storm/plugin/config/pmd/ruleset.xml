<?xml version="1.0" encoding="UTF-8"?>
<!--
  Curated PMD rules. Error Prone, NullAway and google-java-format already cover
  correctness, nullness and style; PMD only adds the size and complexity limits
  that mirror the repository's ESLint config (packages/eslint-config/src/configs/base.ts):
  cognitive complexity 15, cyclomatic 20, max depth 4, max params 4.
-->
<ruleset name="the-storm"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
  <description>The Storm complexity limits</description>

  <rule ref="category/java/design.xml/CognitiveComplexity">
    <properties>
      <property name="reportLevel" value="15"/>
    </properties>
  </rule>
  <rule ref="category/java/design.xml/CyclomaticComplexity">
    <properties>
      <property name="methodReportLevel" value="20"/>
      <property name="classReportLevel" value="200"/>
    </properties>
  </rule>
  <rule ref="category/java/design.xml/AvoidDeeplyNestedIfStmts">
    <properties>
      <property name="problemDepth" value="4"/>
    </properties>
  </rule>
  <!--
    Paper fixes the signatures of ChunkGenerator and BlockPopulator hooks at five
    parameters, so only those overrides, declared directly in a class that
    extends ChunkGenerator or BlockPopulator, are exempt. Every other method, including overrides
    of our own interfaces, stays within four.
  -->
  <rule ref="category/java/design.xml/ExcessiveParameterList">
    <properties>
      <property name="minimum" value="5"/>
      <property name="violationSuppressXPath"
          value="./ancestor-or-self::MethodDeclaration[pmd-java:hasAnnotation('java.lang.Override')][(@Name=('generateNoise', 'generateSurface', 'generateBedrock', 'generateCaves', 'getBaseHeight', 'generateChunkData') and parent::ClassBody/parent::ClassDeclaration/ExtendsList/ClassType[@SimpleName='ChunkGenerator']) or (@Name='populate' and parent::ClassBody/parent::ClassDeclaration/ExtendsList/ClassType[@SimpleName='BlockPopulator'])]"/>
    </properties>
  </rule>
  <rule ref="category/java/bestpractices.xml/UnusedPrivateField"/>
  <rule ref="category/java/bestpractices.xml/UnusedPrivateMethod"/>
  <rule ref="category/java/bestpractices.xml/UnusedLocalVariable"/>
  <rule ref="category/java/errorprone.xml/EmptyCatchBlock"/>
</ruleset>
