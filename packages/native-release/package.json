{
  "name": "@shepherdjerred/native-release",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared Apple and Windows code-signing helpers for native release lanes",
  "exports": {
    "./apple": "./src/apple.ts",
    "./runner": "./src/runner.ts",
    "./windows": "./src/windows.ts"
  },
  "scripts": {
    "build": "bun --no-install build src/apple.ts src/runner.ts src/windows.ts --outdir dist --target bun",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "lint": "bunx eslint --cache .",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run test",
    "test:ci": "bun ../../scripts/ci/run-ci-test.ts"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shepherdjerred/eslint-config": "workspace:*",
    "@tsconfig/node-lts": "^24.0.0",
    "@tsconfig/recommended": "^1.0.13",
    "@tsconfig/strictest": "^2.0.8",
    "@types/bun": "1.4.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "vitest": "5.1.2"
  }
}
