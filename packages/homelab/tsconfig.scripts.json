{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["bun"],
    // argocd.ts typechecks cdk8s release policy, which imports generated k8s
    // types through the same aliases the cdk8s package uses.
    "paths": {
      "@shepherdjerred/homelab/cdk8s/*": ["./src/cdk8s/*"],
      "@shepherdjerred/homelab/*": ["./*"]
    }
  },
  "include": [
    "scripts/argocd/argocd.ts",
    "scripts/argocd/argocd-apply-safety.ts",
    "scripts/argocd/argocd-apply-safety.test.ts",
    "scripts/argocd/argocd-ignored-differences.ts",
    "scripts/argocd/argocd-ignored-differences.test.ts",
    "scripts/argocd/argocd-auto-sync-policy.ts",
    "scripts/argocd/argocd-auto-sync-policy.test.ts",
    "scripts/argocd/argocd-manifest-overrides.ts",
    "scripts/argocd/argocd-manifest-overrides.test.ts",
    "scripts/argocd/argocd-child-sync-timeout.ts",
    "scripts/argocd/argocd-child-sync-timeout.test.ts",
    "scripts/helm/helm-set-version.ts",
    "scripts/helm/helm-set-version.test.ts",
    "scripts/helm/helm-release-core.ts",
    "scripts/helm/helm-release-core.test.ts",
    "scripts/helm/helm-push.ts",
    "scripts/helm/lint-helm.ts",
    "scripts/helm/lint-helm.test.ts",
    "scripts/tofu/lint-tofu.ts",
    "scripts/check-kubeconform.ts",
    "scripts/migration-core.ts",
    "scripts/migration-smoke.test.ts",
    "scripts/scripts-typecheck.test.ts",
    "scripts/velero-backups.ts",
    "scripts/velero-backups.test.ts",
    "scripts/platform-desired-state.ts",
    "scripts/tofu/tofu-stack-manifest.ts",
    "scripts/tofu/tofu-stack.ts",
    "scripts/tofu/tofu-stack.test.ts"
  ]
}
