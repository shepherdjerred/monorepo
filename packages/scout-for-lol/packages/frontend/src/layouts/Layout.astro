---
import "../styles/global.css";
import MarketingTracking from "#src/components/MarketingTracking.astro";
import SeoHead from "#src/components/SeoHead.astro";

interface Props {
  title: string;
  description: string;
  image?: string | undefined;
  noindex?: boolean | undefined;
}

const { title, description, image, noindex } = Astro.props;
const matomoSiteId =
  typeof import.meta.env["PUBLIC_MATOMO_SITE_ID"] === "string"
    ? import.meta.env["PUBLIC_MATOMO_SITE_ID"]
    : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <SeoHead
      title={title}
      description={description}
      image={image}
      noindex={noindex}
    />
    <script is:inline>
      // Initialize dark mode before page renders to prevent flash
      if (
        localStorage.theme === "dark" ||
        (!("theme" in localStorage) &&
          window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>
    <script
      is:inline
      defer
      src="/matomo-bootstrap.js"
      data-matomo-site-id={matomoSiteId}></script>
    <script>
      import { initSentry } from "../lib/sentry";
      initSentry();
    </script>
    <MarketingTracking />
  </head>
  <body class="text-slate-950 dark:text-white">
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
