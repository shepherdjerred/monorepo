{
  "name": "@shepherdjerred/docs-wiki",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "test": "bun --no-install --bun vitest --config ../../../vitest.config.ts run src",
    "test:ci": "bun ../../../scripts/ci/run-ci-test.ts",
    "test:e2e": "bun --no-install --bun playwright test",
    "lint": "eslint --cache",
    "lint:fix": "eslint --cache --fix",
    "deploy": "bun ../../../scripts/release/deploy-site.ts wiki-sjer-red"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-satteri": "0.4.10",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.43.1",
    "astro": "^7.3.3",
    "astro-mermaid": "^2.1.0",
    "mermaid": "^12.0.0",
    "satteri": "0.11.7",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@shepherdjerred/eslint-config": "workspace:*",
    "@typescript/native": "npm:typescript@7.0.2",
    "@types/bun": "1.4.5",
    "eslint": "^10.7.0",
    "typescript": "^6.0.3",
    "vitest": "5.0.5",
    "@vitest/coverage-istanbul": "5.0.5"
  }
}
