{
  "name": "@shepherdjerred/arcade",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "generate": "bun packages/backend/src/runtime/generate-wire.ts",
    "build": "bun run generate",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "lint": "eslint runtimes eslint.config.ts",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run runtimes",
    "test:ci": "bun ../../scripts/ci/run-ci-test.ts"
  },
  "devDependencies": {
    "@arcade/backend": "workspace:*",
    "@arcade/common": "workspace:*",
    "@shepherdjerred/eslint-config": "workspace:*",
    "@types/bun": "1.4.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "vitest": "5.0.3",
    "zod": "^4.4.3"
  }
}
