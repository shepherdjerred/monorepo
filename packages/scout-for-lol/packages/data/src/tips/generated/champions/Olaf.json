      "tips": [
        {
          "id": "top:Olaf:general:0",
          "text": "Throw Undertow at the enemy, then walk over the axe to pick it up. Grabbing it quickly cuts the cooldown, so you can throw again sooner.",
          "refs": [
            { "kind": "ability", "key": "Olaf-Q", "start": 6, "end": 14 }
          ],
          "pWrong": 0.11
        },
        {
          "id": "top:Olaf:general:1",
          "text": "Throw Undertow from long range when you want to chase or harass. The enemy is slowed for longer the farther the axe flies.",
          "refs": [
            { "kind": "ability", "key": "Olaf-Q", "start": 6, "end": 14 },
            { "kind": "keyword", "key": "slowed", "start": 78, "end": 84 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "top:Olaf:general:2",
          "text": "Keep attacking with basic attacks between casts. Each one shortens the cooldown of Reckless Swing, so you can use it again sooner.",
          "refs": [
            { "kind": "ability", "key": "Olaf-E", "start": 83, "end": 97 }
          ],
          "pWrong": 0
        },
        {
          "id": "top:Olaf:general:3",
          "text": "Use Reckless Swing to finish a low-health enemy. It deals true damage, and if the enemy dies the health cost is refunded.",
          "refs": [
            { "kind": "ability", "key": "Olaf-E", "start": 4, "end": 18 }
          ],
          "pWrong": 0.03
        },
        {
          "id": "top:Olaf:general:4",
          "text": "Cast Tough It Out when a trade starts. It gives attack speed and a shield, and the shield grows the more health you have lost.",
          "refs": [
            { "kind": "ability", "key": "Olaf-W", "start": 5, "end": 17 }
          ],
          "pWrong": 0.27
        },
        {
          "id": "top:Olaf:general:5",
          "text": "Hold Ragnarok until an enemy would stun or slow you. It removes those effects and makes you immune to them for a short time.",
          "refs": [
            { "kind": "ability", "key": "Olaf-R", "start": 5, "end": 13 }
          ],
          "pWrong": 0.5
        },
        {
          "id": "top:Olaf:general:6",
          "text": "Keep hitting enemy champions with attacks and Reckless Swing during Ragnarok to extend it. Chase hard while you are immune.",
          "refs": [
            { "kind": "ability", "key": "Olaf-E", "start": 46, "end": 60 },
            { "kind": "ability", "key": "Olaf-R", "start": 68, "end": 76 }
          ],
          "pWrong": 0.13
        },
        {
          "id": "top:Olaf:general:7",
          "text": "Berserker Rage makes you stronger as your health drops, so a low-health fight is not lost. Still, do not stay low against enemies who can burst you down.",
          "refs": [
            { "kind": "ability", "key": "Olaf-passive", "start": 0, "end": 14 }
          ],
          "pWrong": 0.04
        }
      ],
      "combos": [
        {
          "id": "top:Olaf:combo:0",
          "name": "Axe pickup reset",
          "category": "trick",
          "sequence": [{ "kind": "ability", "key": "Olaf-Q" }],
          "when": "Trading or last-hitting in lane when you want Undertow back up quickly.",
          "whenRefs": [
            { "kind": "ability", "key": "Olaf-Q", "start": 46, "end": 54 }
          ],
          "text": "Throw the axe where you will walk next, then pick it up right after it lands. Picking it up early cuts the cooldown, and an instant pickup refunds it fully.",
          "textRefs": []
        },
        {
