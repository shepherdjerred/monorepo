+
+u8 WasmGetPlayerInputMenuState(u8 battler)
+{
+    if (battler >= MAX_BATTLERS_COUNT)
+        return WASM_BATTLE_MENU_NONE;
+    if (gBattlerControllerFuncs[battler] == HandleInputChooseAction)
+        return WASM_BATTLE_MENU_ACTION;
+    if (gBattlerControllerFuncs[battler] == HandleInputChooseMove)
+        return WASM_BATTLE_MENU_MOVE;
+    if (gBattlerControllerFuncs[battler] == HandleInputChooseTarget)
+        return WASM_BATTLE_MENU_TARGET;
+    if (gBattlerControllerFuncs[battler] == PlayerHandleYesNoInput)
+        return WASM_BATTLE_MENU_YES_NO;
+    if (gBattlerControllerFuncs[battler] == CompleteWhenChoseItem
+     && gMain.callback2 != BattleMainCB2
+     && !gPaletteFade.active)
+        return WASM_BATTLE_MENU_BAG;
+    if (gBattlerControllerFuncs[battler] == WaitForMonSelection
+     && gMain.callback2 != BattleMainCB2
+     && !gPaletteFade.active)
+        return WASM_BATTLE_MENU_PARTY;
+    return WASM_BATTLE_MENU_NONE;
+}
