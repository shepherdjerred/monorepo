      "tips": [
        {
          "id": "jungle:Sejuani:general:0",
          "text": "Use Arctic Assault to chase a runner or escape a bad fight. It has no minimum range, so you can use it even at close range.",
          "refs": [
            { "kind": "ability", "key": "Sejuani-Q", "start": 4, "end": 18 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "jungle:Sejuani:general:1",
          "text": "Aim Arctic Assault at an enemy champion. The charge stops when it hits one, and the enemy is knocked up.",
          "refs": [
            { "kind": "ability", "key": "Sejuani-Q", "start": 4, "end": 18 },
            { "kind": "keyword", "key": "knocked-up", "start": 93, "end": 103 }
          ],
          "pWrong": 0.05
        },
        {
          "id": "jungle:Sejuani:general:2",
          "text": "Melee allies add stacks with their attacks, so watch who they are hitting. Cast Permafrost once the target has four stacks to stun them.",
          "refs": [
            { "kind": "ability", "key": "Sejuani-E", "start": 80, "end": 90 }
          ],
          "pWrong": 0.03
        },
        {
          "id": "jungle:Sejuani:general:3",
          "text": "Land both swings of Winter's Wrath. The second swing does most of the damage and leaves enemies slowed.",
          "refs": [
            { "kind": "ability", "key": "Sejuani-W", "start": 20, "end": 34 },
            { "kind": "keyword", "key": "slowed", "start": 96, "end": 102 }
          ],
          "pWrong": 0.14
        },
        {
          "id": "jungle:Sejuani:general:4",
          "text": "Hit an enemy with Glacial Prison from far away. A longer throw stuns for longer and makes an ice storm that slows nearby enemies.",
          "refs": [
            { "kind": "ability", "key": "Sejuani-R", "start": 18, "end": 32 },
            { "kind": "keyword", "key": "slowed", "start": 108, "end": 113 }
          ],
          "pWrong": 0.29
        },
        {
          "id": "jungle:Sejuani:general:5",
          "text": "Save Glacial Prison for fights where your team is close enough to follow up on the stun.",
          "refs": [
            { "kind": "ability", "key": "Sejuani-R", "start": 5, "end": 19 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "jungle:Sejuani:general:6",
          "text": "Hit a stunned enemy with your next attack or ability. It deals bonus damage based on their maximum health.",
          "refs": [],
          "pWrong": 0.2
        },
        {
          "id": "jungle:Sejuani:general:7",
          "text": "Start fights while Frost Armor is up. It makes you tougher and stops enemy slows from working on you.",
          "refs": [
            { "kind": "keyword", "key": "slowed", "start": 75, "end": 80 }
          ],
          "pWrong": 0.28
        }
      ],
      "combos": [
        {
          "id": "jungle:Sejuani:combo:0",
          "name": "Hidden ult animation",
          "category": "trick",
          "sequence": [
            { "kind": "ability", "key": "Sejuani-R" },
            { "kind": "ability", "key": "Sejuani-Q" }
          ],
          "when": "When you want to throw Glacial Prison without the enemy reading the long cast animation.",
          "whenRefs": [
            { "kind": "ability", "key": "Sejuani-R", "start": 23, "end": 37 }
          ],
          "text": "Cast Glacial Prison, then use Arctic Assault right away to hide the cast animation. Arctic Assault can be cast during other abilities without cancelling them.",
          "textRefs": [
            { "kind": "ability", "key": "Sejuani-R", "start": 5, "end": 19 },
            { "kind": "ability", "key": "Sejuani-Q", "start": 30, "end": 44 },
            { "kind": "ability", "key": "Sejuani-Q", "start": 84, "end": 98 }
          ]
        }
      ]
    }
