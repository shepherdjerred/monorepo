+static u8 GetCollisionInDirectionForObservation(struct ObjectEvent *objectEvent, u8 direction)
+{
+    s16 x = objectEvent->currentCoords.x;
+    s16 y = objectEvent->currentCoords.y;
+
+    MoveCoords(direction, &x, &y);
+    return GetCollisionAtCoords(objectEvent, x, y, direction);
+}
+
+const struct WasmObservationV1 *WasmReadObservation(void)
+{
+    struct ObjectEvent *player;
+    struct WasmBattleParticipant *participant;
+    bool8 controlsLocked = ArePlayerFieldControlsLocked();
+    bool8 scriptActive = ScriptContext_IsEnabled();
+    bool8 paletteFading = gPaletteFade.active != 0;
+    bool8 playerStable = IsPlayerStandingStill();
+    bool8 isOverworld = gMain.callback2 == CB2_Overworld;
+    bool8 observationValid = FALSE;
+    bool8 dialogVisible = IsFieldMessageBoxVisible();
+    bool8 dialogInputReady = dialogVisible
+        && (IsTextPrinterWaitingForInput(0) || WasmIsScriptWaitingForButtonPress());
+    u8 battler;
+
+    sWasmObservation.version = WASM_OBSERVATION_VERSION;
+    sWasmObservation.size = sizeof(sWasmObservation);
+    sWasmObservation.frame = gMain.vblankCounter1;
+    sWasmObservation.phase = WASM_PHASE_OTHER;
+    sWasmObservation.readiness = 0;
+    sWasmObservation.mapGroup = 0;
+    sWasmObservation.mapNum = 0;
+    sWasmObservation.x = 0;
+    sWasmObservation.y = 0;
+    sWasmObservation.facing = DIR_NONE;
+    sWasmObservation.avatarFlags = gPlayerAvatar.flags;
+    sWasmObservation.runningState = gPlayerAvatar.runningState;
+    sWasmObservation.tileTransitionState = gPlayerAvatar.tileTransitionState;
+    sWasmObservation.currentMetatileBehavior = 0;
+    sWasmObservation.collisionNorth = 0;
+    sWasmObservation.collisionSouth = 0;
+    sWasmObservation.collisionWest = 0;
+    sWasmObservation.collisionEast = 0;
+    sWasmObservation.controlsLocked = controlsLocked;
+    sWasmObservation.scriptActive = scriptActive;
+    sWasmObservation.paletteFading = paletteFading;
+    sWasmObservation.inBattle = gMain.inBattle;
+    sWasmObservation.objectEventActive = 0;
+    sWasmObservation.battleMenu = WASM_BATTLE_MENU_NONE;
+    sWasmObservation.battlersCount = gBattlersCount;
+    sWasmObservation.battleTypeFlags = gBattleTypeFlags;
+    sWasmObservation.battleControllerExecFlags = gBattleControllerExecFlags;
+    sWasmObservation.inputBattler = MAX_BATTLERS_COUNT;
+    sWasmObservation.opponentBattler = MAX_BATTLERS_COUNT;
+    sWasmObservation.activeBattler = gActiveBattler;
+    sWasmObservation.actionCursor = 0;
+    sWasmObservation.moveCursor = 0;
+    sWasmObservation.dialogFlags = dialogVisible | (dialogInputReady << 1);
+    for (battler = 0; battler < MAX_BATTLERS_COUNT; battler++)
+    {
+        participant = &sWasmObservation.battlers[battler];
+        participant->battler = battler;
+        participant->side = 0xFF;
+        participant->position = 0xFF;
+        participant->active = FALSE;
+        participant->species = SPECIES_NONE;
+        participant->hp = 0;
+        participant->maxHp = 0;
+        participant->partyIndex = 0;
+        participant->status1 = 0;
+    }
+    sWasmObservation.currentMove = gCurrentMove;
+    sWasmObservation.chosenMove = gChosenMove;
+    sWasmObservation.trailingReserved[0] = 0;
+    sWasmObservation.trailingReserved[1] = 0;
+
+    if (gMain.inBattle)
+        sWasmObservation.phase = WASM_PHASE_BATTLE;
+    else if (isOverworld && (controlsLocked || scriptActive))
+        sWasmObservation.phase = WASM_PHASE_SCRIPTED;
+    else if (isOverworld)
+        sWasmObservation.phase = WASM_PHASE_OVERWORLD;
+
+    if (gMain.inBattle)
+    {
+        for (battler = 0; battler < gBattlersCount && battler < MAX_BATTLERS_COUNT; battler++)
+        {
+            participant = &sWasmObservation.battlers[battler];
+            participant->side = GetBattlerSide(battler);
+            participant->position = gBattlerPositions[battler];
+            participant->active = (gAbsentBattlerFlags & (1u << battler)) == 0;
+            participant->species = gBattleMons[battler].species;
+            participant->hp = gBattleMons[battler].hp;
+            participant->maxHp = gBattleMons[battler].maxHP;
+            participant->partyIndex = gBattlerPartyIndexes[battler];
+            participant->status1 = gBattleMons[battler].status1;
+            if (GetBattlerSide(battler) == B_SIDE_PLAYER && participant->active)
+            {
+                u8 menu = WasmGetPlayerInputMenuState(battler);
+                if (sWasmObservation.inputBattler == MAX_BATTLERS_COUNT
+                 && menu != WASM_BATTLE_MENU_NONE)
+                {
+                    sWasmObservation.inputBattler = battler;
+                    sWasmObservation.battleMenu = menu;
+                }
+            }
+            else if (GetBattlerSide(battler) == B_SIDE_OPPONENT && sWasmObservation.opponentBattler == MAX_BATTLERS_COUNT)
+                sWasmObservation.opponentBattler = battler;
+        }
+        if (sWasmObservation.inputBattler < MAX_BATTLERS_COUNT)
+        {
+            battler = sWasmObservation.inputBattler;
+            sWasmObservation.actionCursor = gActionSelectionCursor[battler];
+            sWasmObservation.moveCursor = gMoveSelectionCursor[battler];
+        }
+    }
+
+    if (isOverworld && gPlayerAvatar.objectEventId < OBJECT_EVENTS_COUNT)
+    {
+        player = &gObjectEvents[gPlayerAvatar.objectEventId];
+        if (player->active && player->isPlayer && gSaveBlock1Ptr != NULL)
+        {
+            observationValid = TRUE;
+            sWasmObservation.mapGroup = gSaveBlock1Ptr->location.mapGroup;
+            sWasmObservation.mapNum = gSaveBlock1Ptr->location.mapNum;
+            sWasmObservation.x = player->currentCoords.x;
+            sWasmObservation.y = player->currentCoords.y;
+            sWasmObservation.facing = player->facingDirection;
+            sWasmObservation.currentMetatileBehavior = player->currentMetatileBehavior;
+            sWasmObservation.collisionNorth = GetCollisionInDirectionForObservation(player, DIR_NORTH);
+            sWasmObservation.collisionSouth = GetCollisionInDirectionForObservation(player, DIR_SOUTH);
+            sWasmObservation.collisionWest = GetCollisionInDirectionForObservation(player, DIR_WEST);
+            sWasmObservation.collisionEast = GetCollisionInDirectionForObservation(player, DIR_EAST);
+            sWasmObservation.objectEventActive = TRUE;
+        }
+    }
+
+    if (observationValid)
+        sWasmObservation.readiness |= WASM_OBSERVATION_VALID;
+    if (playerStable)
+        sWasmObservation.readiness |= WASM_PLAYER_STABLE;
+    if ((observationValid && playerStable && isOverworld && !controlsLocked && !scriptActive && !paletteFading)
+     || dialogInputReady
+     || (gMain.inBattle && sWasmObservation.battleMenu != WASM_BATTLE_MENU_NONE))
+        sWasmObservation.readiness |= WASM_INPUT_READY;
+
+    return &sWasmObservation;
+}
+
+u32 WasmReadMapTile(s32 x, s32 y)
+{
+    if (gMain.callback2 != CB2_Overworld || gMapHeader.mapLayout == NULL || gSaveBlock1Ptr == NULL)
+        return 0;
+
+    return (1u << 31)
+         | (MapGridGetMetatileBehaviorAt(x, y) & 0xFF)
+         | ((u32)MapGridGetCollisionAt(x, y) << 8)
+         | ((u32)MapGridGetElevationAt(x, y) << 16);
+}
+
+const struct WasmMapTopologyV1 *WasmReadMapTopology(void)
+{
+    s32 connectionCount = 0;
+
+    sWasmMapTopology.version = WASM_MAP_TOPOLOGY_VERSION;
+    sWasmMapTopology.size = sizeof(sWasmMapTopology);
+    sWasmMapTopology.frame = gMain.vblankCounter1;
+    sWasmMapTopology.available = FALSE;
+    sWasmMapTopology.mapGroup = 0;
+    sWasmMapTopology.mapNum = 0;
+    sWasmMapTopology.reserved = 0;
+    sWasmMapTopology.width = 0;
+    sWasmMapTopology.height = 0;
+    sWasmMapTopology.warpCount = 0;
+    sWasmMapTopology.connectionCount = 0;
+
+    if (gMain.callback2 != CB2_Overworld
+     || gMapHeader.mapLayout == NULL
+     || gMapHeader.events == NULL
+     || gSaveBlock1Ptr == NULL)
+        return &sWasmMapTopology;
+
+    if (gMapHeader.connections != NULL)
+        connectionCount = gMapHeader.connections->count;
+    if (connectionCount < 0)
+        return &sWasmMapTopology;
+
+    sWasmMapTopology.available = TRUE;
+    sWasmMapTopology.mapGroup = gSaveBlock1Ptr->location.mapGroup;
+    sWasmMapTopology.mapNum = gSaveBlock1Ptr->location.mapNum;
+    sWasmMapTopology.width = gMapHeader.mapLayout->width;
+    sWasmMapTopology.height = gMapHeader.mapLayout->height;
+    sWasmMapTopology.warpCount = gMapHeader.events->warpCount;
+    sWasmMapTopology.connectionCount = connectionCount;
+    return &sWasmMapTopology;
+}
+
+static bool8 GetMapConnectionSpan(
+    const struct MapConnection *connection,
+    s16 *startX,
+    s16 *startY,
+    s16 *endX,
+    s16 *endY)
+{
+    s16 edge;
+    s16 first = 0;
+    s16 last = 0;
+    s16 coordinate;
+    bool8 found = FALSE;
+    bool8 gap = FALSE;
+
+    switch (connection->direction)
+    {
+    case CONNECTION_NORTH:
+    case CONNECTION_SOUTH:
+        for (coordinate = MAP_OFFSET;
+             coordinate < gMapHeader.mapLayout->width + MAP_OFFSET;
+             coordinate++)
+        {
+            s16 triggerY = connection->direction == CONNECTION_NORTH
+                ? MAP_OFFSET - 1
+                : gMapHeader.mapLayout->height + MAP_OFFSET;
+            const struct MapConnection *atPosition =
+                GetMapConnectionAtPos(coordinate, triggerY);
+            if (atPosition == connection)
+            {
+                if (gap)
+                    return FALSE;
+                if (!found)
+                    first = coordinate;
+                found = TRUE;
+                last = coordinate;
+            }
+            else if (found)
+            {
+                gap = TRUE;
+            }
+        }
+        if (!found)
+            return FALSE;
+        edge = connection->direction == CONNECTION_NORTH
+            ? MAP_OFFSET
+            : gMapHeader.mapLayout->height + MAP_OFFSET - 1;
+        *startX = first;
+        *startY = edge;
+        *endX = last;
+        *endY = edge;
+        return TRUE;
+    case CONNECTION_WEST:
+    case CONNECTION_EAST:
+        for (coordinate = MAP_OFFSET;
+             coordinate < gMapHeader.mapLayout->height + MAP_OFFSET;
+             coordinate++)
+        {
+            s16 triggerX = connection->direction == CONNECTION_WEST
+                ? MAP_OFFSET - 1
+                : gMapHeader.mapLayout->width + MAP_OFFSET;
+            const struct MapConnection *atPosition =
+                GetMapConnectionAtPos(triggerX, coordinate);
+            if (atPosition == connection)
+            {
+                if (gap)
+                    return FALSE;
+                if (!found)
+                    first = coordinate;
+                found = TRUE;
+                last = coordinate;
+            }
+            else if (found)
+            {
+                gap = TRUE;
+            }
+        }
+        if (!found)
+            return FALSE;
+        edge = connection->direction == CONNECTION_WEST
+            ? MAP_OFFSET
+            : gMapHeader.mapLayout->width + MAP_OFFSET - 1;
+        *startX = edge;
+        *startY = first;
+        *endX = edge;
+        *endY = last;
+        return TRUE;
+    default:
+        return FALSE;
+    }
+}
+
+const struct WasmMapConnectionV1 *WasmReadMapConnection(u32 index)
+{
+    const struct MapConnection *connection;
+    s16 startX;
+    s16 startY;
+    s16 endX;
+    s16 endY;
+
+    if (!sWasmMapTopology.available
+     || gMapHeader.connections == NULL
+     || index >= sWasmMapTopology.connectionCount)
+        return NULL;
+
+    connection = &gMapHeader.connections->connections[index];
+    sWasmMapConnection.version = WASM_MAP_TOPOLOGY_VERSION;
+    sWasmMapConnection.size = sizeof(sWasmMapConnection);
+    sWasmMapConnection.index = index;
+    sWasmMapConnection.direction = connection->direction;
+    sWasmMapConnection.destinationMapGroup = connection->mapGroup;
+    sWasmMapConnection.destinationMapNum = connection->mapNum;
+    sWasmMapConnection.flags = 0;
+    sWasmMapConnection.offset = connection->offset;
+    sWasmMapConnection.startX = 0;
+    sWasmMapConnection.startY = 0;
+    sWasmMapConnection.endX = 0;
+    sWasmMapConnection.endY = 0;
+    if (GetMapConnectionSpan(
+            connection,
+            &startX,
+            &startY,
+            &endX,
+            &endY))
+    {
+        sWasmMapConnection.startX = startX;
+        sWasmMapConnection.startY = startY;
+        sWasmMapConnection.endX = endX;
+        sWasmMapConnection.endY = endY;
+        sWasmMapConnection.flags |= WASM_MAP_CONNECTION_HAS_SPAN;
+    }
+    return &sWasmMapConnection;
+}
+
+static u8 GetMapWarpActivation(u8 metatileBehavior)
+{
+    if (MetatileBehavior_IsNorthArrowWarp(metatileBehavior))
+        return WASM_MAP_WARP_NORTH;
+    if (MetatileBehavior_IsSouthArrowWarp(metatileBehavior))
+        return WASM_MAP_WARP_SOUTH;
+    if (MetatileBehavior_IsWestArrowWarp(metatileBehavior))
+        return WASM_MAP_WARP_WEST;
+    if (MetatileBehavior_IsEastArrowWarp(metatileBehavior))
+        return WASM_MAP_WARP_EAST;
+    if (MetatileBehavior_IsWarpDoor(metatileBehavior))
+        return WASM_MAP_WARP_NORTH;
+    if (MetatileBehavior_IsLadder(metatileBehavior)
+     || MetatileBehavior_IsEscalator(metatileBehavior)
+     || MetatileBehavior_IsNonAnimDoor(metatileBehavior)
+     || MetatileBehavior_IsLavaridgeB1FWarp(metatileBehavior)
+     || MetatileBehavior_IsLavaridge1FWarp(metatileBehavior)
+     || MetatileBehavior_IsAquaHideoutWarp(metatileBehavior)
+     || MetatileBehavior_IsMtPyreHole(metatileBehavior)
+     || MetatileBehavior_IsMossdeepGymWarp(metatileBehavior)
+     || MetatileBehavior_IsUnionRoomWarp(metatileBehavior))
+        return WASM_MAP_WARP_STEP;
+    return WASM_MAP_WARP_UNSUPPORTED;
+}
+
+const struct WasmMapWarpV1 *WasmReadMapWarp(u32 index)
+{
+    const struct WarpEvent *warp;
+    const struct MapHeader *destinationMap;
+
+    if (!sWasmMapTopology.available
+     || index >= sWasmMapTopology.warpCount)
+        return NULL;
+
+    warp = &gMapHeader.events->warps[index];
+    sWasmMapWarp.version = WASM_MAP_TOPOLOGY_VERSION;
+    sWasmMapWarp.size = sizeof(sWasmMapWarp);
+    sWasmMapWarp.index = index;
+    sWasmMapWarp.x = warp->x + MAP_OFFSET;
+    sWasmMapWarp.y = warp->y + MAP_OFFSET;
+    sWasmMapWarp.elevation = warp->elevation;
+    sWasmMapWarp.metatileBehavior =
+        MapGridGetMetatileBehaviorAt(sWasmMapWarp.x, sWasmMapWarp.y);
+    sWasmMapWarp.activation =
+        GetMapWarpActivation(sWasmMapWarp.metatileBehavior);
+    sWasmMapWarp.destinationMapGroup = warp->mapGroup;
+    sWasmMapWarp.destinationMapNum = warp->mapNum;
+    sWasmMapWarp.destinationWarpId = warp->warpId;
+    sWasmMapWarp.flags = 0;
+    sWasmMapWarp.reserved = 0;
+    sWasmMapWarp.destinationX = 0;
+    sWasmMapWarp.destinationY = 0;
+
+    if (warp->mapGroup == MAP_GROUP(MAP_DYNAMIC)
+     && warp->mapNum == MAP_NUM(MAP_DYNAMIC))
+    {
+        sWasmMapWarp.flags |= WASM_MAP_WARP_DYNAMIC_DESTINATION;
+        return &sWasmMapWarp;
+    }
+
+    destinationMap =
+        Overworld_GetMapHeaderByGroupAndId(warp->mapGroup, warp->mapNum);
+    if (destinationMap != NULL
+     && destinationMap->events != NULL
+     && warp->warpId < destinationMap->events->warpCount)
+    {
+        const struct WarpEvent *destinationWarp =
+            &destinationMap->events->warps[warp->warpId];
+        sWasmMapWarp.destinationX = destinationWarp->x + MAP_OFFSET;
+        sWasmMapWarp.destinationY = destinationWarp->y + MAP_OFFSET;
+        sWasmMapWarp.flags |= WASM_MAP_WARP_DESTINATION_RESOLVED;
+    }
+    return &sWasmMapWarp;
+}
+
+u8 WasmCheckpointSave(void)
+{
+    u8 status;
+
+    if (gMain.callback2 != CB2_Overworld && !gMain.inBattle)
+        return SAVE_STATUS_ERROR;
+    if (gMain.callback2 == CB2_Overworld)
+        SaveMapView();
+    PausePyramidChallenge();
+    if (gDifferentSaveFile)
+    {
+        status = TrySavingData(SAVE_OVERWRITE_DIFFERENT_FILE);
+        if (status == SAVE_STATUS_OK)
+            gDifferentSaveFile = FALSE;
+        return status;
+    }
+    return TrySavingData(SAVE_NORMAL);
+}
