      "inputHash": "9a768dbe564fd7cfdaf1b4f56ba09b53366be9ab8591508ae0bb3076564aa03a",
      "tips": [
        {
          "id": "support:Taric:Nautilus:0",
          "text": "Stay out of Dredge Line's long range when you can. Once Nautilus is close, Dazzle is your answer, so don't waste it early.",
          "refs": [
            { "kind": "ability", "key": "Nautilus-Q", "start": 12, "end": 23 },
            { "kind": "champion", "key": "Nautilus", "start": 56, "end": 64 },
            { "kind": "ability", "key": "Taric-E", "start": 75, "end": 81 }
          ],
          "pWrong": 0.47
        },
        {
          "id": "support:Taric:Nautilus:1",
          "text": "Aim Dazzle at where Nautilus will be, not where he stands. It bursts after a delay, so he can walk out of it unless he is closing in on you.",
          "refs": [
            { "kind": "ability", "key": "Taric-E", "start": 4, "end": 10 },
            { "kind": "champion", "key": "Nautilus", "start": 20, "end": 28 }
          ],
          "pWrong": 0.22
        },
        {
          "id": "support:Taric:Nautilus:2",
          "text": "Do not run the instant Riptide goes off next to you. Wait for the waves to finish, or you run into the later ones and take more damage.",
          "refs": [
            { "kind": "ability", "key": "Nautilus-E", "start": 23, "end": 30 }
          ],
          "pWrong": 0.06
        },
        {
          "id": "support:Taric:Nautilus:3",
          "text": "Cast Cosmic Radiance as soon as a fight is certain. Its delay is long, and Nautilus can lock down one of you in that time.",
          "refs": [
            { "kind": "ability", "key": "Taric-R", "start": 5, "end": 20 },
            { "kind": "champion", "key": "Nautilus", "start": 75, "end": 83 }
          ],
          "pWrong": 0.03
        },
        {
          "id": "support:Taric:Nautilus:4",
          "text": "Put Bastion on your carry before Nautilus engages. It shields them and your tether lets your abilities hit from both of you.",
          "refs": [
            { "kind": "ability", "key": "Taric-W", "start": 4, "end": 11 },
            { "kind": "champion", "key": "Nautilus", "start": 33, "end": 41 }
          ],
          "pWrong": 0.12
        },
        {
          "id": "support:Taric:Nautilus:5",
          "text": "Trade with a spell, then hit him with the two Bravado attacks. This shortens your cooldowns and gives you charges for Starlight's Touch to heal with.",
          "refs": [
            {
              "kind": "ability",
              "key": "Taric-passive",
              "start": 46,
              "end": 53
            },
            { "kind": "ability", "key": "Taric-Q", "start": 118, "end": 135 }
          ],
          "pWrong": 0.15
        }
      ],
      "opponent": "Nautilus",
      "comboRefs": []
    },
    {
