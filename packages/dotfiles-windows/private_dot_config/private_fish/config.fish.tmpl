# MSYS2 fish on Windows. MSYS2_PATH_TYPE=inherit passes the Windows PATH
# through, so native tools (claude, codex, op, mise) resolve directly; PATH
# additions live in conf.d/00-path.fish so they precede plugin conf.d files.
# Public URLs mirror packages/dotfiles/private_dot_config/private_fish/config.fish.tmpl; credentials
# are deliberately not rendered into this file (secrets stay in 1Password).

set -gx SHELL /usr/bin/fish
set -gx EDITOR "subl -w"
set -gx LANG en_US.UTF-8
set -gx CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS "1"

set -gx GRAFANA_URL 'https://grafana.tailnet-1a49.ts.net'
set -gx BUGSINK_URL 'https://bugsink.sjer.red'
set -gx HASS_BASE_URL 'https://homeassistant.sjer.red'
set -gx LOKI_ADDR 'https://loki.tailnet-1a49.ts.net'
set -gx PROMETHEUS_URL 'https://prometheus.tailnet-1a49.ts.net'
set -gx POSTHOG_CLI_PROJECT_ID '549883'

abbr grep rg
abbr gs git-spice
# Coding-agent wrappers, mirroring Invoke-AgentCli in the PowerShell profile
# (agent-exec on macOS): provider API keys and homelab tokens are removed, the
# agent runs with approvals and sandboxing bypassed unless AGENT_SAFE=1, and it
# never waits on an editor or pager. Usage: __agent_exec <name> [bypass...] -- [args...]
set -g __agent_scrubbed {ANTHROPIC,OPENAI,CODEX,GEMINI,GOOGLE,XAI,GROK,MOONSHOT,KIMI,CURSOR,GRAFANA,POSTHOG_CLI}(string join "" _API _KEY) \
  OP_SERVICE_ACCOUNT_TOKEN BUGSINK_TOKEN DISCORD_USER_TOKEN DISCORD_BOT_TOKEN \
  ARGOCD_AUTH_TOKEN WOODPECKER_TOKEN CF_API_TOKEN CLOUDFLARE_API_TOKEN

function __agent_exec
  set -l name $argv[1]
  set -l bypass
  set -l rest
  set -l after 0
  for arg in $argv[2..-1]
    # Arguments are data, never `test` operands: `-c` would read as an operator.
    if test $after = 1
      set -a rest $arg
    else if string match -q -- -- $arg
      set after 1
    else
      set -a bypass $arg
    end
  end
  test "$AGENT_SAFE" = 1; and set bypass
  set -l unset
  for var in $__agent_scrubbed
    set -a unset -u $var
  end
  env $unset EDITOR=true VISUAL=true GIT_EDITOR=true PAGER=cat GIT_PAGER=cat \
    (command -s $name) $bypass $rest
end

# Defined only where the agent is installed. `agent` stays unwrapped: here it is Grok's.
command -q claude; and function claude --wraps claude; __agent_exec claude --dangerously-skip-permissions -- $argv; end
command -q agy; and function agy --wraps agy; __agent_exec agy --dangerously-skip-permissions -- $argv; end
command -q cursor-agent; and function cursor-agent --wraps cursor-agent; __agent_exec cursor-agent --yolo --sandbox disabled -- $argv; end
command -q grok; and function grok --wraps grok; __agent_exec grok --always-approve -- $argv; end
command -q kimi; and function kimi --wraps kimi; __agent_exec kimi --auto -- $argv; end
command -q muse; and function muse --wraps muse; __agent_exec muse --yolo --disable-sandbox -- $argv; end
# Herdr requires --no-daemon, and a running Codex never follows the light/dark
# switch (openai/codex#45163), so each launch picks the matching theme. Neither
# is a bypass flag, so both survive AGENT_SAFE=1.
command -q codex; and function codex --wraps codex
  set -l theme catppuccin-latte
  test (od -An -tu4 /proc/registry/HKEY_CURRENT_USER/Software/Microsoft/Windows/CurrentVersion/Themes/Personalize/AppsUseLightTheme | string trim) = 0
  and set theme catppuccin-mocha
  set -l no_daemon --no-daemon
  contains -- --no-daemon $argv; and set no_daemon
  __agent_exec codex --dangerously-bypass-approvals-and-sandbox -- $no_daemon -c "tui.theme=\"$theme\"" $argv
end

if status is-interactive
  fish_vi_key_bindings
end
