+    return node ? avl_node_data( node ) : NULL;
 }
 
+/******************************************************************************
+ *           RtlDeleteElementGenericTableAvl  (NTDLL.@)
+ */
+BOOLEAN WINAPI RtlDeleteElementGenericTableAvl(PRTL_AVL_TABLE table, void *buffer)
+{
+    RTL_BALANCED_LINKS *parent, *node, *next;
+    RTL_GENERIC_COMPARE_RESULTS result;
+
+    TRACE("(%p, %p)\n", table, buffer);
+
+    if (!(node = avl_find( table, buffer, &parent, &result ))) return FALSE;
+
+    if (!node->LeftChild) avl_replace_child( table, node, node->RightChild );
+    else if (!node->RightChild) avl_replace_child( table, node, node->LeftChild );
+    else
+    {
+        next = avl_leftmost( node->RightChild );
+        if (next->Parent != node)
+        {
+            avl_replace_child( table, next, next->RightChild );
+            next->RightChild = node->RightChild;
+            next->RightChild->Parent = next;
+        }
+        avl_replace_child( table, node, next );
+        next->LeftChild = node->LeftChild;
+        next->LeftChild->Parent = next;
+    }
+
+    table->NumberGenericTableElements--;
+    table->DeleteCount++;
+    table->WhichOrderedElement = 0;
+    table->OrderedPointer = NULL;
+    table->RestartKey = NULL;
+    table->FreeRoutine( table, node );
+    return TRUE;
+}
+
