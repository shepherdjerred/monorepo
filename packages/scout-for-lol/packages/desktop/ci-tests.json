{
  "$schema": "../../../../scripts/ci-tests.schema.json",
  "package": "@scout-for-lol/desktop",
  "steps": [
    {
      "runner": "cargo",
      "args": ["--workspace", "--all-features", "--locked"]
    },
    {
      "name": "cargo-stable-profile",
      "runner": "cargo",
      "args": [
        "--config",
        "env.SCOUT_DESKTOP_PROFILE=\"stable\"",
        "--workspace",
        "--all-features",
        "--locked"
      ]
    },
    {
      "runner": "vitest",
      "args": ["scripts"]
    }
  ]
}
