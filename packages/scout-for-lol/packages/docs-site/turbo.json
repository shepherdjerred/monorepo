{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    /**
     * Renders one sample per ScoutQL RENDER kind, plus the competition
     * leaderboard, using Scout's real report renderer. `build` depends on it so
     * the images in the docs are re-derived from the current renderer on every
     * build and cannot drift; the committed output is just a cache.
     */
    "generate": {
      "dependsOn": ["^build"],
      "outputs": ["src/assets/generated/**"]
    },
    "build": {
      "dependsOn": ["generate", "^build"],
      "outputs": ["dist/**"]
    },
    /**
     * `lint` runs `astro sync`, which starts a vite server and optimizes deps
     * into this package's `node_modules/.vite/deps`. `build` (astro build)
     * optimizes into the same directory, and vite installs the result with an
     * atomic rename. The root `lint` task depends only on `^build`/`generate`,
     * so turbo was free to run both here at once and the losing rename failed
     * with `ENOTEMPTY: ... deps_temp_* -> deps` (build 10781, and the same
     * failure on #2251's build 10671). Ordering after `build` serialises the
     * two vite runs; the build is required by `test`/`test:ci` anyway, so this
     * costs no extra work. Same remedy as the root task's `generate`
     * dependency, added for the identical race in build 5789.
     */
    "lint": {
      "dependsOn": ["build", "^build", "generate"]
    },
    "test": {
      "dependsOn": ["build", "^build", "generate"]
    },
    "test:ci": {
      "dependsOn": ["build", "^build", "generate"]
    }
  }
}
