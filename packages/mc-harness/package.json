{
  "name": "@shepherdjerred/mc-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minecraft agent harness: sandbox servers, the MCBridge client, and the daemon behind `toolkit mc`.",
  "exports": {
    "./protocol/*": "./src/protocol/*",
    "./bridge/*": "./src/bridge/*",
    "./providers/*": "./src/providers/*",
    "./sandbox/*": "./src/sandbox/*",
    "./pins.ts": "./src/pins.ts",
    "./target.ts": "./src/target.ts"
  },
  "imports": {
    "#architecture": "./architecture.config.ts",
    "#protocol/*": "./src/protocol/*",
    "#bridge/*": "./src/bridge/*",
    "#providers/*": "./src/providers/*",
    "#sandbox/*": "./src/sandbox/*",
    "#daemon/*": "./src/daemon/*",
    "#src/*": "./src/*"
  },
  "scripts": {
    "build": "bun build src/daemon/main.ts --target=bun --outdir=dist",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run test",
    "lint": "bunx eslint --cache . && check-architecture",
    "daemon": "bun run src/daemon/main.ts",
    "test:ci": "bun ../../scripts/ci/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../scripts/ci/run-ci-test.ts"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shepherdjerred/architecture": "workspace:*",
    "@shepherdjerred/eslint-config": "workspace:*",
    "@types/bun": "1.4.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "vitest": "5.0.1"
  }
}
