diff --git a/util/converter/rewrite_reuse.go b/util/converter/rewrite_reuse.go
new file mode 100644
index 0000000..ddb0c0d
--- /dev/null
+++ b/util/converter/rewrite_reuse.go
@@ -0,0 +1,167 @@
+package converter
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"strconv"
+	"strings"
+
+	"github.com/containerd/containerd/v2/core/content"
+	"github.com/containerd/containerd/v2/pkg/labels"
+	"github.com/moby/buildkit/util/bklog"
+	"github.com/moby/buildkit/util/compression"
+	digest "github.com/opencontainers/go-digest"
+	ocispecs "github.com/opencontainers/image-spec/specs-go/v1"
+)
+
+// Reuse of timestamp-rewritten layer blobs.
+//
+// Rewriting a layer to SOURCE_DATE_EPOCH is a pure function of the source
+// blob's bytes and the converter configuration, so a rewritten blob produced
+// once can be reused for every later export of the same source blob instead of
+// decompressing, rewriting and recompressing it again.
+//
+// After a conversion commits, the source blob is labelled with a record of
+// the rewritten blob, keyed by a hash of the normalized converter
+// configuration, and with a containerd GC content reference to it. The GC
+// reference keeps the rewritten blob alive exactly as long as the source blob;
+// once the source blob is collectable, so is the rewritten blob.
+//
+// A record is only reused when the referenced blob is present in the content
+// store with the recorded size, uncompressed digest and epoch. Otherwise the
+// layer is converted as before and the record is replaced.
+const (
+	// rewriteReuseVersion is part of every reuse key. Bump it whenever the
+	// rewrite or compression output for a given configuration may change, so
+	// records written by an older converter are never reused.
+	rewriteReuseVersion = "1"
+
+	labelRewriteReusePrefix = "buildkit.io/rewritten-timestamp-reuse."
+	labelGCRefRewritten     = "containerd.io/gc.ref.content.buildkit.rewritten."
+)
+
+type rewriteReuseRecord struct {
+	Digest digest.Digest `json:"digest"`
+	Size   int64         `json:"size"`
+	DiffID digest.Digest `json:"diffID"`
+}
+
+// rewriteReuseKey returns the key that identifies every converter input other
+// than the source blob, and whether results of this conversion may be reused.
+func (c *conversion) rewriteReuseKey() (string, bool) {
+	if c.rewriteTimestamp == nil {
+		return "", false
+	}
+	// An immutable base-image diffID is compared against the source while it is
+	// being converted; keep that path exact by never reusing for such layers.
+	if len(c.immDiffIDs) > 0 {
+		return "", false
+	}
+	// Only compression types whose descriptor carries no finalizer
+	// annotations; estargz and similar formats record per-blob metadata that a
+	// reuse record does not reproduce.
+	switch c.target.Type {
+	case compression.Gzip, compression.Zstd, compression.Uncompressed:
+	default:
+		return "", false
+	}
+	if c.finalize != nil {
+		return "", false
+	}
+	level := "default"
+	if c.target.Level != nil {
+		level = strconv.Itoa(*c.target.Level)
+	}
+	normalized := strings.Join([]string{
+		"version=" + rewriteReuseVersion,
+		"epoch=" + strconv.FormatInt(c.rewriteTimestamp.UTC().UnixNano(), 10),
+		"type=" + c.target.Type.String(),
+		"mediatype=" + c.target.Type.MediaType(),
+		"force=" + strconv.FormatBool(c.target.Force),
+		"level=" + level,
+	}, "\n")
+	return digest.FromString(normalized).Encoded()[:32], true
+}
+
+// lookupRewrittenBlob returns the descriptor of a previously rewritten blob
+// for desc, or false when no verified record exists.
+func (c *conversion) lookupRewrittenBlob(ctx context.Context, cs content.Store, desc ocispecs.Descriptor, key string) (*ocispecs.Descriptor, bool) {
+	info, err := cs.Info(ctx, desc.Digest)
+	if err != nil {
+		return nil, false
+	}
+	raw, ok := info.Labels[labelRewriteReusePrefix+key]
+	if !ok {
+		return nil, false
+	}
+	var rec rewriteReuseRecord
+	if err := json.Unmarshal([]byte(raw), &rec); err != nil || rec.Digest.Validate() != nil || rec.DiffID.Validate() != nil {
+		return nil, false
+	}
+	if info.Labels[labelGCRefRewritten+key] != rec.Digest.String() {
+		return nil, false
+	}
+	target, err := cs.Info(ctx, rec.Digest)
+	if err != nil {
+		return nil, false
+	}
+	epoch := fmt.Sprintf("%d", c.rewriteTimestamp.UTC().Unix())
+	if target.Size != rec.Size ||
+		target.Labels[labels.LabelUncompressed] != rec.DiffID.String() ||
+		target.Labels[labelRewrittenTimestamp] != epoch {
+		return nil, false
+	}
+	newDesc := desc
+	newDesc.MediaType = c.target.Type.MediaType()
+	newDesc.Digest = rec.Digest
+	newDesc.Size = rec.Size
+	newDesc.Annotations = map[string]string{
+		labels.LabelUncompressed: rec.DiffID.String(),
+		labelRewrittenTimestamp:  epoch,
+	}
+	bklog.G(ctx).WithField("blob", desc.Digest).WithField("rewritten", rec.Digest).Debugf("reusing timestamp-rewritten blob")
+	return &newDesc, true
+}
+
+// recordRewrittenBlob labels desc's blob with a record of newDesc and a GC
+// reference to it. Failing to record only means the next export converts the
+// layer again, so errors are logged rather than returned.
+func recordRewrittenBlob(ctx context.Context, cs content.Store, desc ocispecs.Descriptor, key string, newDesc ocispecs.Descriptor) {
+	if newDesc.Digest == desc.Digest {
+		return
+	}
+	rec, err := json.Marshal(rewriteReuseRecord{
+		Digest: newDesc.Digest,
+		Size:   newDesc.Size,
+		DiffID: digest.Digest(newDesc.Annotations[labels.LabelUncompressed]),
+	})
+	if err != nil {
+		return
+	}
+	// A rewritten blob that already existed (for example, pulled back from a
+	// registry) keeps the labels it was ingested with, because the commit
+	// above returns AlreadyExists without applying new labels. Stamp the
+	// labels this conversion just computed so the record verifies next time.
+	if _, err := cs.Update(ctx, content.Info{
+		Digest: newDesc.Digest,
+		Labels: map[string]string{
+			labels.LabelUncompressed: newDesc.Annotations[labels.LabelUncompressed],
+			labelRewrittenTimestamp:  newDesc.Annotations[labelRewrittenTimestamp],
+		},
+	}, "labels."+labels.LabelUncompressed, "labels."+labelRewrittenTimestamp); err != nil {
+		bklog.G(ctx).WithError(err).WithField("blob", newDesc.Digest).Debugf("failed to label timestamp-rewritten blob for reuse")
+		return
+	}
+	recordKey := labelRewriteReusePrefix + key
+	gcKey := labelGCRefRewritten + key
+	if _, err := cs.Update(ctx, content.Info{
+		Digest: desc.Digest,
+		Labels: map[string]string{
+			recordKey: string(rec),
+			gcKey:     newDesc.Digest.String(),
+		},
+	}, "labels."+recordKey, "labels."+gcKey); err != nil {
+		bklog.G(ctx).WithError(err).WithField("blob", desc.Digest).Debugf("failed to record timestamp-rewritten blob for reuse")
+	}
+}
diff --git a/util/converter/rewrite_reuse_test.go b/util/converter/rewrite_reuse_test.go
new file mode 100644
index 0000000..9176964
--- /dev/null
+++ b/util/converter/rewrite_reuse_test.go
@@ -0,0 +1,219 @@
+package converter
+
+import (
+	"archive/tar"
+	"bytes"
+	"compress/gzip"
+	"context"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/containerd/containerd/v2/core/content"
+	"github.com/containerd/containerd/v2/core/metadata"
+	"github.com/containerd/containerd/v2/pkg/namespaces"
+	"github.com/containerd/containerd/v2/plugins/content/local"
+	cerrdefs "github.com/containerd/errdefs"
+	"github.com/moby/buildkit/util/compression"
+	digest "github.com/opencontainers/go-digest"
+	ocispecs "github.com/opencontainers/image-spec/specs-go/v1"
+	"github.com/stretchr/testify/require"
+	bolt "go.etcd.io/bbolt"
+)
+
+const labelGCRoot = "containerd.io/gc.root"
+
+type countingStore struct {
+	content.Store
+	writers int
+}
+
+func (s *countingStore) Writer(ctx context.Context, opts ...content.WriterOpt) (content.Writer, error) {
+	s.writers++
+	return s.Store.Writer(ctx, opts...)
+}
+
+func newReuseTestStore(t *testing.T) (context.Context, *countingStore, *metadata.DB) {
+	t.Helper()
+	dir := t.TempDir()
+	store, err := local.NewStore(filepath.Join(dir, "content"))
+	require.NoError(t, err)
+	db, err := bolt.Open(filepath.Join(dir, "meta.db"), 0o644, nil)
+	require.NoError(t, err)
+	t.Cleanup(func() { db.Close() })
+	mdb := metadata.NewDB(db, store, nil)
+	ctx := namespaces.WithNamespace(t.Context(), "buildkit")
+	require.NoError(t, mdb.Init(ctx))
+	return ctx, &countingStore{Store: mdb.ContentStore()}, mdb
+}
+
+// writeSourceLayer stores a gzip layer whose entries carry a timestamp newer
+// than the epoch, so the rewrite changes its bytes.
+func writeSourceLayer(ctx context.Context, t *testing.T, cs content.Store, modTime time.Time) ocispecs.Descriptor {
+	t.Helper()
+	var tarBuf bytes.Buffer
+	tw := tar.NewWriter(&tarBuf)
+	for _, name := range []string{"app/", "app/a.txt", "app/b.txt"} {
+		hdr := &tar.Header{Name: name, ModTime: modTime, Mode: 0o644, Typeflag: tar.TypeReg, Size: int64(len(name))}
+		if name[len(name)-1] == '/' {
+			hdr.Typeflag, hdr.Mode, hdr.Size = tar.TypeDir, 0o755, 0
+		}
+		require.NoError(t, tw.WriteHeader(hdr))
+		if hdr.Size > 0 {
+			_, err := tw.Write([]byte(name))
+			require.NoError(t, err)
+		}
+	}
+	require.NoError(t, tw.Close())
+	var gzBuf bytes.Buffer
+	gw := gzip.NewWriter(&gzBuf)
+	_, err := gw.Write(tarBuf.Bytes())
+	require.NoError(t, err)
+	require.NoError(t, gw.Close())
+	desc := ocispecs.Descriptor{
+		MediaType: ocispecs.MediaTypeImageLayerGzip,
+		Digest:    digest.FromBytes(gzBuf.Bytes()),
+		Size:      int64(gzBuf.Len()),
+	}
+	require.NoError(t, content.WriteBlob(ctx, cs, "source", bytes.NewReader(gzBuf.Bytes()), desc,
+		content.WithLabels(map[string]string{
+			"containerd.io/uncompressed": digest.FromBytes(tarBuf.Bytes()).String(),
+			labelGCRoot:                  "source",
+		})))
+	return desc
+}
+
+func rewrite(ctx context.Context, t *testing.T, cs content.Store, desc ocispecs.Descriptor, comp compression.Config, epoch time.Time) ocispecs.Descriptor {
+	t.Helper()
+	fn, err := NewWithRewriteTimestamp(ctx, cs, desc, comp, &epoch, nil)
+	require.NoError(t, err)
+	require.NotNil(t, fn)
+	out, err := fn(ctx, cs, desc)
+	require.NoError(t, err)
+	require.NotNil(t, out)
+	return *out
+}
+
+func TestRewriteTimestampReusesRecordedBlob(t *testing.T) {
+	ctx, cs, _ := newReuseTestStore(t)
+	epoch := time.Unix(1767225600, 0)
+	src := writeSourceLayer(ctx, t, cs, epoch.Add(24*time.Hour))
+	comp := compression.New(compression.Gzip)
+
+	cs.writers = 0
+	first := rewrite(ctx, t, cs, src, comp, epoch)
+	require.NotEqual(t, src.Digest, first.Digest)
+	require.Equal(t, 1, cs.writers, "the first export converts the layer")
+
+	cs.writers = 0
+	second := rewrite(ctx, t, cs, src, comp, epoch)
+	require.Equal(t, 0, cs.writers, "a recorded, present blob is reused without writing")
+	require.Equal(t, first, second, "the reused descriptor is identical to the converted one")
+}
+
+func TestRewriteTimestampReuseIsKeyedOnConverterConfig(t *testing.T) {
+	ctx, cs, _ := newReuseTestStore(t)
+	epoch := time.Unix(1767225600, 0)
+	src := writeSourceLayer(ctx, t, cs, epoch.Add(24*time.Hour))
+	gz := compression.New(compression.Gzip)
+	rewrite(ctx, t, cs, src, gz, epoch)
+
+	for name, tc := range map[string]struct {
+		comp  compression.Config
+		epoch time.Time
+	}{
+		"level":       {gz.SetLevel(9), epoch},
+		"force":       {gz.SetForce(true), epoch},
+		"compression": {compression.New(compression.Zstd), epoch},
+		"epoch":       {gz, epoch.Add(time.Hour)},
+	} {
+		t.Run(name, func(t *testing.T) {
+			cs.writers = 0
+			rewrite(ctx, t, cs, src, tc.comp, tc.epoch)
+			require.Equal(t, 1, cs.writers, "a different converter input must convert again")
+		})
+	}
+}
+
+func TestRewriteTimestampConvertsWhenRecordDoesNotVerify(t *testing.T) {
+	epoch := time.Unix(1767225600, 0)
+	comp := compression.New(compression.Gzip)
+	key := func(t *testing.T) string {
+		k, ok := (&conversion{target: comp, rewriteTimestamp: &epoch}).rewriteReuseKey()
+		require.True(t, ok)
+		return k
+	}
+
+	t.Run("rewritten blob missing", func(t *testing.T) {
+		ctx, cs, _ := newReuseTestStore(t)
+		src := writeSourceLayer(ctx, t, cs, epoch.Add(time.Hour))
+		first := rewrite(ctx, t, cs, src, comp, epoch)
+		require.NoError(t, cs.Delete(ctx, first.Digest))
+		cs.writers = 0
+		again := rewrite(ctx, t, cs, src, comp, epoch)
+		require.Equal(t, 1, cs.writers)
+		require.Equal(t, first, again, "conversion is deterministic")
+	})
+
+	t.Run("recorded size does not match", func(t *testing.T) {
+		ctx, cs, _ := newReuseTestStore(t)
+		src := writeSourceLayer(ctx, t, cs, epoch.Add(time.Hour))
+		first := rewrite(ctx, t, cs, src, comp, epoch)
+		k := labelRewriteReusePrefix + key(t)
+		_, err := cs.Update(ctx, content.Info{Digest: src.Digest, Labels: map[string]string{
+			k: `{"digest":"` + first.Digest.String() + `","size":1,"diffID":"` + first.Annotations["containerd.io/uncompressed"] + `"}`,
+		}}, "labels."+k)
+		require.NoError(t, err)
+		cs.writers = 0
+		rewrite(ctx, t, cs, src, comp, epoch)
+		require.Equal(t, 1, cs.writers)
+	})
+
+	t.Run("record without its GC reference", func(t *testing.T) {
+		ctx, cs, _ := newReuseTestStore(t)
+		src := writeSourceLayer(ctx, t, cs, epoch.Add(time.Hour))
+		rewrite(ctx, t, cs, src, comp, epoch)
+		gcKey := labelGCRefRewritten + key(t)
+		_, err := cs.Update(ctx, content.Info{Digest: src.Digest, Labels: map[string]string{gcKey: ""}}, "labels."+gcKey)
+		require.NoError(t, err)
+		cs.writers = 0
+		rewrite(ctx, t, cs, src, comp, epoch)
+		require.Equal(t, 1, cs.writers)
+	})
+}
+
+func TestRewriteTimestampNeverReusesForImmutableBaseLayers(t *testing.T) {
+	epoch := time.Unix(1767225600, 0)
+	imm := map[digest.Digest]struct{}{digest.FromString("base"): {}}
+	_, ok := (&conversion{target: compression.New(compression.Gzip), rewriteTimestamp: &epoch, immDiffIDs: imm}).rewriteReuseKey()
+	require.False(t, ok)
+	_, ok = (&conversion{target: compression.New(compression.EStargz), rewriteTimestamp: &epoch}).rewriteReuseKey()
+	require.False(t, ok, "formats with finalizer annotations are not reused")
+	_, ok = (&conversion{target: compression.New(compression.Gzip)}).rewriteReuseKey()
+	require.False(t, ok, "plain recompression is unchanged")
+}
+
+// The GC reference on the source blob keeps the rewritten blob alive while the
+// source is referenced, and both become collectable together.
+func TestRewrittenBlobLifetimeFollowsSourceBlob(t *testing.T) {
+	ctx, cs, mdb := newReuseTestStore(t)
+	epoch := time.Unix(1767225600, 0)
+	src := writeSourceLayer(ctx, t, cs, epoch.Add(time.Hour))
+	rewritten := rewrite(ctx, t, cs, src, compression.New(compression.Gzip), epoch)
+
+	_, err := mdb.GarbageCollect(ctx)
+	require.NoError(t, err)
+	_, err = cs.Info(ctx, src.Digest)
+	require.NoError(t, err, "the rooted source blob survives GC")
+	_, err = cs.Info(ctx, rewritten.Digest)
+	require.NoError(t, err, "the rewritten blob is kept alive by the source's GC reference")
+
+	_, err = cs.Update(ctx, content.Info{Digest: src.Digest, Labels: map[string]string{labelGCRoot: ""}}, "labels."+labelGCRoot)
+	require.NoError(t, err)
+	_, err = mdb.GarbageCollect(ctx)
+	require.NoError(t, err)
+	_, err = cs.Info(ctx, src.Digest)
+	require.True(t, cerrdefs.IsNotFound(err), "the unreferenced source blob is collected")
+	_, err = cs.Info(ctx, rewritten.Digest)
+	require.True(t, cerrdefs.IsNotFound(err), "the rewritten blob is collected with its source")
+}
