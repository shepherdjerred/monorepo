      "tips": [
        {
          "id": "support:Yuumi:general:0",
          "text": "Attach to your lane partner with You and Me! when enemies threaten you; while attached you can't be targeted except by towers.",
          "refs": [
            { "kind": "ability", "key": "Yuumi-W", "start": 33, "end": 44 }
          ],
          "pWrong": 0.23
        },
        {
          "id": "support:Yuumi:general:1",
          "text": "Cast Prowling Projectile while attached and steer it around with your mouse. It speeds up after a moment and slows the enemy more.",
          "refs": [
            { "kind": "ability", "key": "Yuumi-Q", "start": 5, "end": 24 },
            { "kind": "keyword", "key": "slowed", "start": 109, "end": 114 }
          ],
          "pWrong": 0.06
        },
        {
          "id": "support:Yuumi:general:2",
          "text": "Stay attached to the ally who kills the most. Kills and minions build your bond, and your Best Friend makes your abilities stronger.",
          "refs": [],
          "pWrong": 0.33
        },
        {
          "id": "support:Yuumi:general:3",
          "text": "Use Zoomies while attached to shield your partner and give them Move Speed and Attack Speed. It also refills their mana.",
          "refs": [
            { "kind": "ability", "key": "Yuumi-E", "start": 4, "end": 11 }
          ],
          "pWrong": 1
        },
        {
          "id": "support:Yuumi:general:4",
          "text": "Start Final Chapter while attached so you can steer the waves. Aim them at enemies and across your allies to heal them.",
          "refs": [
            { "kind": "ability", "key": "Yuumi-R", "start": 6, "end": 19 }
          ],
          "pWrong": 0.22
        },
        {
          "id": "support:Yuumi:general:5",
          "text": "Watch for stuns and knock-ups when you dash with You and Me!. Being stopped mid-dash puts it on a long cooldown and leaves you exposed.",
          "refs": [
            { "kind": "ability", "key": "Yuumi-W", "start": 49, "end": 60 }
          ],
          "pWrong": 0.18
        },
        {
          "id": "support:Yuumi:general:6",
          "text": "Hit an enemy champion with Prowling Projectile when you are hurt. Feline Friendship heals you and the ally you are attached to.",
          "refs": [
            { "kind": "ability", "key": "Yuumi-Q", "start": 27, "end": 46 },
            {
              "kind": "ability",
              "key": "Yuumi-passive",
              "start": 66,
              "end": 83
            }
          ],
          "pWrong": 0.95
        }
      ],
      "combos": [
        {
          "id": "support:Yuumi:combo:0",
          "name": "Steered Q",
          "category": "trick",
          "sequence": [{ "kind": "ability", "key": "Yuumi-Q" }],
          "when": "When enemies stand behind minions or are dodging in lane while you are attached.",
          "whenRefs": [],
          "text": "Cast the missile while attached and guide it with your mouse around minions and toward the enemy champion. It then accelerates for the stronger slow and damage.",
          "textRefs": []
        }
      ]
    }
