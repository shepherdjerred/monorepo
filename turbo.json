{
  "$schema": "https://turborepo.dev/schema.json",
  // Root-level files whose change must invalidate every task hash.
  // (Root package.json, turbo.json, and bun.lock are always hashed by turbo.)
  "globalDependencies": [
    ".mise.toml",
    "bunfig.toml",
    "patches/**",
    "scripts/ci-reporting.ts",
    "scripts/coverage-cobertura.ts",
    "scripts/ci-test-manifest.json",
    "scripts/run-ci-test.ts"
  ],
  // The toolkit / tasknotes-server `bun --compile` binaries are ~180 MB
  // (64 MB zstd) — over the default upload timeout, so those tasks
  // remote-MISSED every build ("cache artifact ... too large to upload
  // within the timeout").
  "remoteCache": { "uploadTimeout": 300 },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    // Local codegen only (Prisma: birmel, scout backend, dpmk backend).
    // Live-credential codegen lives in generate:live and is NEVER in a
    // default chain (temporal → live Home Assistant, helm-types → chart repos).
    "generate": {
      "outputs": ["generated/**"]
    },
    "generate:live": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "generate"],
      "env": ["NODE_ENV"]
    },
    // CI uses the same cache semantics as `test`, but packages emit JUnit on
    // cache misses. Reports are deliberately not outputs: a cache hit must not
    // restore a stale report from another build.
    "test:ci": {
      "env": ["NODE_ENV"],
      "passThroughEnv": ["MISE_DATA_DIR"],
      "dependsOn": ["^build", "generate"]
    },
    // The scheduled reporting pipeline must execute every test and produce a
    // complete fresh coverage set, so this task intentionally bypasses Turbo.
    "test:report": {
      "cache": false,
      "env": ["NODE_ENV"],
      "passThroughEnv": ["MISE_DATA_DIR"],
      "dependsOn": ["generate", "^build"]
    },
    "lint": {
      // "generate" for the same reason typecheck/test have it: type-aware
      // ESLint builds a TS program, and packages with codegen (Prisma
      // clients) lint against error-types when generate hasn't run yet —
      // build 5789: scout backend, 3863 CI-only no-unsafe-assignment errors
      // from lint racing generate on a cold cache (clean locally where
      // generate had already run).
      "dependsOn": ["^build", "generate"]
    },
    // Browser-driven e2e (Playwright). Not in the default `test` chain and
    // never cached: needs installed browsers and exercises a live dev server.
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    // Container image build (docker buildx --load, tag <name>:dev). BuildKit's
    // layer cache is the cache layer here, not turbo — a turbo "hit" that skips
    // the docker invocation could mask a broken Dockerfile.
    "docker:build": {
      "cache": false
    },
    // Boots the freshly-built :dev image and asserts on startup behavior
    // (health endpoint or expected clean auth-failure) — old CI's smoke tests.
    "smoke": {
      "dependsOn": ["docker:build"],
      "cache": false
    },
    // ─── Root repo-wide checks (run via `bun run verify` or `turbo run <name>`).
    // Inputs are scoped so each check only re-runs when files it actually
    // reads change. Explicit input globs hash gitignored files too, so the
    // big generated dirs are negated wherever a broad glob is needed.
    "//#check-suppressions": {
      "inputs": ["scripts/**", "!scripts/node_modules/**"]
    },
    "//#check-agent-guidance": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "AGENTS.md",
        "CLAUDE.md",
        ".agents/**",
        ".claude/skills",
        ".cursor/**",
        ".opencode/**",
        "packages/**/AGENTS.md",
        "packages/**/CLAUDE.md",
        "packages/**/.agents/**",
        "packages/**/.cursor/**",
        "packages/**/.opencode/**",
        "packages/**/skills/**",
        "packages/dotfiles/dot_agents/skills/**",
        "packages/dotfiles/dot_claude/**",
        "packages/dotfiles/dot_gemini/**",
        "packages/dotfiles/private_dot_codex/**",
        "packages/dotfiles/private_dot_cursor/**",
        "sandbox/**/AGENTS.md",
        "sandbox/**/CLAUDE.md",
        "scripts/check-agent-guidance.ts",
        "scripts/check-agent-guidance.test.ts",
        "scripts/lib/agent-guidance-files.ts",
        "!**/node_modules/**"
      ]
    },
    "//#check-test-standardization": {
      "inputs": [
        "package.json",
        "packages/**",
        "scripts/**",
        ".buildkite/**",
        "!**/node_modules/**",
        "!**/dist/**",
        "!packages/dotfiles/dot_agents/skills/**"
      ]
    },
    "//#check-ai-architecture": {
      "inputs": [
        "package.json",
        ".buildkite/**",
        "packages/**",
        "scripts/**",
        "!**/node_modules/**",
        "!**/dist/**",
        "!packages/docs/**",
        "!packages/dotfiles/dot_agents/skills/**"
      ]
    },
    // Dependency specs must be lockfile-pinnable: a dist-tag re-resolves on
    // every install, so the registry moving `latest` breaks --frozen-lockfile
    // on main with no commit to blame.
    "//#check-floating-deps": {
      "inputs": [
        "package.json",
        "packages/**/package.json",
        "scripts/package.json",
        "!**/node_modules/**",
        "scripts/check-floating-deps.ts"
      ]
    },
    "//#check-patched-deps": {
      "inputs": [
        "package.json",
        "bun.lock",
        "patches/**",
        "packages/**/patches/*.patch",
        "scripts/check-patched-deps.ts",
        ".buildkite/scripts/select-image-targets.ts"
      ]
    },
    // Every env var a pipeline step's scripts require must be provided by that
    // step. Reads the committed vault snapshot (hashes only), never 1Password.
    "//#check-worker-image-pins": {
      // Offline only. The networked proof against the registry runs as its own
      // pipeline step; `verify` never touches the network.
      "inputs": [
        "packages/version-catalog/src/catalog.json",
        "scripts/pin-candidates-state.json",
        "scripts/verify-worker-image-build-ids.ts"
      ]
    },
    "//#check-ci-env": {
      // Every tree requiredEnvFrom may analyze has to be hashed, not just the
      // pipeline: the checker treats literal `.buildkite/scripts/*.ts`
      // commands as entry points and follows their imports, so a requireEnv
      // added there would otherwise reuse a green cached result.
      "inputs": [
        ".buildkite/pipeline.yml",
        ".buildkite/scripts/**",
        "scripts/**",
        "!scripts/node_modules/**",
        "packages/homelab/scripts/**",
        "packages/homelab/src/cdk8s/onepassword-vault-snapshot.json",
        "packages/homelab/src/cdk8s/src/resources/argo-applications/buildkite.ts"
      ]
    },
    "//#check-script-migrations": {
      "inputs": [
        "scripts/script-migrations.json",
        "scripts/script-migrations.schema.json",
        "scripts/check-script-migrations.ts",
        "scripts/**/*.ts",
        ".buildkite/scripts/**",
        "**/*.sh",
        "packages/**/*.ts",
        "packages/**/package.json",
        "packages/**/tsconfig*.json",
        "packages/**/eslint.config.ts",
        "!**/node_modules/**",
        "!sandbox/**",
        "!**/dist/**",
        "!**/generated/**"
      ]
    },
    "//#script-coverage": {
      "dependsOn": ["//#check-script-migrations"],
      "cache": false,
      "inputs": [
        "scripts/bunfig.coverage.toml",
        "scripts/check-script-coverage.ts",
        "scripts/migration-core.ts",
        "scripts/**/*.test.ts",
        ".buildkite/scripts/**/*.ts",
        "packages/discord-plays-mario-kart/scripts/**/*.ts",
        "packages/discord-plays-pokemon/scripts/**/*.ts",
        "packages/dotfiles/bin/executable_git_cleanup.ts",
        "packages/dotfiles/scripts/**/*.ts",
        "packages/homelab/scripts/**/*.ts",
        "packages/llm-observability/test/e2e/**/*.ts",
        "packages/scout-for-lol/scripts/**/*.ts",
        "packages/tasks-for-obsidian/scripts/**/*.ts",
        "packages/toolkit/scripts/**/*.ts",
        "packages/{discord-plays-mario-kart,discord-plays-pokemon,dotfiles,homelab,llm-observability,scout-for-lol,tasks-for-obsidian,toolkit}/package.json"
      ]
    },
    "//#markdownlint": {
      "inputs": ["**/*.md", ".markdownlint*", "!**/node_modules/**"]
    },
    "//#prettier-scout": {
      "inputs": [
        ".prettierrc.json",
        ".prettierignore",
        "scripts/repo-shards.ts",
        "scripts/run-shard-check.ts",
        "scripts/lib/run.ts",
        "packages/scout-for-lol/**",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/dist/**",
        "!**/build/**",
        "!**/target/**",
        "!**/generated/**",
        "!**/.venv/**"
      ]
    },
    "//#prettier-homelab": {
      "inputs": [
        ".prettierrc.json",
        ".prettierignore",
        "scripts/repo-shards.ts",
        "scripts/run-shard-check.ts",
        "scripts/lib/run.ts",
        "packages/homelab/**",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/dist/**",
        "!**/build/**",
        "!**/target/**",
        "!**/generated/**",
        "!**/.venv/**"
      ]
    },
    "//#prettier-packages": {
      "inputs": [
        ".prettierrc.json",
        ".prettierignore",
        "scripts/repo-shards.ts",
        "scripts/run-shard-check.ts",
        "scripts/lib/run.ts",
        "packages/**",
        "!packages/scout-for-lol/**",
        "!packages/homelab/**",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/dist/**",
        "!**/build/**",
        "!**/target/**",
        "!**/generated/**",
        "!**/.venv/**"
      ]
    },
    "//#prettier-root": {
      "inputs": [
        ".prettierrc.json",
        ".prettierignore",
        "scripts/repo-shards.ts",
        "scripts/run-shard-check.ts",
        "scripts/lib/run.ts",
        "**/*",
        "!packages/**",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/dist/**",
        "!**/build/**",
        "!**/target/**",
        "!**/generated/**",
        "!**/.venv/**"
      ]
    },
    "//#shellcheck": {
      "inputs": ["**/*.sh", "!**/node_modules/**", "scripts/shellcheck.ts"]
    },
    "//#hadolint": {
      "inputs": [
        "**/Dockerfile",
        "**/Dockerfile.*",
        "**/*.Dockerfile",
        "!**/node_modules/**",
        ".hadolint.yaml",
        "scripts/hadolint.ts"
      ]
    },
    "//#knip": {
      // Knip resolves `#generated/prisma/...` imports, so the Prisma clients
      // must exist before it runs. Inside the verify graph these generate
      // tasks are otherwise unordered against //#knip, and on a cold CI
      // checkout knip won the race and reported 61 unresolved imports
      // (build 11163). Declaring the dependency lets turbo order and dedupe
      // them; a nested `turbo run generate` inside the gate would instead
      // race the outer graph for each package's Prisma generate lock.
      "dependsOn": [
        "@shepherdjerred/alert-dashboard#generate",
        "@shepherdjerred/birmel#generate",
        "@discord-plays-mario-kart/backend#generate",
        "@scout-for-lol/backend#generate",
        "starlight-karma-bot#generate"
      ],
      "inputs": [
        "knip.json",
        "scripts/knip.ts",
        // Must cover every extension knip.json's entry/project globs analyze,
        // or turbo replays a stale green result when only e.g. a .css or .mdx
        // file changed. Kept in sync with the extensions listed in knip.json.
        "**/*.{ts,tsx,cts,mts,js,jsx,cjs,mjs,astro,css,sass,scss,mdx,prisma,html}",
        "**/package.json",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/generated/**"
      ]
    },
    "//#gitleaks": {
      "inputs": [
        "**/*",
        ".gitleaks.toml",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/dist/**",
        "!**/build/**",
        "!**/target/**",
        "!**/.venv/**"
      ]
    },
    "//#jscpd": {
      "inputs": [
        ".jscpd.json",
        ".jscpd-baseline.json",
        "scripts/jscpd-check.ts",
        "packages/**/*.{ts,tsx}",
        "scripts/**/*.ts",
        "!**/node_modules/**",
        "!**/generated/**",
        "!**/dist/**"
      ]
    },
    "//#quality-ratchet": {
      "inputs": [
        ".quality-baseline.json",
        "scripts/quality-ratchet.ts",
        "**/*.{ts,tsx,rs}",
        "!**/node_modules/**",
        "!**/generated/**",
        "!**/dist/**",
        "!**/target/**"
      ]
    },
    "//#compliance-check": {
      "inputs": [
        "package.json",
        "scripts/compliance-check.ts",
        "scripts/package.json",
        "packages/**/package.json",
        "!packages/**/node_modules/**",
        "packages/*/eslint.config.*",
        "packages/*/tsconfig.json"
      ]
    },
    "//#lockfile-check": {
      "inputs": [
        "bun.lock",
        "package.json",
        "packages/**/package.json",
        "scripts/package.json",
        "!**/node_modules/**"
      ]
    },
    "//#merge-conflicts": {
      "inputs": [
        ".conflictignore",
        "scripts/check-merge-conflicts.ts",
        "**/*.{ts,tsx,rs,json,yaml,yml,md,sh,astro,toml}",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/generated/**",
        "!**/target/**"
      ]
    },
    "//#env-var-names": {
      "inputs": [
        "scripts/check-env-var-names.ts",
        "**/*.{ts,rs,py,fish,tmpl,yaml,yml,env,md,sh,swift}",
        "!**/node_modules/**",
        "!**/generated/**"
      ]
    },
    "//#line-endings-scout": {
      "inputs": [
        ".gitattributes",
        "scripts/check-line-endings.ts",
        "scripts/repo-shards.ts",
        "scripts/run-shard-check.ts",
        "scripts/lib/run.ts",
        "packages/scout-for-lol/**",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/dist/**",
        "!**/build/**",
        "!**/target/**",
        "!**/.venv/**"
      ]
    },
    "//#line-endings-homelab": {
      "inputs": [
        ".gitattributes",
        "scripts/check-line-endings.ts",
        "scripts/repo-shards.ts",
        "scripts/run-shard-check.ts",
        "scripts/lib/run.ts",
        "packages/homelab/**",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/dist/**",
        "!**/build/**",
        "!**/target/**",
        "!**/.venv/**"
      ]
    },
    "//#line-endings-packages": {
      "inputs": [
        ".gitattributes",
        "scripts/check-line-endings.ts",
        "scripts/repo-shards.ts",
        "scripts/run-shard-check.ts",
        "scripts/lib/run.ts",
        "packages/**",
        "!packages/scout-for-lol/**",
        "!packages/homelab/**",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/dist/**",
        "!**/build/**",
        "!**/target/**",
        "!**/.venv/**"
      ]
    },
    "//#line-endings-root": {
      "inputs": [
        ".gitattributes",
        "scripts/check-line-endings.ts",
        "scripts/repo-shards.ts",
        "scripts/run-shard-check.ts",
        "scripts/lib/run.ts",
        "**/*",
        "!packages/**",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/dist/**",
        "!**/build/**",
        "!**/target/**",
        "!**/.venv/**"
      ]
    },
    "//#react-version-sync": {
      "inputs": [
        "scripts/check-react-version-sync.ts",
        "**/package.json",
        "bun.lock",
        "!**/node_modules/**"
      ]
    },
    "//#large-files-scout": {
      "inputs": [
        ".largeignore",
        "scripts/check-large-files.ts",
        "scripts/repo-shards.ts",
        "scripts/run-shard-check.ts",
        "scripts/lib/run.ts",
        "packages/scout-for-lol/**",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/dist/**",
        "!**/build/**",
        "!**/target/**",
        "!**/.venv/**"
      ]
    },
    "//#large-files-homelab": {
      "inputs": [
        ".largeignore",
        "scripts/check-large-files.ts",
        "scripts/repo-shards.ts",
        "scripts/run-shard-check.ts",
        "scripts/lib/run.ts",
        "packages/homelab/**",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/dist/**",
        "!**/build/**",
        "!**/target/**",
        "!**/.venv/**"
      ]
    },
    "//#large-files-packages": {
      "inputs": [
        ".largeignore",
        "scripts/check-large-files.ts",
        "scripts/repo-shards.ts",
        "scripts/run-shard-check.ts",
        "scripts/lib/run.ts",
        "packages/**",
        "!packages/scout-for-lol/**",
        "!packages/homelab/**",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/dist/**",
        "!**/build/**",
        "!**/target/**",
        "!**/.venv/**"
      ]
    },
    "//#large-files-root": {
      "inputs": [
        ".largeignore",
        "scripts/check-large-files.ts",
        "scripts/repo-shards.ts",
        "scripts/run-shard-check.ts",
        "scripts/lib/run.ts",
        "**/*",
        "!packages/**",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/dist/**",
        "!**/build/**",
        "!**/target/**",
        "!**/.venv/**"
      ]
    },
    "//#scout-asset-sizes": {
      "inputs": [
        "packages/scout-for-lol/scripts/check-asset-sizes.ts",
        "packages/scout-for-lol/assets/**",
        "packages/scout-for-lol/packages/data/src/data-dragon/assets/img/champion-loading/**",
        "packages/scout-for-lol/packages/data/src/data-dragon/assets/img/champion-splash/**"
      ]
    },
    "//#guard:migration": {
      "inputs": [
        "scripts/guard-no-package-exclusions.ts",
        "package.json",
        "turbo.json"
      ]
    },
    "//#ruff": {
      "inputs": ["ruff.toml", "**/*.py", "!**/node_modules/**", "!**/.venv/**"]
    },
    "//#pyright": {
      "inputs": [
        "pyrightconfig.json",
        "scripts/pyright-check.ts",
        "scripts/python-dev-requirements.txt",
        "**/*.py",
        "!**/node_modules/**",
        "!**/.venv/**"
      ]
    },
    "//#tunnel-dns-coverage": {
      "inputs": [
        "scripts/check-tunnel-dns-coverage.ts",
        "packages/homelab/src/cdk8s/src/**/*.ts",
        "packages/homelab/src/tofu/cloudflare/*.tf"
      ]
    }
  }
}
