      "tips": [
        {
          "id": "jungle:Nunu:general:0",
          "text": "Use Consume on jungle monsters to clear camps faster and heal. It deals big damage to them and restores your health.",
          "refs": [
            { "kind": "ability", "key": "Nunu-Q", "start": 4, "end": 11 }
          ],
          "pWrong": 0.03
        },
        {
          "id": "jungle:Nunu:general:1",
          "text": "Save Consume for a champion when you are low on health. The heal is stronger below half health.",
          "refs": [
            { "kind": "ability", "key": "Nunu-Q", "start": 5, "end": 12 }
          ],
          "pWrong": 0.09
        },
        {
          "id": "jungle:Nunu:general:2",
          "text": "Hold the turn to steer Biggest Snowball Ever!, and let it roll far before it hits. It hits harder and knocks up longer.",
          "refs": [
            { "kind": "ability", "key": "Nunu-W", "start": 23, "end": 45 },
            { "kind": "keyword", "key": "knocked-up", "start": 102, "end": 111 }
          ],
          "pWrong": 0.17
        },
        {
          "id": "jungle:Nunu:general:3",
          "text": "Recast Biggest Snowball Ever! to release it early when the target is close or about to escape.",
          "refs": [
            { "kind": "ability", "key": "Nunu-W", "start": 7, "end": 29 }
          ],
          "pWrong": 0.05
        },
        {
          "id": "jungle:Nunu:general:4",
          "text": "Land all three snowballs of Snowball Barrage to slow the enemy. The root only hits enemies the snowballs marked, so keep them near you.",
          "refs": [
            { "kind": "ability", "key": "Nunu-E", "start": 28, "end": 44 },
            { "kind": "keyword", "key": "slowed", "start": 48, "end": 52 },
            { "kind": "keyword", "key": "rooted", "start": 68, "end": 72 }
          ],
          "pWrong": 0.65
        },
        {
          "id": "jungle:Nunu:general:5",
          "text": "Snowball Barrage stops at the first enemy it hits. Aim it so minions are not in the way.",
          "refs": [
            { "kind": "ability", "key": "Nunu-E", "start": 0, "end": 16 }
          ],
          "pWrong": 0.88,
          "hidden": true
        },
        {
          "id": "jungle:Nunu:general:6",
          "text": "Wait for the first round of enemy disables before using Absolute Zero. Stay back until then so the channel is not interrupted.",
          "refs": [
            { "kind": "ability", "key": "Nunu-R", "start": 56, "end": 69 }
          ],
          "pWrong": 0.25
        },
        {
          "id": "jungle:Nunu:general:7",
          "text": "Recast Absolute Zero early for partial damage if enemies are about to leave the area.",
          "refs": [
            { "kind": "ability", "key": "Nunu-R", "start": 7, "end": 20 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "jungle:Nunu:general:8",
          "text": "Attack enemy champions to trigger Call of the Freljord. It gives you and a nearby ally extra attack speed and Move Speed.",
          "refs": [
            { "kind": "ability", "key": "Nunu-passive", "start": 34, "end": 54 }
          ],
          "pWrong": 0.62
        }
      ],
      "combos": [
