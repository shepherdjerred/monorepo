  "general": [
    {
      "lane": "middle",
      "inputHash": "98b97887f06112784bb492bcdd674498591a92142120061e7ef0097eb55a872c",
      "tips": [
        {
          "id": "middle:Syndra:general:0",
          "text": "Use Dark Sphere on enemies who stand still to last-hit, and keep the spheres on the ground. Your other abilities need them.",
          "refs": [
            { "kind": "ability", "key": "Syndra-Q", "start": 4, "end": 15 }
          ],
          "pWrong": 0.37
        },
        {
          "id": "middle:Syndra:general:1",
          "text": "Hit an enemy with Force of Will, then follow with Dark Sphere. They are slowed and have a hard time dodging it.",
          "refs": [
            { "kind": "ability", "key": "Syndra-W", "start": 18, "end": 31 },
            { "kind": "ability", "key": "Syndra-Q", "start": 50, "end": 61 },
            { "kind": "keyword", "key": "slowed", "start": 72, "end": 78 }
          ],
          "pWrong": 0.05
        },
        {
          "id": "middle:Syndra:general:2",
          "text": "Place a Dark Sphere near the enemy, then push it into them with Scatter the Weak. A sphere that hits them stuns them.",
          "refs": [
            { "kind": "ability", "key": "Syndra-Q", "start": 8, "end": 19 },
            { "kind": "ability", "key": "Syndra-E", "start": 64, "end": 80 },
            { "kind": "keyword", "key": "stunned", "start": 106, "end": 111 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "middle:Syndra:general:3",
          "text": "Grab an enemy minion with Force of Will when no sphere is around. You can then throw it as a slowing hit on the enemy.",
          "refs": [
            { "kind": "ability", "key": "Syndra-W", "start": 26, "end": 39 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "middle:Syndra:general:4",
          "text": "Scatter the Weak has a long cooldown, so don't waste it. Use it to stun with a sphere or to push away someone diving you.",
          "refs": [
            { "kind": "ability", "key": "Syndra-E", "start": 0, "end": 16 },
            { "kind": "keyword", "key": "stunned", "start": 67, "end": 71 }
          ],
          "pWrong": 0.07
        },
        {
          "id": "middle:Syndra:general:5",
          "text": "Aim Scatter the Weak away from walls and terrain. Enemies are not knocked back through terrain.",
          "refs": [
            { "kind": "ability", "key": "Syndra-E", "start": 4, "end": 20 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "middle:Syndra:general:6",
          "text": "Before you cast Unleashed Power, lay down several Dark Spheres. More spheres on the ground means more damage.",
          "refs": [
            { "kind": "ability", "key": "Syndra-R", "start": 16, "end": 31 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "middle:Syndra:general:7",
          "text": "Put your points into one ability until it reaches max rank. At max rank it gains a strong bonus.",
          "refs": [],
          "pWrong": 0.03
        },
        {
          "id": "middle:Syndra:general:8",
          "text": "Use Unleashed Power on a low-health enemy once you have lots of Splinters of Wrath. It can then finish them off.",
          "refs": [
            { "kind": "ability", "key": "Syndra-R", "start": 4, "end": 19 }
          ],
          "pWrong": 0.11
        }
      ],
      "combos": [
        {
          "id": "middle:Syndra:combo:0",
          "name": "Instant sphere stun (QE buffer)",
          "category": "trick",
          "sequence": [
            { "kind": "ability", "key": "Syndra-Q" },
            { "kind": "ability", "key": "Syndra-E" }
          ],
          "when": "When you want to stun an enemy standing at close or medium range.",
          "whenRefs": [],
          "text": "Cast Q and then E at once, as the sphere is still appearing. The sphere is knocked back as soon as it lands, so the enemy has little time to react.",
          "textRefs": []
        }
      ]
    }
  ],
  "matchups": [
