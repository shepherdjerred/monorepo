{
  "name": "@shepherdjerred/mc-build",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minecraft build library: the 26.2 block registry, block grids, Sponge schematics, the build DSL, lint, and the offline renderer.",
  "exports": {
    "./*": "./src/*"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "build": "bun build src/compile/child.ts src/render/index.ts --target=bun --outdir=dist --external=sharp",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run test",
    "lint": "bunx eslint --cache .",
    "test:ci": "bun ../../scripts/ci/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../scripts/ci/run-ci-test.ts"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "prismarine-nbt": "2.8.0",
    "sharp": "0.35.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shepherdjerred/eslint-config": "workspace:*",
    "@types/bun": "1.4.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "vitest": "5.0.1"
  }
}
