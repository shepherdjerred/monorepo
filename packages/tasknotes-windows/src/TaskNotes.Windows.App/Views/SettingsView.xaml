<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TaskNotes.Windows.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:host="using:TaskNotes.Windows.Host">
    <ScrollViewer>
        <StackPanel
            MaxWidth="760"
            HorizontalAlignment="Left"
            Spacing="16">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />
            <ToggleSwitch
                x:Name="TaskSoundsToggle"
                AutomationProperties.Name="Task sounds"
                Header="Task sounds"
                OffContent="Off"
                OnContent="On"
                Toggled="TaskSounds_Toggled" />
            <TextBlock Text="Subtle sounds for adding, completing, deleting and undoing tasks in the active window. Windows volume and mute apply." TextWrapping="Wrap" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Connect to your Facet sync server. Your API token is stored securely in Windows Credential Locker."
                TextWrapping="Wrap" />
            <TextBox
                x:Name="ServerUrlTextBox"
                AutomationProperties.AutomationId="TaskNotes.Settings.ServerUrl"
                AutomationProperties.Name="Facet server URL"
                Header="Facet server URL"
                PlaceholderText="https://tasknotes.tailnet-1a49.ts.net"
                Text="{x:Bind ViewModel.ServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <PasswordBox
                x:Name="TokenPasswordBox"
                AutomationProperties.AutomationId="TaskNotes.Settings.Token"
                AutomationProperties.Name="API token"
                Header="API token"
                PasswordChanged="TokenPasswordBox_PasswordChanged" />
            <Button
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="TaskNotes.Settings.Save"
                AutomationProperties.Name="Save server settings and synchronize"
                Click="Save_Click"
                Content="Save &amp; synchronize" />
            <TextBlock
                x:Name="ConnectionStatusText"
                AutomationProperties.AutomationId="TaskNotes.Settings.Status"
                AutomationProperties.LiveSetting="Polite"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="BackgroundSyncStatusText"
                AutomationProperties.LiveSetting="Polite"
                TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="EnableBackgroundSync_Click" Content="Enable background sync" />
                <Button Click="DisableBackgroundSync_Click" Content="Disable background sync" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="EnableReminders_Click" Content="Enable Windows reminders" />
                <Button Click="DisableReminders_Click" Content="Disable reminders on this device" />
            </StackPanel>
            <TextBlock
                x:Name="ReminderStatusText"
                AutomationProperties.LiveSetting="Polite"
                TextWrapping="Wrap" />
            <TextBlock Text="Reminders use Windows notifications when running the packaged MSIX app. Delivery depends on Windows permissions and power settings." TextWrapping="Wrap" />
            <TextBox
                x:Name="HotkeyTextBox"
                AutomationProperties.AutomationId="TaskNotes.Settings.Hotkey"
                Header="Global Quick Add hotkey"
                PlaceholderText="Ctrl+Alt+N" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    AutomationProperties.AutomationId="TaskNotes.Settings.Hotkey.Apply"
                    Click="ApplyHotkey_Click"
                    Content="Apply hotkey" />
                <Button
                    AutomationProperties.AutomationId="TaskNotes.Settings.Hotkey.Clear"
                    Click="ClearHotkey_Click"
                    Content="Clear hotkey" />
                <TextBlock
                    x:Name="HotkeyStatusText"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="TaskNotes.Settings.HotkeyStatus"
                    AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <TextBlock
                Margin="0,16,0,0"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Saved views" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="CreateSavedView_Click" Content="Create" />
                <Button Click="RestoreSavedViews_Click" Content="Restore defaults" />
            </StackPanel>
            <ListView
                AutomationProperties.AutomationId="TaskNotes.Settings.SavedViews"
                ItemsSource="{x:Bind ShellViewModel.SavedViews, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="host:SavedViewDefinition">
                        <Grid
                            Padding="0,8"
                            AutomationProperties.AutomationId="{x:Bind Id}"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Name}" />
                            <Button
                                Grid.Column="1"
                                Click="DuplicateSavedView_Click"
                                Content="Duplicate"
                                Tag="{x:Bind Id}" />
                            <Button
                                Grid.Column="2"
                                Click="MoveSavedView_Click"
                                Content="Move up"
                                Tag="{x:Bind Id}" />
                            <Button
                                Grid.Column="3"
                                Click="DeleteSavedView_Click"
                                Content="Delete"
                                Tag="{x:Bind Id}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                Margin="0,16,0,0"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Parked changes" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Changes rejected by the server remain parked here until you retry or discard them."
                TextWrapping="Wrap" />
            <ListView
                AutomationProperties.AutomationId="TaskNotes.Settings.ParkedChanges"
                ItemsSource="{x:Bind ViewModel.ParkedChanges, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="host:ParkedChange">
                        <Grid Padding="0,10" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind ErrorName}" />
                                <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                AutomationProperties.Name="Retry parked change"
                                Click="RetryParked_Click"
                                Content="Retry"
                                Tag="{x:Bind Id}" />
                            <Button
                                Grid.Column="2"
                                AutomationProperties.Name="Discard parked change"
                                Click="DiscardParked_Click"
                                Content="Discard"
                                Tag="{x:Bind Id}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</UserControl>
