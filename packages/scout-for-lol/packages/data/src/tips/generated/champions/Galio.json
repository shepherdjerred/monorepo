      "tips": [
        {
          "id": "middle:Galio:general:0",
          "text": "Aim Winds of War so both windblasts meet on the enemy. The tornado they form hurts high-health targets most, and it keeps going after the blasts pass minions.",
          "refs": [
            { "kind": "ability", "key": "Galio-Q", "start": 4, "end": 16 }
          ],
          "pWrong": 0.38
        },
        {
          "id": "middle:Galio:general:1",
          "text": "Hold Shield of Durand to charge it before a fight. A longer charge taunts for longer and hits harder, but you move slower while charging.",
          "refs": [
            { "kind": "ability", "key": "Galio-W", "start": 5, "end": 21 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "middle:Galio:general:2",
          "text": "Release Shield of Durand even when you are crowd controlled. It still goes off.",
          "refs": [
            { "kind": "ability", "key": "Galio-W", "start": 8, "end": 24 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "middle:Galio:general:3",
          "text": "Use the step back in Justice Punch to dodge enemy spells. Aim it carefully, because Galio stops when he hits terrain.",
          "refs": [
            { "kind": "ability", "key": "Galio-E", "start": 21, "end": 34 },
            { "kind": "champion", "key": "Galio", "start": 84, "end": 89 }
          ],
          "pWrong": 0.06
        },
        {
          "id": "middle:Galio:general:4",
          "text": "Land Justice Punch on a champion to leave them knocked up, then follow with your other abilities while they cannot act.",
          "refs": [
            { "kind": "ability", "key": "Galio-E", "start": 5, "end": 18 },
            { "kind": "keyword", "key": "knocked-up", "start": 47, "end": 57 }
          ],
          "pWrong": 0.23
        },
        {
          "id": "middle:Galio:general:5",
          "text": "Click an ally on the minimap to cast Hero's Entrance and help a distant lane. Your allies in the area also get a shield.",
          "refs": [
            { "kind": "ability", "key": "Galio-R", "start": 37, "end": 52 }
          ],
          "pWrong": 0.55
        },
        {
          "id": "middle:Galio:general:6",
          "text": "Use your abilities on enemy champions between basic attacks. Each hit shortens the cooldown of Colossal Smash, so you get that empowered attack more often.",
          "refs": [
            {
              "kind": "ability",
              "key": "Galio-passive",
              "start": 95,
              "end": 109
            }
          ],
          "pWrong": 0.12
        }
      ],
      "combos": [
        {
          "id": "middle:Galio:combo:0",
          "name": "Minimap Hero's Entrance",
          "category": "trick",
          "sequence": [{ "kind": "ability", "key": "Galio-R" }],
          "when": "When a far-off ally needs help or a fight starts elsewhere on the map and you want to roam from mid.",
          "whenRefs": [],
          "text": "Click an ally's icon on the minimap to cast it without leaving lane. You can arrive at a fight before the enemy expects you.",
          "textRefs": []
        },
        {
          "id": "middle:Galio:combo:1",
          "name": "Punch step-back dodge",
          "category": "trick",
          "sequence": [{ "kind": "ability", "key": "Galio-E" }],
          "when": "When an enemy skillshot is about to hit you and Justice Punch is ready.",
          "whenRefs": [
            { "kind": "ability", "key": "Galio-E", "start": 48, "end": 61 }
          ],
          "text": "Galio steps back before the dash, so casting early can dodge the spell. Aim so the dash still goes where you want.",
          "textRefs": [
            { "kind": "champion", "key": "Galio", "start": 0, "end": 5 }
          ]
        },
        {
          "id": "middle:Galio:combo:2",
          "name": "Shield release while crowd controlled",
          "category": "trick",
          "sequence": [{ "kind": "ability", "key": "Galio-W" }],
          "when": "When you are stunned or caught by crowd control while charging Shield of Durand.",
          "whenRefs": [
            { "kind": "ability", "key": "Galio-W", "start": 63, "end": 79 }
          ],
          "text": "You can release the charge even while crowd controlled. This lets you taunt and damage nearby enemies instead of just waiting out the effect.",
          "textRefs": []
        }
      ]
    }
  ],
