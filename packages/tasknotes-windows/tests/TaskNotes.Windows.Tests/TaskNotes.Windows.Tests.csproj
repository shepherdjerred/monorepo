<Project Sdk="MSTest.Sdk">
  <PropertyGroup>
    <AssemblyName>TaskNotes.Windows.UnitTests</AssemblyName>
    <RootNamespace>TaskNotes.Windows.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <NeedsTaskNotesNative>true</NeedsTaskNotesNative>
    <TestingExtensionsProfile>AllMicrosoft</TestingExtensionsProfile>
    <MSTestParallelizeScope>MethodLevel</MSTestParallelizeScope>
    <MSTestParallelizeWorkers>0</MSTestParallelizeWorkers>
  </PropertyGroup>
  <ItemGroup>
    <Compile
      Include="../../src/TaskNotes.Windows.App/Acceptance/StandaloneAcceptanceDescriptor.cs"
      Link="Adapters/StandaloneAcceptanceDescriptor.cs"
    />
    <Compile
      Include="../../src/TaskNotes.Windows.App/Acceptance/StandaloneAcceptanceBootstrap.cs"
      Link="Adapters/StandaloneAcceptanceBootstrap.cs"
    />
    <EmbeddedResource
      Include="../../e2e/standalone/contract.json"
      LogicalName="StandaloneAcceptanceSchema.json"
    />
    <Compile
      Include="../../src/TaskNotes.Windows.App/ShellPreferencesCodec.cs"
      Link="Adapters/ShellPreferencesCodec.cs"
    />
    <EmbeddedResource
      Include="../../../tasknotes-fixtures/vault/facet-retained-actions.json"
      LogicalName="FacetRetainedActionCases.json"
    />
    <EmbeddedResource
      Include="../../../tasknotes-core/crates/obsidian-sync/tests/reference/protocol.json"
      LogicalName="ObsidianProtocolCapture.json"
    />
    <EmbeddedResource
      Include="../../../tasknotes-fixtures/vault/facet-contract.json"
      LogicalName="FacetContractCases.json"
    />
    <EmbeddedResource
      Include="../../../tasknotes-fixtures/vault/facet-occurrence-contract.json"
      LogicalName="FacetOccurrenceContractCases.json"
    />
    <EmbeddedResource
      Include="../../../tasknotes-fixtures/vault/facet-raw-contract.json"
      LogicalName="FacetRawContractCases.json"
    />
    <PackageReference Include="Microsoft.Testing.Extensions.JUnitReport" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/TaskNotes.Core.Bindings/TaskNotes.Core.Bindings.csproj" />
    <ProjectReference Include="../../src/TaskNotes.Windows.Host/TaskNotes.Windows.Host.csproj" />
    <ProjectReference Include="../../src/TaskNotes.Windows.Presentation/TaskNotes.Windows.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="ServerIntegrationTests.cs" />
    <Compile Remove="TaskNotesServerProcess.cs" />
  </ItemGroup>
</Project>
