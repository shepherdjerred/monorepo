  "general": [
    {
      "lane": "top",
      "inputHash": "36bb1da31d84d71671da5e07ac3f371223a363067772df3fe09e15f514d99665",
      "tips": [
        {
          "id": "top:Renekton:general:0",
          "text": "Wait until your Fury is at least half full, then use Ruthless Predator on an enemy champion. The longer stun is enough time to land a full combo.",
          "refs": [
            { "kind": "ability", "key": "Renekton-W", "start": 53, "end": 70 }
          ],
          "pWrong": 0.72
        },
        {
          "id": "top:Renekton:general:1",
          "text": "Hit enemy champions with Cull the Meek, not just minions. Each champion hit heals you much more and builds Fury faster.",
          "refs": [
            { "kind": "ability", "key": "Renekton-Q", "start": 25, "end": 38 }
          ],
          "pWrong": 0.66
        },
        {
          "id": "top:Renekton:general:2",
          "text": "Dash in with Slice and Dice, hit an enemy, then recast it to get out. You can trade and leave before they answer.",
          "refs": [
            { "kind": "ability", "key": "Renekton-E", "start": 13, "end": 27 }
          ],
          "pWrong": 0.56
        },
        {
          "id": "top:Renekton:general:3",
          "text": "Save your recast of Slice and Dice for when your Fury is high. The empowered recast hurts more and cuts the enemy's Armor.",
          "refs": [
            { "kind": "ability", "key": "Renekton-E", "start": 20, "end": 34 }
          ],
          "pWrong": 0.17
        },
        {
          "id": "top:Renekton:general:4",
          "text": "Keep hitting minions and enemies to hold your Fury. It only fades after a long time without fighting.",
          "refs": [],
          "pWrong": 0.25
        },
        {
          "id": "top:Renekton:general:5",
          "text": "Fight when you are below half health with Fury available. Reign of Anger then builds Fury faster and your empowered abilities come sooner.",
          "refs": [
            {
              "kind": "ability",
              "key": "Renekton-passive",
              "start": 58,
              "end": 72
            }
          ],
          "pWrong": 0.47
        },
        {
          "id": "top:Renekton:general:6",
          "text": "Use Dominus at the start of a long fight. It gives you extra health, damages nearby enemies and fills your Fury.",
          "refs": [
            { "kind": "ability", "key": "Renekton-R", "start": 4, "end": 11 }
          ],
          "pWrong": 0.09
        },
        {
          "id": "top:Renekton:general:7",
          "text": "Walk up and use Ruthless Predator before the enemy shields you. The empowered version destroys shields before it hits.",
          "refs": [
            { "kind": "ability", "key": "Renekton-W", "start": 16, "end": 33 }
          ],
          "pWrong": 0.5
        }
      ],
      "combos": []
    }
  ],
