---
import { SharedNavbar } from "#src/components/shared-navbar.tsx";

interface Props {
  activePage?: "home" | "getting-started" | "docs" | "support" | "whatsnew";
}

const { activePage } = Astro.props;
const paths = {
  home: "/",
  "getting-started": "/getting-started",
  docs: "/docs/",
  support: "/support",
  whatsnew: "/whatsnew",
};
const currentPath = activePage === undefined ? undefined : paths[activePage];
---

<SharedNavbar currentPath={currentPath} client:load />
