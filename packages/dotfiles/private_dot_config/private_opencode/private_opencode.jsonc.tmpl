{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "lsp": true,
  // The Kimi provider is loaded from a local checkout of the shepherdjerred
  // fork of opencode-kimi-full, templated via chezmoi so the home directory
  // resolves per-machine. The pinned checkout and quota companion are cloned
  // and built by run_onchange_after_install-opencode-plugins.sh.tmpl.
  "plugin": [
{{- if stat (joinPath .chezmoi.homeDir "git/opencode-kimi-full") }}
    {{ joinPath .chezmoi.homeDir "git/opencode-kimi-full" | toJson }},
{{- end }}
{{- if stat (joinPath .chezmoi.homeDir "git/opencode-quota/dist/index.js") }}
    {{ printf "file://%s" (joinPath .chezmoi.homeDir "git/opencode-quota/dist/index.js") | toJson }},
{{- end }}
  ],
  "permission": {
    "bash": {
      "*": "allow",
      "sudo *": "deny",
      "su *": "deny",
      "rm -rf*": "deny",
      "rm -fr*": "deny",
      "dd *": "deny",
      "mkfs*": "deny",
      "newfs*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "halt*": "deny",
      "poweroff*": "deny",
      "kubectl delete namespace *": "deny",
      "kubectl delete ns *": "deny",
      "kubectl delete node*": "deny",
      "kubectl delete pv *": "deny",
      "kubectl delete pv/*": "deny",
      "kubectl delete pvc *": "deny",
      "kubectl delete pvc/*": "deny",
      "kubectl delete persistentvolume*": "deny",
      "kubectl delete persistentvolumeclaim*": "deny",
      "kubectl drain *": "deny",
      "talosctl reset*": "deny",
      "talosctl wipe*": "deny",
      "argocd cluster rm*": "deny",
      "argocd app sync*--prune*": "deny",
      "helm uninstall*": "deny",
      "aws s3 rb*": "deny",
      "aws ec2 terminate*": "deny",
      "aws iam delete*": "deny",
      "gh repo delete*": "deny",
      "op vault delete*": "deny",
      "docker system prune*": "deny",
      "docker volume prune*": "deny",
      "docker volume rm*": "deny",
      "velero backup delete*": "deny",
      "sh": "deny",
      "bash": "deny",
      "zsh": "deny",
      "sh -": "deny",
      "bash -": "deny",
      "diskutil eraseDisk*": "deny",
      "diskutil eraseVolume*": "deny",
      "diskutil secureErase*": "deny",
      "diskutil zeroDisk*": "deny",
      "csrutil disable*": "deny",
      "csrutil clear*": "deny",
      "spctl --master-disable*": "deny",
      "nvram -c*": "deny",
      "nvram -d*": "deny",
      "parted *": "deny",
      "fdisk *": "deny",
      "sfdisk *": "deny",
      "gdisk *": "deny",
      "wipefs *": "deny",
      "crontab -r*": "deny",
      "kubectl delete crd*": "deny",
      "kubectl delete customresourcedefinition*": "deny",
      "kubectl delete --all *": "deny",
      "kubectl delete * --all-namespaces*": "deny",
    },
  },
  "mcp": {
    "mcp-gateway-linear": {
      "type": "remote",
      "url": "https://mcp-gateway.tailnet-1a49.ts.net/linear/sse",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {{ onepasswordRead "op://v64ocnykdqju4ui6j6pua56xw4/iixelnobjabehkgxhl3ekacdy4/MCP_PROXY_AUTH_TOKEN" }}",
      },
    },
    "mcp-gateway-posthog": {
      "type": "remote",
      "url": "https://mcp-gateway.tailnet-1a49.ts.net/posthog/sse",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {{ onepasswordRead "op://v64ocnykdqju4ui6j6pua56xw4/iixelnobjabehkgxhl3ekacdy4/MCP_PROXY_AUTH_TOKEN" }}",
      },
    },
  },
  "provider": {
    "kimi-for-coding-oauth": {
      "name": "Kimi For Coding (OAuth)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.kimi.com/coding/v1",
      },
      "models": {
        "kimi-for-coding": {
          "name": "K2.7 Coding",
          "attachment": true,
          "reasoning": true,
          "temperature": false,
          "modalities": {
            "input": ["text", "image", "video"],
            "output": ["text"],
          },
          "options": {},
        },
        "kimi-for-coding-highspeed": {
          "name": "K2.7 Coding Highspeed",
          "attachment": true,
          "reasoning": true,
          "temperature": false,
          "modalities": {
            "input": ["text", "image", "video"],
            "output": ["text"],
          },
          "options": {},
        },
        "k3": {
          "name": "K3",
          "cost": { "input": 3, "output": 15, "cache_read": 0.3 },
          "attachment": true,
          "reasoning": true,
          "temperature": false,
          "modalities": {
            "input": ["text", "image", "video"],
            "output": ["text"],
          },
          "options": {},
          "variants": {
            "low": { "reasoning_effort": "low" },
            "high": { "reasoning_effort": "high" },
            "max": { "reasoning_effort": "max" },
          },
        },
      },
    },
  },
}
