{
  "name": "@shepherdjerred/ts-mc-docs",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit && astro build",
    "preview": "astro preview",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "lint": "astro check",
    "deploy": "bun ../../scripts/release/deploy-site.ts ts-mc-docs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.42.0",
    "astro": "^7.3.3",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "^6.0.3"
  }
}
