+/* With validateOnLoad disabled, MSXML resolves references between the schemas
+ * of a collection when it validates, so a schema may use another cached
+ * namespace without importing it. Such schemas are compiled on first use, with
+ * imports of the other cached namespaces served from the cache itself. */
+#define CACHE_SCHEMA_URL "wine-msxml-schema-cache:"
+
+struct deferred_compile
+{
+    schema_cache *cache;
+    xmlChar **buffers;
+    int count;
+};
+
+static struct deferred_compile *deferred_compile;
+static CRITICAL_SECTION deferred_cs;
+static CRITICAL_SECTION_DEBUG deferred_cs_debug =
+{
+    0, 0, &deferred_cs,
+    { &deferred_cs_debug.ProcessLocksList, &deferred_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": deferred_cs") }
+};
+static CRITICAL_SECTION deferred_cs = { &deferred_cs_debug, -1, 0, 0, 0, 0 };
