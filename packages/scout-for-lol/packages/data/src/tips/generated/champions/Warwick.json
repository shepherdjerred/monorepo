      "tips": [
        {
          "id": "jungle:Warwick:general:0",
          "text": "Hold the Jaws of the Beast button on a runner so Warwick follows them, even through dashes. Tap it instead when you only want a quick bite.",
          "refs": [
            { "kind": "ability", "key": "Warwick-Q", "start": 9, "end": 26 },
            { "kind": "champion", "key": "Warwick", "start": 49, "end": 56 }
          ],
          "pWrong": 0.09
        },
        {
          "id": "jungle:Warwick:general:1",
          "text": "Follow the Blood Hunt trails to enemies who are low on health; Warwick runs faster toward them and attacks much faster against them.",
          "refs": [
            { "kind": "ability", "key": "Warwick-W", "start": 11, "end": 21 },
            { "kind": "champion", "key": "Warwick", "start": 63, "end": 70 }
          ],
          "pWrong": 0.04
        },
        {
          "id": "jungle:Warwick:general:2",
          "text": "Cast Blood Hunt when you arrive at a fight, even if nobody is hurt, to mark the closest enemy and get the speed bonus on them.",
          "refs": [
            { "kind": "ability", "key": "Warwick-W", "start": 5, "end": 15 }
          ],
          "pWrong": 0.08
        },
        {
          "id": "jungle:Warwick:general:3",
          "text": "Use Primal Howl to take less damage while you fight, then let it end next to enemies so they flee in fear.",
          "refs": [
            { "kind": "ability", "key": "Warwick-E", "start": 4, "end": 15 }
          ],
          "pWrong": 0.13
        },
        {
          "id": "jungle:Warwick:general:4",
          "text": "Cast Infinite Duress toward a target you can reach; the leap gets longer with extra Move Speed. It heals Warwick for the damage it deals.",
          "refs": [
            { "kind": "ability", "key": "Warwick-R", "start": 5, "end": 20 },
            { "kind": "champion", "key": "Warwick", "start": 105, "end": 112 }
          ],
          "pWrong": 0.03
        },
        {
          "id": "jungle:Warwick:general:5",
          "text": "Fight when Warwick is low on health, because Eternal Hunger heals him with each attack. Stay in the fight and keep attacking.",
          "refs": [
            { "kind": "champion", "key": "Warwick", "start": 11, "end": 18 },
            {
              "kind": "ability",
              "key": "Warwick-passive",
              "start": 45,
              "end": 59
            }
          ],
          "pWrong": 0.97
        },
        {
          "id": "jungle:Warwick:general:6",
          "text": "Use Jaws of the Beast on big jungle monsters to heal, since it deals extra damage based on the target's health.",
          "refs": [
            { "kind": "ability", "key": "Warwick-Q", "start": 4, "end": 21 }
          ],
          "pWrong": 0.8
        },
        {
          "id": "jungle:Warwick:general:7",
          "text": "Don't start Infinite Duress on a target with a spell shield or crowd control immunity; the channel won't begin.",
          "refs": [
            { "kind": "ability", "key": "Warwick-R", "start": 12, "end": 27 }
          ],
          "pWrong": 0.11
        }
      ],
      "combos": [
        {
          "id": "jungle:Warwick:combo:0",
          "name": "Held Q follow",
          "category": "trick",
          "sequence": [{ "kind": "ability", "key": "Warwick-Q" }],
          "when": "When chasing a fleeing or dashing enemy that you want to stay attached to.",
          "whenRefs": [],
          "text": "Hold the Q button instead of tapping it. Warwick clamps on and follows the target through dashes and teleports, then leaps behind them.",
