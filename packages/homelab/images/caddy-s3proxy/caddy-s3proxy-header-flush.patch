+
+func copyConditionalHeaders(dst http.Header, response *http.Response) {
+	if response == nil || response.StatusCode != http.StatusNotModified {
+		return
+	}
+	for _, name := range []string{"ETag", "Cache-Control", "Date", "Expires", "Vary", "Content-Location", "Last-Modified"} {
+		for _, value := range response.Header.Values(name) {
+			dst.Add(name, value)
+		}
+	}
@@ -336,0 +351,7 @@ func (p S3Proxy) writeResponseFromGetObject(w http.ResponseWriter, obj *s3.GetOb
+	// Preserve the authoritative object (or range) length before flushing.
+	// io.Copy does not infer this for streamed bodies; Cloudflare needs it
+	// to serve byte ranges for large archive downloads.
+	if obj.ContentLength != nil {
+		w.Header().Set("Content-Length", strconv.FormatInt(*obj.ContentLength, 10))
+	}
