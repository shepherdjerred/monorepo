    {
      "lane": "support",
      "inputHash": "403ba37ef21a9aa2f758d7ed45528e253bbda28579d7fab678061b5ddeedd8b2",
      "tips": [
        {
          "id": "support:Soraka:general:0",
          "text": "Hit an enemy with Starcall first, then cast Astral Infusion. Soraka gets Rejuvenation, so the heal costs her almost no health and also heals over time.",
          "refs": [
            { "kind": "ability", "key": "Soraka-Q", "start": 18, "end": 26 },
            { "kind": "ability", "key": "Soraka-W", "start": 44, "end": 59 },
            { "kind": "champion", "key": "Soraka", "start": 61, "end": 67 }
          ],
          "pWrong": 0.06
        },
        {
          "id": "support:Soraka:general:1",
          "text": "Don't spam Astral Infusion without Rejuvenation. It costs a chunk of your own health, and you can't cast it when you are very low.",
          "refs": [
            { "kind": "ability", "key": "Soraka-W", "start": 11, "end": 26 }
          ],
          "pWrong": 0.18
        },
        {
          "id": "support:Soraka:general:2",
          "text": "Poke with Starcall whenever enemies stand in range. It slows them, and a hit on a champion heals you.",
          "refs": [
            { "kind": "ability", "key": "Soraka-Q", "start": 10, "end": 18 },
            { "kind": "keyword", "key": "slowed", "start": 55, "end": 60 }
          ],
          "pWrong": 0.15
        },
        {
          "id": "support:Soraka:general:3",
          "text": "Use Equinox to keep enemies off your carry. It silences them while it lingers, then roots them when it ends.",
          "refs": [
            { "kind": "ability", "key": "Soraka-E", "start": 4, "end": 11 },
            { "kind": "keyword", "key": "silenced", "start": 47, "end": 55 },
            { "kind": "keyword", "key": "rooted", "start": 84, "end": 89 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "support:Soraka:general:4",
          "text": "Aim Equinox where the enemy will stand when it ends. The root only catches whoever is still inside, so it works best as a setup for your team's follow-up.",
          "refs": [
            { "kind": "ability", "key": "Soraka-E", "start": 4, "end": 11 },
            { "kind": "keyword", "key": "rooted", "start": 57, "end": 61 }
          ],
          "pWrong": 0.38
        },
        {
          "id": "support:Soraka:general:5",
          "text": "Use Wish from anywhere on the map to save an ally who is about to die. It heals more on low health allies.",
          "refs": [
            { "kind": "ability", "key": "Soraka-R", "start": 4, "end": 8 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "support:Soraka:general:6",
          "text": "Face a low health ally and Salvation makes you run much faster toward them. Use it to reach and save a friend.",
          "refs": [
            {
              "kind": "ability",
              "key": "Soraka-passive",
              "start": 27,
              "end": 36
            }
          ],
          "pWrong": 0.04
        },
        {
          "id": "support:Soraka:general:7",
          "text": "Stay behind your frontline in fights. Enemies are told to focus you when you step forward to heal.",
          "refs": [],
          "pWrong": 0.1
        }
      ],
      "combos": []
    }
  ],
