{
  "name": "tasks-for-obsidian",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "bun test src scripts",
    "test:coverage": "bun test --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage --config ../../scripts/bunfig.coverage.toml --coverage scripts/clean-ios.test.ts scripts/ios-logs.test.ts",
    "test:contract": "bun test contract-tests --timeout 20000",
    "e2e": "bun run e2e/run.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit && PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit -p tsconfig.scripts.json",
    "check:ios-native-deps": "bun scripts/check-ios-native-deps.ts",
    "check:release-bundle": "bun scripts/check-release-bundle.ts",
    "pod-install": "cd ios && pod install",
    "clean:ios": "bun scripts/clean-ios.ts",
    "ios:logs": "bun scripts/ios-logs.ts",
    "lint:swift": "swiftlint lint --strict --quiet ios/TasksForObsidian ios/TasksWidget",
    "test:ci": "bun ../../scripts/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../scripts/run-ci-test.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.0.2",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-menu/menu": "^2.0.0",
    "@react-native-vector-icons/feather": "^13.1.0",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.11",
    "@sentry/react-native": "^8.8.0",
    "react": "19.2.8",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "3.1.0",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-ios-context-menu": "^3.2.1",
    "react-native-ios-utilities": "^5.2.0",
    "react-native-keychain": "^10.0.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "^4.5.3",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-sound": "^0.13.0",
    "react-native-worklets": "^0.11.0",
    "tasknotes-types": "workspace:*",
    "zeego": "^3.0.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.0",
    "@babel/core-v7": "npm:@babel/core@7.29.7",
    "@babel/plugin-transform-export-namespace-from": "^8.0.0",
    "@babel/plugin-transform-export-namespace-from-v7": "npm:@babel/plugin-transform-export-namespace-from@7.29.7",
    "@babel/preset-env": "^8.0.0",
    "@babel/runtime": "^8.0.0",
    "@react-native-community/cli": "^20.1.3",
    "@react-native-community/cli-platform-android": "^20.1.3",
    "@react-native-community/cli-platform-ios": "^20.1.3",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@shepherdjerred/eslint-config": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.17",
    "@typescript-eslint/utils": "^8.65.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.3.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "node": ">=20.19.4"
  }
}
