{
  "$schema": "../../../../scripts/ci-tests.schema.json",
  "package": "@scout-for-lol/backend",
  "defaultEnv": {
    "DATABASE_URL": "postgres://scout@127.0.0.1:5471/scout_test_unbound"
  },
  "steps": [
    {
      "runner": "vitest",
      "args": [
        "--testTimeout",
        "20000",
        "--exclude",
        "**/*.integration.test.ts"
      ]
    },
    {
      "runner": "vitest",
      "name": "integration",
      "tier": "extended",
      "args": [".integration.test.ts", "--testTimeout", "20000"]
    }
  ]
}
