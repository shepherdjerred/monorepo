<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TaskNotes.Windows.App.Views.TaskListWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:host="using:TaskNotes.Windows.Host"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:TaskNotes.Windows.App.Views"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock
                    x:Name="DestinationTitle"
                    AutomationProperties.AutomationId="TaskNotes.Destination.Title"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Today" />
                <TextBlock
                    x:Name="DestinationSubtitle"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Cached first, synchronized in the background" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    AutomationProperties.Name="Open Pomodoro"
                    Click="OpenPomodoro_Click"
                    Content="Pomodoro" />
                <Button
                    AutomationProperties.Name="Open Time Report"
                    Click="OpenTimeReport_Click"
                    Content="Time Report" />
                <Button
                    AutomationProperties.Name="Refresh tasks"
                    Click="Refresh_Click"
                    Content="Refresh" />
            </StackPanel>
        </Grid>

        <Grid
            Grid.Row="1"
            Margin="0,18,0,10"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                x:Name="SearchBox"
                AutomationProperties.AutomationId="TaskNotes.Search"
                AutomationProperties.Name="Search tasks"
                PlaceholderText="Search tasks"
                QuerySubmitted="SearchBox_QuerySubmitted"
                TextChanged="SearchBox_TextChanged" />
            <ComboBox
                x:Name="SortComboBox"
                Grid.Column="1"
                AutomationProperties.Name="Sort tasks"
                Header="Sort"
                SelectionChanged="SortComboBox_SelectionChanged">
                <ComboBoxItem Content="Synchronized" Tag="AsSynchronized" />
                <ComboBoxItem Content="Effective date" Tag="EffectiveDate" />
                <ComboBoxItem Content="Due date" Tag="DueDate" />
                <ComboBoxItem Content="Priority" Tag="Priority" />
                <ComboBoxItem Content="Title" Tag="Title" />
            </ComboBox>
            <ComboBox
                x:Name="GroupComboBox"
                Grid.Column="2"
                AutomationProperties.Name="Group tasks"
                Header="Group"
                SelectionChanged="GroupComboBox_SelectionChanged">
                <ComboBoxItem Content="None" Tag="None" />
                <ComboBoxItem Content="Date" Tag="Date" />
                <ComboBoxItem Content="Status" Tag="Status" />
                <ComboBoxItem Content="Priority" Tag="Priority" />
                <ComboBoxItem Content="Project" Tag="Project" />
            </ComboBox>
            <Button
                Grid.Column="3"
                VerticalAlignment="Bottom"
                AutomationProperties.Name="Save current query"
                Click="SaveView_Click"
                Content="Save view" />
        </Grid>

        <CommandBar Grid.Row="2" DefaultLabelPosition="Right">
            <AppBarButton
                AutomationProperties.Name="New task"
                Click="NewTask_Click"
                Icon="Add"
                Label="New" />
            <AppBarButton
                x:Name="CompleteSelectedButton"
                AutomationProperties.Name="Complete selected tasks"
                Click="CompleteSelected_Click"
                Icon="Accept"
                IsEnabled="False"
                Label="Complete" />
            <AppBarButton
                x:Name="ScheduleSelectedButton"
                AutomationProperties.Name="Schedule selected tasks"
                Click="ScheduleSelected_Click"
                Icon="Calendar"
                IsEnabled="False"
                Label="Schedule" />
            <AppBarButton
                x:Name="PrioritizeSelectedButton"
                AutomationProperties.Name="Prioritize selected tasks"
                Click="PrioritizeSelected_Click"
                Icon="Flag"
                IsEnabled="False"
                Label="Priority" />
            <AppBarButton
                x:Name="DeleteSelectedButton"
                AutomationProperties.Name="Delete selected tasks"
                Click="DeleteSelected_Click"
                Icon="Delete"
                IsEnabled="False"
                Label="Delete" />
            <AppBarSeparator />
            <AppBarButton
                x:Name="UndoButton"
                AutomationProperties.Name="Undo last completion"
                Click="Undo_Click"
                Icon="Undo"
                IsEnabled="False"
                Label="Undo" />
            <AppBarButton
                AutomationProperties.Name="Toggle task inspector"
                Click="Inspector_Click"
                Icon="Edit"
                Label="Inspector" />
        </CommandBar>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="3"
            Margin="0,0,0,10"
            IsClosable="False"
            IsOpen="True"
            Severity="Informational">
            <TextBlock
                x:Name="StatusText"
                AutomationProperties.AutomationId="TaskNotes.SyncStatus"
                AutomationProperties.LiveSetting="Polite"
                Text="Loading cached tasks…" />
        </InfoBar>

        <ListView
            x:Name="TaskList"
            Grid.Row="4"
            AutomationProperties.AutomationId="TaskNotes.TaskList"
            AutomationProperties.Name="Tasks"
            IsItemClickEnabled="True"
            ItemClick="TaskList_ItemClick"
            ItemsSource="{x:Bind ViewModel.VisibleTasks, Mode=OneWay}"
            SelectionChanged="TaskList_SelectionChanged"
            SelectionMode="Multiple">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="host:TaskItem">
                    <Grid
                        Padding="6,10"
                        AutomationProperties.AutomationId="{x:Bind AutomationId}"
                        AutomationProperties.Name="{x:Bind Title}"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            AutomationProperties.Name="{x:Bind Title}"
                            Click="Completion_Click"
                            IsChecked="{x:Bind IsCompleted}"
                            Tag="{x:Bind Id}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Title}"
                                    TextWrapping="Wrap" />
                                <TextBlock Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{x:Bind PendingLabel}" />
                            </StackPanel>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind TaxonomyLabel}"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{x:Bind StatusLabel}" />
                                <TextBlock Text="{x:Bind PriorityLabel}" />
                                <TextBlock Text="{x:Bind DateLabel}" />
                                <TextBlock Text="{x:Bind GroupLabel}" />
                            </StackPanel>
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            AutomationProperties.Name="Edit task"
                            Click="EditTask_Click"
                            Content="Edit"
                            Tag="{x:Bind Id}" />
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Click="EditTask_Click" Text="Edit" />
                                <MenuFlyoutSubItem Text="Move to status">
                                    <MenuFlyoutItem
                                        Click="MoveStatus_Click"
                                        Tag="open"
                                        Text="Open" />
                                    <MenuFlyoutItem
                                        Click="MoveStatus_Click"
                                        Tag="in-progress"
                                        Text="In progress" />
                                    <MenuFlyoutItem
                                        Click="MoveStatus_Click"
                                        Tag="waiting"
                                        Text="Waiting" />
                                    <MenuFlyoutItem
                                        Click="MoveStatus_Click"
                                        Tag="delegated"
                                        Text="Delegated" />
                                    <MenuFlyoutItem
                                        Click="MoveStatus_Click"
                                        Tag="done"
                                        Text="Done" />
                                    <MenuFlyoutItem
                                        Click="MoveStatus_Click"
                                        Tag="cancelled"
                                        Text="Cancelled" />
                                </MenuFlyoutSubItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Click="DeleteTask_Click" Text="Delete" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <views:TaskEditorView
            x:Name="InspectorPane"
            Grid.RowSpan="5"
            Grid.Column="1"
            ViewModel="{x:Bind EditorViewModel, Mode=OneWay}"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
