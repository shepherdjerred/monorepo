<?xml version="1.0" encoding="utf-8"?>
<template_modifications>
  <modification type="public" template="message_macros" modification_key="storm_historical_display_name" description="Keep the post's original author label linked to its native profile" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[<xf:username user="$user" rich="true" defaultname="{$fallbackName}"]]></find>
    <replace><![CDATA[<xf:username user="$user" rich="true" defaultname="{$fallbackName}" username="{{ ($user.storm_historical && $fallbackName) ? $fallbackName : null }}"]]></replace>
  </modification>
</template_modifications>
