{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sjer.red/schemas/ci-tests.schema.json",
  "title": "One workspace's CI test steps (<workspace>/ci-tests.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "package", "steps"],
  "properties": {
    "$schema": {
      "type": "string",
      "pattern": "(^|/)ci-tests\\.schema\\.json$"
    },
    "package": {
      "type": "string",
      "minLength": 1
    },
    "coverageAlways": {
      "type": "boolean"
    },
    "defaultEnv": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "excludedSuites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["runner"],
            "properties": {
              "runner": {
                "const": "vitest"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "group": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "tier": {
                "description": "ci (default), or extended when the step starts an external runtime (database server, Temporal test server, browser, game server, container service, ffmpeg) or its uncached CI p50 exceeds three minutes. Pull requests never run extended steps.",
                "enum": ["ci", "extended"]
              },
              "runtime": {
                "enum": ["bun", "node"]
              },
              "runtimeReason": {
                "type": "string",
                "minLength": 1
              },
              "runtimeArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["runner", "args"],
            "properties": {
              "runner": {
                "const": "go"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "group": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "tier": {
                "description": "ci (default), or extended when the step starts an external runtime (database server, Temporal test server, browser, game server, container service, ffmpeg) or its uncached CI p50 exceeds three minutes. Pull requests never run extended steps.",
                "enum": ["ci", "extended"]
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["runner", "args"],
            "properties": {
              "runner": {
                "const": "cargo"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "group": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "tier": {
                "description": "ci (default), or extended when the step starts an external runtime (database server, Temporal test server, browser, game server, container service, ffmpeg) or its uncached CI p50 exceeds three minutes. Pull requests never run extended steps.",
                "enum": ["ci", "extended"]
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["runner", "args"],
            "properties": {
              "runner": {
                "const": "dotnet"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "group": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "tier": {
                "description": "ci (default), or extended when the step starts an external runtime (database server, Temporal test server, browser, game server, container service, ffmpeg) or its uncached CI p50 exceeds three minutes. Pull requests never run extended steps.",
                "enum": ["ci", "extended"]
              },
              "args": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "coverageConfig": {
                "type": "string",
                "minLength": 1
              },
              "mstest": {
                "type": "object",
                "additionalProperties": false,
                "required": ["parallel", "timeoutMs"],
                "properties": {
                  "parallel": {
                    "type": "boolean"
                  },
                  "timeoutMs": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["runner", "args"],
            "properties": {
              "runner": {
                "const": "gradle"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "group": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "tier": {
                "description": "ci (default), or extended when the step starts an external runtime (database server, Temporal test server, browser, game server, container service, ffmpeg) or its uncached CI p50 exceeds three minutes. Pull requests never run extended steps.",
                "enum": ["ci", "extended"]
              },
              "args": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["runner", "name", "command"],
            "properties": {
              "runner": {
                "const": "command"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "group": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "tier": {
                "description": "ci (default) or extended; shared runs a prerequisite command in both tiers.",
                "enum": ["ci", "extended", "shared"]
              },
              "command": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    }
  }
}
