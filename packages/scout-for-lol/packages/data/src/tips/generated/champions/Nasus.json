  "general": [
    {
      "lane": "top",
      "inputHash": "2fb4e6157c03657b66106b56ae038f7cb812c13a342adaa225286bde40d1daa3",
      "tips": [
        {
          "id": "top:Nasus:general:0",
          "text": "Last-hit every minion with Siphoning Strike when it is ready. Each kill adds permanent damage, and kills on champions and large minions add the most.",
          "refs": [
            { "kind": "ability", "key": "Nasus-Q", "start": 27, "end": 43 }
          ],
          "pWrong": 0.72
        },
        {
          "id": "top:Nasus:general:1",
          "text": "Cast Wither on the enemy when they walk up or run away. It slows them more each second and cuts their Attack Speed, so keep chasing them while it ramps up.",
          "refs": [
            { "kind": "ability", "key": "Nasus-W", "start": 5, "end": 11 }
          ],
          "pWrong": 0.1
        },
        {
          "id": "top:Nasus:general:2",
          "text": "Use Spirit Fire on minion waves to farm and shred Armor. Don't push too far past your minions when you do.",
          "refs": [
            { "kind": "ability", "key": "Nasus-E", "start": 4, "end": 15 }
          ],
          "pWrong": 0.09
        },
        {
          "id": "top:Nasus:general:3",
          "text": "Cast Spirit Fire on the enemy before you trade. It deals damage over time and lowers their Armor, so your attacks hit harder.",
          "refs": [
            { "kind": "ability", "key": "Nasus-E", "start": 5, "end": 16 }
          ],
          "pWrong": 0.03
        },
        {
          "id": "top:Nasus:general:4",
          "text": "Save Fury of the Sands for a fight you plan to win. Stay close to the enemies, because the sandstorm only hurts those nearby.",
          "refs": [
            { "kind": "ability", "key": "Nasus-R", "start": 5, "end": 22 }
          ],
          "pWrong": 0.05
        },
        {
          "id": "top:Nasus:general:5",
          "text": "Use Fury of the Sands to take a fight you would lose otherwise. It gives you extra Health and resistances, and Siphoning Strike comes back sooner.",
          "refs": [
            { "kind": "ability", "key": "Nasus-R", "start": 4, "end": 21 },
            { "kind": "ability", "key": "Nasus-Q", "start": 111, "end": 127 }
          ],
          "pWrong": 0.04
        },
        {
          "id": "top:Nasus:general:6",
          "text": "Trade with Siphoning Strike when it is ready. It has extra range and your Soul Eater life steal heals you through the trade.",
          "refs": [
            { "kind": "ability", "key": "Nasus-Q", "start": 11, "end": 27 },
            {
              "kind": "ability",
              "key": "Nasus-passive",
              "start": 74,
              "end": 84
            }
          ],
          "pWrong": 0.3
        }
      ],
      "combos": []
    }
  ],
  "matchups": [
    {
