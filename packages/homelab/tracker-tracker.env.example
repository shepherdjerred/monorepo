# Tracker Tracker operator configuration.
# This file contains references and non-secret values only. Run commands with:
#
#   op run --env-file=tracker-tracker.env.example -- bun run tracker-tracker:bootstrap
#   op run --env-file=tracker-tracker.env.example -- bun run tracker-tracker:export
#
# The tracker-tracker-secrets item also supplies the Kubernetes SESSION_SECRET
# through the OnePasswordItem in the tracker-tracker namespace. qBittorrent
# credentials come from the existing qBittorrent item.

