{
  "name": "@shepherdjerred/discord-plays-web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "description": "Shared browser code for the Discord Plays game web UIs",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    "./*": "./src/*"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "PATH=node_modules/@typescript/native/bin:$PATH tsc -p tsconfig.build.json",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "lint": "eslint .",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run test/",
    "test:ci": "bun ../../scripts/ci/run-ci-test.ts"
  },
  "dependencies": {
    "@sentry/react": "^11.5.0",
    "@shepherdjerred/discord-plays-core": "workspace:*",
    "@shepherdjerred/sentry-config": "workspace:*",
    "@tailwindcss/vite": "^4.0.17",
    "@tanstack/react-query": "^5.70.0",
    "@vitejs/plugin-react": "^6.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io-client": "^4.8.1",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.0.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shepherdjerred/eslint-config": "workspace:*",
    "@types/dom-webcodecs": "^0.1.18",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "vitest": "5.0.3",
    "@vitest/coverage-istanbul": "5.0.3"
  }
}
