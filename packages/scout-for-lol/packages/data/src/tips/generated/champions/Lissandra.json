      "tips": [
        {
          "id": "middle:Lissandra:general:0",
          "text": "Aim Ice Shard so it hits a minion or enemy first; the shard then breaks and keeps flying, so enemies behind the first target are hit too.",
          "refs": [
            { "kind": "ability", "key": "Lissandra-Q", "start": 4, "end": 13 }
          ],
          "pWrong": 0.14
        },
        {
          "id": "middle:Lissandra:general:1",
          "text": "Use Ring of Frost when an enemy walks up to you; they are rooted, so your other spells land easily.",
          "refs": [
            { "kind": "ability", "key": "Lissandra-W", "start": 4, "end": 17 },
            { "kind": "keyword", "key": "rooted", "start": 58, "end": 64 }
          ],
          "pWrong": 0.11
        },
        {
          "id": "middle:Lissandra:general:2",
          "text": "Cast Glacial Path and recast it to blink to the claw. Use it to close on a target or to escape over walls.",
          "refs": [
            { "kind": "ability", "key": "Lissandra-E", "start": 5, "end": 17 }
          ],
          "pWrong": 0.04
        },
        {
          "id": "middle:Lissandra:general:3",
          "text": "Do not recast Glacial Path while you are rooted; you cannot. Save Glacial Path for when you are free to move.",
          "refs": [
            { "kind": "ability", "key": "Lissandra-E", "start": 14, "end": 26 },
            { "kind": "keyword", "key": "rooted", "start": 41, "end": 47 },
            { "kind": "ability", "key": "Lissandra-E", "start": 66, "end": 78 }
          ],
          "pWrong": 0.16
        },
        {
          "id": "middle:Lissandra:general:4",
          "text": "At level 6, cast Frozen Tomb on yourself when you are about to die. It makes you untargetable, heals you and damages and slows enemies around you.",
          "refs": [
            { "kind": "ability", "key": "Lissandra-R", "start": 17, "end": 28 },
            { "kind": "keyword", "key": "slowed", "start": 121, "end": 126 }
          ],
          "pWrong": 0.19
        },
        {
          "id": "middle:Lissandra:general:5",
          "text": "Use Frozen Tomb on a dangerous enemy to stun them and chill the area around them. Walk in range first, since you must be close to cast it.",
          "refs": [
            { "kind": "ability", "key": "Lissandra-R", "start": 4, "end": 15 }
          ],
          "pWrong": 0.44
        },
        {
          "id": "middle:Lissandra:general:6",
          "text": "Fight near fresh kills: dead enemies become Frozen Thralls that slow and then explode on nearby enemies.",
          "refs": [
            { "kind": "keyword", "key": "slowed", "start": 64, "end": 68 }
          ],
          "pWrong": 0.05
        }
      ],
      "combos": [
        {
          "id": "middle:Lissandra:combo:0",
          "name": "Wall-hop Glacial Path",
          "category": "terrain",
          "sequence": [{ "kind": "ability", "key": "Lissandra-E" }],
          "when": "When you need to escape or chase through a thin wall in the jungle or near the river.",
          "whenRefs": [],
          "text": "Cast the claw over the wall so it is at least halfway through, then recast to blink through it. The claw passes through any wall.",
          "textRefs": []
        },
        {
          "id": "middle:Lissandra:combo:1",
          "name": "Instant self-cast Tomb",
          "category": "trick",
          "sequence": [{ "kind": "ability", "key": "Lissandra-R" }],
          "when": "When you're about to be burst down, or want to dodge a dangerous spell.",
          "whenRefs": [],
          "text": "Press the self-cast key with the ultimate key at once (alt+R by default) to enter stasis instantly. This also destroys projectiles aimed at you.",
          "textRefs": []
        }
      ]
    }
  ],
