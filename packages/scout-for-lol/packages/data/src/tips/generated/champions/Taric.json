  "general": [
    {
      "lane": "support",
      "inputHash": "ecd98699abdd91e236d5de7d8b01185753115affb9ccdd35711b62302ba4a6ee",
      "tips": [
        {
          "id": "support:Taric:general:0",
          "text": "Cast an ability, then attack twice. Bravado makes those hits quick, adds magic damage and shortens your ability cooldowns.",
          "refs": [
            {
              "kind": "ability",
              "key": "Taric-passive",
              "start": 36,
              "end": 43
            }
          ],
          "pWrong": 0.02
        },
        {
          "id": "support:Taric:general:1",
          "text": "Bind your carry with Bastion and stay close. While you are linked, your abilities also come from them, so Dazzle can hit from both of you.",
          "refs": [
            { "kind": "ability", "key": "Taric-W", "start": 21, "end": 28 },
            { "kind": "ability", "key": "Taric-E", "start": 106, "end": 112 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "support:Taric:general:2",
          "text": "Aim Dazzle so the enemy is still in the beam when it bursts. The wind-up is slow, but you can keep walking while it charges.",
          "refs": [
            { "kind": "ability", "key": "Taric-E", "start": 4, "end": 10 }
          ],
          "pWrong": 0.29
        },
        {
          "id": "support:Taric:general:3",
          "text": "Use Starlight's Touch before a fight when it is full, or at low stacks to trigger Bravado more often. Hitting with Bravado attacks adds stacks.",
          "refs": [
            { "kind": "ability", "key": "Taric-Q", "start": 4, "end": 21 },
            {
              "kind": "ability",
              "key": "Taric-passive",
              "start": 82,
              "end": 89
            },
            {
              "kind": "ability",
              "key": "Taric-passive",
              "start": 115,
              "end": 122
            }
          ],
          "pWrong": 0.54
        },
        {
          "id": "support:Taric:general:4",
          "text": "Cast Cosmic Radiance as soon as you know a fight is starting. It has a delay, so waiting until someone is about to die is too late.",
          "refs": [
            { "kind": "ability", "key": "Taric-R", "start": 5, "end": 20 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "support:Taric:general:5",
          "text": "Step in with Bastion for the shield when the enemy is about to poke. It shields you and your ally and costs little to keep up.",
          "refs": [
            { "kind": "ability", "key": "Taric-W", "start": 13, "end": 20 }
          ],
          "pWrong": 1
        }
      ],
      "combos": [
        {
          "id": "support:Taric:combo:0",
          "name": "Split Dazzle",
          "category": "trick",
          "sequence": [
            { "kind": "ability", "key": "Taric-W" },
            { "kind": "ability", "key": "Taric-E" }
          ],
          "when": "When you have a tethered ally standing apart from you and want to catch an enemy who is dodging.",
          "whenRefs": [],
          "text": "Bastion makes your ally cast Dazzle too, from their own position. Keep them spread so the two beams cover different angles and are hard to sidestep.",
          "textRefs": [
            { "kind": "ability", "key": "Taric-W", "start": 0, "end": 7 },
            { "kind": "ability", "key": "Taric-E", "start": 29, "end": 35 }
          ]
        }
      ]
    }
  ],
