            { "kind": "keyword", "key": "slowed", "start": 52, "end": 57 }
          ],
          "pWrong": 0.1
        },
        {
          "id": "top:Nasus:Aatrox:1",
          "text": "Step out of the line of The Darkin Blade and stay away from the tip of each swing. The edge is where he deals the most damage and knocks you up.",
          "refs": [
            { "kind": "ability", "key": "Aatrox-Q", "start": 24, "end": 40 }
          ],
          "pWrong": 0.15
        },
        {
          "id": "top:Nasus:Aatrox:2",
          "text": "Last-hit with Siphoning Strike every time you can, and trade only when Aatrox has used his Q or dash. Each kill makes your later hits stronger.",
          "refs": [
            { "kind": "ability", "key": "Nasus-Q", "start": 14, "end": 30 },
            { "kind": "champion", "key": "Aatrox", "start": 71, "end": 77 }
          ],
          "pWrong": 0.78
        },
        {
          "id": "top:Nasus:Aatrox:3",
          "text": "Use Spirit Fire on Aatrox when he stands in the lane. It lowers his Armor, so your Siphoning Strike hits harder.",
          "refs": [
            { "kind": "ability", "key": "Nasus-E", "start": 4, "end": 15 },
            { "kind": "champion", "key": "Aatrox", "start": 19, "end": 25 },
            { "kind": "ability", "key": "Nasus-Q", "start": 83, "end": 99 }
          ],
          "pWrong": 0.16
        },
        {
          "id": "top:Nasus:Aatrox:4",
          "text": "Do not stand in the spot where Infernal Chains lands. Walk out of it quickly, toward the sides or at Aatrox, or you get pulled back.",
          "refs": [
            { "kind": "ability", "key": "Aatrox-W", "start": 31, "end": 46 },
            { "kind": "champion", "key": "Aatrox", "start": 101, "end": 107 }
          ],
          "pWrong": 0.57
        },
        {
          "id": "top:Nasus:Aatrox:5",
          "text": "Turn on Fury of the Sands when you fight him, especially at level 6. It makes you much sturdier and burns him while he stays close.",
          "refs": [
            { "kind": "ability", "key": "Nasus-R", "start": 8, "end": 25 }
          ],
          "pWrong": 0.11
        }
      ],
      "opponent": "Aatrox",
      "comboRefs": []
    },
