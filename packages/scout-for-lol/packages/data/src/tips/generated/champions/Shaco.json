      "tips": [
        {
          "id": "jungle:Shaco:general:0",
          "text": "Hit enemies from behind with basic attacks and Deceive; Backstab adds bonus damage, and Deceive then critically strikes.",
          "refs": [
            { "kind": "ability", "key": "Shaco-Q", "start": 47, "end": 54 },
            {
              "kind": "ability",
              "key": "Shaco-passive",
              "start": 56,
              "end": 64
            },
            { "kind": "ability", "key": "Shaco-Q", "start": 88, "end": 95 }
          ],
          "pWrong": 0.18
        },
        {
          "id": "jungle:Shaco:general:1",
          "text": "Use Deceive to blink over terrain when you need to escape. It also lets you get behind a target before you attack.",
          "refs": [
            { "kind": "ability", "key": "Shaco-Q", "start": 4, "end": 11 }
          ],
          "pWrong": 0.11
        },
        {
          "id": "jungle:Shaco:general:2",
          "text": "Place Jack In The Box in chokepoints and bushes on your escape route. Enemies who step on it are feared and rooted, and the trap keeps shooting them.",
          "refs": [
            { "kind": "ability", "key": "Shaco-W", "start": 6, "end": 21 },
            { "kind": "keyword", "key": "rooted", "start": 108, "end": 114 }
          ],
          "pWrong": 0.73
        },
        {
          "id": "jungle:Shaco:general:3",
          "text": "Jack In The Box hits monsters harder, so drop it on a camp and attack alongside it to clear faster.",
          "refs": [
            { "kind": "ability", "key": "Shaco-W", "start": 0, "end": 15 }
          ],
          "pWrong": 0.15
        },
        {
          "id": "jungle:Shaco:general:4",
          "text": "Throw Two-Shiv Poison at a low-health enemy to finish them; it hits harder then. Attacking while it is ready also leaves them slowed.",
          "refs": [
            { "kind": "ability", "key": "Shaco-E", "start": 6, "end": 21 },
            { "kind": "keyword", "key": "slowed", "start": 126, "end": 132 }
          ],
          "pWrong": 0.03
        },
        {
          "id": "jungle:Shaco:general:5",
          "text": "Casting Two-Shiv Poison breaks your invisibility from Deceive, so attack first and throw it afterward.",
          "refs": [
            { "kind": "ability", "key": "Shaco-E", "start": 8, "end": 23 },
            { "kind": "ability", "key": "Shaco-Q", "start": 54, "end": 61 }
          ],
          "pWrong": 0.08
        },
        {
          "id": "jungle:Shaco:general:6",
          "text": "Cast Jack In The Box while invisible. It does not break Deceive, so you can set a trap and still strike.",
          "refs": [
            { "kind": "ability", "key": "Shaco-W", "start": 5, "end": 20 },
            { "kind": "ability", "key": "Shaco-Q", "start": 56, "end": 63 }
          ],
          "pWrong": 0
        },
        {
          "id": "jungle:Shaco:general:7",
          "text": "Send the Hallucinate clone at the enemy while you stay back. When it dies it explodes and drops mini boxes that fear nearby enemies.",
          "refs": [
            { "kind": "ability", "key": "Shaco-R", "start": 9, "end": 20 }
          ],
          "pWrong": 0.13
        },
        {
          "id": "jungle:Shaco:general:8",
          "text": "Deceive has a long cooldown, so don't spend it on a fight you can't win. Keep it to escape if the fight goes badly.",
          "refs": [
            { "kind": "ability", "key": "Shaco-Q", "start": 0, "end": 7 }
          ],
          "pWrong": 0.05
        }
      ],
      "combos": [
        {
          "id": "jungle:Shaco:combo:0",
          "name": "Stealth box drop",
          "category": "trick",
          "sequence": [
            { "kind": "ability", "key": "Shaco-Q" },
            { "kind": "ability", "key": "Shaco-W" }
          ],
          "when": "Setting a trap while you are invisible during a chase or escape.",
          "whenRefs": [],
          "text": "Jack in the Box doesn't break Deceive's invisibility. Drop a box at the enemy's feet or behind you without revealing yourself.",
          "textRefs": [
            { "kind": "ability", "key": "Shaco-W", "start": 0, "end": 15 },
            { "kind": "ability", "key": "Shaco-Q", "start": 30, "end": 37 }
          ]
        },
        {
          "id": "jungle:Shaco:combo:1",
          "name": "Deceive-Hallucinate flip",
          "category": "trick",
          "sequence": [
            { "kind": "ability", "key": "Shaco-Q" },
            { "kind": "ability", "key": "Shaco-R" }
