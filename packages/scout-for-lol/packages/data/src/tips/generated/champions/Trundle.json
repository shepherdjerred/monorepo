  "general": [
    {
      "lane": "jungle",
      "inputHash": "2064956ae6a8f7138d51dbe6f320dd1ac56fbaeb74fa2dab20ce319126bb4810",
      "tips": [
        {
          "id": "jungle:Trundle:general:0",
          "text": "Fight inside Frozen Domain whenever you can. Place it where the fight will happen, then pull enemies onto it.",
          "refs": [
            { "kind": "ability", "key": "Trundle-W", "start": 13, "end": 26 }
          ],
          "pWrong": 0.03
        },
        {
          "id": "jungle:Trundle:general:1",
          "text": "Use Chomp on the enemy's main physical damage dealer. It cuts their Attack Damage and raises yours.",
          "refs": [
            { "kind": "ability", "key": "Trundle-Q", "start": 4, "end": 9 }
          ],
          "pWrong": 0.04
        },
        {
          "id": "jungle:Trundle:general:2",
          "text": "Put Pillar of Ice in a chasing enemy's path to block them; it knocks back and slows them. Use it to cut off an escape.",
          "refs": [
            { "kind": "ability", "key": "Trundle-E", "start": 4, "end": 17 },
            { "kind": "keyword", "key": "slowed", "start": 78, "end": 83 }
          ],
          "pWrong": 0.22
        },
        {
          "id": "jungle:Trundle:general:3",
          "text": "Use Subjugate on a tanky enemy in a long fight. You heal and take their defenses, or you can make them the target your team focuses.",
          "refs": [
            { "kind": "ability", "key": "Trundle-R", "start": 4, "end": 13 }
          ],
          "pWrong": 0.03
        },
        {
          "id": "jungle:Trundle:general:4",
          "text": "Stay close when enemies die in a fight. King's Tribute heals you from their maximum Health.",
          "refs": [
            {
              "kind": "ability",
              "key": "Trundle-passive",
              "start": 40,
              "end": 54
            }
          ],
          "pWrong": 0.01
        }
      ],
      "combos": [
        {
          "id": "jungle:Trundle:combo:0",
          "name": "Pillar to cut off escape",
          "category": "trick",
          "sequence": [{ "kind": "ability", "key": "Trundle-E" }],
          "when": "A fleeing enemy is running down a narrow jungle path or toward a wall.",
          "whenRefs": [],
          "text": "Place the pillar just behind the target so it blocks the path and slows them. It acts as terrain, so they have to walk around it.",
          "textRefs": []
        }
      ]
    }
  ],
