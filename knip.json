{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    ".": {
      "entry": [".buildkite/scripts/**/*.ts"],
      "project": [".buildkite/**/*.ts"]
    },
    "scripts": {
      "entry": ["*.ts", "observability/**/*.ts", "lib/image-pin-catalog.ts"],
      "project": ["**/*.ts"]
    },
    "packages/birmel": {
      "project": ["src/**/*.ts", "prisma/**/*.prisma"]
    },
    "packages/alert-dashboard": {
      "entry": [
        "src/**/*.test.ts",
        "integration/**/*.ts",
        "e2e/**/*.ts",
        "architecture-fixtures/**/*.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx,css}",
        "integration/**/*.ts",
        "e2e/**/*.ts",
        "architecture-fixtures/**/*.ts",
        "prisma/**/*.prisma",
        "*.{ts,cjs}"
      ]
    },
    "packages/architecture": {
      "entry": ["bin/*.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "bin/**/*.ts", "test/**/*.ts"]
    },
    // The architecture fixtures are deliberately unimported production-invalid
    // modules, so Knip needs them as explicit entries.
    "packages/pr-fleet-controller": {
      "entry": ["architecture-fixtures/**/*.ts"],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts",
        "architecture-fixtures/**/*.ts"
      ]
    },
    "packages/discord-plays-core": {
      "project": ["src/**/*.ts"]
    },
    "packages/eslint-config": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["eslint-import-resolver-node"]
    },
    "packages/astro-opengraph-images": {
      "entry": ["src/presets/render-examples.ts"],
      "project": ["src/**/*.{ts,tsx,astro}"]
    },
    "packages/better-skill-capped": {
      "entry": ["src/main.tsx", "src/**/*.test.ts", "vite.config.ts"],
      "project": ["src/**/*.{ts,tsx,css}"],
      "vite": false
    },
    "packages/sjer.red": {
      "entry": ["src/**/*.astro"],
      "project": ["src/**/*.{ts,tsx,astro,css,mdx,sass,scss}"]
    },
    "packages/docs/wiki": {
      "entry": ["public/posthog.js"]
    },
    "packages/glitter": {
      "entry": ["public/posthog.js"]
    },
    "packages/webring": {
      "project": ["src/**/*.ts"]
    },
    "packages/home-assistant": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/llm-models": {
      "entry": ["src/index.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/glitter-context": {
      "entry": ["src/index.ts", "test/**/*.ts", "scripts/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/llm-observability": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/starlight-karma-bot": {
      "entry": ["src/index.ts", "scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "prisma/**/*.prisma"]
    },
    "packages/homelab/src/cdk8s": {
      "entry": ["src/**/*.ts", "scripts/**/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"],
      "ignoreDependencies": ["cdk8s-cli"]
    },
    "packages/homelab/src/helm-types": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/discord-plays-pokemon/packages/backend": {
      "entry": [
        "src/**/*.test.ts",
        "scripts/**/*.ts",
        "src/goal/pokemonctl.ts"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/discord-plays-pokemon/packages/common": {
      "project": ["src/**/*.ts"]
    },
    "packages/discord-plays-pokemon/packages/frontend": {
      "entry": ["src/stories/**/*.tsx"],
      "project": ["src/**/*.{ts,tsx,css}", "*.ts"]
    },
    "packages/discord-plays-pokemon": {
      "entry": ["scripts/**/*.ts"],
      "project": ["scripts/**/*.ts"]
    },
    "packages/discord-plays-mario-kart": {
      "entry": ["scripts/**/*.ts", "wasm-src/**/*.mjs"],
      "project": ["scripts/**/*.ts", "wasm-src/**/*.mjs"]
    },
    "packages/discord-plays-mario-kart/packages/backend": {
      "entry": ["src/**/*.test.ts", "scripts/**/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "prisma/**/*.prisma"]
    },
    "packages/discord-plays-mario-kart/packages/common": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/discord-plays-mario-kart/packages/frontend": {
      "entry": ["src/**/*.test.ts", "src/stories/**/*.tsx"],
      "project": ["src/**/*.{ts,tsx,css}", "*.ts"]
    },
    "packages/scout-for-lol/packages/backend": {
      "entry": ["src/**/*.test.ts", "scripts/**/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "prisma/**/*.prisma"]
    },
    "packages/scout-for-lol/packages/data": {
      "entry": ["scripts/**/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/scout-for-lol/packages/report": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/scout-for-lol/packages/frontend": {
      "entry": [
        "src/**/*.astro",
        "src/**/*.tsx",
        "src/lib/sentry.ts",
        "src/*-stub.ts"
      ],
      "project": ["src/**/*.{ts,tsx,astro,css,mdx}"]
    },
    "packages/scout-for-lol/packages/docs-site": {
      "entry": ["src/**/*.astro", "src/**/*.tsx", "public/**/*.js"],
      "project": ["src/**/*.{ts,tsx,astro,mdx}", "*.ts", "public/**/*.js"]
    },
    "packages/scout-for-lol/packages/app": {
      "entry": ["src/**/*.test.ts", "index.html"],
      "project": ["src/**/*.{ts,tsx,css}", "*.ts"]
    },
    "packages/scout-for-lol/packages/evals": {
      "entry": ["src/scripts/**/*.ts", "src/**/*.test.ts", "e2e/**/*.ts"],
      "project": ["src/**/*.{ts,tsx,css}", "e2e/**/*.ts", "*.ts"]
    },
    "packages/scout-for-lol/packages/desktop": {
      "entry": ["src/main.tsx"],
      "project": ["src/**/*.{ts,tsx,css}"],
      "vite": false,
      "postcss": false
    },
    "packages/scout-for-lol/packages/ui": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/scout-for-lol": {
      "entry": ["scripts/**/*.ts"],
      "project": ["scripts/**/*.ts"]
    },
    "packages/cooklang-rich-preview": {
      "entry": ["src/**/*.astro"],
      "project": ["src/**/*.{ts,tsx,astro,css}", "*.ts"]
    },
    "packages/monarch": {
      "entry": ["src/**/*.test.ts", "src/lib/*/classify.ts", "scripts/**/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/stocks-sjer-red": {
      "entry": ["src/**/*.astro"],
      "project": ["src/**/*.{ts,astro,css}", "*.ts"]
    },
    "packages/streambot": {
      "entry": ["test/**/*.ts", "integration/**/*.ts", "e2e/**/*.ts"],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts",
        "integration/**/*.ts",
        "e2e/**/*.ts"
      ]
    },
    "packages/temporal": {
      "entry": ["src/**/*.test.ts", "scripts/**/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/trmnl-dashboard": {
      "entry": ["src/__tests__/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/leetcode": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/toolkit": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/tasknotes-macos": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"]
    },
    "packages/tasknotes-core": {
      "entry": ["ci/*.ts"],
      "project": ["ci/**/*.ts"]
    },
    // The Rust core and the sync server are consumed by path, not by import:
    // MSBuild compiles the core's generated C# and the tests spawn the server
    // from its directory. The workspace deps are what order turbo's graph.
    "packages/tasknotes-windows": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"],
      "ignoreDependencies": ["tasknotes-core", "tasknotes-server"]
    },
    "packages/tasknotes-e2e": {
      "ignoreDependencies": ["tasknotes-server"]
    },
    "packages/tasknotes-server": {
      "project": ["src/**/*.ts"]
    },
    "packages/tasknotes-types": {
      "project": ["src/**/*.ts"]
    },
    "packages/homelab": {
      "entry": ["scripts/**/*.ts"],
      "project": ["scripts/**/*.ts"]
    },
    "packages/discord-stream-lifecycle": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/code-review": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreExportsUsedInFile": true,
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "exports": "error",
    "optionalPeerDependencies": "error",
    "catalog": "error",
    "duplicates": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off",
    "namespaceMembers": "off",
    "unresolved": "error",
    "unlisted": "error",
    "binaries": "error"
  },
  "ignore": [
    "**/eslint.config.ts",
    "**/generated/**",
    "sandbox/archive/**",
    "sandbox/practice/**",
    "packages/resume/**",
    "packages/dotfiles/**",
    "packages/cooklang-for-obsidian/**",
    "packages/tasks-for-obsidian/**",
    "sandbox/poc/**",
    "scripts/observability/local-stack/**"
  ],
  "ignoreDependencies": [
    "@anthropic-ai/claude-agent-sdk",
    "@commitlint/types",
    "@eslint-community/eslint-plugin-eslint-comments",
    "@eslint/compat",
    "@eslint/eslintrc",
    "@eslint/js",
    "@fontsource/roboto",
    "@grafana/grafana-foundation-sdk",
    "@iconify-json/heroicons",
    "@iconify-json/mdi",
    "@iconify-json/simple-icons",
    "@libsql/client",
    "@opentelemetry/core",
    "@opentelemetry/sdk-node",
    "@opentelemetry/sdk-trace-base",
    "@opentelemetry/semantic-conventions",
    "@prisma/client",
    "@prisma/client-runtime-utils",
    "@resvg/resvg-js",
    "@scout-for-lol/data",
    "@scout-for-lol/ui",
    "@shepherdjerred/eslint-config",
    "@snazzah/davey",
    "@svgr/plugin-jsx",
    "@tailwindcss/forms",
    "@tailwindcss/postcss",
    "@tanstack/eslint-plugin-query",
    "@tauri-apps/api",
    "@tauri-apps/plugin-dialog",
    "@tauri-apps/plugin-fs",
    "@temporalio/testing",
    "@total-typescript/ts-reset",
    "@types/eslint-plugin-jsx-a11y",
    "@types/express",
    "@types/lodash",
    "@types/react",
    "@typescript-eslint/eslint-plugin",
    "@typescript-eslint/parser",
    "@typescript-eslint/utils",
    "@vitejs/plugin-react",
    "@vitejs/plugin-react-swc",
    "autoprefixer",
    "cron-parser",
    "debug",
    "eslint-config-prettier",
    "eslint-import-resolver-typescript-bun",
    "eslint-plugin-astro",
    "eslint-plugin-jsx-a11y",
    "eslint-plugin-react",
    "eslint-plugin-react-hooks",
    "eslint-plugin-react-refresh",
    "eslint-plugin-regexp",
    "eslint-plugin-unicorn",
    "express",
    "ffmpeg-static",
    "glob",
    "globals",
    "jiti",
    "keyboardjs",
    "lodash",
    "postcss",
    "prism-media",
    "react",
    "remeda",
    "sodium-native",
    "ts-morph",
    "ts-pattern",
    "tslib",
    "typescript-eslint",
    "vite-tsconfig-paths",
    "yoga-wasm-web",
    "youtubei.js",
    "zod"
  ],
  "ignoreFiles": [
    "packages/discord-plays-mario-kart/packages/frontend/src/model/connection.ts",
    "packages/discord-plays-mario-kart/packages/frontend/src/util.ts",
    "packages/discord-plays-pokemon/packages/frontend/src/util.ts",
    "packages/monarch/src/lib/costco/receipt-parser.ts"
  ],
  "ignoreIssues": {
    "packages/better-skill-capped/src/components/ui/card.tsx": ["exports"],
    "packages/discord-plays-mario-kart/packages/backend/src/observability/tracing.ts": [
      "exports"
    ],
    "packages/discord-plays-mario-kart/packages/backend/src/util.ts": [
      "exports"
    ],
    "packages/discord-plays-mario-kart/packages/frontend/src/controller-ui.tsx": [
      "exports"
    ],
    "packages/discord-plays-pokemon/packages/backend/src/emulator/audio/wav.ts": [
      "exports"
    ],
    "packages/discord-plays-pokemon/packages/backend/src/game/events/pokemon-struct.ts": [
      "exports"
    ],
    "packages/discord-plays-pokemon/packages/backend/src/discord/message-handler.ts": [
      "exports"
    ],
    "packages/discord-plays-pokemon/packages/backend/src/emulator/constants.ts": [
      "exports"
    ],
    "packages/discord-plays-pokemon/packages/backend/src/game/command/command.ts": [
      "exports"
    ],
    "packages/discord-plays-pokemon/packages/backend/src/observability/tracing.ts": [
      "exports"
    ],
    "packages/home-assistant/src/codegen/introspect.ts": ["exports"],
    "packages/monarch/src/lib/classifier/cache.ts": ["exports"],
    "packages/monarch/src/lib/classifier/claude.ts": ["exports"],
    "packages/monarch/src/lib/conservice/client.ts": ["exports"],
    "packages/monarch/src/lib/enrichment.ts": ["exports"],
    "packages/monarch/src/lib/monarch/api.ts": ["exports"],
    "packages/scout-for-lol/packages/app/src/components/ui/dialog.tsx": [
      "exports"
    ],
    "packages/scout-for-lol/packages/app/src/components/ui/dropdown-menu.tsx": [
      "exports"
    ],
    "packages/scout-for-lol/packages/app/src/components/ui/select.tsx": [
      "exports"
    ],
    "packages/scout-for-lol/packages/desktop/src/components/ui/card.tsx": [
      "exports"
    ],
    "packages/scout-for-lol/packages/frontend/src/lib/review-tool/reset-defaults.ts": [
      "exports"
    ],
    "packages/tasknotes-server/src/sentry.ts": ["exports"],
    "packages/temporal/src/observability/tracing.ts": ["exports"],
    "packages/temporal/src/workflows/ha/util.ts": ["exports"]
  },
  "ignoreBinaries": [
    "argocd",
    "buildkite-agent",
    "ffmpeg",
    "ffprobe",
    "gitleaks",
    "go",
    "golangci-lint",
    "helm",
    "kubectl",
    "mktemp",
    "op",
    "pinchtab",
    "swift",
    "swiftlint",
    "tflint",
    "uv",
    "uvx",
    "velero",
    "xcodegen"
  ]
}
