{
  "name": "@shepherdjerred/monorepo",
  "private": true,
  "scripts": {
    "verify": "turbo run build typecheck test lint check-todos check-suppressions check-patched-deps check-script-migrations markdownlint prettier shellcheck knip gitleaks jscpd quality-ratchet compliance-check lockfile-check merge-conflicts env-var-names line-endings react-version-sync large-files guard:migration ruff pyright tunnel-dns-coverage check:talos lint:helm check:1password check:test-template check:ios-native-deps check:release-bundle lint:swift check:caddyfile test:contract check:rehearsal --continue",
    "docs:board": "bun run --cwd packages/docs-board launch",
    "knip": "knip --no-config-hints",
    "markdownlint": "markdownlint-cli2 '**/*.md'",
    "markdownlint:fix": "markdownlint-cli2 --fix '**/*.md'",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "shellcheck": "bun scripts/shellcheck.ts",
    "gitleaks": "gitleaks detect --source . --no-git --redact --no-banner",
    "jscpd": "jscpd",
    "quality-ratchet": "bun scripts/quality-ratchet.ts",
    "compliance-check": "bash scripts/compliance-check.sh",
    "lockfile-check": "bun install --frozen-lockfile --dry-run",
    "merge-conflicts": "bun scripts/check-merge-conflicts.ts",
    "env-var-names": "bun scripts/check-env-var-names.ts",
    "line-endings": "bun scripts/check-line-endings.ts",
    "react-version-sync": "bun scripts/check-react-version-sync.ts",
    "large-files": "bun scripts/check-large-files.ts",
    "guard:migration": "bun run scripts/guard-no-package-exclusions.ts",
    "ruff": "uvx ruff check .",
    "pyright": "bun scripts/pyright-check.ts",
    "tunnel-dns-coverage": "bun scripts/check-tunnel-dns-coverage.ts",
    "check-todos": "bun run packages/docs-board/src/cli/check-docs.ts",
    "check-suppressions": "bun scripts/check-suppressions.ts",
    "check-patched-deps": "bun scripts/check-patched-deps.ts",
    "check-script-migrations": "bun scripts/check-script-migrations.ts"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "jscpd": "5.0.12",
    "knip": "6.17.1",
    "lefthook": "^2.1.10",
    "markdownlint-cli2": "^0.23.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "turbo": "2.10.5"
  },
  "workspaces": [
    "packages/astro-opengraph-images",
    "packages/better-skill-capped",
    "packages/birmel",
    "packages/code-review",
    "packages/cooklang-for-obsidian",
    "packages/cooklang-rich-preview",
    "packages/discord-plays-core",
    "packages/discord-plays-mario-kart/packages/backend",
    "packages/discord-plays-mario-kart/packages/common",
    "packages/discord-plays-mario-kart/packages/frontend",
    "packages/discord-plays-pokemon/packages/backend",
    "packages/discord-plays-pokemon/packages/common",
    "packages/discord-plays-pokemon/packages/frontend",
    "packages/discord-stream-lifecycle",
    "packages/discord-video-stream",
    "packages/docs-board",
    "packages/eslint-config",
    "packages/glitter",
    "packages/glitter-context",
    "packages/home-assistant",
    "packages/homelab",
    "packages/homelab/src/cdk8s",
    "packages/homelab/src/helm-types",
    "packages/leetcode",
    "packages/llm-models",
    "packages/llm-observability",
    "packages/monarch",
    "packages/release-tools",
    "packages/resume",
    "packages/scout-for-lol",
    "packages/scout-for-lol/packages/app",
    "packages/scout-for-lol/packages/backend",
    "packages/scout-for-lol/packages/data",
    "packages/scout-for-lol/packages/desktop",
    "packages/scout-for-lol/packages/desktop/src-tauri",
    "packages/scout-for-lol/packages/frontend",
    "packages/scout-for-lol/packages/report",
    "packages/scout-for-lol/packages/ui",
    "packages/sjer.red",
    "packages/starlight-karma-bot",
    "packages/stocks-sjer-red",
    "packages/streambot",
    "packages/tasknotes-server",
    "packages/tasknotes-types",
    "packages/tasks-for-obsidian",
    "packages/temporal",
    "packages/terraform-provider-asuswrt",
    "packages/toolkit",
    "packages/trmnl-dashboard",
    "packages/webring",
    "scripts"
  ],
  "overrides": {
    "@anthropic-ai/claude-agent-sdk": "0.3.183",
    "@grpc/grpc-js": "1.14.4",
    "@opentelemetry/api": "1.9.1",
    "@typescript-eslint/eslint-plugin": "8.61.1",
    "@typescript-eslint/parser": "8.61.1",
    "@typescript-eslint/utils": "8.61.1",
    "axios": "1.18.0",
    "@opentelemetry/propagator-jaeger": "2.9.0",
    "@opentelemetry/core": "2.10.0",
    "fast-xml-parser": "5.10.1",
    "js-yaml": "4.3.0",
    "linkify-it": "5.0.2",
    "svgo": "4.0.2",
    "devalue": "5.8.1",
