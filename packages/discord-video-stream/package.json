{
  "name": "@shepherdjerred/discord-video-stream",
  "version": "6.0.0-fork.0",
  "description": "Monorepo fork of @dank074/discord-video-stream with a seekable player and a bun-safe lazy sharp import",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/*",
      "default": "./src/*"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "PATH=node_modules/@typescript/native/bin:$PATH tsc -p tsconfig.build.json",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "test": "bun test",
    "test:ci": "bun ../../scripts/run-ci-test.ts"
  },
  "dependencies": {
    "@lng2004/node-datachannel": "0.32.0-20260202",
    "@snazzah/davey": "^0.1.8",
    "debug-level": "^4.1.1",
    "node-av": "^6.1.1",
    "p-debounce": "^5.1.0",
    "sharp": "^0.35.0",
    "zeromq": "^6.5.0"
  },
  "peerDependencies": {
    "discord.js-selfbot-v13": "^3.6.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^26.1.1",
    "discord.js-selfbot-v13": "^3.7.1",
    "ffmpeg-static": "^5.3.0",
    "typescript": "^6.0.3",
    "@typescript/native": "npm:typescript@7.0.2"
  }
}
