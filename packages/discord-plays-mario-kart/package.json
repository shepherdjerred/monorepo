{
  "name": "@shepherdjerred/discord-plays-mario-kart-scripts",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "test": "bun --no-install --bun vitest --config ../../vitest.config.ts run scripts/build-wasm.test.ts scripts/vendor-n64wasm.test.ts scripts/migration-smoke.test.ts",
    "test:coverage": "bun --no-install --bun vitest --config ../../vitest.config.ts run --coverage.reporter=text --coverage.reporter=lcovonly --coverage.reportsDirectory=coverage --coverage scripts/build-wasm.test.ts scripts/vendor-n64wasm.test.ts --coverage.thresholds.lines=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90",
    "lint": "eslint --config eslint.config.ts scripts",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "build:wasm": "bun scripts/build-wasm.ts",
    "vendor:wasm": "bun scripts/vendor-n64wasm.ts",
    "test:ci": "bun ../../scripts/run-ci-test.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../scripts/run-ci-test.ts"
  },
  "devDependencies": {
    "@shepherdjerred/eslint-config": "workspace:*",
    "@types/bun": "1.4.0",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "zod": "^4.4.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "vitest": "4.1.9",
    "@vitest/coverage-istanbul": "4.1.9"
  }
}
