  "general": [
    {
      "lane": "jungle",
      "inputHash": "5c5d9d85d2e82f6840bf46518bf610c16fcf7165f4d8a6034e7118213321ca17",
      "tips": [
        {
          "id": "jungle:Zac:general:0",
          "text": "Walk over the goo chunks that drop after each hit; picking them up heals you and keeps you in the fight.",
          "refs": [],
          "pWrong": 0.07
        },
        {
          "id": "jungle:Zac:general:1",
          "text": "Charge Elastic Slingshot out of sight, such as from the fog of war, so the enemy has little time to react before they are knocked up.",
          "refs": [
            { "kind": "ability", "key": "Zac-E", "start": 7, "end": 24 },
            { "kind": "keyword", "key": "knocked-up", "start": 122, "end": 132 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "jungle:Zac:general:2",
          "text": "Hold the Elastic Slingshot charge a little longer when you can; a longer charge keeps enemies knocked up for longer.",
          "refs": [
            { "kind": "ability", "key": "Zac-E", "start": 9, "end": 26 },
            { "kind": "keyword", "key": "knocked-up", "start": 94, "end": 104 }
          ],
          "pWrong": 0.56
        },
        {
          "id": "jungle:Zac:general:3",
          "text": "Use Stretching Strikes on one enemy, then attack a different one to pull them together and hit everyone nearby.",
          "refs": [
            { "kind": "ability", "key": "Zac-Q", "start": 4, "end": 22 }
          ],
          "pWrong": 0.16
        },
        {
          "id": "jungle:Zac:general:4",
          "text": "Use Unstable Matter often in fights; every chunk you pick up shortens its cooldown, and it hurts high-health targets more.",
          "refs": [
            { "kind": "ability", "key": "Zac-W", "start": 4, "end": 19 }
          ],
          "pWrong": 0.15
        },
        {
          "id": "jungle:Zac:general:5",
          "text": "Cast Let's Bounce! to start a fight or finish one; you can still move and use Unstable Matter while bouncing, and you pick up chunks as you go.",
          "refs": [
            { "kind": "ability", "key": "Zac-R", "start": 5, "end": 18 },
            { "kind": "ability", "key": "Zac-W", "start": 78, "end": 93 }
          ],
          "pWrong": 0.16
        },
        {
          "id": "jungle:Zac:general:6",
          "text": "When Cell Division is ready and you are about to die, fall where the enemy cannot easily reach your bloblets, since they must survive to revive you.",
          "refs": [
            { "kind": "ability", "key": "Zac-passive", "start": 5, "end": 18 }
          ],
          "pWrong": 0.06
        },
        {
          "id": "jungle:Zac:general:7",
          "text": "Do not charge Elastic Slingshot in front of enemies with a stun, silence or knock up; those interrupt the charge.",
          "refs": [
            { "kind": "ability", "key": "Zac-E", "start": 14, "end": 31 },
            { "kind": "keyword", "key": "stunned", "start": 59, "end": 63 },
            { "kind": "keyword", "key": "silenced", "start": 65, "end": 72 },
            { "kind": "keyword", "key": "knocked-up", "start": 76, "end": 84 }
          ],
          "pWrong": 0.17
        }
      ],
      "combos": []
    }
  ],
