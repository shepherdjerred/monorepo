      "tips": [
        {
          "id": "top:Kennen:general:0",
          "text": "Open a trade with Thundering Shuriken, then use Electrical Surge to add a second Mark of the Storm. A third mark stuns, so finish with another ability.",
          "refs": [
            { "kind": "ability", "key": "Kennen-Q", "start": 18, "end": 37 },
            { "kind": "ability", "key": "Kennen-W", "start": 48, "end": 64 },
            {
              "kind": "ability",
              "key": "Kennen-passive",
              "start": 81,
              "end": 98
            }
          ],
          "pWrong": 0.58
        },
        {
          "id": "top:Kennen:general:1",
          "text": "Aim Thundering Shuriken carefully; it stops at the first enemy it hits, so minions in the way will soak it up.",
          "refs": [
            { "kind": "ability", "key": "Kennen-Q", "start": 4, "end": 23 }
          ],
          "pWrong": 0.35
        },
        {
          "id": "top:Kennen:general:2",
          "text": "Start a fight with Lightning Rush. It damages the enemy and gives back Energy, so you can keep casting afterward.",
          "refs": [
            { "kind": "ability", "key": "Kennen-E", "start": 19, "end": 33 }
          ],
          "pWrong": 0.03
        },
        {
          "id": "top:Kennen:general:3",
          "text": "Press Lightning Rush again to end it early when you want to start hitting; you gain Attack Speed afterward.",
          "refs": [
            { "kind": "ability", "key": "Kennen-E", "start": 6, "end": 20 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "top:Kennen:general:4",
          "text": "Keep hitting the enemy with basic attacks between spells; every few attacks, Electrical Surge adds a bonus hit and a Mark of the Storm.",
          "refs": [
            { "kind": "ability", "key": "Kennen-W", "start": 77, "end": 93 },
            {
              "kind": "ability",
              "key": "Kennen-passive",
              "start": 117,
              "end": 134
            }
          ],
          "pWrong": 0.19
        },
        {
          "id": "top:Kennen:general:5",
          "text": "Use Slicing Maelstrom when several enemies are close to you in a fight. It also makes you tankier while it lasts.",
          "refs": [
            { "kind": "ability", "key": "Kennen-R", "start": 4, "end": 21 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "top:Kennen:general:6",
          "text": "Don't chase a stunned enemy twice in a row; the stun is much shorter if the same target is stunned again soon.",
          "refs": [
            { "kind": "keyword", "key": "stunned", "start": 14, "end": 21 },
            { "kind": "keyword", "key": "stunned", "start": 48, "end": 52 },
            { "kind": "keyword", "key": "stunned", "start": 91, "end": 98 }
          ],
          "pWrong": 0.3
        }
      ],
      "combos": [
        {
          "id": "top:Kennen:combo:0",
