    "@scout-for-lol/report": "workspace:*",
    "@sentry/react": "^10.0.0",
    "@tanstack/react-query": "^5.62.0",
    "@trpc/client": "^11.17.0",
    "@trpc/tanstack-react-query": "^11.17.0",
    "clsx": "^2.1.1",
    "echarts": "^6.0.0",
    "lucide-react": "^1.14.0",
    "monaco-editor": "^0.56.0",
    "posthog-js": "^1.414.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
