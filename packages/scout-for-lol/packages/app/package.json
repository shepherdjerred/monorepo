    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "vitest": "4.1.9",
    "@vitest/coverage-istanbul": "4.1.9"
  }
