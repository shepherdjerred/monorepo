+static BOOL xsd_imports_namespace(xmlNodePtr root, const xmlChar *uri)
+{
+    xmlNodePtr child;
+
+    for (child = xmlFirstElementChild(root); child; child = xmlNextElementSibling(child))
+    {
+        xmlChar *ns;
+        BOOL found;
+
+        if (!xmlStrEqual(child->name, BAD_CAST "import")) continue;
+        ns = xmlGetProp(child, BAD_CAST "namespace");
+        found = xmlStrEqual(ns ? ns : BAD_CAST "", uri);
+        xmlFree(ns);
+        if (found) return TRUE;
+    }
+    return FALSE;
+}
+
+static void LIBXML2_LOG_CALLBACK ignore_regexp_error(void *ctx, char const *msg, ...)
+{
+}
+
+static xmlRegexpPtr compile_pattern_quietly(const xmlChar *pattern)
+{
+    xmlGenericErrorFunc error_func = xmlGenericError;
+    void *error_context = xmlGenericErrorContext;
+    xmlRegexpPtr regexp;
+
+    xmlSetGenericErrorFunc(NULL, ignore_regexp_error);
+    regexp = xmlRegexpCompile(pattern);
+    xmlSetGenericErrorFunc(error_context, error_func);
+    return regexp;
+}
+
+/* MSXML accepts QName values with surrounding whitespace or whitespace between
+ * the prefix and the local name, and pattern facets written in its own regular
+ * expression dialect. libxml2 cannot express some of those patterns, so they
+ * are dropped rather than failing the whole collection. */
+static void normalize_xsd_node(xmlNodePtr node)
+{
+    static const char *qname_attrs[] = { "type", "ref", "base", "itemType", "substitutionGroup" };
+    xmlNodePtr child, next;
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(qname_attrs); i++)
+    {
+        xmlChar *value = xmlGetNoNsProp(node, BAD_CAST qname_attrs[i]);
+        xmlChar *src, *dst;
+        BOOL changed = FALSE;
+
+        if (!value) continue;
+        for (src = dst = value; *src; src++)
+        {
+            if (IS_BLANK_CH(*src))
+            {
+                changed = TRUE;
+                continue;
+            }
+            *dst++ = *src;
+        }
+        *dst = 0;
+        if (changed) xmlSetProp(node, BAD_CAST qname_attrs[i], value);
+        xmlFree(value);
+    }
+
+    for (child = xmlFirstElementChild(node); child; child = next)
+    {
+        next = xmlNextElementSibling(child);
+        if (xmlStrEqual(child->name, BAD_CAST "pattern"))
+        {
+            xmlChar *value = xmlGetNoNsProp(child, BAD_CAST "value");
+            xmlRegexpPtr regexp = value ? compile_pattern_quietly(value) : NULL;
+
+            if (regexp) xmlRegFreeRegexp(regexp);
+            else
+            {
+                WARN("ignoring pattern %s\n", debugstr_a((const char *)value));
+                xmlUnlinkNode(child);
+                xmlFreeNode(child);
+            }
+            xmlFree(value);
+            continue;
+        }
+        normalize_xsd_node(child);
+    }
+}
+
+static xmlNodePtr xsd_find_complex_type(xmlNodePtr root, const xmlChar *qname)
+{
+    const xmlChar *name = xmlStrchr(qname, ':') ? xmlStrchr(qname, ':') + 1 : qname;
+    xmlNodePtr child;
+    xmlChar *value;
+    BOOL found;
+
+    for (child = xmlFirstElementChild(root); child; child = xmlNextElementSibling(child))
+    {
+        if (!xmlStrEqual(child->name, BAD_CAST "complexType")) continue;
+        value = xmlGetNoNsProp(child, BAD_CAST "name");
+        found = xmlStrEqual(value, name);
+        xmlFree(value);
+        if (found) return child;
+    }
+    return NULL;
+}
+
+static BOOL xsd_type_declares_attribute(xmlNodePtr root, xmlNodePtr type, const xmlChar *attr, int depth)
+{
+    xmlNodePtr content, extension, child;
+    xmlChar *value;
+    BOOL found = FALSE;
+
+    if (!type || depth > 32) return FALSE;
+    for (child = xmlFirstElementChild(type); child && !found; child = xmlNextElementSibling(child))
+    {
+        if (!xmlStrEqual(child->name, BAD_CAST "attribute")) continue;
+        value = xmlGetNoNsProp(child, BAD_CAST "name");
+        found = xmlStrEqual(value, attr);
+        xmlFree(value);
+    }
+    if (found) return TRUE;
+
+    for (content = xmlFirstElementChild(type); content; content = xmlNextElementSibling(content))
+    {
+        if (!xmlStrEqual(content->name, BAD_CAST "complexContent")) continue;
+        for (extension = xmlFirstElementChild(content); extension; extension = xmlNextElementSibling(extension))
+        {
+            if (!xmlStrEqual(extension->name, BAD_CAST "extension")) continue;
+            if (xsd_type_declares_attribute(root, extension, attr, depth + 1)) return TRUE;
+            value = xmlGetNoNsProp(extension, BAD_CAST "base");
+            found = value && xsd_type_declares_attribute(root, xsd_find_complex_type(root, value), attr, depth + 1);
+            xmlFree(value);
+            if (found) return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+/* MSXML ignores an extension redeclaring an attribute its base type declares. */
+static void xsd_remove_inherited_attributes(xmlNodePtr root, xmlNodePtr node)
+{
+    xmlNodePtr child, next;
+
+    for (child = xmlFirstElementChild(node); child; child = next)
+    {
+        next = xmlNextElementSibling(child);
+
+        if (xmlStrEqual(child->name, BAD_CAST "extension"))
+        {
+            xmlChar *base = xmlGetNoNsProp(child, BAD_CAST "base");
+            xmlNodePtr base_type = base ? xsd_find_complex_type(root, base) : NULL;
+            xmlNodePtr attr, next_attr;
+
+            for (attr = xmlFirstElementChild(child); base_type && attr; attr = next_attr)
+            {
+                xmlChar *name;
+
+                next_attr = xmlNextElementSibling(attr);
+                if (!xmlStrEqual(attr->name, BAD_CAST "attribute")) continue;
+                name = xmlGetNoNsProp(attr, BAD_CAST "name");
+                if (name && xsd_type_declares_attribute(root, base_type, name, 0))
+                {
+                    WARN("ignoring redeclared attribute %s\n", debugstr_a((const char *)name));
+                    xmlUnlinkNode(attr);
+                    xmlFreeNode(attr);
+                }
+                xmlFree(name);
+            }
+            xmlFree(base);
+        }
+        xsd_remove_inherited_attributes(root, child);
+    }
 }
 
+static xmlDocPtr xsd_doc_with_cache_imports(schema_cache *cache, xmlDocPtr doc)
+{
+    xmlDocPtr copy = xmlCopyDoc(doc, 1);
+    xmlNodePtr root = xmlDocGetRootElement(copy), import, first;
+    xmlChar *target = xmlGetProp(root, BAD_CAST "targetNamespace");
+    char url[sizeof(CACHE_SCHEMA_URL) + 12];
+    int i;
+
+    normalize_xsd_node(root);
+    xsd_remove_inherited_attributes(root, root);
+
+    for (i = 0; i < cache->count; i++)
+    {
+        const xmlChar *uri = cache->uris[i];
+        cache_entry *entry = xmlHashLookup(cache->cache, uri);
+
+        if (!entry || entry->type != CacheEntryType_XSD) continue;
+        if (xmlStrEqual(uri, target ? target : BAD_CAST "")) continue;
+        if (xsd_imports_namespace(root, uri)) continue;
+
+        sprintf(url, CACHE_SCHEMA_URL "%d", i);
+        import = xmlNewDocNode(copy, root->ns, BAD_CAST "import", NULL);
+        if (*uri) xmlSetProp(import, BAD_CAST "namespace", uri);
+        xmlSetProp(import, BAD_CAST "schemaLocation", BAD_CAST url);
+        if ((first = xmlFirstElementChild(root))) xmlAddPrevSibling(first, import);
+        else xmlAddChild(root, import);
+    }
+
+    xmlFree(target);
+    return copy;
+}
+
+static xmlParserInputPtr cached_schema_input(const char *URL, xmlParserCtxtPtr ctxt)
+{
+    struct deferred_compile *compile = deferred_compile;
+    cache_entry *entry;
+    xmlChar *buffer, **buffers;
+    xmlNodePtr node, next;
+    xmlDocPtr doc;
+    int index, size;
+
+    if (!compile) return NULL;
+    index = atoi(URL + sizeof(CACHE_SCHEMA_URL) - 1);
+    if (index < 0 || index >= compile->cache->count) return NULL;
+    if (!(entry = xmlHashLookup(compile->cache->cache, compile->cache->uris[index]))) return NULL;
+
+    doc = xsd_doc_with_cache_imports(compile->cache, entry->doc);
+    /* the DOM keeps the XML declaration as a processing instruction */
+    for (node = doc->children; node; node = next)
+    {
+        next = node->next;
+        if (node->type == XML_PI_NODE && xmlStrEqual(node->name, BAD_CAST "xml"))
+        {
+            xmlUnlinkNode(node);
+            xmlFreeNode(node);
+        }
+    }
+    xmlDocDumpMemoryEnc(doc, &buffer, &size, "UTF-8");
+    xmlFreeDoc(doc);
+    if (!buffer) return NULL;
+
+    if (!(buffers = realloc(compile->buffers, (compile->count + 1) * sizeof(*buffers))))
+    {
+        xmlFree(buffer);
+        return NULL;
+    }
+    compile->buffers = buffers;
+    compile->buffers[compile->count++] = buffer;
+    return xmlNewStringInputStream(ctxt, buffer);
+}
+
+static void compile_deferred_entry(schema_cache *cache, cache_entry *entry)
+{
+    struct deferred_compile compile = { cache };
+    xmlSchemaParserCtxtPtr spctx;
+    xmlDocPtr doc;
+    int i;
+
+    EnterCriticalSection(&deferred_cs);
+    deferred_compile = &compile;
+    doc = xsd_doc_with_cache_imports(cache, entry->doc);
+    spctx = xmlSchemaNewDocParserCtxt(doc);
+    entry->schema = Schema_parse(spctx);
+    xmlSchemaFreeParserCtxt(spctx);
+    deferred_compile = NULL;
+    LeaveCriticalSection(&deferred_cs);
+
+    for (i = 0; i < compile.count; i++) xmlFree(compile.buffers[i]);
+    free(compile.buffers);
+
+    if (entry->schema) entry->compiled_doc = doc;
+    else xmlFreeDoc(doc);
+}
+
 static inline xmlSchemaPtr get_node_schema(schema_cache* This, xmlNodePtr node)
 {
     cache_entry* entry = get_entry(This, get_node_nsURI(node));
-    return (!entry)? NULL : entry->schema;
+    if (!entry) return NULL;
+    if (!entry->schema && entry->type == CacheEntryType_XSD) compile_deferred_entry(This, entry);
+    return entry->schema;
 }
 
