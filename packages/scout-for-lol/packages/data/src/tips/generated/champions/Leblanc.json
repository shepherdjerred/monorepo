  "general": [
    {
      "lane": "middle",
      "inputHash": "c39090c4fbefe8f10bcf45ce7354f6a9e5eac371bbabfebe782b957129743998",
      "tips": [
        {
          "id": "middle:Leblanc:general:0",
          "text": "Use Distortion to dash in, trade, then recast it to return to safety. Recast within its short window or you are stuck where you landed.",
          "refs": [
            { "kind": "ability", "key": "Leblanc-W", "start": 4, "end": 14 }
          ],
          "pWrong": 0.04
        },
        {
          "id": "middle:Leblanc:general:1",
          "text": "Open a trade with Sigil of Malice, then hit the marked enemy with another ability to set off the mark for extra damage.",
          "refs": [
            { "kind": "ability", "key": "Leblanc-Q", "start": 18, "end": 33 }
          ],
          "pWrong": 0.04
        },
        {
          "id": "middle:Leblanc:general:2",
          "text": "Aim Ethereal Chains at the first enemy in its path, since a minion in the way takes the chain instead. Keep the line clear of minions.",
          "refs": [
            { "kind": "ability", "key": "Leblanc-E", "start": 4, "end": 19 }
          ],
          "pWrong": 0.12
        },
        {
          "id": "middle:Leblanc:general:3",
          "text": "After Ethereal Chains lands, stay close so the tether holds. If it lasts, the enemy is rooted and takes extra damage.",
          "refs": [
            { "kind": "ability", "key": "Leblanc-E", "start": 6, "end": 21 },
            { "kind": "keyword", "key": "rooted", "start": 87, "end": 93 }
          ],
          "pWrong": 0.34
        },
        {
          "id": "middle:Leblanc:general:4",
          "text": "Use Distortion to line up Ethereal Chains, since the dash changes your position.",
          "refs": [
            { "kind": "ability", "key": "Leblanc-W", "start": 4, "end": 14 },
            { "kind": "ability", "key": "Leblanc-E", "start": 26, "end": 41 }
          ],
          "pWrong": 0
        },
        {
          "id": "middle:Leblanc:general:5",
          "text": "Use Sigil of Malice then Ethereal Chains on an enemy with a blink to stop them escaping.",
          "refs": [
            { "kind": "ability", "key": "Leblanc-Q", "start": 4, "end": 19 },
            { "kind": "ability", "key": "Leblanc-E", "start": 25, "end": 40 }
          ],
          "pWrong": 0.09
        },
        {
          "id": "middle:Leblanc:general:6",
          "text": "Save Mimic for a kill. It copies your last ability with more damage, so use your best one right before it.",
          "refs": [
            { "kind": "ability", "key": "Leblanc-R", "start": 5, "end": 10 }
          ],
          "pWrong": 0.45
        },
        {
          "id": "middle:Leblanc:general:7",
          "text": "Use Sigil of Malice on low-health enemies. A kill refunds its Mana and part of its cooldown, so you can chain it again.",
          "refs": [
            { "kind": "ability", "key": "Leblanc-Q", "start": 4, "end": 19 }
          ],
          "pWrong": 0.05
        },
        {
          "id": "middle:Leblanc:general:8",
          "text": "Do not fall back on Mirror Image to survive. It hides you only briefly, and attacking breaks it.",
          "refs": [
            {
              "kind": "ability",
              "key": "Leblanc-passive",
              "start": 20,
              "end": 32
            }
          ],
          "pWrong": 0.51
        }
      ],
      "combos": [
        {
          "id": "middle:Leblanc:combo:0",
          "name": "Slide-in Distortion return",
          "category": "trick",
          "sequence": [
            { "kind": "ability", "key": "Leblanc-Q" },
            { "kind": "ability", "key": "Leblanc-W" },
            { "kind": "ability", "key": "Leblanc-W" }
          ],
          "when": "When you trade in lane and want to poke and then get back out of danger.",
          "whenRefs": [],
          "text": "Mark the target, dash in with W to detonate it, and recast W to return to your starting spot. The dash is aggressive and the return keeps you safe.",
          "textRefs": [
            { "kind": "summoner-spell", "key": "32", "start": 0, "end": 4 }
          ]
        }
      ]
    }
  ],
