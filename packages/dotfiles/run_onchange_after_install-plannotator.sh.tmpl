{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash

set -euo pipefail

# Plannotator is the plan- and code-review layer for coding agents. Three pieces,
# deliberately kept apart:
#
#   1. the binary, installed here with --minimal so the upstream installer writes
#      nothing outside ~/.local/bin — no hooks, skills, or per-agent config;
#   2. the Claude Code integration, which ships as a Claude Code plugin and
#      therefore never touches ~/.claude/settings.json (that file is generated by
#      claude-managed/install-managed-settings.sh and would clobber such edits);
#   3. the Codex integration, which is an ordinary chezmoi-managed file —
#      private_dot_codex/private_hooks.json, with [features] hooks = true already
#      set in private_config.toml.
#
# Letting the upstream installer wire 2 and 3 itself would fight both of those
# owners, which is why --minimal is not optional here.
plannotator_version="v0.27.15"

# The installer is served only from plannotator.ai, a mutable URL with no tagged
# copy in the GitHub repo, so pin its digest: an upstream change fails here and
# gets re-reviewed rather than executing unreviewed. Bumping plannotator_version
# means re-reading the installer and updating this digest in the same change.
installer_url="https://plannotator.ai/install.sh"
installer_sha256="df4170473178791deed11849f01c84d9e791263d9064de812e1dfc880aee5e96"

# Marketplace and plugin are both named "plannotator"; the plugin carries the
# EnterPlanMode and ExitPlanMode hooks that open the review UI.
claude_marketplace="backnotprop/plannotator"
claude_plugin="plannotator@plannotator"

installed_version=""
if command -v plannotator >/dev/null 2>&1; then
  installed_version="v$(plannotator --version | awk '{print $2}')"
fi

if [ "$installed_version" = "$plannotator_version" ]; then
  printf 'Plannotator %s already installed\n' "$plannotator_version"
else
  installer="$(mktemp)"
  trap 'rm -f "$installer"' EXIT
  curl -fsSL "$installer_url" -o "$installer"

  actual_sha256="$(shasum -a 256 "$installer" | awk '{print $1}')"
  if [ "$actual_sha256" != "$installer_sha256" ]; then
    printf 'Plannotator installer digest changed.\n' >&2
    printf '  expected: %s\n' "$installer_sha256" >&2
    printf '  actual:   %s\n' "$actual_sha256" >&2
    printf 'Re-read %s and update the pin before installing.\n' "$installer_url" >&2
    exit 1
  fi

  # --verify-attestation checks the binary's SLSA build provenance through the
  # public attestations API, which needs no credentials.
  bash "$installer" --minimal --version "$plannotator_version" --verify-attestation
fi

# Capture listings before matching: piping into `grep -q` under `pipefail` fails
# the pipeline, because grep exits on the first match and the producer takes a
# SIGPIPE.
marketplaces="$(claude plugin marketplace list)"
if [[ $marketplaces != *"$claude_marketplace"* ]]; then
  claude plugin marketplace add "$claude_marketplace"
fi

plugins="$(claude plugin list)"
if [[ $plugins != *"$claude_plugin"* ]]; then
  claude plugin install "$claude_plugin"
fi

# Clean up retired unofficial wrappers and hook registrations from earlier installs
rm -f \
  "$HOME/.grok/hooks/plannotator.json" \
  "$HOME/.local/bin/plannotator-antigravity-stop-hook" \
  "$HOME/.local/bin/plannotator-cursor-session-end-hook"
{{- end -}}

