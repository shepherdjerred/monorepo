{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // homelab has no build script, so this is a transit task whose hash every
    // TypeScript consumer (temporal, cdk8s) inherits through ^build. They import
    // only scripts/** and top-level src modules (homelab-build-inputs.test.ts
    // proves those import nothing else), so Talos, OpenTofu, Helm and image
    // edits no longer re-run their suites.
    "build": {
      "inputs": [
        "package.json",
        "tsconfig*.json",
        "scripts/**",
        "src/*.ts",
        "src/*.json"
      ]
    },
    // The pinned Talos installer in patches/image.yaml must match what the
    // image.yaml schematic produces (old CI: talos-schematic-sync).
    "check:talos": {
      "inputs": ["src/talos/**"]
    },
    // Helm chart lint over the cdk8s synth output (old CI: homelab-helm-lint).
    // Ordered after the synth so it never reads a half-written dist/.
    "lint:helm": {
      "dependsOn": ["@homelab/cdk8s#build"],
      "inputs": [
        "scripts/helm/lint-helm.ts",
        "src/cdk8s/**",
        "!src/cdk8s/node_modules/**",
        "!src/cdk8s/dist/**"
      ]
    },
    // tflint (bundled terraform ruleset, repo-owned empty config, offline)
    // over every src/tofu stack.
    "lint:tofu": {
      "inputs": ["src/tofu/**", "scripts/tofu/lint-tofu.ts", ".tflint.hcl"]
    },
    // kubeconform validation of the cdk8s synth output. Ordered after the
    // synth (like lint:helm) so it reads the final, patched dist/.
    "check:kubeconform": {
      "dependsOn": ["@homelab/cdk8s#build"],
      "inputs": [
        "scripts/check-kubeconform.ts",
        "src/cdk8s/**",
        "!src/cdk8s/node_modules/**",
        "!src/cdk8s/dist/**"
      ]
    }
  }
}
