---
import publication from "@shepherdjerred/glitter-boys-launcher/published-release.json";
import { parsePublicationRecord } from "@shepherdjerred/glitter-boys-launcher/publication";
const { release } = parsePublicationRecord(publication);
---

{release ? (
  <p>
    <a class="download" href={release.installer.url} download>
      Download for Windows
    </a>
    <br />
    <small>
      Version {release.version} · Windows 10/11, 64-bit · Publisher: Jerred
      Shepherd
    </small>
  </p>
) : (
  <p>Ask Jerred for the Windows installer.</p>
)}
<style>
  .download {
    display: inline-block;
    padding: 0.65rem 1rem;
    border-radius: 0.4rem;
    background: var(--sl-color-text-accent);
    color: var(--sl-color-bg);
    font-weight: 700;
    text-decoration: none;
  }
  .download:focus-visible {
    outline: 3px solid var(--sl-color-text);
    outline-offset: 3px;
  }
  small {
    color: var(--sl-color-gray-2);
  }
</style>
