            { "kind": "ability", "key": "Zoe-Q" },
            "attack"
          ],
          "when": "After the bubble lands and the enemy is falling asleep.",
          "whenRefs": [],
          "text": "Wait for the sleep, then hit with a long-travel star as the big wake-up hit for double damage. Finish with the empowered attack.",
          "textRefs": []
        }
      ]
