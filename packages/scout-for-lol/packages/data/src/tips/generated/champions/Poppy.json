  "general": [
    {
      "lane": "support",
      "inputHash": "b51418db3436c1967a92a37a42550cd5295dbc07f51650f46c11c3087ad03518",
      "tips": [
        {
          "id": "support:Poppy:general:0",
          "text": "Look for walls when you use Heroic Charge. If you carry the enemy into terrain they are stunned and take extra damage, which sets up your carry's follow-up.",
          "refs": [
            { "kind": "ability", "key": "Poppy-E", "start": 28, "end": 41 },
            { "kind": "keyword", "key": "stunned", "start": 88, "end": 95 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "support:Poppy:general:1",
          "text": "Save Steadfast Presence for an enemy who is about to dash at you or your carry. It stops the dash and leaves them slowed.",
          "refs": [
            { "kind": "ability", "key": "Poppy-W", "start": 5, "end": 23 },
            { "kind": "keyword", "key": "slowed", "start": 114, "end": 120 }
          ],
          "pWrong": 0.04
        },
        {
          "id": "support:Poppy:general:2",
          "text": "Walk over your buckler after Iron Ambassador lands to get your shield back. Enemy champions can destroy it by stepping on it, so grab it first.",
          "refs": [
            {
              "kind": "ability",
              "key": "Poppy-passive",
              "start": 29,
              "end": 44
            }
          ],
          "pWrong": 0.04
        },
        {
          "id": "support:Poppy:general:3",
          "text": "Use Hammer Shock when enemies stand together, and again to catch them as the ground erupts. It slows them and hits twice, so it works well for poke.",
          "refs": [
            { "kind": "ability", "key": "Poppy-Q", "start": 4, "end": 16 },
            { "kind": "keyword", "key": "slowed", "start": 95, "end": 100 },
            { "kind": "keyword", "key": "poke", "start": 143, "end": 147 }
          ],
          "pWrong": 0.23
        },
        {
          "id": "support:Poppy:general:4",
          "text": "Release Keeper's Verdict right away to knock an enemy up in a close fight. Charge it first only when you want to throw a distant enemy back toward their base.",
          "refs": [
            { "kind": "ability", "key": "Poppy-R", "start": 8, "end": 24 }
          ],
          "pWrong": 0.2
        },
        {
          "id": "support:Poppy:general:5",
          "text": "Don't start charging Keeper's Verdict when you could be stunned or interrupted. If the charge is interrupted, the ability goes on a long cooldown.",
          "refs": [
            { "kind": "ability", "key": "Poppy-R", "start": 21, "end": 37 },
            { "kind": "keyword", "key": "stunned", "start": 56, "end": 63 }
          ],
          "pWrong": 0.16
        }
      ],
      "combos": [
        {
          "id": "support:Poppy:combo:0",
          "name": "Flash charged ult",
          "category": "trick",
          "sequence": [
            { "kind": "ability", "key": "Poppy-R" },
            { "kind": "summoner-spell", "key": "2202" }
          ],
          "when": "When you want a long-range knockback without the enemy seeing you close in.",
          "whenRefs": [],
          "text": "Flash is still usable while you charge the hammer. Start charging, then Flash toward the target before you release to reposition.",
          "textRefs": [
            { "kind": "summoner-spell", "key": "4", "start": 0, "end": 5 },
            { "kind": "summoner-spell", "key": "4", "start": 72, "end": 77 }
          ]
        }
      ]
    }
  ],
