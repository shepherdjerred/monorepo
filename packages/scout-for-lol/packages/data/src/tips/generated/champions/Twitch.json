      "tips": [
        {
          "id": "adc:Twitch:general:0",
          "text": "Throw Venom Cask onto enemies standing together, then keep attacking. Everyone in the cloud is slowed and builds more Deadly Venom.",
          "refs": [
            { "kind": "ability", "key": "Twitch-W", "start": 6, "end": 16 },
            { "kind": "keyword", "key": "slowed", "start": 95, "end": 101 },
            {
              "kind": "ability",
              "key": "Twitch-passive",
              "start": 118,
              "end": 130
            }
          ],
          "pWrong": 0.06
        },
        {
          "id": "adc:Twitch:general:1",
          "text": "Build up several stacks of Deadly Venom before pressing Contaminate. It hits harder for every stack on the target.",
          "refs": [
            {
              "kind": "ability",
              "key": "Twitch-passive",
              "start": 27,
              "end": 39
            },
            { "kind": "ability", "key": "Twitch-E", "start": 56, "end": 67 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "adc:Twitch:general:2",
          "text": "Use Contaminate to finish a fleeing enemy. It reaches far and still hits a target you can't see.",
          "refs": [
            { "kind": "ability", "key": "Twitch-E", "start": 4, "end": 15 }
          ],
          "pWrong": 0.26
        },
        {
          "id": "adc:Twitch:general:3",
          "text": "Use Ambush to sneak into a fight or to reposition. Attacking or casting Venom Cask or Contaminate ends it, so pick your moment.",
          "refs": [
            { "kind": "ability", "key": "Twitch-Q", "start": 4, "end": 10 },
            { "kind": "ability", "key": "Twitch-W", "start": 72, "end": 82 },
            { "kind": "ability", "key": "Twitch-E", "start": 86, "end": 97 }
          ],
          "pWrong": 0.07
        },
        {
          "id": "adc:Twitch:general:4",
          "text": "Leave Ambush and attack right away. You get bonus Attack Speed for a short time.",
          "refs": [
            { "kind": "ability", "key": "Twitch-Q", "start": 6, "end": 12 }
          ],
          "pWrong": 0.01
        },
        {
          "id": "adc:Twitch:general:5",
          "text": "Save Spray and Pray for team fights. Line up enemies so the bolts pass through several of them.",
          "refs": [
            { "kind": "ability", "key": "Twitch-R", "start": 5, "end": 19 }
          ],
          "pWrong": 0.07
        },
        {
          "id": "adc:Twitch:general:6",
          "text": "Use Spray and Pray's long range to hit turrets without being shot back.",
          "refs": [
            { "kind": "ability", "key": "Twitch-R", "start": 4, "end": 18 }
          ],
          "pWrong": 0.04
        },
        {
          "id": "adc:Twitch:general:7",
          "text": "Stay behind your tank. Twitch is fragile, and he is easy to kill once he is caught out of camouflage.",
          "refs": [
            { "kind": "champion", "key": "Twitch", "start": 23, "end": 29 }
          ],
          "pWrong": 0.13
        }
      ],
      "combos": [
        {
          "id": "adc:Twitch:combo:0",
          "name": "Ambush attack-speed reset",
          "category": "trick",
          "sequence": [{ "kind": "ability", "key": "Twitch-Q" }, "attack"],
          "when": "When you want to ambush an enemy and open a fight from stealth with a burst of attack speed.",
