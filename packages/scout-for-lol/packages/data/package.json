{
  "name": "@scout-for-lol/data",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./model/weekly-parlay.ts": {
      "types": "./dist/weekly-parlay.d.ts",
      "default": "./dist/model/weekly-parlay.js"
    },
    "./browser-assets": "./src/browser-assets.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "build": "PATH=node_modules/@typescript/native/bin:$PATH tsc --emitDeclarationOnly -p tsconfig.weekly-parlay.build.json && bun build src/model/bucks/weekly-parlay.ts --outfile dist/model/weekly-parlay.js --target bun --external zod",
    "generate": "bun run scripts/generate-permission-catalog.ts && bun run scripts/generate-asset-manifest.ts --check && bun run scripts/generate-dare-paraphrase-schema.ts",
    "generate:asset-manifest": "bun run scripts/generate-asset-manifest.ts --write",
    "check:asset-manifest": "bun run scripts/generate-asset-manifest.ts --check",
    "test": "bun --no-install --bun vitest --config ../../../../vitest.config.ts run",
    "test:watch": "bun --no-install --bun vitest --config ../../../../vitest.config.ts",
    "test:coverage": "bun --no-install --bun vitest --config ../../../../vitest.config.ts run --coverage",
    "test:ci": "bun ../../../../scripts/ci/run-ci-test.ts",
    "lint": "bun x eslint src",
    "format": "bun x prettier --check src",
    "format:write": "bun x prettier --write src",
    "typecheck": "PATH=node_modules/@typescript/native/bin:$PATH tsc --noEmit",
    "update-data-dragon": "bun run scripts/update-data-dragon.ts",
    "test:report": "CI_TEST_COVERAGE=1 bun ../../../../scripts/ci/run-ci-test.ts"
  },
  "dependencies": {
    "@shepherdjerred/llm-runtime": "workspace:*",
    "@shepherdjerred/llm-models": "workspace:*",
    "@shepherdjerred/glitter-context": "workspace:*",
    "chevrotain": "^13.0.0",
    "cron-parser": "^5.5.0",
    "date-fns": "^4.1.0",
    "remeda": "^2.21.2",
    "ts-pattern": "^5.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "bun-types": "1.4.0",
    "eslint": "^10.3.0",
    "prettier": "3.9.6",
    "typescript": "^6.0.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "vitest": "4.1.10",
    "@vitest/coverage-istanbul": "4.1.10"
  },
  "imports": {
    "#competitive-progression-catalog": "./competitive-progression-catalog.json",
    "#competitive-progression-catalog-schema": "./competitive-progression-catalog.schema.json",
    "#generated/*": "./generated/*",
    "#src/*": "./src/*"
  }
}
