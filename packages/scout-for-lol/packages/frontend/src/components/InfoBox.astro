---
interface Props {
  title?: string;
  variant?: "info" | "warning" | "success" | "danger" | "note";
  icon?: string;
}

const { title, variant = "info", icon } = Astro.props;

// Explicit Tailwind color classes for each variant
const variantClasses = {
  info: {
    bg: "bg-scout-raised ",
    border: "border-scout-brand ",
    title: "text-scout-ink ",
    text: "text-scout-subtle ",
  },
  warning: {
    bg: "bg-scout-raised ",
    border: "border-scout-warning ",
    title: "text-scout-ink ",
    text: "text-scout-subtle ",
  },
  success: {
    bg: "bg-scout-raised ",
    border: "border-scout-success ",
    title: "text-scout-ink ",
    text: "text-scout-subtle ",
  },
  danger: {
    bg: "bg-scout-raised ",
    border: "border-scout-danger ",
    title: "text-scout-ink ",
    text: "text-scout-subtle ",
  },
  note: {
    bg: "bg-scout-raised ",
    border: "border-scout-border ",
    title: "text-scout-ink ",
    text: "text-scout-subtle ",
  },
};

const classes = variantClasses[variant];
---

<div class={`${classes.bg} border ${classes.border} rounded-lg p-6`}>
  {
    title && (
      <h4 class={`font-semibold ${classes.title} mb-2 flex items-center`}>
        {icon && <span class="mr-2">{icon}</span>}
        {title}
      </h4>
    )
  }
  <div class={classes.text}>
    <slot />
  </div>
</div>
