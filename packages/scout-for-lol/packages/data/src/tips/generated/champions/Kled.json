            { "kind": "ability", "key": "Kled-Q", "start": 15, "end": 34 }
          ],
          "pWrong": 0.12
        },
        {
          "id": "top:Kled:Garen:1",
          "text": "Don't fight inside Judgment for long. Jousting through Garen and back out gets you away from the spin.",
          "refs": [
            { "kind": "ability", "key": "Garen-E", "start": 19, "end": 27 },
            { "kind": "ability", "key": "Kled-E", "start": 38, "end": 46 },
            { "kind": "champion", "key": "Garen", "start": 55, "end": 60 }
          ],
          "pWrong": 0.36
        },
        {
          "id": "top:Kled:Garen:2",
          "text": "Garen's Decisive Strike silences you, so don't rely on abilities in the moment after his first hit.",
          "refs": [
            { "kind": "champion", "key": "Garen", "start": 0, "end": 5 },
            { "kind": "ability", "key": "Garen-Q", "start": 8, "end": 23 },
            { "kind": "keyword", "key": "silenced", "start": 24, "end": 32 }
          ],
          "pWrong": 0.02
        },
        {
          "id": "top:Kled:Garen:3",
          "text": "Use Violent Tendencies so that its fourth hit lands on Garen, and fight when he is hurt, before Perseverance heals him.",
          "refs": [
            { "kind": "ability", "key": "Kled-W", "start": 4, "end": 22 },
            { "kind": "champion", "key": "Garen", "start": 55, "end": 60 },
            {
              "kind": "ability",
              "key": "Garen-passive",
              "start": 96,
              "end": 108
            }
          ],
          "pWrong": 0.22
        },
        {
          "id": "top:Kled:Garen:4",
          "text": "Stay healthy when you are low, since Demacian Justice deals more damage to hurt targets.",
          "refs": [
            { "kind": "ability", "key": "Garen-R", "start": 37, "end": 53 }
          ],
          "pWrong": 0.52
        }
      ],
      "opponent": "Garen",
      "comboRefs": []
    },
